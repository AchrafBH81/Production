   -
     name : calcul_prixuf
     procedure_id : 1624319578973741076
     type_code : 14
     code : |1+
      Procédure calcul_prixuf(no_produit1,no_produit2,no_produit3,udemesure = "A",produitdebase="")
      
      
      indice est un entier = 0
      EXTRARECHERCHE EST UNE CHAINE
      EXTRATRECHERCHE EST UNE CHAINE
      resultat est un reel
      pextrat est un tableau de 3 reel 
      pextra est un tableau de 3 reel
      escompte est un tableau de 3 reel
      escomptet est un tableau de 3 reel
      net est un tableau de 3 reel
      nett est un tableau de 3 reel
      netpbase est un reel
      escpbase est un reel
      prixdebase est un reel
      epaisseur est un entier = 0
      nbverre est une chaine
      daterequise est une chaine = ""
      si pas sansespace(no_produit1) = "" alors
      	indice = indice  + 1
      	hlitrecherche("invent","INUM",no_produit1)
      //Code WinDev 5.5 remplacé par la migration :
      //	si pas h.endehors alors
      	si pas HEnDehors() alors
      		
      //Code WinDev 5.5 remplacé par la migration :
      //		si h.trouve  alors
      		si HTrouve()  alors
      			//pdebase = invent.ipbase
      			epaisseur += invent.iepaisseur
      			
      			si pas invent.ibase alors
      				
      				EXTRARECHERCHE = invent.ipextra
      				EXTRATRECHERCHE = invent.ipextrat
      				hlitrecherche("invent","INUM",EXTRARECHERCHE)
      //Code WinDev 5.5 remplacé par la migration :
      //				si pas h.endehors alors
      				si pas HEnDehors() alors
      //Code WinDev 5.5 remplacé par la migration :
      //					si h.trouve alors
      					si HTrouve() alors
      						escompte[1] = trouve_escompte(client.numero+invent.inum,...
      						client.numero+repete(" ",10)+invent.icategorie)
      						si sansespace(invent.idateprixfutur) = "" alors
      							si udemesure = "A" alors
      								pextra[1] = invent.iprixa
      							sinon
      								pextra[1] = invent.iprixm
      							fin
      							
      						sinon
      							si daterequise > invent.idateprixfutur ou sansespace(daterequise) = "" alors
      								daterequise = invent.idateprixfutur
      						    fin
      									 
      							si udemesure = "A" alors
      								pextra[1] = invent.iprixfutur
      							sinon
      								pextra[1] = invent.iprixfuturm
      							fin
      						fin
      					fin
      				fin		  
      				hlitrecherche("invent","INUM",EXTRATRECHERCHE)
      //Code WinDev 5.5 remplacé par la migration :
      //				si pas h.endehors alors
      				si pas HEnDehors() alors
      //Code WinDev 5.5 remplacé par la migration :
      //					si h.trouve alors
      					si HTrouve() alors
      						escomptet[1] = trouve_escompte(client.numero+invent.inum,...
      						client.numero+repete(" ",10)+invent.icategorie)
      						si sansespace(invent.idateprixfutur) = "" alors
      							si udemesure = "A" alors
      								pextrat[1] = invent.iprixa
      							sinon
      								pextrat[1] = invent.iprixm
      							fin
      							
      						sinon
      							si daterequise > invent.idateprixfutur ou sansespace(daterequise) = "" alors
      								daterequise = invent.idateprixfutur
      						    fin
      							si udemesure = "A" alors
      								pextrat[1] = invent.iprixfutur
      							sinon
      								pextrat[1] = invent.iprixfuturm
      							fin
      						fin
      					fin
      				fin		  
      			fin
      		FIN
      		
      	sinon
      		pextra[1] = ""
      		pextrat[1] = ""
      		net[1] = 0
      		nett[1] = 0
      		escompte[1] = 0
      		escomptet[1] = 0
      		
      	fin
      	si pas pextra[1]= "" alors
      		net[1] = pextra[1] * (100 - escompte[1]) / 100
      	FIN
      	si pas pextrat[1] = "" alors
      		nett[1] = pextrat[1] * (100 - escomptet[1]) / 100
      	FIN
      fin
      
      
      
      
      si pas sansespace(no_produit2) = "" alors
      	indice = indice  + 1
      	hlitrecherche("invent","INUM",no_produit2)
      //Code WinDev 5.5 remplacé par la migration :
      //	si pas h.endehors alors
      	si pas HEnDehors() alors
      		
      //Code WinDev 5.5 remplacé par la migration :
      //		si h.trouve  alors
      		si HTrouve()  alors
      			//	pdebase = invent.ipbase
      			epaisseur += invent.iepaisseur
      			
      			si pas invent.ibase alors
      				EXTRARECHERCHE = invent.ipextra
      				EXTRATRECHERCHE = invent.ipextrat
      				hlitrecherche("invent","INUM",EXTRARECHERCHE)
      //Code WinDev 5.5 remplacé par la migration :
      //				si pas h.endehors alors
      				si pas HEnDehors() alors
      //Code WinDev 5.5 remplacé par la migration :
      //					si h.trouve alors
      					si HTrouve() alors
      						escompte[2] = trouve_escompte(client.numero+invent.inum,...
      						client.numero+repete(" ",10)+invent.icategorie)
      						si sansespace(invent.idateprixfutur) = "" alors
      							si udemesure = "A" alors
      								pextra[2] = invent.iprixa
      							sinon
      								pextra[2] = invent.iprixm
      							fin
      							
      						sinon
      							si daterequise > invent.idateprixfutur ou sansespace(daterequise) = "" alors
      								daterequise = invent.idateprixfutur
      						    fin
      							si udemesure = "A" alors
      								pextra[2] = invent.iprixfutur
      							sinon
      								pextra[2] = invent.iprixfuturm
      							fin
      						fin
      						
      					fin
      				fin		  
      				hlitrecherche("invent","INUM",EXTRATRECHERCHE)
      //Code WinDev 5.5 remplacé par la migration :
      //				si pas h.endehors alors
      				si pas HEnDehors() alors
      //Code WinDev 5.5 remplacé par la migration :
      //					si h.trouve alors
      					si HTrouve() alors
      						escomptet[2] = trouve_escompte(client.numero+invent.inum,...
      						client.numero+repete(" ",10)+invent.icategorie)
      						si sansespace(invent.idateprixfutur) = "" alors
      							si udemesure = "A" alors
      								pextrat[2] = invent.iprixa
      							sinon
      								pextrat[2] = invent.iprixm
      							fin
      							
      						sinon
      							si daterequise > invent.idateprixfutur ou sansespace(daterequise) = "" alors
      								daterequise = invent.idateprixfutur
      						    fin
      							si udemesure = "A" alors
      								pextrat[2] = invent.iprixfutur
      							sinon
      								pextrat[2] = invent.iprixfuturm
      							fin
      						fin
      					fin
      				fin		  
      			fin
      		FIN
      		
      	sinon
      		pextra[2] = ""
      		pextrat[2] = ""
      		net[2] = 0
      		nett[2] = 0
      		escompte[2] = 0
      		escomptet[2] = 0
      		
      	fin
      	si pas pextra[2]= "" alors
      		net[2] = pextra[2] * (100 - escompte[2]) / 100
      	FIN
      	si pas pextrat[2] = "" alors
      		nett[2] = pextrat[2] * (100 - escomptet[2]) / 100
      	FIN
      fin
      
      
      si pas sansespace(no_produit3) = "" alors
      	
      	indice = indice + 1
      	hlitrecherche("invent","INUM",no_produit3)
      //Code WinDev 5.5 remplacé par la migration :
      //	si pas h.endehors alors
      	si pas HEnDehors() alors
      		
      //Code WinDev 5.5 remplacé par la migration :
      //		si h.trouve  alors
      		si HTrouve()  alors
      			//	pdebase = invent.ipbase
      			epaisseur += invent.iepaisseur
      			si pas invent.ibase alors
      				EXTRARECHERCHE = invent.ipextra
      				EXTRATRECHERCHE = invent.ipextrat
      				hlitrecherche("invent","INUM",EXTRARECHERCHE)
      //Code WinDev 5.5 remplacé par la migration :
      //				si pas h.endehors alors
      				si pas HEnDehors() alors
      //Code WinDev 5.5 remplacé par la migration :
      //					si h.trouve alors
      					si HTrouve() alors
      						escompte[3] = trouve_escompte(client.numero+invent.inum,...
      						client.numero+repete(" ",10)+invent.icategorie)
      						si sansespace(invent.idateprixfutur) = "" alors
      							si udemesure = "A" alors
      								pextra[3] = invent.iprixa
      							sinon
      								pextra[3] = invent.iprixm
      							fin
      							
      						sinon
      							si daterequise > invent.idateprixfutur ou sansespace(daterequise) = "" alors
      								daterequise = invent.idateprixfutur
      						    fin
      							si udemesure = "A" alors
      								pextra[3] = invent.iprixfutur
      							sinon
      								pextra[3] = invent.iprixfuturm
      							fin
      						fin
      					fin
      				fin		  
      				hlitrecherche("invent","INUM",EXTRATRECHERCHE)
      //Code WinDev 5.5 remplacé par la migration :
      //				si pas h.endehors alors
      				si pas HEnDehors() alors
      //Code WinDev 5.5 remplacé par la migration :
      //					si h.trouve alors
      					si HTrouve() alors
      						escomptet[3] = trouve_escompte(client.numero+invent.inum,...
      						client.numero+repete(" ",10)+invent.icategorie)
      						si sansespace(invent.idateprixfutur) = "" alors
      							si udemesure = "A" alors
      								pextra[3] = invent.iprixa
      							sinon
      								pextra[3] = invent.iprixm
      							fin
      							
      						sinon
      							si daterequise > invent.idateprixfutur ou sansespace(daterequise) = "" alors
      								daterequise = invent.idateprixfutur
      						    fin
      							si udemesure = "A" alors
      								pextra[3] = invent.iprixfutur
      							sinon
      								pextra[3] = invent.iprixfuturm
      							fin
      						fin
      					fin
      				fin		  
      			fin
      		FIN
      		
      	sinon
      		pextra[3] = ""
      		pextrat[3] = ""
      		net[3] = 0
      		nett[3] = 0
      		escompte[3] = 0
      		escomptet[3] = 0
      		
      	fin
      	si pas pextra[3]= "" alors
      		net[3] = pextra[3] * (100 - escompte[3]) / 100
      	FIN
      	si pas pextrat[1] = "" alors
      		nett[3] = pextrat[3] * (100 - escomptet[3]) / 100
      	FIN
      fin
      
      
      
      si pas indice = 0 alors
      	
      	hlitrecherche("invent","INUM",produitdebase)
      	
      //Code WinDev 5.5 remplacé par la migration :
      //	si pas h.endehors alors
      	si pas HEnDehors() alors
      //Code WinDev 5.5 remplacé par la migration :
      //		si h.trouve alors
      		si HTrouve() alors
      //			daterequise = invent.idateprixfutur
      			escpbase = trouve_escompte(client.numero+invent.inum,...
      			client.numero+repete(" ",10)+invent.icategorie,indice,"base")
      			selon indice
      			cas 1
      				nbverre = "simple"
      				si sansespace(invent.idateprixfutur) = "" alors
      					si udemesure = "A" alors
      						prixdebase = invent.iprixa 
      					sinon
      						prixdebase = invent.iprixm 
      					fin	
      				sinon
      							si daterequise > invent.idateprixfutur ou sansespace(daterequise) = "" alors
      								daterequise = invent.idateprixfutur
      						    fin
      					si udemesure = "A" alors
      						prixdebase = invent.iprixfutur 
      					sinon
      						prixdebase = invent.iprixfuturm 
      					fin	
      				fin
      			cas 2   
      				nbverre = "double"
      				si sansespace(invent.idateprixfutur) = "" alors
      					si udemesure = "A" alors
      						prixdebase = invent.iprixdouble
      					sinon
      						prixdebase = invent.iprixdoublem
      					fin	
      				sinon
      							si daterequise > invent.idateprixfutur ou sansespace(daterequise) = "" alors
      								daterequise = invent.idateprixfutur
      						    fin
      					si udemesure = "A" alors
      						prixdebase = invent.iprixfuturdouble
      					sinon
      						prixdebase = invent.iprixfuturdoublem
      					fin	
      				fin	
      				// Options
      				
      				
      			cas 3
      				nbverre = "triple"
                      si sansespace(invent.idateprixfutur) = "" alors
      					si udemesure = "A" alors
      						prixdebase = invent.iprixtriple
      					sinon
      					    
      						prixdebase = invent.iprixtriplem
      					fin	
      					
      				sinon
      							si daterequise > invent.idateprixfutur ou sansespace(daterequise) = "" alors
      								daterequise = invent.idateprixfutur
      						    fin
      					si udemesure = "A" alors
      						prixdebase = invent.iprixfuturtriple
      					sinon
      					    
      						prixdebase = invent.iprixfuturtriplem
      					fin	
      					
      				fin
      				// Options
      				
      			fin
      		fin
      	FIN
      	netpbase = prixdebase * (100 - escpbase) /100
      	
      fin
      resultat = net[1]+ ...
      net[2]+...
      net[3]+...
      nett[1]+...
      nett[2]+...
      nett[3]+...
      netpbase 
      
      renvoyer resultat
      
     type : 458752
   -
     name : calcul_prixu
     procedure_id : 1624319578973806612
     type_code : 14
     code : |1+
      
      Procédure calcul_prixu(no_produit1,no_produit2,no_produit3,udemesure = "A",produitdebase="")
      
      
      indice est un entier = 0
      EXTRARECHERCHE EST UNE CHAINE
      EXTRATRECHERCHE EST UNE CHAINE
      resultat est un reel
      pextrat est un tableau de 3 reel 
      pextra est un tableau de 3 reel
      escompte est un tableau de 3 reel
      escomptet est un tableau de 3 reel
      net est un tableau de 3 reel
      nett est un tableau de 3 reel
      netpbase est un reel
      escpbase est un reel
      prixdebase est un reel
      epaisseur est un entier = 0
      nbverre est une chaine
      	
      	si pas sansespace(no_produit1) = "" alors
      		indice = indice  + 1
      		hlitrecherche("invent","INUM",no_produit1)
      //Code WinDev 5.5 remplacé par la migration :
      //		si pas h.endehors alors
      		si pas HEnDehors() alors
      			
      //Code WinDev 5.5 remplacé par la migration :
      //			si h.trouve  alors
      			si HTrouve()  alors
      				//pdebase = invent.ipbase
      				epaisseur += invent.iepaisseur
      				
