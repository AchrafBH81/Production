         	spqteint.spqclient + spqteint.spqcomposant1 + spqteint.spqcomposant2 + spqteint.spqcomposant3	
         compteur++
         hlitsuivant("spqteint","spqclientproduitintervalle")
         
         fin
         //Code WinDev 5.5 remplacé par la migration :
