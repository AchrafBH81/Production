   -
     name : assigneLibelle
     procedure_id : 1624319578973937684
     type_code : 14
     code : |1+
      Procédure assigneLibelle()
      i est un entier
      
      lTableauLibelle est un tableau de  21 chaines
      lTableauLibelle[1]  = "lentete,lentete"
      lTableauLibelle[2]  = "lvigueur,lvigueur"
      lTableauLibelle[3]  = "lremplace,lremplace"
      // _ptype = 1 = standard 2 = speciaux
      si _ptype = 1 alors
      	lTableauLibelle[4]  = "lstandard,lstandard"
      	lTableauLibelle[5]  = "lstandardsuite,lstandardsuite"
      sinon
      	lTableauLibelle[4]  = "lspeciaux,lstandard"
      	lTableauLibelle[5]  = "lspeciauxsuite,lstandardsuite"
      fin
      lTableauLibelle[6]  = "lnumero,lnumero"
      lTableauLibelle[7]  = "facdescription,facdescription"
      lTableauLibelle[8]  = "langlais,Langlais"
      lTableauLibelle[9]  = "langlais,Langlais1"
      lTableauLibelle[10]  = "lmetrique,lmetrique"
      lTableauLibelle[11]  = "lmetrique,lmetrique1"
      lTableauLibelle[12]  = "lvigueur,LDate"
      lTableauLibelle[13]  = "lremplace,lremplace"
      lTableauLibelle[14]  = "facdescription,facdescription"
      lTableauLibelle[15]  = "lcondpaiement,LCondpaiement"
      lTableauLibelle[16]  = "ldoubleprix,lprix"
      lTableauLibelle[17]  = "ltriple,lprix1"
      lTableauLibelle[18]  = "surchargeenergie,Explication1"
      lTableauLibelle[19]  = "dimension15pourcent,Explication2"
      lTableauLibelle[20]  = "dimension30pourcent,Explication3"
      lTableauLibelle[21]  = "ExtraNote,ExtraNote"
      
      selon client.CLangue
      	cas 1
      		pour i = 1 a 21
      			si hlitrecherche(Traduction,TRecherche,extraitchaine(lTableauLibelle[i],1,",")) alors
      				{"ListeExtraPrixClienttriestandard1."+ExtraitChaîne(lTableauLibelle[i],2,",")} = traduction.dFrancais
      			fin
      		FIN
      		selon _ptype
      			cas "1"
      				si hlitrecherche(Traduction,trecherche,"ExtraStandard") alors
      					EnteteRupture = traduction.dfrancais
      					POUR j = 3 a 6
      						SI HLitRecherche(Traduction,trecherche,"MessExtra"+SansEspace(NumériqueVersChaîne(j))) ALORS
      							messageEnteteRupture[j] = SansEspace(Traduction.dfrancais)
      						FIN
      					FIN
      				FIN
      			cas "2"
      				si hlitrecherche(Traduction,trecherche,"ExtraSpeciaux") alors
      					EnteteRupture = traduction.dfrancais
      					POUR j = 3 a 6
      						SI HLitRecherche(Traduction,trecherche,"MessExtra"+SansEspace(NumériqueVersChaîne(j))) ALORS
      							messageEnteteRupture[j] = SansEspace(Traduction.dfrancais)
      						FIN
      					FIN
      				FIN
      		FIN	
      	cas 2
      		pour i = 1 a 21
      			si hlitrecherche(Traduction,TRecherche,extraitchaine(lTableauLibelle[i],1,",")) alors
      				{"ListeExtraPrixClienttriestandard1."+ExtraitChaîne(lTableauLibelle[i],2,",")} = traduction.danglais
      			fin
      		fin
      		selon _ptype
      			cas "1"
      				si hlitrecherche(Traduction,trecherche,"ExtraStandard") alors
      					EnteteRupture = traduction.danglais
      					POUR j = 3 a 6
      						SI HLitRecherche(Traduction,trecherche,"MessExtra"+SansEspace(NumériqueVersChaîne(j))) ALORS
      							messageEnteteRupture[j] = SansEspace(Traduction.danglais)
      						FIN
      					FIN
      				FIN
      			cas "2"
      				si hlitrecherche(Traduction,trecherche,"ExtraSpeciaux") alors
      					EnteteRupture = traduction.danglais
      					POUR j = 3 a 6
      						SI HLitRecherche(Traduction,trecherche,"MessExtra"+SansEspace(NumériqueVersChaîne(j))) ALORS
      							messageEnteteRupture[j] = SansEspace(Traduction.danglais)
      						FIN
      					FIN
      				FIN
      				
      		fin
      fin
      
      
      
      
     type : 458752
   -
     name : CalculPrixExtra
     procedure_id : 1624319578974003220
     type_code : 14
     code : |1-
      Procédure CalculPrixExtra(_numero)
      _extra est une chaine
      _extrat est une chaine
      _prixa est un reel = 0
      _prixm est un reel = 0
      _special est un booleen = faux
      _modifiable est un booleen
      
      
      si hlitrecherche(invent,INUM,_numero) ALORS
      	_extra = invent.ipextra
      	_extrat = invent.ipextrat
      	si sansespace(_extra) <> "" 
      		si _extra <> _numero alors
      			_modifiable = faux
      			si hlitrecherche(FclientExtra,IdClientNoProduit,HConstruitValClé(FclientExtra,IdClientNoProduit,client.IDClient,sansespace(_extra))) et FclientExtra.prixSpecial alors
      				_special = vrai
      				_prixa+= FclientExtra.PrixAnglais
      				_prixm+= FclientExtra.PrixMetrique
      			sinon
      				si hlitrecherche(invent,INUM,_extra) alors
      					_prixa+= invent.IPRIXA
      					_prixm+= invent.IPRIXm
      				fin
      			fin
      		sinon
      			_prixa+= invent.IPRIXA
      			_prixm+= invent.IPRIXm
      		FIN
      	fin
      
      	si sansespace(_extrat) <> ""  alors
      		si _extrat <> _numero alors
      			_modifiable = faux
      			si hlitrecherche(FclientExtra,IdClientNoProduit,HConstruitValClé(FclientExtra,IdClientNoProduit,client.IDClient,sansespace(_extrat)))  et FclientExtra.prixSpecial  alors
      				_special = vrai
      				_prixa+= FclientExtra.PrixAnglais
      				_prixm+= FclientExtra.PrixMetrique
      			sinon
      				si  hlitrecherche(invent,INUM,_extrat) alors
      					_prixa+= invent.IPRIXA
      					_prixm+= invent.IPRIXm
      				fin
      			fin
      		sinon
      			_prixa+= invent.IPRIXA
      			_prixm+= invent.IPRIXm
      		fin
      	fin
      FIN
      
      
      renvoyer NumériqueVersChaine(_prixa, "10.2f")+","+NumériqueVersChaine(_prixm, "10.2f") + ","+_special+","+_modifiable
     type : 458752
  procedure_templates : []
