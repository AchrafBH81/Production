     y : 81.061
     width : 195.9
     height : 4.762
    code_elements :
     type_code : 30
     p_codes :
      -
        code : |1+
         //Code WinDev 5.5 remplacé par la migration :
         //bloc_haut..etat = actif
         //clederecherche EST UNE CHAINE
         bloc_haut..etat = actif; bloc_haut..Visible=Vrai
         compteur est un entier = 1
         //clederecherche = HConstruitValClé(ThermosClient,IdClientIdhermos,client.numero,RequeteThermos.ennumero)
         //HLITRECHERCHE(ThermosClient,IdClientIdhermos,clederecherche)
         
        type : 327692
      -
        code : |1-
         
         si listeprix.nouvelleliste   alors
         	ListeHistoDetail.IDListeHisto = ListeHisto.IDListeHisto
         	ListeHistoDetail.iDescription = rubriq1
         	ListeHistoDetail.INoProduit = RUBRIQUE1
         	ListeHistoDetail.iPrixa = CALCUL1
         	ListeHistoDetail.iPrixM = CALCUL2
         	si requeteextratrie.ibase alors
         		ListeHistoDetail.IPrixaT = CALCUL3
         		ListeHistoDetail.iPrixMT = CALCUL4
         		ListeHistoDetail.ibase = vrai
         	sinon
         		ListeHistoDetail.IPrixaT = 0
         		ListeHistoDetail.iPrixMT = 0
         		ListeHistoDetail.ibase = faux
         	fin
         	ListeHistoDetail.ITypeProduit = 7
         	hajoute(ListeHistoDetail)
         
         FIN
        type : 327693
      -
        type : 327697
        enabled : false
