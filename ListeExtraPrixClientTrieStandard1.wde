   -
     code : |1+
      Procedure ListeExtraPrixClientTrieStandard1(_pParam1="", _ptype="", _pParam3="", _pParam4="")
      
      GLOBAL
      	NUMEROCLIENT EST UNE CHAINE = _PPARAM1
      	tabpi2min est un tableau associatif (*, *, wlEntier) de chaînes
      	
      tabpi2min[2] = Client.cminimuma3 = 0 ? client.cminimuma sinon Client.cminimuma3
      tabpi2min[3] = Client.cminimuma4= 0 ? Client.cminimuma SINON Client.cminimuma4
      tabpi2min[4] = Client.cminimuma5= 0 ? Client.cminimuma SINON Client.cminimuma5
      tabpi2min[5] = Client.cminimuma6= 0 ? Client.cminimuma SINON Client.cminimuma6
      tabpi2min[9] = client.cminimumatrempe = 0 ? client.cminimuma sinon client.cminimumatrempe
      
      
      clederecherche est une chaine
      // Ne sauvegarde pas les paramètres spécifiés
      si pas listeprix.NouvelleListe alors
      	GrpDateRempl..visible = faux
      	lvigueur..visible = faux
      	ldate..visible = vrai
      sinon
      	GrpDateRempl..visible = vrai
      	//
      FIN
      si pas gImprimeCondPMT alors
      	GrpCondPmt..visible=faux
      fin
      EnteteRupture est une chaine // Chaine a inscrire dans l'entête des ruptures
      // exemple Thermos 3MM pour verre standard
      // Extra Verre spéciaux 3MM
      messageEnteteRupture est un tableau associatif de chaines
      HLit(config,1)
      //iMessage = config.textebaspage1listeprix	
      listeprix.ListeImprimee = faux									
      
      assigneLibelle()
      
      iMessage = Client.CLangue = 1 ? config.textebaspage1listeprix SINON config.TexteBasPage1ListePrixAnglais
      lnumero = "Code       Pi2 Min"
      iInitRequeteEtat(ListeExtraPrixClientTrieStandard,_ptype)
      
     type : 327680
   -
     code : |1-
       SI RequeteExtraTrie.icategorie = "VTR" ALORS  pi2min = 9
     type : 327695
   -
     code : |1+
      // Vérification de la condition
      
      si hlitrecherche(FclientExtra,IdClientNoProduit,HConstruitValClé(FclientExtra,IdClientNoProduit,client.IDClient,sansespace(requeteextratrie.INUM))) alors
      	si pas FclientExtra.ListeDePrix alors
      		renvoyer faux
      	fin
      sinon
      renvoyer faux
      fin
      
      
      RENVOYER VRAI		// Enregistrement accepté
      
      
     type : 327696
   -
     code : |1+
      lNombreenrImprime = MOIMEME..NbEnrImprimé
     type : 327682
