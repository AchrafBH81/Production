         hlitrecherche("spqteint","spqclientproduitintervalle",numeroclient+complete(ENSEMBLE.encomposant1,10)+...
                           complete(ENSEMBLE.encomposant2,10)+complete(ENSEMBLE.encomposant3,10)+caract(0))
         
