   -
     name : allumebouton
     procedure_id : 5055152975564494316
     type_code : 14
     code : |1+
      Procédure allumebouton()
      EteintBouton()
      message(gauche({ChampEnCours()}..nom,15))
      si champencours <> "" et ( gauche({ChampEnCours()}..nom,14) = "cProduitDefaut" ou gauche({ChampEnCours()}..nom,15) = "cProduitAssocie" )alors
      	BtnRecherche1..x = {ChampEnCours()}..x + {ChampEnCours()}..Largeur +5 
      	BtnRecherche1..y ={ChampEnCours()}..y +2
      	btnrecherche1..visible = vrai
      fin
      
      
      
      
     type : 458752
   -
     name : EteintBouton
     procedure_id : 5055153045135562024
     type_code : 14
     code : |1-
      Procédure EteintBouton()
      
      btnrecherche1..visible = faux
