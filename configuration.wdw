          internal_properties : 
          properties :
           x : 711
           y : 358
           width : 20
           height : 20
          type : 4
          code_elements :
           type_code : 4
           p_codes :
            -
              code : |1+
               //anciendossier = CheminRecup
               LigneEnCours est un entier = ComboCheminTrsfVideojet
               CheminTrsfvideojettempo est une chaine  = fRepSélecteur(sansespace(extraitchaine(ComboCheminTrsfVideojet[ComboCheminTrsfVideojet],2,"-")),"Dossier des lots","Choisir le dossier de préparation pour Vidéojet") 
               si CheminTrsfvideojettempo <> "" alors
               	ComboCheminTrsfVideojet[comboCheminTrsfVidéojet] = ComboCheminTrsfVideojet + "- " +CheminTrsfvideojettempo
               	listeselectplus(ComboCheminTrsfVideojet,LigneEnCours)
               fin
               
               
              type : 18
            -
              type : 161
              enabled : false
