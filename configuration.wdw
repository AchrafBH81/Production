 message_bar :
  internal_properties : CQAAAAkAAAC6+uxP2/ySQzShqR+j2bXfRNDo5YSAobXzaDqalwJ4TJeYexhPt/kLCEbcfmmKhdC4k5UKGGF1oi0SBZIYyoSSCCJ1RWXUv+f9bJMLL1Vsl1aD7f8U7hKnstXm/Q==
 actionbar : {}
 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1-
      
      // Pour compatibilité 5.5
      MoiMême..Visible=Vrai
      h1 est un reel
      l1 est un reel
      NBL est un entier
      NBH est un entier
      tdt est un entier
      gaz est un reel
      cap est un reel
      mdo est un reel
      mdc est un reel
      aut est un reel
      frg est un reel
      
      hOuvre("secteur")
      HLitPremier("secteur","secteur")
      //Code WinDev 5.5 remplacé par la migration :
      //TANTQUE pas h.EnDehors
      TANTQUE pas HEnDehors()
      	ListeAjoute("COMBO_secteur",secteur.sdescription+glien(secteur.secteur))
      	HLitSuivant("secteur","secteur")
      FIN
      
      //Code WinDev 5.5 remplacé par la migration :
      //Infoobjet(combo_secteur..Nom,43,vrai)
      gLienActive(combo_secteur..Nom,vrai)
      
      hlitpremier("config","COCLEUNIK")
      fichierversecran("configuration","config")
      AjusteLibelleQte(config.DimensionAverifierPrep)
      
      hinfogene("coulisse")
      si h.nbenr = 0 alors
      	hajoute("coulisse")
      FIN
      
      hlitpremier("coulisse","C2CLEUNIK")
      fichierversecran("configuration","coulisse")
      
      Evénement("allumebouton",".*",WM_SETFOCUS)
      evenement("BtnClicDroite",".*",WM_rBUTTONDOWN)
      
      selon gLogCompt
      	cas "Acomba"
              BtnRechDossierData..visible = vrai
      		DossierData..visible = vrai
      		DossierComptabilite..libelle = "Dossier Acomba"
      	CAs "Cameleon"	
      		DossierData..visible = faux
      		BtnRechDossierData..visible = faux
      		DossierComptabilite..libelle = "Dossier Caméléon"
      FIN
      //ValideOnglet(mafenetre..nom)
   -
     code : |1+
      remplircombo()
      ExécuteTraitement(csUniteAUT,trtModification)
      ExécuteTraitement(csUnitemdo,trtModification)
      ExécuteTraitement(csUniteMDOcarrelage,trtModification)
      ExécuteTraitement(csUnitefrg,trtModification)
      ExécuteTraitement(ComboProvince,trtSélection)
     type : 34
   -
     type : 180
     enabled : false
   -
     type : 230
     enabled : false
   -
     code : |1-
      si configuration..Modifié alors
      	si acso_message("Info","Voulez-vous sauvegarder les modifications ?","OuiNon") = IDYES alors
      		ExécuteTraitement(BTN_OK,trtClic)
      	FIN
      FIN
     type : 2
   -
     type : 11
   -
     type : 12
   -
     type : 17
   -
     type : 13
  procedures :
   -
     name : TesteFormule
     procedure_id : 5055138244007722751
     type_code : 14
     code : |1+
      Procédure TesteFormule(NomChamp)
      quand exception 
      	acso_message("Erreur","Erreur dans la formule de calcul ou dans la condition","Erreur")
      	acso_message("Erreur",exceptionInfo(errMessage),"Erreur")
      	retour
      FIN
      res est une chaine       // resultat de la compil	
      IdChamp est une chaine = milieu(NomChamp,11)
      formule est une chaine = {"cformule"+IdChamp}
      indice est un entier = milieu(IdChamp,3)
      resultatCondition est un booleen
      si sansespace(formule) = "" alors
      	retour
      FIN
      assignevariable()
      
      si pas valideformule(formule) ALORS
      	{IdChamp} = 0
      	acso_Message("Erreur dans la formule",{IdChamp},"Erreur")
      	retour
      FIN
      
      //CalculAutresVariables(idchamp,indice-1)
      formule1 est une chaine = "y est un reel"+RC+"y="+formule+RC+"renvoyer y "
      res = compile("formule2",formule1)
      si res = "" ALORS
      	{IdChamp} = ExécuteTraitement("formule2",trtProcédure)
      	si {IdChamp} < 0 alors
      		{IdChamp} = 0
      	FIN
      	titresuivant("Résultat de la formule")
      //	formule = {"typecarr.conditionsi"+gauche(idchamp,2)}[îndice]
      	formule1 = "y est un reel"+RC+"y="+formule+RC+"renvoyer y "
      	res = compile("formule2",formule1)
      
      	si res = "" alors
      //		resultatcondition = ExécuteTraitement("formule2",trtProcédure)
      //
      //		si resultatcondition  alors
      //			formule = {"typecarr.conditionalors"+gauche(idchamp,2)}[îndice]
      //			formule1 = "y est un reel"+RC+"y="+formule+RC+"renvoyer y "
      			res = compile("formule2",formule1)
      			si res = "" ALORS
      				acso_message("Résultat de la formule",ExécuteTraitement("formule2",trtProcédure),"Info")
      			sinon
      				titresuivant("Erreur dans la formule")
      				acso_Message("Erreur dans la formule",res,"Erreur")
      			fin
      
      //		sinon
      //			info({idchamp})
      //		fin
      	sinon
      		titresuivant("Erreur dans la formule")
      		acso_Message("Erreur dans la formule",res,"Erreur")
      	fin
      
      	//	info(ExécuteTraitement("formule2",trtProcédure))
      sinon
      	titresuivant("Erreur dans la formule")
      	acso_Message("Erreur dans la formule",res,"Erreur")
      fin
      
      
      
      
      
     type : 458752
   -
     name : valideformule
     procedure_id : 5055138317188841597
     type_code : 14
     code : |1+
      Procédure valideformule(Formulaverifier)
      xposition est un entier = 0  // position du caractere /
      xposition1 est un entier = 1 // position du caractere )
      souschaine est une chaine
      i est un entier = 1
      formule1 est une chaine
      res est une chaine
      boucle
      	xposition = position(Formulaverifier,"/",xposition+1)
      	si xposition = 0 alors
      		sortir
      	FIN
      	xposition1 = position(Formulaverifier,")",xposition)
          si xposition1 = 0 alors
             xposition1 = taille(Formulaverifier)
          fin
          	
      	souschaine = milieu(Formulaverifier,xposition+1,xposition1-xposition)
      	souschaine = remplace(souschaine,"(","")
      	souschaine = remplace(souschaine,")","")
      
      	formule1 = "y est un reel"+RC+"y="+souschaine+RC+"renvoyer y "
      	res = compile("formule2",formule1)
      	si ExécuteTraitement("formule2",trtProcédure) = 0 alors
      		acso_message("Erreur",souschaine,"Erreur")
      		acso_message("Erreur","Division par zéro","Erreur")
      		renvoyer faux
      	FIN
      FIN
      
      
      
      renvoyer vrai
      
      
      
     type : 458752
