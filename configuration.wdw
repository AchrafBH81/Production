   -
     name : remplirCombo
     procedure_id : 5856086492555504452
     type_code : 14
     code : |1-
      Procédure remplirCombo()
      
      i est un entier
      pour i = 1 a 10
      	listeajoute(ComboCheminTrsfVideojet,i + "- " +config.CheminTrsfVidéojet[i])
      FIN
      
      listeselectplus(ComboCheminTrsfVideojet,1)
      
      pour i = 1 a 10
      	listeajoute(ComboCheminTrsfcarrelage,i + "- " +config.CheminTrsfcarrelage[i])
      FIN
      
      listeselectplus(ComboCheminTrsfcarrelage,1)
     type : 458752
