  widthClient : 890
  heightClient : 575
 controls :
  -
    name : BTN_SORTIE
    identifier : 0x3e9d90ac46ce2cec
    internal_properties : 
    properties :
     x : 4
     y : 2
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         ferme
         
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_OK
    identifier : 0x3e9d90ac1a4a2cf6
    internal_properties : 
    properties :
     x : 64
     y : 2
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         restaure_bouton()
         //si sansespace(DossierFichierPDF) = "" alors
         //	si acso_message("Question","Le champ <Dossier Fichier PDF> est vide"+rc+"Cela peut occasionner des problèmes lors de la préparation de fichier PDF."+rc+rc+"Voulez le modifier maintenant ?","OuiNon") = idyes alors
         //		reprisesaisie(dossierfichierpdf)
         //	fin
         //
         //FIN
         i est une entier
         ecranversfichier(configuration,config)
         gclConfig.m_bComponentPositionForPrep = Int_prepComponentorder
         config.cDoubleScellantA = config.cDoubleScellant / 25.4
         pour i = 1 a 10
         	config.CheminTrsfVidéojet[i] = sansespace(extraitchaine(ComboCheminTrsfVideojet[i],2,"-"))
         FIN
         pour i = 1 a 10
         	config.CheminTrsfCarrelage[i] = sansespace(extraitchaine(ComboCheminTrsfCarrelage[i],2,"-"))
         FIN
         hmodifie(config,hnumenrencours)
         gmessageajout = config.CMessageAjout
         gmessagemodification = config.CMessageModification
         
         gImpressionFeuilleTravail = config.ImpressionFeuilleTravail
         gProvinceTaxe = config.Province
         gImprimeCondPMT = config.ImprimeCondPmt
         DescriptionVarInter1 = sansespace(config.VariableIntercalaire1)
         DescriptionVarInter2 = sansespace(config.VariableIntercalaire2)
         DescriptionVarInter3 = sansespace(config.VariableIntercalaire3)
         DescriptionVarInter4 = sansespace(config.VariableIntercalaire4)
         DescriptionVarInter5 = sansespace(config.VariableIntercalaire5)
         
         si ratioDoubleTripleForme..modifie alors
         	si acso_message("Question","Voulez-vous recalculer les formes ","OuiNon") = idyes alors
         		pour TOUT forme 
         			forme.extratriple = forme.extradouble * config.ratioDoubleTripleForme
         			hmodifie(forme,hNumEnrEnCours)
         		FIN
         		pour TOUT FormeClient 
         			formeclient.FpRixtriple = formeclient.fPrixdouble * config.ratioDoubleTripleForme
         			hmodifie(formeclient,hNumEnrEnCours)
         		FIN
         	FIN
         fin
         configuration..Modifié = faux
         acso_message("Information","Vos données de base ont été sauvegardées","Info")
        type : 18
      -
        type : 161
        enabled : false
