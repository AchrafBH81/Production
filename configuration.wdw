   -
     name : BtnClicDroite
     procedure_id : 5055526401204060931
     type_code : 14
     code : |1+
      Procédure BtnClicDroite()
      AncienneValeur est une chaine = moimeme
      numerocomposante est une chaine
      si Minuscule(gauche(moimeme..nom,8)) = "cformule" alors
      	si pas moimeme..etat <> actif  alors
      		moimeme = AncienneValeur + ouvre(FenetreAbrev)
      
      		moimeme..curseur = taille(moimeme + 1)
      		reprisesaisie(moimeme)
      	fin
      FIN
      
      
      
      
     type : 458752
   -
     name : AjusteLibelleQte
     procedure_id : 5389873763177871863
     type_code : 14
     code : |1+
      Procédure AjusteLibelleQte(lDimension=0)
      MaxQteClair1300Moins..libelle = "Quantité maximum  (XXXX et moins):"
      MaxQteClair1300plus..libelle = "Quantité maximum  (XXXX et plus):"
      
      
      MaxQteClair1300Moins..libelle = remplace(MaxQteClair1300Moins..libelle,"XXXX",sansespace(NumériqueVersChaine(lDimension)))
      MaxQteClair1300plus..libelle = remplace(MaxQteClair1300Plus..libelle,"XXXX",sansespace(NumériqueVersChaine(lDimension)))
      
      
      
