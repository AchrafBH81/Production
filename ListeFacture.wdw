  -
    name : Btn_Ok
    identifier : 0x475848ff0dc0b3bb
    internal_properties : 
    properties :
     x : 427
     y : 47
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         si InterrupteurFichier alors
         	si sansespace(config.DossierComptabilite) = "" alors
         		ACSO_message("Erreur","Le dossier de destination du fichier de transfert vers Caméléon n'est pas configuré"+rc+"SVP l'inscrire dans Configuration","Erreur")
         	sinon
         		si  fRep(config.DossierComptabilite,frRépertoire) = "" alors
         			si ACSO_message("Erreur","Le dossier de destination ("+sansespace(config.DossierComptabilite)+") du fichier de transfert vers Caméléon est inexistant"+rc+"Voulez-vous le creer?","OuiNon") = idyes alors
         				si pas fRepCrée(sansespace(config.DossierComptabilite)) alors
         					acso_message("Ereur","La création du dossier a échouée","Erreur")
         					renvoyer vrai
         				FIN
         			sinon
         
         				renvoyer vrai
         			fin
         		fin	
         	fin
         fin
         
         
         RequeteFactureTransfert.pdateDebut = csddatedebut
         RequeteFactureTransfert.pdatefin = csddatefin
         selon Sélecteurfactures
         	cas 1
         		RequeteFactureTransfert.ptransfere1 =0
         		RequeteFactureTransfert.ptransfere2 = 1
         
         	cas 2
         		RequeteFactureTransfert.ptransfere1 =1
         		RequeteFactureTransfert.ptransfere2 = 1
         	cas 3		
         		RequeteFactureTransfert.ptransfere1 =0
         		RequeteFactureTransfert.ptransfere2 = 0
         FIN
         HExécuteRequête(RequeteFactureTransfert)
         si hnbenr(RequeteFactureTransfert) = 0 alors
         	ACSO_message("Erreur","Aucune facture ne correspond à votre demande","Erreur")
         	ferme(ListeFacture)
         FIN
         
         
         iConfigure(imprimanterapport)
         
         
         si SélecteurDestination = 1 alors
         	iapercu()
         fin
         
         iimprimeetat(EtransfertFacture,csddatedebut,csddatefin,InterrupteurFichier)
         
         si SélecteurDestination = 1 alors
         	iapercu()
         fin
         iimprimeetat(Etransfertsommaire,csddatedebut,csddatefin)
         
         
         si InterrupteurFichier alors
         	pour tout RequeteFactureTransfert
         		si hlitrecherche(BonLivraison,IDBonLivraison,RequeteFactureTransfert.IDBonLivraison) alors
         			BonLivraison.Btransfere = vrai
         			hmodifie(BonLivraison,hNumEnrEnCours)
         		fin
         
         FIN
         fin
         
        type : 18
      -
        type : 161
        enabled : false
