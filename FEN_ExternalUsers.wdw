 controls :
  -
    name : BTN_SORTIE
    identifier : 0x247a6fb96e490e16
    internal_properties : 
    properties :
     x : 25
     y : 9
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         pour chaque clUser de gtabuser 
         	si clUser.m_bIsModified alors
         		si clUser.m_IdexternalUsers <> 0  alors
         			si HLitRecherche(ExternalUsers,IDExternalUsers,cluser.m_IdexternalUsers) alors
         				MémoireVersFichier(clUser,ExternalUsers)
         				hmodifie(ExternalUsers,hNumEnrEnCours)
         			fin
         		sinon
         			MémoireVersFichier(clUser,ExternalUsers)
         			Hajoute(ExternalUsers)
         			
         		FIN
         	fin
         FIN
         ferme()
         
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_AJOUT
    identifier : 0x247a6fb96e4a0e16
    internal_properties : 
    properties :
     x : 89
     y : 9
     width : 31
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         gsCurrentLine = TABLEH_ExternalUsers.COL_CompanyNumber
         gnCurrentStatus = TABLEH_ExternalUsers[TABLEH_ExternalUsers]..Enroulé
         
         
         clUser est un cUserExternal = allouer un cUserExternal()
         clUser.m_bIsActive	= vrai
         clUser.m_bIsNew		= vrai
         clUser				= ouvre(FEN_ExternalUserDetails,clUser)
         si cluser.m_sUserCode <> "" alors
         	gtabuser.ajoute(clUser)
         fin
         FillUserTable()
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_MODIFIE
    identifier : 0x247a6fb96e4b0e16
    internal_properties : 
