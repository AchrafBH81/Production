 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1+
      gtabuser est un tableau de cUserExternal
      gsdReqsql est une source de donnees
      gclCurrentuser est un cUserExternal
      gnCurrentLine est un entier = 0
      gnCurrentStatus est un entier = 0
      gsCurrentLine est une chaîne
   -
     code : |1+
      HExécuteRequêteSQL(gsdReqsql,hRequêteDéfaut,"select * from ExternalUsers where isactive = 1 order by CustomerNumber , IsMaster desc")
      FichierVersTableau(gtabuser,gsdReqsql)
      
      FillUserTable()
      
      si TABLEH_ExternalUsers..vide alors
      	BTN_MODIFIE..etat = grise
      FIN
     type : 34
   -
     type : 180
     enabled : false
   -
     type : 230
     enabled : false
   -
     type : 11
   -
     type : 12
   -
     type : 17
   -
     type : 13
  procedures :
   -
     name : FillUserTable
     procedure_id : 1483272755565605738
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      // FillUserTable ()
      //
      // Paramètres :
      //	Aucun
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure FillUserTable()
      
      TableSupprimeTout(TABLEH_ExternalUsers)
      nLastLine			est un entier
      sLastCustomerCode	est une chaîne
      gtabuser.trie(ttMembre+tccRespecteNumérique,"m_sCustomerNumber;-m_bIsmaster")
      
      pour chaque clUser de gtabuser
      	si cluser.m_sCustomerNumber <> sLastCustomerCode ALORS
      		nlastline			= TableAjouteLigne(TABLEH_ExternalUsers,cluser.m_sCustomerNumber,cluser.m_sCustomerName)
      		si gsCurrentLine = sansespace(clUser.m_sCustomerNumber) alors
      			gncurrentline = nlastline
      		FIN
      		sLastCustomerCode	= clUser.m_sCustomerNumber
      		TableAjouteFils(TABLEH_ExternalUsers,nLastLine,"","",cluser.m_sUserCode,clUser.m_sUsername,cluser.m_bIsmaster,cluser.m_bIsActive,cluser.m_bIsnew)
      	sinon
      		TableAjouteFils(TABLEH_ExternalUsers,nLastLine,"","",clUser.m_sUserCode,clUser.m_sUsername,clUser.m_bIsmaster,clUser.m_bIsActive,clUser.m_bIsnew)
      	FIN
      FIN
      TableEnrouleTout(TABLEH_ExternalUsers)
     type : 458752
