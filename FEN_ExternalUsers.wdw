     y : 9
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         gclCurrentuser  = ouvre(FEN_ExternalUserDetails,gclCurrentuser,"M")
         FillUserTable()
         
         
        type : 18
      -
