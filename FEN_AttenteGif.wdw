      PROCEDURE MaFenêtre(gsLibelle est une chaine,gnXPos est un entier = 0, gnYPos est  un entier = 0)
      
      
      LIB_message = gsLibelle
      si gnxpos <> 0 alors mafenetre..x = gnxpos - (mafenetre..largeur / 2)
      si gnYpos <> 0 alors mafenetre..y = gnYpos - (mafenetre..hauteur / 2)
      
