   -
     name : OnFocus
     procedure_id : 1769744543588249867
     type_code : 12
     code : |1+
      PROCEDURE GLOBAL PROTÉGÉE OnFocus()
      SI Pas ::isActive Alors Retour 
      
      
      SI Contient({_EVE.nom}..Groupe,::groupeActifInactif, SansCasse) ALORS
        {::ButtonToActivate}..Etat = actif
      	
      	
      	
      fin
      
     type : 458752
   -
     name : Activate
     procedure_id : 1769753918767874225
     type_code : 12
     code : |1+
      // Cette fonction permet le click 
      //
      //	pgroupeActifInactif : Groupe de champs qui sert à activer/desactiver les champs de la page 
      //
      PROCEDURE GLOBAL Activate(pgroupeActifInactif est un chaine =  "GR_ACTIF_INACTIF")
      if (pas ::initialized) THEN
      	WM_LBUTTONDOWN est un entier = 513
      	
      	Evénement(::OnFocus,".*",513)
      END
      ::groupeActifInactif = pgroupeActifInactif
      
      ::isActive = true
      
      
     type : 458752
   -
     name : Deactivate
     procedure_id : 1769765755697811291
     type_code : 12
     code : |1-
      PROCEDURE GLOBAL Deactivate()
      ::groupeActifInactif = null
      ::isActive = False
     type : 458752
