  -
    name : BTN_FERME
    identifier : 0x3b0b6b057fddd69a
    internal_properties : 
    properties :
     x : 437
     y : 273
     width : 80
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         
        type : 14
      -
        code : |1+
         // en mode création de mail
         si pbMode alors
         	// on remplit la liste des fichiers attachés
         	// et on le copie dans le répertoire des fichiers attachés
         	sListe  est une chaine
         	sFichierDest est une chaine
         	i est un entier
         	pour i=1 a TableOccurrence(TableFic)
         		sListe += col_ficat[i]+";"
         //		sFichierDest = frepencours()+"\"+CHEMIN+"\"+col_ficat[i]
         //		// création si inexistant du répertoire
         //		si pas frepcree(frepencours()+"\"+CHEMIN) alors
         //			Erreur("Impossible de créer le répertoire")
         //		fin
         //		// copie du fichier
         //		si pas fCopieFichier(col_fic[i],sFichierDest) alors
         //			erreur("Impossible de copier le fichier : ",""+col_fic[i],"vers :",sFichierDest)
         //		FIN
         	FIN
         fin
         
         ferme("",sListe)
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_AJOUT
    identifier : 0x3b0b6b0575e8d69a
    internal_properties : 
    properties :
     x : 265
     y : 273
     width : 80
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         
        type : 14
      -
        code : |1-
         si TableOccurrence(TableFic)=10 alors
         
         	acso_message("Erreur","Vous avez atteint le nombre maximum de fichiers attachés","Erreur")
         	retour
         FIN
         
         sFic est une chaine
         nTaille est un reel
         sFic = fSélecteur("","","Sélectionnez un fichier...","Tous fichiers (*.*)"+tab+"*.*","*",fSelOuvre+fSelExiste)
         si sFic<>"" alors
         	nTaille=ftaille(sFic)/1024
         	nTaille=arrondi(nTaille,2)
         	TableAjouteLigne(TableFic,sFic,nTaille+" Ko",sFic)
         FIN
         TABLESELECTPLUS(TableFic,tableoccurrence(TableFic))
        type : 18
      -
        type : 161
        enabled : false
