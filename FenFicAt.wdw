 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1+
      procedure FenFicAt(psListeFicAt="", pbMode=faux)
      
      // on remplit la table avec la liste des fichiers attachés
      sFichier est une chaine
      i est un entier
      nTaille est un reel
      
      i=1
      // on remplit la table des fichiers attachés
      sfichier = extraitchaine(psListeFicAt,i,";")
      tantque (sFichier<>"" et sFichier<>eot)
      	nTaille=ftaille(sfichier)/1024
      	ntaille=arrondi(ntaille,2)
      	TableAjouteLigne(TableFic,sfichier,nTaille+" Ko")
      	i++
      	TABLESELECTPLUS(TableFic,1)
      	sfichier = extraitchaine(psListeFicAt,i,";")
      FIN
      
      // état du bouton
      btn_ajout..visible=pbmode
      BTN_SUPPR..visible=pbmode
