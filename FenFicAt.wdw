         si col_ficat<>"" alors
         	// on ouvre le fichier attaché
         	si pas LanceAppliAssociée(col_ficat) alors
         		acso_message("Erreur","Aucune application n'est associée à ce fichier","Erreur")
         	FIN
         FIN
         
         
         
