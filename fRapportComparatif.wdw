  -
    name : IntParVendeur
    identifier : 0x26281bbff1f48e19
    internal_properties : 
    properties :
     x : 36
     y : 107
     width : 113
     height : 26
    options :
     -
       internal_properties : CQAAAAkAAAD8S6kPVjOqoNFTOiunK2e2RpLo1kSGmBgpRGh2o5fawBlUfDE6nmaX9YxUP5rpUzOgQhBKkLITdCDKG3QRiDq9q9Ld4bNpECw5JX2It+BCC0AIR+VM9Wq8CdYFyooNYrJPqTiC6th7m7I+fIqv0Fl33epWQZ6aTxO0ISEITyg=
    type : 5
    controls : []
    code_elements :
     type_code : 5
     p_codes :
      -
        code : |1+
         SI MoiMême ALORS
         	Combo_Vendeur..Etat  = Actif 
         	Combo_Vendeur = 0
         SINON
         	Combo_Vendeur..Etat = Inactif
         	Combo_Vendeur = -1
         FIN
         
        type : 17
  -
