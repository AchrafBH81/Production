  procedures :
   -
     name : rapportParVendeur
     procedure_id : 1596556691033159101
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      // rapportParVendeur ()
      //
      // Paramètres :
      //	Aucun
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE rapportParVendeur()
      
      TotalQuantite est un reel
      TotalArgent est un reel
      ltypeligne est une chaine
      reqsql est une source de donnees
      reqsql1 est une source de donnees
      txtsql est une chaine 
      Lastclient est une chaine = ""
      LastVendeur est un entier = 0
      LastNomClient est une chaine  =""
      lresult est une chaine = ""
      rGtotalArgent est un reel = 0
      ldateduRapport est une chaine = csddatedebut
      datetempo est une date = csddatedebut
      datetempo..Année--
      ldatedurapportanneeprec est une chaine =  datetempo
      ldatepremierjourmois est une chaine = PremierJourDuMois(ldateduRapport)
      ldatepremierjourmoisanneeprec est une chaine = PremierJourDuMois(ldatedurapportanneeprec)
      ldateannee est une chaine = gauche(ldateduRapport,4)
      ldateanneeprec est une chaine = gauche(ldatedurapportanneeprec,4)
      lmois est une chaine 
      
      POUR i =1 _a_ (val(milieu(ldateduRapport,5,2))-1)
      	lmois+=i+";"
      FIN
      
      sablier(vrai)
      
      
      
      
      HCréation(tempoHisto)
      RequêteHistoFactureDateParVendeur.bdateDebut = ldatepremierjourmois
      RequêteHistoFactureDateParVendeur.bDateFin = ldateduRapport
      HExécuteRequête(RequêteHistoFactureDateParVendeur)
      POUR TOUT RequêteHistoFactureDateParVendeur 
      	SI  HLitRecherche(tempoHisto,cvendeurnoClient,HConstruitValClé(tempoHisto,cvendeurnoClient,RequeteHistoFactureDateParVendeur.cvendeur,SansEspace(RequêteHistoFactureDateParVendeur.Bclient)),hIdentique) ALORS
      		tempoHisto.VenteDebutMois = RequêteHistoFactureDateParVendeur.la_somme_BStotal
      		HModifie(tempoHisto,hNumEnrEnCours)
      	SINON
      		HRAZ(tempoHisto)
      		tempoHisto.VenteDebutMois = RequêteHistoFactureDateParVendeur.la_somme_BStotal
      		tempoHisto.noClient = SansEspace(RequêteHistoFactureDateParVendeur.Bclient)
      		tempoHisto.NOMCLIENT = RequêteHistoFactureDateParVendeur.nom
      		tempoHisto.cvendeur = RequeteHistoFactureDateParVendeur.cvendeur
      		tempoHisto.NOmVendeur = RequeteHistoFactureDateParVendeur.nom_Ve
      		HAjoute(tempoHisto)
      	FIN
      FIN
      
      RequêteHistoFactureDateParVendeur.bdateDebut = ldatepremierjourmoisanneeprec
      RequêteHistoFactureDateParVendeur.bDateFin = ldatedurapportanneeprec
      HExécuteRequête(RequêteHistoFactureDateParVendeur)
      POUR TOUT RequêteHistoFactureDateParVendeur 
      	SI  HLitRecherche(tempoHisto,cvendeurnoClient,HConstruitValClé(tempoHisto,cvendeurnoClient,RequeteHistoFactureDateParVendeur.cvendeur,SansEspace(RequeteHistoFactureDateParVendeur.Bclient)),hIdentique) ALORS
      		tempoHisto.VenteDebutMoisprec = RequeteHistoFactureDateParVendeur.la_somme_BStotal
      		HModifie(tempoHisto,hNumEnrEnCours)
      	SINON
      		HRAZ(tempoHisto)
      		tempoHisto.VenteDebutMoisprec = RequeteHistoFactureDateParVendeur.la_somme_BStotal
      		tempoHisto.noClient = SansEspace(RequeteHistoFactureDateParVendeur.Bclient)
      		tempoHisto.NOMCLIENT = RequeteHistoFactureDateParVendeur.nom
      		tempoHisto.cvendeur = RequeteHistoFactureDateParVendeur.cvendeur
      		tempoHisto.NOmVendeur = RequeteHistoFactureDateParVendeur.nom_Ve		
      		HAjoute(tempoHisto)
      	FIN
      FIN
      
      RequêteHistoMoisDebutAnneeParVendeur.pAnnee = ldateannee
      RequêteHistoMoisDebutAnneeParVendeur.pMois = lmois
      HExécuteRequête(RequêteHistoMoisDebutAnneeParVendeur)
      POUR TOUT RequêteHistoMoisDebutAnneeParVendeur 
      	SI  HLitRecherche(tempoHisto,cvendeurnoClient,HConstruitValClé(tempoHisto,cvendeurnoClient,RequeteHistoMoisDebutAnneeParVendeur.cvendeur,SansEspace(RequeteHistoMoisDebutAnneeParVendeur.hClient)),hIdentique) ALORS
      		tempoHisto.VenteDebutAnnee = RequêteHistoMoisDebutAnneeParVendeur.la_somme_lvente
      		HModifie(tempoHisto,hNumEnrEnCours)
      	SINON
      		HRAZ(tempoHisto)
      		tempoHisto.VenteDebutAnnee = RequêteHistoMoisDebutAnneeParVendeur.la_somme_lvente
      		tempoHisto.noClient = SansEspace(RequêteHistoMoisDebutAnneeParVendeur.hClient)
      		tempoHisto.NOMCLIENT = RequêteHistoMoisDebutAnneeParVendeur.nom
      		tempoHisto.cvendeur  = RequeteHistoMoisDebutAnneeParVendeur.cvendeur
      		tempoHisto.NOmVendeur = RequeteHistoMoisDebutAnneeParVendeur.nom_Ve		
      		HAjoute(tempoHisto)
      	FIN
      FIN
      
      
      
      
      
      RequêteHistoMoisDebutAnneeParVendeur.pAnnee = ldateanneeprec
      RequêteHistoMoisDebutAnneeParVendeur.pMois = lmois
      HExécuteRequête(RequêteHistoMoisDebutAnneeParVendeur)
      POUR TOUT RequêteHistoMoisDebutAnneeParVendeur 
      	SI  HLitRecherche(tempoHisto,cvendeurnoClient,HConstruitValClé(tempoHisto,cvendeurnoClient,RequeteHistoMoisDebutAnneeParVendeur.cvendeur,SansEspace(RequeteHistoMoisDebutAnneeParVendeur.hClient)),hIdentique) ALORS
      		tempoHisto.VenbteDebutAnneePres = RequeteHistoMoisDebutAnneeParVendeur.la_somme_lvente
      		
      		HModifie(tempoHisto,hNumEnrEnCours)
      	SINON
      		HRAZ(tempoHisto)
      		tempoHisto.VenbteDebutAnneePres = RequeteHistoMoisDebutAnneeParVendeur.la_somme_lvente
      		tempoHisto.noClient = SansEspace(RequeteHistoMoisDebutAnneeParVendeur.hClient)
      		tempoHisto.NOMCLIENT = RequeteHistoMoisDebutAnneeParVendeur.nom
      		tempoHisto.cvendeur  = RequeteHistoMoisDebutAnneeParVendeur.cvendeur
      		tempoHisto.NOmVendeur = RequeteHistoMoisDebutAnneeParVendeur.nom_Ve
      		HAjoute(tempoHisto)
      	FIN
      FIN
      
      requeteDétailCommandeUnJour1.pDateCommande = ldateduRapport
      HExécuteRequête(requeteDétailCommandeUnJour1)
      //HCréation(trdetailListe)
      SI PAS HSupprimeTout(trdetailListe) ALORS
      	Erreur(HErreurInfo(hErrMessage))
      	RENVOYER Faux
      FIN
      POUR TOUT requeteDétailCommandeUnJour1
      	HCopieEnreg(trdetailListe,requeteDétailCommandeUnJour1)
      	trdetailListe.TNoclient = SansEspace(requeteDétailCommandeUnJour1.faclient)
      	trdetailListe.Tsurcharge = requeteDétailCommandeUnJour1.fsurchargepeinture
      	trdetailListe.surchargeenergie = requeteDétailCommandeUnJour1.surchargeenergie * requeteDétailCommandeUnJour1.fdqteafacturer / requeteDétailCommandeUnJour1.fdqte
      	
      	HAjoute(trdetailListe)
      FIN
      
      HExécuteRequête(RequetecommandeunjourFacture,hRequêteDéfaut,ldateduRapport)
      POUR TOUT RequetecommandeunjourFacture
      	HCopieEnreg(trdetailListe,RequetecommandeunjourFacture)
      	trdetailListe.TNoclient = SansEspace(RequetecommandeunjourFacture.faclient)
      	trdetailListe.Tsurcharge = RequetecommandeunjourFacture.fsurchargepeinture
      	HAjoute(trdetailListe)
      FIN
      
      HExécuteRequête(RequeteDetailUnJourV1)
      POUR TOUT RequeteDetailUnJourV1 
      	SI RequeteDetailUnJourV1.ftype = 1 ALORS
      		ltypeligne = "Verre"
      	SINON SI RequeteDetailUnJourV1.ftype = 2 
      		SI PAS RequeteDetailUnJourV1.fdverreunite ALORS
      			ltypeligne = "Unite"
      		SINON
      			ltypeligne = "Verre"
      		FIN
      	SINON SI RequeteDetailUnJourV1.ftype = 3
      		ltypeligne = "Fourniture" 
      	SINON SI RequeteDetailUnJourV1.ftype = 4
      		ltypeligne = "Carrelage" 
      	SINON SI RequeteDetailUnJourV1.ftype = 5
      		ltypeligne = "Peinture" 
      	FIN
      	
      	TotalArgent = 0 
      	TotalQuantite = 0
      	SELON ltypeligne
      		CAS "Unite"
      			TotalArgent +=  Arrondi(RequeteDetailUnJourV1.fdqteafacturer * RequeteDetailUnJourV1.fdprixu,2)
      		CAS "Fourniture"
      			//		totalpage +=  arrondi(requetebletat.fdqte * requetebLETAT.fdprixupied,2)
      			TotalArgent +=  Arrondi(RequeteDetailUnJourV1.fdqteafacturer * RequeteDetailUnJourV1.fdprixupied,2)
      			
      			
      		CAS "Verre"
      			//sinon
      			//		totalpage +=  arrondi(requetedetailunjourv1.fdqte * ((requetedetailunjourv1.fdpiedcarrefacture * requetedetailunjourv1.fdprixupiedfacture) + ...
      			//		requetedetailunjourv1.fdextraforme),2)
      			TotalArgent +=  Arrondi(RequeteDetailUnJourV1.fdqteafacturer * (RequeteDetailUnJourV1.fdpiedcarrefacture * RequeteDetailUnJourV1.fdprixupiedfacture),2)+ ...
      			Arrondi(RequeteDetailUnJourV1.fdqteafacturer *RequeteDetailUnJourV1.fdextraforme,2)+Arrondi(RequeteDetailUnJourV1.fdqteafacturer *RequeteDetailUnJourV1.FDextra10X,2)+...
      			Arrondi(RequeteDetailUnJourV1.fdqteafacturer *RequeteDetailUnJourV1.FDextra5x,2)
      			
      			//		totalfacture +=  arrondi(requetedetailunjourv1.fdqte * ((requetedetailunjourv1.fdpiedcarrefacture * requetedetailunjourv1.fdprixupiedfacture)+ ...
      			//		requetedetailunjourv1.fdextraforme),2)
      			
      			TotalQuantite+=RequeteDetailUnJourV1.fdqteafacturer 
      			
      			TotalArgent += Arrondi(RequeteDetailUnJourV1.surchargeenergie,2) //* requetedetailunjourv1.fdqteafacturer / requetedetailunjourv1.fdqte
      			//TotalArgent+= Arrondi(RequeteDetailUnJourV1.FDExtraCap * RequeteDetailUnJourV1.fdqteafacturer,2)
      			
      			
      			
      		CAS "Carrelage"
      			//		FIN
      			//		si requetedetailunjourv1.ftype = 2 et pas requetedetailunjourv1.fdverreunite alors
      			
      			TotalArgent +=  Arrondi((RequeteDetailUnJourV1.frcarrprixu + RequeteDetailUnJourV1.fdcarrprixdebase)* RequeteDetailUnJourV1.fdqteafacturer,2)...
      			+Arrondi(((RequeteDetailUnJourV1.Ftotalcarreaupeinture*RequeteDetailUnJourV1.fPrixCarreauPeinture)...
      			+(RequeteDetailUnJourV1.FDnbcarreauPeinture1*RequeteDetailUnJourV1.fdprixcarreaupeinture1))...
      			* RequeteDetailUnJourV1.fdqteafacturer ,2)
      			
      			
      			//		totalfacture +=  arrondi(requetedetailunjourv1.fdcarrprixtotal+requetedetailunjourv1.fTotalPeinture,2)
      			//		AlimenteHistoriqueProduit(sansespace(client.numero),requetedetailunjourv1.BDateFacture,2,requetedetailunjourv1.fdnumprod,"","","", arrondi(requetedetailunjourv1.fdqte * requetedetailunjourv1.fdprixu,2),...
      			//		requetedetailunjourv1.surchargeenergie,requetedetailunjourv1.fddesc,requetedetailunjourv1.fdqte)
      			//TotalArgent+=RequeteDetailUnJourV1.fdqteafacturer * RequeteDetailUnJourV1.fdcarreauh * RequeteDetailUnJourV1.fdcarreauv
      			
      		CAS "Peinture"
      			//		FIN
      			//		si requetedetailunjourv1.ftype = 2 et pas requetedetailunjourv1.fdverreunite alors
      			//TotalArgent +=  Arrondi(RequeteDetailUnJourV1.fdqteafacturer * (RequeteDetailUnJourV1.fdpiedcarrefacture * RequeteDetailUnJourV1.fdprixupied),2)
      			//		totalfacture +=  arrondi(requetedetailunjourv1.fdprixtotal,2)
      			TotalArgent+= Arrondi(RequeteDetailUnJourV1.fdprixtotal,2) * RequeteDetailUnJourV1.fdqteafacturer / RequeteDetailUnJourV1.fdqte
      			//		AlimenteHistoriqueProduit(sansespace(client.numero),requetedetailunjourv1.BDateFacture,2,requetedetailunjourv1.fdnumprod,"","","", arrondi(requetedetailunjourv1.fdqte * requetedetailunjourv1.fdprixu,2),...
      			//		requetedetailunjourv1.surchargeenergie,requetedetailunjourv1.fddesc,requetedetailunjourv1.fdqte)
      			
      	FIN
      	
      	
      	SI  HLitRecherche(tempoHisto,cvendeurnoClient,HConstruitValClé(tempoHisto,cvendeurnoClient,RequeteDetailUnJourV1.cvendeur,SansEspace(RequeteDetailUnJourV1.TNoclient))) ALORS
      		tempoHisto.VenteQuotidienne += TotalArgent
      		tempoHisto.QteQuotidienne +=TotalQuantite
      		HModifie(tempoHisto,hNumEnrEnCours)
      	SINON
      		HRAZ(tempoHisto)
      		tempoHisto.VenteQuotidienne =TotalArgent
      		tempoHisto.QteQuotidienne =TotalQuantite
      		tempoHisto.noClient = SansEspace(RequeteDetailUnJourV1.TNoclient)
      		tempoHisto.NOMCLIENT = RequeteDetailUnJourV1.nom
      		tempoHisto.cvendeur = RequeteDetailUnJourV1.cvendeur
              tempohisto.NOmVendeur = RequeteDetailUnJourV1.nom_Ve
      		HAjoute(tempoHisto)
      	FIN
      FIN
      fid est un entier = fouvre("c:\liste,txt",foCréation)
      
      txtsql = [
      SELECT 
      Facture.faclient AS faclient,	
      Facture.fanumero AS fanumero,	
      Client.nom AS nom,	
      Facture.fatypedocument AS fatypedocument,	
      Facture.FPREPARATION AS FPREPARATION,
      facture.cvendeur as cvendeur
      FROM 
      Client,	
      Facture
      WHERE 
      Facture.IDClient	=	Client.IDClient
      AND
      (
      Facture.FPREPARATION <> 'B'
      AND	Facture.fatypedocument = 1
      AND	Facture.fanumero <> 0
      )
      ORDER BY 
      faclient ASC
      
      
      ]
      HExécuteRequêteSQL(reqsql,hRequêteDéfaut,txtsql)
      
      TotalArgent = 0
      TotalQuantite = 0 
      POUR TOUT reqsql 
      	SI (reqsql.faclient <> Lastclient ET PAS Lastclient = "") ou (reqsql.cvendeur <> LastVendeur ET PAS LastVendeur = 0) ALORS
      		SI  HLitRecherche(tempoHisto,cvendeurnoClient,hconstruitvalcle(tempoHisto,cvendeurnoClient,LastVendeur,SansEspace(Lastclient))) ALORS
      			tempoHisto.VentesEnCours = TotalArgent
      			tempoHisto.QteEnCours=TotalQuantite
      			HModifie(tempoHisto,hNumEnrEnCours)
      		SINON
                  hlitrecherche(Vendeur,IDVendeur,LastVendeur)
                  
      			HRAZ(tempoHisto)
      			tempoHisto.VentesEnCours +=TotalArgent
      			tempoHisto.QteEnCours +=TotalQuantite
      			//			tempoHisto.noClient = SansEspace(reqsql.faclient)
      			tempoHisto.noClient = SansEspace(Lastclient)
      			//			tempoHisto.NOMCLIENT =reqsql.nom
      			tempoHisto.NOMCLIENT =LastNomClient
      			tempoHisto.cvendeur = LastVendeur
      			tempohisto.NOmVendeur = vendeur.nom
      			HAjoute(tempoHisto)
      		FIN
      		
      		Lastclient = reqsql.faclient 
      		LastNomClient = reqsql.nom
      		LastVendeur = reqsql.cvendeur
      		TotalArgent = 0
      		TotalQuantite = 0 
      	FIN
      	Lastclient = reqsql.faclient
      	LastNomClient = reqsql.nom
      	LastVendeur = reqsql.cvendeur
      	lresult =calculTotalCommande(reqsql.fanumero)
      	fEcritLigne(fid,reqsql.fanumero+";"+ExtraitChaîne(lresult,1,";"))
      	
      	TotalArgent += Val(ExtraitChaîne(lresult,1,";"))
      	TotalQuantite += Val(ExtraitChaîne(lresult,2,";"))
      	
      	
      FIN
      
      
      SI  HLitRecherche(tempoHisto,cvendeurnoClient,HConstruitValClé(tempoHisto,cvendeurnoClient,LastVendeur,SansEspace(Lastclient))) ALORS
      	tempoHisto.VentesEnCours += TotalArgent
      	tempoHisto.QteEnCours+=TotalQuantite
      	HModifie(tempoHisto,hNumEnrEnCours)
      SINON
      	HLitRecherche(Vendeur,IDVendeur,LastVendeur)
      	HRAZ(tempoHisto)
      	tempoHisto.VentesEnCours =TotalArgent
      	tempoHisto.QteEnCours =TotalQuantite
      	tempoHisto.noClient = SansEspace(reqsql.faclient)
      	tempoHisto.NOMCLIENT = reqsql.nom
      	tempohisto.cvendeur = reqsql.cvendeur
          tempohisto.NOmVendeur = vendeur.nom
      	HAjoute(tempoHisto)
      FIN
      HAnnuleDéclaration(reqsql)
      
      
      
      txtsql = [
      SELECT 
      BonLivraison.Bnumero AS Bnumero,	
      BonLivraison.Bdate AS Bdate,	
      BonLivraison.Bclient AS Bclient,	
      hfacture.fanumero AS fanumero,	
      hfacture.fadate AS fadate,	
      hfacture.fadatecommande AS fadatecommande,	
      hfacture.FPREPARATION AS FPREPARATION,	
      hfacture.fatypedocument AS fatypedocument,	
      hfacture.faclient AS faclient,	
      hfacture.cvendeur AS cvendeur,
      hfacture.HFCLEUNIK AS HFCLEUNIK,	
      Client.nom AS nom
      FROM 
      BonLivraison INNER JOIN hfacture ON hfacture.Bnumero	=	BonLivraison.Bnumero,	
      //BonLivraison LEFT OUTER JOIN Client ON Client.numero	=	BonLivraison.Bclient
      BonLivraison INNER JOIN Client ON Client.numero	=	BonLivraison.Bclient
      WHERE 
      (
      BonLivraison.Bfacture = 0
      )
      ORDER BY 
      fanumero ASC,	
      Bnumero ASC
      ]
      
      HExécuteRequêteSQL(reqsql1,hRequêteDéfaut,txtsql)
      
      
      TotalArgent = 0
      TotalQuantite = 0 
      Lastclient = ""
      LastVendeur = 0
      POUR TOUT reqsql1 
      	SI (reqsql1.faclient <> Lastclient ET PAS Lastclient = "") OU (reqsql1.cvendeur <> LastVendeur ET PAS LastVendeur = 0) ALORS
      		SI  HLitRecherche(tempoHisto,cvendeurnoClient,HConstruitValClé(tempoHisto,cvendeurnoClient,LastVendeur,SansEspace(Lastclient))) ALORS
      			tempoHisto.VentesEnCours += TotalArgent
      			tempoHisto.QteEnCours +=TotalQuantite
      			HModifie(tempoHisto,hNumEnrEnCours)
      			
      		SINON
      			HRAZ(tempoHisto)	
      			HLitRecherche(Vendeur,IDVendeur,LastVendeur)
      			tempoHisto.VentesEnCours =TotalArgent
      			tempoHisto.QteEnCours =TotalQuantite
      			//			tempoHisto.noClient = SansEspace(reqsql1.faclient)
      			//			tempoHisto.NOMCLIENT = reqsql1.nom
      			tempoHisto.noClient = SansEspace(Lastclient)
      			tempoHisto.NOMCLIENT = LastNomClient
      			tempoHisto.cvendeur = LastVendeur
      			tempoHisto.NOmVendeur = Vendeur.nom
      			HAjoute(tempoHisto)
      		FIN
      		
      		Lastclient = reqsql1.faclient 
      		LastNomClient = reqsql1.nom
      		LastVendeur = reqsql1.cvendeur
      		TotalArgent = 0
      		TotalQuantite = 0 
      	FIN
      	Lastclient = reqsql1.faclient
      	LastNomClient = reqsql1.nom
      	LastVendeur = reqsql1.cvendeur
      	lresult = calculTotalCommandeBL(reqsql1.hfcleunik)
      	TotalArgent += Val(ExtraitChaîne(lresult,2,";"))
      	TotalQuantite += Val(ExtraitChaîne(lresult,1,";"))
      	
      	
      FIN
      
      SI  HLitRecherche(tempoHisto,cvendeurnoClient,HConstruitValClé(tempoHisto,cvendeurnoClient,LastVendeur,SansEspace(Lastclient))) ALORS
      	tempoHisto.VentesEnCours += TotalArgent
      	tempoHisto.QteEnCours +=TotalQuantite
      	
      	HModifie(tempoHisto,hNumEnrEnCours)
      	
      SINON
      	HLitRecherche(Vendeur,IDVendeur,LastVendeur)
      	HRAZ(tempoHisto)
      	tempoHisto.VentesEnCours =TotalArgent
      	tempoHisto.QteEnCours =TotalQuantite
      	tempoHisto.noClient = SansEspace(reqsql1.faclient)
      	tempoHisto.NOMCLIENT = reqsql1.nom
      	tempoHisto.cvendeur = reqsql1.cvendeur
      	tempoHisto.NOmVendeur = Vendeur.nom
      	HAjoute(tempoHisto)
      FIN
      
      POUR TOUT tempoHisto 
      	SI HLitRecherche(Client,numero,tempoHisto.noClient) ALORS
      		tempoHisto.CategClient = Client.categorie
      		HModifie(tempoHisto,hNumEnrEnCours)
      	FIN
      FIN
      sablier(faux)
      SI SélecteurDestination = 1 ALORS
      	iAperçu()
      FIN
      
      si fRapportComparatif.IntParCategorie alors
      	iImprimeEtat(EHistoSommaireParVendeurEtCategorie,csddatedebut,Combo_Vendeur = "0" ? 0 SINON Combo_Vendeur)
      	
      sinon	
      	iImprimeEtat(EHistoSommaireParVendeur,csddatedebut,Combo_Vendeur = "0" ? 0 sinon combo_vendeur)
      fin
      
      
      
      
