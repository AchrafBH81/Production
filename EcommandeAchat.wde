 controls : []
 code_elements :
  type_code : 13
  p_codes : []
  procedures :
   -
     name : assigneLibelle
     procedure_id : 5060330147702671563
     type_code : 14
     code : |1+
      Procédure assigneLibelle()
      i est un entier
      
      lTableauLibelle est un tableau de  13 chaines
      lTableauLibelle[1]  = "acommandeachat"
      lTableauLibelle[2]  = "facpage"
      lTableauLibelle[3]  = "facpagede"
      lTableauLibelle[4]  = "anumerocommande"
      lTableauLibelle[5]  = "facdate"
      lTableauLibelle[6]  = "anumeroproduit"
      lTableauLibelle[7]  = "ldescription"
      lTableauLibelle[8]  = "aquantite"
      lTableauLibelle[9]  = "acoutuni"
      lTableauLibelle[10] = "acouttotal"
      lTableauLibelle[11] = "atotal"
      lTableauLibelle[12] = "plustaxe"
      lTableauLibelle[13] = "facdate1"
      
      
      
      
      selon fournisseur.fLangue
      	cas 0,1
      		pour i = 1 a 13
      			si hlitrecherche(Traduction,TRecherche,lTableauLibelle[i]) alors
      				{"ecommandeachat."+lTableauLibelle[i]} = traduction.dFrancais
      			fin
      		FIN
      
      	cas 2
      		pour i = 1 a 13
      			si hlitrecherche(Traduction,TRecherche,lTableauLibelle[i]) alors
      				{"ecommandeachat."+lTableauLibelle[i]} = traduction.danglais
      			fin
      		FIN
      fin
      
     type : 458752
  procedure_templates : []
  property_templates : []
