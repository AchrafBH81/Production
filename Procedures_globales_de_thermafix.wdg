   -
     name : CheckDimensionException
     procedure_id : 1398047546071430618
     type_code : 15
     code : |1+
      // Résumé : marquer un thermos qui vont être au mur dans le camion pour la livraison
      //    Si les 2 cotés sont plus grand que 850mm 
      //    si un des 2 cotés est plus grand que 2050mm
      //    si c'est une forme.
      // Syntaxe :
      //CheckDimensionException (<nNoCommande> est entier sur 8 octets)
      //
      // Paramètres :
      //	nNoCommande (entier sur 8 octets) : <indiquez ici le rôle de sNoCommande>
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      //	
      PROCEDURE CheckDimensionException(nNoCommande est un entier sur 8 octets)
      bOrderException est un booleen = faux
      bOrderNoExecption est un booleen = Faux
      nHauteurMetrique est un entier
      nLargeurMetrique est un entier
      
      
      si hlitrecherche(Facture,fanumero,nNoCommande) alors
      	pour tout fdetail avec "fdnocomm = "+nNoCommande
      		si fdetail.ftype = 1 alors
      			Fdetail.ExceptionForShippingBill =  faux
      			selon facture.facalcul
      				CAS 1
      					nHauteurMetrique = Arrondi(InchFractionToMillimeter(Fdetail.fdhauteura))
      					nLargeurMetrique = Arrondi(InchFractionToMillimeter(Fdetail.fdlargeura))
      					
      					SI sansespace(fdetail.fdforme) <> "" _ou_ (nLargeurMetrique > 850 _ET_ nHauteurMetrique > 850) _ou_ (nLargeurMetrique > 2100 _OU_ nHauteurMetrique > 2100)  ALORS
      						fdetail.ExceptionForShippingBill =  Vrai
                         fin
                         
      				CAS 2
      					si SansEspace(Fdetail.fdforme) <> "" _OU_ (val(Fdetail.fdlargeura) > 850 _et_ Val(Fdetail.fdhauteura) > 850) _OU_ (val(Fdetail.fdlargeura) > 2100 _OU_ val(Fdetail.fdhauteura) > 2100) alors
      						Fdetail.ExceptionForShippingBill =  Vrai
      					FIN
      				
      				AUTRE CAS
      					
      			FIN
      			hmodifie(fdetail,hNumEnrEnCours)
      		FIN
      	fin
      	
      fin
      
      
