     name : remplirFourniture
     procedure_id : 5054811784255195327
     type_code : 15
     code : |1+
      Procédure remplirFourniture()
      i est un entier
      
      hlit(config,1)
      pour i = 1 a  10
      	{"produits.libelleDescription"+i}..libelle = sansespace(config.descriptionFourniture[i])
      fin	
     type : 458752
   -
     name : epurefactureTRN
     procedure_id : 5160634500147449377
     type_code : 15
     code : |1+
      Procédure epurefactureTRN(numeroenregistrement,lignedetable)
      nTotalToProduced est un entier = 0
      lcombinetaxe est un booleen = faux
      prepfacture.majhistorique(numeroenregistrement,lignedetable)
      toutelafacture = vrai
      
      hlit("Facture",numeroenregistrement)
      hlitrecherche("fdetail","fdnocomm",facture.fanumero)
      
      tantque fdetail.fdnocomm = facture.fanumero et pas HEnDehors()
      	fdetail.fdqtedejafacture =  fdetail.fdqtedejafacture + fdetail.fdqteafacturer
      	fdetail.fdqteafacturer = fdetail.fdqte - fdetail.fdqtedejafacture
          fdetail.SUrchargedejafacture = fdetail.SUrchargedejafacture+fdetail.SUrchargeafacturer
          fdetail.SUrchargeafacturer = fdetail.surchargeenergie- fdetail.SUrchargedejafacture
      	Fdetail.Fdqte_Produced			= 0
      	Fdetail.Fdqte_BackOrder			= 0
      	Fdetail.Fdqte_BackOrderreason	= ""    
       //   fdetail.Fdqte_Produced = 0    
      	SI Fdetail.ftype = 1 ALORS  nTotalToProduced += Fdetail.fdqteafacturer	
      	si fdetail.fdqteafacturer <> 0 alors
      		toutelafacture = faux
      	fin
      	hmodifie("fdetail")
      	hlitsuivant("fdetail","fdnocomm")
      FIN
      lcombinetaxe = facture.fCombineTaxe
      si toutelafacture alors
      	facture.FPREPARATION = "B"
      	facture.livrepartiel = ""
          facture.NumberOfThermosProduced = 0
      	hmodifie(Facture,hNumEnrEnCours)
      sinon
          facture.livrepartiel = "P"
      	facture.faimprimer = 0
      	Facture.NumberOfThermosToProduce	= nTotalToProduced
      	Facture.NumberOfThermosProduced		= 0
      	Facture.Started						= 0
      	Facture.Completed					= 0
      	Facture.NumberOfThermosBackOrdered	= 0
      	
      	hmodifie(facture,hNumEnrEnCours)	
      FIN
      
      renvoyer lcombinetaxe
      
     type : 458752
   -
     name : SupprimeFactureTRN
     procedure_id : 5161687418575082928
     type_code : 15
     code : |1+
      
      Procédure SupprimeFactureTRN()
      
      toutelafacture = vrai
      
      tabOrders	est un tableau d'entier
      nRes		est un entier
      
      
      pour TOUT ReqGroupShippingBill  
      	nRes 	= tabOrders.cherche(tcLinéaire,ReqGroupShippingBill.fanumero)
      	si nRes = -1 alors
      		tabOrders.ajoute( ReqGroupShippingBill.fanumero)
      	fin	   
      	si hlitrecherche(Fdetail,fdnocommfdligne,[ReqGroupShippingBill.fanumero,ReqGroupShippingBill.fdligne]) alors
      		fdetail.QteFactureReel += ReqGroupShippingBill.fdqteafacturer
      		hmodifie(Fdetail,hNumEnrEnCours)
      		
      	FIN
      FIN
      
      
      pour chaque nOrder de tabOrders
      	
      	
      	
      	si hlitrecherche(Facture,fanumero,nOrder) alors
      		
      		
      		pour tout fdetail avec "FDNOCOMM = "+nOrder	
      			si fdetail.QteFactureReel <> fdetail.fdqte alors
      				toutelafacture = faux
      			sinon
      				hsupprime("fdetail",hnumenrencours)
      				
      			fin
      		fin	
      		
      		si hErreurIntégrité() alors
      		FIN
      		
      		
      		si toutelafacture alors
      			hsupprime("Facture",hNumEnrEnCours)
      		FIN
      		si hErreurIntégrité() alors
      		FIN
      		
      		
      	fin
      	
      FIN
      
      
     type : 458752
   -
     name : calcul_prix_carr
     procedure_id : 5162795232905005176
     type_code : 15
     code : |1+
      Procédure calcul_prix_carr(lnoclient,numerocarrelage)
      // Carrelage
      clederecherche est une chaine
      escompte_carrelage est un reel
      prixcarrpied est un reel 
      lprixcarrU est un reel
      lprixcarrUc est un reel
      lprixcarrbase est un reel
      
      escompteqte = faux
      //prixdebasecarrelage est un reel
      hlitrecherche(client,numero,lnoclient)
      
      
      
      		si 	hlitrecherche("invent","INUM",numerocarrelage) alors
      			lprixcarrU = invent.iprixm
      			lprixcarrUc = invent.iprixcarreau
      			lprixcarrbase = invent.iprixbasecarrelage  
      		FIN
      		
      		//  commandetrn.prix_carreau = 3.25
      		clederecherche = HConstruitValClé(ProduitClient,IdClientIdproruit,lnoclient,numerocarrelage)
      		si hlitrecherche(ProduitClient,IdClientIdproruit,clederecherche,hIdentique) ALORS
      			si produitclient.IPprixSpecial alors
      				lprixcarrUc = produitclient.iprixa
      				lprixcarrbase = produitclient.iprixm
      			fin
      		fin
      		si hfdetail.TDemiCarrelage alors
      			lprixcarrUcC+=client.Cextracarrelagedemi
      		fin
      
      //		si commandetrn.cdcarrelage alors
      
      			hfdetail.frcarrprixu = hfdetail.fdnbcarreau * lprixcarrUc
      			hfdetail.fdcarrprixdebase=lprixcarrbase 
      			hfdetail.fdcarrprixtotal = (hfdetail.frcarrprixu + hfdetail.fdcarrprixdebase)* hfdetail.fdqteafacturer 
                  hmodifie(hfdetail,hNumEnrEnCours)
      //		sinon
      //			commandetrn.cdcarrprixu = commandetrn.nombre_de_carreau * commandetrn.cdcarrprixuc 
      //			commandetrn.cdcarrprixtotal = (commandetrn.cdcarrprixu * commandetrn.cdqte) + (commandetrn.cdprixdebasecarrelage  * commandetrn.cdqte)
      //			commandetrn.cdprixu = commandetrn.nombre_de_carreau * commandetrn.cdcarrprixuc 
      //			commandetrn.cdprixtot = (commandetrn.cdcarrprixu * commandetrn.cdqte) + (commandetrn.cdprixdebasecarrelage * commandetrn.cdqte)
      //
      //		fin
      
      
      
      
      
      
      
     type : 458752
