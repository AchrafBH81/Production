   -
     name : CalculPoidsCommande
     procedure_id : 2140090218591920053
     type_code : 15
     code : |1-
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] CalculPoidsCommande (<idcommande> est entier)
      //
      // Paramètres :
      //	idcommande (entier) : <indiquez ici le rôle de idcommande>
      // Valeur de retour :
      // 	réel : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE CalculPoidsCommande(idcommande est un entier)
      
      txtsql est une chaîne = [
      Select thermostype,fdpiedcarrereel,fdqteafacturer,fdbase from fdetail where fdnocomm = %1 and thermostype IN('S','D','T')
      ]
      reqsql est une source de Données
      PoidsPourCalcul est un reel
      Epaisseur est un entier  
      PoidsTotal est un reel =0
      
      si hlitrecherche(Facture,FACLEUNIK,idcommande) ALORS
        si hexecuterequetesql(reqsql,hRequêteDéfaut,ChaîneConstruit(txtsql,facture.fanumero)) alors
           pour tout reqsql
           	Epaisseur = Val(Droite(SansEspace(reqsql.fdbase),1))
              si 3 <= Epaisseur <= 6 alors  
                 selon reqsql.thermostype
      					CAS "S"
      						PoidsPourCalcul = tabPoidsthermos[Epaisseur].esimple
      					CAS "D"
      						PoidsPourCalcul = tabPoidsthermos[Epaisseur].edouble
      					CAS "T"
      						PoidsPourCalcul = tabPoidsthermos[Epaisseur].etriple
      				fin
                  
              fin
              PoidsTotal += ( PoidsPourCalcul * reqsql.fdpiedcarrereel * reqsql.fdqteafacturer)
      
           fin
           	
           	
        fin
        		
      	
      FIN
      
      renvoyer PoidsTotal
     type : 458752
   -
     name : CalculPoidsThermos
     procedure_id : 2140123818139123402
     type_code : 15
     code : |1-
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] CalculPoidsThermos (<Surface> est réel sur 4 octets, <sThermosType> est chaîne, <Pbase> est chaîne, <Facalcul> est entier)
      //
      // Paramètres :
      //	Surface (réel sur 4 octets) : <indiquez ici le rôle de idcommande>
      //	sThermosType (chaîne ANSI) : <indiquez ici le rôle de NoLigne>
      //	Pbase (chaîne ANSI) : <indiquez ici le rôle de Pbase>
      //	Facalcul (entier) : <indiquez ici le rôle de Facalcul>
      // Valeur de retour :
      // 	réel : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE CalculPoidsThermos(Surface est un reel sur 4 octets,sThermosType est une chaîne,Pbase est une chaine,Facalcul est un entier sans signe sur 1 octet)
      
      
      
      PoidsPourCalcul est un reel
      Epaisseur est un entier  
      PoidsTotal est un reel =0
      surfacePourCalcul est un reel = Surface
      si Facalcul = 2 alors surfacePourCalcul = Surface * 10.764
      
      
           	Epaisseur = Val(Droite(SansEspace(Pbase),1))
              si 3 <= Epaisseur <= 6 alors  
                 selon sThermosType
      					CAS "S"
      						PoidsPourCalcul = tabPoidsthermos[Epaisseur].esimple
      					CAS "D"
      						PoidsPourCalcul = tabPoidsthermos[Epaisseur].edouble
      					CAS "T"
      						PoidsPourCalcul = tabPoidsthermos[Epaisseur].etriple
      				fin
                  
              fin
              PoidsTotal += ( PoidsPourCalcul * surfacePourCalcul)
      
      
           	
      
        		
      	
      
      
      renvoyer PoidsTotal
     type : 458752
   -
     name : majtracking
     procedure_id : 2271597358178304407
     type_code : 15
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //majtracking (<nInvoiceNumber>, <scomputername>, <bisEdi> [, <sCustomerNumber> est chaîne [, <bIsEdiWeb> est booléen]])
      //
      // Paramètres :
      //	nInvoiceNumber : <indiquez ici le rôle de InvoiceNumber>
      //	scomputername : <indiquez ici le rôle de scomputername>
      //	bisEdi : <indiquez ici le rôle de bisEdi>
      // 	sCustomerNumber (chaîne ANSI - valeur par défaut="") : <indiquez ici le rôle de sCustomerNumber>
      // 	bIsEdiWeb (booléen - valeur par défaut=0) : <indiquez ici le rôle de bIsEdiWeb>
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      //	IdFacture : <indiquez ici le rôle de IdFacture>
      //	sComputerName : <indiquez ici le rôle de ComputerName>
      //	bfactureisedi : <indiquez ici le rôle de isedi>
      PROCEDURE majtracking(nInvoiceNumber,scomputername,bisEdi,sCustomerNumber est une chaine  ="",bIsEdiWeb est un booleen = faux)
      
      nNumberOfGrill est un entier
      NumberOfThermos est un entier
      Amount est un monetaire = calculTotalCommande(nInvoiceNumber)
      NumberOfLines est un entier 
      (NumberOfLines,NumberOfThermos) = calculNumberOfLineInOrder(nInvoiceNumber)
      
      si pas hlitrecherche(Tracking,InvoiceNumber,nInvoiceNumber) alors
      	tracking.Computername = scomputername
      	tracking.Username = gsuser
      	selon facture.fatypedocument
      		cas 1
      			Tracking.DocumentType =  "F"
      		cas 2
      			Tracking.DocumentType = "C"
      		cas 3
      			Tracking.DocumentType = "S"
      			
      		AUTRE CAS
      			
      	FIN
      	tracking.InvoiceNumber = nInvoiceNumber
      	tracking.IsEDI = tracking.DocumentType = "F" ? bisEdi sinon 0
      	tracking.NumberOfThermos = NumberOfThermos
      	tracking.NumberOfLines = NumberOfLines
      	tracking.Amount = Amount
      	tracking.InvoiceDate = facture.fadate
      
      	hajoute(tracking)
      	
      	
      sinon
      	Tracking.NumberOfThermos = NumberOfThermos
      	Tracking.NumberOfLines = NumberOfLines
      	Tracking.Amount = Amount
      	tracking.InvoiceDate = facture.fadate
      	tracking.isedi = facture.isedi
      	SELON Facture.fatypedocument
      		CAS 1
      			Tracking.DocumentType =  "F"
      		CAS 2
      			Tracking.DocumentType = "C"
      		CAS 3
      			Tracking.DocumentType = "S"
      			
      		AUTRE CAS
      			
      	FIN
      	Hmodifie(tracking,hNumEnrEnCours)
      	
      FIN
      
      
      
      
     type : 458752
   -
     name : calculNumberOfLineInOrder
     procedure_id : 2271957207754175316
     type_code : 15
     code : |1-
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] calculNumberOfLineInOrder (<InvoiceNumber>)
      //
      // Paramètres :
      //	InvoiceNumber : <indiquez ici le rôle de InvoiceNumber>
      // Valeur de retour :
      // 	multi-valeur : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE calculNumberOfLineInOrder(InvoiceNumber)
      numberofthermos est un entier = 0
      Numberoflines est un entier
      reqsql est une source de donnees
      reqsql1 est une source de donnees
      
      txtsql est une chaine = [
      	select sum(fdetail.fdqte) as numberofthermos from fdetail where fdetail.fdnocomm = %1 and fdetail.ftype = 1 and fdetail.thermostype <> 'S'
      ]
      txtsql1 est une chaine = [
      	select count(fdetail.fdnocomm) as numberoflines from fdetail where fdetail.fdnocomm = %1 and fdetail.ftype = 1
      ]
      
      si HExécuteRequêteSQL(reqsql,ChaîneConstruit(txtsql,InvoiceNumber))   alors
      	NumberOfThermos = reqsql.numberofthermos
      FIN
      
      SI HExécuteRequêteSQL(reqsql1,ChaîneConstruit(txtsql1,InvoiceNumber))  ALORS
      	NumberOfLines = reqsql1.numberoflines <> null ? reqsql1.numberoflines sinon 0 
      FIN
      
      renvoyer (NumberOfLines,NumberOfThermos)
     type : 458752
