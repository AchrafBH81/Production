     name : majtrackingHisto
     procedure_id : 2272539742929095065
     type_code : 15
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //majtrackingHisto (<nInvoiceNumber>)
      //
      // Paramètres :
      // 	nInvoiceNumber : <indiquez ici le rôle de nInvoiceNumber>
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      //	IdFacture : <indiquez ici le rôle de IdFacture>
      //	sComputerName : <indiquez ici le rôle de ComputerName>
      //	bfactureisedi : <indiquez ici le rôle de isedi>
      //	scomputername : <indiquez ici le rôle de scomputername>
      //	bisEdi : <indiquez ici le rôle de bisEdi>
      //	nInvoiceNumber : <indiquez ici le rôle de InvoiceNumber>
      PROCEDURE majtrackingHisto(nInvoiceNumber)
      txtsql est une chaine = [
      	Select lutilisateur as computername from logfile 
      	where logfile.lnocommande = %1 and LogFile.lFonction = 'HAjoute'
      ]
      reqsqlCN est une source de donnees
      scomputername est une chaine = ""
      si HExécuteRequêteSQL(reqsqlCN,hRequêteDéfaut,chaineconstruit(txtsql,nInvoiceNumber)) _et_ hnbenr(reqsqlCN) > 0 ALORS
      	hlit(reqsqlCN,1)
      	scomputername = reqsqlCN.computername
      FIN
      
      
      
      
      
      NumberOfGrill est un entier
      NumberOfThermos est un entier
      Amount est un monetaire = calculTotalCommandehisto(nInvoiceNumber)
      NumberOfLines est un entier 
      (NumberOfLines,NumberOfThermos) = calculNumberOfLineInOrderhisto(nInvoiceNumber)
      bisEdi est un booleen = sansespace(hfacture.IdEdiKey) <> ""
      
      si pas hlitrecherche(Tracking,InvoiceNumber,nInvoiceNumber) alors
      	tracking.Computername = scomputername
      	selon hfacture.fatypedocument
      		cas 1
      			Tracking.DocumentType =  "F"
      		cas 2
      			Tracking.DocumentType = "C"
      		cas 3
      			Tracking.DocumentType = "S"
      			
      		AUTRE CAS
      			
      	FIN
      	tracking.InvoiceNumber = nInvoiceNumber
      	tracking.IsEDI = bisEdi
      	tracking.NumberOfThermos = NumberOfThermos
      	tracking.NumberOfLines = NumberOfLines
      	tracking.Amount = Amount
      	tracking.InvoiceDate = hfacture.fadatecommande
      	hajoute(tracking)
      	
      	
      sinon
      	Tracking.NumberOfThermos = NumberOfThermos
      	Tracking.NumberOfLines = NumberOfLines
      	Tracking.Amount = Amount
      	Hmodifie(tracking,hNumEnrEnCours)
      	
      FIN
      
      
      
      
     type : 458752
