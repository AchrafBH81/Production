   -
     name : calculNumberOfLineInOrderHisto
     procedure_id : 2272540193900831087
     type_code : 15
     code : |1-
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] calculNumberOfLineInOrderHisto (<InvoiceNumber>)
      //
      // Paramètres :
      //	InvoiceNumber : <indiquez ici le rôle de InvoiceNumber>
      // Valeur de retour :
      // 	multi-valeur : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE calculNumberOfLineInOrderHisto(InvoiceNumber)
      numberofthermos est un entier = 0
      Numberoflines est un entier
      reqsqlNL est une source de donnees
      reqsqlNL1 est une source de donnees
      
      txtsql est une chaine = [
      	select sum(hfdetail.fdqte) as numberofthermos,
      	CASE WHEN hfdetail.fdcomposant3 = '' and hfdetail.fdcomposant2 = '' THEN 'S' ELSE 'D' end as Thermostype
      	from hfdetail 
      	where hfdetail.fdnocomm = %1 and hfdetail.ftype = 1 and thermostype <> 'S' 
      	group by thermostype
      ]
      txtsql1 est une chaine = [
      	select count(hfdetail.fdnocomm) as numberoflines from hfdetail where hfdetail.fdnocomm = %1 
      ]
      
      si HExécuteRequêteSQL(reqsqlNL,ChaîneConstruit(txtsql,InvoiceNumber)) _and_ hnbenr(reqsqlNL) <> 0   alors
      	hlit(reqsqlNL,1)
      	numberofthermos = reqsqlNL.numberofthermos
      FIN
      
      SI HExécuteRequêteSQL(reqsqlNL1,ChaîneConstruit(txtsql1,InvoiceNumber)) _AND_ HNbEnr(reqsqlNL1) <> 0   ALORS
      	hlit(reqsqlNL1,1)
      	Numberoflines = reqsqlNL1.numberoflines <> null ? reqsqlNL1.numberoflines sinon 0 
      FIN
      
      renvoyer (Numberoflines,numberofthermos)
     type : 458752
   -
     name : GetNextOrderNumber
     procedure_id : 1217225819775061920
     type_code : 15
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] GetNextOrderNumber ()
      //
      // Paramètres :
      //	Aucun
      // Valeur de retour :
      // 	entier : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE GetNextOrderNumber()
      nCpt est un entier
      nNextNumber est un entier
      
      
      BOUCLE
      	HLitPremier(config,COCLEUNIK,hBlocageLectureEcriture)
      	SI HErreurBlocage() ALORS
      		nCpt++
      		si nCpt > 30 alors
      			sortir
      		FIN
      	sinon
      		sortir
      	FIN
      FIN
      
      si nCpt > 30 alors renvoyer 0
      BOUCLE 
      	
      	nNextNumber = config.Numcomm
      	config.Numcomm = nNextNumber + 1
      	HModifie(config,hNumEnrEnCours)
      	HForceEcriture(config)
      	SI PAS HRecherche(Facture,fanumero,nNextNumber) ALORS
      		SORTIR
      	FIN
      FIN
      
      HDébloqueFichier(config)
      renvoyer nNextNumber
     type : 458752
   -
     name : GetConfig
     procedure_id : 1227704591508015645
     type_code : 15
     code : |1-
      PROCEDURE GetConfig()
      
      
      FichierVersMémoire(gclConfig,config)
      gclconfig.m_sBascoFTPAddress = sansespace(gclConfig.m_sBascoFTPAddress)
      gclconfig.m_sBascouser = sansespace(gclConfig.m_sBascouser)
      gclconfig.m_sBascoPassword = sansespace(gclConfig.m_sBascoPassword)
      
      pour i = 1 a 10
      	gclConfig.m_tabCheminTransfertVideojet[i] = config.CheminTrsfVidéojet[i]
      	gclConfig.m_tabCheminTransfertCarrelage[i] = config.CheminTrsfCarrelage[i]
      	gclConfig.m_tabDescriptionFourniture[i] = config.descriptionFourniture[i]
      	gclConfig.m_tabCDefautFourniture[i] = config.CDefautFourniture[i]
      FIN
      
      pour i = 1 a 6
      	gclConfig.m_tabSujetFrancais[i] = config.SujetFrancais[i]
      	gclConfig.m_tabSujetanglais[i] = config.Sujetanglais[i]
      	gclConfig.m_tabtexteFrancais[i] = config.texteFrancais[i]	
      	gclConfig.m_tabTexteAnglais[i] = config.TexteAnglais[i]
      FIN
      
      pour i = 1 a 30
      	gclConfig.m_tabNomConstante[i] = config.CfNomConstante[i]
      FIN
     type : 458752
