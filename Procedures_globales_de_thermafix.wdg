   -
     name : initcombo
     procedure_id : 4511921385211157661
     type_code : 15
     code : |1+
      
      //--Procédure interne-------------------------------------------------------
      //--Procédure créée par l'assistant --
      procedure InitCombo(ChpCombo,NomFic,NomRubEnClair,NomRubCle)
      //Remplit une combo-alimentée à partir d'un fichier HF
      //Entrée: ChpCombo = champ combo ou liste à remplir (il faut le champ et pas son nom)
      //        NomFic   = nom logique du fichier HF source
      //        NomRubEnClair = rubrique en clair (affichée dans la liste) du fichier source
      //        NomRubCle     = rubrique de liaison (celle qui est lue et écrite dans le fichier)
      //
      //ATTENTION! Cette combo doit absolument être reliée à la rubrique NomRubCle du fichier
      //NomFic, sinon FichierVersEcran et EcranVersFichier ne fonctionneront pas.
      //Pour relier un champ à une rubrique, allez dans la description du champ, à l'onglet "fichier" 
      //
      //La combo ou liste utilisée doit être de type graphique, sinon la rubrique cachée
      //apparaitra sur la droite de la liste (après quelques caractères cabalistiques)
      
      //remplissage de la combo avec le contenu du fichier spécifié
      //la rubrique visible est NomRubEnClair, la rubrique cachée est NomRubCle
      
      //Code WinDev 5.5 remplacé par la migration :
      //NumEnr est un entier long = 1
      NumEnr est un entier   = 1
      sablier
      h.endehors=0
      //Code WinDev 5.5 remplacé par la migration :
      //tantque pas h.endehors
      tantque pas HEnDehors()
            hlit(NomFic,NumEnr)
      //Code WinDev 5.5 remplacé par la migration :
      //      si h.actif et pas h.endehors alors 
            si (HEtat()=HEtatActif) et pas HEnDehors() alors 
      //Code WinDev 5.5 remplacé par la migration :
      //            listeajoute(ChpCombo..Nom,{NomFic+"."+NomRubEnClair}+glien(verschaine({NomFic+"."+NomRubCle})))
                  listeajoute(ChpCombo..Nom,{NomFic+"."+NomRubEnClair}+glien(NumeriqueVersChaine({NomFic+"."+NomRubCle})))
            fin
            NumEnr++
      fin
      
      // La combo doit être de type "auto-alimentée" pour être prise en compte 
      // par FichierversEcran et EcranVersFichier.
      //Code WinDev 5.5 remplacé par la migration :
      //Infoobjet(ChpCombo..Nom,43,vrai)
      gLienActive(ChpCombo..Nom,vrai)
      
      
      
      //--fin code généré par l'assistant --
      
     type : 458752
