   -
     name : CalculNombreVerre
     procedure_id : 2085267825522425098
     type_code : 15
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] CalculNombreVerre (<composant1> est chaîne, <composant2> est chaîne, <composant3> est chaîne)
      //
      // Paramètres :
      //	composant1 (chaîne ANSI) : <indiquez ici le rôle de composant1>
      //	composant2 (chaîne ANSI) : <indiquez ici le rôle de composant2>
      //	composant3 (chaîne ANSI) : <indiquez ici le rôle de composant3>
      // Valeur de retour :
      // 	entier : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE CalculNombreVerre(composant1 est un chaine,composant2 est une chaîne,composant3 est une chaine)
      cpt est un entier  = 0
      SI SansEspace(composant1) <> "" ALORS cpt++
      SI SansEspace(composant2) <> "" ALORS cpt++
      SI SansEspace(composant3) <> "" ALORS cpt++
      
      renvoyer cpt
      
      
     type : 458752
   -
     name : GetJourLivraison
     procedure_id : 2086366559746411196
     type_code : 15
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] GetJourLivraison (<IdClient> est entier, <idsaison> est entier)
      //
      // Paramètres :
      //	IdClient (entier) : <indiquez ici le rôle de IdClient>
      //	idsaison (entier) : <indiquez ici le rôle de idsaison>
      // Valeur de retour :
      // 	numérique : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      
      PROCEDURE GetJourLivraison(IdClient est un entier,idsaison est un entier) : numérique
      txtsql est une chaine  = 
      [
