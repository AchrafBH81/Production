   -
     name : DesactiveHyperThreading
     procedure_id : 5199567045824696257
     type_code : 15
     code : |1+
      Procédure DesactiveHyperThreading()
      
      
      // choix du processeur ou dés activation de l'Hyperthreading 
       hInstance est un entier 
       RetourFonction est un entier 
       dwProcessAffinityMask est un entier 
      
       SI SysVersionWindows(sysVersionPlateForme) = "NT" alors 
         dwProcessAffinityMask = 1             // ICI: choix du CPU 
         hInstance = API("KERNEL32","GetCurrentProcess") 
         RetourFonction = API("KERNEL32","SetProcessAffinityMask",hInstance,dwProcessAffinityMask) 
         SI RetourFonction = 0 ALORS 
            Erreur(ErreurInfo()) 
         FIN 
       FIN 
      
      
     type : 458752
   -
     name : LireHyperThreading
     procedure_id : 5199570503953914522
     type_code : 15
     code : |1+
      Procédure LireHyperThreading()
      
      RetourFonction est un booléen // Type C :BOOL
      hProcess est un entier // Type C :HANDLE
      lpProcessAffinityMask est un entier // Type C :LPDWORD
      lpSystemAffinityMask est un entier // Type C :LPDWORD
      hProcess = API("KERNEL32","GetCurrentProcess") 
      
      RetourFonction=API("KERNEL32","GetProcessAffinityMask",hProcess,lpProcessAffinityMask,lpSystemAffinityMask)
      
      info(lpProcessAffinityMask)
      info(lpSystemAffinityMask)
     type : 458752
   -
     name : ModifierCommandeseulement
     procedure_id : 5218119644162916945
     type_code : 15
     code : |1+
      Procédure ModifierCommandeseulement(LaDAte = datesys())
      lexception5 est un booleen = faux
      lexception10 est un booleen = faux
      resultatcalcul est un chaine = ""
      _prixa est un reel
      _prixm est un reel
      
      ouvresoeur(AfficheMiseajour)
      //HLitRecherche(facture,faclient,client.numero)
      hlitpremier(facture,fanumero)
      tantque pas HEnDehors(Facture)
      	si facture.fadate >= LaDAte alors
      		HLitSuivant(facture,fanumero)
      		continuer
      	fin
      
      
      	AfficheMiseajour.csnFacture = facture.fanumero
      	MultitacheRepeint(AfficheMiseajour)
      	multitache(10)
      	//	si facture.fanumero >= 50124 alors
      	hlitrecherche(client,numero,facture.faclient)
      	hlitrecherche(fdetail,fdnocomm,facture.fanumero)
      	tantque pas hendehors(fdetail) et fdetail.fdnocomm = facture.fanumero
      		lexception5  = faux
      		lexception10  = faux
      		si fdetail.ftype = 1 et pas fdetail.FDprixmodifie alors
      			resultatcalcul = CalculPrixThermos(fdetail.fdnumprod,client.IDClient,fdetail.fdcomposant1,fdetail.fdcomposant2,fdetail.fdcomposant3)
      			_prixa = val(extraitchaine(resultatcalcul,1,","))
      			_prixm = val(extraitchaine(resultatcalcul,2,","))
      
      			//			si hlitrecherche(thermosClient,IdClientIdhermos,HConstruitValClé(thermosclient,IdClientidhermos,sansespace(client.numero),sansespace(fdetail.fdnumprod))) alors
      			selon facture.facalcul 
      				cas 1
      //					fdetail.fdprixupied= thermosclient.Tprixa
      					fdetail.fdprixupied= _prixa
      				cas 2
      //					fdetail.fdprixupied= thermosclient.Tprixm
      					fdetail.fdprixupied= _prixm
      			FIN
      			selon client.CImpressionAngMet
      				cas 1
      //					fdetail.fdprixu = fdetail.fdpiedcarrefacture * ThermosClient.Tprixa
      					fdetail.fdprixu = fdetail.fdpiedcarrefacture * _prixa
      					fdetail.fdprixtotal = fdetail.fdqte * fdetail.fdprixu
      //					fdetail.fdprixupiedfacture = ThermosClient.tprixa
      					fdetail.fdprixupiedfacture = _prixa
      				cas 2
      //					fdetail.fdprixu = fdetail.fdpiedcarrefacture * ThermosClient.Tprixm
      					fdetail.fdprixu = fdetail.fdpiedcarrefacture * _prixm
      					fdetail.fdprixtotal = fdetail.fdqte * fdetail.fdprixu
      //					fdetail.fdprixupiedfacture = ThermosClient.tprixm
      					fdetail.fdprixupiedfacture = _prixm
      
      			FIN
      			si val(fdetail.fdhauteur) <> 0 et val(fdetail.fdlargeur) <> 0 alors
      				si val(fdetail.fDLARGEUR) > val(fdetail.fDHAUTEUR) alors
      					si partieentiere(val(fdetail.fDLARGEUR)/val(fdetail.fdhauteur)) >= 10 alors
      						lexception10 = vrai
      					sinon si partieentiere(val(fdetail.fDLARGEUR)/val(fdetail.fdhauteur)) >= 5 alors
      						lexception5= vrai
      					fin
      				sinon
      					si partieentiere(val(fdetail.fDhauteur)/val(fdetail.fdlargeur)) >= 10 alors
      						lexception10 = vrai
      					sinon si partieentiere(val(fdetail.fDhauteur)/val(fdetail.fdlargeur)) >= 5 alors
      						lexception5= vrai
      					fin
      
      			FIN
      			//			fin
      
      
      			si lexception5 alors
      				fdetail.FDextra5x = fdetail.fdprixu * config.Exception5 / 100
      			sinon
      				fdetail.FDextra5x = 0
      			FIN
      			si lexception10 <> 0 alors
      				fdetail.FDextra10x = fdetail.fdprixu * config.Exception10 / 100
      			sinon
      				fdetail.FDextra10x
      			FIN
      			si facture.FSURCHARGEENERGIE alors
      				fdetail.surchargeenergie = calculsurcharge(fdetail.fdprixtotal+(fdetail.fdqte * (fdetail.FDextra10X+fdetail.FDextra5x)),...
      				fdetail.fdcarrprixtotal,fdetail.fdextraforme*fdetail.fdqte,fdetail.ftype)
      				fdetail.SUrchargeafacturer = fdetail.surchargeenergie * fdetail.fdqteafacturer / fdetail.fdqte
      				fdetail.SUrchargedejafacture = fdetail.surchargeenergie - fdetail.SUrchargeafacturer
      			sinon
      				fdetail.surchargeenergie = 0
      				fdetail.SUrchargeafacturer = 0
      				fdetail.SUrchargedejafacture = 0
      			fin
      			fdetail.fdprixtotal += fdetail.fdqte * fdetail.fdextraforme
      			HModifie(fdetail,hNumEnrEnCours)
      		fin
      
      	fin
      	hlitrecherche(BonLivraison,BnoCommande,fdetail.fdnocomm)
      	tantque pas hendehors(BonLivraison) et BonLivraison.BnoCommande = fdetail.fdnocomm
      		//		si hlitrecherche(BonLivraison,BnoCommande,fdetail.fdnocomm) alors
      		si BonLivraison.bfacture = 0 alors
      			si hlitrecherche(hfacture,Bnumero,BonLivraison.bnumero) alors
      				hlitrecherche(hfdetail,HFCLEUNIK,hfacture.HFCLEUNIK)
      				tantque pas hendehors(hfdetail) et hfdetail.HFCLEUNIK = hfacture.HFCLEUNIK
      					si hfdetail.ftype = 1 et hfdetail.fdligne= fdetail.fdligne alors
      						hfdetail.fdprixupied= fdetail.fdprixupied
      						hfdetail.fdprixu = fdetail.fdpiedcarrefacture * fdetail.fdprixupiedfacture
      						hfdetail.fdprixtotal = hfdetail.fdqteafacturer * hfdetail.fdprixu
      						hfdetail.fdprixupiedfacture = fdetail.fdprixupiedfacture
      						hfdetail.FDextra10X = fdetail.FDextra10X
      						hfdetail.FDextra5X = fdetail.FDextra5X
      						si facture.FSURCHARGEENERGIE alors
      							hfdetail.SUrchargeafacturer = fdetail.surchargeenergie * hfdetail.fdqteafacturer / fdetail.fdqte
      							hfdetail.surchargeenergie = fdetail.surchargeenergie * hfdetail.fdqteafacturer / fdetail.fdqte
      						sinon
      							hfdetail.SUrchargeafacturer = 0
      							hfdetail.surchargeenergie = 0
      						fin
      						hfdetail.fdprixtotal += hfdetail.fdqteafacturer * hfdetail.fdextraforme
      
      						HModifie(hfdetail,hnumenrencours)
      					FIN
      					hlitsuivant(hfdetail,HFCLEUNIK)
      			FIN
      		FIN
      
      	fin
      	HLitSuivant(BonLivraison,BnoCommande)
      fin
      
      
      hlitsuivant(fdetail,fdnocomm)
      FIN
      //fin
      HLitSuivant(Facture,fanumero)
      FIN
      Ferme(AfficheMiseajour)
      
      
      
     type : 458752
   -
     name : calculsurcharge
     procedure_id : 5218120970911562729
     type_code : 15
     code : |1+
      Procédure calculsurcharge(lmontant=0,lmontantcarrelage=0,lmontantforme=0,ltype=1)
      // ltype 1=thermos 2=verre a l'unité
      
      lpourcentagebase est un reel
      lpourcentageunite est un reel
      lpourcentageforme est un reel
      lpourcentagecarrelage est un reel
      valeuraretourner est un reel
      
      si client.surcharge alors
      	si client.csurchargebase <> 0 alors
      		lpourcentagebase = client.csurchargebase
      	sinon
      		lpourcentagebase = config.surchargebase
      	FIN
      sinon
      	lpourcentagebase=0
      fin
      
      
      si client.surchargeverreunite alors
      	si client.csurchargeverreunite <>0 alors
      	lpourcentageunite = client.csurchargeverreunite
      	sinon
      	lpourcentageunite = config.surchargeverreunite
      	FIN
      sinon
      lpourcentageunite = 0
      fin
      
      
      si client.SUrchargeforme alors
      	si client.Csurchargeforme <>0 alors
      		lpourcentageforme = client.Csurchargeforme
      	sinon
      		lpourcentageforme = config.SUrchargeforme
      	FIN
      sinon
      	lpourcentageforme = 0
      fin
      
      si client.SUrchargecarrelage
      	si client.Csurchargecarrelage<>0 alors
      		lpourcentagecarrelage= client.Csurchargecarrelage
      	sinon
      	    lpourcentagecarrelage= config.SUrchargecarrelage
      	FIN
      sinon
      	lpourcentagecarrelage= 0
      fin
      
      
      
      
      
       
      valeuraretourner = (lmontant * lpourcentagebase / 100)+(lmontantcarrelage*lpourcentagecarrelage/100)+(lmontantforme * lpourcentageforme / 100)
      renvoyer valeuraretourner
      
      
      
      
     type : 458752
   -
     name : ModifierCommandeseulementCarr
     procedure_id : 5221101488771830521
     type_code : 15
     code : |1+
      Procédure ModifierCommandeseulementCarr(LaDAte = datesys())
      lexception5 est un booleen = faux
      lexception10 est un booleen = faux
      ouvresoeur(AfficheMiseajour)
      lNumRecFdetail est un entier
      //HLitRecherche(facture,faclient,client.numero)
      hlitpremier(facture,fanumero)
      tantque pas HEnDehors(Facture)
      	si facture.fadate >= LaDAte alors
      		HLitSuivant(facture,fanumero)
      		continuer
      	fin
      
      
      	AfficheMiseajour.csnFacture = facture.fanumero
      	MultitacheRepeint(AfficheMiseajour)
      	multitache(10)
      //	si facture.fanumero >= 50141 alors
      		hlitrecherche(client,numero,facture.faclient)
      		hlitrecherche(fdetail,fdnocomm,facture.fanumero)
      		tantque pas hendehors(fdetail) et fdetail.fdnocomm = facture.fanumero
      			si fdetail.ftype = 4 alors
      				si hlitrecherche(ProduitClient,IdClientIdproruit,HConstruitValClé(ProduitClient,IdClientIdproruit,sansespace(client.numero),sansespace(fdetail.fdnumprod))) alors
      					si ProduitClient.IPprixSpecial alors
      						fdetail.fdcarrpruxuc= ProduitClient.IPrixa
      						fdetail.fdcarrprixdebase= produitclient.iprixm
      						fdetail.frcarrprixu = fdetail.fdnbcarreau * produitclient.iprixa
      						fdetail.fdprixu = fdetail.fdnbcarreau * produitclient.iprixa
      						fdetail.fdprixtotal = arrondi(fdetail.fdqte * ( fdetail.frcarrprixu + fdetail.fdcarrprixdebase),2)
      						fdetail.fdcarrprixtotal = fdetail.fdprixtotal
      						HModifie(fdetail,hNumEnrEnCours)
      
      						// Modification des bon de livraison si applicable
      
      						hlitrecherche(BonLivraison,BnoCommande,fdetail.fdnocomm)
      						tantque pas hendehors(BonLivraison) et BonLivraison.BnoCommande = fdetail.fdnocomm
      							si BonLivraison.bfacture = 0 alors
      								si hlitrecherche(hfacture,Bnumero,BonLivraison.bnumero) alors
      									hlitrecherche(hfdetail,fdnocommfdligne1,HConstruitValClé(hfdetail,fdnocommfdligne1,fdetail.fdnocomm,fdetail.fdligne))
      									tantque pas hendehors(hfdetail) et hfdetail.fdnocomm = fdetail.fdnocomm et hfdetail.fdligne = fdetail.fdligne
      										hfdetail.fdcarrpruxuc= ProduitClient.IPrixa
      										hfdetail.fdcarrprixdebase= produitclient.iprixm
      										hfdetail.frcarrprixu = fdetail.fdnbcarreau * produitclient.iprixa
      										hfdetail.fdprixu = fdetail.fdnbcarreau * produitclient.iprixa
      										hfdetail.fdprixtotal = arrondi(hfdetail.fdqteafacturer * ( fdetail.frcarrprixu + fdetail.fdcarrprixdebase),2)
      										hfdetail.fdcarrprixtotal = hfdetail.fdprixtotal
      										HModifie(hfdetail,hNumEnrEnCours)
      										HLitSuivant(hfdetail,fdnocommfdligne1)
      									fin
      								fin
      							fin
      							hlitsuivant(BonLivraison,BnoCommande)
      						fin
      
      
      						lNumRecFdetail = HSauvePosition(fdetail)
      						si hlitrecherche(fdetail,fdnocommfdligne,HConstruitValClé(fdetail,fdnocommfdligne,fdetail.fdnocomm,fdetail.fdlien)) alors
      							fdetail.fdcarrpruxuc= ProduitClient.IPrixa
      							fdetail.fdcarrprixdebase= produitclient.iprixm
      							fdetail.frcarrprixu = fdetail.fdnbcarreau * produitclient.iprixa
      							fdetail.fdcarrprixtotal = arrondi(fdetail.fdqte * ( fdetail.frcarrprixu + fdetail.fdcarrprixdebase),2)
      							HModifie(fdetail,hNumEnrEnCours)
      
      							// Modification des bon de livraison si applicable
      
      							hlitrecherche(BonLivraison,BnoCommande,fdetail.fdnocomm)
      							tantque pas hendehors(BonLivraison) et BonLivraison.BnoCommande = fdetail.fdnocomm
      								si BonLivraison.bfacture = 0 alors
      									si hlitrecherche(hfacture,Bnumero,BonLivraison.bnumero) alors
      										hlitrecherche(hfdetail,fdnocommfdligne1,HConstruitValClé(hfdetail,fdnocommfdligne1,fdetail.fdnocomm,fdetail.fdligne))
      										tantque pas hendehors(hfdetail) et hfdetail.fdnocomm = fdetail.fdnocomm et hfdetail.fdligne = fdetail.fdligne
      											hfdetail.fdcarrpruxuc= ProduitClient.IPrixa
      											hfdetail.fdcarrprixdebase= produitclient.iprixm
      											hfdetail.frcarrprixu = fdetail.fdnbcarreau * produitclient.iprixa
      											hfdetail.fdcarrprixtotal = arrondi(hfdetail.fdqteafacturer * ( fdetail.frcarrprixu + fdetail.fdcarrprixdebase),2)
      											HModifie(hfdetail,hNumEnrEnCours)
      											HLitSuivant(hfdetail,fdnocommfdligne1)
      										fin
      									fin
      								fin
