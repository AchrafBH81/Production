   -
     name : Feedmenu
     procedure_id : 1426542902091680012
     type_code : 15
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] Feedmenu (<nGroupID> est entier)
      //
      // Paramètres :
      //	nGroupID (entier) : <indiquez ici le rôle de nGroupID>
      // Valeur de retour :
      // 	booléen : <indiquez ici le rôle de la valeur de retour>
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure Feedmenu(nGroupID est un entier)
      sdReqsql	est une source de donnees
      sTxtsql		est une chaine	= [
      	select optionmenu,optionactif,nomoption,nomcomplet,isButton , niveauSuperieur from securite
      	inner join optionmenu on securite.optionmenu = optionmenu.idoptionmenu where idusergroup = %1
      ]
      si nGroupID <= 0  _ou_ (hlitrecherche(UserGroup,IDUserGroup,nGroupID) _et_ sansespace(UserGroup.Description) = "Admin") alors renvoyer Vrai
      
      taOptionMenu	est un tableau associatif d'Entier
      stCurrentButton	est un STButtonSecurity
      
      
      si hexecuterequetesql(sdReqsql,hRequêteDéfaut,ChaîneConstruit(sTxtsql,nGroupID)) alors
      	pour TOUT sdReqsql 
      		QUAND EXCEPTION dans
      			
      			si sdReqsql.isbutton alors
      				stCurrentButton					= allouer un STButtonSecurity
      				stCurrentButton.sButtonName		= sdReqsql.nomoption
      				stCurrentButton.bActiveButton	= sdReqsql.optionactif
      				gtaFloatingButton[sdReqsql.niveausuperieur].tabButtonSecurity.ajoute(stCurrentButton)
      			sinon	
      				taOptionMenu[sdReqsql.nomoption] = sdReqsql.optionactif
      				{"maitre._menu."+sdReqsql.nomcomplet}..visible = sdReqsql.optionactif
      			fin
      		FAIRE
      		FIN
      		
      	fin
      FIN
      
      
      
      
      
     type : 458752
