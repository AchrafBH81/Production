      				cas "A"
      					montant = invent.iprixfuturdouble
      				cas "M"
      					montant = invent.iprixfuturdoublem
      					
      				FIN
      			fin
      		cas 3
      			si sansespace(invent.idateprixfutur) = "" alors
      				selon udemesure
      				cas "A"
      					montant = invent.iprixtriple
      				cas "M"
      					montant = invent.iprixtriplem
      				fin	
      			sinon
      				selon udemesure
      				cas "A"
      					montant = invent.iprixfuturtriple
      				cas "M"
      					montant = invent.iprixfuturtriplem
      				fin
