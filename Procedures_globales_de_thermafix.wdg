     name : trouve_escompte
     procedure_id : 4511921384290508694
     type_code : 15
     code : |1+
      Procédure trouve_escompte(produit = "",_categorie = "",indice = 1,provenance = "")
      escompte est un reel = 0
      renvoyer escompte
      si escompteqte alors
      	escompte = pourcescompteqte	
      sinon
      	hlitrecherche("speciaux","cle",produit)
      	
      //Code WinDev 5.5 remplacé par la migration :
      //	si pas h.endehors alors
      	si pas HEnDehors() alors
      		
      //Code WinDev 5.5 remplacé par la migration :
      //		si h.trouve alors
      		si HTrouve() alors
      			si provenance = "base" alors	
      				selon indice
      				cas  2 
      					escompte = speciaux.pprix
      				cas 3
      					escompte = speciaux.pprixt
      				autre cas
      					escompte = 0
      				fin	
      			sinon
      				escompte = speciaux.pprix
      			fin	
      		sinon
      			
      			hlitrecherche("speciaux","cle",_categorie)
      //Code WinDev 5.5 remplacé par la migration :
      //			si pas h.endehors alors
      			si pas HEnDehors() alors
      				
      //Code WinDev 5.5 remplacé par la migration :
      //				si h.trouve alors
      				si HTrouve() alors
      					escompte = speciaux.pprix
      				sinon
      					escompte = 0
      				FIN
      				
      				
      			FIN
      		fin
      	sinon
      		hlitrecherche("speciaux","cle",_categorie)
      //Code WinDev 5.5 remplacé par la migration :
      //		si pas h.endehors alors
      		si pas HEnDehors() alors
      			
      //Code WinDev 5.5 remplacé par la migration :
      //			si h.trouve alors
      			si HTrouve() alors
      				
      				escompte = speciaux.pprix
      			sinon
      				escompte = 0
      			FIN
      			
      			
      			
      		FIN
      		
      	fin	
      fin
      renvoyer escompte
      
