   -
     name : PrinterGetStatus
     procedure_id : 5223620754374626473
     type_code : 15
     code : |1+
      FUNCTION PrinterGetStatus(pPrinter=iInfoImprimante())
      pPrinterName est une chaîne ASCIIZ sur 256 = pPrinter
      phPrinter est un entier = 0
      pcbNeeded est un entier = 0
      RetCode est un entier
      tSTATUS est un tableau dynamique de 100 x_PRINTER_INFO_2
      Buf est une chaîne ASCIIZ sur 2048
      Etat est un entier = 0
      // Ouverture du lien vers l'imprimante phPrinter = handle sur l'imprimante
      si API( "winspool.drv" ,"OpenPrinterA", pPrinterName, &phPrinter, Null) <> 0 alors
      
      	RetCode = API("winspool.drv", "GetPrinterA", phPrinter, 2, &tSTATUS, 0,	&pcbNeeded)
      	RetCode = API("winspool.drv", "GetPrinterA", phPrinter, 2, &tSTATUS,	pcbNeeded, &pcbNeeded)
      	IF RetCode <> 0 THEN
      		Etat = tSTATUS[1]:status
      	END
      	API("winspool.drv", "ClosePrinter", phPrinter)
      fin
      RENVOYER Etat
      //****************************************************************************
      
     type : 458752
   -
     name : iPrinterStatus
     procedure_id : 5223624374491834394
     type_code : 15
     code : |1+
      //****************************
      // Renvoie le status d'une imprimante
      //****************************
      FUNCTION iGetStatus(pPrinterName=iInfoImprimante())
      
      Status, hdPrint, Ret, cbBuf, pcbNeeded sont des entiers
      PrinterName est une chaîne ASCIIZ sur 512 = pPrinterName
      tPRINTER est une x_PRINTER_INFO_6
      PRINTER_INFO_LEVEL est un entier = 6
      http://forum.pcsoft.fr/post.awp?id=92137&forum=pcsoft.fr.windev&result=../search.awp... 2008-04-04
      Buf est une chaîne ASCIIZ sur 1024
      Status = INVALID_PRINTER
      // Ouverture du handle avec l'imprimante
      Ret = API( "winspool.drv", "OpenPrinterA" , &PrinterName, &hdPrint, Null)
      IF Ret = 0 THEN RENVOYER Status
      // Execution de iPrinterStatus fonction une fois avec 0 pour connaitre le nombre exact
      cbBuf = 0
      pcbNeeded = 0
      API( "winspool.drv", "GetPrinterA", hdPrint, PRINTER_INFO_LEVEL, &tPRINTER,cbBuf, &pcbNeeded)
      // Met le nombre renvoyer par le premier appel
      cbBuf = pcbNeeded
      Ret = API( "winspool.drv", "GetPrinterA", hdPrint, PRINTER_INFO_LEVEL,&tPRINTER, cbBuf, &pcbNeeded)
      IF Ret = 0 THEN
      	API("winspool.drv","ClosePrinter", hdPrint)
      	RENVOYER Status
      END
      Status = tPRINTER:Status
      API("winspool.drv","ClosePrinter", hdPrint)
      RENVOYER Status
      //Status = tPRINTER[1]:Status
      //API("winspool.drv","ClosePrinter", hdPrint)
      //RENVOYER Status // peut etre un OuBinaire des constantes
      
      
      
      
     type : 458752
   -
     name : KillProcess
     procedure_id : 5242191327981841701
     type_code : 15
     code : |1+
      Procédure KillProcess(NomProcess = "")
      
      
      TH32CS est un entier  = 0x2
      hSnapshot est un entier 
      processInfo est un PROCESSENTRY32
      succes est un entier 
      exeName est une chaine
      retval est un entier 
      RetourFonction est un entier // Type C :HANDLE
      dwDesiredAccess est un entier =PROCESS_ALL_ACCESS // Type C :DWORD
      bInheritHandle est un booléen = vrai// Type C :BOOL
      dwProcessId est un entier // Type C :DWORD
      exitcode est un entier
      
      // En premier, faire une photo de la liste des processus
      hSnapshot = AppelDll32("kernel32", "CreateToolhelp32Snapshot", TH32CS, 0)
      
      // Information sur le 1er processus de la liste
      processInfo:dwSize = Dimension(processInfo)
      succes = AppelDll32("kernel32", "Process32First", hSnapshot, &processInfo)
      
      // Etre sûr qu'un handle a été retourné
      SI hSnapshot = -1 ALORS
      
      	Info("Impossible de faire une photo des processus !")
      
      FIN
      
      // Boucle pour chaque processus de la liste
      // Ce code vous est offert par Beaussier en ligne 
      TANTQUE succes <> 0
      
      	// Extraction du nom de fichier du processus
      	exeName = processInfo:szExeFile
      
      	// Affichage du processus et du nombre de threads
      	//	Info("Processus : " + RC + exeName + RC + ...
      	//	"Nombre de threads : "+ processInfo:cntThreads)
      
      	si exeName = NomProcess alors
      		RetourFonction=API("KERNEL32","OpenProcess",dwDesiredAccess,bInheritHandle,processInfo:th32ProcessID)
      		RetourFonction=API("KERNEL32","TerminateProcess",RetourFonction,exitcode)
      	    sortir
      	fin
      
      
      	// Information sur le prochain processus s'il y en un
      	processInfo:dwSize = Dimension(processInfo)
      	succes = AppelDll32("kernel32", "Process32Next", hSnapshot, &processInfo)
      
      FIN
      
      // Détruit la photo
      retval = AppelDLL32("kernel32", "CloseHandle", hSnapshot)
     type : 458752
