     name : Update_20130310
     procedure_id : 5274889971342785340
     type_code : 15
     code : |1+
      Procédure Update_20130310()
      
      traduction.Description = "Standard"
      traduction.Dfrancais = "Standard"
      traduction.Danglais = "Standard"
      Traduction.dlongueurmax = 25
      traduction.trecherche = "lstandard"
      Traduction.tetat = "L"
      hajoute(Traduction)
      
      traduction.Description = "Spéciaux"
      traduction.Dfrancais = "Spéciaux"
      traduction.Danglais = "Spécials"
      Traduction.dlongueurmax = 25
      traduction.trecherche = "lspeciaux"
      Traduction.tetat = "L"
      hajoute(Traduction)
      
      traduction.Description = "Standard (suite)"
      traduction.Dfrancais = "Standard (suite)"
      traduction.Danglais = "Standard (suite)"
      Traduction.dlongueurmax = 25
      traduction.trecherche = "lstandardsuite"
      Traduction.tetat = "L"
      hajoute(Traduction)
      
      traduction.Description = "Spéciaux (suite)"
      traduction.Dfrancais = "Spéciaux (suite)"
      traduction.Danglais = "Specials (suite)"
      Traduction.dlongueurmax = 25
      traduction.trecherche = "lspeciauxsuite"
      Traduction.tetat = "L"
      hajoute(Traduction)
      
      traduction.Description = "Extra Standard"
      traduction.Dfrancais = "Thermos <Epaisseur>MM"
      traduction.Danglais = "Thermos <Epaisseur>MM"
      Traduction.dlongueurmax = 50
      traduction.trecherche = "ExtraStandard"
      Traduction.tetat = "L"
      hajoute(Traduction)
      
      traduction.Description = "Extra Speciaux"
      traduction.Dfrancais = "Extra Verre Spéciaux <Epaisseur>MM"
      traduction.Danglais = "Extra Verre Spéciaux <Epaisseur>MM"
      Traduction.dlongueurmax = 50
      traduction.trecherche = "ExtraSpeciaux"
      Traduction.tetat = "L"
      hajoute(Traduction)
      
      
      traduction.Description = "Note Extra"
      traduction.Dfrancais = "Note en bas de page pour l'extra"
      traduction.Danglais = "Note en bas de page pour l'extra"
      Traduction.dlongueurmax = 50
      traduction.trecherche = "ExtraNote"
      Traduction.tetat = "L"
      hajoute(Traduction)
      
      
      pour tout invent
      	invent.iCatPourListe = 1
      	invent.IEpaisseurPourListe = 2
      	hmodifie(invent,hnumenrencours)	
      FIN
      
      
