   -
     name : epurefacture
     procedure_id : 4511921385875233869
     type_code : 15
     code : |1+
      //Procédure epurefacture(numeroenregistrement,nocommande)
      //qteafacturer est un reel
      //qtedejafacture est un reel
      //prepfacture.majhistorique(numeroenregistrement,nocommande)
      //toutelafacture = vrai
      //
      //hlit("Facture",numeroenregistrement)
      //facture.FPREPARATION = "B"
      //hmodifie("facture")	
      
      
      
      Procédure epurefacture(numeroenregistrement,lignedetable)
      
      prepfacture.majhistorique(numeroenregistrement,lignedetable)
      toutelafacture = vrai
      
      hlit("Facture",numeroenregistrement)
      
      
      hlitrecherche("fdetail","fdnocomm",facture.fanumero)
      
      //Code WinDev 5.5 remplacé par la migration :
      //tantque fdetail.fdnocomm = facture.fanumero et pas h.endehors
      tantque fdetail.fdnocomm = facture.fanumero et pas HEnDehors()
      
      	fdetail.fdqtedejafacture =  fdetail.fdqtedejafacture + fdetail.fdqteafacturer
      	fdetail.fdqteafacturer = fdetail.fdqte - fdetail.fdqtedejafacture
      	fdetail.SUrchargedejafacture = fdetail.SUrchargedejafacture+fdetail.SUrchargeafacturer
      	fdetail.SUrchargeafacturer = fdetail.surchargeenergie- fdetail.SUrchargedejafacture
      	si fdetail.fdqteafacturer <> 0 alors  // = fdetail.fdqte-fdetail.fdqtedejafacture alors  
      		//     hcopieenreg("aliasfdet","fdetail")
      		//	 hajoute("aliasfdet")
      		//	 hsupprime("fdetail")
      		//   sinon
      		toutelafacture = faux
      	fin
      	hmodifie("fdetail")
      	//     hcopieenreg("aliasfdet","fdetail")
      	//	 hajoute("aliasfdet")
      
      	hlitsuivant("fdetail","fdnocomm")
      
      FIN
      
      //hcopieenreg("aliasfac","facture")
      //hajoute("aliasfac")
      
      si toutelafacture alors
      	//    hsupprime(facture,hNumEnrEnCours)
      	facture.FPREPARATION = "B"
      	facture.livrepartiel = ""
      	hmodifie(Facture,hNumEnrEnCours)
      sinon
      	facture.livrepartiel = "P"
      	facture.faimprimer = 0
      	hmodifie(facture,hNumEnrEnCours)	
      FIN
      
      
     type : 458752
