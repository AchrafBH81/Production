   -
     name : DateSQL
     procedure_id : 4511921380063435602
     type_code : 15
     code : |1+
      
      // Retourne la date au format {d'AAAA-MM-JJ'} 
      // Assure une compatibilité avec ODBC
      //
      Procédure DateSQL(ChampDate)
      
      // taille de l'année (sur 2 ou 4 positions)
      nTailleAnnee est un entier=taille(ChampDate)-4
      
      // date au format AAAA-MM-JJ
      sDate est une chaine=gauche(ChampDate,nTailleAnnee)+"-"+milieu(ChampDate,nTailleAnnee+1,2)+"-"+droite(ChampDate,2)
      
      // retourne la date au format ODBC
      renvoyer "{d "+Quote(sDate)+"}"
      
