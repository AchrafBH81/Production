     type : 458752
   -
     name : ModifierCommandeseulementForme
     procedure_id : 5222844834043880819
     type_code : 15
     code : |1+
      Procédure ModifierCommandeseulementForme(LaDAte = datesys())
      lexception5 est un booleen = faux
      lexception10 est un booleen = faux
      ouvresoeur(AfficheMiseajour)
      lNumRecFdetail est un entier
      //HLitRecherche(facture,faclient,client.numero)
      hlitpremier(facture,fanumero)
      tantque pas HEnDehors(Facture)
      	si facture.fadate > LaDAte alors
      		HLitSuivant(facture,fanumero)
      		continuer
      	fin
      
      
      	AfficheMiseajour.csnFacture = facture.fanumero
      	MultitacheRepeint(AfficheMiseajour)
      	multitache(10)
      	//	si facture.fanumero >= 50142 alors
      	hlitrecherche(client,numero,facture.faclient)
      	hlitrecherche(fdetail,fdnocomm,facture.fanumero)
      	tantque pas hendehors(fdetail) et fdetail.fdnocomm = facture.fanumero
      		si fdetail.ftype = 1 et sansespace(fdetail.fdforme) <> ""
      			si hlitrecherche(FormeClient,IdClientNoForme,HConstruitValClé(FormeClient,IdClientNoForme,sansespace(client.numero),sansespace(fdetail.fdforme))) alors
      				si formeclient.fPrixSpecial alors
      
      
      					selon TrouveNbVerre()
      						cas 2
      							fdetail.fdextraforme = formeclient.fPrixdouble
      						cas 3
      							fdetail.fdextraforme = formeclient.fPrixtriple
      					fin
      
      					fdetail.fdprixtotal = arrondi(fdetail.fdqte * ( fdetail.fdprixu + fdetail.fdextraforme),2)
      					HModifie(fdetail,hNumEnrEnCours)
      
      					// Modification des bon de livraison si applicable
      
      					hlitrecherche(BonLivraison,BnoCommande,fdetail.fdnocomm)
      					tantque pas hendehors(BonLivraison) et BonLivraison.BnoCommande = fdetail.fdnocomm
      						si BonLivraison.bfacture = 0 alors
      							si hlitrecherche(hfacture,Bnumero,BonLivraison.bnumero) alors
      								hlitrecherche(hfdetail,fdnocommfdligne1,HConstruitValClé(hfdetail,fdnocommfdligne1,fdetail.fdnocomm,fdetail.fdligne))
      								tantque pas hendehors(hfdetail) et hfdetail.fdnocomm = fdetail.fdnocomm et hfdetail.fdligne = fdetail.fdligne
      									hfdetail.fdextraforme= fdetail.fdextraforme
      									hfdetail.fdprixtotal = arrondi(hfdetail.fdqteafacturer * ( fdetail.fdprixu + fdetail.fdextraforme),2)
      									HModifie(hfdetail,hNumEnrEnCours)
      									HLitSuivant(hfdetail,fdnocommfdligne1)
      								fin
      							fin
      					fin
      					hlitsuivant(BonLivraison,BnoCommande)
      				fin
      			sinon
      				si hlitrecherche(forme,fnumero,fdetail.fdforme) alors
      					selon TrouveNbVerre()
      						cas 2
      							fdetail.fdextraforme = forme.extradouble
      						cas 3
      							fdetail.fdextraforme = forme.extratriple
      					fin
      
      					fdetail.fdprixtotal = arrondi(fdetail.fdqte * ( fdetail.fdprixu + fdetail.fdextraforme),2)
      					HModifie(fdetail,hNumEnrEnCours)
      
      					// Modification des bon de livraison si applicable
      
      					hlitrecherche(BonLivraison,BnoCommande,fdetail.fdnocomm)
      					tantque pas hendehors(BonLivraison) et BonLivraison.BnoCommande = fdetail.fdnocomm
      						si BonLivraison.bfacture = 0 alors
      							si hlitrecherche(hfacture,Bnumero,BonLivraison.bnumero) alors
      								hlitrecherche(hfdetail,fdnocommfdligne1,HConstruitValClé(hfdetail,fdnocommfdligne1,fdetail.fdnocomm,fdetail.fdligne))
      								tantque pas hendehors(hfdetail) et hfdetail.fdnocomm = fdetail.fdnocomm et hfdetail.fdligne = fdetail.fdligne
      									hfdetail.fdextraforme= fdetail.fdextraforme
      									hfdetail.fdprixtotal = arrondi(hfdetail.fdqteafacturer * ( fdetail.fdprixu + fdetail.fdextraforme),2)
      									HModifie(hfdetail,hNumEnrEnCours)
      									HLitSuivant(hfdetail,fdnocommfdligne1)
      								fin
      							fin
      					fin
      					hlitsuivant(BonLivraison,BnoCommande)
      				fin
      
      
      			fin
      			//					info(fdetail.fdnumprod)
      			//					info(facture.faclient)
      			//					info("Liste de prix")
      		fin
      		//	fin
      	sinon
      
      		si hlitrecherche(forme,fnumero,fdetail.fdforme) alors
      			selon TrouveNbVerre()
      				cas 2
      					fdetail.fdextraforme = forme.extradouble
      				cas 3
      					fdetail.fdextraforme = forme.extratriple
      			fin
      
      			fdetail.fdprixtotal = arrondi(fdetail.fdqte * ( fdetail.fdprixu + fdetail.fdextraforme),2)
      			HModifie(fdetail,hNumEnrEnCours)
      
      			// Modification des bon de livraison si applicable
      
      			hlitrecherche(BonLivraison,BnoCommande,fdetail.fdnocomm)
      			tantque pas hendehors(BonLivraison) et BonLivraison.BnoCommande = fdetail.fdnocomm
      				si BonLivraison.bfacture = 0 alors
