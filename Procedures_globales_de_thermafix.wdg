   -
     name : maj_carrelage
     procedure_id : 4511921384951962981
     type_code : 15
     code : |1+
      Procédure maj_carrelage()
      // pour vérifier le type de carrelage 
      //   soit   vertical/horizontal
      //          vertical
      //          horizontal
      //          Croix
      //
      // Selon le type les champs formules horizontal/vertical 
      // seront ou non disponible à la saisie 
      
      selon typecalcul
         cas 1
      //Code WinDev 5.5 remplacé par la migration :
      //	  formule_trouv..etat = actif
      	  formule_trouv..etat = actif; formule_trouv..Visible=Vrai
           
      cas 2
      //Code WinDev 5.5 remplacé par la migration :
      //	  formule_trouh..etat = actif
      	  formule_trouh..etat = actif; formule_trouh..Visible=Vrai
      	autre cas 
      //Code WinDev 5.5 remplacé par la migration :
      //	  formule_trouv..etat = actif
      	  formule_trouv..etat = actif; formule_trouv..Visible=Vrai
      //Code WinDev 5.5 remplacé par la migration :
      //	  formule_trouh..etat = actif
      	  formule_trouh..etat = actif; formule_trouh..Visible=Vrai
      	  			  
      FIN
      
     type : 458752
   -
     name : maj_ficheclient
     procedure_id : 4511921384380947823
     type_code : 15
     code : |1+
      Procédure maj_ficheclient()
      NomDeFenetre est une chaine
      si gFormatFacture = 2 alors
      	NomDeFenetre = "fenclientTRN"
      sinon
      	NomDeFenetre = "fenclient"
      fin
      si pas {NomDeFenetre+".ssecteur"} = ""
      	hlitrecherche("secteur","secteur",{NomDeFenetre+".ssecteur"})
      
      	//Code WinDev 5.5 remplacé par la migration :
      	//si h.trouve alors
      	si HTrouve() alors
      		//Code WinDev 5.5 remplacé par la migration :
      		// si pas h.endehors alors
      		si pas HEnDehors() alors
      			{NomDeFenetre+".description"} = secteur.sdescription
      		fin  
      	fin
      sinon
      	{NomDeFenetre+".description"} = "Secteur inexistant"	 
      fin
      
     type : 458752
   -
     name : maj_produit
     procedure_id : 4511921385839189359
     type_code : 15
     code : |1+
      procédure maj_produit(provenance="")
      
      
      //hlitrecherche("INVENTAIRE","INUM",table.inum)
      //produits.pro_onglet..etat = inactif
      //Code WinDev 5.5 remplacé par la migration :
      //produits.pro_onglet[2]..etat = grisé
      produits.pro_onglet[2]..etat = grisé; produits.pro_onglet[2]..Visible=Vrai
      //Code WinDev 5.5 remplacé par la migration :
      //produits.pro_onglet[3]..etat = grisé
      produits.pro_onglet[3]..etat = grisé; produits.pro_onglet[3]..Visible=Vrai
      //Code WinDev 5.5 remplacé par la migration :
      //produits.pro_onglet[4]..etat = grisé
      produits.pro_onglet[4]..etat = grisé; produits.pro_onglet[4]..Visible=Vrai
      //Code WinDev 5.5 remplacé par la migration :
      //produits.pro_onglet[5]..etat = grisé
      //produits.pro_onglet[5]..etat = grisé; produits.pro_onglet[5]..Visible=Vrai
      //Code WinDev 5.5 remplacé par la migration :
      //produits.pro_onglet[6]..etat = grisé
      produits.pro_onglet[6]..etat = grisé; produits.pro_onglet[6]..Visible=Vrai
      //Code WinDev 5.5 remplacé par la migration :
      //produits.pro_onglet[7]..etat = grisé
      produits.pro_onglet[7]..etat = grisé; produits.pro_onglet[7]..Visible=Vrai
      produits.pro_onglet[8]..etat = grisé; produits.pro_onglet[8]..Visible=Vrai
      
      selon produits.ptype
      
      	cas 1
      
      
      		//Code WinDev 5.5 remplacé par la migration :
      		//	produits.pro_onglet[2]..etat = actif
      		produits.pro_onglet[2]..etat = actif; produits.pro_onglet[2]..Visible=Vrai
      		//Code WinDev 5.5 remplacé par la migration :
      		//	produits.pro_onglet[3]..etat = actif
      		produits.pro_onglet[3]..etat = actif; produits.pro_onglet[3]..Visible=Vrai
      		si modif ou ajout = Vrai ou provenance = "bouton" alors
      			produits.pro_onglet = 2
      
      		fin
      		si modif ou ajout = Vrai alors
      			//si pas provenance = "bouton" alors
      
      			//Code WinDev 5.5 remplacé par la migration :
      			//		execute("produits.pbase..sortie" )
      			ExecuteTraitement("produits.pbase",TRTsortie )
      			//Code WinDev 5.5 remplacé par la migration :
      			//	    saisie_produit..etat = ACTIF
      			produits.saisie_produit..etat = ACTIF; produits.saisie_produit..Visible=Vrai
      			//Code WinDev 5.5 remplacé par la migration :
      			//		saisie_verre..etat = actif
      			produits.saisie_verre..etat = actif; produits.saisie_verre..Visible=Vrai
      			//Code WinDev 5.5 remplacé par la migration :
      			//		entete..etat = actif
      			produits.entete..etat = actif; produits.entete..Visible=Vrai
      			//numpro..etat = grisé
      
      			//sinon
      			//    saisie_produit..etat = inACTIF
      
      
      		FIN
      	cas 2
      		produits.pro_onglet[4]..etat = actif; produits.pro_onglet[4]..Visible=Vrai
      		si modif ou ajout = Vrai ou provenance = "bouton" alors
      			//saisie_produit..etat = INACTIF
      			produits.pro_onglet = 4
      
      			si modif ou ajout = Vrai alors
      
      				produits.saisie_unite..etat = actif
      				produits.saisie_unite..Visible=Vrai
      				produits.saisie_produit..etat = ACTIF
      				produits.saisie_produit..Visible=Vrai
      
      			sinon
      				si produits.iunitetype = 1 ou produits.iunitetype = 4 alors
      					//Code WinDev 5.5 remplacé par la migration :
      					//                tableauprix..etat = inactif
      					produits.tableauprix..etat = AffichageSeulement; produits.tableauprix..Visible=Vrai
      
      					si produits.tableauprix alors
      						//Code WinDev 5.5 remplacé par la migration :
      						//					btn_tableau..etat = inactif
      						produits.btn_tableau..etat = AffichageSeulement; produits.btn_tableau..Visible=Vrai
      					sinon
      						//Code WinDev 5.5 remplacé par la migration :
      						//					btn_tableau..VISIBLE = FAUX
      						produits.btn_tableau..Visible=Faux
      
      					FIN
      				sinon
      					//Code WinDev 5.5 remplacé par la migration :
      					//					btn_tableau..VISIBLE = FAUX
      					produits.btn_tableau..Visible=Faux
      					//Code WinDev 5.5 remplacé par la migration :
      					//				    tableauprix..VISIBLE = FAUX
      					produits.tableauprix..Visible=Faux
      				FIN
      			fin    
      		fin
      		//Code WinDev 5.5 remplacé par la migration :
      		//	produits.pro_onglet[4]..etat = actif
      		produits.pro_onglet[4]..etat = actif; produits.pro_onglet[4]..Visible=Vrai
      		//		produits.iunitetype = 1
      
      	cas 3
      		produits.pro_onglet[7]..etat = actif; produits.pro_onglet[7]..Visible=Vrai
      		si modif ou ajout = Vrai ou provenance = "bouton" alors
      			//Code WinDev 5.5 remplacé par la migration :
      			//		saisie_produit..etat = INACTIF
      			//			produits.saisie_produit..etat = AffichageSeulement; produits.saisie_produit..Visible=Vrai
      			produits.Saisie_Fourniture..etat = actif
      			produits.Saisie_Fourniture..Visible=Vrai
      			produits.pro_onglet = 7
      		fin
      		//Code WinDev 5.5 remplacé par la migration :
      		//	produits.pro_onglet[5]..etat = actif
      		produits.pro_onglet[7]..etat = actif; produits.pro_onglet[7]..Visible=Vrai
      	cas 4
      		//Code WinDev 5.5 remplacé par la migration :
      		//	produits.pro_onglet[6]..etat = actif
      		remplirFourniture()
      		produits.pro_onglet[6]..etat = actif; produits.pro_onglet[6]..Visible=Vrai
      		si modif ou ajout = Vrai ou provenance = "bouton" alors
      			si modif ou ajout = Vrai alors
      				//Code WinDev 5.5 remplacé par la migration :
      				//			combo_calcul..etat = actif
      				produits.combo_calcul..etat = actif; produits.combo_calcul..Visible=Vrai
      				//Code WinDev 5.5 remplacé par la migration :
      				//		    saisie_produit..etat = ACTIF
      				produits.saisie_produit..etat = ACTIF; produits.saisie_produit..Visible=Vrai
      				//Code WinDev 5.5 remplacé par la migration :
      				//			saisie_carrelage..etat = actif
      				produits.saisie_carrelage..etat = actif; produits.saisie_carrelage..Visible=Vrai
      			sinon
      				//Code WinDev 5.5 remplacé par la migration :
      				//		    saisie_produit..etat = inACTIF
      				produits.saisie_produit..etat = AffichageSeulement; produits.saisie_produit..Visible=Vrai
      				//Code WinDev 5.5 remplacé par la migration :
      				//			saisie_carrelage..etat = inactif
      				produits.saisie_carrelage..etat = AffichageSeulement; produits.saisie_carrelage..Visible=Vrai
      				//Code WinDev 5.5 remplacé par la migration :
      				//			combo_calcul..etat = inactif
      				produits.combo_calcul..etat = AffichageSeulement; produits.combo_calcul..Visible=Vrai
      				execute("produits.isaisietotalcarreau..mod")
      
      			fin
      			//		si ajout  = vrai alors
      			//			ecranpremier("combo_calcul")
      			//			
      			//		FIN
      
      			produits.pro_onglet = 6
      		fin
      
      	cas 5
      
      		//Code WinDev 5.5 remplacé par la migration :
      		//	produits.pro_onglet[7]..etat = actif
      		produits.pro_onglet[8]..etat = actif; produits.pro_onglet[8]..Visible=Vrai
      		si modif ou ajout = Vrai ou provenance = "bouton" alors
      			//Code WinDev 5.5 remplacé par la migration :
      			//		saisie_produit..etat = INACTIF
      			produits.saisie_produit..etat = AffichageSeulement; produits.saisie_produit..Visible=Vrai
      			produits.Saisie_peinture..etat = actif
      			produits.saisie_produit..etat = ACTIF
      			produits.saisie_produit..Visible=Vrai
      		    ExécuteTraitement(produits.csUnitePeinture,trtModification)
      			produits.pro_onglet = 8
      			fin
      
      fin
      
      
      selon sansespace(invent.inum)
      	cas sansespace(config.lienDemiThermos)
      		produits.BTN_DETRUIRE..etat = Grisé
      		
      	AUTRE CAS
      
      		produits.BTN_DETRUIRE..Etat = produits.fiche..etat		
      FIN
      
      si produits.pro_onglet = 1 et pas wrecherche alors
      //	reprisesaisie("table")
      fin
      
     type : 458752
