      txtsql = ChaîneConstruit(txtsql,IdClient,idsaison)
      
      Reqsql est une source de donnees
      
      HExécuteRequêteSQL(Reqsql,hRequêteDéfaut,txtsql)
      
      renvoyer Reqsql.jourlivraison
      
      
