     type_code : 15
     code : |1+
      Procédure calculprixescfutur(no_produit1,no_produit2,no_produit3,udemesure = "A")
      montant est un reel  = 0
      nombredeverre est un entier = 0
      totalextra est un reel = 0
      hpos est un entier
      
      j est un entier
      
      si pas sansespace(no_produit1) = "" alors
      	hlitrecherche("invent","INUM",no_produit1)
      //Code WinDev 5.5 remplacé par la migration :
      //	si pas h.endehors et h.trouve alors
      	si pas HEnDehors() et HTrouve() alors
      		si pas sansespace(invent.ipextra) = "" alors
      			si invent.ipextra <> invent.inum alors
      				hpos = hsauveposition("invent")
      				hlitrecherche("invent","INUM",invent.ipextra)
      //Code WinDev 5.5 remplacé par la migration :
      //				si pas h.endehors et h.trouve alors
      				si pas HEnDehors() et HTrouve() alors
      					
      					si sansespace(invent.idateprixfutur) = "" alors
      						selon udemesure
      						cas "A"
      							totalextra += invent.IPRIXa
      						cas "M"
      							totalextra += invent.iprixm
      						FIN
      					sinon	 
      						selon udemesure
      						cas "A"
      							totalextra += invent.IPRIXfutur
      						cas "M"
      							totalextra += invent.iprixfuturm
      						FIN
      					fin	 
      				FIN
      				hretourposition(hpos)
      			sinon
      				si sansespace(invent.idateprixfutur) = "" alors
      					selon udemesure
      					cas "A"
      						totalextra += invent.IPRIXa
      					cas "M"
      						totalextra += invent.iprixm
      					FIN
      				sinon	 
      					selon udemesure
      					cas "A"
      						totalextra += invent.IPRIXfutur
      					cas "M"
      						totalextra += invent.iprixfuturm
      					FIN
      				fin	 
      				
      				
      			FIN
      		FIN
      	fin
      	si pas sansespace(invent.ipextrat) = "" alors
      		si invent.ipextrat <> invent.inum alors
      			hpos = hsauveposition("invent")
      			hlitrecherche("invent","INUM",invent.ipextrat)
      //Code WinDev 5.5 remplacé par la migration :
      //			si pas h.endehors et h.trouve alors
      			si pas HEnDehors() et HTrouve() alors
      				si sansespace(invent.idateprixfutur) = "" alors
      					selon udemesure
      					cas "A"
      						totalextra += invent.IPRIXa
      					cas "M"
      						totalextra += invent.iprixm
      					FIN
      				sinon	 
      					selon udemesure
      					cas "A"
      						totalextra += invent.IPRIXfutur
      					cas "M"
      						totalextra += invent.iprixfuturm
      					FIN
      				fin	 
      				
      			FIN
      			hretourposition(hpos)
      			
      		sinon
      			si sansespace(invent.idateprixfutur) = "" alors
      				selon udemesure
      				cas "A"
      					totalextra += invent.IPRIXa
      				cas "M"
      					totalextra += invent.iprixm
      				FIN
      			sinon	 
      				selon udemesure
      				cas "A"
      					totalextra += invent.IPRIXfutur
      				cas "M"
      					totalextra += invent.iprixfuturm
      				FIN
      			fin	 
      			
      		FIN
      	fin
      	nombredeverre++
      FIN
      si pas sansespace(no_produit2) = "" alors
      	hlitrecherche("invent","INUM",no_produit2)
      //Code WinDev 5.5 remplacé par la migration :
      //	si pas h.endehors et h.trouve alors
      	si pas HEnDehors() et HTrouve() alors
      		si pas sansespace(invent.ipextra) = "" alors
