     type_code : 15
     code : |1+
      Procédure CopierInexVersINC()
      
      pour tout spacer 
      	si spacer.stype = "I" alors
      	  spacer.Stype = "T"
      	  spacer.sdescription = remplace(spacer.sdescription,"Inex","INC")
      	  hajoute(spacer)
      	fin
      FIN
      
     type : 458752
   -
     name : RemplaceFormule
     procedure_id : 5862043216973743496
     type_code : 15
     code : |1+
      Procédure RemplaceFormule(_formule)
      
      
      si sansespace(DescriptionVarInter1) <> "" alors
      	_formule = remplace(_formule,DescriptionVarInter1,"VARINTER1")
      fin
      si sansespace(DescriptionVarInter2) <> "" alors
      	_formule = remplace(_formule,DescriptionVarInter2,"VARINTER2")
      fin
      si sansespace(DescriptionVarInter3) <> "" alors
      	_formule = remplace(_formule,DescriptionVarInter3,"VARINTER3")
      fin
      si sansespace(DescriptionVarInter4) <> "" alors
      	_formule = remplace(_formule,DescriptionVarInter4,"VARINTER4")
      fin
      si sansespace(DescriptionVarInter5) <> "" alors
      	_formule = remplace(_formule,DescriptionVarInter5,"VARINTER5")
      fin
      renvoyer _formule
     type : 458752
   -
     name : trouvetauxtaxe
     procedure_id : 1365737525457757824
     type_code : 15
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] trouvetauxtaxe (<_NumeroClient> [, <_date> [, <_langue>]])
      //
      // Paramètres :
      //	_NumeroClient : <indiquez ici le rôle de _IDTaxeGroupe>
      //	_date : <indiquez ici le rôle de _date>
      //	_langue (valeur par défaut=1) : < indiquez ici le rôle de _langue >
      // Valeur de retour :
      // 	tableau : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE trouvetauxtaxe(_NumeroClient,_date = datesys(),_langue = 1)
      _tableautaxe est un tableau dynamique de 0 par 4 chaine
      
      si hlitrecherche(Client,numero,_NumeroClient) alors
      	Reqsql est une source de donnees
      	txtreq est une chaine = 
      	[
      	SELECT 
      	TaxeGroupeDate.IDTaxeGroupeDate AS IDTaxeGroupeDate,	
      	TaxeGroupeDate.IDTaxeGroupe AS IDTaxeGroupe,	
      	TaxeGroupeDate.DateDebut AS DateDebut,	
      	TaxeGroupeDate.DateFin AS DateFin,	
      	TaxeGroupeDateTaux.IDTaxeGroupeDateTaux AS IDTaxeGroupeDateTaux,	
      	TaxeGroupeDateTaux.IDTaxeGroupeDate AS IDTaxeGroupeDate_Ta,	
      	TaxeGroupeDateTaux.Ordre AS Ordre,	
      	TaxeGroupeDateTaux.Description AS Description,	
      	TaxeGroupeDateTaux.Taux AS Taux,	
      	TaxeGroupeDateTaux.nogl AS nogl,	
      	TaxeGroupeDateTaux.Combine AS Combine,	
      	TaxeGroupeDateTaux.DescriptionAnglaise AS DescriptionAnglaise
      	FROM 
      	TaxeGroupeDate,	
      	TaxeGroupeDateTaux
      	WHERE 
      	TaxeGroupeDateTaux.IDTaxeGroupeDate	=	TaxeGroupeDate.IDTaxeGroupeDate
      	AND
      	(
      	TaxeGroupeDate.IDTaxeGroupe = %1
      	AND	TaxeGroupeDate.DateDebut <= '%2'
      	AND	TaxeGroupeDate.DateFin >= '%2'
      	)
      	ORDER BY 
      	Ordre ASC
      	]
      	
      	txtreq = ChaîneConstruit(txtreq,client.IDTaxeGroupe,_date)
      	
      	si hexecuterequetesql(Reqsql,hRequêteDéfaut,txtreq)
      		pour TOUT Reqsql 
      			
      			tableauajouteligne(_tableautaxe,_langue = 1 ? Reqsql.description sinon Reqsql.descriptionanglaise,Reqsql.taux,Reqsql.nogl,Reqsql.combine)
      		fin
      		
      	fin
      fin
      renvoyer _tableautaxe
      
     type : 458752
   -
     name : calculTotalCommande
     procedure_id : 1466308762713474606
     type_code : 15
     code : |1+
      Procédure calculTotalCommande(lNoCommande=0,lBonLivraison est un booleen = faux)
      TotalQuantite est un reel = 0
      totalcommande est un reel = 0
      
      lQteAjuste est un reel
      //SI MODIF ALORS
      
      
      
      
      
      
      
      
      hlitrecherche(fdetail,fdnocomm,lNoCommande)
      //Code WinDev 5.5 remplacé par la migration :
      //tantque pas h.endehors
      tantque pas HEnDehors() et fdetail.fdnocomm= lNoCommande
      lQteAjuste = lBonLivraison ? 1 sinon fdetail.fdqteafacturer / fdetail.fdqte
      	selon fdetail.ftype
      		cas 1
      //			rthermos+=((arrondi(fdetail.fdprixtotal,2)+arrondi(fdetail.surchargeenergie,2)) * lQteAjuste) + (fdetail.fdqteafacturer * (fdetail.FDextra10X+fdetail.FDextra5x))
                  TotalQuantite += Fdetail.fdqteafacturer
      			TotalCommande+=((arrondi(fdetail.fdprixtotal,2)+arrondi(fdetail.surchargeenergie,2)) * lQteAjuste) + (fdetail.fdqteafacturer * (fdetail.FDextra10X+fdetail.FDextra5x))
      		cas 2
      //			rthermos+=((arrondi(fdetail.fdprixtotal,2)+arrondi(fdetail.surchargeenergie,2)) * lQteAjuste) + (fdetail.fdqteafacturer * (fdetail.FDextra10X+fdetail.FDextra5x))
      //			totalquantite += Fdetail.fdqteafacturer
      			TotalCommande+=((arrondi(fdetail.fdprixtotal,2)+arrondi(fdetail.surchargeenergie,2)) * lQteAjuste) + (fdetail.fdqteafacturer * (fdetail.FDextra10X+fdetail.FDextra5x))
      		cas 3
      //			rautres+=(arrondi(fdetail.fdprixtotal,2)) * lQteAjuste
      			TotalCommande+=(arrondi(fdetail.fdprixtotal,2)) * lQteAjuste
      		cas 4
      //			rcarrelage+=(arrondi(fdetail.fdprixtotal,2)) * lQteAjuste
      			TotalCommande+=(arrondi(fdetail.fdprixtotal,2)) * lQteAjuste
      			si fdetail.fpeinture alors
      				TotalCommande+=(arrondi(fdetail.fTotalPeinture,2)) * fdetail.fdqteafacturer
      //				carrelagept+=(arrondi(fdetail.fTotalPeinture,2)) * fdetail.fdqteafacturer
      			fin
      		cas 5
      //			rpeinture+=(arrondi(fdetail.fdprixtotal,2)) * lQteAjuste
      			TotalCommande+=(arrondi(fdetail.fdprixtotal,2)) * lQteAjuste
      
      	FIN
      
      	//hmodifie("trdetail")
      	HLITSUIVANT(fdetail,fdnocomm)
      
      fin		 
      
      
      renvoyer numeriqueverschaine(TotalCommande)+";"+numeriqueverschaine(TotalQuantite)
      
      
      
      
     type : 458752
   -
     name : calculTotalCommandeBL
     procedure_id : 1466729360268253910
     type_code : 15
     code : |1+
      Procédure calculTotalCommandeBL(lNoCommande=0)
      rTotalCommande est un reel
      rthermos est un reel
      
      //SI MODIF ALORS
      
      
      
      
      
      hlitrecherche(hfdetail,HFCLEUNIK,lNoCommande)
      //Code WinDev 5.5 remplacé par la migration :
      //tantque pas h.endehors
      tantque pas HEnDehors() et hfdetail.HFCLEUNIK= lNoCommande
      
      	selon hfdetail.ftype
      		cas 1
      			rthermos +=  arrondi(hfdetail.fdqteafacturer * ((hfdetail.fdpiedcarrefacture * hfdetail.fdprixupiedfacture) + ...
      			hfdetail.fdextraforme),2)+arrondi(hfdetail.fdqteafacturer *hfdetail.FDextra10X,2)+...
      			arrondi(hfdetail.fdqteafacturer *hfdetail.FDextra5x,2)+arrondi(hfdetail.SUrchargeafacturer,2)
      			rTotalCommande +=  hfdetail.fdqteafacturer 
      			
      		cas 2
      			rthermos +=  arrondi(hfdetail.fdqteafacturer * hfdetail.fdprixu,2)
      			rTotalCommande +=  hfdetail.fdqteafacturer 
      		cas 3
      	//		rautres +=  arrondi(hfdetail.fdqteafacturer * hfdetail.fdprixupied,2)
      			rthermos +=  arrondi(hfdetail.fdqteafacturer * hfdetail.fdprixupied,2)
      		cas 4
      	//		rcarrelage +=  arrondi((hfdetail.frcarrprixu + hfdetail.fdcarrprixdebase)* hfdetail.fdqteafacturer,2)
      
      			rthermos +=  arrondi((hfdetail.frcarrprixu + hfdetail.fdcarrprixdebase)* hfdetail.fdqteafacturer,2)...
      			+arrondi(((hfdetail.Ftotalcarreaupeinture*hfdetail.fPrixCarreauPeinture)...
      			+(hfdetail.FDnbcarreauPeinture1*hfdetail.fdprixcarreaupeinture1))...
      			* hfdetail.fdqteafacturer ,2)
      
      	//		rcarrelagept += arrondi(((hfdetail.Ftotalcarreaupeinture*hfdetail.fPrixCarreauPeinture)...
      	//		+(hfdetail.FDnbcarreauPeinture1*hfdetail.fdprixcarreaupeinture1))...
      	//		* hfdetail.fdqteafacturer ,2)
      		cas 5
      	//		rpeinture +=  arrondi(hfdetail.fdqteafacturer * (hfdetail.fdpiedcarrefacture * hfdetail.fdprixupied),2)
      			rthermos+=  arrondi(hfdetail.fdqteafacturer * (hfdetail.fdpiedcarrefacture * hfdetail.fdprixupied),2)
      
      
      	FIN
      
      
      	//hmodifie("trdetail")
      	HLITSUIVANT(hfdetail,HFCLEUNIK)
      
      fin		 
      
      renvoyer numeriqueverschaine(rTotalCommande)+";"+numeriqueverschaine(rthermos)
      
      
      
      //FIN
      
     type : 458752
   -
     name : TrouveExtraDemi
     procedure_id : 1530890085647125228
     type_code : 15
     code : |1-
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] TrouveExtraDemi (<noclient>)
      //
      // Paramètres :
      //	noclient : <indiquez ici le rôle de noclient>
      // Valeur de retour :
      // 	réel : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE TrouveExtraDemi(noclient)
      valeuraretourner est un reel = 0
      RecordEnCours est un entier = HSauvePosition(produitclient)
      si hlitrecherche(ProduitClient,IdClientIdproruit,HConstruitValClé(ProduitClient,IdClientIdproruit,noclient,gNoExtraDemi)) alors
      	valeuraretourner =  produitclient.IPrixa
      sinon si hlitrecherche(invent,inum,gNoExtraDemi) alors
      	valeuraretourner = invent.iprixunite
      	
      		
      FIN
      HRetourPosition(RecordEnCours)
      
      renvoyer valeuraretourner
     type : 458752
   -
     name : LogErreur
     procedure_id : 1543889465603484656
     type_code : 15
     code : |1+
      PROCEDURE LogErreur()
      
      //info(repdonnees)
      fid est un entier = fouvre(completerep(repdonnees)+"Log\Log"+DateHeureSys()+".txt",foCréation)
      TitreSuivant("Erreur de l'application")
      //Erreur("Une erreur est survenue et l'application va fermer")
      Erreur(ExceptionInfo(errComplet))
      
      si fid <> -1 alors
      	fecrit(fid,ExceptionInfo(errComplet))
      	fferme(fid)
      fin
      HFerme("*")
      FinProgramme()	
      
     type : 458752
   -
     name : GetCommandeEdiFromDatFile
     procedure_id : 1630705924468511585
     type_code : 15
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] GetCommandeEdiFromDatFile (<fid> est entier)
      //
      // Paramètres :
      //	fid (entier) : <indiquez ici le rôle de fid>
      // Valeur de retour :
      // 	oCommandeEdi : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE GetCommandeEdiFromDatFile(fid est un entier)
      
      _NomCie est un entier = 1
      _NoCommande est une entier = 2
      _DateRequise est un entier = 3
      _DateCommande est un entier = 4
      _NoPorte est un entier = 5
      _CommandePar est un entier = 6
      _noTelephoneAchat est un entier = 7
      _noTelephoneLivraison est un entier  = 8
      
      _NoLigne est un entier = 1
      _Qte est un entier = 2
      _Largeur est un entier = 3
      _Hauteur est un entier =4
      _fini est un entier = 5
      _UniteMesure est un entier = 6
      _NbThermos est un entier = 7
      _Intercalaire est un entier = 8
      _descverre est un entier = 9
      _refclient est un entier = 10
      _cap est un entier = 11
      _gaz est un entier = 12
      _nbcarreauhor est un entier = 13
      _nbcarreauver est un entier = 14
      _DescCarrelage est un entier = 15
      _DescCarrelage2 est un entier = 16
      _Alignement est un entier = 17
      _TypeCarrelage est un entier = 18
      _distance est un entier = 19
      _proportion est un entier = 20
      _doubleseal est un entier = 21
      
      
      
      
      
      cCommandeEdi est un oCommandeEdi = new oCommandeEdi()
      
      //fid est un entier = fouvre(fSélecteur("g:\edi", "", "Sélectionnez un fichier...", "Tous les fichiers (*.*)" + TAB + "*.*", "*.*"),foLecture)
      LigneLue est une chaine = flitligne(fid )
      
      cCommandeEdi._Client = extraitchaine(LigneLue,_NomCie,";")
      cCommandeEdi._NoCommande = ExtraitChaîne(LigneLue,_NoCommande,";")
      cCommandeEdi._DateRequise = ExtraitChaîne(LigneLue,_DateRequise,";")
      cCommandeEdi._Datecommande = ExtraitChaîne(LigneLue,_DateCommande,";")
      cCommandeEdi._NoPorte = ExtraitChaîne(LigneLue,_NoPorte,";")
      cCommandeEdi._Acheteur = ExtraitChaîne(LigneLue,_CommandePar,";")
      cCommandeEdi._Telephoneachat = ExtraitChaîne(LigneLue,_noTelephoneAchat,";")
      cCommandeEdi._Telephonelivraison = ExtraitChaîne(LigneLue,_noTelephoneLivraison,";")
      
      LigneLue  = flitligne(fid )
      
      tantque sansespace(LigneLue) <> ""
      	ccommandeediLigne est un oCommandeEdiLigne = new oCommandeEdiLigne()
      	ccommandeediLigne._noLigne =  ExtraitChaîne(LigneLue,_NoLigne,";")
      	ccommandeediLigne._Quantite =  ExtraitChaîne(LigneLue,_Qte,";")
      	ccommandeediLigne._largeur = ExtraitChaîne(LigneLue,_Largeur,";")
      	ccommandeediLigne._Hauteur = ExtraitChaîne(LigneLue,_Hauteur,";")
      	ccommandeediLigne._fini = 	ExtraitChaîne(LigneLue,_fini,";")
      	ccommandeediLigne._UniteDeMesure = 	ExtraitChaîne(LigneLue,_UniteMesure,";")
      	ccommandeediLigne._NbVerre = 	ExtraitChaîne(LigneLue,_NbThermos,";")
      	ccommandeediLigne._TypeIntercalaire = extraitchaine(LigneLue,_Intercalaire,";")
      	ccommandeediLigne._DescriptionVerre = ExtraitChaîne(LigneLue,_descverre,";")
      	ccommandeediLigne._RefClient = ExtraitChaîne(LigneLue,_refclient,";")
      	ccommandeediLigne._Cap = ExtraitChaîne(LigneLue,_cap,";")
      	ccommandeediLigne._gaz = ExtraitChaîne(LigneLue,_gaz,";")
      	ccommandeediLigne._NbCarreauHorizontal = 	ExtraitChaîne(LigneLue,_nbcarreauhor,";")
      	ccommandeediLigne._NbCarreauvertical = 	ExtraitChaîne(LigneLue,_nbcarreauver,";")
      	ccommandeediLigne._TypeCarrelage = 	ExtraitChaîne(LigneLue,_DescCarrelage,";")
      	ccommandeediLigne._TypeCarrelage2 = ExtraitChaîne(LigneLue,_DescCarrelage2,";")
      	ccommandeediLigne._CommandeAlignement = ExtraitChaîne(LigneLue,_Alignement,";")
      	ccommandeediLigne._Type = ExtraitChaîne(LigneLue,_TypeCarrelage,";")
      	ccommandeediLigne._DistanceSiContour = ExtraitChaîne(LigneLue,_distance,";")
      	ccommandeediLigne._ProportionTete = ExtraitChaîne(LigneLue,_proportion,";")
      	ccommandeediLigne._DoubleSeal = ExtraitChaîne(LigneLue,_doubleseal,";")
      	
      	TableauAjoute(cCommandeEdi.tabLigneCommande,ccommandeediLigne)
      	
      	LigneLue  = fLitLigne(fid )
      	
      	
      	
      	
      	
      FIN
      
      
      renvoyer cCommandeEdi
      
     type : 458752
   -
     name : GetCommandeEdiFromHyperFile
     procedure_id : 1651155221552859742
     type_code : 15
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] GetCommandeEdiFromHyperFile (<IdFacture> est entier)
      //
      // Paramètres :
      //	IdFacture (entier) : <indiquez ici le rôle de fid>
      // Valeur de retour :
      // 	oCommandeEdi : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE GetCommandeEdiFromHyperFile(IdFacture est un entier)
      reqsql est une source de donnees
      reqtxt est une chaine = [
      select * from FdetailInternet where FACLEUNIK = %1
      ]
      
      
      si HLitRecherche(FactureInternet,FACLEUNIK,IdFacture) alors
      	cCommandeEdi est un oCommandeEdi = new oCommandeEdi()
      	
      	
      	
      	cCommandeEdi._Client = FactureInternet.fiClient
      	cCommandeEdi._NoCommande = factureinternet.FiNumeroCommande
      	cCommandeEdi._DateRequise = FactureInternet.fiDateRequise
      	cCommandeEdi._DateCommande = FactureInternet.fiDateCommande
      	cCommandeEdi._NoPorte = FactureInternet.FiNoPorte
      	cCommandeEdi._Acheteur = FactureInternet.fiAcheteur
      	cCommandeEdi._Telephoneachat = FactureInternet.fiTelAchat
      	cCommandeEdi._Telephonelivraison = FactureInternet.fiTelLivraison
      	
      	
      FIN
      iConfigure
      reqtxt = chaineconstruit(reqtxt,FactureInternet.FACLEUNIK)
      si HExécuteRequêteSQL(reqsql,hRequêteDéfaut,reqtxt) alors
      	pour tout reqsql
      		ccommandeediLigne est un oCommandeEdiLigne = new oCommandeEdiLigne()
      		ccommandeediLigne._noLigne =  reqsql.noLigne
      		ccommandeediLigne._Quantite =  reqsql.QUANTITE
      		ccommandeediLigne._largeur = reqsql.LARGEUR
      		ccommandeediLigne._Hauteur = reqsql.LARGEUR
      		ccommandeediLigne._fini = 	reqsql.fini
      		ccommandeediLigne._UniteDeMesure = 	reqsql.UniteMesure
      		ccommandeediLigne._NbVerre = 	reqsql.NbVerre
      		ccommandeediLigne._TypeIntercalaire = reqsql.TYpeIntercalaire
      		ccommandeediLigne._DescriptionVerre = reqsql.descriptionVerre
      		ccommandeediLigne._RefClient = reqsql.réfClient
      		ccommandeediLigne._Cap = reqsql.cap
      		ccommandeediLigne._Gaz = reqsql.Gaz
      		ccommandeediLigne._NbCarreauHorizontal = 	reqsql.NbCarreauHorizontal
      		ccommandeediLigne._NbCarreauVertical = 	reqsql.NbCarreauVertical
      		ccommandeediLigne._TypeCarrelage = 	reqsql.tYpecarrelage
      		ccommandeediLigne._TypeCarrelage2 = ""
      		ccommandeediLigne._CommandeAlignement = reqsql.COmmandeAlignement
      		ccommandeediLigne._Type = reqsql.type
      		ccommandeediLigne._DistanceSiContour = reqsql.dImensionSiContour
      		ccommandeediLigne._ProportionTete = reqsql.ProportionTete
      		ccommandeediLigne._DoubleSeal = reqsql.DoubleSeal
      		
      		
      		TableauAjoute(cCommandeEdi.tabLigneCommande,ccommandeediLigne)
      	fin	
      sinon
      	info(herreurinfo(hErrMessage))	
      FIN
      
      
      renvoyer cCommandeEdi
      
