   -
     name : AjouteOrder
     procedure_id : 4511921382020798683
     type_code : 15
     code : |1+
      
      fonction AjouteOrder(ChOrder,Ajout)
      si ChOrder="" alors
      	renvoyer Ajout
      sinon
      	renvoyer ChOrder+","+Ajout
      fin
      
     type : 458752
   -
     name : AjouteSelect
     procedure_id : 4511921381703473371
     type_code : 15
     code : |1+
      
      fonction AjouteSelect(Select,NomFic,NomRub)
      // La chaîne Select est constituée de deux chaînes séparées par EOT: 
      //   NomDesRubriques+EOT+NomDesFichiers
      
      si Select="" alors
      	renvoyer NomFic+"."+NomRub+EOT+NomFic
      sinon
      	si Position(","+ExtraitChaine(Select,2,EOT)+"," , ","+NomFic+",")=0 alors
      		renvoyer ExtraitChaine(Select,1,EOT)+","+NomFic+"."+NomRub+EOT+...
      				ExtraitChaine(Select,2,EOT)+","+NomFic
      	sinon
      		renvoyer ExtraitChaine(Select,1,EOT)+","+NomFic+"."+NomRub+EOT+...
      				ExtraitChaine(Select,2,EOT)
      	fin
      fin
      
     type : 458752
   -
     name : AjouteWhere
     procedure_id : 4511921380614461689
     type_code : 15
     code : |1+
      
      fonction AjouteWhere(ChWhere,Ajout)
      // Ajoute la condition Ajout à la condition ChWhere
      // Si ChWhere est différente de "", il faut ajouter "(" et ")" autour pour gérer le "AND"
      
      si Ajout="" alors
      	renvoyer ChWhere
      sinon
      	si ChWhere="" alors
      		renvoyer Ajout
      	sinon
      		renvoyer "("+ChWhere+") AND "+Ajout
      	fin
      fin
      
     type : 458752
   -
     name : calculprixescfutur
