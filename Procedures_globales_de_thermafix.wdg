   -
     name : SupprimeFacture
     procedure_id : 4709642807295188080
     type_code : 15
     code : |1+
      Procédure SupprimeFacture(NoCommande)
      qteafacturer est un reel
      qtedejafacture est un reel
      
      
      
      
      toutelafacture = vrai
      si hlitrecherche(Facture,fanumero,NoCommande) alors
      
      	hlitrecherche("fdetail","fdnocomm",facture.fanumero)
      
      	tantque fdetail.fdnocomm = facture.fanumero et pas HEnDehors()
      
      		si fdetail.fdqteafacturer = fdetail.fdqte-fdetail.fdqtedejafacture alors  
      			hsupprime("fdetail",hnumenrencours)
      			si hErreurIntégrité() alors
      			FIN
      		sinon
      			qtedejafacture = fdetail.fdqtedejafacture
      			qteafacturer = fdetail.fdqteafacturer
      			fdetail.fdqtedejafacture =  qtedejafacture + qteafacturer
      			fdetail.fdqteafacturer = fdetail.fdqte - fdetail.fdqtedejafacture
      			toutelafacture = faux
      			hmodifie("fdetail",hnumenrencours)
      		fin
      		hlitsuivant("fdetail","fdnocomm")
      
      	FIN
      
      	si hErreurIntégrité() alors
      	FIN
      
      	si toutelafacture alors
      
      		hsupprime("Facture")
      		si hErreurIntégrité() alors
      		FIN
      	sinon
      		facture.FPREPARATION = ""
      		hmodifie("facture")	
      	FIN
      	//prepfacture.majhistorique(numeroenregistrement,nocommande)
      	//toutelafacture = vrai
      
      fin
      
     type : 458752
   -
     name : Remplir_repetitif
     procedure_id : 4735664370114442432
     type_code : 15
     code : |1+
      Procédure Remplir_repetitif(lfenetre="commande")
      
      
      champrepetitif = allouer un tableau de 0 par 0 chaine
      
      i est un entier = 1
      hlit(Répétitif,i)
      tantque pas hendehors(Répétitif)
      	dimension(champrépétitif,i,7)
      	champrépétitif[i,1] = remplace(répétitif.NomChamp,"commande",lfenetre,SansCasse)
      	champrépétitif[i,2] = remplace(répétitif.RépétitifChamp,"commande",lfenetre,SansCasse)
      	champrépétitif[i,4] = remplace(répétitif.condition,"commande",lfenetre,SansCasse)
      	champrépétitif[i,5] = remplace(répétitif.persistant,"commande",lfenetre,SansCasse)
      	ChampRépétitif[i,7] = remplace(repetitif.formuleaexecuter,"commande",lfenetre,SansCasse)
      	i++
      	hlit(Répétitif,i)
      FIN
