   -
     name : transfert_facture
     procedure_id : 4511921385461636954
     type_code : 15
     code : |1+
      Procédure transfert_facture(numero_bl,affichemessageerreur = faux,messageaafficher = "")
      fac_entete est un tableau de 5 chaines
      totalfacture est un reel  = 0
      totalsurcharge est un reel = 0
      totalextracap est un reel = 0
      totalextraforme est un reel = 0
      totaltaxe est un reel = 0
      totalligne est un reel = 0
      valeuraverifier est une chaine
      i est un entier = 0
      typededocument est un entier
      lCodeErreur est un entier
      
      
      libérer fac_detail
      fac_detail = allouer un tableau de 0 par 4 chaine
      //fac_detail[1,1] = ""
      //fac_detail[1,2] = "0.00"
      hlitrecherche(BonLivraison,Bnumero,numero_bl)
      si htrouve(BonLivraison) alors
      	//	bonlivraison.BDateFacture = datesys()
      	//	bonlivraison.Bfacture = prochainnumerodefacture
      	//	hmodifie(BonLivraison,hNumEnrEnCours)
          selon bonlivraison.brien   // type de document
          cas "1"
          	typededocument = 3
          cas "2"
          	typededocument = 2	
          fin
          	
      	fac_entete[1] = bonlivraison.Bclient
      	fac_entete[2] = dateverschaine(bonlivraison.Bdatefacture,"JJ/MM/AAAA")
      	fac_entete[3] = numeriqueverschaine(bonlivraison.Bfacture) 
      
      	fac_entete[4] = numeriqueverschaine(bonlivraison.Bnumero)
      	fac_entete[5] = "Transfert / Logiciel de production"
      
      
      	hexecuterequete(RequeteDetailCompta,hRequêteDéfaut,numero_bl)
      	hlitpremier(requeteDetailCompta)
      	tantque pas hendehors(RequeteDetailCompta)
      		si RequeteDetailCompta.MontantGlivre <> 0 alors
      			i++
      			dimension(fac_detail,i,4)
      			fac_detail[i,1] = RequeteDetailCompta.NoGlivre
      			fac_detail[i,2] = numeriqueverschaine(RequeteDetailCompta.MontantGlivre)
      			fac_detail[i,3] = RequeteDetailCompta.EstTaxe
      		fin
      		hlitsuivant(RequeteDetailCompta)
      	fin
      //	valeuraverifier = Aco_AjoutTrxRcv(fac_entete,fac_detail,typededocument) 
      	valeuraverifier = ACCC_TrxAjout(fac_entete,fac_detail,typededocument,lCodeErreur) 
      
      
      	si extraitchaine(valeuraverifier,1,",") = "1"
      		bonlivraison.Btransfere = vrai
      		hmodifie(BonLivraison)
      		renvoyer vrai
      	sinon
      		si affichemessageerreur alors 
      			messageaafficher = extraitchaine(valeuraverifier,2,",")
      			acso_message("Erreur",extraitchaine(valeuraverifier,2,","),"Erreur")
      		sinon
      			messageaafficher = extraitchaine(valeuraverifier,2,",")
      		fin
      		//	   bonlivraison.Btransfere = 2
      		//	   hmodifie(BonLivraison)
      		renvoyer faux
      	fin
      sinon
      	renvoyer faux
      fin
      
     type : 458752
