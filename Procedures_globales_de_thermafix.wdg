      						hlitrecherche(hfdetail,fdnocommfdligne1,HConstruitValClé(hfdetail,fdnocommfdligne1,fdetail.fdnocomm,fdetail.fdligne))
      						tantque pas hendehors(hfdetail) et hfdetail.fdnocomm = fdetail.fdnocomm et hfdetail.fdligne = fdetail.fdligne
      							hfdetail.fdextraforme= fdetail.fdextraforme
      							hfdetail.fdprixtotal = arrondi(hfdetail.fdqteafacturer * ( fdetail.fdprixu + fdetail.fdextraforme),2)
      							HModifie(hfdetail,hNumEnrEnCours)
      							HLitSuivant(hfdetail,fdnocommfdligne1)
      					fin
      			fin
      		fin
      		hlitsuivant(BonLivraison,BnoCommande)
      	fin
      
      fin
      
      
      fin
      fin
      hlitsuivant(fdetail,fdnocomm)
      FIN
      //	fin
      HLitSuivant(Facture,fanumero)
      FIN
      
      Ferme(AfficheMiseajour)
      
      
      
      
      
