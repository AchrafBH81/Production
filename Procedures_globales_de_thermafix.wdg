     code : |1-
      Procédure EpurePDF(lChemin,lnom,lchange,lnbjours)
      
      //si Position(lChemin,lTypeDoc,1,DepuisDébut)  > 0 ALORS
      	
      	si dateversentier(datesys())-DateVersEntier(fDate(lChemin+lnom)) >= lnbjours alors
      		FenAttentePetite.libelle1 = "Epuration du fichier PDF en cours......"+RC+rc+lChemin+lnom
      		multitacherepeint(FenAttentePetite)
      		fsupprime(lChemin+lnom)
      		
      	FIN
      	
      //fin
     type : 458752
   -
     name : AjusteFacture
     procedure_id : 5276340926731612759
     type_code : 15
     code : |1-
      Procédure AjusteFacture()
      
      ancienneintegrite	est un booleen	= HGèreIntégrité(Contrainte_Facture_fdetail,hEnSuppression,faux)
      CommandeFacture		est un booleen	= vrai
      pour tout facture avec "FPREPARATION = 'B'"
      	message(facture.fanumero)
      	multitacherepeint()
      	CommandeFacture=vrai
      	hlitrecherche(hfacture,fanumero,facture.fanumero) 
      	tantque pas HEnDehors(hfacture) et hfacture.fanumero = facture.fanumero
      		si hlitrecherche(BonLivraison,Bnumero,hfacture.Bnumero) 
      			si BonLivraison.Bfacture = 0 alors
      				CommandeFacture = faux
      			fin
      		FIN
      		HLitSuivant(hfacture,fanumero)
      	FIN
      	si CommandeFacture alors
      		sdReqsqldelete est une source de donnees
      		HExécuteRequêteSQL(sdReqsqldelete,hRequêteDéfaut,"delete from fdetail where fdetail.fdnocomm = "+ facture.fanumero)
      		HSupprime(facture,hNumEnrEnCours)
      	fin
      	multitache(-1)
      FIN
      
      HGèreIntégrité(Contrainte_Facture_fdetail,hEnSuppression,ancienneintegrite)
      
      
      //pour tout fdetail
      //	Message(fdetail.fdnocomm)
      //	MultitâcheRepeint()
      //	si pas hlitrecherche(facture,fanumero,fdetail.fdnocomm) alors
      //		hsupprime(fdetail,hnumenrencours)
      //	FIN
      //	Multitâche(-1)
      //FIN
      
      sTxtsql est une chaine = [
      delete from fdetail where fdetail.fdnocomm not in (select facture.fanumero from facture)
      ]
      sdReqsql est une source de donnees
      HExécuteRequêteSQL(sdReqsql,hRequêteDéfaut,sTxtsql)
