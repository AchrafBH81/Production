   -
     name : connecter_usager
     internal_properties : CQAAAAkAAAAETzEdwRNMKZCPH5biRPuGIhjJRSEy3U5JTZLOlnghFVmFZRAIgAj/DndRQNodyJtsm+0/ZceFTWe1eMnQaGiLmgPfLUoNfKg7ZDSdjQfgE4hHDRZHlxXQX2O7phicXMgmI90vZoTwQshKoz41fdqz8xIKS6ylpZC1pX+bK8EWsw4U
     procedure_id : 5336042918805521276
     type_code : 15
     code : |1+
      // Traitement automatique des exceptions :   exécuter le bloc de code CAS EXCEPTION:
      //
      Procédure connecter_usager()
      
      tableauinfocie	est un tableau dynamique
      wpathexe		est une chaine	//inilit("ACOMBA","PATHEXE","",repencours+"production.ini")
      wpathdata		est une chaine	//  inilit("ACOMBA","PATHDATA","",repencours+"production.ini")
      wpathcie		est une chaine	//= inilit("ACOMBA","CIE","",repencours+"production.ini")
      nomusager		est une chaine	= inilit("USAGER","USAGER","",repencours+"production.ini")
      souvenir		est un booleen	= inilit("USAGER","SOUVENIR","",repencours+"production.ini")
      wmotdepasse		est une chaine	= decrypte(inilit("USAGER","MOTDEPASSE","",repencours+"production.ini"),"planisoft")
      
      ///////////////////////////////////////////////////////////////
      
      
      si gLogCompt = "Acomba" et pas enmodetest() alors
      	///////////////////////////////
      	// Si Acomba
      	///////////////////////////////
      	si pas AcombaX.ACCC_AcombaInit ALORS
      		ACSO_message("Erreur","Impossible d'initialiser la connection  avec acomba","Erreur")
      		goto sortie
      		FinProgramme()
      	FIN
      	wpathexe	= INILit("ACOMBA","PATHEXE","",repencours+"production.ini")
      	wpathdata	= INILit("ACOMBA","PATHDATA","",repencours+"production.ini")
      	wpathcie	= INILit("ACOMBA","CIE","",repencours+"production.ini")
      	boucle
      		
      		si pas acombax.ACSO_CompagnieConnection(completerep(wpathdata),wpathexe,faux) alors
      			si pas ouvre(acombax.Connection,wpathexe,wpathdata,wpathcie) alors
      				ACSO_message("Erreur","Impossible de se connecter sur la société "+wpathcie,"Erreur")
      				
      				FinProgramme()
      				
      				
      			fin
      		sinon
      			sortir
      		fin
      		///////////////////////
      		// code a conserver temporairement
      		// Jean Hamelin 31 decembre 2013
      		//
      		//	si pas ouvre(acombax.Connection,wpathexe,wpathdata,wpathcie) alors
      		//		goto sortie
      		//		finprogramme()
      		//	sinon
      		//		si acombax.ACSO_CompagnieConnection(completerep(wpathdata)+sansespace(wpathcie),wpathexe,faux) alors
      		//		si acombax.ACSO_CompagnieConnection(completerep(wpathdata),wpathexe,faux) alors
      		//			sortir	
      		//		FIN
      		//	FIN
      	fin
      	iniecrit("ACOMBA","PATHEXE",wpathexe,repencours+"production.ini")
      	iniecrit("ACOMBA","PATHDATA",wpathdata,repencours+"production.ini")
      	iniecrit("ACOMBA","CIE",wpathcie,repencours+"production.ini")
      	
      	
      	boucle
      		selon ouvre(acombax.motdepasse,nomusager,wmotdepasse,wpathexe,wpathdata,souvenir,gConnexionHF) 
      			//	barredetachemessageaafficher=acomba.aco_nomcie()+" [  "+nomusager+ "  ]"
      			cas 1 
      				
      				tableauinfocie = acombax.ACSO_CompagnieInfo()
      				message(" " + tableauinfocie[1]+" [  "+nomusager+ "  ]"+" Version " +  EXEInfo("Version"))
      				
      				//message(acomba.aco_nomcie()+" [  "+nomusager+ "  ]")
      				//AcombaIni()
      				lusager				= nomusager
      				//		maitre.btn_usager..LARGEUR = (TAILLE(lusager)+1) * 10
      				//Code WinDev 5.5 remplacé par la migration :
      				//	maitre.btn_usager..colonne = 780 - (TAILLE(lusager) * 10)
      				//		maitre.btn_usager..x = sysxres() - (TAILLE(lusager) * 10) - 30
      				//		maitre.btn_usager..libellé  = lusager
      				//		maitre.btn_usager..etat = actif
      				//		maitre.BTN_usager..visible = vrai
      				//		maitre.btn_constructor..etat = actif
      				ensemblepersoactif	= vrai
      				HChangeConnexion("*",gConnexionHF)
      				hlitpremier(config)
      				si pas config.FichierThermosCommun
      					//			HChangeRep("PERSOENS",ComplèteRep(repdonnees)+SansEspace(lusager))
      					HChangeRep("PERSOENS",".\"+SansEspace(lusager))
      					//    HASSIGNE("Glivre",repdonnees+sansespace(usager))
      					hcreationsiinexistant("PERSOENS")
      				fin
      				si souvenir alors
      					iniecrit("USAGER","USAGER",nomusager,repencours+"production.ini")
      					iniecrit("USAGER","MOTDEPASSE",crypte(wmotdepasse,"planisoft"),repencours+"production.ini")
      					iniecrit("USAGER","SOUVENIR",numeriqueverschaine(souvenir),repencours+"production.ini")
      				sinon
      					iniecrit("USAGER","USAGER","",repencours+"production.ini")
      					iniecrit("USAGER","MOTDEPASSE","",repencours+"production.ini")
      					iniecrit("USAGER","SOUVENIR","",repencours+"production.ini")
      					
      				fin
      				
      				
      				
      				AcombaIni()
      				
      				acousager		= nomusager
      				acomotdepasse	= wmotdepasse
      				acosouvenir		= souvenir	
      				acoacomba		= wpathexe
      				acodonnees		= wpathdata
      				sortir
      			cas 2  // sortie demandé par l'utilisateur
      				finprogramme()
      				
      				//       Avantage.av_deconnecter(nomdelasocket01)
      			//		affiche_menu(acousager)
      			cas 3  // impossible de connecter sur le serveur Hyperfile
      				
      				acso_message("Erreur","Impossible de de connecter sur le serveur de base de données","info")
      				
      		fin
      		
      	fin
      sinon
      	ensemblepersoactif	= vrai
      	//	maitre.btn_constructor..etat = actif
      	//	message("Version " +  EXEInfo("Version")+" " + config.NomCompagnie)
      	cleusb				= val(INILit("USB","STANDALONE","0",repencours+"production.ini"))
      	si  cleusb alors
      		hchangerep("*",completerep(frepencours())+"data")
      	sinon	
      		BOUCLE
      			
      			selon ouvre(ConnecteurHF,gConnexionHf)
      				cas 2 
      					finprogramme()
      				CAS 3  // impossible de connecter sur le serveur Hyperfile
      					
      					ACSO_message("Erreur","Impossible de de connecter sur le serveur de base de données","info")	
      				AUTRE CAS
      					HChangeConnexion("*",gConnexionHF)	
      					
      					
      					si hlitrecherche(Usager,NomUsager,gsuser) alors
      						gsusername = sansespace(usager.Prenom+" "+usager.nom) 
      						
      						si usager.IsNew alors
      							si ouvre(FEN_CreatePassword)  alors
      								sortir
      							sinon
      								erreur("Erreur lors de la création du mot de passe")
      								continuer
      							fin
      							
      						FIN
      						si pas usager.IsActive alors
      							erreur("Utilisateur inactif !!")
      							continuer
      						FIN
      						si usager.MotDePasse = gsPassword alors
      							sortir
      						sinon
      							Erreur("Mot de passe incorrect !")
      							
      						FIN
      						
      					sinon
      						erreur("Utilisateur inexistant !")
      					FIN
      					
      					
      			FIN
      			
      		fin
      	fin	
      	
      	
      fin
      
      
      
      
      
      sortie:
      
      CAS EXCEPTION:
      info("Connecteur HF:"+exceptioninfo(herrcomplet))
     type : 458752
   -
     name : AcombaIni
     procedure_id : 5336043893162162943
     type_code : 15
     code : |1+
      Procédure AcombaIni(change = faux)
      
      dfMonfichier EST une description de fichier
      drMarubrique EST UNE DESCRIPTION DE RUBRIQUE
      nUmeroderecord est un entier = 1
      listegl est un tableau dynamique = ACGL_FicheListe()
      
      
      //info(frep(repavantage,FRRepertoire))
      
      
      HChangeRep(glivre,".\"+NetAdresseIP())
      //HChangeRep(Glivre,fRepEnCours())
      //    HASSIGNE("Glivre",repdonnees+sansespace(usager))
      //hcreationsiinexistant("PERSOENS")
      hcreation(glivre)
      
      i est un entier 
      
      pour i = 1 a dimension(listegl)/2
      	
      	glivre.numerogl = sansespace(listegl[i,1])
      	glivre.Description    = listegl[i,2]
      	hajoute(glivre)
      
      fin
      
      //ouvre(numerodegrandlivre)
      
      
     type : 458752
   -
     name : LireOnglet
     procedure_id : 5337559569088081274
     type_code : 15
     code : |1+
      // Remplit la table avec les éléments parents (onglets, groupe) de la fenêtre
      // Entrée:	sParent		Nom de l'élément parent
      Procédure LireOnglet(sParent, nType)
      
      
      
      // Premier champ de la fenêtre
      nValRech est un entier=enumpremier
      si nType=typGrp alors nValRech+=enumGroupe
      sNomChamp est une chaîne=EnumèreSousElément(sParent,nValRech)
      TANTQUE sNomChamp<>""
      
      	// nom complet du champ
      	sNomComplet est une chaine=sParent+"."+sNomChamp
      
      	// si on énumération des groupes
      	si nType={sNomComplet}..type alors
      		sNomChamp=EnumèreSousElément(sNomComplet,enumVolet+enumPremier)
      		tantque sNomChamp <> ""
      			si hlitrecherche("gpwconfigurationelement","configuration_element",HConstruitValClé("gpwconfigurationelement","configuration_element",lusager,sNomComplet+"."+sNomChamp),hIdentique) alors
      				selon {"gpwconfigurationelement.etat"}
      					cas 1
      					cas 2
      						{sNomComplet}[sNomChamp]..etat = inactif
      					cas 3
      						{sNomComplet}[sNomChamp]..etat = grise
      
      					cas 4
      						{sNomComplet}[sNomChamp]..etat = invisible
      				FIN
      			FIN
      			sNomChamp=EnumèreSousElément(sNomComplet,enumVolet)
      		FIN
      		// ajout de l'élément dans la table
      //		AjouteElement(sNomComplet,nType,"","")
      	sinon
      		
      		// si le type correspond, ajout de l'élément dans la table
      //		si {sNomComplet,indgpw}..Type=nType alors AjouteElement(sNomComplet,nType,{sNomComplet,indgpw}..libelle,{sNomComplet,indgpw}..groupe)
      	fin
      
      	// Champ suivant
      	sNomChamp=EnumèreSousElément(sParent)
      FIN
      
     type : 458752
   -
     name : ValideOnglet
     procedure_id : 5337559698221425572
     type_code : 15
     code : |1+
      Procédure ValideOnglet(lnomfenetre)
      
      LireOnglet(lnomfenetre,typOnglet)
      
      
     type : 458752
   -
     name : MajHistoFac
     procedure_id : 5379166946387087274
     type_code : 15
     code : |1+
      Procédure MajHistoFac()
      rectotal est une chaine = sansespace(NumériqueVersChaine(hnbenr(facture)+hnbenr(hfacture)))
      i est un entier
      
      pour tout hfacture 
      i++
      MiseaJourFacture.csnCompteur = sansespace(NumériqueVersChaine(i))+"/"+rectotal
      MultitacheRepeint(MiseaJourFacture)
      	si hlitrecherche(client,numero,hfacture.faclient) alors
      		hfacture.nom = client.nom
      		hfacture.Adresse = client.crue
      		hfacture.ville = client.cville
      		hfacture.CodePostal = client.ccodepostal
      		hfacture.noTelephone = client.ctelephone
      		hmodifie(hfacture,hNumEnrEnCours)
      	FIN
      	
      FIN
      pour tout facture 
      	i++
      	MiseaJourFacture.csnCompteur = sansespace(NumériqueVersChaine(i))+"/"+rectotal
      	MultitacheRepeint(MiseaJourFacture)
      	si hlitrecherche(client,numero,facture.faclient) alors
      		facture.nom = client.nom
      		facture.Adresse = client.crue
      		facture.ville = client.cville
      		facture.CodePostal = client.ccodepostal
      		facture.noTelephone = client.ctelephone
      		hmodifie(facture,hNumEnrEnCours)
      	FIN
      
      FIN
     type : 458752
   -
     name : calcul_anglais
     procedure_id : 5472690910620072244
     type_code : 15
     code : |1-
      // ramener une valeur décimale en anglais
      
      Procédure calcul_anglais(dimensionacalculer)
      j est un entier = memoccurrence("tableau_anglais")
      k est un entier = 1
      lapartiedecimaletexte est une chaine = ""
      lapartieentiere est une chaine = sansespace(numeriqueverschaine(partieentiere(val(dimensionacalculer)/25.4)))
      lapartiedecimale est un entier = arrondi(partiedecimale(val(dimensionacalculer)/25.4),3)*1000
      
      si lapartiedecimale > 0 alors
      	mempremier("tableau_anglais")
      	tantque memvalcle("tableau_anglais") < lapartiedecimale 
      		si memencours("tableau_anglais") = j alors
      			sortir
      		sinon	
      			memsuivant("tableau_anglais")
      		FIN
      	FIn
      	
         si memvalcle("tableau_anglais") < lapartiedecimale alors
          lapartiedecimaletexte = ""
          lapartieentiere = NumériqueVersChaine(val(lapartieentiere)+1)
         sinon
         		
      	lapartiedecimaletexte = memrecupere("tableau_anglais",memencours("tableau_anglais"))
         fin
      sinon
      	lapartiedecimaletexte = ""
      fin
      
      renvoyer lapartieentiere + " "+lapartiedecimaletexte
     type : 458752
   -
     name : CalculPrixThermos
     procedure_id : 5584661601804385645
     type_code : 15
     code : |1-
      Procédure CalculPrixThermos(NoThermos,_IDclient,cdcomposant1="",cdcomposant2="",cdcomposant3="",pdebase="")
      resultat est un reel = 0
      NbThermos est un entier = 0
      Extra est une chaine
      ExtraT est une chaine
      PrixTotal est un reel = 0
      PrixTotalM est un reel = 0
      PrixTotalFutur est un reel = 0
      PrixTotalFuturM est un reel = 0
      special est un booleen = faux
      
      
      
      si  hlitrecherche(persoens,ennumero,complete(NoThermos,20),hIdentique) et  (persoens.enfabrication ou persoens.enVerreUnite)
      	//si pas sansespace(NoThermos)="" et hlitrecherche(persoens,ennumero,nothermos) ALORS
      	//	si cdfabrication 
      	si hlitrecherche(ThermosClient,IdClientIdhermos,hconstruitvalcle(ThermosClient,IdClientIdhermos,complete(client.numero,10),complete(NoThermos,20))) et ThermosClient.prixSpecial ALORS
      		PrixTotal+=thermosclient.Tprixa
      		PrixTotalM+=ThermosClient.Tprixm
      		special=vrai
      	sinon
      		PrixTotal+=persoens.enprixa
      		PrixTotalM+=persoens.enprixm
      		PrixTotalFutur+= persoens.enprixfutura
      		PrixTotalFuturM+= persoens.enprixfuturm
      		special=faux
      	fin
      sinon
      
      
      	si sansespace(cdcomposant1) <> "" alors
      		NbThermos++
      
      		si hlitrecherche(invent,INUM,cdcomposant1)  alors
      			si pas invent.ibase alors
      				Extra = invent.ipextra
      				ExtraT = invent.ipextrat
      				si hlitrecherche(FclientExtra,IdClientNoProduit,HConstruitValClé(FclientExtra,IdClientNoProduit,_IDclient,sansespace(Extra)),hIdentique) et fclientextra.prixSpecial ALORS
      					PrixTotal+=FclientExtra.PrixAnglais
      					PrixTotalM+=FclientExtra.Prixmetrique
      					special=vrai
      				sinon
      					si hlitrecherche(invent,INUM,Extra) alors
      						PrixTotal+= arrondi(invent.IPRIXA,2)
      						PrixTotalM+= arrondi(invent.iprixm,2)
      						PrixTotalFutur+= arrondi(invent.iprixfutur,2)
      						PrixTotalFuturM+= arrondi(invent.iprixfuturm,2)
      					FIN
      				fin	
      				si hlitrecherche(FclientExtra,IdClientNoProduit,HConstruitValClé(FclientExtra,IdClientNoProduit,_IDclient,sansespace(ExtraT)))  et fclientextra.prixSpecial ALORS
      					PrixTotal+=FclientExtra.PrixAnglais
      					PrixTotalM+=FclientExtra.Prixmetrique
      					special=vrai
      				sinon
      					si hlitrecherche(invent,INUM,ExtraT) alors
      						PrixTotal+= arrondi(invent.IPRIXA,2)
      						PrixTotalM+= arrondi(invent.IPRIXm,2)
      						PrixTotalFutur+= arrondi(invent.iprixfutur,2)
      						PrixTotalFuturM+= arrondi(invent.iprixfuturm,2)
      					FIN
      				fin
      			fin
      
      
      		fin
      
      	Fin
      
      	si sansespace(cdcomposant2) <> "" alors
      		NbThermos++
      
      		si hlitrecherche(invent,INUM,cdcomposant2)  alors
      			si pas invent.ibase alors
      				Extra = invent.ipextra
      				ExtraT = invent.ipextrat
      				si hlitrecherche(FclientExtra,IdClientNoProduit,HConstruitValClé(FclientExtra,IdClientNoProduit,_IDclient,sansespace(Extra))) et fclientextra.prixSpecial ALORS
      					PrixTotal+=FclientExtra.PrixAnglais
      					PrixTotalM+=FclientExtra.Prixmetrique
      					special=vrai
      				sinon
      					si hlitrecherche(invent,INUM,Extra) alors
      						PrixTotal+= arrondi(invent.IPRIXA,2)
      						PrixTotalM+=arrondi(invent.IPRIXm,2)
      						PrixTotalFutur+= arrondi(invent.iprixfutur,2)
      						PrixTotalFuturM+= arrondi(invent.iprixfuturm,2)
      					FIN
      				fin
      				si hlitrecherche(FclientExtra,IdClientNoProduit,HConstruitValClé(FclientExtra,IdClientNoProduit,_IDclient,sansespace(ExtraT))) et fclientextra.prixSpecial ALORS
      					PrixTotal+=FclientExtra.PrixAnglais
      					PrixTotalM+=FclientExtra.Prixmetrique
      					special=vrai
      				sinon
      
      					si hlitrecherche(invent,INUM,ExtraT) alors
      						PrixTotal+= arrondi(invent.IPRIXA,2)
      						PrixTotalM+= arrondi(invent.IPRIXm,2)
      						PrixTotalFutur+= arrondi(invent.iprixfutur,2)
      						PrixTotalFuturM+= arrondi(invent.iprixfuturm,2)
      					FIN
      				fin
      			fin
      
      		fin
      
      	Fin
      
      
      	si sansespace(cdcomposant3) <> "" alors
      		NbThermos++
      
      		si hlitrecherche(invent,INUM,cdcomposant3)  alors
      			si pas invent.ibase alors
      				Extra = invent.ipextra
      				ExtraT = invent.ipextrat
      				si hlitrecherche(FclientExtra,IdClientNoProduit,HConstruitValClé(FclientExtra,IdClientNoProduit,_IDclient,sansespace(Extra))) et fclientextra.prixSpecial ALORS
      					PrixTotal+=FclientExtra.PrixAnglais
      					PrixTotalM+=FclientExtra.Prixmetrique
      					special=vrai
      				sinon
      					si hlitrecherche(invent,INUM,Extra) alors
      						PrixTotal+= arrondi(invent.IPRIXA,2)
      						PrixTotalM+= arrondi(invent.IPRIXm,2)
      						PrixTotalFutur+= arrondi(invent.iprixfutur,2)
      						PrixTotalFuturM+= arrondi(invent.iprixfuturm,2)
      					FIN
      				fin
      				si hlitrecherche(FclientExtra,IdClientNoProduit,HConstruitValClé(FclientExtra,IdClientNoProduit,_IDclient,sansespace(ExtraT))) et fclientextra.prixSpecial ALORS
      					PrixTotal+=FclientExtra.PrixAnglais
      					PrixTotalM+=FclientExtra.Prixmetrique
      					special=vrai
      				sinon
      
      					si hlitrecherche(invent,INUM,ExtraT) alors
      						PrixTotal+= arrondi(invent.IPRIXA,2)
      						PrixTotalM+= arrondi(invent.IPRIXm,2)
      						PrixTotalFutur+= arrondi(invent.iprixfutur,2)
      						PrixTotalFuturM+= arrondi(invent.iprixfuturm,2)
      					FIN
      				fin
      			fin
      
      
      		fin
      
      	Fin
      	
      	//si hlitrecherche(FclientExtra,IdClientNoProduit,HConstruitValClé(FclientExtra,IdClientNoProduit,_IdClient,sansespace(persoens.epbase))) et fclientextra.prixSpecial ALORS
      		si hlitrecherche(FclientExtra,IdClientNoProduit,HConstruitValClé(FclientExtra,IdClientNoProduit,_IDclient,sansespace(pdebase))) et fclientextra.prixSpecial ALORS
      		special=vrai
      		si NbThermos = 2 alors
      			PrixTotal+= arrondi(FclientExtra.PrixAnglaisD,2)
      			PrixTotalM+= arrondi(FclientExtra.PrixmetriqueD,2)
      		sinon si NbThermos = 3
      			PrixTotal+= arrondi(fclientextra.PrixAnglaisT,2)
      			PrixTotalM+= arrondi(fclientextra.PrixMetriqueT,2)
      		FIN
      	sinon
      	//	si hlitrecherche(invent,INUM,persoens.epbase) alors
      			si hlitrecherche(invent,INUM,pdebase) alors
      				si  NbThermos = 2  alors
      				PrixTotal+= arrondi(invent.IPRIXDOUBLE,2)
      				PrixTotalM+= arrondi(invent.IPRIXDOUBLEM,2)
      				PrixTotalFutur+= arrondi(invent.iprixfuturdouble,2)
      				PrixTotalFuturM+= arrondi(invent.iprixfuturdoublem,2)
      			sinon si  NbThermos = 3 
      				PrixTotal+= arrondi(invent.iprixtriple,2)
      				PrixTotalM+= arrondi(invent.iprixtripleM,2)
      				PrixTotalFutur+= arrondi(invent.iprixfuturtriple,2)
      				PrixTotalFuturM+= arrondi(invent.iprixfuturtriplem,2)
      
      			FIN
      		fin
      	FIN
      fin
      
      si HLitRecherche(PrixSurchargeClient,IDClientennumero,HConstruitValClé(PrixSurchargeClient,IDClientennumero,_IDclient,Complète(NoThermos,20))) ALORS
      	PrixTotal = PrixSurchargeClient.PrixAnglais
      	PrixTotalM = PrixSurchargeClient.PrixMetrique	
      FIN
      
      
      renvoyer NumériqueVersChaine(PrixTotal)+","+numeriqueverschaine(PrixTotalM) + "," + special + ","+ NumériqueVersChaine(PrixTotalFutur)+","+numeriqueverschaine(PrixTotalFuturM)
     type : 458752
   -
     name : CalculPrixThermosListe
     procedure_id : 5602894686253585116
     type_code : 15
     code : |1-
      Procédure CalculPrixThermosListe(NoThermos,_IDclient,cdcomposant1="",cdcomposant2="",cdcomposant3="",pdebase="")
      resultat est un reel = 0
      NbThermos est un entier = 0
      Extra est une chaine
      ExtraT est une chaine
      PrixTotal est un reel = 0
      PrixTotalM est un reel = 0
      special est un booleen = faux
      
      
      si  hlitrecherche(persoens,ennumero,complete(NoThermos,20),hIdentique) et  (persoens.enfabrication ou persoens.enVerreUnite)
      	//si pas sansespace(NoThermos)="" et hlitrecherche(persoens,ennumero,nothermos) ALORS
      	//	si cdfabrication 
      	si hlitrecherche(ThermosClient,IdClientIdhermos,hconstruitvalcle(ThermosClient,IdClientIdhermos,complete(client.numero,10),complete(NoThermos,20))) et ThermosClient.prixSpecial ALORS
      		PrixTotal+=thermosclient.Tprixa
      		PrixTotalM+=ThermosClient.Tprixm
      		special=vrai
      	sinon
      		PrixTotal+=persoens.enprixa
      		PrixTotalM+=persoens.enprixm
      		special=faux
      	fin
      sinon
      
      	cdcomposant1 = persoens.encomposant1
      	cdcomposant2 = persoens.encomposant2
      	cdcomposant3 = persoens.encomposant3
      	pdebase = persoens.epbase
      
      	si sansespace(cdcomposant1) <> "" alors
      		NbThermos++
      
      		si hlitrecherche(invent,INUM,cdcomposant1)  alors
      			si pas invent.ibase alors
      				Extra = invent.ipextra
      				ExtraT = invent.ipextrat
      				si hlitrecherche(FclientExtra,IdClientNoProduit,HConstruitValClé(FclientExtra,IdClientNoProduit,_IDclient,sansespace(Extra))) et fclientextra.prixSpecial ALORS
      					PrixTotal+=FclientExtra.PrixAnglais
      					PrixTotalM+=FclientExtra.Prixmetrique
      					special=vrai
      				sinon
      					si hlitrecherche(invent,INUM,Extra) alors
      						PrixTotal+= arrondi(invent.IPRIXA,2)
      						PrixTotalM+= arrondi(invent.iprixm,2)
      					FIN
      				fin	
      				si hlitrecherche(FclientExtra,IdClientNoProduit,HConstruitValClé(FclientExtra,IdClientNoProduit,_IDclient,sansespace(ExtraT)))  et fclientextra.prixSpecial ALORS
      					PrixTotal+=FclientExtra.PrixAnglais
      					PrixTotalM+=FclientExtra.Prixmetrique
      					special=vrai
      				sinon
      					si hlitrecherche(invent,INUM,ExtraT) alors
      						PrixTotal+= arrondi(invent.IPRIXA,2)
      						PrixTotalM+= arrondi(invent.IPRIXm,2)
      					FIN
      				fin
      			fin
      
      
      		fin
      
      	Fin
      
      	si sansespace(cdcomposant2) <> "" alors
      		NbThermos++
      
      		si hlitrecherche(invent,INUM,cdcomposant2)  alors
      			si pas invent.ibase alors
      				Extra = invent.ipextra
      				ExtraT = invent.ipextrat
      				si hlitrecherche(FclientExtra,IdClientNoProduit,HConstruitValClé(FclientExtra,IdClientNoProduit,_IDclient,sansespace(Extra))) et fclientextra.prixSpecial ALORS
      					PrixTotal+=FclientExtra.PrixAnglais
      					PrixTotalM+=FclientExtra.Prixmetrique
      					special=vrai
      				sinon
      					si hlitrecherche(invent,INUM,Extra) alors
      						PrixTotal+= arrondi(invent.IPRIXA,2)
      						PrixTotalM+=arrondi(invent.IPRIXm,2)
      					FIN
      				fin
      				si hlitrecherche(FclientExtra,IdClientNoProduit,HConstruitValClé(FclientExtra,IdClientNoProduit,_IDclient,sansespace(ExtraT))) et fclientextra.prixSpecial ALORS
      					PrixTotal+=FclientExtra.PrixAnglais
      					PrixTotalM+=FclientExtra.Prixmetrique
      					special=vrai
      				sinon
      
      					si hlitrecherche(invent,INUM,ExtraT) alors
      						PrixTotal+= arrondi(invent.IPRIXA,2)
      						PrixTotalM+= arrondi(invent.IPRIXm,2)
      					FIN
      				fin
      			fin
      
      		fin
      
      	Fin
      
      
      	si sansespace(cdcomposant3) <> "" alors
      		NbThermos++
      
      		si hlitrecherche(invent,INUM,cdcomposant3)  alors
      			si pas invent.ibase alors
      				Extra = invent.ipextra
      				ExtraT = invent.ipextrat
      				si hlitrecherche(FclientExtra,IdClientNoProduit,HConstruitValClé(FclientExtra,IdClientNoProduit,_IDclient,sansespace(Extra))) et fclientextra.prixSpecial ALORS
      					PrixTotal+=FclientExtra.PrixAnglais
      					PrixTotalM+=FclientExtra.Prixmetrique
      					special=vrai
      				sinon
      					si hlitrecherche(invent,INUM,Extra) alors
      						PrixTotal+= arrondi(invent.IPRIXA,2)
      						PrixTotalM+= arrondi(invent.IPRIXm,2)
      					FIN
      				fin
      				si hlitrecherche(FclientExtra,IdClientNoProduit,HConstruitValClé(FclientExtra,IdClientNoProduit,_IDclient,sansespace(ExtraT))) et fclientextra.prixSpecial ALORS
      					PrixTotal+=FclientExtra.PrixAnglais
      					PrixTotalM+=FclientExtra.Prixmetrique
      				sinon
      
      					si hlitrecherche(invent,INUM,ExtraT) alors
      						PrixTotal+= arrondi(invent.IPRIXA,2)
      						PrixTotalM+= arrondi(invent.IPRIXm,2)
      						special=vrai
      					FIN
      				fin
      			fin
      
      
      		fin
      
      	Fin
      	
      	//si hlitrecherche(FclientExtra,IdClientNoProduit,HConstruitValClé(FclientExtra,IdClientNoProduit,_IdClient,sansespace(persoens.epbase))) et fclientextra.prixSpecial ALORS
      		si hlitrecherche(FclientExtra,IdClientNoProduit,HConstruitValClé(FclientExtra,IdClientNoProduit,_IDclient,sansespace(pdebase))) et fclientextra.prixSpecial ALORS
      		special=vrai
      		si NbThermos = 2 alors
      			PrixTotal+= arrondi(FclientExtra.PrixAnglaisD,2)
      			PrixTotalM+= arrondi(FclientExtra.PrixmetriqueD,2)
      		sinon si NbThermos = 3
      			PrixTotal+= arrondi(fclientextra.PrixAnglaisT,2)
      			PrixTotalM+= arrondi(fclientextra.PrixMetriqueT,2)
      		FIN
      	sinon
      	//	si hlitrecherche(invent,INUM,persoens.epbase) alors
      			si hlitrecherche(invent,INUM,pdebase) alors
      				si  NbThermos = 2  alors
      				PrixTotal+= arrondi(invent.IPRIXDOUBLE,2)
      				PrixTotalM+= arrondi(invent.IPRIXDOUBLEM,2)
      			sinon si  NbThermos = 3 
      				PrixTotal+= arrondi(invent.iprixtriple,2)
      				PrixTotalM+= arrondi(invent.iprixtripleM,2)
      
      			FIN
      		fin
      	FIN
      fin
      
      
      SI HLitRecherche(PrixSurchargeClient,IDClientennumero,HConstruitValClé(PrixSurchargeClient,IDClientennumero,_IDclient,Complète(NoThermos,20))) ALORS
      	PrixTotal	= PrixSurchargeClient.PrixAnglais
      	PrixTotalM	= PrixSurchargeClient.PrixMetrique	
      FIN
      
      renvoyer NumériqueVersChaine(PrixTotal)+","+numeriqueverschaine(PrixTotalM) + "," + special
     type : 458752
   -
     name : CopierInexVersINC
