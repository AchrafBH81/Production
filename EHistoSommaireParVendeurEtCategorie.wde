     -
       name : EcartMois
       identifier : 0x5987381c066b2bbb
       internal_properties : 
       properties :
        x : 246.915
        width : 22.45
        height : 5.77
       code_elements :
        type_code : 29
        p_codes :
         -
           code : |1+
            si ventemois = 0 et ventemoisprec = 0 alors 
            	moimeme = 0
            sinon SI VenteMois = 0 alors 
            	moimeme = -1
            sinon si ventemoisprec = 0 alors 
            	moimeme = 1
            sinon
            	moimeme = (ventemois - ventemoisprec) / abs(ventemoisprec) 
            	SI Abs(MoiMême) > 99.9999 ALORS 
            		SI MoiMême > 0 ALORS MoiMême = 99.9999 SINON MoiMême = -99.9999
            	FIN
            fin
           type : 327692
     -
       name : VenteAnnee
       identifier : 0x5987381c066c2bbb
       internal_properties : 
       properties :
        x : 269.458
        width : 27.
        height : 5.77
       code_elements :
        type_code : 29
        p_codes :
         -
           code : |1+
            moimeme+= ventemois
           type : 327692
     -
       name : VenteAnneePrec
       identifier : 0x5987381c066d2bbb
       internal_properties : 
       properties :
        x : 296.458
        width : 27.
        height : 5.77
       code_elements :
        type_code : 29
        p_codes :
         -
           code : |1+
            MoiMême+= VenteMoisprec
           type : 327692
     -
       name : EcartAnnee
       identifier : 0x5987381c066e2bbb
       internal_properties : 
       properties :
        x : 323.458
        width : 22.142
        height : 5.77
       code_elements :
        type_code : 29
        p_codes :
         -
           code : |1+
            si venteannee = 0 et venteanneeprec = 0 alors 
            	moimeme = 0
            sinon SI Venteannee = 0 alors 
            	moimeme = -1
            sinon si venteanneeprec = 0 alors 
            	moimeme = 1
            sinon
            	moimeme = (VenteAnnee - venteanneeprec) / abs(venteanneeprec) 
            	si abs(moimeme) > 99.9999 alors 
            		si moimeme > 0 alors moimeme = 99.9999 sinon moimeme = -99.9999
            	FIN
            fin
           type : 327692
