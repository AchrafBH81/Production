      lTableauLibelle[18] = "facpiedcarrefacture,facpiedcarrefacture"
      lTableauLibelle[19] = "facprixuni,facprixuni"
      lTableauLibelle[20] = "facsurcharge,facsurcharge"
      lTableauLibelle[21] = "facsoustotal,facsoustotal"
      lTableauLibelle[22] = "factotal,factotal"
      lTableauLibelle[23] = "factotalpage,factotalpage"
      lTableauLibelle[24] = "facfax,facrecupar"
      lTableauLibelle[25] = "facmetrecarre,facmetrecarre"
      lTableauLibelle[26] = "facmetrecarrefacture,facmetrecarrefacture"
      lTableauLibelle[27] = "facprixunimetre,facprixunimetre"
      lTableauLibelle[28] = "facnotvq,facnotvq"
      lTableauLibelle[29] = "facnotps,facnotps"
      lTableauLibelle[30] = "factvq,factvq"
      lTableauLibelle[31] = "factps,factps"
      lTableauLibelle[32] = "facpied,facpied"
      lTableauLibelle[33] = "facpiedfacture,facpiedfacture"
      lTableauLibelle[34] = "facprixupied,facprixupied"
      lTableauLibelle[35] = "facmetre,facmetre"
      lTableauLibelle[36] = "facmetrefacture,facmetrefacture"
      lTableauLibelle[37] = "facprixumetrelin,facprixumetrelin"
      lTableauLibelle[38] = "vendua,vendua"
      lTableauLibelle[39] = "livrea,Livrea"
      lTableauLibelle[40] = "lcondpaiement,conditionpaiement"
      lTableauLibelle[41] = "notrereference,notrereference"
      lTableauLibelle[42] = "peinturetlt,peinturetlt"
      lTableauLibelle[43] = "peintureinterieure,peintureinterieure"
      lTableauLibelle[44] = "votrecommande,votrecommande"
      lTableauLibelle[45] = "bonlivraison,Bonlivraison"
      lTableauLibelle[46] = "facsurchargetaux,facsurchargetaux"
      selon client.CLangue
      	cas 1
      		pour i = 1 a 46
      			si hlitrecherche(Traduction,TRecherche,extraitchaine(lTableauLibelle[i],1,",")) alors
      				{"eGroupInvoice."+ExtraitChaîne(lTableauLibelle[i],2,",")} = traduction.dFrancais
      			fin
      		FIN
      	cas 2
      		pour i = 1 a 46
      			si hlitrecherche(Traduction,TRecherche,extraitchaine(lTableauLibelle[i],1,",")) alors
      				{"eGroupInvoice."+ExtraitChaîne(lTableauLibelle[i],2,",")} = traduction.danglais
      			fin
      		FIN
      fin
