    code_elements :
     type_code : 30
     p_codes :
      -
        code : |1-
         
        type : 327694
      -
        code : |1+
         si  LIB_OurOrderNumber1 <>  OldOrderNumber  alors
         
         	iimprimebloc(iOrderDetail)
         	oldordernumber = LIB_OurOrderNumber1
         FIN
         
         //// ****************** Nouveau code ****************************
         
         j est un entier
         nIndicecarr est un entier
         bCarrtrouve est un booleen = faux//A FAIRE :
         sCarrnogl est une chaine
         totcar est un reel
         totpeinture est un reel
         
         si ReqGroupShippingBill.ftype = 1 alors
         	lTypeLigne = "Verre"
         sinon si ReqGroupShippingBill.ftype = 2 
         	si pas ReqGroupShippingBill.fdverreunite alors
         		lTypeLigne = "Unite"
         	sinon
         		lTypeLigne = "Verre"
         	fin
         sinon si ReqGroupShippingBill.ftype = 4
         	ltypeligne = "Carrelage" 
         sinon si ReqGroupShippingBill.ftype = 3
         	ltypeligne = "Fourniture" 
         sinon si ReqGroupShippingBill.ftype = 5
         	ltypeligne = "Peinture" 
         fin
         
         //si ReqGroupShippingBill.ftype = 4 alors
         //	corps..visible = faux
         //sinon
         calculligne++
         
         selon lTypeLigne
         	cas "Unite"
         		CORPS..VISIBLE = VRAI
         		rubrique17 = ReqGroupShippingBill.fdprixu
         		rubrique16 = 1
         		//		rubrique16..visible = faux
         	cas "Verre"	
         		corps..visible = vrai
         //		si hlitrecherche(typespac,tnumero,sansespace(ReqGroupShippingBill.ftypespacer)) alors
         //			si client.CLangue=1 alors cspacer = typespac.tdesccourte sinon cspacer = typespac.tdesccourtea
         //		sinon
         //			cspacer = ""	
         //		FIN
         		
         		SI Val(SansEspace(ReqGroupShippingBill.ftypespacer)) <> 0 _AND_ HLitRecherche(IntercalaireCouleurs,IDIntercalaireCouleurs,Val(SansEspace(ReqGroupShippingBill.ftypespacer))) ALORS
         			SI Client.CLangue=1 ALORS CSpacer=IntercalaireCouleurs.DescriptionCourte SINON CSpacer=IntercalaireCouleurs.DesctiptionCourteAnglais
         		SINON
         			CSpacer = ""	
         			
         		FIN
         	cas "Fourniture"	
         		corps..visible = faux
         		iImprimeBloc(ITERATION10)
         		//		rubrique16..visible = vrai
         	cas "Carrelage"
         		corps..visible = faux
         		iImprimeBloc(ITERATION1)
         	cas "Peinture"
         		corps..visible = faux
         		iImprimeBloc(ITERATION2)
         fin
         
         
         
         
         
         //	si pas facturereimpression alors
         //		remplir_tableau(rubrique21,arrondi(rubrique4 * (rubrique16 * rubrique17),2))
         //	FIN
         
         //	totalpage +=  arrondi(ReqGroupShippingBill.fdqteafacturer * ReqGroupShippingBill.fdpiedcarrefacture * ReqGroupShippingBill.fdprixupiedfacture,2)
         //	totalfacture +=  arrondi(ReqGroupShippingBill.fdqteafacturer * ReqGroupShippingBill.fdpiedcarrefacture * ReqGroupShippingBill.fdprixupiedfacture,2)
         
         selon lTypeLigne
         	cas "Unite"
         		//		FIN
         		//		si ReqGroupShippingBill.ftype = 2 et pas ReqGroupShippingBill.fdverreunite alors
         		totalpage +=  arrondi(ReqGroupShippingBill.fdqteafacturer * ReqGroupShippingBill.fdprixu,2)
         		totalfacture +=  arrondi(ReqGroupShippingBill.fdqteafacturer * ReqGroupShippingBill.fdprixu,2)
         //		AlimenteHistoriqueProduit(sansespace(client.numero),ReqGroupShippingBill.BDateFacture,2,ReqGroupShippingBill.fdnumprod,"","","", arrondi(ReqGroupShippingBill.fdqteafacturer * ReqGroupShippingBill.fdprixu,2),...
         //		ReqGroupShippingBill.surchargeenergie,ReqGroupShippingBill.fddesc,ReqGroupShippingBill.fdqteafacturer)
         	cas "Fourniture"
         		//		FIN
         		//		si ReqGroupShippingBill.ftype = 2 et pas ReqGroupShippingBill.fdverreunite alors
         		totalpage +=  arrondi(ReqGroupShippingBill.fdqteafacturer * ReqGroupShippingBill.fdprixupied,2)
         		totalfacture +=  arrondi(ReqGroupShippingBill.fdqteafacturer * ReqGroupShippingBill.fdprixupied,2)
         //		AlimenteHistoriqueProduit(sansespace(client.numero),ReqGroupShippingBill.BDateFacture,2,ReqGroupShippingBill.fdnumprod,"","","", arrondi(ReqGroupShippingBill.fdqteafacturer * ReqGroupShippingBill.fdprixu,2),...
         //		0,ReqGroupShippingBill.fddesc,ReqGroupShippingBill.fdqteafacturer)
         
         	cas "Verre"
         		//sinon
         		totalpage +=  arrondi(ReqGroupShippingBill.fdqteafacturer * ((ReqGroupShippingBill.fdpiedcarrefacture * ReqGroupShippingBill.fdprixupiedfacture) + ...
         		ReqGroupShippingBill.fdextraforme),2)+arrondi(ReqGroupShippingBill.fdqteafacturer *ReqGroupShippingBill.FDextra10X,2)+...
         		arrondi(ReqGroupShippingBill.fdqteafacturer *ReqGroupShippingBill.FDextra5x,2)
         		
         //		totalfacture +=  arrondi(ReqGroupShippingBill.fdqteafacturer * ((ReqGroupShippingBill.fdpiedcarrefacture * ReqGroupShippingBill.fdprixupiedfacture)+ ...
         //		ReqGroupShippingBill.fdextraforme),2)
         		totalfacture +=  arrondi(ReqGroupShippingBill.fdqteafacturer * (ReqGroupShippingBill.fdpiedcarrefacture * ReqGroupShippingBill.fdprixupiedfacture),2)+ ...
         		arrondi(ReqGroupShippingBill.fdqteafacturer *ReqGroupShippingBill.fdextraforme,2)+arrondi(ReqGroupShippingBill.fdqteafacturer *ReqGroupShippingBill.FDextra10X,2)+...
         		arrondi(ReqGroupShippingBill.fdqteafacturer *ReqGroupShippingBill.FDextra5x,2)
         //		wl.trace( Arrondi(ReqGroupShippingBill.fdqteafacturer * (ReqGroupShippingBill.fdpiedcarrefacture * ReqGroupShippingBill.fdprixupiedfacture),2)+ ...
         //		Arrondi(ReqGroupShippingBill.fdqteafacturer *ReqGroupShippingBill.fdextraforme,2)+Arrondi(ReqGroupShippingBill.fdqteafacturer *ReqGroupShippingBill.FDextra10X,2)+...
         //		Arrondi(ReqGroupShippingBill.fdqteafacturer *ReqGroupShippingBill.FDextra5x,2))
         //		
         //		wl.trace(totalfacture)
         
         
         		//		totalpage +=  arrondi(ReqGroupShippingBill.fdqteafacturer * ReqGroupShippingBill.fdpiedcarrefacture * ReqGroupShippingBill.fdprixupiedfacture,2) + ...
         		//		arrondi(ReqGroupShippingBill.fdqteafacturer * ReqGroupShippingBill.fdextraforme,2)
         		//		totalfacture +=  arrondi(ReqGroupShippingBill.fdqteafacturer * ReqGroupShippingBill.fdpiedcarrefacture * ReqGroupShippingBill.fdprixupiedfacture,2) + ...
         		//		arrondi(ReqGroupShippingBill.fdqteafacturer * ReqGroupShippingBill.fdextraforme,2)
         
         
         ///		totalsurcharge += arrondi(ReqGroupShippingBill.SUrchargeafacturer,2)
         		totalsurcharge += arrondi(ReqGroupShippingBill.surchargeenergie,2)
         		totalcap+= arrondi(ReqGroupShippingBill.FDExtraCap * ReqGroupShippingBill.fdqteafacturer,2)
         
         
         //		AlimenteHistoriqueProduit(sansespace(client.numero),ReqGroupShippingBill.BDateFacture, ReqGroupShippingBill.ftype,ReqGroupShippingBill.fdnumprod,ReqGroupShippingBill.fdcomposant1,...
         //		ReqGroupShippingBill.fdcomposant2,ReqGroupShippingBill.fdcomposant3,arrondi(ReqGroupShippingBill.fdqteafacturer * ((ReqGroupShippingBill.fdpiedcarrefacture * ReqGroupShippingBill.fdprixupiedfacture)+ ...
         //		ReqGroupShippingBill.fdextraforme),2)+arrondi(ReqGroupShippingBill.fdqteafacturer *ReqGroupShippingBill.FDextra10X,2)+...
         //		arrondi(ReqGroupShippingBill.fdqteafacturer *ReqGroupShippingBill.FDextra5x,2),...
         //		ReqGroupShippingBill.surchargeenergie,ReqGroupShippingBill.fddesc,ReqGroupShippingBill.fdqteafacturer,0,(ReqGroupShippingBill.fdpiedcarrefacture*lmultiplicateur*ReqGroupShippingBill.fdqteafacturer))
         
         
         	cas "Carrelage"
         		//		FIN
         		//		si ReqGroupShippingBill.ftype = 2 et pas ReqGroupShippingBill.fdverreunite alors
         		totalpage +=  arrondi((ReqGroupShippingBill.frcarrprixu + ReqGroupShippingBill.fdcarrprixdebase)* ReqGroupShippingBill.fdqteafacturer,2)...
         		+arrondi(ReqGroupShippingBill.fTotalPeinture * ReqGroupShippingBill.fdqteafacturer ,2)
         
         //		totalfacture +=  arrondi((ReqGroupShippingBill.frcarrprixu + ReqGroupShippingBill.fdcarrprixdebase)* ReqGroupShippingBill.fdqteafacturer,2)...
         //		+arrondi(((ReqGroupShippingBill.Ftotalcarreaupeinture*ReqGroupShippingBill.fPrixCarreauPeinture)...
         //		+(ReqGroupShippingBill.FDnbcarreauPeinture1*ReqGroupShippingBill.fdprixcarreaupeinture1))...
         //		* ReqGroupShippingBill.fdqteafacturer ,2)
         		totalfacture +=  arrondi(((ReqGroupShippingBill.fdcarrpruxuc * ReqGroupShippingBill.fdnbcarreau) + ReqGroupShippingBill.fdcarrprixdebase)* ReqGroupShippingBill.fdqteafacturer,2)...
         		+arrondi(((ReqGroupShippingBill.Ftotalcarreaupeinture*ReqGroupShippingBill.fPrixCarreauPeinture)...
         		+(ReqGroupShippingBill.FDnbcarreauPeinture1*ReqGroupShippingBill.fdprixcarreaupeinture1))...
         		* ReqGroupShippingBill.fdqteafacturer ,2)
         		// pour calculer le montant a transférer a l'historique
         //		wl.trace( Arrondi(((ReqGroupShippingBill.fdcarrpruxuc * ReqGroupShippingBill.fdnbcarreau) + ReqGroupShippingBill.fdcarrprixdebase)* ReqGroupShippingBill.fdqteafacturer,2)...
         //		+Arrondi(((ReqGroupShippingBill.Ftotalcarreaupeinture*ReqGroupShippingBill.fPrixCarreauPeinture)...
         //		+(ReqGroupShippingBill.FDnbcarreauPeinture1*ReqGroupShippingBill.fdprixcarreaupeinture1))...
         //		* ReqGroupShippingBill.fdqteafacturer ,2))
         //		wl.trace(totalfacture)
         		totcar = arrondi((ReqGroupShippingBill.frcarrprixu + ReqGroupShippingBill.fdcarrprixdebase)* ReqGroupShippingBill.fdqteafacturer,2)
         		totpeinture = arrondi(((ReqGroupShippingBill.Ftotalcarreaupeinture*ReqGroupShippingBill.fPrixCarreauPeinture)...
         		+(ReqGroupShippingBill.FDnbcarreauPeinture1*ReqGroupShippingBill.fdprixcarreaupeinture1))...
         		* ReqGroupShippingBill.fdqteafacturer ,2)
         		
         		//		AlimenteHistoriqueProduit(sansespace(client.numero),ReqGroupShippingBill.BDateFacture,2,ReqGroupShippingBill.fdnumprod,"","","", arrondi(ReqGroupShippingBill.fdqteafacturer * ReqGroupShippingBill.fdprixu,2),...
         		//		ReqGroupShippingBill.surchargeenergie,ReqGroupShippingBill.fddesc,ReqGroupShippingBill.fdqteafacturer)
         //		AlimenteHistoriqueProduit(sansespace(client.numero),ReqGroupShippingBill.BDateFacture,4,ReqGroupShippingBill.fdnumcarr,"","","",...
         //		totcar,0,desccarr,qtecarr24,totpeinture)
         
         	cas "Peinture"
         		//		FIN
         		//		si ReqGroupShippingBill.ftype = 2 et pas ReqGroupShippingBill.fdverreunite alors
         		totalpage +=  arrondi(ReqGroupShippingBill.fdqteafacturer * (ReqGroupShippingBill.fdpiedcarrefacture * ReqGroupShippingBill.fdprixupied),2)
         		totalfacture +=  arrondi(ReqGroupShippingBill.fdqteafacturer * (ReqGroupShippingBill.fdpiedcarrefacture * ReqGroupShippingBill.fdprixupied),2)
         		totpeinture = arrondi(ReqGroupShippingBill.fdqteafacturer * (ReqGroupShippingBill.fdpiedcarrefacture * ReqGroupShippingBill.fdprixupied),2)
         		//		AlimenteHistoriqueProduit(sansespace(client.numero),ReqGroupShippingBill.BDateFacture,2,ReqGroupShippingBill.fdnumprod,"","","", arrondi(ReqGroupShippingBill.fdqteafacturer * ReqGroupShippingBill.fdprixu,2),...
         		//		ReqGroupShippingBill.surchargeenergie,ReqGroupShippingBill.fddesc,ReqGroupShippingBill.fdqteafacturer)
         //		AlimenteHistoriqueProduit(sansespace(client.numero),ReqGroupShippingBill.BDateFacture,5,ReqGroupShippingBill.fdnumprod...
         //		,"","","",Totpeinture,0,DescPeinture,QtePeinture)
         fin
         
         
         
         
         
         
         
         
         
         
         
        type : 327692
      -
        code : |1+
         si ReqGroupShippingBill.ftype <> 4 alors
         
         	si pas facturereimpression alors
         		si ReqGroupShippingBill.ftype <> 4 alors
         			SI ReqGroupShippingBill.FDExtraCap <> 0 ALORS
         				remplir_tableau(rubrique21,arrondi(rubrique18,2) - (arrondi(ReqGroupShippingBill.FDExtraCap * ReqGroupShippingBill.fdqteafacturer,2)),Faux,vrai)
         				remplir_tableau(gclConfig.m_sCapGL,arrondi(ReqGroupShippingBill.FDExtraCap) * ReqGroupShippingBill.fdqteafacturer,Faux,Vrai)
         			SINON
         				remplir_tableau(rubrique21,arrondi(rubrique18,2),Faux,Vrai)
         			FIN
         		fin
         	FIN
         
             si ReqGroupShippingBill.FDextra5x <> 0 ou ReqGroupShippingBill.FDextra10X <> 0 alors
               calculligne++
               iimprimebloc(ITERATION11)
             fin
             	
         	si pas sansespace(ReqGroupShippingBill.fdforme) = ""  ou ReqGroupShippingBill.fdextraforme <> 0  alors
         		calculligne++
         		iImprimeBloc(ITERATION9)	
         		//  totalpage +=  totalextraforme
         		//  totalfacture +=  totalextraforme
         	FIN
         	si pas sansespace(ReqGroupShippingBill.fnotes) = "" alors //ou ReqGroupShippingBill.fdextraforme <> 0 ALORS
         		calculligne++
         		iImprimeBloc(ITERATION3)	
         		//  totalpage +=  totalextraforme
         		//  totalfacture +=  totalextraforme
         	FIN
         	si pas sansespace(ReqGroupShippingBill.fnotes1) = ""   ALORS
         		calculligne++
         		iImprimeBloc(ITERATION5)	
         		//  totalpage +=  totalextraforme
         		//  totalfacture +=  totalextraforme
         	FIN
         sinon
         	si ReqGroupShippingBill.fpeinture alors
         		calculligne++
         		iImprimeBloc(ITERATION6)	
         
         	FIN
         fin
         
         si CORPS..visible ALORS
         	TotaldePage+=rubrique18
         FIN
        type : 327693
      -
        type : 327697
        enabled : false
