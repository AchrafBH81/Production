   -
     name : Remplir_tableau
     procedure_id : 1843272020792173113
     type_code : 14
     code : |1+
      Procédure Remplir_tableau(codegl,montantgl,taxegl=faux,ForceZero=faux)
      codegltrouve est un booleen = faux
      j est un entier = (dimension(fac_detail)/4)
      k est un entier
      si facturereimpression _ou_ (montantgl = 0 _et_ pas ForceZero )alors
      	renvoyer vrai
      FIN
      si pas j = 1 alors
      pour k = 2 a j
      	si fac_detail[k,1] = codegl alors
      		codegltrouve = vrai
      		fac_detail[k,2]=numeriqueverschaine(val(fac_detail[k,2])+montantgl)
      	    sortir
      	FIN
      FIN
      fin
      
      si pas codegltrouve alors
          
      	dimension(fac_detail,j+1,4)
      	fac_detail[j+1,1] = codegl
      	fac_detail[j+1,2] = numeriqueverschaine(montantgl)
          si taxegl alors
          	fac_detail[j+1,3] = "1"
          fin	
      FIN
      
      
      
     type : 458752
   -
