        p_codes :
         -
           type : 327699
           enabled : false
    properties :
     width : 269.4
     height : 61.794
    code_elements :
     type_code : 30
     p_codes :
      -
        code : |1+
         hlitrecherche(client,numero,ReqGroupShippingBill.bclient)
         selon client.CImpressionAngMet
         	cas 1
         	  lmultiplicateur=1
         	cas 2
         		lmultiplicateur=gclconfig.m_rconversionam
         
         FIN
         assigneLibelle()
         si pas ReqGroupShippingBill.fpeinture_hf = 1 alors
             grpPiedPeinture..visible = faux
             GrpMetrePeinture..visible = faux
         	selon client.cUnitemesureImpression
         
         		cas 1
         			grppied..visible= vrai
         			grpmetre..visible = faux
         		cas 2 
         			grppied..visible = faux
         			grpmetre..visible = vrai
         		cas 0,3
         			SI RequetefeuilleLivraison.facalcul = 1 ALORS
         				grpPied..Visible	= Vrai
         				grpMetre..Visible	= Faux
         			sinon
         				grpPied..Visible	= Faux
         				grpMetre..Visible	= Vrai
         				
         			FIN
         	FIN
         sinon
         	grpPied..visible = faux
         	GrpMetre..visible = faux
         	facfini..Libellé=""
         	facspacer..Libellé=""
         	faccarrelage..Libellé=""
         	factotalcarr..Libellé=""
         
         	selon client.CImpressionAngMet
         
         		cas 0,1
         			grppiedpeinture..visible= vrai
         			grpmetrepeinture..visible = faux
         		cas 2 
         			grppiedpeinture..visible = faux
         			grpmetrepeinture..visible = vrai
         	FIN
         
         fin
         SI ReqGroupShippingBill.lNom <> "" ALORS
         	NomClient1 = ReqGroupShippingBill.lNom
         	AdresseClient1 = ReqGroupShippingBill.lRue
         	VilleClient1 = ReqGroupShippingBill.lVille
         	CodePostalClient1 = ReqGroupShippingBill.lCodePostal	
         SINON
         	NomClient1 = "  M Ê M E / S A M E  "
         	AdresseClient1 = ""
         	VilleClient1 = ""
         	CodePostalClient1 = ""
         	
         FIN
         
         //si ReqGroupShippingBill.idlivraison <> 0 alors
         //	si hlitrecherche(ClientLivraison,IDClientLivraison,ReqGroupShippingBill.idlivraison) alors
         //		nomclient1 = ClientLivraison.lNom
         //		adresseclient1 = ClientLivraison.lRue
         //		VilleClient1 = ClientLivraison.lVille+","+ClientLivraison.lprovince
         //		CodePostalClient1 = ClientLivraison.lCodePostal	
         //	FIN
         //sinon
         //	nomclient1 = "  M Ê M E / S A M E  "
         //	adresseclient1 = ""
         //	VilleClient1 = ""
         //	CodePostalClient1 = ""	
         //FIN
         
         si sansespace(ReqGroupShippingBill.fnopeinture) = "" alors
         	grppeinture..visible = faux
         sinon
         	CCouleurPeinture = ReqGroupShippingBill.fnopeinture
         	Cdescpeinture = ReqGroupShippingBill.fdescpeinture
         	si ReqGroupShippingBill.ftypepeinture1= 1 alors
         		hlitrecherche(Traduction,TRecherche,"peintureexterieure")
         		si client.CLangue=1 alors peinturetlt = Traduction.dfrancais sinon peinturetlt = Traduction.danglais
         	FIN
         FIN
         
         si SansEspace(ReqGroupShippingBill.fnopeinture1) <> "" alors
         	CCouleurPeinture1 = ReqGroupShippingBill.fnopeinture1
         	Cdescpeinture1 = ReqGroupShippingBill.fdescpeinture1
         	hlitrecherche(Traduction,TRecherche,"peintureexterieure") 
         	si client.CLangue=1 alors peinturetlt = Traduction.dfrancais sinon peinturetlt = Traduction.danglais
         	GrpPeintureInt..visible = vrai
         sinon
         	GrpPeintureInt..visible = faux    
         FIN
         
         faxclient = client.cfax
         telephoneclient=  (client.cInterurbain ? "(1) " sinon "") +client.ctelephone
         
         _tableautaxe est un tableau dynamique= trouvetauxtaxe(Client.numero,DateValide(ReqGroupShippingBill.BDateFacture) ? ReqGroupShippingBill.BDateFacture SINON DateSys(),Client.CLangue)
         
         SI Dimension(_tableautaxe) >= 4 ALORS
         	taxedesc1 = _tableautaxe[1,1]
         	TaxeGL1 = _tableautaxe[1,3]
         FIN
         SI Dimension(_tableautaxe) = 8 ALORS
         	taxedesc2 = _tableautaxe[2,1]
         	TaxeGL2 = _tableautaxe[2,3]
         	
         
         FIN
        type : 327692
      -
        type : 327697
        enabled : false
