    properties :
     y : 121.112
     width : 269.4
     height : 5.
    code_elements :
     type_code : 30
     p_codes :
      -
        code : |1+
         // a faire: inscrire le coutant pas carreau dans une colonne, le prix de base dans une autre et inscrire le tootal unitaire dans prix.uni.
         qtecarr = ReqGroupShippingBill.fdqteafacturer
         qtecarr6 = ReqGroupShippingBill.fdcarreauv
         qtecarr8 = ReqGroupShippingBill.fdcarreauh
         DescCarr = ReqGroupShippingBill.fddesc
         si ReqGroupShippingBill.fdcarrprixdebase <> 0 alors
         	qtecarr29 = "$ Base"
         	qtecarr30 = ReqGroupShippingBill.fdcarrprixdebase
         sinon
         	qtecarr29 = ""
         	qtecarr30 = 0
         FIN
         
         qtecarr24 = ReqGroupShippingBill.fdnbcarreau
         si ReqGroupShippingBill.TDemiCarrelage alors
         	PrixUnitCarr = ReqGroupShippingBill.fdcarrpruxuc
         	TotalCarr = arrondi((((ReqGroupShippingBill.fdcarrpruxuc)*ReqGroupShippingBill.fdnbcarreau) + ReqGroupShippingBill.fdcarrprixdebase)* ReqGroupShippingBill.fdqteafacturer,2)
         sinon
         	PrixUnitCarr = ReqGroupShippingBill.fdcarrpruxuc
         	TotalCarr = arrondi((ReqGroupShippingBill.frcarrprixu + ReqGroupShippingBill.fdcarrprixdebase)* ReqGroupShippingBill.fdqteafacturer,2)
         FIN
         
         
         
         
         
         
        type : 327692
      -
        code : |1+
         totaldepage+=arrondi(totalcarr,2)
         remplir_tableau(ReqGroupShippingBill.fdcodegl,arrondi(totalcarr,2))
         
         si ReqGroupShippingBill.TDemiCarrelage alors
         	iimprimebloc(ITERATION12)
         FIN
         
        type : 327693
      -
        type : 327697
        enabled : false
