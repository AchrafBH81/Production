     type_code : 30
     p_codes :
      -
        code : |1+
         qtecarr9 = ReqGroupShippingBill.fdqteafacturer
         qtecarr28 = ReqGroupShippingBill.fdcarreauv
         qtecarr64 = ReqGroupShippingBill.fdcarreauh
         qtecarr65 = ReqGroupShippingBill.Ftotalcarreaupeinture
         PrixUnitCarr1 = ReqGroupShippingBill.fPrixCarreauPeinture
         TotalCarr1 = qtecarr65 * PrixUnitCarr1 * qtecarr9
         selon ReqGroupShippingBill.fTypePeinture
         		cas 2
         			si client.CLangue=1 alors DescriptionPeinture = "Peint.TLT" + ReqGroupShippingBill.fNoPeintureExtTout + " " + sansespace(ReqGroupShippingBill.fdescpeintureExtTout) sinon DescriptionPeinture = "TLT Paint" + ReqGroupShippingBill.fNoPeintureExtTout + " " + sansespace(ReqGroupShippingBill.fdescpeintureExtTout)
         		cas 1
         			si client.CLangue=1 alors DescriptionPeinture = "Peint. ext." + ReqGroupShippingBill.fNoPeintureExtTout + " " + sansespace(ReqGroupShippingBill.fdescpeintureExtTout) sinon DescriptionPeinture = "Ext. Paint" + ReqGroupShippingBill.fNoPeintureExtTout + " " + sansespace(ReqGroupShippingBill.fdescpeintureExtTout)
         fin
         
         calculligne++
        type : 327692
      -
        code : |1+
         SI PAS facturereimpression ALORS Remplir_tableau_gl(gclconfig.m_sGlPeinturecarrelage,arrondi(TotalCarr1,2))
         totaldepage+=totalcarr1
         si pas sansespace(ReqGroupShippingBill.FnopeintureInterieure) = "" alors
         	iImprimeBloc(ITERATION8)
         FIN
         
         
        type : 327693
      -
        type : 327697
        enabled : false
