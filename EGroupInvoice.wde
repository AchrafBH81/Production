         	iImprimeBloc(iteration7)
         	totalfacture+=ReqGroupShippingBill.fsurchargepeinture
         	remplir_tableau(gclconfig.m_sNoGlPeinture,arrondi(ReqGroupShippingBill.fsurchargepeinture,2))
         //	AlimenteHistoriqueProduit(sansespace(client.numero),ReqGroupShippingBill.BDateFacture,5,ReqGroupShippingBill.fdnumprod...
         //	,"","","",arrondi(ReqGroupShippingBill.fsurchargepeinture,2),0,DescPeinture,0)
         FIN
         
         TotalSurchargeTaux = Arrondi(totalfacture+( SurchargeSurEnergie ? totalsurcharge SINON 0 ),2) * ReqGroupShippingBill.surchargeTauxPourc / 100
         TotaldeSurchargeTaux = totalsurchargetaux
         totaldesurcharge = totalsurcharge
         totaldefacture = totalfacture + totalsurcharge + TotalSurchargeTaux
         totaltvh = arrondi((totalfacture + totalsurcharge+ TotalSurchargeTaux) * ReqGroupShippingBill.bTauxTaxe1 / 100,2)
         totaltvq = arrondi((totalfacture + totalsurcharge+ TotalSurchargeTaux+(ReqGroupShippingBill.bCalculTaux2sur1 ? totaltvh sinon 0)) * ReqGroupShippingBill.bTauxTaxe2 / 100,2)
         grandtotal = totaldefacture + totaltvh + TotalTVQ
         si pas facturereimpression alors
         	fac_detail[1,2] = numeriqueverschaine(arrondi(grandtotal,2) * -1)
         	Remplir_tableau(gclConfig.m_ssurchargegl,Arrondi(totalsurcharge,2),Faux,vrai)
         	Remplir_tableau(gclConfig.m_sSUrchargeTauxGl,Arrondi(TotalSurchargeTaux,2),faux,vrai)
         	
         	si sansespace(taxegl1) <> "" alors Remplir_tableau(taxegl1,Arrondi(TotalTVH,2),Vrai,vrai)
         	SI SansEspace(taxeGL2) <> "" ALORS 
         		Remplir_tableau(taxegl2,Arrondi(TotalTVQ,2),Vrai,vrai)
         	sinon
         		Remplir_tableau(gclConfig.m_sgltvq,Arrondi(TotalTVQ,2),Vrai,Vrai)
         		
         	FIN
         //	Remplir_tableau(config.gltps,Arrondi(TotalTVH,2),Vrai)
         //	Remplir_tableau(config.gltvq,Arrondi(TotalTVQ,2),Vrai)
         //	AlimenteHistorique(sansespace(client.numero),ReqGroupShippingBill.BDateFacture,totalfacture+totalsurcharge,ReqGroupShippingBill.cvendeur)
         fin
         
         
         
         
        type : 327692
      -
        type : 327697
        enabled : false
