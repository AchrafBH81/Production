  procedures :
   -
     name : ajoutedetail
     procedure_id : 5052261977559697857
     type_code : 14
     code : |1+
      Procédure ajoutedetail(numerofacture)
       hlitrecherche(hfdetail,HFCLEUNIK,numerofacture)
       
      
      //hlitrecherche("hfdetail","fdcle",numerofacture)
      
      //Code WinDev 5.5 remplacé par la migration :
      //tantque pas h.endehors et hfacture.fanofacture = hfdetail.fdnofact
      tantque pas HEnDehors() et hfdetail.HFCLEUNIK = numerofacture
         	memajoute("zonefacture",h.numenr,h.numenr)
      
      	hlitsuivant(hfdetail,HFCLEUNIK)
      	
      FIN
      
