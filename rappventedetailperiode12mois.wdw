  p_codes :
   -
     code : |1+
      
      
      ladate est une date = datesys()
      // Pour compatibilité 5.5
      MoiMême..Visible=Vrai
      moimeme..Hauteur = 300
      
      
      moimeme..y = (Sysyres()-moimeme..hauteur) /2 
