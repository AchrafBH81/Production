      -
        code : |1+
         //RequeteBonLivraisonFacture.pNoCommande = RequeteDetailUnJourV1.fdnocomm
         //QteDejaFacture est un reel = 0 
         //si hexecuterequete(RequeteBonLivraisonFacture) alors
         //	qtedejafacture = RequeteBonLivraisonFacture.la_somme_fdqteafacturer
         //FIN
         CtotalThermos = totalthermos
         CtotalCarrelage = totalcarrelage
         
         totalthermos=0
         totalcarrelage = 0
         totalfacture = 0
         totaldepeinture = 0
         totalsurcharge = 0
         totalpoids = 0
         
         SI HLitRecherche(Client,numero,RequeteDetailUnJourV1.TNoclient) _et_ client.cRapportLivraisonDetaille ALORS
             RequeteDetailUnJourUnClient.pNoClient = RequeteDetailUnJourV1.TNoclient 
             si HExécuteRequête(RequeteDetailUnJourUnClient) _et_ hnbenr(RequeteDetailUnJourUnClient) > 0 alors
             	iimprimeetat(eFabricationAFaireUnClient,lLivraison)
             FIN
             moimeme..visible = Faux
         sinon 
         	moimeme..visible = vrai    
         FIn
