 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1+
      PROCEDURE MaFenêtre()
      
      CompileOrders est un structure
      	sUser est une chaine
      	xtotalEdi est un monetaire
      	nNumberOrdersEDI est un entier
      	nNumberOfLinesEDI est un entier
      	nNumberOfThermosEDI est un entier
      	xtotal est un monetaire
      	nNumberOrders est un entier
      	nNumberOfLines est un entier
      	nNumberOfThermos est un entier
      	xtotalQuotation est un monetaire
      	nNumberOrdersQuotation est un entier
      	nNumberOfLinesQuotation est un entier
      	nNumberOfThermosQuotation est un entier
      	
      	
      	
      	
      fin
      reqsql est une source de donnees
      orderTracking est un tableau associatif de CompileOrders
      CurrentOrderTracking est un CompileOrders
      gnIntervalle est un entier 
      
      gnNbOrders est un entier
      gnNbOrderLines est un entier
      gnNbOrderThermos est un entier
      gnNbEDIOrders est un entier
      gnNbEDIOrderLines est un entier
      gnNbEDIOrderThermos est un entier
      gnNbQuotations est un entier
      gnNbQuotationLines est un entier
      gnNbQuotationThermos est un entier
      gnNbTotalOrders est un entier
      gnNbTotalLines est un entier
      gnNbTotalThermos est un entier
      
      si pas fFichierExiste("Config.ini") alors
      	fcree("config.ini")
      FIN
      NbMinutes est une chaine = INILit("Intervalle","Minutes","5","config.ini") 
      gnintervalle = val(inilit("Intervalle","Minutes","5","config.ini")) * 60 * 100
      BTN_SansNom1..Libellé = remplace(BTN_SansNom1..Libellé,"5 minutes",nbminutes + " Minutes" )
      
      
      
      
   -
     code : |1+
      
      ExécuteTraitement(BtnRefresh,trtclic)
      timersys("Refreshorder",gnintervalle,1)
      
     type : 34
   -
     code : |1+
      
      
     type : 234
   -
     code : |1+
      
      
     type : 165
