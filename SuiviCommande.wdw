  -
    name : BtnRefresh
    identifier : 0x22685cf75254c21c
    internal_properties : 
    properties :
     x : 682
     y : 6
     width : 80
     height : 80
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         FinTimerSys((1))
         RefreshOrder()
         TimerSys("Refreshorder",gnIntervalle,1)
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_SansNom1
    identifier : 0x226869525ad2047a
    internal_properties : 
    properties :
     x : 250
     y : 6
     width : 279
     height : 65
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         FinTimerSys((1))
         nNewgap est un entier
         sOldGap est une chaine = INILit("Intervalle","Minutes","5","config.ini") 
         
         saisie("Inscrivez l'intervalle de rafraichissement en minutes",nNewgap)
         
         si nNewgap <= 0 alors
         	Erreur("L'intervalle doit être supérieur à 0")
         TimerSys("Refreshorder",gnIntervalle,1)
         	renvoyer faux
         FIN
         gnIntervalle = nNewgap * 60 * 100
         INIecrit("Intervalle","Minutes",numeriqueverschaine(nNewgap),"config.ini")
         
         BTN_SansNom1..Libellé = Remplace(BTN_SansNom1..Libellé,sOldGap +" Minutes",numeriqueverschaine(nNewgap) + " Minutes" )
         
         
         TimerSys("Refreshorder",gnIntervalle,1)
         
         
         
         
        type : 18
      -
        type : 161
        enabled : false
 menu :
  name : _Menu
  identifier : 0x292573e513b5f221
  internal_properties : 
  options : []
 popup_menus :
  -
    name : MenuDatePrédéfinie
    identifier : 0x22685cf75263c21c
    internal_properties : 
    options :
     -
       name : MenuAujourdhui
       identifier : 0x22685cf75264c21c
       internal_properties : 
       code_elements :
        type_code : 26
        p_codes :
         -
           code : |1-
            sSuperChamp est une chaîne
            dDate est une date = DateSys()
            
            // Récupérer le nom du super champ
            sSuperChamp = ExtraitChaîne(ChampContextuel(), 1, ".")
            
            {sSuperChamp+".SAI_DateDébut",indChamp} = dDate
            {sSuperChamp+".LIB_JOUR_DEB",indChamp} = EntierVersJourEnLettre(dDate)
            
            {sSuperChamp+".SAI_DateFin",indChamp} = dDate
            {sSuperChamp+".LIB_JOUR_FIN",indChamp} = EntierVersJourEnLettre(dDate)
            
            {sSuperChamp,indChamp}..valeur = dDate+TAB+dDate
           type : 32
     -
       name : MenuHier
       identifier : 0x22685cf75265c21c
       internal_properties : 
       code_elements :
        type_code : 26
        p_codes :
         -
           code : |1-
            dDate 	est une date = DateSys()
            sSuperChamp est une chaîne
            
            // Récupérer le nom du super champ
            sSuperChamp = ExtraitChaîne(ChampContextuel(), 1, ".")
            
            // Récupérer le jour précédent
            dDate..jour--
            
            {sSuperChamp+".SAI_DateDébut",indChamp} = dDate
            {sSuperChamp+".LIB_JOUR_DEB",indChamp} = EntierVersJourEnLettre(dDate)
            
            {sSuperChamp+".SAI_DateFin",indChamp} = dDate
            {sSuperChamp+".LIB_JOUR_FIN",indChamp} = EntierVersJourEnLettre(dDate)
            
            {sSuperChamp,indChamp}..valeur = dDate+TAB+dDate
           type : 32
     -
       name : MenuSemaineCourante
       identifier : 0x22685cf75266c21c
       internal_properties : 
       code_elements :
        type_code : 26
        p_codes :
         -
           code : |1-
            dDateDebut 	est une date = DateSys()
            dDateFin	est une date = DateSys()
            nNumJour 	est un entier
            sSuperChamp est une chaîne
            
            // Récupérer le nom du super champ
            sSuperChamp = ExtraitChaîne(ChampContextuel(), 1, ".")
            
            // Récupérer le numéro du jour de la semaine
            nNumJour = EntierVersJour(dDateDebut)
            
            // Semaine courante
            dDateDebut..jour -= (nNumJour-1)
            
            {sSuperChamp+".SAI_DateDébut",indChamp} = dDateDebut
            {sSuperChamp+".LIB_JOUR_DEB",indChamp} = EntierVersJourEnLettre(dDateDebut)
            
            dDateFin = dDateDebut
            dDateFin..Jour += 6
            
            {sSuperChamp+".SAI_DateFin",indChamp} = dDateFin
            {sSuperChamp+".LIB_JOUR_FIN",indChamp} = EntierVersJourEnLettre(dDateFin)
            
            {sSuperChamp,indChamp}..valeur = dDateDebut+TAB+dDateFin
           type : 32
     -
       name : MenuSemainePrécédente
       identifier : 0x22685cf75267c21c
       internal_properties : 
       code_elements :
        type_code : 26
        p_codes :
         -
           code : |1-
            dDateDebut 	est une date = DateSys()
            dDateFin	est une date = DateSys()
            sSuperChamp est une chaîne
            
            // Récupérer le nom du super champ
            sSuperChamp = ExtraitChaîne(ChampContextuel(), 1, ".")
            
            // Positionner le jour sur la semaine précédente
            dDateDebut..jour -= 6
            
            {sSuperChamp+".SAI_DateDébut",indChamp} = dDateDebut
            {sSuperChamp+".LIB_JOUR_DEB",indChamp} = EntierVersJourEnLettre(dDateDebut)
            
            {sSuperChamp+".SAI_DateFin",indChamp} = dDateFin
            {sSuperChamp+".LIB_JOUR_FIN",indChamp} = EntierVersJourEnLettre(dDateFin)
            
            {sSuperChamp,indChamp}..valeur = dDateDebut+TAB+dDateFin
           type : 32
     -
       name : Semaine_précédente
       identifier : 0x22685cf75268c21c
       internal_properties : 
       code_elements :
        type_code : 26
        p_codes :
         -
           code : |1-
            dDateDebut 	est une date = DateSys()
            dDateFin	est une date = DateSys()
            nNumJour 	est un entier
            sSuperChamp est une chaîne
            
            // Récupérer le nom du super champ
            sSuperChamp = ExtraitChaîne(ChampContextuel(), 1, ".")
            
            // Semaine précédente
            dDateDebut..jour -= 7
            nNumJour = EntierVersJour(dDateDebut)
            dDateDebut..jour -= (nNumJour-1)
            dDateFin = dDateDebut
            dDateFin += 6
            
            {sSuperChamp+".SAI_DateDébut",indChamp} = dDateDebut
            {sSuperChamp+".LIB_JOUR_DEB",indChamp} = EntierVersJourEnLettre(dDateDebut)
            
            {sSuperChamp+".SAI_DateFin",indChamp} = dDateFin
            {sSuperChamp+".LIB_JOUR_FIN",indChamp} = EntierVersJourEnLettre(dDateFin)
            
            {sSuperChamp,indChamp}..valeur = dDateDebut+TAB+dDateFin
           type : 32
     -
       name : MenuMoisCourant
       identifier : 0x22685cf75269c21c
       internal_properties : 
       code_elements :
        type_code : 26
        p_codes :
         -
           code : |1-
            dDateDebut 	est une date = DateSys()
            dDateFin	est une date = DateSys()
            sSuperChamp est une chaîne
            
            // Récupérer le nom du super champ
            sSuperChamp = ExtraitChaîne(ChampContextuel(), 1, ".")
            
            // Mois courant
            dDateDebut..jour = 1
            
            {sSuperChamp+".SAI_DateDébut",indChamp} = dDateDebut
            {sSuperChamp+".LIB_JOUR_DEB",indChamp} = EntierVersJourEnLettre(dDateDebut)
            
            {sSuperChamp+".SAI_DateFin",indChamp} = dDateFin
            {sSuperChamp+".LIB_JOUR_FIN",indChamp} = EntierVersJourEnLettre(dDateFin)
            
            {sSuperChamp,indChamp}..valeur = dDateDebut+TAB+dDateFin
           type : 32
     -
       name : MenuMoisFlottant
       identifier : 0x22685cf7526ac21c
       internal_properties : 
       code_elements :
        type_code : 26
        p_codes :
         -
           code : |1-
            dDateDebut 	est une date = DateSys()
            dDateFin	est une date = DateSys()
            sSuperChamp est une chaîne
            
            // Récupérer le nom du super champ
            sSuperChamp = ExtraitChaîne(ChampContextuel(), 1, ".")
            
            // Mois flottant
            dDateDebut..mois--
            dDateDebut..jour++
            
            {sSuperChamp+".SAI_DateDébut",indChamp} = dDateDebut
            {sSuperChamp+".LIB_JOUR_DEB",indChamp} = EntierVersJourEnLettre(dDateDebut)
            
            {sSuperChamp+".SAI_DateFin",indChamp} = dDateFin
            {sSuperChamp+".LIB_JOUR_FIN",indChamp} = EntierVersJourEnLettre(dDateFin)
            
            {sSuperChamp,indChamp}..valeur = dDateDebut+TAB+dDateFin
