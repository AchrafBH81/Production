 popup_menus : []
 message_bar :
  internal_properties : CQAAAAkAAAC0/JJxwcaURS4PIwlNM1d5JrKOx2J+n9spAoje/noRdFfgU7DHb2F7OGaMvhGCOUy0n/GWhAXxPoFO2VY0N4ke8jy3i1sWHUUfTvXpzbeCqUj9VwUS6AidpMfo8w==
 actionbar : {}
 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1-
      // Ouverture de la fenêtre de type Fiche
      // Entrée:	ModeOuverture=mode d'ouverture de la fenêtre :
      //				- "Parcours"	Visualisation de tous les enregistrements
      //								grâce aux boutons de parcours
      //				- "Modif"		Modification de l'enregistrement en cours
      //				- "Création"	Création d'un nouvel enregistrement
      //				- "linkedBrowse"	Parcours du fichier en liaison avec la fenêtre mère
      //							(avec suppression et création)
       
      PROCEDURE FicheRAD(ModeOuverture="Parcours")
      
      GLOBAL
      	gNumEnr est un entier = 0				// enregistrement en cours dans le fichier
      	gModeFenetre est une chaine				// mode de la fenêtre
      	gbFenetreModifiee est un booléen = Faux		// Est-ce qu'un enregistrement a été modifié ? 
      	gsModeAppel est une chaine = ModeOuverture	// Mode d'appel de la fenêtre
          TableauFournisseur est un tableau dynamique
          reqSql est une source de Données
          TxtSql est un chaine = "select dateemail,lsujet,ldestinataire,ltypedocument,idarchiveemail,iTypeEnvoi from ArchiveEmail where archiveemail.noClient = '%1' and ArchiveEmail.lTypeDocument > 5 order by ArchiveEmail.dateEmail desc"
      
      // Gestion des erreurs d'accès à la base de données
      // Les messages d'erreurs renvoyés par la base sont affichés
      // Vous pouvez traiter ici les compte-rendu d'erreurs de votre base
      QUAND Exception
      	Erreur("Une erreur est survenue dans la fenêtre",ExceptionInfo(errMessage))
      	// On réactive les exceptions
      	ExceptionActive()
      	// On reprend le traitement
      	RepriseSaisie()
      FIN
      lajout est un booleen = faux
      lmodif est un booleen = faux
      listeajoute(lTypeDocument,glien(6)+"Commande d'achat")	
   -
     code : |1+
      hlitpremier(Fournisseur,Fnom)
      Table_Fournisseur = 1
     type : 34
   -
     type : 180
     enabled : false
   -
     type : 230
     enabled : false
   -
     code : |1-
      
     type : 2
   -
     type : 11
   -
     type : 12
   -
     code : |1+
      
      // Si un champ a été modifié, on active le groupe de validation des modifications
      SI ChampExiste("GP_APPLIQUER") ALORS GP_APPLIQUER..Etat = Actif
     type : 17
   -
     type : 13
