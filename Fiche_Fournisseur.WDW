          code_elements :
           type_code : 6
           p_codes :
            -
              code : |1+
               selon moimeme
               	// Manuel
               	CAS "1"
               		GrpFTP..etat = grise
               		GrpCourriel..etat = grise
               		grpftp = ""
               		grpcourriel = ""
               	// FTP
               	CAS "2"
               		GrpFTP..Etat = actif
               		GrpCourriel..Etat = grise
               		GrpCourriel = ""
               	// Courriel
               	CAS "3"
               		GrpFTP..Etat = Grisé
               		GrpCourriel..Etat = Actif
               		GrpFTP = ""
               		
               FIN
              type : 17
