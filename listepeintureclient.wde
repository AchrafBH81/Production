 controls : []
 code_elements :
  type_code : 13
  p_codes :
   -
     code : |1+
      Procedure _LISTE_BASE_PIED_CLIENT(_pParam1="", _pParam2="", _pParam3="", _pParam4="")
      
      GLOBAL
      numeroclient est une chaine = _pparam1
      compteur est un entier
      si pas listeprix.NouvelleListe alors
      	GrpDateRempl..visible = faux
      	Lvigueur..visible = faux
      	ldate..visible=vrai
      sinon
      	GrpDateRempl..visible = vrai
      
      FIN
      si pas gImprimeCondPMT alors
      	GrpCondPmt..visible=faux
      sinon
      	Facdescription..Largeur = Facdescription..LargeurInitiale+Lnumero..LargeurInitiale
      	Facdescription..x = Lnumero..x
      	Lnumero..visible = faux
      	rubriq3..Largeur = RUBRIQ3..LargeurInitiale+RUBRIQUE1..LargeurInitiale
      	rubriq3..x = RUBRIQue1..x
      	RUBRIQue1..visible = faux
      
      FIN
      listeprix.ListeImprimee = Faux
      assigneLibelle()
     type : 327680
   -
     code : |1-
      
     type : 327695
   -
     code : |1+
      // Vérification de la condition
      SI HLitRecherche(invent,INUM,RequeteClientProduit.Idproruit) ET PAS invent.iactif ALORS RENVOYER Faux 
      SI pas (RequeteClientProduit.ITypeProduit= 5)ALORS RENVOYER FAUX
      SI pas RequeteClientProduit.IlisteDePrix ALORS RENVOYER FAUX
      //si (position(_pparam2,complete(invent.icategorie,3)) = 0) alors renvoyer faux
      
      RENVOYER VRAI		// Enregistrement accepté
      
      
     type : 327696
   -
     code : |1+
      lNombreenrImprime = moimeme..NbEnrImprimé
      
     type : 327682
  procedures :
   -
     name : assigneLibelle
     procedure_id : 5275258153372442842
     type_code : 14
     code : |1+
      Procédure assigneLibelle()
      i est un entier
      
      lTableauLibelle est un tableau de  11 chaines
      lTableauLibelle[1]  = "lentete,lentete"
      lTableauLibelle[2]  = "lvigueur,lvigueur"
      lTableauLibelle[3]  = "lremplace,lremplace"
      lTableauLibelle[4]  = "lpeinture,lpeinture"
      lTableauLibelle[5]  = "lpeinturesuite,lpeinturesuite"
      lTableauLibelle[6]  = "lnumero,lnumero"
      lTableauLibelle[7]  = "facdescription,facdescription"
      lTableauLibelle[8]  = "langlais,Langlais"
      lTableauLibelle[9]  = "lmetrique,lmetrique"
      lTableauLibelle[10]  = "facdate,ldate"
      lTableauLibelle[11]  = "lcondpaiement,LCondpaiement"
      
      selon client.CLangue
      	cas 1
      		pour i = 1 a 11
      			si hlitrecherche(Traduction,TRecherche,extraitchaine(lTableauLibelle[i],1,",")) alors
      				{"listepeintureclient."+ExtraitChaîne(lTableauLibelle[i],2,",")} = traduction.dFrancais
      			fin
      		FIN
      
      
      	cas 2
      		pour i = 1 a 11		
      			si hlitrecherche(Traduction,TRecherche,extraitchaine(lTableauLibelle[i],1,",")) alors
      				{"listepeintureclient."+ExtraitChaîne(lTableauLibelle[i],2,",")} = traduction.danglais
      			fin
      		FIN
      fin
      
      
      
      
      
     type : 458752
  procedure_templates : []
