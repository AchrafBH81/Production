    properties :
     width : 269.4
     height : 61.529
    code_elements :
     type_code : 30
     p_codes :
      -
        code : |1+
         hlitrecherche(client,numero,requeteBletat.bclient)
         selon client.CImpressionAngMet
         	cas 1
         	  lmultiplicateur=1
         	cas 2
         		lmultiplicateur=config.conversionam
         
         FIN
         assigneLibelle()
         si pas requetebletat.fpeinture_hf = 1 alors
             grpPiedPeinture..visible = faux
             GrpMetrePeinture..visible = faux
         	selon client.CImpressionAngMet
         
         		cas 0,1
         			grppied..visible= vrai
         			grpmetre..visible = faux
         		cas 2 
         			grppied..visible = faux
         			grpmetre..visible = vrai
         	FIN
         sinon
         	grpPied..visible = faux
         	GrpMetre..visible = faux
         	facfini..Libellé=""
         	facspacer..Libellé=""
         	faccarrelage..Libellé=""
         	factotalcarr..Libellé=""
         
         	selon client.CImpressionAngMet
         
         		cas 0,1
         			grppiedpeinture..visible= vrai
         			grpmetrepeinture..visible = faux
         		cas 2 
         			grppiedpeinture..visible = faux
         			grpmetrepeinture..visible = vrai
         	FIN
         
         fin
         SI RequeteBlEtat.lNom <> "" ALORS
         	NomClient1 = RequeteBlEtat.lNom
         	AdresseClient1 = RequeteBlEtat.lRue
         	VilleClient1 = RequeteBlEtat.lVille
         	CodePostalClient1 = RequeteBlEtat.lCodePostal	
         SINON
         	NomClient1 = "  M Ê M E / S A M E  "
         	AdresseClient1 = ""
         	VilleClient1 = ""
         	CodePostalClient1 = ""
         	
         FIN
         
         //si requetebletat.idlivraison <> 0 alors
         //	si hlitrecherche(ClientLivraison,IDClientLivraison,requetebletat.idlivraison) alors
         //		nomclient1 = ClientLivraison.lNom
         //		adresseclient1 = ClientLivraison.lRue
         //		VilleClient1 = ClientLivraison.lVille+","+ClientLivraison.lprovince
         //		CodePostalClient1 = ClientLivraison.lCodePostal	
         //	FIN
         //sinon
         //	nomclient1 = "  M Ê M E / S A M E  "
         //	adresseclient1 = ""
         //	VilleClient1 = ""
         //	CodePostalClient1 = ""	
         //FIN
         
         si sansespace(Requetebletat.fnopeinture) = "" alors
         	grppeinture..visible = faux
         sinon
         	CCouleurPeinture = Requetebletat.fnopeinture
         	Cdescpeinture = Requetebletat.fdescpeinture
         	si Requetebletat.ftypepeinture1= 1 alors
         		hlitrecherche(Traduction,TRecherche,"peintureexterieure")
         		si client.CLangue=1 alors peinturetlt = Traduction.dfrancais sinon peinturetlt = Traduction.danglais
         	FIN
         FIN
         
         si SansEspace(Requetebletat.fnopeinture1) <> "" alors
         	CCouleurPeinture1 = Requetebletat.fnopeinture1
         	Cdescpeinture1 = Requetebletat.fdescpeinture1
         	hlitrecherche(Traduction,TRecherche,"peintureexterieure") 
         	si client.CLangue=1 alors peinturetlt = Traduction.dfrancais sinon peinturetlt = Traduction.danglais
         	GrpPeintureInt..visible = vrai
         sinon
         	GrpPeintureInt..visible = faux    
         FIN
         
         faxclient = client.cfax
         telephoneclient=  (client.cInterurbain ? "(1) " sinon "") +client.ctelephone
         
         _tableautaxe est un tableau dynamique= trouvetauxtaxe(Client.numero,DateValide(RequeteBLetat.BDateFacture) ? RequeteBlEtat.BDateFacture SINON DateSys(),Client.CLangue)
         
         SI Dimension(_tableautaxe) >= 4 ALORS
         	taxedesc1 = _tableautaxe[1,1]
         	TaxeGL1 = _tableautaxe[1,3]
         FIN
         SI Dimension(_tableautaxe) = 8 ALORS
         	taxedesc2 = _tableautaxe[2,1]
         	TaxeGL2 = _tableautaxe[2,3]
         	
         
         FIN
        type : 327692
      -
        type : 327697
        enabled : false
