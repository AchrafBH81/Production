      -
        code : |1+
         qtecarr9 = requetebletat.fdqteafacturer
         qtecarr28 = requetebletat.fdcarreauv
         qtecarr64 = requetebletat.fdcarreauh
         qtecarr65 = requetebletat.Ftotalcarreaupeinture
         PrixUnitCarr1 = requetebletat.fPrixCarreauPeinture
         TotalCarr1 = qtecarr65 * PrixUnitCarr1 * qtecarr9
         selon requetebletat.fTypePeinture
         		cas 2
         			si client.CLangue=1 alors DescriptionPeinture = "Peint.TLT" + requetebletat.fNoPeintureExtTout + " " + sansespace(requetebletat.fdescpeintureExtTout) sinon DescriptionPeinture = "TLT Paint" + requetebletat.fNoPeintureExtTout + " " + sansespace(requetebletat.fdescpeintureExtTout)
         		cas 1
         			si client.CLangue=1 alors DescriptionPeinture = "Peint. ext." + requetebletat.fNoPeintureExtTout + " " + sansespace(requetebletat.fdescpeintureExtTout) sinon DescriptionPeinture = "Ext. Paint" + requetebletat.fNoPeintureExtTout + " " + sansespace(requetebletat.fdescpeintureExtTout)
         fin
         
         calculligne++
        type : 327692
      -
        code : |1+
         Remplir_tableau_gl(config.GlPeinturecarrelage,arrondi(TotalCarr1,2))
         totaldepage+=totalcarr1
         si pas sansespace(requetebletat.FnopeintureInterieure) = "" alors
         	iImprimeBloc(ITERATION8)
         FIN
         
         
        type : 327693
      -
