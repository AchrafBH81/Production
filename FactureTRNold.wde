  p_codes :
   -
     code : |1+
      procedure FactureTRNold(facturereimpression = faux,numerobonl=0)
      
      
      tableaucarrelage est un tableau dynamique
      tableaucarrelage = allouer un tableau de 0 par 5 chaine
      dimensiontableaucarrelage est un entier = 0
      calculligne est un entier = 0
      AncienNumCommande est un entier
      AncienNumcarrelage est une chaine = ""
      ldebut est un entier = vrai
      lTypeLigne est une chaine = "" // Verre, verre a l'unité, Unité , carrelage , Peinture
      totalpage est un reel = 0
      totalpage1 est un reel = 0
      totalfacture est un reel = 0
      totalsurcharge est un reel = 0
      totalcap est un reel = 0
      libérer fac_detail
      fac_detail = allouer un tableau de 1 par 4 chaine
      fac_detail[1,1] = ""
      fac_detail[1,2] = "0.00"
      lmultiplicateur est un reel
      taxedesc1 est une chaine
      taxeGL1 est une chaine
      taxedesc2 est une chaine
      taxeGL2 est une chaine
      
      
      
      
      hlit(config,1)
      
     type : 327680
   -
     code : |1-
      
     type : 327695
  procedures :
   -
     name : Rupturefdcomm
     procedure_id : 1749113581527686704
     type_code : 14
     code : |1+
      Procédure Rupturefdcomm()
      
      iimprime("salut")
      
     type : 458752
   -
     name : Remplir_tableau
     procedure_id : 1749113581527752240
     type_code : 14
     code : |1+
      Procédure Remplir_tableau(codegl,montantgl,taxegl=faux)
      codegltrouve est un booleen = faux
      j est un entier = (dimension(fac_detail)/4)
      k est un entier
      si facturereimpression alors
      	renvoyer vrai
      FIN
      si pas j = 1 alors
      pour k = 2 a j
      	si fac_detail[k,1] = codegl alors
      		codegltrouve = vrai
      		fac_detail[k,2]=numeriqueverschaine(val(fac_detail[k,2])+montantgl)
      	    sortir
      	FIN
      FIN
      fin
      
      si pas codegltrouve alors
          
      	dimension(fac_detail,j+1,4)
      	fac_detail[j+1,1] = codegl
      	fac_detail[j+1,2] = numeriqueverschaine(montantgl)
          si taxegl alors
          	fac_detail[j+1,3] = "1"
          fin	
      FIN
      
      
      
     type : 458752
   -
     name : assigneLibelle
     procedure_id : 1749113581527817776
     type_code : 14
     code : |1-
      Procédure assigneLibelle()
      i est un entier
      
      lTableauLibelle est un tableau de 45 chaines
      lTableauLibelle[1]  = "facentete,facentete"
      lTableauLibelle[2]  = "facpage,facpage"
      lTableauLibelle[3]  = "facpagede,facpagede"
      lTableauLibelle[4]  = "facnumero,facnumero"
      lTableauLibelle[5]  = "facdate,facdate"
      lTableauLibelle[6]  = "facjobdetail,facjobdetail"
      lTableauLibelle[7]  = "facquantite,facquantite"
      lTableauLibelle[8]  = "faclargeur,faclargeur"
      lTableauLibelle[9] = "fachauteur,fachauteur"
      lTableauLibelle[10] = "faclargeurpouce,faclargeurpouce"
      lTableauLibelle[11] = "fachauteurpouce,fachauteurpouce"
      lTableauLibelle[12] = "facdescription,facdescription"
      lTableauLibelle[13] = "facfini,facfini"
      lTableauLibelle[14] = "facspacer,facspacer"
      lTableauLibelle[15] = "faccarrelage,faccarrelage"
      lTableauLibelle[16] = "factotalcarr,factotalcarr"
      lTableauLibelle[17] = "facpiedcarre,facpiedcarre"
      lTableauLibelle[18] = "facpiedcarrefacture,facpiedcarrefacture"
      lTableauLibelle[19] = "facprixuni,facprixuni"
      lTableauLibelle[20] = "facsurcharge,facsurcharge"
      lTableauLibelle[21] = "facsoustotal,facsoustotal"
      lTableauLibelle[22] = "factotal,factotal"
      lTableauLibelle[23] = "factotalpage,factotalpage"
      lTableauLibelle[24] = "facfax,facrecupar"
      lTableauLibelle[25] = "facmetrecarre,facmetrecarre"
      lTableauLibelle[26] = "facmetrecarrefacture,facmetrecarrefacture"
      lTableauLibelle[27] = "facprixunimetre,facprixunimetre"
      lTableauLibelle[28] = "facnotvq,facnotvq"
      lTableauLibelle[29] = "facnotps,facnotps"
      lTableauLibelle[30] = "factvq,factvq"
      lTableauLibelle[31] = "factps,factps"
      lTableauLibelle[32] = "facpied,facpied"
      lTableauLibelle[33] = "facpiedfacture,facpiedfacture"
      lTableauLibelle[34] = "facprixupied,facprixupied"
      lTableauLibelle[35] = "facmetre,facmetre"
      lTableauLibelle[36] = "facmetrefacture,facmetrefacture"
      lTableauLibelle[37] = "facprixumetrelin,facprixumetrelin"
      lTableauLibelle[38] = "vendua,vendua"
      lTableauLibelle[39] = "livrea,Livrea"
      lTableauLibelle[40] = "lcondpaiement,conditionpaiement"
      lTableauLibelle[41] = "notrereference,notrereference"
      lTableauLibelle[42] = "peinturetlt,peinturetlt"
      lTableauLibelle[43] = "peintureinterieure,peintureinterieure"
      lTableauLibelle[44] = "votrecommande,votrecommande"
      lTableauLibelle[45] = "bonlivraison,Bonlivraison"
      
      selon client.CLangue
      	cas 1
      		pour i = 1 a 45
      			si hlitrecherche(Traduction,TRecherche,extraitchaine(lTableauLibelle[i],1,",")) alors
      				{"facturetrn."+ExtraitChaîne(lTableauLibelle[i],2,",")} = traduction.dFrancais
      			fin
      		FIN
      	cas 2
      		pour i = 1 a 45
      			si hlitrecherche(Traduction,TRecherche,extraitchaine(lTableauLibelle[i],1,",")) alors
      				{"facturetrn."+ExtraitChaîne(lTableauLibelle[i],2,",")} = traduction.danglais
      			fin
      		FIN
      fin
     type : 458752
   -
     name : AlimenteHistorique
     procedure_id : 1749113581527883312
     type_code : 14
     code : |1+
      Procédure AlimenteHistorique(lclient,ldate,lmontant,lvendeur)
      
      si  facturereimpression alors
      	renvoyer vrai
      FIN
      lannee est un entier= ldate..Année
      lmois est un entier = ldate..mois
      
      
      si hlitrecherche(HistoAnneeMois,lanneeMois,HConstruitValClé(HistoAnneeMois,lanneemois,lclient,lannee,lmois)) alors
      	HistoAnneeMois.lvente+= lmontant
      	hmodifie(HistoAnneeMois,hNumEnrEnCours)
      sinon
      	HistoAnneeMois.hclient = sansespace(lclient)
      	HistoAnneeMois.lAnnee = lannee
      	HistoAnneeMois.lmois = lmois
      	HistoAnneeMois.lvente = lmontant
      	HistoAnneeMois.cvendeur = lvendeur
      	hajoute(HistoAnneeMois)
      FIN
      
      renvoyer vrai
      
      
      
      
     type : 458752
   -
     name : AlimenteHistoriqueProduit
     procedure_id : 1749113581527948848
     type_code : 14
     code : |1+
      Procédure AlimenteHistoriqueProduit(lclient,ldate,ltype,lnumprod,lcomp1,lcomp2,lcomp3,lmontant,lsurcharge,ldesc,lqte,ltotalpeinture=0,lpied=0 )
      
      
      si  facturereimpression alors
      	renvoyer vrai
      FIN
      
      
      i est un entier
      lannee est un entier = numeriqueverschaine(ldate..annee)
      lmois est une chaine = remplir_zero(sansespace(numeriqueverschaine(ldate..mois)),2)
      lperiode est une chaine= lannee+lmois
      
      
      
      
      
      selon ltype
      
      	cas 1
      		si hlitrecherche(HistoAnneeMoisProduit,hClientlComp1lcomp2lcomp3lAnneelmois,...
      			HConstruitValClé(HistoAnneeMoisProduit,hClientlComp1lcomp2lcomp3lAnneelmois,lclient,lnumprod,lcomp1,...
      			lcomp2,lcomp3,lannee,lmois)) alors
      			HistoAnneeMoisProduit.lqte += lqte
      			HistoAnneeMoisProduit.lvente +=  arrondi(lmontant,2)
      			HistoAnneeMoisProduit.lsurcharge +=  arrondi(lsurcharge,2)
      			HistoAnneeMoisProduit.lpied +=lpied
      			hmodifie(HistoAnneeMoisProduit,hNumEnrEnCours)
      		sinon
      			HistoAnneeMoisProduit.lperiode = lperiode
      			HistoAnneeMoisProduit.hClient = lclient
      			HistoAnneeMoisProduit.lAnnee = lannee
      			HistoAnneeMoisProduit.lmois = lmois
      			HistoAnneeMoisProduit.ldescription = ldesc
      			HistoAnneeMoisProduit.lProduit = lnumprod
      			HistoAnneeMoisProduit.lComp1 = lcomp1
      			HistoAnneeMoisProduit.lComp2 = lcomp2
      			HistoAnneeMoisProduit.lComp3 = lcomp3
      			HistoAnneeMoisProduit.lsurcharge =  arrondi(lsurcharge,2)
      			HistoAnneeMoisProduit.lpied =lpied
      			HistoAnneeMoisProduit.lqte = lqte
      			HistoAnneeMoisProduit.lType = "T"
      			HistoAnneeMoisProduit.lvente =  arrondi(lmontant,2)
      			HistoAnneeMoisProduit.peinturecarrelage = 0
      			hajoute(HistoAnneeMoisProduit)
      		FIN
      
      
      
      	cas 4
      		si hlitrecherche(HistoAnneeMoisProduit,hClientlComp1lcomp2lcomp3lAnneelmois,...
      			HConstruitValClé(HistoAnneeMoisProduit,hClientlComp1lcomp2lcomp3lAnneelmois,lclient,lnumprod,"","","",lannee,lmois)) alors
      			HistoAnneeMoisProduit.lqte += lqte
      			HistoAnneeMoisProduit.lpied =0
      			HistoAnneeMoisProduit.lvente +=  arrondi(lmontant,2)
      			HistoAnneeMoisProduit.lsurcharge +=  arrondi(lsurcharge,2)
      			HistoAnneeMoisProduit.peinturecarrelage += ltotalpeinture
      			hmodifie(HistoAnneeMoisProduit,hNumEnrEnCours)
      		sinon
      			HistoAnneeMoisProduit.lperiode = lperiode
      			HistoAnneeMoisProduit.hClient = lclient
      			HistoAnneeMoisProduit.lAnnee = lannee
      			HistoAnneeMoisProduit.lmois = lmois
      			HistoAnneeMoisProduit.ldescription = ldesc
      			HistoAnneeMoisProduit.lComp1 = ""
      			HistoAnneeMoisProduit.lComp2 = ""
      			HistoAnneeMoisProduit.lComp3 = ""
      			HistoAnneeMoisProduit.lProduit = lnumprod
      			HistoAnneeMoisProduit.lsurcharge =  arrondi(lsurcharge,2)
      			HistoAnneeMoisProduit.lqte = lqte
      			HistoAnneeMoisProduit.lType = "C"
      			HistoAnneeMoisProduit.lpied =0
      			HistoAnneeMoisProduit.lvente =  arrondi(lmontant,2)
      			HistoAnneeMoisProduit.peinturecarrelage = ltotalpeinture
      			hajoute(HistoAnneeMoisProduit)
      		FIN
      	autre cas
      		si hlitrecherche(HistoAnneeMoisProduit,hClientlComp1lcomp2lcomp3lAnneelmois,...
      			HConstruitValClé(HistoAnneeMoisProduit,hClientlComp1lcomp2lcomp3lAnneelmois,lclient,lnumprod,"","","",lannee,lmois)) alors
      			HistoAnneeMoisProduit.lqte += lqte
      			HistoAnneeMoisProduit.lpied =0
      			HistoAnneeMoisProduit.lvente +=  arrondi(lmontant,2)
      			HistoAnneeMoisProduit.lsurcharge +=  arrondi(lsurcharge,2)
      			hmodifie(HistoAnneeMoisProduit,hNumEnrEnCours)
      		sinon
      			HistoAnneeMoisProduit.lperiode = lperiode
      			HistoAnneeMoisProduit.hClient = lclient
      			HistoAnneeMoisProduit.lAnnee = lannee
      			HistoAnneeMoisProduit.lmois = lmois
      			HistoAnneeMoisProduit.ldescription = ldesc
      			HistoAnneeMoisProduit.lComp1 = ""
      			HistoAnneeMoisProduit.lComp2 = ""
      			HistoAnneeMoisProduit.lComp3 = ""
      			HistoAnneeMoisProduit.lProduit = lnumprod
      			HistoAnneeMoisProduit.lsurcharge =  arrondi(lsurcharge,2)
      			HistoAnneeMoisProduit.lqte = lqte
      			HistoAnneeMoisProduit.lpied =0
      			HistoAnneeMoisProduit.lvente =  arrondi(lmontant,2)
      			HistoAnneeMoisProduit.peinturecarrelage = 0
      			hajoute(HistoAnneeMoisProduit)
      		FIN
      FIN
      
      
      
      
