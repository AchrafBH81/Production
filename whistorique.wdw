   -
     name : AlimenteLanneemois
     procedure_id : 5051560004661548644
     type_code : 14
     code : |1-
      Procédure AlimenteLanneemois()
      lannee est une chaine
      lmois est une chaine
      lclient est une chaine
      
      
      hcreation(HistoAnneeMois)
      hcreation(HistoAnneeMoisProduit)
      HLitPremier(BonLivraison,Bnumero)
      sablier(vrai)
      tantque pas hendehors(BonLivraison)
      	csnNoFacture = BonLivraison.Bfacture
      	MultitacheRepeint(whistorique)
      	si BonLivraison.Bfacture <> 0  alors
      		ltotalbon = 0
      		ltotalsurcharge = 0
      		lannee = BonLivraison.Bdatefacture..Année
      		lmois = BonLivraison.Bdatefacture..mois
      		lclient = sansespace(bonLivraison.Bclient)
      		AlimenteAnneMoisProduit(BonLivraison.bnumero,lclient,lannee,remplir_zero(lmois,2),lannee+remplir_zero(lmois,2))
      		hraz(HistoAnneeMoisProduit)
      		BonLivraison.bstotal = ltotalbon+ltotalsurcharge
      		bonlivraison.Bsurcharge = ltotalsurcharge
      		BonLivraison.BTVH = arrondi((ltotalbon+ltotalsurcharge) * BonLivraison.bTauxTvh / 100,2)
              BonLivraison.btps = 0
              BonLivraison.btvq=0
      		HModifie(BonLivraison,hNumEnrEnCours)
              
              
      		si hlitrecherche(HistoAnneeMois,lanneeMois,HConstruitValClé(HistoAnneeMois,lanneemois,lclient,lannee,lmois)) alors
      			HistoAnneeMois.lvente+= ltotalbon+ltotalsurcharge
      //			HistoAnneeMois.lvente+= BonLivraison.BStotal//+ltotalsurcharge
      			hmodifie(HistoAnneeMois,hNumEnrEnCours)
      		sinon
      			si BonLivraison.bstotal <> 0
      				HistoAnneeMois.hclient = lclient
      				HistoAnneeMois.lAnnee = lannee
      				HistoAnneeMois.lmois = lmois
      //				HistoAnneeMois.lvente = BonLivraison.BStotal//+ltotalsurcharge
      				HistoAnneeMois.lvente = ltotalbon+ltotalsurcharge
      				hajoute(HistoAnneeMois)
      			FIN
      		fin
      	FIN
      	HLitSuivant(BonLivraison,Bnumero)
      FIN
      
      sablier(faux)                      
     type : 458752
   -
     name : AlimenteAnneMoisProduit
     procedure_id : 5051560072065405711
     type_code : 14
     code : |1+
      Procédure AlimenteAnneMoisProduit(lNumeroBon,lclient,lannee,lmois,lperiode)
      i est un entier
      HExécuteRequête(RequeteDetailfacture,hRequêteDéfaut,lNumeroBon)
      HLitPremier(RequeteDetailfacture)
      
      
      tantque pas HEnDehors(RequeteDetailfacture)
      	si hlitrecherche(client,numero,RequeteDetailfacture.faclient) alors
      		hlitrecherche(hfdetail,HFCLEUNIK,RequeteDetailfacture.HFCLEUNIK)
      		tantque  hfdetail.fdnocomm = RequeteDetailfacture.fanumero et pas hendehors(hfdetail)
      			selon hfdetail.ftype
      				cas 1
      					si hlitrecherche(HistoAnneeMoisProduit,hClientlComp1lcomp2lcomp3lAnneelmois,...
      						HConstruitValClé(HistoAnneeMoisProduit,hClientlComp1lcomp2lcomp3lAnneelmois,lclient,hfdetail.fdnumprod,hfdetail.fdcomposant1,...
      						hfdetail.fdcomposant2,hfdetail.fdcomposant3,lannee,lmois)) alors
      						HistoAnneeMoisProduit.lqte += hfdetail.fdqteafacturer
      						HistoAnneeMoisProduit.lvente +=  arrondi(hfdetail.fdqteafacturer * ((hfdetail.fdpiedcarrefacture * hfdetail.fdprixupiedfacture)  + hfdetail.fdextraforme),2)
      						HistoAnneeMoisProduit.lsurcharge +=  arrondi(hfdetail.surchargeenergie,2)
      						hmodifie(HistoAnneeMoisProduit,hNumEnrEnCours)
      					sinon
      						HistoAnneeMoisProduit.lperiode = lperiode
      						HistoAnneeMoisProduit.hClient = lclient
      						HistoAnneeMoisProduit.lAnnee = lannee
      						HistoAnneeMoisProduit.lmois = lmois
      						HistoAnneeMoisProduit.ldescription = hfdetail.fddesc
      						HistoAnneeMoisProduit.lProduit = hfdetail.fdnumprod
      						HistoAnneeMoisProduit.lComp1 = hfdetail.fdcomposant1
      						HistoAnneeMoisProduit.lComp2 = hfdetail.fdcomposant2
      						HistoAnneeMoisProduit.lComp3 = hfdetail.fdcomposant3
      						HistoAnneeMoisProduit.lsurcharge =  arrondi(hfdetail.surchargeenergie,2)
      						HistoAnneeMoisProduit.lqte = hfdetail.fdqteafacturer
      						HistoAnneeMoisProduit.lvente =  arrondi(hfdetail.fdqteafacturer * ((hfdetail.fdpiedcarrefacture * hfdetail.fdprixupiedfacture)  + hfdetail.fdextraforme),2)
      						si HistoAnneeMoisProduit.lvente <> 0 alors
      							hajoute(HistoAnneeMoisProduit)
      						fin
      					FIN
      					ltotalbon+=arrondi(hfdetail.fdqteafacturer * ((hfdetail.fdpiedcarrefacture * hfdetail.fdprixupiedfacture)  + hfdetail.fdextraforme),2)
      					ltotalsurcharge += arrondi(hfdetail.surchargeenergie,2)
      
      				cas 4
      					si hlitrecherche(HistoAnneeMoisProduit,hClientlComp1lcomp2lcomp3lAnneelmois,...
      						HConstruitValClé(HistoAnneeMoisProduit,hClientlComp1lcomp2lcomp3lAnneelmois,lclient,hfdetail.fdnumprod,"","","",lannee,lmois)) alors
      						HistoAnneeMoisProduit.lqte += hfdetail.fdqteafacturer
      						HistoAnneeMoisProduit.lvente +=  arrondi(hfdetail.fdcarrprixtotal,2)+arrondi(hfdetail.fdqteafacturer*hfdetail.fTotalPeinture)
      						HistoAnneeMoisProduit.lsurcharge +=  arrondi(hfdetail.surchargeenergie,2)
      						hmodifie(HistoAnneeMoisProduit,hNumEnrEnCours)
      					sinon
      						HistoAnneeMoisProduit.lperiode = lperiode
      						HistoAnneeMoisProduit.hClient = lclient
      						HistoAnneeMoisProduit.lAnnee = lannee
      						HistoAnneeMoisProduit.lmois = lmois
      						HistoAnneeMoisProduit.ldescription = hfdetail.fddesc
      						HistoAnneeMoisProduit.lComp1 = ""
      						HistoAnneeMoisProduit.lComp2 = ""
      						HistoAnneeMoisProduit.lComp3 = ""
      						HistoAnneeMoisProduit.lProduit = hfdetail.fdnumprod
      						HistoAnneeMoisProduit.lsurcharge =  arrondi(hfdetail.surchargeenergie,2)
      						HistoAnneeMoisProduit.lqte = hfdetail.fdqteafacturer
      						HistoAnneeMoisProduit.lvente =  arrondi(hfdetail.fdcarrprixtotal,2)//+arrondi(hfdetail.fdqteafacturer*hfdetail.fTotalPeinture)
      						si HistoAnneeMoisProduit.lvente <> 0 alors
      							hajoute(HistoAnneeMoisProduit)
      						fin
      
      					FIN
      					ltotalbon+= arrondi(hfdetail.fdcarrprixtotal,2)
      					ltotalsurcharge += arrondi(hfdetail.surchargeenergie,2)
      				autre cas
      					si hfdetail.fdverreunite alors
      						si hlitrecherche(HistoAnneeMoisProduit,hClientlComp1lcomp2lcomp3lAnneelmois,...
      							HConstruitValClé(HistoAnneeMoisProduit,hClientlComp1lcomp2lcomp3lAnneelmois,lclient,hfdetail.fdnumprod,"","","",lannee,lmois)) alors
      							HistoAnneeMoisProduit.lqte += hfdetail.fdqteafacturer
      							HistoAnneeMoisProduit.lvente +=  arrondi(hfdetail.fdqteafacturer * ((hfdetail.fdpiedcarrefacture * hfdetail.fdprixupiedfacture)  + hfdetail.fdextraforme),2)
      							HistoAnneeMoisProduit.lsurcharge +=  arrondi(hfdetail.surchargeenergie,2)
      							hmodifie(HistoAnneeMoisProduit,hNumEnrEnCours)
      						sinon
      							HistoAnneeMoisProduit.lperiode = lperiode
      							HistoAnneeMoisProduit.hClient = lclient
      							HistoAnneeMoisProduit.lAnnee = lannee
      							HistoAnneeMoisProduit.lmois = lmois
      							HistoAnneeMoisProduit.ldescription = hfdetail.fddesc
      							HistoAnneeMoisProduit.lComp1 = ""
      							HistoAnneeMoisProduit.lComp2 = ""
      							HistoAnneeMoisProduit.lComp3 = ""
      							HistoAnneeMoisProduit.lProduit = hfdetail.fdnumprod
      							HistoAnneeMoisProduit.lsurcharge =  arrondi(hfdetail.surchargeenergie,2)
      							HistoAnneeMoisProduit.lqte = hfdetail.fdqteafacturer
      							HistoAnneeMoisProduit.lvente =  arrondi(hfdetail.fdqteafacturer * ((hfdetail.fdpiedcarrefacture * hfdetail.fdprixupiedfacture)  + hfdetail.fdextraforme),2)
      							si HistoAnneeMoisProduit.lvente <> 0 alors
      								hajoute(HistoAnneeMoisProduit)
      							fin		
      						FIN
      						ltotalbon+= arrondi(hfdetail.fdqteafacturer * ((hfdetail.fdpiedcarrefacture * hfdetail.fdprixupiedfacture)  + hfdetail.fdextraforme),2)
      						ltotalsurcharge += arrondi(hfdetail.surchargeenergie,2)
      					sinon
      						si hlitrecherche(HistoAnneeMoisProduit,hClientlComp1lcomp2lcomp3lAnneelmois,...
      							HConstruitValClé(HistoAnneeMoisProduit,hClientlComp1lcomp2lcomp3lAnneelmois,lclient,hfdetail.fdnumprod,"","","",lannee,lmois)) alors
      							HistoAnneeMoisProduit.lqte += hfdetail.fdqteafacturer
      							HistoAnneeMoisProduit.lvente +=  arrondi(hfdetail.fdqteafacturer * hfdetail.fdprixu,2)
      							HistoAnneeMoisProduit.lsurcharge +=  arrondi(hfdetail.surchargeenergie,2)
      							hmodifie(HistoAnneeMoisProduit,hNumEnrEnCours)
      						sinon
      							HistoAnneeMoisProduit.lperiode = lperiode
      							HistoAnneeMoisProduit.hClient = lclient
      							HistoAnneeMoisProduit.lAnnee = lannee
      							HistoAnneeMoisProduit.lmois = lmois
      							HistoAnneeMoisProduit.ldescription = hfdetail.fddesc
      							HistoAnneeMoisProduit.lComp1 = ""
      							HistoAnneeMoisProduit.lComp2 = ""
      							HistoAnneeMoisProduit.lComp3 = ""
      							HistoAnneeMoisProduit.lProduit = hfdetail.fdnumprod
      							HistoAnneeMoisProduit.lsurcharge =  arrondi(hfdetail.surchargeenergie,2)
      							HistoAnneeMoisProduit.lqte = hfdetail.fdqteafacturer
      							HistoAnneeMoisProduit.lvente =   arrondi(hfdetail.fdqteafacturer * hfdetail.fdprixu,2)
      							si HistoAnneeMoisProduit.lvente <> 0 alors
      								hajoute(HistoAnneeMoisProduit)
      							fin		
      						FIN
      						ltotalbon+=arrondi(hfdetail.fdqteafacturer * hfdetail.fdprixu,2)
      						ltotalsurcharge +=  arrondi(hfdetail.surchargeenergie,2)
      					fin
      
      			FIN
      
      			hlitsuivant(hfdetail,HFCLEUNIK)
      
      		fin	
      	fin
      	hlitsuivant(RequeteDetailfacture)
      FIN
      
      
      
     type : 458752
