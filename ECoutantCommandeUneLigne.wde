 controls : []
 code_elements :
  type_code : 13
  p_codes :
   -
     code : |1+
      procedure ECoutantCommandeUneLigne(lqte=1,ltotalcommande=0)
      
      ltotalligne est un reel
      // fcoutant.ftype 
      //
      // 1 = verre
      // 2 = Spacer
      // 3 = cap
      // 4 = gaz
      // 5 = carrelage
      // 6 = Main d'oeuvre
      // 7 = Frais généraux
      // 8 = Autres frais
      // 9 = Main d'oeuvre Carrelage
      
     type : 327680
   -
     code : |1+
      si RequeteCoutantCommandeUneLigne.cType = 5 alors
      	iSubstBloc(CORPS,ITERATION1)
      sinon
      	iSubstBloc(CORPS,"")
      
      FIN
      
      
     type : 327695
   -
     code : |1+
      iImprimeBloc(BasDePagePersonnel)
     type : 327682
