       properties :
        x : 32.235
        width : 89.586
        height : 5.
       code_elements :
        type_code : 29
        p_codes :
         -
           code : |1+
            selon RequeteCoutantCommandeUneLigne.cType
            	cas 6,9 
            	   moimeme = "Main d'oeuvre"
            	cas 7
            		moimeme = "Frais généraux"
            	cas 8
            		moimeme = "Autres frais"
            	autres cas
            		si hlitrecherche(invent,INUM,RequeteCoutantCommandeUneLigne.CFourniture) alors
            			moimeme = invent.idesc
            		FIN
            
            FIN
            
           type : 327692
         -
           type : 327699
           enabled : false
