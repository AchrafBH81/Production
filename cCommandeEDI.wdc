   -
     name : ParserThermos
     procedure_id : 1731267034603976985
     type_code : 12
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //ParserThermos (<idclientencours>)
      //
      // Paramètres :
      // 	idclientencours : <indiquez ici le rôle de idclientencours>
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE ParserThermos(idclientencours)
      sChaineaparser	est une chaine	= sansespace(:desc1)+" "+sansespace(:desc2)
      nPos			est un entier	//= PositionOccurrence(chaineaparser," ",2,DepuisFin)
      
      
      
      
      :épaisseur = 0
      SI HLitRecherche(RelationEDI,IdClientdescriptionEDIClient,[idclientencours,1,:Thermos]) ALORS
      	:IdThermosRelation = relationedi.IDpersoEns	
      	:IDRelationEdi = relationedi.IDRelationEDI
      	:relationThermosOK = vrai
      	:detailFacture._CommSpeciale = faux
      	:detailFacture._unitedemesure = 1
      	si hlitrecherche(persoens,PECLEUNIK,IdThermosRelation) alors
      		:detailFacture._Numthermos = persoens.ennumero
      		:detailfacture._AvecCap = persoens.encap
      		:detailFacture._AvecGaz = persoens.engaz
      		:composant1 = Persoens.encomposant1
      		:produitdebase = persoens.epbase
      		:detailFacture._codeGL = persoens.encodegl
      		:detailFacture._descThermos = persoens.endescription
      		:detailfacture._JobLigne = :nojob
      		
      		si Pas sansespace(:composant1) = "" _et_ hlitrecherche(invent,INUM,:composant1) alors
      			:ComposantBase1 = invent.ipbase
      			:detailfacture._epaisseur+= invent.iepaisseur
      			si pas :detailFacture._EnergiVerre alors detailFacture._EnergiVerre = (invent.ienergieverre OU invent.ienergieverreESC)
      			
      		FIN
      		:composant2 = Persoens.encomposant2
      		SI PAS SansEspace(:composant2) = "" _ET_ HLitRecherche(Invent,INUM,:composant2) ALORS
      			:ComposantBase2 = Invent.IPBASE
      			:detailFacture._epaisseur+= Invent.iepaisseur
      			SI PAS :detailFacture._EnergiVerre ALORS detailFacture._EnergiVerre = (invent.ienergieverre OU invent.ienergieverreESC)
      		fin
      		:composant3 = Persoens.encomposant3
      		SI PAS SansEspace(:composant3) = "" _ET_ HLitRecherche(Invent,INUM,:composant3) ALORS
      			:ComposantBase3 = Invent.IPBASE
      			:detailFacture._epaisseur+= Invent.iepaisseur
      			SI PAS :detailFacture._EnergiVerre ALORS detailFacture._EnergiVerre = (invent.ienergieverre OU invent.ienergieverreESC)
      		FIN
      		si sansespace(:composant3) = "" alors :nbverre = 2 sinon :nbverre =3
      	fin
      fin
      
      SI sansespace(:spacer) = "" _ou_ HLitRecherche(RelationEDI,IdClientdescriptionEDIClient,[idclientencours,3,:Spacer],hIdentique) ALORS
      	
      	IdSpacerRelation = RelationEDI.IDSpacer
      	:relationSpacerOK = Vrai
      	SI HLitRecherche(IntercalaireCouleurs,IDIntercalaireCouleurs,:IDSpacerRelation) ALORS
      		TypeSpacer = IntercalaireCouleurs.IDIntercalaireCouleurs
      	FIN
      FIN
      
      
