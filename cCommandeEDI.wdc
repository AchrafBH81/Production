     type : 458752
   -
     name : CalculNbCarreau
     procedure_id : 1736116108989028211
     type_code : 12
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] CalculNbCarreau ( [<methode>])
      //
      // Paramètres :
      // 	methode (valeur par défaut=1) : < indiquez ici le rôle de methode >
      // Valeur de retour :
      // 	entier : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE CalculNbCarreau(methode = 1)
      // méthode  1 = normal
      //          2 = contour
      //          3 = semi-contour 
      
      
      LOCAL
      	nbcarreau est un entier
      	met1 est une chaine = config.formulecontour
      	met2 est une chaine = config.formulesemicontour
      	formule1 est une chaine 
      	formule2 est une chaine = "y est un reel"+RC+"y="+met2+RC+"renvoyer(y)"
      	res est une chaine
      	
      SI Client.cQteSpecialeContour ALORS
      	SI SansEspace(typecarr.TcalculQteContour) <> "" ALORS
      		nbl est un entier = commandeTRN.CDCARREAUV
      		nbh est un entier = commandeTRN.CDCARREAUH
      		formule1 = "y est un reel"+RC+"y="+typecarr.TcalculQteContour+RC+"renvoyer(y)"
      		methode = 2
      	FIN	
      SINON
      	methode = 1
      FIN
      
      SELON methode
      	CAS 1
      		nbcarreau = commandeTRN.CDCARREAUV * commandeTRN.CDCARREAUH
      	CAS 2
      		res = Compile("formulec1",formule1)
      		SI res = "" ALORS
      			nbcarreau = ExécuteTraitement("formulec1",trtProcédure) 
      		FIN
      		
      	
      	CAS 3
      		res = Compile("formulec2",formule2)
      		SI res = "" ALORS
      			nbcarreau = ExécuteTraitement("formulec2",trtProcédure) 
      		FIN
      		
      		
      FIN
      RENVOYER nbcarreau
      
      
      
      
      
      
      
      
      
     type : 458752
   -
     name : CalculSurface
     procedure_id : 1736119167005864686
     type_code : 12
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] CalculSurface ()
      //
      // Paramètres :
      //	Aucun
      // Valeur de retour :
      // 	réel : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE CalculSurface()
      
      
      surface_entier_largeur est un reel
      surface_fraction_largeur est un reel
      surface_entier_hauteur est un reel
      surface_fraction_hauteur est un reel
      largeur_calcul est un reel
      hauteur_calcul est un reel
      
      SELON :detailFacture._unitedemesure
      	// Anglais
      	CAS 1 
      		
      		surface_entier_largeur = PartieEntière(Val(:Largeur))
      		surface_fraction_largeur = PartieDécimale(Val(:Largeur))
      		surface_entier_hauteur = PartieEntière(Val(:hauteur))
      		surface_fraction_hauteur = PartieDécimale(Val(:hauteur))
      		
      		SI modulo(surface_entier_largeur,2) = 0 ALORS
      			SI PAS surface_fraction_largeur = 0  ALORS
      				largeur_calcul = surface_entier_largeur + 2
      			SINON
      				largeur_calcul = surface_entier_largeur 
      			FIN	
      		SINON
      			largeur_calcul = surface_entier_largeur + 1
      		FIN	
      		
      		SI modulo(surface_entier_hauteur,2) = 0 ALORS
      			SI PAS surface_fraction_hauteur = 0  ALORS
      				hauteur_calcul = surface_entier_hauteur + 2
      			SINON
      				hauteur_calcul = surface_entier_hauteur 
      			FIN	
      		SINON
      			hauteur_calcul = surface_entier_hauteur + 1
      		FIN	
      		
      		
      		RENVOYER hauteur_calcul * largeur_calcul / 144
      		
      		
      		//Métrique
      		
      	CAS 2
      		
      		//largeur_calcul = val(commande.cdlargeur) * 1000
      		largeur_calcul = Val(:Largeur) //* 1000
      		SI PAS modulo(largeur_calcul,20) = 0 ALORS
      			
      			largeur_calcul = largeur_calcul + (20 - modulo(largeur_calcul,20))
      			
      		FIN
      		
      		largeur_calcul = largeur_calcul / 1000
      		
      		hauteur_calcul = Val(:hauteur) //* 1000
      		SI PAS modulo(hauteur_calcul,20) = 0 ALORS
      			
      			hauteur_calcul = hauteur_calcul + (20 - modulo(hauteur_calcul,20))
      			
      		FIN
      		
      		hauteur_calcul = hauteur_calcul / 1000
      		
      		
      		RENVOYER hauteur_calcul * largeur_calcul
      		
      		
      FIN	
      
      
      
      
     type : 458752
   -
     name : VerifieSurface
     procedure_id : 1736119544963009683
     type_code : 12
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] VerifieSurface (<surfaceaverifier1>)
      //
      // Paramètres :
      // 	surfaceaverifier1 : <indiquez ici le rôle de surfaceaverifier1>
      // Valeur de retour :
      // 	booléen : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE VerifieSurface(surfaceaverifier1)
      
      
      valeuraretourner EST UN BOOLEEN = VRAI
      surfaceaverifier est un reel
      decision est un entier 
      lemessage est une chaine = " Le composant "
      produitremplacement est une chaine
      
      
      composantrempl1 est une chaine = :composant1
      composantrempl2 est une chaine = :composant2
      composantrempl3 est une chaine = :composant3
      saveccap est un booleen = faux
      savecgaz est un booleen = faux
      cleaveccap est une chaine
      cleavecgaz est une chaine
      SI :detailFacture._unitedemesure = 2 ALORS
      	surfaceaverifier = surfaceaverifier1 * tauxconversionam
      	
      SINON
      	surfaceaverifier = surfaceaverifier1
      FIN
      
      SI SansEspace(:composant1) <> "" ALORS 
      	HLitRecherche(Invent,INUM,SansEspace(:composant1))
      	SI Invent.isurfmax <> 0.00 ALORS
      		TANTQUE  surfaceaverifier > Invent.isurfmax ET Invent.isurfmax <> 0.00
      			composantrempl1 = SansEspace(Invent.ipsuivant)
      			valeuraretourner = Faux
      			SI composantrempl1 = "" ALORS
      				SORTIR
      			FIN
      			HLitRecherche(Invent,INUM,SansEspace(Invent.ipsuivant))
      			
      		FIN  
      	FIN
      FIN
      
      SI SansEspace(:composant2) <> "" ALORS 
      	
      	HLitRecherche(Invent,INUM,SansEspace(:composant2))
      	
      	SI Invent.isurfmax <> 0.00 ALORS
      		TANTQUE  surfaceaverifier > Invent.isurfmax ET Invent.isurfmax <> 0.00
      			composantrempl2 = SansEspace(Invent.ipsuivant)
      			valeuraretourner = Faux
      			SI composantrempl2 = "" ALORS
      				SORTIR
      			FIN
      			
      			HLitRecherche(Invent,INUM,SansEspace(Invent.ipsuivant))
      			
      		FIN  
      	FIN	
      FIN
      SI SansEspace(:composant3) <> "" ALORS 
      	
      	HLitRecherche(Invent,INUM,SansEspace(:composant3))
      	
      	SI Invent.isurfmax <> 0.00 ALORS
      		TANTQUE  surfaceaverifier > Invent.isurfmax ET Invent.isurfmax <> 0.00
      			composantrempl3 = SansEspace(Invent.ipsuivant)
      			valeuraretourner = Faux
      			SI composantrempl3 = "" ALORS
      				SORTIR
      			FIN
      			HLitRecherche(Invent,INUM,SansEspace(Invent.ipsuivant))
      			
      		FIN  
      	FIN
      FIN
      HLitRecherche(Persoens,ennumero,:detailFacture._Numthermos)
      //Code WinDev 5.5 remplacé par la migration :
      //si pas h.endehors et h.trouve alors
      SI PAS HEnDehors() ET HTrouve() ALORS
      	saveccap = Persoens.encap
      	savecgaz = Persoens.engaz
      FIN
      HConvertC(cleaveccap,saveccap)
      HConvertC(cleavecgaz,savecgaz)
      
      HLitRecherche(Persoens,clecomposantcapgaz,Complète(composantrempl1,10)+Complète(composantrempl2,10)+Complète(composantrempl3,10)+cleaveccap+cleavecgaz)
      //Code WinDev 5.5 remplacé par la migration :
      //SI PAS H.ENDEHORS ET H.TROUVE ALORS
      SI PAS HEnDehors() ET HTrouve() ALORS
      	produitremplacement = SansEspace(Persoens.ennumero)
      	
      FIN
      
      RENVOYER valeuraretourner
      
      
      
      
      
     type : 458752
   -
     name : ParserForme
     procedure_id : 1777155259769385562
     type_code : 12
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] ParserForme (<IdClientEnCours>)
      //
      // Paramètres :
      // 	IdClientEnCours : <indiquez ici le rôle de IdClientEnCours>
      // Valeur de retour :
      // 	booléen : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE ParserForme(IdClientEnCours)
      
      SI SansEspace(:DescriptionForme) = "" ALORS RENVOYER Vrai
      
      :DetailForme._Dimension1 = :FormeDimension1
      :DetailForme._Dimension2 = :FormeDimension2
      :DetailForme._Dimension3 = :FormeDimension3
      :DetailForme._Dimension4 = :FormeDimension4
      :DetailForme._Dimension5 = :FormeDimension5
      
      
      SI  HLitRecherche(RelationEDI,IdClientdescriptionEDIClient,[IdClientEnCours,6,:DescriptionForme],hIdentique) ALORS
      	:IDformeRelation = RelationEDI.IDforme
      	:relationformeOK = Vrai
      	:Detailforme._NumeroForme = :IDformeRelation
      	
      FIN
     type : 458752
   -
     name : CalculSurfaceReelle
     procedure_id : 1777686993898734871
     type_code : 12
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] CalculSurfaceReelle ()
      //
      // Paramètres :
      //	Aucun
      // Valeur de retour :
      // 	réel : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE CalculSurfaceReelle()
      
      
      surface_entier_largeur est un reel
      surface_fraction_largeur est un reel
      surface_entier_hauteur est un reel
      surface_fraction_hauteur est un reel
      largeur_calcul est un reel
      hauteur_calcul est un reel
      
      SELON :detailFacture._unitedemesure
      	// Anglais
      	CAS 1 
      		
      		surface_entier_largeur = PartieEntière(Val(:Largeur))
      		surface_fraction_largeur = PartieDécimale(Val(:Largeur))
      		surface_entier_hauteur = PartieEntière(Val(:hauteur))
      		surface_fraction_hauteur = PartieDécimale(Val(:hauteur))
      		
      
      		
      		
      		RENVOYER hauteur_calcul * largeur_calcul / 144
      		
      		
      		//Métrique
      		
      	CAS 2
      		
      		//largeur_calcul = val(commande.cdlargeur) * 1000
      		largeur_calcul = Val(:Largeur) //* 1000
      
      		
      		largeur_calcul = largeur_calcul / 1000
      		
      		hauteur_calcul = Val(:hauteur) //* 1000
      
      		
      		hauteur_calcul = hauteur_calcul / 1000
      		
      		
      		RENVOYER hauteur_calcul * largeur_calcul
      		
      		
      FIN	
      
      
      
      
     type : 458752
