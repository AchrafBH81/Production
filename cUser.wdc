      		m_Isdeleted 		est un booleen 		<mapping = Isdeleted>
      		m_bIsActive 		est un booleen		 <mapping = isactive>
      		m_sCompanyNumber est une chaine <mapping = CompanyNumber>
      		m_bIsNew est un booleen <mapping = isnew>
      	<FIN>
