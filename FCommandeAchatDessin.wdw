 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1-
      PROCEDURE MaFenêtre(nIdCommande est un entier = 0,NoCommande est une chaine = "")
      
      tabFileName est un tableau de chaînes
      RepEncours est une chaine = completerep(fRépertoireTemp())
   -
     code : |1+
      txtsql est une chaine = [
      select * from commandeachatdessin where commandeAchatdessin.idcommandeachat = %1
      ]
      reqSql est une source de donnees
      CurrentID est un entier
      Filename est une chaine
      
      
      si HExécuteRequêteSQL(reqSql,hRequêteDéfaut,chaineconstruit(txtsql,nIdCommande)) ALORS
      	pour TOUT reqSql 
      		//CurrentID = ZRDessin.ajoute()
      		hlitrecherche(CommandeAchatDessin,IDCommandeAchatDessin,reqSql.idcommandeachatdessin)
      		Filename = repencours+reqSql.idcommandeachatdessin+".pdf"
      		tabFileName.Ajoute(Filename)
      		HExtraitMémo(CommandeAchatDessin,Dessin,Filename)
      		zrdessin.ajouteligne(Filename,1,reqSql.idcommandeachatdessin,reqSql.filedescription)
      	FIN
      FIN
      ExplorerAccepte(Vrai, ZRDessin)
      Evénement("AddPdfFile", "ZRDessin", WM_DROPFILES)
      //Evénement("OutlookPdfFile", "AddButton",cf_hdrop)
      
      ZRDessin..DndCible = dndProgrammé
      //AddButton..DndCible = dndProgrammé
      DnDEvénement("SurSurvol", ZRDessin, dndSurvol)
      //DnDEvénement("OutlookPdfFile", AddButton, dndLâcher)
      //DnDEvénement("SurSurvol", addbutton, dndSurvol)
      
     type : 34
   -
     code : |1+
      
      
     type : 234
   -
     code : |1+
      
      
     type : 165
   -
     code : |1+
      
      
     type : 177
   -
     type : 180
     enabled : false
   -
     type : 230
     enabled : false
   -
     code : |1+
      
      pour chaque filename de tabfilename
      	fsupprime(filename)
      FIN
     type : 2
  procedures :
   -
     name : SurSurvol
     procedure_id : 1204220207482398851
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
