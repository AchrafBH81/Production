     type : 458752
   -
     name : AddPdfFile
     procedure_id : 1204220843137575478
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      // AddPdfFile ()
      //
      // Paramètres :
      //	Aucun
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE AddPdfFile()
      
      DnDAccepte(dndCopier)
      nbFic est un entier = ExplorerRécupère(_EVE.wParam)
      sNomFic est une chaîne
      FileDescription est une chaine
      FileName est une chaine
      sTabFilename est un tableau de chaînes
      
      // Récupération de tous les fichiers
      POUR i = 1 A nbFic
      	sNomFic = ExplorerRécupère(_EVE.wParam, i)
      	si majuscule(fExtraitChemin(sNomFic,fExtension)) = ".PDF" alors
      		sTabFilename.ajoute(sNomFic)
      	FIN
      fin
      pour chaque sFilename de sTabFilename
              FileDescription = ""
      //		Saisie("Description du fichier <"+sFilename+">",FileDescription)
      		HRAZ(CommandeAchatDessin)
      		CommandeAchatDessin.IDCommandeAchat = CommandeAchat.IDCommandeAchat
      		CommandeAchatDessin.FileDescription = fExtraitChemin(sFilename,fFichier+fExtension)
      		//CommandeAchatDessin.Dessin = "c:\documents\test.jpg"
      		HAttacheMémo(CommandeAchatDessin,Dessin,sFilename,hMémoImg)
      		HAjoute(CommandeAchatDessin)
      		
      		
      		
      		FileName = RepEncours+CommandeAchatDessin.IDCommandeAchatDessin+".pdf"
      		TabFilename.Ajoute(FileName)
      		HExtraitMémo(CommandeAchatDessin,Dessin,FileName)
      		ZRDessin.AjouteLigne(FileName,1,CommandeAchatDessin.IDCommandeAchatDessin,CommandeAchatDessin.FileDescription)
      
      FIN
     type : 458752
   -
     name : PasteFile
     procedure_id : 1204273095861193869
     type_code : 14
     code : |1+
      hwndObjet est un entier = 0
      nTailleBuffer est un entier = 0
      nClipBoardFormat est un entier = 0
      sFormatName est une chaîne = ""
      sFichierCopier est une chaîne = ""
      bufBuffer est un Buffer sur 10 000 000 // Prévoir une taille suffisante pour stocker la pièce jointe
      
      // Ouverture au Press Papier
      AppelDLL32("user32", "OpenClipboard",0)
      
      // Enumération des types présent dans le presse papier
      nClipBoardFormat = AppelDLL32("user32", "EnumClipboardFormats",nClipBoardFormat)
      
      TANTQUE nClipBoardFormat <> 0
      	
      	// Lecture de du type de l'élément stoqué
      	nTailleBuffer = AppelDLL32("user32", "GetClipboardFormatNameA",nClipBoardFormat,&bufBuffer,255)
      	
      	// Réupération de du type de l'élément stoqué
      	sFormatName = Tronque(bufBuffer,nTailleBuffer)
      	
      	SELON sFormatName
      	
      		CAS "FileGroupDescriptor"
      			
      			// RECUPERATION DU FICHIER COPIÉ DEPUIS OUTLOOK
      			hwndObjet = AppelDLL32("user32", "GetClipboardData",nClipBoardFormat)
      			
      			SI hwndObjet <> 0 ALORS
      				
      				nTailleBuffer = AppelDLL32("kernel32","GlobalSize",hwndObjet)
      				
      				Transfert(&bufBuffer, hwndObjet, nTailleBuffer)
      				
      				sFichierCopier = Tronque(bufBuffer,nTailleBuffer)
      				
      				// Suppression des caractères inutiles
      				sFichierCopier = Remplace(sFichierCopier,Caract(0),"")
      				sFichierCopier = Remplace(sFichierCopier,Caract(1),"")
      				
      			FIN
      			
      		CAS "FileContents"
      			
      			// RECUPERATION DU CONETNU DU FICHIER COPIÉ DEPUIS OUTLOOK
      			hwndObjet = AppelDLL32("user32", "GetClipboardData",nClipBoardFormat)
      			
      			SI hwndObjet <> 0 ALORS
      				
      				// Récupération de la taille des données
      				nTailleBuffer = AppelDLL32("kernel32","GlobalSize",hwndObjet)
      				
      				// Copie des données dans le buffer tampon
      				Transfert(&bufBuffer, hwndObjet, nTailleBuffer)
      				
      				// Ajout du chemin
      				sFichierCopier = fRépertoireTemp() +[fSep()]+ sFichierCopier
      				
      				// Sauvegarde du buffer final dans un fichier
      				fSauveBuffer(sFichierCopier,Tronque(bufBuffer,nTailleBuffer))
      				
      			SINON
      				
      				sFichierCopier = ""
      				
      			FIN
      			
      	FIN
      	
      	nClipBoardFormat = AppelDLL32("user32", "EnumClipboardFormats",nClipBoardFormat)
      	
      FIN
      
      // Fermeture au Press Papier
      AppelDLL32("user32", "CloseClipboard")
      
      
      HRAZ(CommandeAchatDessin)
      CommandeAchatDessin.IDCommandeAchat = CommandeAchat.IDCommandeAchat
      CommandeAchatDessin.FileDescription = fExtraitChemin(sfichiercopier,fFichier+fExtension)
      //CommandeAchatDessin.Dessin = "c:\documents\test.jpg"
      HAttacheMémo(CommandeAchatDessin,Dessin,sfichiercopier,hMémoImg)
      HAjoute(CommandeAchatDessin)
      
      
      
      sFileName est une chaine = RepEncours+CommandeAchatDessin.IDCommandeAchatDessin+".pdf"
      tabFileName.Ajoute(sFileName)
      HExtraitMémo(CommandeAchatDessin,Dessin,sFileName)
      ZRDessin.AjouteLigne(sFileName,1,CommandeAchatDessin.IDCommandeAchatDessin,CommandeAchatDessin.FileDescription)
      
      // Ouverture du fichier
      fsupprime(sfichiercopier)
     type : 458752
   -
     name : OutLookPdfFile
     procedure_id : 1204293823433240855
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //OutLookPdfFile ()
      //
      // Paramètres :
      //	Aucun
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE OutLookPdfFile()
      
      DnDAccepte(dndCopier)
      Mail est un Email
      Mail..Source=fChargeTexte(ExplorerRécupère(_EVE.wParam,1))
      // Une fois la structure Email renseignée, les PJ se trouvent dans le tableau "Mail..Attache"
      POUR	nCpt=1 A TableauOccurrence(Mail..Attache)
      sCheminFichierASauver est une chaine =fRépertoireTemp() +[fSep()] +Mail..Attache[nCpt]..Nom
      EmailSauveFichierAttaché(Mail..Attache[nCpt],sCheminFichierASauver)
      FIN
      
      	
      
      
      
      
      
      
      nbFic est un entier = ExplorerRécupère(_EVE.wParam)
      sNomFic est une chaîne
      FileDescription est une chaine
      FileName est une chaine
      sTabFilename est un tableau de chaînes
      
      // Récupération de tous les fichiers
      POUR i = 1 A nbFic
      	sNomFic = ExplorerRécupère(_EVE.wParam, i)
      	si majuscule(fExtraitChemin(sNomFic,fExtension)) = ".PDF" alors
      		sTabFilename.ajoute(sNomFic)
      	FIN
      fin
      pour chaque sFilename de sTabFilename
              FileDescription = ""
      //		Saisie("Description du fichier <"+sFilename+">",FileDescription)
      		HRAZ(CommandeAchatDessin)
      		CommandeAchatDessin.IDCommandeAchat = CommandeAchat.IDCommandeAchat
      		CommandeAchatDessin.FileDescription = fExtraitChemin(sFilename,fFichier+fExtension)
      		//CommandeAchatDessin.Dessin = "c:\documents\test.jpg"
      		HAttacheMémo(CommandeAchatDessin,Dessin,sFilename,hMémoImg)
      		HAjoute(CommandeAchatDessin)
      		
      		
      		
      		FileName = RepEncours+CommandeAchatDessin.IDCommandeAchatDessin+".pdf"
      		TabFilename.Ajoute(FileName)
      		HExtraitMémo(CommandeAchatDessin,Dessin,FileName)
      		ZRDessin.AjouteLigne(FileName,1,CommandeAchatDessin.IDCommandeAchatDessin,CommandeAchatDessin.FileDescription)
      
      FIN
     type : 458752
