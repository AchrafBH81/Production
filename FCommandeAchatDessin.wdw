  -
    name : AddButton
    identifier : 0x20ad8d025373f1b2
    internal_properties : 
    properties :
     x : 686
     y : 111
     width : 50
     height : 50
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         sFichier est une chaîne
         Filename est une chaine
         Filedescription est une chaîne
         // Ouvre le sélecteur de fichiers
         sFichier = fSélecteur("", "", "Sélectionnez un dessin à importer", "Tous les fichiers (*.*)" + TAB + "*.*" + RC + "*.pdf" + TAB + "*.pdf", "*.pdf")
         si sFichier = "" alors renvoyer vrai
         //saisie("description du fichier",Filedescription)
         hraz(CommandeAchatDessin)
         CommandeAchatDessin.IDCommandeAchat = CommandeAchat.IDCommandeAchat
         //CommandeAchatDessin.FileDescription = Filedescription
         CommandeAchatDessin.FileDescription = fExtraitChemin(sfichier,fFichier+fExtension)
         
         //CommandeAchatDessin.Dessin = "c:\documents\test.jpg"
         hattachememo(CommandeAchatDessin,dessin,sFichier,hMémoImg)
         HAjoute(CommandeAchatDessin)
         
         
         
         Filename = RepEncours+commandeachatdessin.idcommandeachatdessin+".pdf"
         tabFileName.Ajoute(Filename)
         HExtraitMémo(CommandeAchatDessin,Dessin,Filename)
         ZRDessin.AjouteLigne(Filename,1,CommandeAchatDessin.idcommandeachatdessin,CommandeAchatDessin.FileDescription)
        type : 18
      -
        type : 161
        enabled : false
