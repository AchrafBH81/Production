   -
     name : VerifieCourriel
     procedure_id : 1652986333698336945
     type_code : 14
     code : |1+
      Procédure VerifieCourriel(lnoclient=0)
      
      si HLitRecherche(client,numero,lnoclient) alors
      	si  (sansespace(client.ccourrielFacture[1]) <> "" ou  sansespace(client.ccourrielFacture[2]) <> "" ou sansespace(client.ccourrielFacture[3]) <> "" ...
      		ou sansespace(client.ccourrielFacture[4]) <> "") alors
              renvoyer vrai
      	FIN
      fin
      renvoyer faux
     type : 458752
   -
     name : GetDetail
     procedure_id : 1749795575556403203
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //GetDetail (<nBillNumber> est entier, <nOrderNumber> est entier)
      //
      // Paramètres :
      //	nBillNumber (entier) : <indiquez ici le rôle de BillNumber>
      //	nOrderNumber (entier) : <indiquez ici le rôle de nOrderNumber>
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure GetDetail(nBillNumber est un entier , nOrderNumber est une entier)
      
      
      TableLigne.supprimetout()
      
      sTxtsql est une chaine = [
      	SELECT 
      	hfdetail.H0CLEUNIK AS H0CLEUNIK,	
      	hfdetail.fdligne AS fdligne,	
      	hfdetail.fdnocomm AS fdnocomm,	
      	hfdetail.fdnumprod AS fdnumprod,	
      	hfdetail.fddesc AS fddesc,	
      	hfdetail.fdqte AS fdqte,	
      	hfdetail.fdqteafacturer AS fdqteafacturer,	
      	hfdetail.fdqtedejafacture AS fdqtedejafacture,	
      	hfdetail.fdlargeur AS fdlargeur,	
      	hfdetail.fdlargeura AS fdlargeura,	
      	hfdetail.fdhauteur AS fdhauteur,	
      	hfdetail.fdhauteura AS fdhauteura,	
      	hfdetail.fdhauteur1 AS fdhauteur1,	
      	hfdetail.fdhauteur1a AS fdhauteur1a,	
      	hfdetail.fdprixu AS fdprixu,	
      	hfdetail.fdlien AS fdlien,	
      	hfdetail.fdnumcarr AS fdnumcarr,	
      	BonLivraison.bTauxTvh AS bTauxTvh,	
      	hfacture.NoLot AS NoLot,	
      	BonLivraison.btauxtvq AS btauxtvq,	
      	BonLivraison.bTauxTaxe1 AS bTauxTaxe1,	
      	BonLivraison.bTauxTaxe2 AS bTauxTaxe2,	
      	BonLivraison.bCalculTaux2sur1 AS bCalculTaux2sur1,	
      	BonLivraison.cvendeur AS cvendeur,	
      	hfdetail.surchargeTauxafacturer AS surchargeTauxafacturer,	
      	hfdetail.SUrchargeTaux AS SUrchargeTaux,	
      	hfacture.surchargeTauxChange AS surchargeTauxChange,	
      	hfacture.surchargeTauxPourc AS surchargeTauxPourc,	
      	hfacture.lNote AS lNote,	
      	hfdetail.fdhauteuranglais1 AS fdhauteuranglais1,
      	hfdetail.SUrchargeafacturer,
      	hfdetail.surchargeenergie,	
      	hfacture.IDCamions AS idcamions,	
      	Camions.Abreviation AS Abreviation
      	FROM 
      	(
      	(
      	BonLivraison
      	INNER JOIN
      	hfacture
      	ON BonLivraison.Bnumero = hfacture.Bnumero
      	)
      	LEFT OUTER JOIN
      	Camions
      	ON hfacture.IDCamions = Camions.IDCamions
      	)
      	INNER JOIN
      	hfdetail
      	ON hfacture.HFCLEUNIK = hfdetail.HFCLEUNIK
      	WHERE 
      	(
      	BonLivraison.Bnumero	= {pNoBon} AND
      	hfdetail.fdnocomm = {pOrderNumber} AND
      	hfdetail.ftype			= 1
      	)
      	ORDER BY 
      	fdnocomm ASC,	
      	fdligne ASC
      ]
      
      sdReqsql est une source de donnees
      sdReqsql.pNoBon = nBillNumber
      sdReqsql.pOrderNumber = nOrderNumber
      sTxtSqlOriginal est une chaine = [
      	SELECT 
      	
      	fdetail.fdligne AS fdligne,	
      	fdetail.fdnocomm AS fdnocomm,	
      	fdetail.fdnumprod AS fdnumprod,	
      	fdetail.fddesc AS fddesc,	
      	fdetail.fdqte AS fdqte,	
      	fdetail.fdqteafacturer AS fdqteafacturer,	
      	fdetail.fdqtedejafacture AS fdqtedejafacture,	
      	fdetail.fdlargeur AS fdlargeur,	
      	fdetail.fdlargeura AS fdlargeura,	
      	fdetail.fdhauteur AS fdhauteur,	
      	fdetail.fdhauteura AS fdhauteura,	
      	fdetail.fdhauteur1 AS fdhauteur1,	
      	fdetail.fdhauteur1a AS fdhauteur1a,	
      	fdetail.fdprixu AS fdprixu,	
      	fdetail.fdlien AS fdlien,	
      	fdetail.fdnumcarr AS fdnumcarr
      	
      	from fdetail
      	where fdetail.fdnocomm = {OrderNumber} and fdetail.ftype			= 1
      	order by fdligne
      	
      ]
      
      sdReqsqloriginal est une source de donnees
      sdReqsqloriginal.OrderNumber = Table_BlFacture.fanumero[Table_BlFacture]
      si HExécuteRequêteSQL(sdReqsqloriginal,hRequêteDéfaut,sTxtSqlOriginal) alors
      	pour TOUT sdReqsqloriginal 	
      		TableajouteLigne(tableligne,sdReqsqloriginal.fdnumprod,sdReqsqloriginal.fddesc,sdReqsqloriginal.fdlargeur,sdReqsqloriginal.fdhauteur,sdReqsqloriginal.fdnumcarr,...
      		sdReqsqloriginal.fdqte,0...
      		,0,sdReqsqloriginal.fdligne,sdReqsqloriginal.fdqte,0,sdReqsqloriginal.fdqtedejafacture)
      	fin
      FIN
      
      nRes est un entier
      
      si HExécuteRequêteSQL(sdReqsql,hRequêteDéfaut,sTxtsql) alors
      	pour tout sdReqsql
      		nRes = tablecherche("LIGNE",sdReqsql.fdligne,rechercheIdentique)  
      		si nRes <> -1 alors
      			tableligne[nRes].facturer = sdReqsql.fdqteafacturer
      			tableligne[nRes].COL_OldQtyToInvoice = sdReqsql.fdqteafacturer
      			
      		fin
      	fin	
      FIN
      
      tableselectmoins(TableLigne)
      
      
      
      
     type : 458752
   -
     name : SuppressBOL
     procedure_id : 1790535200107870660
     type_code : 14
     code : |1-
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      // SuppressBOL ()
      //
      // Paramètres :
      //	Aucun
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure SuppressBOL()
      
      /////////////////////////////////////////////////////////////
      POUR TOUT RequeteBlFacture 
      SI HLitRecherche(Facture,fanumero,RequeteBlFacture.fanumero) ALORS
      	Facture.FPREPARATION = "F"
      	HModifie(Facture)
      	POUR TOUT hfdetail AVEC "HFCLEUNIK= "+RequeteBlFacture.HFCLEUNIK
      		RequetefactureDetail.pNoComm	= hfdetail.fdnocomm
      		RequetefactureDetail.pNoLigne	= hfdetail.fdligne
      		HExécuteRequête(RequetefactureDetail,hModifieFichier)
      		POUR TOUT RequetefactureDetail
      			//			si hlitrecherche(fdetail,fdnocommfdligne,HConstruitValClé(fdetail,fdnocommfdligne,hfdetail.fdnocomm,hfdetail.fdligne)) alors
      			RequetefactureDetail.fdqtedejafacture-=hfdetail.fdqteafacturer
      			RequetefactureDetail.fdqteafacturer = RequetefactureDetail.fdqte-RequetefactureDetail.fdqtedejafacture
      			RequetefactureDetail.SUrchargedejafacture-=hfdetail.SUrchargeafacturer
      			RequetefactureDetail.SUrchargeafacturer = RequetefactureDetail.surchargeenergie - RequetefactureDetail.SUrchargedejafacture
      			
      			HModifie(RequetefactureDetail,hNumEnrEnCours)
      		FIN
      	FIN
      	
      FIN
      FIN
      
      //		hlitsuivant(RequeteBlFacture,RequeteBlFacture.fanumero)
      //	fin
      
      SI HLitRecherche(BonLivraison,Bnumero,numerodebon) ALORS
      	HSupprime(BonLivraison)
      FIN
      
      POUR TOUT RequeteBlFacture 
      SI HLitRecherche(BonLivraison,BnoCommande,RequeteBlFacture.fanumero) ALORS
      	Facture.livrepartiel = "P"
      	HModifie(Facture)
      SINON
      	Facture.livrepartiel = " "
      	HModifie(Facture)
      FIN
      FIN
      
      ////////////////////////////////////////////////////////////
      
      
      //
      //HLitPremier(RequeteBlFacture,RequeteBlFacture.fanumero)
      ////	tantque pas hendehors(RequeteBlFacture)
      //SI HLitRecherche(Facture,fanumero,RequeteBlFacture.fanumero) ALORS
      //	Facture.FPREPARATION = "F"
      //	HModifie(Facture)
      //	POUR TOUT hfdetail AVEC "HFCLEUNIK= "+RequeteBlFacture.HFCLEUNIK
      //		RequetefactureDetail.pNoComm	= hfdetail.fdnocomm
      //		RequetefactureDetail.pNoLigne	= hfdetail.fdligne
      //		HExécuteRequête(RequetefactureDetail,hModifieFichier)
      //		POUR TOUT RequetefactureDetail
      //			//			si hlitrecherche(fdetail,fdnocommfdligne,HConstruitValClé(fdetail,fdnocommfdligne,hfdetail.fdnocomm,hfdetail.fdligne)) alors
      //			RequetefactureDetail.fdqtedejafacture-=hfdetail.fdqteafacturer
      //			RequetefactureDetail.fdqteafacturer = RequetefactureDetail.fdqte-RequetefactureDetail.fdqtedejafacture
      //			RequetefactureDetail.SUrchargedejafacture-=hfdetail.SUrchargeafacturer
      //			RequetefactureDetail.SUrchargeafacturer = RequetefactureDetail.surchargeenergie - RequetefactureDetail.SUrchargedejafacture
      //			
      //			HModifie(RequetefactureDetail,hNumEnrEnCours)
      //		FIN
      //	FIN
      //	
      //FIN
      
      //		hlitsuivant(RequeteBlFacture,RequeteBlFacture.fanumero)
      //	fin
      
      //SI HLitRecherche(BonLivraison,Bnumero,numerodebon) ALORS
      //	HSupprime(BonLivraison)
      //FIN
      //SI HLitRecherche(BonLivraison,BnoCommande,RequeteBlFacture.fanumero) ALORS
      //	Facture.livrepartiel = "P"
      //	HModifie(Facture)
      //SINON
      //	Facture.livrepartiel = " "
      //	HModifie(Facture)
      //	
      //FIN
     type : 458752
   -
     name : CreateNewBOL
     internal_properties : CQAAAAkAAAD3VeNQ54qxa/l1CRHx2/4mDGoCOQwOQBBFWuJVoLbFOViOyZOqZlWQ9O0OW+3wXLXWHuFKD+9UPchgxctbGtYduCmXnkkibreQ+Zr6XZrrtyVq/zfBl+A=
     procedure_id : 1790555244729101802
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //CreateNewBOL (<nShippingBillNumber> est entier)
      //
      // Paramètres :
      //	nShippingBillNumber (entier) : <indiquez ici le rôle de nShippingBillNumber>
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //// Traitement automatique des exceptions :   exécuter le bloc de code CAS EXCEPTION:
      //
      
      procédure CreateNewBOL(nShippingBillNumber est une entier)
      lcombinetaxe		est un booleen
      nRecordNumber		est un entier
      nDestination		est un entier
      lAdresseCourriel	est une chaine
      lSujet				est une chaine
      lMessage			est une chaine 
      lNbCopieBlivraison	est un entier
      lnomfichier			est une chaine
      
      si hlitrecherche(facture,fanumero,Table_BlFacture.NoCommande[Table_BlFacture]) alors
      	nRecordNumber = HNumEnr(facture)	
      	
      FIN
      
      OuvreSoeur(FenAttentePetite)
      
      HTransactionDébut(gConnexionHF)
      
      HRAZ(BonLivraison)
      lcombinetaxe					= epurefactureNewBol(nRecordNumber,nShippingBillNumber)
      
      BonLivraison.Bclient			= hfacture.faclient
      BonLivraison.Bdate				= datesys()
      BonLivraison.Bnumero			= nShippingBillNumber
      BonLivraison.BCommandeClient	= hfacture.fanocommande
      BonLivraison.BnoCommande		= hfacture.fanumero
      BonLivraison.BStotal			= hfacture.fatotal
      BonLivraison.BTVH				= hfacture.fatps
      BonLivraison.bTauxTvh			= hfacture.fatps
      BonLivraison.btauxtvq			= hfacture.fatvq
      //		BonLivraison.bTauxTvh = config.tauxtps
      //		BonLivraison.bTauxTvq = config.tauxtvq
      
      
      SI hfacture.fatps = 0 OU hfacture.fatvq=0 ALORS
      	tableautaxe = trouvetauxtaxe(hfacture.faclient, datesys())
      	SI Dimension(tableautaxe) >= 4 ALORS
      		BonLivraison.bTauxTaxe1 = tableautaxe[1,2]
      	FIN
      	SI Dimension(tableautaxe) = 8 ALORS
      		BonLivraison.bTauxTaxe2			= tableautaxe[2,2]
      		BonLivraison.bCalculTaux2sur1	= tableautaxe[2,4]
      	FIN
      SINON
      	BonLivraison.bTauxTaxe1			= hfacture.fatps
      	BonLivraison.bTauxTaxe2			= hfacture.fatvq
      	BonLivraison.bCalculTaux2sur1	= lcombinetaxe
      FIN
      
      
      
      
      BonLivraison.brien		= NumériqueVersChaîne(hfacture.fatypedocument)
      
      BonLivraison.cvendeur	= hfacture.cvendeur
      HAjoute(BonLivraison)
      
      POUR TOUT hfacture AVEC "bnumero = " + BonLivraison.Bnumero
      	POUR TOUT Fcoutant AVEC "cNoCommande = "+ hfacture.fanumero
      		Fcoutant.CdateLivraison	= BonLivraison.Bdate
      		Fcoutant.CNoBlivraison	= BonLivraison.Bnumero
      		HModifie(Fcoutant,hNumEnrEnCours)
      	FIN
      	POUR TOUT FcoutantLigne AVEC "cNoCommande = "+ hfacture.fanumero
      		FcoutantLigne.CdateLivraison	= BonLivraison.Bdate
      		FcoutantLigne.CNoBlivraison		= BonLivraison.Bnumero
      		HModifie(FcoutantLigne,hNumEnrEnCours)
      	FIN
      FIN	
      
      HTransactionFin(gConnexionHF)
      
      SI HErreurDoublon() ALORS
      FIN
      
      si hlitrecherche(client,numero,noclient) alors
      	SI SansEspace(client.ccourrielBonLivraison[1]) = "" ET SansEspace(client.ccourrielBonLivraison[2]) = "" ET SansEspace(client.ccourrielBonLivraison[3]) = "" ... 
      		ET SansEspace(client.ccourrielBonLivraison[4]) = "" ALORS
      		nDestination = 2
      		
      	fin
      	
      FIN
      SI nDestination = 1 ALORS
      	lNbCopieBlivraison = gclConfig.m_nNbcopieBlivraison
      SINON
      	lNbCopieBlivraison = gclConfig.m_nNbCopieBlivraisonCourriel
      FIN
      HExécuteRequête(RequeteBlEtat,hRequêteDéfaut,BonLivraison.Bnumero)
      
      
      SI nDestination =1 OU nDestination = 2 ALORS
      	iFenêtreAbandon(Faux)
      	FenAttentePetite.libelle1 = "Impression du Bon de livraison "+BonLivraison.Bnumero
      	Multitâche(50)
      	
      	iConfigure(SansEspace(imprimantebon),Vrai)
      	
      	iParamètre("DEFAUT=NON")
      	//			iParamètre("COPIES="+lnbcopieBlivraison)
      	iParamètre("QUALITE=HAUTE")
      	//			iimprimeetat(BonLivraisontrn)
      	iImprimeEtat(BonLivraisonMultiple,lNbCopieBlivraison,RequeteBlEtat.Abreviation)
      	
      FIN
      
      SI nDestination =2  ALORS
      	FenAttentePetite.libelle1 = "Préparation du fichier PDF en cours ....."
      	iFenêtreAbandon(Faux)
      	Sablier(Vrai)
      	Multitâche(100)
      	SI HLitRecherche(client,numero,BonLivraison.Bclient) ALORS
      		POUR i = 1 À 4
      			SI SansEspace(client.ccourrielBonLivraison[i]) <> "" ALORS
      				lAdresseCourriel += SansEspace(client.ccourrielBonLivraison[i])+";"
      			FIN
      		FIN
      		SI client.CLangue = 1 ALORS
      			lSujet		= SansEspace(gclConfig.m_tabSujetFrancais[2]) //+" "+bonlivraison.Bnumero
      			lMessage	= gclConfig.m_tabTexteFrancais[2]
      		SINON
      			lSujet		= SansEspace(gclConfig.m_tabSujetAnglais[2])//+" "+bonlivraison.Bnumero
      			lMessage	= gclConfig.m_tabTexteAnglais[2]
      		FIN	
      	FIN
      	
      	lnomfichier = ComplèteRep(repdonnees)+"PDF\"+SansEspace(BonLivraison.Bclient)+"\BonLivraison\BdeL"+BonLivraison.Bnumero+".pdf"+";"
      	iConfigure(SansEspace(imprimantefacture),Vrai)
      	iParamètre("DEFAUT=NON")
      	iParamètre("FORMATPAPIER=LETTRE")
      	iDestination(iPDFGénérique,lnomfichier)
      	iImprimeEtat(BonLivraisonTRN)
      	FenAttentePetite.libelle1	= "Préparation du fichier PDF BdeL"+BonLivraison.Bnumero+" en cours..."
      	Sablier(Faux)
      	
      	
      FIN
      
      ferme(FenAttentePetite)
      
      CAS EXCEPTION:
      htransactionAnnule(gConnexionHF)
      info(ExceptionInfo(errMessage)) 
     type : 458752
   -
     name : majhistorique
     procedure_id : 1793128402442363882
     type_code : 14
     code : |1-
      Procédure majhistorique(numeroenregistrement,ShippingBillNumber)
      hgereintegrite(faux)
      
      multiplicateur est un entier
      hlit(config,1)
      hlit("Facture",numeroenregistrement)
      si facture.fatypedocument  = 2 alors
      	multiplicateur = -1
      sinon
      	multiplicateur = 1	
      FIN
      hfacture.ftransfere      = faux
      hfacture.fanumero        = facture.fanumero
      hfacture.fadate          = facture.fdaterequise
      hfacture.fadatecommande  = facture.fadate
      hfacture.fatype          = facture.fatype
      hfacture.faclient        = facture.faclient
      hfacture.bnumero         = ShippingBillNumber
      hfacture.fanofacture     = ShippingBillNumber
      hfacture.fanojob         = facture.fanojob
      hfacture.fanocommande    = facture.fanocommande
      hfacture.fasecteur       = facture.fasecteur
      hfacture.facalcul        = facture.facalcul
      hfacture.fasurcharge     = facture.fasurcharge 
      hfacture.fatotal         = facture.fatotal     
      hfacture.fatps           = facture.fatps       
      hfacture.fatvq           = facture.fatvq   
      hfacture.fatypedocument  = Facture.fatypedocument
      hfacture.fareference     = Facture.fareference
      hfacture.fabonlivraison  = facture.fabonlivraison
      hfacture.NoLot           = facture.nolot
      hfacture.fafraistransport= Facture.fafraistransport * multiplicateur
      hfacture.fsurchargepeinture = facture.fsurchargepeinture
      hfacture.NoGlSurchargePeinture = facture.NoGlSurchargePeinture
      hfacture.idlivraison        = facture.idLivraison
      hfacture.SUrchargePeinture = facture.SUrchargePeinture
      hfacture.fpeinture = facture.fpeinture
      hfacture.idlivraison = facture.idLivraison
      hfacture.nom 			 = facture.nom
      hfacture.adresse		 = facture.adresse
      hfacture.Ville 			 = facture.ville
      hfacture.CodePostal		 = facture.CodePostal
      hfacture.noTelephone	 = facture.noTelephone
      hfacture.ftypecredit     = facture.Ftypecredit
      hfacture.cvendeur        = facture.cvendeur
      hfacture.lnom 			 = facture.lNom
      hfacture.lRue 			 = facture.lRue
      hfacture.lVille 		 = facture.lVille
      hfacture.lcodepostal 	 = facture.lCodePostal
      hfacture.lAdresseManuelle=facture.lAdresseManuelle
      hfacture.lnote            = facture.lnote
      hfacture.IdPurchaseOrderEdi = facture.IdPurchaseOrderEdi
      hfacture.IdEdiKey           = facture.IdEdiKey
      hfacture.IDCamions    = facture.IDCamions
      //hfacture.surchargeTauxPourc = facture.surchargeTauxPourc
      SI gclconfig.m_bSUrchargeTauxActive alors
      	si hlitrecherche(client,numero,hfacture.faclient) _et_ Client.SUrchargeTaux ALORS
      		SI Client.CSurchargeTauxBase <> 0 ALORS
      			hfacture.surchargeTauxPourc = Client.CSurchargeTauxBase
      		SINON
      			hfacture.surchargeTauxPourc = gclconfig.m_rSurChargeTauxBase
      		FIN	
      	SINON
      			hfacture.surchargeTauxPourc = 0
      	FIN
      fin
      hajoute("hfacture")
      //Code WinDev 5.5 remplacé par la migration :
      //si hdoublon() alors
      si HErreurDoublon() alors
      	erreur("Impossible d'ajouter la facture "+numeriqueverschaine(facture.fanofacture,"10d"))
      	renvoyer vrai
      FIN
      
      
      hlitrecherche("fdetail","fdnocomm",facture.fanumero)
      
      //Code WinDev 5.5 remplacé par la migration :
      //tantque fdetail.fdnocomm = facture.fanumero et pas h.endehors
      tantque fdetail.fdnocomm = facture.fanumero et pas HEnDehors()
      	si fdetail.fdqteafacturer <> 0 alors  
      		hfdetail.fdnocomm       = facture.fanumero
      		hfdetail.fdligne        = fdetail.fdligne
      		hfdetail.fdnumprod      = fdetail.fdnumprod
      		hfdetail.fddesc         = fdetail.fddesc
      		hfdetail.fdqte          = fdetail.fdqte
      		hfdetail.fdqteafacturer = fdetail.fdqteafacturer  * multiplicateur
      		hfdetail.fdqtedejafacture = fdetail.fdqtedejafacture  * multiplicateur
      		
      		hfdetail.fdespace       = fdetail.fdespace
      		hfdetail.fdlargeur      = fdetail.fdlargeur
      		hfdetail.fdhauteur      = fdetail.fdhauteur
      		hfdetail.fdhauteur1     = fdetail.fdhauteur1
      		hfdetail.fdlargeura     = fdetail.fdlargeura
      		hfdetail.fdhauteura     = fdetail.fdhauteura
      		hfdetail.fdhauteur1a    = fdetail.fdhauteur1a
      		hfdetail.fdprixu        = fdetail.fdprixu
      		hfdetail.fdcarrelage    = fdetail.fdcarrelage
      		hfdetail.fdcarreauh     = fdetail.fdcarreauh
      		hfdetail.fdcarreauv     = fdetail.fdcarreauv
      		hfdetail.fdnumcarr      = fdetail.fdnumcarr
      		hfdetail.ftype          = fdetail.ftype
      		hfdetail.fdprixtotal    = fdetail.fdprixtotal
      		hfdetail.fdcarrpruxuc   = fdetail.fdcarrpruxuc
      		hfdetail.frcarrprixu    = fdetail.frcarrprixu * multiplicateur
      		hfdetail.fdcarrprixtotal= fdetail.fdcarrprixtotal * multiplicateur
      		hfdetail.fdprixupied    = fdetail.fdprixupied
      		hfdetail.fdcodegl       = fdetail.fdcodegl
      		hfdetail.fcapgaztube    = fdetail.fcapgaztube 
      		hfdetail.fdverreunite   = fdetail.fdverreunite
      		hfdetail.fdnofact       = Numerodebon
      		hfdetail.FDJOBLIGNE      = fdetail.FDJOBLIGNE
      		hfdetail.fdcomposant1    =fdetail.fdcomposant1
      		hfdetail.fdcomposant2    =fdetail.fdcomposant2
      		hfdetail.fdcomposant3    =fdetail.fdcomposant3
      		hfdetail.fdcarrprixdebase=fdetail.fdcarrprixdebase * multiplicateur
      		hfdetail.surchargeenergie=fdetail.surchargeenergie  * multiplicateur
      		hfdetail.fdcommentaire   = fdetail.fdcommentaire
      		hfdetail.fdlargeuru      = fdetail.fdlargeuru
      		hfdetail.fdhauteuru      = fdetail.fdhauteuru
      		hfdetail.fdforme         = fdetail.fdforme
      		hfdetail.fdextraforme    = fdetail.fdextraforme //* MULTIPLICATEUR
      		hfdetail.HFCLEUNIK       = hfacture.HFCLEUNIK
      		hfdetail.ffini           = fdetail.ffini 
      		hfdetail.fdhauteuranglais=Fdetail.fdhauteuranglais
      		hfdetail.fdhauteuranglais1=Fdetail.fdhauteuranglais1
      		
      		hfdetail.fdlargeuranglais=fdetail.fdlargeuranglais
      		hfdetail.fdpiedcarre     = fdetail.fdpiedcarre
      		hfdetail.fdpiedcarrefacture=fdetail.fdpiedcarrefacture
      		hfdetail.ftypespacer       = fdetail.ftypespacer
      		hfdetail.FDespace2         = fdetail.FDespace2
      		hfdetail.fdprixupiedfacture=fdetail.fdprixupiedfacture
      		hfdetail.fdextracap       = fdetail.fdextracap //* MULTIPLICATEUR 
      		hfdetail.fnotes           = fdetail.fnotes
      		hfdetail.fnotes1           = fdetail.fnotes1
      		hfdetail.fdvariablex       = fdetail.fdvariablex
      		hfdetail.fdvariablex1       = fdetail.fdvariablex1
      		hfdetail.fdtypecalcul     = fdetail.fdtypecalcul
      		hfdetail.fdnbcarreau       = fdetail.fdnbcarreau
      		hfdetail.fTypePeinture         = fdetail.fTypePeinture
      		hfdetail.fNoPeintureExtTout     = fdetail.fNoPeintureExtTout
      		hfdetail.FnopeintureInterieure     = fdetail.FnopeintureInterieure
      		hfdetail.fdescpeintureExtTout    = fdetail.fdescpeintureExtTout
      		hfdetail.fDescPeintureInterieure    = fdetail.fDescPeintureInterieure
      		hfdetail.fTotalPeinture             = fdetail.fTotalPeinture
      		hfdetail.fPrixCarreauPeinture      = fdetail.fPrixCarreauPeinture
      		hfdetail.Ftotalcarreaupeinture     = fdetail.Ftotalcarreaupeinture
      		hfdetail.fpeinture                  = fdetail.fpeinture
      		hfdetail.libelleNbCarreauExtTlt     = fdetail.libelleNbCarreauExtTlt
      		hfdetail.libelleNbcarreauinterieur     = fdetail.libelleNbcarreauinterieur
      		hfdetail.FtotalbarrePeinture     = fdetail.FtotalbarrePeinture
      		hfdetail.fnopeinture = fdetail.fnopeinture
      		hfdetail.fdescpeinture = fdetail.fdescpeinture
      		hfdetail.fextrapeinture = fdetail.fextrapeinture
      		hfdetail.fdescpeinture1 = fdetail.fdescpeinture1
      		hfdetail.fTypePeinture1     = fdetail.fTypePeinture1
      		hfdetail.fnopeinture1 = fdetail.fnopeinture1
      		hfdetail.FDnbcarreauPeinture1 = fdetail.FDnbcarreauPeinture1
      		hfdetail.fdprixcarreaupeinture1 = fdetail.fdprixcarreaupeinture1
      		hfdetail.fdfabrication = fdetail.FDfabrication
      		hfdetail.SUrchargeafacturer = fdetail.SUrchargeafacturer
      		hfdetail.surchargeenergie = fdetail.SUrchargeafacturer
      		hfdetail.SUrchargedejafacture = fdetail.SUrchargedejafacture
      		hfdetail.FDextra10X=fdetail.FDextra10x
      		hfdetail.FDextra5X=fdetail.FDextra5x
      		hfdetail.TDemiCarrelage = fdetail.TDemiCarrelage
      		hfdetail.FDextraCarrelagedemi = fdetail.FDextraCarrelagedemi
      		hfdetail.fdpiedcarrefacture = Fdetail.fdpiedcarrefacture
      		hfdetail.fdsurfacemodifie = fdetail.fdsurfacemodifie
      		hfdetail.FDprixmodifie = fdetail.FDprixmodifie
      		hfdetail.IDPurchaseOrderItemEdi = Fdetail.IDPurchaseOrderItemEdi
      		hfdetail.fdligneEdi = fdetail.fdligneedi
      		hfdetail.ExtraArgonPrice = fdetail.ExtraArgonPrice
      		hfdetail.CalculArgon = fdetail.CalculArgon
      		hfdetail.PietageArgon = fdetail.PietageArgon
      		hfdetail.fdbase = Fdetail.fdbase
      		hfdetail.ExceptionForShippingBill = fdetail.ExceptionForShippingBill
      		hfdetail.fnolot = fdetail.fnolot
      		hajoute("hfdetail")
      		
      		
      		
      	fin
      	hlitsuivant("fdetail","fdnocomm")
      	
      FIN
      
      hgereintegrité(vrai)
     type : 458752
   -
     name : epurefactureNewBol
     internal_properties : CQAAAAkAAABdgoBVUIapPw79aBnZZXdFu7XR/+qcNCKC0djLwMkrEzUExKp+jSPktr2FSpDUiQqQO9NpzERFvVVeNVEo/VG3GWgtnZox
     procedure_id : 1793129093933307661
     type_code : 14
     code : |1+
      Procédure epurefactureNewBol(numeroenregistrement,nShippingBillNumber)
      
      lcombinetaxe est un booleen = faux
      majhistorique(numeroenregistrement,nShippingBillNumber)
      toutelafacture = vrai
      
      hlit("Facture",numeroenregistrement)
      hlitrecherche("fdetail","fdnocomm",facture.fanumero)
      
      tantque fdetail.fdnocomm = facture.fanumero et pas HEnDehors()
      	fdetail.fdqtedejafacture =  fdetail.fdqtedejafacture + fdetail.fdqteafacturer
      	fdetail.fdqteafacturer = fdetail.fdqte - fdetail.fdqtedejafacture
          fdetail.SUrchargedejafacture = fdetail.SUrchargedejafacture+fdetail.SUrchargeafacturer
          fdetail.SUrchargeafacturer = fdetail.surchargeenergie- fdetail.SUrchargedejafacture
      	si fdetail.fdqteafacturer <> 0 alors
      		toutelafacture = faux
      	fin
      	
      	hmodifie("fdetail")
      	hlitsuivant("fdetail","fdnocomm")
      FIN
      lcombinetaxe = facture.fCombineTaxe
      si toutelafacture alors
      	facture.FPREPARATION = "B"
      	facture.livrepartiel = ""
      	hmodifie(Facture,hNumEnrEnCours)
      sinon
          facture.livrepartiel = "P"
      	facture.faimprimer = 0
      	hmodifie(facture,hNumEnrEnCours)	
      FIN
      
      renvoyer lcombinetaxe
      
     type : 458752
   -
     name : CreateGroupBOL
     internal_properties : CQAAAAkAAACFj0VbjkDxjIwCqvZaBxKCrAkKtYYPxP1iF62knHDQpFOhHlozW58FO3p6r6WJ7rSL8LB+hof2jV7cQbLD+BRGi4Er/ym691r2Dmfx8UipUKcNll+fypJ9Iq9KNLzJwINTW38wqi69RIgfgPYVXxf6Evzh9gI=
     procedure_id : 1844748016480462001
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //CreateGroupBOL (<nShippingBillNumber> est entier)
      //
      // Paramètres :
      //	nShippingBillNumber (entier) : <indiquez ici le rôle de nShippingBillNumber>
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //// Traitement automatique des exceptions :   exécuter le bloc de code CAS EXCEPTION:
      //
      
      procédure CreateGroupBOL(nShippingBillNumber est une entier)
      clCurrentCustomer			est un cCustomerOrderToPrint
      clCurrentOrder				est un cordertoprint
      clCurrentOrderDetail		est un corderdetail
      tabCurrentCustomerOrder est un tableau de cCustomerOrderToPrint
      
      
      
      pour chaque ligne de  Table_BlFacture 
      	si HLitRecherche(Facture,fanumero,Table_BlFacture.fanumero) alors
      		
      		clCurrentCustomer.m_nCustomerID			= client.IDClient
      		clCurrentCustomer.m_nShippingCustomerID	= facture.idLivraison
      		clCurrentOrder							= allouer un cOrderToPrint()
      		clCurrentOrder.m_nOrderNumber			= Table_BlFacture.fanumero
      		clCurrentOrder.m_sCustomerNumberJob		= Facture.fanojob
      		clCurrentOrder.m_sCustomerOrderNumber	= Facture.fanocommande
      		clCurrentOrder.m_dOrderRequiredDate		= Facture.fadate
      		HLitRecherche(Fdetail,fdnocomm,Table_BlFacture.fanumero)
      		TANTQUE Fdetail.fdnocomm = Table_BlFacture.fanumero
      			SI Fdetail.ftype <> 4 ALORS
      				clCurrentOrderDetail					= allouer un cOrderDetail()
      				clCurrentOrderDetail.m_nLineNumber		= Fdetail.fdligne
      				clCurrentOrderDetail.m_nQtyProduced		= Fdetail.fdqteafacturer
      				
      				clCurrentOrderDetail.m_sProductNumber	= Fdetail.fdnumprod
      				clCurrentOrder.m_tabOrderDetail.Ajoute(clCurrentOrderDetail)
      			FIN
      			HLitSuivant(Fdetail,fdnocomm)
      		FIN
      		
      		clCurrentCustomer.m_tabOrder.Ajoute(clCurrentOrder)
      	FIN
      	
      FIN
      
      tabCurrentCustomerOrder.ajoute(clCurrentCustomer)
      PrintBatchShippingBills(tabCurrentCustomerOrder,nShippingBillNumber)
      
      
      CAS EXCEPTION:
     type : 458752
   -
     name : GetOrderDetail
     internal_properties : CQAAAAkAAADjWI494CoY9EtrzmJuNDEQUaz5InpIpb1Tfw4rVb/U7FyqeWiZQ3jIQBPOk37zgpCkM1NFgYBHi4zrK9ALT8G07wmnuQVMiks=
     procedure_id : 1844876513451321625
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] GetOrderDetail (<nBillNumber> est entier, <nOrderNumber> est entier)
      //
      // Paramètres :
      //	nBillNumber (entier) : <indiquez ici le rôle de BillNumber>
      //	nOrderNumber (entier) : <indiquez ici le rôle de nOrderNumber>
      // Valeur de retour :
      // 	tableau (cOrderDetail) : <indiquez ici le rôle de la valeur de retour>
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure GetOrderDetail(nBillNumber est un entier , nOrderNumber est une entier)
      
      tabOrderDetail est un tableau de cOrderDetail
      clCurrentOrderdetail est un cOrderDetail
      
      
      
      
      sTxtsql est une chaine = [
      	SELECT 
      	hfdetail.H0CLEUNIK AS H0CLEUNIK,	
      	hfdetail.fdligne AS fdligne,	
      	hfdetail.fdnocomm AS fdnocomm,	
      	hfdetail.fdnumprod AS fdnumprod,	
      	hfdetail.fddesc AS fddesc,	
      	hfdetail.fdqte AS fdqte,	
      	hfdetail.fdqteafacturer AS fdqteafacturer,	
      	hfdetail.fdqtedejafacture AS fdqtedejafacture,	
      	hfdetail.fdlargeur AS fdlargeur,	
      	hfdetail.fdlargeura AS fdlargeura,	
      	hfdetail.fdhauteur AS fdhauteur,	
      	hfdetail.fdhauteura AS fdhauteura,	
      	hfdetail.fdhauteur1 AS fdhauteur1,	
      	hfdetail.fdhauteur1a AS fdhauteur1a,	
      	hfdetail.fdprixu AS fdprixu,	
      	hfdetail.fdlien AS fdlien,	
      	hfdetail.fdnumcarr AS fdnumcarr,	
      	BonLivraison.bTauxTvh AS bTauxTvh,	
      	hfacture.NoLot AS NoLot,	
      	BonLivraison.btauxtvq AS btauxtvq,	
      	BonLivraison.bTauxTaxe1 AS bTauxTaxe1,	
      	BonLivraison.bTauxTaxe2 AS bTauxTaxe2,	
      	BonLivraison.bCalculTaux2sur1 AS bCalculTaux2sur1,	
      	BonLivraison.cvendeur AS cvendeur,	
      	hfdetail.surchargeTauxafacturer AS surchargeTauxafacturer,	
      	hfdetail.SUrchargeTaux AS SUrchargeTaux,	
      	hfacture.surchargeTauxChange AS surchargeTauxChange,	
      	hfacture.surchargeTauxPourc AS surchargeTauxPourc,	
      	hfacture.lNote AS lNote,	
      	hfdetail.fdhauteuranglais1 AS fdhauteuranglais1,
      	hfdetail.SUrchargeafacturer,
      	hfdetail.surchargeenergie,	
      	hfacture.IDCamions AS idcamions,	
      	Camions.Abreviation AS Abreviation
      	FROM 
      	(
      	(
      	BonLivraison
      	INNER JOIN
      	hfacture
      	ON BonLivraison.Bnumero = hfacture.Bnumero
      	)
      	LEFT OUTER JOIN
      	Camions
      	ON hfacture.IDCamions = Camions.IDCamions
      	)
      	INNER JOIN
      	hfdetail
      	ON hfacture.HFCLEUNIK = hfdetail.HFCLEUNIK
      	WHERE 
      	(
      	BonLivraison.Bnumero	= {pNoBon} AND
      	hfdetail.fdnocomm = {pOrderNumber} AND
      	hfdetail.ftype			= 1
      	)
      	ORDER BY 
      	fdnocomm ASC,	
      	fdligne ASC
      ]
      
      sdReqsql est une source de donnees
      sdReqsql.pNoBon = nBillNumber
      sdReqsql.pOrderNumber = nOrderNumber
      sTxtSqlOriginal est une chaine = [
      	SELECT 
      	
      	fdetail.fdligne AS fdligne,	
      	fdetail.fdnocomm AS fdnocomm,	
      	fdetail.fdnumprod AS fdnumprod,	
      	fdetail.fddesc AS fddesc,	
      	fdetail.fdqte AS fdqte,	
      	fdetail.fdqteafacturer AS fdqteafacturer,	
      	fdetail.fdqtedejafacture AS fdqtedejafacture,	
      	fdetail.fdlargeur AS fdlargeur,	
      	fdetail.fdlargeura AS fdlargeura,	
      	fdetail.fdhauteur AS fdhauteur,	
      	fdetail.fdhauteura AS fdhauteura,	
      	fdetail.fdhauteur1 AS fdhauteur1,	
      	fdetail.fdhauteur1a AS fdhauteur1a,	
      	fdetail.fdprixu AS fdprixu,	
      	fdetail.fdlien AS fdlien,	
      	fdetail.fdnumcarr AS fdnumcarr
      	
      	from fdetail
      	where fdetail.fdnocomm = {OrderNumber} and fdetail.ftype			= 1
      	order by fdligne
      	
      ]
      
      sdReqsqloriginal est une source de donnees
      sdReqsqloriginal.OrderNumber = nOrderNumber
      si HExécuteRequêteSQL(sdReqsqloriginal,hRequêteDéfaut,sTxtSqlOriginal) alors
      	pour TOUT sdReqsqloriginal 	
      		clCurrentOrderdetail = allouer un corderdetail()
              clCurrentOrderdetail.m_sProductNumber = sdReqsqloriginal.fdnumprod
              clCurrentOrderdetail.m_sProductdescription = sdReqsqloriginal.fddesc
              clCurrentOrderdetail.m_sWidth = sdReqsqloriginal.fdlargeur
              clCurrentOrderdetail.m_sheight = sdReqsqloriginal.fdhauteur
              clCurrentOrderdetail.m_sGridNumber = sdReqsqloriginal.fdnumcarr
              clCurrentOrderdetail.m_nQty = sdReqsqloriginal.fdqte
       
              clCurrentOrderdetail.m_nlinenumber = sdReqsqloriginal.fdligne
                     
      	    tabOrderDetail.ajoute(clCurrentOrderdetail)
      	fin
      FIN
      
      nRes est un entier
      
      si HExécuteRequêteSQL(sdReqsql,hRequêteDéfaut,sTxtsql) alors
      	pour tout sdReqsql
      		nRes = tableaucherche(tabOrderDetail,tcLinéaire,"m_nLineNumber",sdReqsql.fdligne)  
      		si nRes <> -1 alors
      			tabOrderDetail[nRes].m_nQtyProduced = sdReqsql.fdqteafacturer
      			tabOrderDetail[nRes].m_nAlreadyInvoiceQty = sdReqsqloriginal.fdqtedejafacture
      			tabOrderDetail[nRes].m_nModifiedQty = sdReqsql.fdqteafacturer
      		fin
      	fin	
      FIN
      
      tableselectmoins(TableLigne)
      
      renvoyer tabOrderDetail
      
      
      
     type : 458752
   -
     name : ShowOrderdetail
     procedure_id : 1844883115117484891
     type_code : 14
     code : |1-
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //ShowOrderdetail (<nOrderNumber> est entier)
      //
      // Paramètres :
      //	nOrderNumber (entier) : <indiquez ici le rôle de nOrderNumber>
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure ShowOrderdetail(nOrderNumber est un entier)
      TableLigne.supprimetout()
      pour chaque clOrderLine de gtaOrderdetail[nOrderNumber].m_tabOrderDetail
      	TableAjouteLigne(TableLigne,clOrderLine.m_sProductNumber,clOrderLine.m_sProductdescription,clOrderLine.m_sWidth,clOrderLine.m_sHeight,clOrderLine.m_sGridNumber,...
      	clOrderLine.m_nQty,clOrderLine.m_nModifiedQty...
      	,0,clOrderLine.m_nLineNumber,clOrderLine.m_nQty,0,clOrderLine.m_nAlreadyInvoiceQty)
      FIN
     type : 458752
