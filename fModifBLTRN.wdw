  -
    name : BTN_Save
    identifier : 0x284884ebb68b78ce
    internal_properties : 
    properties :
     x : 682
     y : 234
     width : 25
     height : 25
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         
         lNoRec		est un entier
         lnocomm		est un entier = Table_BlFacture.NoCommande[Table_BlFacture]
         lnoligne	est un entier = TableLigne.LIGNE
         SuppressBOL()
         //Pour chaque ligne de TableLigne
         POUR CHAQUE clOrder,keyOrder de gtaOrderdetail
         	POUR CHAQUE clOrderDetail de clOrder.m_tabOrderDetail
         		si HLitRecherche(Fdetail,fdnocommfdligne,[keyOrder,clOrderDetail.m_nLineNumber]) alors
         
         			Fdetail.fdqteafacturer	=  clOrderDetail.m_nModifiedQty
         			lnoligne				= clOrderDetail.m_nLineNumber
         		lNoRec					= HSauvePosition(Fdetail)
         		SI Fdetail.fdqteafacturer <> Fdetail.fdqte-Fdetail.fdqtedejafacture ALORS
         			Fdetail.SUrchargeafacturer = Arrondi(Fdetail.surchargeenergie * (Fdetail.fdqteafacturer/Fdetail.fdqte),2)
         		SINON
         			Fdetail.SUrchargeafacturer = Fdetail.surchargeenergie - Fdetail.SUrchargedejafacture
         		FIN
         		HModifie(Fdetail,hNumEnrEnCours)
         		POUR TOUT Fdetail AVEC "fdnocomm = "+lnocomm+ "et fdlien= "+lnoligne
         				Fdetail.fdqteafacturer= clOrderDetail.m_nModifiedQty
         			SI Fdetail.fdqteafacturer <> Fdetail.fdqte-Fdetail.fdqtedejafacture ALORS
         				Fdetail.SUrchargeafacturer = Arrondi(Fdetail.surchargeenergie * (Fdetail.fdqteafacturer/Fdetail.fdqte),2)
         			SINON
         				Fdetail.SUrchargeafacturer = Fdetail.surchargeenergie - Fdetail.SUrchargedejafacture
         			FIN
         			
         			HModifie(Fdetail,hNumEnrEnCours)
         		FIN
         		HRetourPosition(lNoRec)	
         
         	FIN
         FIN
         FIN
         
         creategroupBol(numerodebon)
         
         ferme(mafenetre)
         
         
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_cancel
    identifier : 0x2848850fb68d036a
    internal_properties : 
    properties :
     x : 651
     y : 234
     width : 25
     height : 25
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         si ouinon("Voulez-vous annuler les modification en cours (O/N)") = oui alors
         	fiche..etat = Actif
         	GR_Modif..etat = grise
         	Pour chaque clOrder de gtaOrderdetail
         		pour chaque clOrderDetail de clOrder.m_tabOrderDetail
         			clOrderDetail.m_nModifiedQty = clOrderDetail.m_nQtyProduced
         		FIN
         	FIN
         	TableAffiche(Table_BlFacture)
         FIN
        type : 18
      -
        type : 161
        enabled : false
