  -
    name : BTN_EnvoiCourriel
    identifier : 0x481a19374f85bdd7
    internal_properties : 
    properties :
     x : 318
     y : 10
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         //hexecuterequete(RequeteBlEtat,hRequêteDéfaut,numerodebon)
         //iconfigure(sansespace(imprimantefacture),vrai)
         //iParamètre("DEFAUT=NON")
         //iParamètre("QUALITE=HAUTE")
         //iParamètre("COPIES="+CONFIG.nbcopieBlivraison)
         //selon gFormatFacture
         //	cas 1
         //		iimprimeetat(bonlivraison)
         //	cas 2
         //		iimprimeetat(bonlivraisontrn)
         
         //FIN
         
         numerofacture est un entier 
         lAdresseCourriel est une chaine
         lNumeroClient est une chaine
         ListeFichier est une chaine
         ListeNoFacture est une chaine
         lSujet est une chaine
         lMessage est une chaine 
         lCommandeTransferee est une chaine
         sablier(vrai)
         hexecuterequete(RequeteBlEtat,hRequêteDéfaut,numerodebon)
         multitache(300)
         
         
         si HLitRecherche(client,numero,noclient) alors
         	lAdresseCourriel = sansespace(client.ccourrielBonLivraison[1])
         	si client.CLangue = 1 alors
         		lSujet = SANSESPACE(gclconfig.m_tabSujetFrancais[2]) //+" "+bonlivraison.Bnumero
         		lMessage = gclConfig.m_tabTexteFrancais[2]
         	sinon
         		lSujet = SANSESPACE(gclConfig.m_tabSujetanglais[2])//+" "+bonlivraison.Bnumero
         		lMessage = gclConfig.m_tabTexteanglais[2]
         	fin	
         fin
         iconfigure(sansespace(imprimantepdf),vrai)
         iParamètre("DEFAUT=NON")
         iParamètre("QUALITE=HAUTE")
         iimprimeetat(BonLivraisontrn)
         sablier(vrai)
         multitache(500)
         si fFichierExiste(fExtraitChemin(gclconfig.m_sDossierFichierPDF, fDisque+fRépertoire)+"BdeL"+numerodebon+".pdf") alors
         	fSupprime(fExtraitChemin(gclConfig.m_sDossierFichierPDF, fDisque+fRépertoire)+"BdeL"+numerodebon+".pdf")
         FIN
         frenomme(sansespace(gclConfig.m_sDossierFichierPDF),...
         fExtraitChemin(gclConfig.m_sDossierFichierPDF, fDisque+fRépertoire)+"BdeL"+numerodebon+".pdf")
         ListeFichier+=fExtraitChemin(gclConfig.m_sDossierFichierPDF, fDisque+fRépertoire)+"BdeL"+numerodebon+".pdf"+";"
         ListeNoFacture+=sansespace(numerodebon)
         
         
         sablier(faux)
         ouvre(FenEmail,lAdresseCourriel,lSujet,lMessage,ListeFichier,noclient)
         
         
         
        type : 18
      -
        type : 161
        enabled : false
      -
        type : 66050
