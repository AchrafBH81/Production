  -
    name : BTN_Annule
    identifier : 0x47d012bc745d9ef7
    internal_properties : 
    properties :
     x : 106
     y : 10
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         si acso_message("Question","Voulez-vous supprimer entièrement le bon de commande numéro "+ numerodebon ,"OuiNon") = idyes alors
         
         	
         	pour TOUT RequeteblFacture 
         	si hlitrecherche(Facture,fanumero,RequeteBlFacture.fanumero) alors
         		facture.FPREPARATION = "F"
         		hmodifie(facture)
         		pour tout hfdetail avec "HFCLEUNIK= "+RequeteBlFacture.HFCLEUNIK
         			RequetefactureDetail.pNoComm =hfdetail.fdnocomm
         			RequetefactureDetail.pNoLigne = hfdetail.fdligne
         			HExécuteRequête(RequetefactureDetail,hModifieFichier)
         			pour tout RequetefactureDetail
         //			si hlitrecherche(fdetail,fdnocommfdligne,HConstruitValClé(fdetail,fdnocommfdligne,hfdetail.fdnocomm,hfdetail.fdligne)) alors
         				RequetefactureDetail.fdqtedejafacture-=hfdetail.fdqteafacturer
         				RequetefactureDetail.fdqteafacturer = RequetefactureDetail.fdqte-RequetefactureDetail.fdqtedejafacture
         				RequetefactureDetail.SUrchargedejafacture-=hfdetail.SUrchargeafacturer
         				RequetefactureDetail.SUrchargeafacturer = RequetefactureDetail.surchargeenergie - RequetefactureDetail.SUrchargedejafacture
                         
         				HModifie(RequetefactureDetail,hNumEnrEnCours)
         			fin
         		fin
         
         	fin
         	FIN
         
         	//		hlitsuivant(RequeteBlFacture,RequeteBlFacture.fanumero)
         	//	fin
         
         	si hlitrecherche(BonLivraison,Bnumero,numerodebon) alors
         		hsupprime(BonLivraison)
         	FIN
         	
         	POUR TOUT RequeteBlFacture 
         	si HLitRecherche(BonLivraison,BnoCommande,RequeteBlFacture.fanumero) ALORS
         		facture.livrepartiel = "P"
         		hmodifie(facture)
         	sinon
         		facture.livrepartiel = " "
         		hmodifie(facture)
         	FIN
         	fin
         	
         	acso_message("Message","Le bon de livraison # "+numerodebon+" à été complétement supprimé","Info")
         FIN
         
         ferme(fModifBLtrn)
        type : 18
      -
        type : 161
        enabled : false
