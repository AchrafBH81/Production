   -
     code : |1+
      procedure fModifBL(numerodebon,nomclient,Noclient="")
      
      gbSendbymail est un booleen = faux
      gtaOrderdetail	est un tableau associatif (*, *, wlEntier) de cordertoprint
      
      
      
      
   -
     code : |1+
      mafenetre..plan = 1
      lnumerobon = numerodebon
      lnomclient = nomclient
      si hlitrecherche(client,numero,NoClient) alors
      	pOUR I = 1 A 4
      		SI SANSESPACE(CLIENT.ccourrielBonLivraison[I]) <> "" alors
      			gbSendbymail = VRAI
      			SORTIR
      		FIN
      	FIN
      FIN
      gtaOrderdetail.supprimetout()
      hexecuterequete(RequeteBlFacture,hRequêteDéfaut,numerodebon)
      pour TOUT RequeteBlFacture 
      	gtaOrderdetail[requeteblfacture.fanumero].m_tabOrderDetail = GetOrderDetail(NumerodeBon,requeteblfacture.fanumero)
      	
      FIN
      Table_BlFacture..visible = vrai
      tableaffiche(Table_BlFacture)
      
     type : 34
