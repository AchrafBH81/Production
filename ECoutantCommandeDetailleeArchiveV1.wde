 controls : []
 code_elements :
  type_code : 13
  p_codes :
   -
     code : |1+
      procedure ECoutantCommandeSommaireDetaillee(lDateDebut = "20070419",ldatefin = "20070420",lNoClient = "",lnolotdebut = 0, lnolotfin=0)
      si ldatedebut <> "" alors
      	CDateDebut = ldatedebut
      	CDatefin = ldatefin
      	grpdate..visible = vrai
      	grplot..visible = faux
      
      sinon
      	CLotDebut = lNoLotdebut
      	CLotfin = lNoLotfin
      	grpdate..visible = faux
      	grplot..visible = vrai
      
      fin
      si lnoclient <> "" alors
      	LibelleClient = "Pour le client"
      	RNoClient..visible = faux
      FIN
      
     type : 327680
   -
     code : |1+
      si RequeteCoutantCommandeArchivev2.ctype = 4 alors
      	iSubstBloc(CORPS,ITERATION1)
      sinon
      	iSubstBloc(CORPS,"")
      
      FIN
