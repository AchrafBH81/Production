    code_elements :
     type_code : 30
     p_codes :
      -
        code : |1+
         HExécuteRequête(RequeteCoutantCommandeUneLigne,hRequêteDéfaut,RequeteCoutantCommandeArchivev2.cNoCommande,...
         RequeteCoutantCommandeArchivev2.cNoLigne)
         pour tout RequeteCoutantCommandeUneLigne
         	CoutantTotal+=arrondi(RequeteCoutantCommandeUneLigne.ccouttotal,2)
         	//	couttotal+=arrondi(RequeteCoutantCommandeUneLigne.ccouttotal,2)
         FIN
         si RequeteCoutantCommandeArchiveV2.Cdatelivraison <> "" alors
         	si hlitrecherche(hfdetail,fdcle,HConstruitValClé(hfdetail,fdcle,RequeteCoutantCommandeArchiveV2.CNoBlivraison,RequeteCoutantCommandeArchivev2.cNoCommande,...
         		RequeteCoutantCommandeArchivev2.cNoLigne))
         		lqte = hfdetail.fdqteafacturer
         		Lnumprod = hfdetail.fdnumprod
         		Ldesc = hfdetail.fddesc
         		llargeur = hfdetail.fdlargeur
         		lhauteur = hfdetail.fdhauteur
         
         	FIN
         sinon
         	si hlitrecherche(fdetail,fdcle,HConstruitValClé(fdetail,fdcle,RequeteCoutantCommandeArchivev2.cnocommande,...
         		RequeteCoutantCommandeArchivev2.cNoLigne))
         		lqte = fdetail.fdqteafacturer
         		Lnumprod = fdetail.fdnumprod
         		Ldesc = fdetail.fddesc
         		llargeur = fdetail.fdlargeur
         		lhauteur = fdetail.fdhauteur
         
         	FIN
         
         fin
