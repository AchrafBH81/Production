    properties :
     y : 35.77
     width : 205.9
     height : 5.821
    code_elements :
     type_code : 30
     p_codes :
      -
        code : |1+
         lNoGl est une chaine
         ldebitcredit est une chaine
         hlit(config,1)
         hexecuterequete(RequeteDetailCompta,hRequêteDéfaut,RequeteFactureTransfert.Bnumero)
         pour tout RequeteDetailCompta
         	si PrepFichier alors
         		CI.CLIENT = RequeteFactureTransfert.Bclient
         		CI.REFERENCE = "FAC"+sansespace(RequeteFactureTransfert.Bfacture)
         		CI.DATE = RequeteFactureTransfert.BDateFacture
         		CI.MONTANT = RequeteDetailCompta.MontantGlivre * -1
         	fin
         	si sansespace(RequeteDetailCompta.NoGlivre) = "" 
         		si requetedetailcompta.noLigne = 1 alors
         			lNoGl = config.NoGlrecevable
         		sinon
         			lNoGl = config.glventedefaut
         		fin
         		ldebitcredit = "D"
         		si PrepFichier alors
         			CI.TYPEGL = 99
         		fin
         
         	sinon
         		lNoGl = RequeteDetailCompta.NoGlivre
         		ldebitcredit = "C"
         		si PrepFichier alors
         			CI.TYPEGL = 88
         		fin
         
         	FIN
         	si PrepFichier alors
         
         		CI.COMPGL = lNoGl
         		//si ci.montant <> 0 alors
         		HAJOUTE(CI)
         		//fin
         	fin
         
         	si hlitrecherche(Transferttempo,nogl,sansespace(lNoGl)) alors
         		Transferttempo.Montant+=RequeteDetailCompta.MontantGlivre
         		hmodifie(Transferttempo,hNumEnrEnCours)
         	sinon
         		Transferttempo.nogl=sansespace(lNoGl)
         		Transferttempo.Montant=RequeteDetailCompta.MontantGlivre
         		Transferttempo.Debitcredit = ldebitcredit
         		hajoute(Transferttempo)
         	fin
         
         
         
         
         
         
         
         
         FIN
         
        type : 327693
      -
        type : 327697
        enabled : false
