 controls : []
 code_elements :
  type_code : 13
  p_codes :
   -
     code : |1+
      procedure etransfertfacture(ldatedebut="",ldatefin="",PrepFichier = faux)
      
      i est un entier = 1
      hlit(config,1)
      HCréation(Transferttempo)
      si PrepFichier alors
      //	si pas hinithf55(completerep(frepencours())+"forxbase.wdd") alors
      //		info(erreurinfo())
      //	FIN
      	HDBDecritFichier("CRIMPORT","CI",sansespace(config.DossierComptabilite)+"\crimport.dbf")
      	HDBDecritRubrique("CLIENT,C,10")
      	HDBDecritRubrique("REFERENCE,C,9")
      	HDBDecritRubrique("DATE,D")
      	HDBDecritRubrique("MONTANT,N,11,2")
      	HDBDecritRubrique("TYPEGL,N,2,0")
      	HDBDecritRubrique("COMPGL,C,6")
      	HDBDecritRubrique("COUTANT,N,15,4")
      	HDBCreation()
      
      	hdbouvre("crimport","CI",sansespace(config.DossierComptabilite)+"\crimport.dbf")
      fin
      
     type : 327680
 code_parameters :
