 code_elements :
  type_code : 13
  p_codes :
   -
     code : |1-
      Procedure _LISTE_UNITE_CARRELAGE_CLIENT(_pParam1="", _pParam2="", _pParam3="", _pParam4="")
      
      GLOBAL
      	numeroclient est une chaine = _pparam1
      
      si pas listeprix.nouvelleliste alors
      	GrpDateRempl..visible = faux
      	lvigueur..visible = faux
      	ldate..visible = vrai
      sinon
      	GrpDateRempl..visible = vrai
      FIN
      si pas gImprimeCondPMT alors
      	GrpCondPmt..visible=faux
      sinon
      	iSubstBloc(BLOC_HAUT,EnteteComposante)
      	iSubstBloc(BLOC_CORPS,DetailComposante)
      FIN
      HLit(config,1)
      //selon client.CLangue
      //	cas 1
      //		iMessage=config.textebaspageformelisteprix
      //	cas 2
      //		iMessage=config.TexteBasPageFormeListePrixAnglais
      //		
      //	AUTRE CAS
      //		iMessage=config.textebaspageformelisteprix
      //		
      //FIN
      listeprix.ListeImprimee = Faux
      assigneLibelle()
     type : 327680
   -
     code : |1+
      // Vérification de la condition
      SI HLitRecherche(invent,INUM,RequeteClientProduit.Idproruit) ET PAS invent.iactif ALORS RENVOYER Faux 
      SI pas (RequeteClientProduit.ITypeProduit = 4) ALORS RENVOYER FAUX
      si pas RequeteClientProduit.IlisteDePrix alors renvoyer faux
      RENVOYER VRAI		// Enregistrement accepté
      
     type : 327696
   -
     code : |1-
      
      lNombreenrImprime = monetat..NbEnrImprimé
     type : 327682
  procedures :
   -
     name : assigneLibelle
     procedure_id : 5275259669935539153
     type_code : 14
     code : |1-
      Procédure assigneLibelle()
      i est un entier
      
      lTableauLibelle est un tableau de  25 chaines
      lTableauLibelle[1]  = "lentete,lentete"
      lTableauLibelle[2]  = "lvigueur,lvigueur"
      lTableauLibelle[3]  = "lremplace,lremplace"
      lTableauLibelle[4]  = "faccarrelage,faccarrelage"
      lTableauLibelle[5]  = "lcarrelagesuite,lcarrelagesuite"
      lTableauLibelle[6]  = "faccarrelage,Faccarrelage1"
      lTableauLibelle[7]  = "lcarrelagesuite,lcarrelagesuite1"
      lTableauLibelle[8]  = "lnumero,lnumero"
      lTableauLibelle[9]  = "facdescription,facdescription"
      lTableauLibelle[10]  = "lprixcarreau,lprixcarreau"
      lTableauLibelle[11]  = "lprixcarreau,lprixcarreau1"
      lTableauLibelle[12]  = "lprix,lprixbase"
      lTableauLibelle[13]  = "lprix,lprixbase1"
      lTableauLibelle[14]  = "facpiedcarre,facpiedcarre"
      lTableauLibelle[15]  = "facmetrecarre,facmetrecarre"
      lTableauLibelle[16]  = "lvigueur,LVigueur"
      lTableauLibelle[17]  = "lvigueur,LVigueur1"
      lTableauLibelle[18]  = "lvigueur,LDate"
      lTableauLibelle[19]  = "lvigueur,LDate1"
      lTableauLibelle[20]  = "lremplace,lremplace"
      lTableauLibelle[21]  = "lremplace,lremplace1"
      lTableauLibelle[22]  = "lentete,lEntete1"
      lTableauLibelle[23]  = "facdescription,facdescription"
      lTableauLibelle[24]  = "lcondpaiement,LCondpaiement"
      lTableauLibelle[25]  = "lcondpaiement,LCondpaiement1"
      
      selon client.CLangue
      	cas 1
      		pour i = 1 a 25
      			si hlitrecherche(Traduction,TRecherche,extraitchaine(lTableauLibelle[i],1,",")) alors
      				{"ListeCarrelageClient."+ExtraitChaîne(lTableauLibelle[i],2,",")} = traduction.dFrancais
      			fin
      		FIN
      	cas 2
      		pour i = 1 a 25
      			si hlitrecherche(Traduction,TRecherche,extraitchaine(lTableauLibelle[i],1,",")) alors
      				{"ListeCarrelageClient."+ExtraitChaîne(lTableauLibelle[i],2,",")} = traduction.danglais
      			fin
      		FIN
      fin
     type : 458752
