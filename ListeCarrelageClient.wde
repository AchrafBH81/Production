        x : 22.5
        width : 99.5
        height : 4.764
       code_elements :
        type_code : 29
        p_codes :
         -
           code : |1+
            si hlitrecherche(invent,INUM,RequeteClientProduit.Idproruit) alors
            	si client.CLangue=1 alors moimeme = sansespace(invent.IDESC) sinon moimeme = sansespace(invent.idesca)
            sinon
            	si client.CLangue=1 alors moimeme = "Produit Inexistant" sinon moimeme = "Product not found"	
            FIN
           type : 327692
         -
           type : 327699
           enabled : false
     -
       name : RUBRIQUE6
       identifier : 0x49357cb92f8fc42f
       internal_properties : 
       properties :
        x : 141.577
        width : 20.
        height : 4.764
       code_elements :
        type_code : 29
        p_codes :
         -
           code : |1+
            si RequeteClientProduit.IPprixSpecial alors
            	si client.CalculCarrPied alors
            		piedcarre = RequeteClientProduit.IPrixCarrPiedCarre
            		metrecarre = RequeteClientProduit.IPrixCarrmetCarre
            	sinon
            		rubrique6 = RequeteClientProduit.iprixa
            		rubrique7 = RequeteClientProduit.iprixm
            	fin
            sinon
            	si hlitrecherche(invent,INUM,RequeteClientProduit.Idproruit) alors
            		rubrique6 = invent.iprixcarreau
            		rubrique7 = invent.iprixbasecarrelage
            		piedcarre = 0
            		metrecarre = 0
            	sinon
            		moimeme = 0
            		rubrique6 = 0
            		rubrique7= 0
            		piedcarre = 0
            		metrecarre = 0
            	fin
            
            FIN
            
           type : 327692
