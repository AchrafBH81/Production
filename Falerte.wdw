         		cbOperateurEgalite3[9]..Etat = Actif
         		cbOperateurEgalite3[10]..Etat = grise
         		
         		Liste_intercalaire3..Visible = Faux
         		BTN_Intercalaire3..Visible = Faux	
         		
         	CAS 15
         		
