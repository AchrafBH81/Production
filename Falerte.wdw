  -
    name : cbAction1
    identifier : 0x2681b9ff1c089234
    internal_properties : 
    properties :
     x : 119
     y : 261
     width : 299
     height : 24
    dropdown :
     internal_properties : 
     type : 7
    type : 14
    code_elements :
     type_code : 23
     p_codes :
      -
        type : 35
        enabled : false
      -
        code : |1+
         
         selon moimeme
         	cas 1 
         		cbChoix1..visible = Vrai
         		schoix1..Visible = Faux
         		schoix1_2..Visible = Faux
         		Liste_intercalaire1..visible =faux
         		BTN_Intercalaire1..visible =faux
         
         		cbOperateurEgalite1[1]..Etat = actif
         		cbOperateurEgalite1[2]..Etat = Grisé
         		cbOperateurEgalite1[3]..Etat = Grisé
         		cbOperateurEgalite1[4]..Etat = Grisé
         		cbOperateurEgalite1[5]..Etat = Grisé
         		cbOperateurEgalite1[6]..Etat = Actif
         		cbOperateurEgalite1[7]..Etat = Grisé
         		cbOperateurEgalite1[8]..Etat = Grisé
         		cbOperateurEgalite1[9]..Etat = Grisé
         		cbOperateurEgalite1[10]..Etat = Grisé
         		
         		POUR TOUT IntercalaireCouleurDimensions  
         			ListeAjoute(cbChoix1,IntercalaireCouleurDimensions.Description+gLien(IntercalaireCouleurDimensions.IDIntercalaireCouleurDimensions))
         		FIN
         	CAS 12
         		
         		cbChoix1..Visible = Faux
         		schoix1..Visible = Faux
         		Schoix1_2..Visible = Faux
         		cbOperateurEgalite1[1]..Etat = Grisé
         		cbOperateurEgalite1[2]..Etat = Grisé
         		cbOperateurEgalite1[3]..Etat = Grisé
         		cbOperateurEgalite1[4]..Etat = Grisé
         		cbOperateurEgalite1[5]..Etat = Grisé
         		cbOperateurEgalite1[6]..Etat = Grisé
         		cbOperateurEgalite1[7]..Etat = Grisé
         		cbOperateurEgalite1[8]..Etat = Actif
         		cbOperateurEgalite1[9]..Etat = Grisé
         		cbOperateurEgalite1[10]..Etat = Grisé
         		
         		Liste_intercalaire1..X = cbOperateurEgalite1..X+cbOperateurEgalite1..Largeur+5
         		Liste_intercalaire1..Y = MoiMême..Y
         		Liste_intercalaire1..Etat = Actif
         		Liste_intercalaire1..Visible = Vrai
         		BTN_Intercalaire1..Etat = Actif
         		BTN_Intercalaire1..X = Liste_intercalaire1..X+Liste_intercalaire1..Largeur + 5
         		BTN_Intercalaire1..Y = MoiMême..Y
         		BTN_Intercalaire1..Visible = Vrai
         		
         	cas 11
         		
         
         		schoix1..Visible = vrai
         
         		cbOperateurEgalite1[1]..Etat = actif
         		cbOperateurEgalite1[2]..Etat = Grisé
         		cbOperateurEgalite1[3]..Etat = Grisé
         		cbOperateurEgalite1[4]..Etat = Grisé
         		cbOperateurEgalite1[5]..Etat = Grisé
         		cbOperateurEgalite1[6]..Etat = Grisé
         		cbOperateurEgalite1[7]..Etat = Grisé
         		cbOperateurEgalite1[8]..Etat = actif
         		cbOperateurEgalite1[9]..Etat = Grisé
         		cbOperateurEgalite1[10]..Etat = Grisé
         		ExécuteTraitement(cbOperateurEgalite1,trtSélection)
         //	cas 13
         //		
         //		cbChoix1..Visible = Faux
         //		schoix1..Visible = Faux
         //		Schoix1_2..Visible = Faux
         //		cbOperateurEgalite1[1]..Etat = Grisé
         //		cbOperateurEgalite1[2]..Etat = Grisé
         //		cbOperateurEgalite1[3]..Etat = Grisé
         //		cbOperateurEgalite1[4]..Etat = Grisé
         //		cbOperateurEgalite1[5]..Etat = Grisé
         //		cbOperateurEgalite1[6]..Etat = Grisé
         //		cbOperateurEgalite1[7]..Etat = Grisé
         //		cbOperateurEgalite1[8]..Etat = Grisé
         //		cbOperateurEgalite1[9]..Etat = actif
         //		
         //		Liste_intercalaire1..visible = faux
         //		BTN_Intercalaire1..Visible = faux
         		
         	CAS 13,14,16
         		
         		cbChoix1..Visible = Faux
         		schoix1..Visible = Faux
         		Schoix1_2..Visible = Faux
         		cbOperateurEgalite1[1]..Etat = Grisé
         		cbOperateurEgalite1[2]..Etat = Grisé
         		cbOperateurEgalite1[3]..Etat = Grisé
         		cbOperateurEgalite1[4]..Etat = Grisé
         		cbOperateurEgalite1[5]..Etat = Grisé
         		cbOperateurEgalite1[6]..Etat = Grisé
         		cbOperateurEgalite1[7]..Etat = Grisé
         		cbOperateurEgalite1[8]..Etat = Grisé
         		cbOperateurEgalite1[9]..Etat = Actif
         		cbOperateurEgalite1[10]..Etat = Grisé
         		
         		Liste_intercalaire1..Visible = Faux
         		BTN_Intercalaire1..Visible = Faux
         		
         	CAS 15
         		
         		cbChoix1..Visible = Faux
         		schoix1..Visible = vrai
         		Schoix1_2..Visible = vrai
         		cbOperateurEgalite1[1]..Etat = Grisé
         		cbOperateurEgalite1[2]..Etat = Grisé
         		cbOperateurEgalite1[3]..Etat = Grisé
         		cbOperateurEgalite1[4]..Etat = Grisé
         		cbOperateurEgalite1[5]..Etat = Grisé
         		cbOperateurEgalite1[6]..Etat = Grisé
         		cbOperateurEgalite1[7]..Etat = Grisé
