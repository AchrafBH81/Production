         		Liste_intercalaire3..Visible = Vrai
         		BTN_Intercalaire3..Etat = Actif
         		BTN_Intercalaire3..X = Liste_intercalaire3..X+Liste_intercalaire3..Largeur + 5
         		BTN_Intercalaire3..Y = MOIMEME..Y
