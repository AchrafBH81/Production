         			ListeAjoute(cbChoix3,IntercalaireCouleurDimensions.Description+gLien(IntercalaireCouleurDimensions.IDIntercalaireCouleurDimensions))
         		FIN
         	CAS 11
         		
         		
         		schoix3..Visible = Vrai
         		
