        type : 35
        enabled : false
      -
        code : |1+
         
         SELON MoiMême
         	CAS 7,10
         		Schoix2_2..Visible = Vrai
         	CAS 8  // est dans la liste
         		
         		SI cbAction2 = 11 ALORS   // Composante de thermos
         			Schoix2_2..Visible				= Faux
         			schoix2..Visible				= Faux
         			Liste_Composante2..X			= cbOperateurEgalite2..X+cbOperateurEgalite2..Largeur+5
         			Liste_Composante2..Y			= cbOperateurEgalite2..Y
         //			Liste_Composante2..Etat			= Actif
