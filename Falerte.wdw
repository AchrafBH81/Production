         		BTN_Intercalaire2..Etat = Actif
         		BTN_Intercalaire2..X = Liste_intercalaire2..X+Liste_intercalaire2..Largeur + 5
         		BTN_Intercalaire2..Y = MOIMEME..Y
         		BTN_Intercalaire2..Visible = Vrai
         		
         //	CAS 13
         //		
         //		cbChoix2..Visible = Faux
         //		schoix2..Visible = Faux
         //		Schoix2_2..Visible = Faux
         //		cbOperateurEgalite2[1]..Etat = Grisé
         //		cbOperateurEgalite2[2]..Etat = Grisé
