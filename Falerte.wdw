         			BTN_Composante2..Etat			= Actif
         			BTN_Composante2..X				= Liste_Composante2..X+Liste_Composante2..Largeur + 5
         			BTN_Composante2..Y				= cbOperateurEgalite2..Y
         			BTN_Composante2..Visible		= Vrai
         			
         		SINON
         			Schoix2_2..Visible = Vrai
         			
         		FIN
         			
         	AUTRE CAS
         		Schoix2_2..Visible = Faux
         		SI cbAction2 = 11 ALORS  // Composante de thermos
         			schoix2..Visible = Vrai
         		FIN
         		Liste_Composante2..Visible		= Faux
         		BTN_Composante2..Visible		= Faux
         
         FIN
        type : 33
      -
        type : 17
        enabled : false
