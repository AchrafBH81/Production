         	CAS 13,14,16
         		
         		cbChoix2..Visible = Faux
         		schoix2..Visible = Faux
         		Schoix2_2..Visible = Faux
         		cbOperateurEgalite2[1]..Etat = Grisé
         		cbOperateurEgalite2[2]..Etat = Grisé
         		cbOperateurEgalite2[3]..Etat = Grisé
         		cbOperateurEgalite2[4]..Etat = Grisé
         		cbOperateurEgalite2[5]..Etat = Grisé
         		cbOperateurEgalite2[6]..Etat = Grisé
         		cbOperateurEgalite2[7]..Etat = Grisé
         		cbOperateurEgalite2[8]..Etat = Grisé
         		cbOperateurEgalite2[9]..Etat = Actif
         		cbOperateurEgalite2[10]..Etat = Grisé
         		
         		Liste_intercalaire2..Visible = Faux
         		BTN_Intercalaire2..Visible = Faux
         		
         		
         	CAS 15
         		
         		cbChoix2..Visible = Faux
         		schoix2..Visible = Vrai
         		Schoix2_2..Visible = Vrai
         		cbOperateurEgalite2[1]..Etat = Grisé
         		cbOperateurEgalite2[2]..Etat = Grisé
         		cbOperateurEgalite2[3]..Etat = Grisé
         		cbOperateurEgalite2[4]..Etat = Grisé
         		cbOperateurEgalite2[5]..Etat = Grisé
         		cbOperateurEgalite2[6]..Etat = Grisé
         		cbOperateurEgalite2[7]..Etat = Grisé
         		cbOperateurEgalite2[8]..Etat = Grisé
         		cbOperateurEgalite2[9]..Etat = Grisé
         		cbOperateurEgalite2[10]..Etat = Actif
         		
         		Liste_intercalaire2..Visible = Faux
         		BTN_Intercalaire2..Visible = Faux	
         		
         	autre CAS 
         		cbChoix2..Visible = Faux
         		schoix2..Visible = Vrai
         		schoix2_2..Visible = Faux
         		cbOperateurEgalite2[1]..Etat = Actif
         		cbOperateurEgalite2[2]..Etat = actif
         		cbOperateurEgalite2[3]..Etat = Actif
         		cbOperateurEgalite2[4]..Etat = Actif
         		cbOperateurEgalite2[5]..Etat = Actif
         		cbOperateurEgalite2[6]..Etat = Actif
