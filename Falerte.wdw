         		cbOperateurEgalite3[2]..Etat = Grisé
         		cbOperateurEgalite3[3]..Etat = Grisé
         		cbOperateurEgalite3[4]..Etat = Grisé
         		cbOperateurEgalite3[5]..Etat = Grisé
         		cbOperateurEgalite3[6]..Etat = Grisé
         		cbOperateurEgalite3[7]..Etat = Grisé
         		cbOperateurEgalite3[8]..Etat = actif
         		cbOperateurEgalite3[9]..Etat = Grisé
         		cbOperateurEgalite3[10]..Etat = Grisé
         		ExécuteTraitement(cbOperateurEgalite3,trtSélection)
         		
         	CAS 12
         		
         		cbChoix3..Visible = Faux
         		schoix3..Visible = Faux
         		Schoix3_2..Visible = Faux
         		cbOperateurEgalite3[1]..Etat = Grisé
         		cbOperateurEgalite3[2]..Etat = Grisé
         		cbOperateurEgalite3[3]..Etat = Grisé
         		cbOperateurEgalite3[4]..Etat = Grisé
         		cbOperateurEgalite3[5]..Etat = Grisé
