  -
    name : cbOperateurEgalite1
    identifier : 0x2681ba6b1f1c3814
    internal_properties : 
    properties :
     x : 427
     y : 261
     width : 189
     height : 24
    dropdown :
     internal_properties : 
     type : 7
    type : 14
    code_elements :
     type_code : 23
     p_codes :
      -
        type : 35
        enabled : false
      -
        code : |1+
         	selon  cbOperateurEgalite1
         		cas 7,10
         			Schoix1_2..visible = vrai
         		cas 8  // est dans la liste
         		
         		SI cbAction1 = 11 ALORS   // Composante de thermos
         			Schoix1_2..Visible				= Faux
         			schoix1..Visible				= Faux
         			Liste_Composante1..X			= cbOperateurEgalite1..X+cbOperateurEgalite1..Largeur+5
         			Liste_Composante1..Y			= cbOperateurEgalite1..Y
         //			Liste_Composante1..Etat			= Actif
         			Liste_Composante1..Visible		= Vrai
         			BTN_Composante1..Etat			= Actif
         			BTN_Composante1..X				= Liste_Composante1..X+Liste_Composante1..Largeur + 5
         			BTN_Composante1..Y				= cbOperateurEgalite1..Y
         			BTN_Composante1..Visible		= Vrai
         			
         			
         		SINON
         			Schoix1_2..Visible = Vrai
         			
         		FIN
         				
         		AUTRE CAS
         		Schoix1_2..Visible = faux
         		SI cbAction1 = 11 ALORS  // Composante de thermos
         			schoix1..Visible = Vrai
         		FIN
         		Liste_Composante1..Visible		= Faux
         		BTN_Composante1..Visible		= Faux
         	FIN
        type : 33
      -
        type : 17
        enabled : false
