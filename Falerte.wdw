         		cbOperateurEgalite1[9]..Etat = grisé
         		cbOperateurEgalite1[10]..Etat = Actif
         		
         		Liste_intercalaire1..Visible = Faux
         		BTN_Intercalaire1..Visible = Faux	
         		
         //	CAS 18
         //		
         //		cbChoix1..Visible				= Faux
         //		schoix1..Visible				= vrai
         //		Schoix1_2..Visible				= Faux
         //		cbOperateurEgalite1[1]..Etat	= Grisé
         //		cbOperateurEgalite1[2]..Etat	= Grisé
         //		cbOperateurEgalite1[3]..Etat	= Grisé
