 message_bar :
  internal_properties : CQAAAAkAAAAgEGb1tUo4GfLrB30B56s9au7KA64qCwdV1pQ34YOUzPPso4zvQ2EHnEJosj3+iyJ68UPAQn9biEcUE6gqjPFVthj71+96WQHbirE1EXNO9TThs7luVHwRKFt8Zw==
 actionbar : {}
 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1+
      
      fonction recherchedeComposante(SaisieOK=0,type="")
      // L'appel à cette fenêtre est du type:
      //       OUVRE(nom_fen,SaisieOK)
      //		 si SaisieOK alors 		// Un enregistrement a été sélectionné
      // Vous pouvez aussi utiliser la syntaxe d'appel suivante:
      //       SI OUVRE(nom_fen) alors		// Un enregistrement a été sélectionné
      
      
      // Pour compatibilité 5.5
      MoiMême..Visible=Vrai
      Global
          resultat est une chaine
      	NomFic		est une chaine		// Nom du fichier associé à la fenêtre
      //	CleParcours	est une chaine		// Nom de la clé de parcours
          pos est un entier 
       NomFic="invent"						// Fichier principal de la fenêtre
       CleParcours="INUM"	// Détermine l'ordre de tri initial de la table
      
      // Affiche dans la table, depuis le début du fichier, avec ascenseur variable.
      // Pas de filtre sur le fichier, le total des enregistrements peut-être visualisé.
      pos = hsauveposition("invent")
      
      
   -
     code : |1+
      
      
      HFiltre(invent,itypeiactif,HConstruitValClé(invent,itypeiactif,1,1))
      TableAffiche(TABLE,taInit)
     type : 34
   -
     type : 180
     enabled : false
   -
     type : 230
     enabled : false
   -
     code : |1+
      
      hdesactivefiltre(nomfic)
      
      //Renvoyer SaisieOK
      
      Renvoyer resultat
      
     type : 2
   -
     type : 11
   -
     type : 12
   -
     type : 17
   -
     type : 13
