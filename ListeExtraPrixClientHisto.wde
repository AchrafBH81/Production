     p_codes :
      -
        code : |1+
         compteur est un entier = 1
         hlitrecherche("spqteint","spqclientproduitintervalle",numeroclient+complete(ENSEMBLE.encomposant1,10)+...
                           complete(ENSEMBLE.encomposant2,10)+complete(ENSEMBLE.encomposant3,10)+caract(0))
         
         //Code WinDev 5.5 remplacé par la migration :
         //tantque pas h.endehors et ...
         tantque pas HEnDehors() et ...
         	numeroclient+complete(ENSEMBLE.encomposant1,10)+...
             complete(ENSEMBLE.encomposant2,10)+complete(ENSEMBLE.encomposant3,10) = ...
         	spqteint.spqclient + spqteint.spqcomposant1 + spqteint.spqcomposant2 + spqteint.spqcomposant3	
         compteur++
         hlitsuivant("spqteint","spqclientproduitintervalle")
         
         fin
         //Code WinDev 5.5 remplacé par la migration :
         //si (compteur * 5) + _.debv > ihauteurpage() alors
         si (compteur * 5) + iHauteurRestantePage() > ihauteurpage() alors
         						  iterminepage()
         fin						  
         
        type : 327692
      -
        code : |1+
         borne est une chaine = numeroclient+complete(ENSEMBLE.encomposant1,10)+...
                           complete(ENSEMBLE.encomposant2,10)+complete(ENSEMBLE.encomposant3,10)
         
         //Code WinDev 5.5 remplacé par la migration :
         //iimprimeetat("LIGNEESCQTE",borne+caract(0),borne+caract(255))
         iHautBasPageImbriqué(Vrai); iImprimeEtat("LIGNEESCQTE",borne+caract(0),borne+caract(255))
         
        type : 327693
      -
        type : 327697
