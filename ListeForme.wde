 controls : []
 code_elements :
  type_code : 13
  p_codes :
   -
     code : |1-
      procedure listeforme(NoClient = "")
      //cheminforme = ComplèteRep(fRepEnCours())+"formes\"
      //cheminforme = completerep(repdonnees)+"formes\"
      
      HLit(config,1)
      cheminforme = ComplèteRep(config.Dossierforme)
     type : 327680
   -
     code : |1+
      si noclient <> "" alors
      	si hlitrecherche(FormeClient,IdClientNoForme,HConstruitValClé(FormeClient,IdClientNoForme,sansespace(noclient)...
      		,sansespace(forme.fnumero))) alors
      		si pas FormeClient.fListePrix alors
      			renvoyer faux
      		sinon 
      			renvoyer vrai
      		FIN
      	sinon
      		renvoyer faux
      	FIN
      FIN
      
     type : 327696
   -
     code : |1+
      lNombreenrImprime = moimeme..NbEnrImprimé
      
     type : 327682
