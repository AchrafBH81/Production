  -
    name : Bouton1
    identifier : 0x2f89935e0491a819
    internal_properties : 
    properties :
     x : 56
     y : 55
     width : 246
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         pour tout facture 
         
         	message(facture.fanumero)
         	multitacherepeint()
         	si facture.fatypedocument <> 3 _et_ sansespace(facture.faclient) = "139" alors
         		facture.isedi = Vrai
         		hmodifie(Facture,hNumEnrEnCours)
         	sinon
         		Facture.IsEDI = faux
         		HModifie(Facture,hNumEnrEnCours)
         		
         	FIN
         FIN
         
         
         
        type : 18
      -
        type : 161
        enabled : false
  -
    name : Bouton2
    identifier : 0x2f899fdd04d6763d
    internal_properties : 
