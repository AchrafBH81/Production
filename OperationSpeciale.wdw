  -
    name : Bouton3
    identifier : 0x2f89a731a004163d
    internal_properties : 
    properties :
     x : 56
     y : 85
     width : 246
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         txtreq est une chaine = [
         update facture 
         inner join logfile on logfile.lNoCommande = facture.fanumero
         set facture.Computername = logfile.lUtilisateur
         
         where LogFile.lFonction = 'HAjoute'
         ]
         reqsql est une source de Données
         si HExécuteRequêteSQL(reqsql,hRequêteDéfaut,txtreq) alors
         sinon
         	info("erreur")	
         FIN
        type : 18
      -
        type : 161
        enabled : false
  -
    name : Bouton4
    identifier : 0x2f89b270a2120724
    internal_properties : 
    properties :
     x : 56
     y : 254
     width : 246
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         //txtreq est une chaine = [
         //select * from hfacture where hfacture.fadate > '20181231'
         //]
         //reqsql est une source de donnees
         //
         //si HExécuteRequêteSQL(reqsql,hRequêteDéfaut,txtreq) alors
         POUR CHAQUE hfacture
         	si hfacture.fadatecommande > "20181231" alors
         		Message(hfacture.fanumero)
         		MultitâcheRepeint()
         		majtrackingHisto(hfacture.fanumero)
         	FIN
         fin
         
         //FIN
        type : 18
      -
        type : 161
        enabled : false
  -
    name : Bouton5
    identifier : 0x2fa59d11a1d6709c
    internal_properties : 
    properties :
     x : 56
     y : 318
     width : 246
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         txtreq est une chaine = [
         	select commandeachat.IDCommandeAchat,commandeachat.CaNumero,CommandeAchatDetail.cNoLigne,commandeachat.CanoCommande,fdetail.ThermosType,CommandeAchatDetail.cadNoProduit from CommandeAchatDetail
         	inner join CommandeAchat on commandeachat.IDCommandeAchat = CommandeAchatDetail.IDCommandeAchat
         	inner join fdetail on fdetail.fdnocomm = commandeachat.CanoCommande and fdetail.fdligne = commandeachatdetail.cNoLigne
         	where CommandeAchat.CaFermeExterieur=0 and fdetail.ThermosType in ('D','T')
         ]
         reqsql est une source de donnees
         
         si HExécuteRequêteSQL(reqsql,hRequêteDéfaut,txtreq) alors
         	pour tout reqsql
         		si hlitrecherche(commandeachat,idcommandeachat,reqsql.idcommandeachat) alors
         			si pas HLitRecherche(invent,INUM,reqsql.cadnoproduit) alors
         				commandeachat.CaFermeExterieur = vrai
         				hmodifie(commandeachat,hnumenrencours)
         			fin
         		fin
         	fin
         fin
        type : 18
      -
        type : 161
        enabled : false
