 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1-
      PROCEDURE MaFenêtre(IdCommande est un entier,FileNameEdi est un chaine,NoCommande est une chaine,IsException est un booleen = faux)
      
      txtreq est une chaîne
      reqsql est une source de donnees
      tabFileName est un tableau de chaînes
      tabFileNameToSend est un tableau de chaînes
      
      RepEncours est une chaine = completerep(fRépertoireTemp())
      cpt est un entier
      sFilename est une chaine
      mafenetre..ValeurRenvoyée = tabFileNameToSend
   -
     code : |1-
      txtreq = [
      	select * from commandeAchatdessin where idcommandeachat = %1
      ]
      TableAjouteLigne(Table1,Vrai,"Fichier EDI",FileNameEdi,fExtraitChemin(Filenameedi,fFichier+fExtension))
      tabfilename.ajoute(filenameedi)
      si HExécuteRequêteSQL(reqsql,hRequêteDéfaut,ChaîneConstruit(txtreq,idcommande)) ALORS
      	pour tout reqsql
      		HLitRecherche(CommandeAchatDessin,IDCommandeAchatDessin,reqSql.idcommandeachatdessin)
      		cpt++
      		sFilename = RepEncours+nocommande+"-"+cpt+".pdf"
      		tabFileName.Ajoute(sFileName)
      		HExtraitMémo(CommandeAchatDessin,Dessin,sFilename)
      		
      		TableAjouteLigne(Table1,isexception,reqsql.FileDescription,sFileName,fExtraitChemin(sfilename,fFichier+fExtension))
      	FIN
      fin
      table1[1].transfert..etat = inactif
     type : 34
