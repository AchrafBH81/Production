    properties :
     y : 10.583
     width : 259.4
     height : 4.349
    code_elements :
     type_code : 30
     p_codes :
      -
        code : |1+
         si sansespace(RequeteCommandeDetail.FDJOBLIGNE) = "" et sansespace(RequeteCommandeDetail.fnotes) = "" et sansespace(RequeteCommandeDetail.fnotes1) = "" alors
         	corps..visible = vrai
         	iteration1..etat = faux
         	si pas RequeteCommandeDetail.ftypespacer = 0  alors
         		si hlitrecherche(typespac,tnumero,RequeteCommandeDetail.ftypespacer) alors
         			rTypeSpacer = typespac.tdesccourte
         		sinon
         			rTypeSpacer = ""
         		fin
         	sinon
         		rTypeSpacer = ""
         	fin
         
         sinon
         	corps..visible = faux
         	iimprimebloc(iteration1)
         FIN
        type : 327692
      -
        type : 327697
        enabled : false
