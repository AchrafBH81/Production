  p_codes :
   -
     code : |1+
      Procedure RAPPORTVENTEDETAILperiode(ltableauperiode="", _pParam2="", _pParam3="", _pParam4="")
      
      //	szmodeetat = "PAYSAGE"
      hlitpremier("config","COCLEUNIK")
      
      lmoisabrev est un tableau de 12 chaines
      lmoisabrev[1] = "Janv."
      lmoisabrev[2] = "Févr."
      lmoisabrev[3] = "Mars"
      lmoisabrev[4] = "Avril"
      lmoisabrev[5] = "Mai"
      lmoisabrev[6] = "Juin"
      lmoisabrev[7] = "Juil."
      lmoisabrev[8] = "Août"
      lmoisabrev[9] = "Sept."
      lmoisabrev[10] = "Oct."
      lmoisabrev[11] = "Nov."
      lmoisabrev[12] = "Déc."
      lcompteurligne est un entier = 0
      
     type : 327680
  procedures :
   -
     name : tridetailfacture
     procedure_id : 5273452213563553853
     type_code : 14
     code : |1+
      Procédure tridetailfacture()
      si hfdetail.ftype = 1 alors
      	 
      
      renvoyer hfdetail.fdcomposant1+hfdetail.fdcomposant2+hfdetail.fdcomposant3
      
      sinon
      
      //renvoyer hfdetail.fdnumprod
      renvoyer hfdetail.fdnumprod
      
      
      fin
      
     type : 458752
