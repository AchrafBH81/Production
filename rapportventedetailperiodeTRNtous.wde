  -
    name : BLOC_CORPS
    identifier : 0x492f10d947adf87b
    internal_properties : CQAAAAkAAABumoZ7PD6k0ydX4Ju5vNAvxO1Qy5jrkdtksjF07MfCdr2cTbRGREUmgSXrBgyL/isFZdc2+7RLmKG4KstPe8KiIfhE5p3PxdgQ27sDyyCSFqLaGvOpS81vdSEwQv1IMWe0bGFVo+czRz2Cz+sTCa2F2lyl9mHG1KkbeMYl+M6U9Q+vgtm5N8+fnV/MgnY2t5MRBNc6uORVNom9bFa7L5or8nTdjQw5GW3R2L56L0/zP3xbbd4xyWNGLC8TryR4vrcqd3UaoZMdKyhLB7XNyg==
    properties :
     y : 65.197
     width : 269.4
     height : 1.002
    code_elements :
     type_code : 30
     p_codes :
      -
        code : |1+
         //si requeteventeperiodeproduitsommaire.lperiode >= ltableauperiode[1] et requeteventeperiodeproduitsommaire.lperiode <= ltableauperiode[2] alors
         //	TOTALclient+=requeteventeperiodeproduitsommaire.lvente+requeteventeperiodeproduitsommaire.peinturecarrelage
         ////	TOTALQTE+=requeteventeperiodeproduitsommaire.lqte
         //	surchargeper+=requeteventeperiodeproduitsommaire.lsurcharge
         ////	TotalPiedCourant+=requeteventeperiodeproduitsommaire.lpied
         //
         //sinon
         //	TOTALclientprec+=requeteventeperiodeproduitsommaire.lvente+requeteventeperiodeproduitsommaire.peinturecarrelage
         ////	TOTALQTEprec+=requeteventeperiodeproduitsommaire.lqte
         //	surchargeperprec+=requeteventeperiodeproduitsommaire.lsurcharge
         ////	TotalPiedprec+=requeteventeperiodeproduitsommaire.lpied
         //FIN
         
         si requeteventeperiodeproduitsommaire.lperiode >= ltableauperiode[1] et requeteventeperiodeproduitsommaire.lperiode <= ltableauperiode[2] alors
         	TOTALPRODUIT+=requeteventeperiodeproduitsommaire.lvente//+requeteventeperiodeproduitsommaire.peinturecarrelage
         	TOTALQTE+=requeteventeperiodeproduitsommaire.lqte
         	surchargeper+=requeteventeperiodeproduitsommaire.lsurcharge
         	TotalPiedCourant+=requeteventeperiodeproduitsommaire.lpied
         	lPeintureCarrelage+=requeteventeperiodeproduitsommaire.peinturecarrelage
         	si requeteventeperiodeproduitsommaire.lType = "T"  ALORS
         		
         		TOTALQTETHERMOS1+=requeteventeperiodeproduitsommaire.lqte
         		TOTALTHERMOS1+=RequeteventePeriodeProduitSommaire.lvente
         		si RequeteventePeriodeProduitSommaire.LqteSimple = "S" alors
         
         			TOTALQTEVERRE+=RequeteventePeriodeProduitSommaire.lqte
         			TOTALVerre += RequeteventePeriodeProduitSommaire.lvente
         		sinon
         			TOTALQTETHERMOS+=RequeteventePeriodeProduitSommaire.lqte
         			TOTALTHERMOS+=RequeteventePeriodeProduitSommaire.lvente
         		fin
         		
         	sinon si requeteventeperiodeproduitsommaire.lType = "C" alors
         		TOTALQTEcarrelage+=requeteventeperiodeproduitsommaire.lqte
         		TOTALcarrelage+=requeteventeperiodeproduitsommaire.lvente
         	fin
         	
         sinon
         	TOTALPRODUITprec+=requeteventeperiodeproduitsommaire.lvente//+requeteventeperiodeproduitsommaire.peinturecarrelage
         	TOTALQTEprec+=requeteventeperiodeproduitsommaire.lqte
         	surchargeperprec+=requeteventeperiodeproduitsommaire.lsurcharge
         	TotalPiedprec+=requeteventeperiodeproduitsommaire.lpied
         	lPeintureCarrelageprec+=requeteventeperiodeproduitsommaire.peinturecarrelage
         	si requeteventeperiodeproduitsommaire.lType = "T"  ALORS
         		TOTALQTEThermosprec1+=requeteventeperiodeproduitsommaire.lqte
         		TOTALTHERMOSPREC1+=requeteventeperiodeproduitsommaire.lvente
         		
         		SI RequeteventePeriodeProduitSommaire.LqteSimple = "S" ALORS
         			
         			TOTALQTEVERREprec+=RequeteventePeriodeProduitSommaire.lqte
         			TOTALVerreprec += RequeteventePeriodeProduitSommaire.lvente
         		SINON
         			TOTALQTETHERMOSprec+=RequeteventePeriodeProduitSommaire.lqte
         			TOTALTHERMOSprec+=RequeteventePeriodeProduitSommaire.lvente
         		FIN
         	sinon si requeteventeperiodeproduitsommaire.lType = "C" alors
         		TOTALQTEcarrelagePREC+=requeteventeperiodeproduitsommaire.lqte
         		TOTALcarrelagePREC+=requeteventeperiodeproduitsommaire.lvente
         	fin
         FIN
         
         
         
         
