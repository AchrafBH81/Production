     code : |1+
      evenement("BtnSurvol1",".*",WM_MOUSEMOVE)
      evenement("BtnClicDroite1",".*",WM_rBUTTONDOWN)
      i est un entier
      hlit(Config,1)
      
      pour i = 1 a 20
      si i < 9 alors
        {"libelleDescription"+i}..libelle = sansespace(config.descriptionFourniture[i])
      fin	
      
      
      	si sansespace(Config.CFnomconstante[i]) <> "" alors
      		{"FEconstante"+i}..visible = vrai
      		{"FEconstante"+i}..libelle = sansespace(Config.CFnomconstante[i])
      	sinon
      		{"FEconstante"+i}..visible = faux
      		{"libellek"+i}..visible = faux
      
      	fin
      
      FIN
      
      hlitpremier("typecarr","tcdescription")
      fichierversecran
      Combo_Typecarrelage = typecarr.tYpecarrelage
      
      AssigneVariable()
      HDésactiveFiltre(typecarr)
      listeajoute(_tctypecalcul,"Normal")
      listeajoute(_tctypecalcul,"Contour")
      listeajoute(_tctypecalcul,"Tête")
      
      ExécuteTraitement(CAR_ONGLET,trtModification)
      mafenetre..visible = vrai
     type : 34
