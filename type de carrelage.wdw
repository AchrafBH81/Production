     type_code : 14
     code : |1+
      Procédure CalculAjustement()
      
      Affichagehauteur = NbCarreauhauteurTest+AjustementHauteur
      Affichagelargeur = NbCarreaulargeurTest+Ajustementlargeur
      
     type : 458752
   -
     name : valideformule
     procedure_id : 4813183774691094189
     type_code : 14
     code : |1+
      Procédure valideformule(Formulaverifier)
      xposition est un entier = 0  // position du caractere /
      xposition1 est un entier = 1 // position du caractere )
      souschaine est une chaine
      i est un entier = 1
      formule1 est une chaine
      res est une chaine
      boucle
      	xposition = position(Formulaverifier,"/",xposition+1)
      	si xposition = 0 alors
      		sortir
      	FIN
      	xposition1 = position(Formulaverifier,")",xposition)
      	si xposition1 = 0 alors
      		xposition1 = taille(Formulaverifier)
      	fin
      
      	souschaine = milieu(Formulaverifier,xposition+1,xposition1-xposition)
      	souschaine = remplace(souschaine,"(","")
      	souschaine = remplace(souschaine,")","")
      
      	formule1 = "y est un reel"+RC+"y="+souschaine+RC+"renvoyer y "
      	res = compile("formule2",formule1)
      	si ExécuteTraitement("formule2",trtProcédure) = 0 alors
      		acso_message("Erreur",souschaine,"Erreur")
      		acso_message("Erreur","Division par zéro","Erreur")
      		renvoyer faux
      	FIN
      FIN
      
      renvoyer vrai
      
      
      
     type : 458752
   -
     name : TesteFormuleQte
     procedure_id : 5053672504763596999
     type_code : 14
     code : |1+
      Procédure TesteFormuleQte(NomChamp)
      quand exception 
      	acso_message("Erreur","Erreur dans la formule de calcul ou dans la condition","Erreur")
      	acso_message("Erreur",exceptionInfo(errMessage),"Erreur")
      	retour
      FIN
      res est une chaine       // resultat de la compil	
      formule est une chaine = TcFormuleQTC
      //indice est un entier = milieu(idchamp,3)
      resultatCondition est un booleen
      si sansespace(formule) = "" alors
      	retour
      FIN
      AssigneVariableQTE()
      
      //si pas valideformule(formule) ALORS
      //	{idchamp} = 0
      //	info({idchamp})
      //    retour
      //FIN
      
      //CalculAutresVariables(idchamp,indice-1)
      formule1 est une chaine = "y est un reel"+RC+"y="+formule+RC+"renvoyer y "
      res = compile("formule2",formule1)
      si res = "" ALORS
      	titresuivant("Résultat")
      	acso_message("Résultat de la formule",ExécuteTraitement("formule2",trtProcédure),"Info")
      	//	info(ExécuteTraitement("formule2",trtProcédure))
      sinon
      	titresuivant("Erreur dans la formule")
      	acso_Message("Erreur dans la formule",res,"Erreur")
      fin
      
      
      
      
      
     type : 458752
   -
     name : AssigneVariableQTE
     procedure_id : 5053674270568482273
     type_code : 14
     code : |1-
      Procédure AssigneVariableQTE()
      i est un entier
      H1 = Hauteurtest
      L1 = Largeurtest
      NBL = NbCarreauLargeurTest
      NBH = NbCarreauHauteurtest
      C = EpaisseurCadre
      ETL = EpaisseurTigeLargeur
      eth = EpaisseurTigeHauteur
      vx = VariableUtil
      vx1 = VariableUtil1
      DDV = ddvtest
      DDH = ddhtest
      pour i = 1 a 20
      	{"k"+i} = {"FEconstante"+i}
      FIN
      
      //ExécuteTraitement(NbCarreauHauteurtest,trtModification)
     type : 458752
   -
     name : allumebouton
     procedure_id : 5054031930205253705
     type_code : 14
     code : |1+
      Procédure allumebouton()
      EteintBouton()
      message(gauche({ChampEnCours()}..nom,15))
      si champencours <> "" et gauche({ChampEnCours()}..nom,15) = "TProduitAssocie" alors
      	BtnRecherche..x = {ChampEnCours()}..x + {ChampEnCours()}..Largeur +5 
      	BtnRecherche..y ={ChampEnCours()}..y +2
      	btnrecherche..visible = vrai
      fin
      
      
      
      
     type : 458752
   -
     name : EteintBouton
     procedure_id : 5054032187030346784
     type_code : 14
     code : |1-
      Procédure EteintBouton()
      
      btnrecherche..visible = faux
