          identifier : 0x4f3d4e5f670c8f8f
          internal_properties : 
          properties :
           x : 259
           y : 6
           width : 152
           height : 24
          dropdown :
           internal_properties : 
           properties :
            height : 152
           type : 7
          type : 14
          code_elements :
           type_code : 23
           p_codes :
            -
              type : 35
              enabled : false
            -
              code : |1+
               si moimeme = 2 alors
               	GrpContour..visible = vrai
               sinon
               	GrpContour..visible = faux
               
               FIN
               
               DessineCarrelage()
              type : 33
            -
              type : 17
              enabled : false
        -
          name : tVariableARGON
          identifier : 0x50a3f4b803baa31e
          internal_properties : 
          properties :
           x : 465
           y : 6
           width : 113
           height : 23
          options :
           -
             internal_properties : CQAAAAkAAADfkenzOd08jk8zLMVmvc9I/HkKGtJGjFdQilZKObOEkCvxMJa/K+qHHPMXs986pMLuLq0GGik3zvh9Utqrgav1VzCTotWRSLUR4JGYS7xI3GarQnPjLe65JS/PtFSj5B9L/0BFFLFupcPMFtrjb9dLvVNmefkDRA==
          type : 5
          controls : []
          code_elements :
           type_code : 5
           p_codes :
            -
              code : |1+
               ExécuteTraitement(CboSpacer,trtSélection)
              type : 17
        -
          name : cboSpacer
          identifier : 0x51654fd57af6f8a1
          internal_properties : 
          properties :
           x : 259
           y : 55
           width : 269
           height : 24
          dropdown :
           internal_properties : 
           properties :
            height : 152
           type : 7
          type : 14
          code_elements :
           type_code : 23
           p_codes :
            -
              code : |1+
               hlitrecherche(IntercalaireCouleurdimensions,IDIntercalaireCouleurdimensions,cbospacer)
               si tVariableARGON alors
               	VARINTER1 = IntercalaireCouleurdimensions.VarInter1A
               	VARINTER2 = IntercalaireCouleurdimensions.VarInter2A
               	VARINTER3 = IntercalaireCouleurdimensions.VarInter3A
               	VARINTER4 = IntercalaireCouleurdimensions.VarInter4A
               	VARINTER5 = IntercalaireCouleurdimensions.VarInter5A
               sinon
               	VARINTER1 = IntercalaireCouleurdimensions.VarInter1
               	VARINTER2 = IntercalaireCouleurdimensions.VarInter2
               	VARINTER3 = IntercalaireCouleurdimensions.VarInter3
               	VARINTER4 = IntercalaireCouleurdimensions.VarInter4
               	VARINTER5 = IntercalaireCouleurdimensions.VarInter5
               fin
               
               varint1 = varinter1
               varint2 = varinter2
               varint3 = varinter3
               varint4 = varinter4
               varint5 = varinter5
               
              type : 33
            -
              type : 17
              enabled : false
        -
          name : CboSpacerCouleur
          identifier : 0x4f3d507679f8b773
          internal_properties : 
          properties :
           x : 260
           y : 31
           width : 268
           height : 24
          dropdown :
           internal_properties : 
           properties :
            height : 152
           type : 7
          type : 14
          code_elements :
           type_code : 23
           p_codes :
            -
              code : |1+
               hfiltre(IntercalaireCouleurDimensions,IDIntercalaireCouleurs,moimeme)
               listeaffiche(cbospacer)
               hlitrecherche(IntercalaireCouleurs,IDIntercalaireCouleurs,moimeme)
               HLitRecherche(Intercalaires,IDIntercalaires,IntercalaireCouleurs.idIntercalaires)
               c = intercalaires.EpaisseurCadre
               libEpaisseurCadre..libelle = "= Epaisseur cadre ("+ sansespace(intercalaires.description)+")"
               EpaisseurCadre = c
               DessineCarrelage()
               ExécuteTraitement(CboSpacer,trtSélection)
               
              type : 33
            -
              type : 17
              enabled : false
    type : 16
    controls : []
    code_elements :
     type_code : 24
     p_codes :
      -
        code : |1+
         selectteurcbospacer est un entier = cbospacer
         selon moimeme
         	cas 1
         		navigation..visible = faux
         		GrpEntete..visible = faux
         		TableAffiche(Table_typecarr,taCourantPremier)
         	cas 2,3,4,5,6,7
         		navigation..visible = vrai	
         		GrpEntete..visible = vrai
         	cas 8
         		navigation..visible = vrai	
         		GrpEntete..visible = vrai
         		imagecarrelage = ""
         		dessinecarrelage()
         FIN
         
         ExécuteTraitement(SélecteurTypeCarrelage,trtModification)
         ExécuteTraitement(CboCarrelage,trtSélection)
         ExécuteTraitement(CboSpacerCouleur,trtselection)
         ExécuteTraitement(TDemiCarrelage,trtModification)
         cbospacer = selectteurcbospacer 
         ExécuteTraitement(Cbospacer,trtSélection)
         CalculAjustement()
        type : 17
      -
        type : 292
        enabled : false
      -
        type : 293
        enabled : false
