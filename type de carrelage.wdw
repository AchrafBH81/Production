   -
     name : TesteFormuleFourn
     procedure_id : 5054121642109790870
     type_code : 14
     code : |1+
      Procédure TesteFormuleFourn(NomChamp)
      quand exception 
      	acso_message("Erreur","Erreur dans la formule de calcul ou dans la condition","Erreur")
      	acso_message("Erreur",exceptionInfo(errMessage),"Erreur")
      	
      	retour
      FIN
      res est une chaine       // resultat de la compil	
      IdChamp est une chaine = milieu(NomChamp,11)
      formule est une chaine = {"tcformule"+IdChamp}
      indice est un entier = milieu(IdChamp,3)
      resultatCondition est un booleen
      si sansespace(formule) = "" alors
      	retour
      FIN
      assignevariable()
      
      si pas valideformule(formule) ALORS
      	{IdChamp} = 0
      	acso_Message("Erreur dans la formule",{IdChamp},"Erreur")
      	retour
      FIN
      
      //CalculAutresVariables(idchamp,indice-1)
      formule1 est une chaine = "y est un reel"+RC+"y="+formule+RC+"renvoyer y "
      res = compile("formule2",formule1)
      si res = "" ALORS
      	{IdChamp} = ExécuteTraitement("formule2",trtProcédure)
      	si {IdChamp} < 0 alors
      		{IdChamp} = 0
      	FIN
      	titresuivant("Résultat de la formule")
      //	formule = {"typecarr.conditionsi"+gauche(idchamp,2)}[îndice]
      	formule1 = "y est un reel"+RC+"y="+formule+RC+"renvoyer y "
      	res = compile("formule2",formule1)
      
      	si res = "" alors
      //		resultatcondition = ExécuteTraitement("formule2",trtProcédure)
      //
      //		si resultatcondition  alors
      //			formule = {"typecarr.conditionalors"+gauche(idchamp,2)}[îndice]
      //			formule1 = "y est un reel"+RC+"y="+formule+RC+"renvoyer y "
      			res = compile("formule2",formule1)
      			si res = "" ALORS
      				acso_message("Résultat de la formule",ExécuteTraitement("formule2",trtProcédure),"Info")
      			sinon
      				titresuivant("Erreur dans la formule")
      				acso_Message("Erreur dans la formule",res,"Erreur")
      			fin
      
      //		sinon
      //			info({idchamp})
      //		fin
      	sinon
      		titresuivant("Erreur dans la formule")
      		acso_Message("Erreur dans la formule",res,"Erreur")
      
      	fin
      
      	//	info(ExécuteTraitement("formule2",trtProcédure))
      sinon
      	titresuivant("Erreur dans la formule")
      	acso_Message("Erreur dans la formule",res,"Erreur")
      fin
      
      
      
      
      
