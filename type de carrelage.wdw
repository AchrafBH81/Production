   -
     name : BtnSurvol1
     procedure_id : 4800966165490900454
     type_code : 14
     code : |1+
      Procédure BtnSurvol1()
      BulleActive(vrai)
      idBouton est une chaine 
      si gauche(moimeme..nom,9) = "BtnCalcul" alors
      	idBouton = droite(moimeme..nom,taille(moimeme..nom)-9)
      	Si sansespace({"typecarr.ConditionSi"+gauche(idBouton,2)}[val(milieu(idBouton,3))]) = "" alors
      		moimeme..bulle= "Pas de condition"
      	sinon	
      		moimeme..bulle = "Si ["+sansespace({"typecarr.ConditionSi"+gauche(idBouton,2)}[val(milieu(idBouton,3))])+"]" + rc ...
      		+    "      Alors ["+idBouton+" = "+sansespace({"typecarr.ConditionAlors"+gauche(idBouton,2)}[val(milieu(idBouton,3))])+"]" 
      
      	fin
      FIN
      
      
      
      
      
      
      
     type : 458752
   -
     name : BtnClicDroite1
     procedure_id : 4800966319818976411
     type_code : 14
     code : |1+
      Procédure BtnClicDroite1()
      AncienneValeur est une chaine = moimeme
      numerocomposante est une chaine
      si Minuscule(gauche(moimeme..nom,9)) = "tcformule" ou Minuscule(gauche(moimeme..nom,4)) = "type"alors
      	si pas moimeme..etat <> actif  alors
      		moimeme = AncienneValeur + ouvre(FenetreAbrev)
      
      		moimeme..curseur = taille(moimeme + 1)
      		reprisesaisie(moimeme)
      	fin
      FIN
      
      
      
      
     type : 458752
