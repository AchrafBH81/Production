   -
     code : |1+
      
      Procedure Fiche(ModeAppel="Création",SaisieOK=Faux)
      // L'appel à cette fenêtre est du type:
      //       OUVRE(nom_fen,ModeAppel,SaisieOK)
      //    ModeAppel indique le travail à exécuter:
      //        "Création"	Création d'un enregistrement
      //        "Modif"		Modification de l'enregistrement en cours
      // Le paramètre SaisieOK sera retourné à Vrai si validation (Faux si annulation).
      // En mode "Modif", le blocage de l'enregistrement est effectué par la fenêtre appelante.
      
      // Pour compatibilité 5.5
      
      
      Global
      NomFic			est une chaine		// Nom du fichier associé à la fenêtre
      NomFic="typecarr"
      // Variable nécessaires pour testet les formules de calcul
      
      
      H1 est un reel
      L1 est un reel
      NBL est un reel
      NBH est un reel
      C est un reel
      ETL est un reel
      ETH est un reel
      VX est un reel
