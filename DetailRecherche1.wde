       code_elements :
        type_code : 29
        p_codes :
         -
           code : |1+
            si hlitrecherche(typespac,tnumero,RequeteCommandeRecherche1.ftypespacer) alors
            	typespacer0 = typespac.tdesccourte
            sinon
            	typespacer0 = ""	
            FIN
            
           type : 327692
         -
           type : 327699
           enabled : false
    properties :
     y : 10.583
     width : 269.4
     height : 4.085
    code_elements :
     type_code : 30
     p_codes :
      -
        code : |1+
         si RequeteCommandeRecherche1.ftype <> 4 alors
         	si RequeteCommandeRecherche1.ftype = 1 alors
         		rubrique17..visible = vrai
         		rubrique19..visible = vrai
         		typespacer0..visible = vrai
         		typespacer1..visible = vrai
         		spacer1..visible = vrai
         		spacer2..visible = vrai
         		spacer3..visible = vrai
         		spacer4..visible = vrai
         	sinon
         		rubrique17..visible = faux
         		rubrique19..visible = faux
         		typespacer0..visible = faux
         		typespacer1..visible = faux
         		spacer1..visible = faux
         		spacer2..visible = faux
         		spacer3..visible = faux
         		spacer4..visible = faux
         	fin
         
         	GrpCarrelage..visible = faux
         sinon
         	rubrique17..visible = faux
         	rubrique19..visible = faux
         	typespacer0..visible = faux
         	typespacer1..visible = faux
         	spacer1..visible = faux
         	spacer2..visible = faux
         	spacer3..visible = faux
         	spacer4..visible = faux
         	GrpCarrelage..visible = vrai
         FIN
         si (sansespace(RequeteCommanderecherche1.FDJOBLIGNE) = "" et sansespace(RequeteCommanderecherche1.fnotes) = "") et ...
         	pas RequeteCommanderecherche1.ftype = 4 alors 
         
         	corps..visible = vrai
         	iteration1..etat = faux
         	Icarrelage..etat = faux
         sinon si RequeteCommanderecherche1.ftype = 4
         	corps..visible = faux
         
         	iimprimebloc(Icarrelage)
         sinon
         
         
         	corps..visible = faux
         	iimprimebloc(iteration1)
         FIN
        type : 327692
      -
        type : 327697
        enabled : false
