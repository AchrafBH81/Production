  -
    name : BOUTON3
    identifier : 0x46192bc3261eb361
    internal_properties : 
    properties :
     x : 543
     y : 66
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         //conditiondeselection est une chaine
         listeclient est une chaine
         
         //ouvrefille(FenAttente,"Préparation du rapport en cours ... ",ijaunebulle,ivertfonce)
         //multitache(200)
         //memcree("zonefacture")
         //clederecherche EST UNE CHAINE 
         //Code WinDev 5.5 remplacé par la migration :
         //numerovue est un entier long
         
         nUmerovue est un entier  
         sChoixrapport est une chaine
         bChoixsommaire est un booleen  
         tableaudate est un tableau de 4 chaines
         tableaudateComparatif est un tableau associatif de Comparatif
         txtreqsql est une chaine = [
         	select HistoJourProduit.hClient,sum(HistoJourProduit.lvente) as total
         	from HistoJourProduit
         	where HistoJourProduit.lDate between '%1' and '%2'
         	%3
         	group by hclient
         ]
         txtreqsqlPeinture est une chaine = [
         	SELECT 
         	HistoAnneeMoisProduit.hClient as client,
         	sum(HistoAnneeMoisProduit.peinturecarrelage) AS peinturecarrelage	
         	
         	FROM 
         	HistoAnneeMoisProduit
         	WHERE 
         	
         	(
         	HistoAnneeMoisProduit.lperiode BETWEEN '%1' AND '%2'
         	%3
         	)
         	
         	group by client
         	ORDER BY 
         	Client ASC
         ]
         
         
         Reqsql est une source de Données
         Reqsqlpeinture est une source de Données
         
         txtreq est une chaine
         
         //datedebutannee est une chaine= config.canneeencoursdebut
         
         
         Datefinrapport est une date = SansEspace(NumériqueVersChaîne(csdannee1))+remplir_zero(SansEspace(NumériqueVersChaîne(ccmois1)),2) + "01"
         Datefinrapport = DernierJourDuMois(Datefinrapport)
         
         
         //datefinannee est une chaine= ventefin
         //datedebutannee est une date
         //datefinannee est une date = datedujour()
         //datedebuttrimestre est une date
         //datefinTrimestre est une date = datedujour()
         //
         //datedebutannee = datedujour()
         //datedebutannee..Année-=1
         //datedebutannee..jour+=1
         //
         //datedebuttrimestre = datedujour()
         //datedebuttrimestre..mois-=3
         //datedebuttrimestre..Jour+=1
         
         datedebutannee est une date = Datefinrapport
         datefinannee est une date = Datefinrapport
         datedebuttrimestre est une date = Datefinrapport
         datefinTrimestre est une date = Datefinrapport
         
         //datedebutannee = DateDuJour()
         datedebutannee..Année-=1
         datedebutannee..Jour+=1
         
         //datedebuttrimestre = DateDuJour()
         datedebuttrimestre..Mois-=3
         datedebuttrimestre..Jour+=1
         
         
         datedebutanneeprecedent est une date = datedebutannee
         datedebutanneeprecedent..annee-=1
         datefinanneeprecedent est une date= datefinannee
         datefinanneeprecedent..annee -=1
         datedebuttrimestreprecedent est une date = datedebuttrimestre
         datedebuttrimestreprecedent..annee-=1
         datefinTrimestreprecedent est une date = datefinTrimestre
         datefinTrimestreprecedent..annee-=1
         
         //tableaudateComparatif[1] = datedebutannee
         //tableaudateComparatif[2] = datefinannee
         //tableaudateComparatif[3] = datedebuttrimestre
         //tableaudateComparatif[4] = datefinTrimestre
         //tableaudateComparatif[5] = datedebutanneeprecedent
         //tableaudateComparatif[6] = datefinanneeprecedent
         //tableaudateComparatif[7] = datedebuttrimestreprecedent
         //tableaudateComparatif[8] = datefinTrimestreprecedent
         
         
         
         
         Rang est un entier
         Indice est un entier
         sLigne est une chaine
         Rang = 1
         tableaudate[1] =  sansespace(numeriqueverschaine(csdannee))+remplir_zero(sansespace(numeriqueverschaine(ccmois)),2)
         tableaudate[2] =  sansespace(numeriqueverschaine(csdannee1))+remplir_zero(sansespace(numeriqueverschaine(ccmois1)),2)
         
         // pour comparitif année précédente
         
         tableaudate[3] =  sansespace(numeriqueverschaine(csdannee-1))+remplir_zero(sansespace(numeriqueverschaine(ccmois)),2)
         tableaudate[4] =  sansespace(numeriqueverschaine(csdannee1-1))+remplir_zero(sansespace(numeriqueverschaine(ccmois1)),2)
         
         sablier(vrai)
         selon rappventedetailperiode.selectclient
         // choisir un ou plusieurs clients
         
         	cas 2
         		
         		pour Rang = 1 a ListeSelectOccurrence(CHOIXCLIENT)
         			Indice = ListeSelect("CHOIXCLIENT", Rang)
         			listeclient += sansespace(CHOIXCLIENT[Indice])+";"
         		fin
         		
         		
         		RequeteventePeriodeProduit.pdebutap = tableaudate[1]
         		RequeteventePeriodeProduit.pfinap = tableaudate[2]
         		RequeteventePeriodeProduit.pdebut = tableaudate[3]
         		RequeteventePeriodeProduit.pfin = tableaudate[4]
         		RequeteventePeriodeProduit.pNoClient = listeclient
         		
         		HExécuteRequête(RequeteventePeriodeProduit,hRequêteDéfaut)
         		// Tous les clients
         		
         	cas 1
         		RequeteventePeriodeProduit.pdebutap = tableaudate[1]
         		RequeteventePeriodeProduit.pfinap = tableaudate[2]
         		RequeteventePeriodeProduit.pdebut = tableaudate[3]
         		RequeteventePeriodeProduit.pfin = tableaudate[4]
         		RequeteventePeriodeProduit.pNoClient = null
         		HExécuteRequête(RequeteventePeriodeProduit,hRequêteDéfaut)
         		
         	cas 3
         		RequeteventePeriodeProduitSommaire.pdebutap = tableaudate[1]
         		RequeteventePeriodeProduitSommaire.pfinap = tableaudate[2]
         		RequeteventePeriodeProduitSommaire.pdebut = tableaudate[3]
         		RequeteventePeriodeProduitSommaire.pfin = tableaudate[4]
         		RequeteventePeriodeProduitSommaire.pNoClient = null
         		HExécuteRequête(RequeteventePeriodeProduitSommaire,hRequêteDéfaut)
         		
         		
         		
         fin	
         
         tempComparatif est un comparatif
         LaCondition est une chaine = ""
         si listeclient <> "" alors
         	listeparam est un chaine = transformChaine(listeclient)
         	LaCondition = "and hclient IN " + listeparam
         fin
         
         	txtreq = chaineconstruit(txtreqsql,datedebutannee,datefinannee,LaCondition )
         	si HExécuteRequêteSQL(Reqsql,hRequêteDéfaut,txtreq) alors
         		pour tout Reqsql
         			si tableaudateComparatif[Reqsql.hclient] = null alors
         				tempComparatif = allouer un comparatif
         				tempComparatif.AnneeCourante = Reqsql.total
         				tableaudateComparatif[Reqsql.hclient] = tempComparatif
         			sinon
         				tableaudateComparatif[Reqsql.hclient].AnneeCourante = Reqsql.total
         			FIN
         		fin
         	FIN
         	
         	txtreq = ChaîneConstruit(txtreqsql,datedebuttrimestre,datefinTrimestre,LaCondition )
         	SI HExécuteRequêteSQL(Reqsql,hRequêteDéfaut,txtreq) ALORS
         		pour tout Reqsql
         			SI tableaudateComparatif[Reqsql.hclient] = Null ALORS
         				tempComparatif = allouer un Comparatif
         				tempComparatif.Trimestreencours = Reqsql.total
         				tableaudateComparatif[Reqsql.hclient] = tempComparatif
         			SINON
         				tableaudateComparatif[Reqsql.hclient].Trimestreencours = Reqsql.total
         			FIN
         		fin
         	FIN
         
         	txtreq = ChaîneConstruit(txtreqsql,datedebutanneeprecedent,datefinanneeprecedent,LaCondition )
         	SI HExécuteRequêteSQL(Reqsql,hRequêteDéfaut,txtreq) ALORS
         		POUR TOUT Reqsql
         			SI tableaudateComparatif[Reqsql.hclient] = Null ALORS
         				tempComparatif = allouer un Comparatif
         				tempComparatif.AnneePrecedente = Reqsql.total
         				tableaudateComparatif[Reqsql.hclient] = tempComparatif
         			SINON
         				tableaudateComparatif[Reqsql.hclient].anneePrecedente = Reqsql.total
         			FIN
         		FIN
         	FIN
         	txtreq = ChaîneConstruit(txtreqsql,datedebuttrimestreprecedent,datefinTrimestreprecedent,LaCondition )
         	SI HExécuteRequêteSQL(Reqsql,hRequêteDéfaut,txtreq) ALORS
         		POUR TOUT Reqsql
         			SI tableaudateComparatif[Reqsql.hclient] = Null ALORS
         				tempComparatif = allouer un Comparatif
         				tempComparatif.TrimestrePrecedent = Reqsql.total
         				tableaudateComparatif[Reqsql.hclient] = tempComparatif
         			SINON
         				tableaudateComparatif[Reqsql.hclient].TrimestrePrecedent = Reqsql.total
         			FIN
         		FIN
         	FIN
         	
         //////////////////////////////////////////////////////////////////
         // Il faut calculer la peinture a part.
         // car elle n,est pas calculé dan sle total du fichier HistoJourProduit
         // utilisé dans la requete précédente
         ////////////////////////////////////////////////////////////////////
         
         txtreq = ChaîneConstruit(txtreqsqlPeinture,gauche(datedebutannee,6),gauche(datefinannee,6),LaCondition )
         SI HExécuteRequêteSQL(Reqsqlpeinture,hRequêteDéfaut,txtreq) ALORS
         	POUR TOUT Reqsqlpeinture
         		SI tableaudateComparatif[Reqsqlpeinture.client] = Null ALORS
         			tempComparatif = allouer un Comparatif
         			tempComparatif.AnneeCourante = Reqsqlpeinture.peinturecarrelage
         			tableaudateComparatif[Reqsqlpeinture.client] = tempComparatif
         		SINON
         			tableaudateComparatif[Reqsqlpeinture.client].AnneeCourante += Reqsqlpeinture.peinturecarrelage
         		FIN
         	FIN
         FIN
         txtreq = ChaîneConstruit(txtreqsqlPeinture,Gauche(datedebuttrimestre,6),Gauche(datefinTrimestre,6),LaCondition )
         
         SI HExécuteRequêteSQL(Reqsqlpeinture,hRequêteDéfaut,txtreq) ALORS
         	POUR TOUT Reqsqlpeinture
         		SI tableaudateComparatif[Reqsqlpeinture.client] = Null ALORS
         			tempComparatif = allouer un Comparatif
         			tempComparatif.Trimestreencours = Reqsqlpeinture.peinturecarrelage
         			tableaudateComparatif[Reqsqlpeinture.client] = tempComparatif
         		SINON
         			tableaudateComparatif[Reqsqlpeinture.client].Trimestreencours += Reqsqlpeinture.peinturecarrelage
         		FIN
         	FIN
         FIN
         
         txtreq = ChaîneConstruit(txtreqsqlPeinture,Gauche(datedebutanneeprecedent,6),Gauche(datefinanneeprecedent,6),LaCondition )
         SI HExécuteRequêteSQL(Reqsqlpeinture,hRequêteDéfaut,txtreq) ALORS
         	POUR TOUT Reqsqlpeinture
         		SI tableaudateComparatif[Reqsqlpeinture.client] = Null ALORS
         			tempComparatif = allouer un Comparatif
         			tempComparatif.AnneePrecedente = Reqsqlpeinture.peinturecarrelage
         			tableaudateComparatif[Reqsqlpeinture.client] = tempComparatif
         		SINON
         			tableaudateComparatif[Reqsqlpeinture.client].AnneePrecedente += Reqsqlpeinture.peinturecarrelage
         		FIN
         	FIN
         FIN
         txtreq = ChaîneConstruit(txtreqsqlPeinture,Gauche(datedebuttrimestreprecedent,6),Gauche(datefinTrimestreprecedent,6),LaCondition )
         
         SI HExécuteRequêteSQL(Reqsqlpeinture,hRequêteDéfaut,txtreq) ALORS
         	POUR TOUT Reqsqlpeinture
         		SI tableaudateComparatif[Reqsqlpeinture.client] = Null ALORS
         			tempComparatif = allouer un Comparatif
         			tempComparatif.TrimestrePrecedent = Reqsqlpeinture.peinturecarrelage
         			tableaudateComparatif[Reqsqlpeinture.client] = tempComparatif
         		SINON
         			tableaudateComparatif[Reqsqlpeinture.client].TrimestrePrecedent += Reqsqlpeinture.peinturecarrelage
         		FIN
         	FIN
         FIN
         
         
         	
         	
         	
         //FIN
         
         
         sablier(faux)
         iconfigure(imprimanterapport,vrai)
         iParamètre("DEFAUT=NON")
         iParamètre("QUALITE=HAUTE")
         iParamètre("ORIENTATION=PAYSAGE")
         si rappventedetailperiode.destination = 2 alors
         	iapercu(1,"Rapport de vente")
         fin
         selon gFormatFacture
         	cas 1
         		selon cselFormat
         			cas 1
         				iParamètre("FORMATPAPIER=LEGAL")
         				iimprimeetat(Rapportventedetailperiode,tableaudate)
         			cas 2
         				iParamètre("FORMATPAPIER=LETTRE")
         				iimprimeetat(rapportventedetailperiode11pouce,tableaudate)
         		fin
         		
         	cas 2
         		selon rappventedetailperiode.selectclient
         			cas 1,2
         				iParamètre("FORMATPAPIER=LETTRE")
         				iimprimeetat(rapportventedetailperiodeTRN11pouce,tableaudate,tableaudateComparatif)
         			cas 3
         				iParamètre("FORMATPAPIER=LETTRE")
         				iimprimeetat(RapportventedetailperiodeTRNtous,tableaudate,tableaudateComparatif)
         				
         				
         		fin
         fin
         
         //TableVersExcel(TableExcel,"c:\documents\novy\VenteGlobal.xls")
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BOUTON4
    identifier : 0x46192bc3489cb361
    internal_properties : 
    properties :
     x : 640
     y : 114
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         //conditiondeselection est une chaine
         memcree("zonefacture")
         //clederecherche EST UNE CHAINE 
         //Code WinDev 5.5 remplacé par la migration :
         //numerovue est un entier long
         numerovue est un entier  
         choixrapport est une chaine
         choixsommaire est un booleen  
         tableaudate est un tableau de 8 chaines
         datedebutannee est une chaine= config.canneeencoursdebut
         datefinannee est une chaine= ventefin
         datedebutanneeprecedent est une chaine
         datefinanneeprecedent est une chaine
         datedebutperiodeprecedent est une chaine
         datefinperiodeprecedent est une chaine
         Rang est un entier
         Indice est un entier
         ligne est une chaine
         Rang = 1
         datedebutperiodeprecedent = numeriqueverschaine(val(dateverschaine(ventedebut,"AAAA"))-1,"4d")
         //datedebutanneeprecedent =dateverschaine(datedebutanneeprecedent+droite(datedebutannee,4))
         datedebutperiodeprecedent =datedebutperiodeprecedent+droite(ventedebut,4)
         
         datefinperiodeprecedent = numeriqueverschaine(val(dateverschaine(ventefin,"AAAA"))-1,"4d")
         //datedebutanneeprecedent =dateverschaine(datedebutanneeprecedent+droite(datedebutannee,4))
         datefinperiodeprecedent =datefinperiodeprecedent+droite(ventefin,4)
         
         datedebutanneeprecedent = numeriqueverschaine(val(dateverschaine(datedebutannee,"AAAA"))-1,"4d")
         //datedebutanneeprecedent =dateverschaine(datedebutanneeprecedent+droite(datedebutannee,4))
         datedebutanneeprecedent =datedebutanneeprecedent+droite(datedebutannee,4)
         datefinanneeprecedent = datefinperiodeprecedent
         tableaudate[1] =  ventedebut
         tableaudate[2] =  ventefin
         tableaudate[3] =  datedebutannee
         tableaudate[4] =  datefinannee
         tableaudate[5] =  datedebutanneeprecedent
         tableaudate[6] =  datefinanneeprecedent
         tableaudate[7] =  datedebutperiodeprecedent
         tableaudate[8] =  datefinperiodeprecedent
         
         
         selon rappventedetail.selectclient
         cas 3
         Boucle
          	Indice = ListeSelect("CHOIXCLIENT", Rang)
         	Si Indice<>-1 alors
         		// Ajoute l'élément sélectionné dans ListeSel
                 hlitrecherche("hfacture","faclient",choixclient[Indice])
         //Code WinDev 5.5 remplacé par la migration :
         //		tantque pas h.endehors et hfacture.faclient = choixclient[Indice]
         		tantque pas HEnDehors() et hfacture.faclient = choixclient[Indice]
             	   
                    si hfacture.fadate >=  datedebutanneeprecedent et hfacture.fadate <=  datefinanneeprecedent alors
         			ajoutedetail(hfacture.fanofacture)
         		   fin
                    si hfacture.fadate >=  datedebutannee et hfacture.fadate <=  datefinannee alors
         			ajoutedetail(hfacture.fanofacture)
         		   fin
         //			info(hfacture.fanofacture)
         //			memajoute("zonefacture",h.numenr,h.numenr)
         			hlitsuivant("hfacture","faclient")
         		FIN
         		//ligne+=choixclient[Indice] //+ "_"
         	Sinon 
         		Sortir     // Sort de la boucle
         	Fin
         	Rang++
         Fin 
         cas 1
                 hlitpremier("hfacture","faclient")
         //Code WinDev 5.5 remplacé par la migration :
         //		tantque pas h.endehors 
         		tantque pas HEnDehors() 
             	   
         //           si hfacture.fadate >=  ventedebut et hfacture.fadate <=  ventefin alors
                    si hfacture.fadate >=  datedebutanneeprecedent et hfacture.fadate <=  ventefin alors
         			ajoutedetail(hfacture.fanofacture)
         			fin
         //			info(hfacture.fanofacture)
         //			memajoute("zonefacture",h.numenr,h.numenr)
         			hlitsuivant("hfacture","faclient")
         		FIN
         cas 2
                 hlitrecherche("hfacture","faclient",rappventedetail.saisienumero)
         //Code WinDev 5.5 remplacé par la migration :
         //		tantque pas h.endehors et hfacture.faclient = rappventedetail.saisienumero    	   
         		tantque pas HEnDehors() et hfacture.faclient = rappventedetail.saisienumero    	   
         //           si hfacture.fadate >=  ventedebut et hfacture.fadate <=  ventefin alors
                    si hfacture.fadate >=  datedebutanneeprecedent et hfacture.fadate <=  ventefin alors
         			ajoutedetail(hfacture.fanofacture)
         			fin
         //			info(hfacture.fanofacture)
         //			memajoute("zonefacture",h.numenr,h.numenr)
         			hlitsuivant("hfacture","faclient")
         		FIN
         	
         fin	
         iconfigure(imprimanterapport,vrai)
         iParamètre("DEFAUT=NON")
         iParamètre("FORMATPAPIER=LEGAL")
         
         si rappventedetail.destination = 2 alors
          iapercu(1,"Rapport de vente")
         fin
         iimprimeetat("RAPPORTVENTEDETAIL","zonefacture",tableaudate)
         
