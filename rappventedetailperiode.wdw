  procedures :
   -
     name : ajoutedetail
     procedure_id : 5051116573748802401
     type_code : 14
     code : |1+
      Procédure ajoutedetail(numerofacture)
       hlitrecherche(hfdetail,HFCLEUNIK,numerofacture)
       
      
      //hlitrecherche("hfdetail","fdcle",numerofacture)
      
      //Code WinDev 5.5 remplacé par la migration :
      //tantque pas h.endehors et hfacture.fanofacture = hfdetail.fdnofact
      tantque pas HEnDehors() et hfdetail.HFCLEUNIK = numerofacture
         	memajoute("zonefacture",h.numenr,h.numenr)
      
      	hlitsuivant(hfdetail,HFCLEUNIK)
      	
      FIN
      
     type : 458752
   -
     name : transformChaine
     procedure_id : 2285228111365020862
     type_code : 14
     code : |1-
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] transformChaine (<ListeClient>)
      //
      // Paramètres :
      //	ListeClient : <indiquez ici le rôle de ListeClient>
      // Valeur de retour :
      // 	chaîne ANSI : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE transformChaine(ListeClient)
      TabListe est un tableau de chaînes
      ListeAretourner est une chaine 
      ChaîneVersTableau(ListeClient,TabListe,";")
      
      pour chaque Nom de TabListe
      	si Nom <> "" alors ListeAretourner += [","]+"'"+Nom+"'"
      FIN
      ListeAretourner = "(" + ListeAretourner + ")"
      renvoyer ListeAretourner
     type : 458752
  procedure_templates : []
  property_templates : []
