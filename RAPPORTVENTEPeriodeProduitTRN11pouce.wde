    properties :
     y : 50.304
     width : 269.4
     height : 4.69
    code_elements :
     type_code : 30
     p_codes :
      -
        code : |1+
         j est un entier
         jj est une chaine
         jjj est un entier
         //pour j = 1 a 12
         
         
         
         pour j = 1 a 12
         
         	si  hlitrecherche(HistoAnneeMoisProduit,hClientlComp1lcomp2lcomp3lAnneelmois,...
         		HConstruitValClé(HistoAnneeMoisProduit,hClientlComp1lcomp2lcomp3lAnneelmois,sansespace(RequeteVenteproduitFiltre.hClient),...
         		RequeteVenteproduitFiltre.lProduit,RequeteVenteproduitFiltre.lComp1,RequeteVenteproduitFiltre.lcomp2,RequeteVenteproduitFiltre.lcomp3,...
         		lperiode[j,2],lperiode[j,1])) alors
                 NUMEROProduit = HistoAnneeMoisProduit.lProduit
                 DescriptionProduit = HistoAnneeMoisProduit.ldescription	
         		{"totalclient"+j} = HistoAnneeMoisproduit.lvente+HistoAnneeMoisProduit.lsurcharge
         //		{"totalsecteur"+j} += HistoAnneeMoisproduit.lvente
         		{"toussecteur"+j} += HistoAnneeMoisproduit.lvente+HistoAnneeMoisProduit.lsurcharge+HistoAnneeMoisProduit.peinturecarrelage
         		{"totalpeinture"+j}  += HistoAnneeMoisProduit.peinturecarrelage
             fin
         fin
             
             
             
             
             
         
         
         
         
        type : 327692
      -
        type : 327697
        enabled : false
