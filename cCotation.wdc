  p_codes :
   -
     code : |1+
      cCotation est une Classe <MAPPING=Cotation>
      	
      	// Le code se trouvant entre <MAPPING> et <FIN> est généré automatiquement.
      	// Il sera effacé et recréé entièrement à chaque génération depuis le menu contextuel
      	// du fichier dans l'explorateur de projet "..Regénérer la classe modèle".
      	<MAPPING>
      	m_nIDCotation							est un entier sur 8 octets				<MAPPING =IDCotation, clé unique>
      	m_dCotationDate							est une Date							<MAPPING =CotationDate>
      	m_sIdentification						est une chaîne ANSI						<MAPPING =identification>
      	m_sJobNumber							est une chaîne							<MAPPING = Jobnumber>
      	m_nCurrentUserID						est un entier							<MAPPING = idCustomer>
      	m_moCotationTotal						est un monétaire						<MAPPING = CotationTotal>
      	m_moFifteenYearsWarrantyTotal			est un monétaire						<MAPPING = FifteenYearsWarrantyTotal>
      	m_moExtraArgonGazTotal					est un monétaire						<MAPPING = ExtraArgonGazTotal>
      	m_sCalculType							est une chaîne							<MAPPING = calculType>
      	m_sCotationNumber						est une chaîne							<MAPPING = CotationNumber>
      	m_bOrderSended							est un booléen							<MAPPING =  sended>
      	m_dRequireddate							est une Date							<MAPPING = RequiredDate>
      	m_nShippingAddressID					est un entier							<MAPPING = ShippingAddressID>
      	m_nTruckID								est un entier							<mapping = TruckID>
      	
      	
      	<FIN>
      	
      	m_tabCotationdetails est un tableau de cCotationDetails
      	
      FIN
      
