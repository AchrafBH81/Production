    code_elements :
     type_code : 30
     p_codes :
      -
        code : |1+
         //compteur est un entier = 1
         hlitrecherche("spinter","spcleclientproduitnumero",numeroclient+invent.inum+caract(0))
         
         //Code WinDev 5.5 remplacé par la migration :
         //tantque pas h.endehors et ...
         tantque pas HEnDehors() et ...
         	numeroclient+invent.inum = ...
         	spinter.spclient+spinter.spproduit
         compteur++
         hlitsuivant("spinter","spcleclientproduitnumero")
         
         fin
         //Code WinDev 5.5 remplacé par la migration :
         //si (compteur * 5) + _.debv > ihauteurpage() alors
         si (compteur * 5) + iHauteurRestantePage() > ihauteurpage() alors
            iterminepage()
         fin						  
         
        type : 327692
      -
        code : |1+
         //Code WinDev 5.5 remplacé par la migration :
         // IIMPRIMEETAT("LIGNEESCVERREUNITE",numeroclient+invent.INUM,numeroclient+invent.INUM)
          iHautBasPageImbriqué(Vrai); iImprimeEtat("LIGNEESCVERREUNITE",numeroclient+invent.INUM,numeroclient+invent.INUM)
         
        type : 327693
      -
        type : 327697
        enabled : false
 controls : []
 code_elements :
  type_code : 13
  p_codes :
   -
     code : |1+
      Procedure _LISTE_BASE_PIED_CLIENT(_pParam1="", _pParam2="", _pParam3="", _pParam4="")
      
      GLOBAL
      numeroclient est une chaine = _pparam1
      compteur est un entier
      si pas gImprimeCondPMT alors
      	GrpCondPmt..visible=faux
      FIN
      
     type : 327680
   -
     code : |1-
      
     type : 327695
  procedures :
   -
     name : assigneLibelle
     procedure_id : 5275291165167036740
     type_code : 14
     code : |1-
      Procédure assigneLibelle()
      i est un entier
      
      lTableauLibelle est un tableau de 9 chaines
      lTableauLibelle[1]  = "lentete,lentete"
      lTableauLibelle[2]  = "lvigueur,lvigueur"
      lTableauLibelle[3]  = "lremplace,lremplace"
      lTableauLibelle[4]  = "lverreunite,lverreunite"
      lTableauLibelle[5]  = "lnumero,lnumero"
      lTableauLibelle[6]  = "facdescription,facdescription"
      lTableauLibelle[7]  = "langlais,Langlais"
      lTableauLibelle[8]  = "lmetrique,lmetrique"
      lTableauLibelle[9]  = "lcondpaiement,LCondpaiement"
      
      selon client.CLangue
      	cas 1
      		pour i = 1 a 9
      			si hlitrecherche(Traduction,TRecherche,extraitchaine(lTableauLibelle[i],1,",")) alors
      				{"ListeVerreUniteClientHisto."+ExtraitChaîne(lTableauLibelle[i],2,",")} = traduction.dFrancais
      			fin
      		FIN
      	cas 2
      		pour i = 1 a 9
      			si hlitrecherche(Traduction,TRecherche,extraitchaine(lTableauLibelle[i],1,",")) alors
      				{"ListeVerreUniteClientHisto."+ExtraitChaîne(lTableauLibelle[i],2,",")} = traduction.danglais
      			fin
      		FIN
      fin
     type : 458752
  procedure_templates : []
  property_templates : []
