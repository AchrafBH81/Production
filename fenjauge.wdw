 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1+
      // - Utilisez cette fenêtre en tant que fenêtre fille de la fenêtre effectuant le traitement
      // - Régulièrement, renseignez cette fenêtre de la progression du traitement en utilisant
      // la fonction Execute: Execute("FenJauge.Progression",Valeur) // Valeur est un pourcentage
      // - Refermez la fenêtre 
      
      // Exemple de traitement utilisant cette fenêtre: 'FenGen' étant le nom de cette fenêtre
      // 	i est un entier
      // 	OuvreFille("FenGen.wdw")
      // 	Pour i=1 a 100
      // 		Execute("FenGen.Progression",i) // i est compris entre 0 et 100,
      //										// i est le pourcentage de progression
      // 	Fin
      // 	Ferme("FenGen")
      procedure fenjauge(fentitre)
      
      // Pour compatibilité 5.5
      MoiMême..Visible=Vrai
      
        fenjauge.titre = fentitre
        multitache
      
