 menu :
  name : _Menu
  identifier : 0x3e9d90c830449a75
  internal_properties : 
  options : []
 languages :
  - fr-FR
 popup_menus : []
 message_bar :
  internal_properties : CQAAAAkAAACmjuBzz8CGl3hd7dPnHYkTCIxEkXAY2TVT2ApGuCAWtu3GvVyFQSkzWoQs3DXmlCkTflIz+46mZeZTHk/TQ32CRK4B0eFIK1NpGM/X85GoU5JHKTPg2gabptn64Q==
 actionbar : {}
 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1+
      
      // Pour compatibilité 5.5
      MoiMême..Visible=Vrai
      
      j est un entier
      hinfogene("videojet")
      
      // Migration : Déplacement de variables globales
      global
      resultat est une chaine
      TH est une chaine = sansespace(config.vjthermafix)
      SN est une chaine = sansespace(config.vjstnazaire)
      IG est une chaine = sansespace(config.texteigma)
      v1 est une chaine = sansespace(config.vjvariable1)
      v2 est une chaine = sansespace(config.vjvariable2)
      v3 est une chaine = sansespace(config.vjvariable3)
      v4 est une chaine = sansespace(config.vjvariable4)
      LW est une chaine = sansespace(config.vjlw)
      Z est une chaine = sansespace(config.vjz)
      VCO est une chaine = "C1234"
      DT est une chaine = sansespace(DATEVERSCHAINE(DATESYS(),config.cformatdedate))
      CT est une chaine = "T9876"
      SPA est une chaine = "7/8"
      CL est une chaine = "Le nom du client"
      CD est une chaine = "1234567890"
      DI est une chaine = "1234X5678"
      FL est une chaine = "V"
      LI est une chaine = "12"
      CP est une chaine = "Cap"
      formule est une chaine = ""
      NU est une chaine = "999999-999"
      BA est une chaine = "101"
      NJ est une chaine = "Job 1234"
      
      
      si h.nbenr = 0 alors
      	pour j = 1 a 20
      		videojet.videonumero = j
      		hajoute("videojet")	
      	FIN
      fin
      pour j = 1 a 20
      	hlitrecherche("videojet","videonumero",sansespace(NumériqueVersChaine(j,"2d")),hIdentique)
      	
      	tableajoute("TABLE1",videojet.videonumero+tab+videojet.videodescription)
      FIN
      hlitpremier("config","COCLEUNIK")
      
   -
     type : 180
     enabled : false
   -
     type : 230
     enabled : false
   -
     type : 11
   -
     type : 12
   -
     type : 17
   -
