      -
        code : |1+
         j est un entier
         
         pour j = 1 a 20
         	hlitrecherche("videojet","videonumero",novideojet[j])
         //Code WinDev 5.5 remplacé par la migration :
         //	si pas h.endehors alors
         	si pas HEnDehors() alors
         //Code WinDev 5.5 remplacé par la migration :
         //		si h.trouve alors
         		si HTrouve() alors
         			videojet.videodescription = lignevideojet[j]
         			hmodifie("videojet")
         		FIN
         	FIN
         	
         FIN
         
