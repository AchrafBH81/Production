  -
    name : Btn_Ok
    identifier : 0x4767503272929f80
    internal_properties : 
    properties :
     x : 427
     y : 47
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         //requeteDétailCommandeUnJour.pDateCommande = csddatedebut
         //HExécuteRequête(requeteDétailCommandeUnJour)
         
         
         requeteDétailCommandeUnJour1.pDateCommande = csddatedebut
         HExécuteRequête(requeteDétailCommandeUnJour1)
         //hcreation(trdetailListe)
         SI PAS HSupprimeTout(trdetailListe) ALORS
         	Erreur(HErreurInfo(hErrMessage))
         	RENVOYER Faux
         FIN
         pour tout requeteDétailCommandeUnJour1
         	HCopieEnreg(trdetailListe,requeteDétailCommandeUnJour1)
         	trdetailListe.TNoclient = requeteDétailCommandeunjour1.faclient
         	trdetailListe.Tsurcharge = requeteDétailCommandeUnJour1.fsurchargepeinture
         	trdetailliste.surchargeenergie = requeteDétailCommandeUnJour1.surchargeenergie * requeteDétailCommandeUnJour1.fdqteafacturer / requeteDétailCommandeUnJour1.fdqte
         	hajoute(trdetailListe)
         FIN
         
         hexecuterequete(RequetecommandeunjourFacture,hRequêteDéfaut,csddatedebut)
         pour tout RequetecommandeunjourFacture
         	HCopieEnreg(trdetailListe,RequetecommandeunjourFacture)
         	trdetailListe.TNoclient = RequetecommandeunjourFacture.faclient
         	trdetailListe.Tsurcharge = requeteCommandeUnJourfacture.fsurchargepeinture
         	hajoute(trdetailListe)
         FIN
         
         
         iConfigure(imprimanterapport)
         SI SélecteurDestination = 1 ALORS
         	iAperçu()
         FIN
         si pas IntParVendeur alors
         	HExécuteRequête(RequeteDetailUnJourV1)
         	iImprimeEtat(EVenteJourV1,csddatedebut)
         sinon
         	RequeteQuotidienVendeurTypeClient.PVendeur = (Combo_Vendeur = 0 ? null sinon Combo_Vendeur)
         	HExécuteRequête(RequeteQuotidienVendeurTypeClient)
         	iImprimeEtat(EVenteJourParVendeurTypeClient,csddatedebut,Combo_Vendeur = "0" ? 0 SINON Combo_Vendeur)
         //	RequeteDetailUnJourV1ParVendeur.pVendeur = (Combo_Vendeur = 0 ? Null SINON Combo_Vendeur)	
         //	HExécuteRequête(RequeteDetailUnJourV1parvendeur)
         //	iImprimeEtat(EVenteJourParVendeur,csddatedebut,Combo_Vendeur = "0" ? 0 sinon Combo_Vendeur)
         fin
         
         
        type : 18
      -
        type : 161
        enabled : false
