   -
     name : debloquefiche
     procedure_id : 4511921534688322941
     type_code : 14
     code : |1+
      Procédure debloquefiche()
      
      //Code WinDev 5.5 remplacé par la migration :
      //numeroenr est un entier long
      numeroenr est un entier  
      
      numeroenr = tablenumenr("TABLE")
      
      si numeroenr > 0 alors
      	boucle
      		hdebloquenumenr("invent",numeroenr)
      //Code WinDev 5.5 remplacé par la migration :
      //		si pas hdejabloque() alors sortir
      		si pas HErreurBlocage() alors sortir
      	FIN
      FIN
      
     type : 458752
   -
     name : modifierfiche
     procedure_id : 4511921535617426823
     type_code : 14
     code : |1+
      Procédure modifierfiche()
      x est un entier = 0
      si moimeme..modifie et modif alors
      	    ecranversfichier("produits","invent")
      		si sansespace(invent.Ipbase) = valeuroriginale alors
      			invent.ipbase = produits.numpro
      		FIN
      		si sansespace(invent.ipextra) = valeuroriginale alors
      			invent.Ipextra = produits.numpro
      		FIN
      		si sansespace(invent.ipextrat) = valeuroriginale alors
      			invent.Ipextra = produits.numpro
      		FIN
      	   
       	    hmodifie("invent")
      //Code WinDev 5.5 remplacé par la migration :
      //        si hdoublon() alors
              si HErreurDoublon() alors
      			info(h.numenr)
      		FIN
      	 fichierversecran
      	 
      	 
      	 hlitpremier("invent","INUM")
      //Code WinDev 5.5 remplacé par la migration :
      //	 tantque pas h.endehors
      	 tantque pas HEnDehors()
      	  si pas sansespace(invent.INUM) = sansespace(produits.numpro) alors
      	    si sansespace(invent.Ipbase) = valeuroriginale alors
      			invent.ipbase = produits.numpro
      		FIN
      		si sansespace(invent.ipextra) = valeuroriginale alors
      			invent.Ipextra = produits.numpro
      		FIN
      		si sansespace(invent.ipextrat) = valeuroriginale alors
      			invent.Ipextra = produits.numpro
      		FIN
      	    hmodifie("invent")
      //Code WinDev 5.5 remplacé par la migration :
      //        si hdoublon() alors
              si HErreurDoublon() alors
      			info(h.numenr)
      		FIN
      	   fin
      		hlitsuivant("invent","INUM")
            
           fin
           HRETOURPOSITION(POS_INV) 
      	 hlitpremier("ENSEMBLE","ennumero")
      	 
      //Code WinDev 5.5 remplacé par la migration :
      //	 tantque pas h.endehors 
      	 tantque pas HEnDehors() 
      		hinfogene("ENSEMBLE")
      	    si sansespace(ENSEMBLE.encomposant1) = valeuroriginale alors
      			ENSEMBLE.encomposant1 = produits.numpro
      		FIN
      		si sansespace(ENSEMBLE.encomposant2) = valeuroriginale alors
      			ENSEMBLE.encomposant2 = produits.numpro
      		FIN
      		si sansespace(ENSEMBLE.encomposant3) = valeuroriginale alors
      			ENSEMBLE.encomposant3 = produits.numpro
      		FIN
      	    hmodifie("ensemble")
      //Code WinDev 5.5 remplacé par la migration :
      //        si hdoublon() alors
              si HErreurDoublon() alors
      			info(h.numenr)
      		FIN
      		hlitsuivant("ENSEMBLE","ennumero") 
      	 FIN
      	  
      	 
      	 
      	 
      	 
      //Code WinDev 5.5 remplacé par la migration :
      //     execute("btn_ok..cli")
           ExecuteTraitement("btn_ok",TRTclic)
      FIN
      
     type : 458752
   -
     name : valide_champ
     procedure_id : 4511921535925446073
     type_code : 14
     code : |1+
      Procédure valide_champ()
      valeuraretourner est un booleen = vrai
      
      selon produits.ptype
      	
      cas 1
      	si (produits.iprixfuturdouble <> 0 ou ...
      	 produits.iprixfuturtriple <> 0 ou ...
      	 produits.iprixfuturdouble_m <> 0 ou ...
      	 produits.iprixfuturtriple_m <> 0) et produits.idateprixfutur = "" alors
      	   valeuraretourner = faux
      	fin
      cas 2
      	si ( produits.iprixfuturtriplem <> 0 ...
      		ou produits.iprixfuturu <> 0) ...
      		et produits.idateprixfutur = "" alors
      	   valeuraretourner = faux
      	fin
      cas 3
      	
      cas 4
      	si ( produits.iprixfuturbasecarrelage <> 0 ...
      		ou produits.iprixfuturcarreau <> 0) ...
      		et produits.idateprixfutur = "" alors
      	   valeuraretourner = faux
      	
      	fin
      	
      	
      FIN
      
      renvoyer valeuraretourner
      
     type : 458752
   -
     name : allumebouton
     procedure_id : 5054773653525681102
     type_code : 14
     code : |1+
      Procédure allumebouton()
      EteintBouton()
      //message(gauche({ChampEnCours()}..nom,15))
      si champencours <> "" et gauche({ChampEnCours()}..nom,15) = "IProduitAssocie" alors
      		BtnRecherche..x = {ChampEnCours()}..x + {ChampEnCours()}..Largeur  
      		BtnRecherche..y ={ChampEnCours()}..y 
      		btnrecherche..visible = vrai
      fin
      
      
      
      
     type : 458752
   -
     name : EteintBouton
     procedure_id : 5054773721485480229
     type_code : 14
     code : |1-
      Procédure EteintBouton()
      
      btnrecherche..visible = faux
     type : 458752
   -
     name : LoseFocus
     procedure_id : 5054777248193943816
     type_code : 14
     code : |1+
      Procédure LoseFocus()
      EteintBouton()
      lchampNom est une chaine
      si champprecedent() <> "" alors
      	si gauche({champprecedent()}..nom,15) = "IProduitAssocie" alors
      		norecencours est un entier = HSauvePosition(invent)
      		si sansespace(champprecedent()) <> "" alors
      			lchampNom = {champprecedent()}..nom[[25 a ]]
      			si hlitrecherche(invent,INUM,{champprecedent()}) alors
      				{"cstDescriptionProduit"+lchampNom} = invent.idesc
      			sinon
      				acso_message("Erreur","Produit inexistant dans le fichier","Erreur")
      				moimeme = ""
      				reprisesaisie()
      			FIN
      		FIN
      		
      		HRetourPosition(norecencours)
      	fin
      fin
      
      
      
      
     type : 458752
   -
     name : ValideFourniture
     procedure_id : 5054803537064361573
     type_code : 14
     code : |1+
      Procédure ValideFourniture(ltypecarrelage)
      i est un entier
      si hlitrecherche(typecarr,tcdescription,ltypecarrelage) alors
      	pour i = 1 a 10
      		si sansespace(typecarr.TformuleQteFourniture[i]) <> "" alors
      			{"IProduitAssocieCarrelage"+i}..etat = actif
      		sinon
      			{"IProduitAssocieCarrelage"+i}..etat = grise
      		FIN
      	fin	
      FIN
      
     type : 458752
   -
     name : EteintFourniture
     procedure_id : 5054808086586467625
     type_code : 14
     code : |1+
      Procédure EteintFourniture()
      i est un entier
      pour i = 1 a 10
      	{"IProduitAssocieCarrelage"+i}..etat = grise
      fin	
      
     type : 458752
   -
     name : modifiernumero
     procedure_id : 5589144225369726685
     type_code : 14
     code : |1+
      Procédure modifiernumero(_nouveau,_ancien)
      si produits.ptype = 1 alors
      	sablier(vrai)
      	pour tout persoens
      		si persoens.encomposant1 = _ancien alors
      			persoens.encomposant1 = _nouveau
      		FIN
      		si persoens.encomposant2 = _ancien alors
      			persoens.encomposant2 = _nouveau
      		FIN
      		si persoens.encomposant3 = _ancien alors
      			persoens.encomposant3 = _nouveau
      		FIN
      		hmodifie(persoens,hNumEnrEnCours)
      	FIN
      	pour tout Fdetail
      		si fdetail.fdcomposant1 = _ancien alors
      			fdetail.fdcomposant1 = _nouveau
      		FIN
      		si fdetail.fdcomposant2 = _ancien alors
      			fdetail.fdcomposant2 = _nouveau
      		FIN
      		si fdetail.fdcomposant3 = _ancien alors
      			fdetail.fdcomposant3 = _nouveau
      		FIN
      		hmodifie(fdetail,hNumEnrEnCours)
      	FIN
      
      	pour tout hFdetail
      		si hfdetail.fdcomposant1 = _ancien alors
      			hfdetail.fdcomposant1 = _nouveau
      		FIN
      		si hfdetail.fdcomposant2 = _ancien alors
      			hfdetail.fdcomposant2 = _nouveau
      		FIN
      		si hfdetail.fdcomposant3 = _ancien alors
      			hfdetail.fdcomposant3 = _nouveau
      		FIN
      		hmodifie(hfdetail,hNumEnrEnCours)
      	FIN
      	
      	pour tout inter
      		si inter.icomposant1 = _ancien alors
      			inter.icomposant1 = _nouveau
      		FIN
      		si inter.icomposant2 = _ancien alors
      			inter.icomposant2 = _nouveau
      		FIN
      		si inter.icomposant3 = _ancien alors
      			inter.icomposant3 = _nouveau
      		FIN
      		hmodifie(inter,hNumEnrEnCours)
      	FIN
      	
      	pour tout FclientExtra 
      		si fclientextra.NoProduit = _ancien alors
      			fclientextra.NoProduit = _nouveau
      		    hmodifie(fclientextr,hNumEnrEnCours)
      		FIN
      	FIN
      	sablier(faux)
      
      fin
      
      
      
      
      
     type : 458752
