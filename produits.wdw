  procedures :
   -
     name : bloquefiche
     procedure_id : 4511921535446902121
     type_code : 14
     code : |1+
      Procédure bloquefiche()
      
      //Code WinDev 5.5 remplacé par la migration :
      //numeroenr est un entier long
      numeroenr est un entier  
      selon pro_onglet
      
      	cas 1
      		si table..vide alors renvoyer faux
      
      		numeroenr = tablenumenr("TABLE")
      
      		si numeroenr > 0 alors
      			//Code WinDev 5.5 remplacé par la migration :
      			//	hlitbloque("invent",numeroenr)
      			hlit("invent",numeroenr,HBlocageEcriture)
      			//Code WinDev 5.5 remplacé par la migration :
      			//	si hdejabloque() alors
      			si HErreurBlocage() alors
      				Erreur("Cette information est deja utilisée sur un autre poste")
      				renvoyer faux
      			FIN
      			//Code WinDev 5.5 remplacé par la migration :
      			//	si pas h.actif alors
      			si pas (HEtat()=HEtatActif) alors
      				erreur("Cette fiche à été supprimée par un autre poste")
      				//Code WinDev 5.5 remplacé par la migration :
      				//		tableaffiche("TABLE","*")
      				tableaffiche("TABLE",taCourantPremier)
      				renvoyer faux
      			FIN
      		FIN
      
      
      		renvoyer vrai
      
      	cas 8
      		si table..vide alors renvoyer faux
      
      		numeroenr = tablenumenr("TABLE")
      
      		si numeroenr > 0 alors
      			//Code WinDev 5.5 remplacé par la migration :
      			//	hlitbloque("invent",numeroenr)
      			hlit("invent",numeroenr,HBlocageEcriture)
      			//Code WinDev 5.5 remplacé par la migration :
      			//	si hdejabloque() alors
      			si HErreurBlocage() alors
      				Erreur("Cette information est deja utilisée sur un autre poste")
      				renvoyer faux
      			FIN
      			//Code WinDev 5.5 remplacé par la migration :
      			//	si pas h.actif alors
      			si pas (HEtat()=HEtatActif) alors
      				erreur("Cette fiche à été supprimée par un autre poste")
      				//Code WinDev 5.5 remplacé par la migration :
      				//		tableaffiche("TABLE","*")
      				tableaffiche("TABLE1",taCourantPremier)
      				renvoyer faux
      			FIN
      		FIN
      
      
      		renvoyer vrai
      autres cas
              renvoyer vrai
      fin
     type : 458752
   -
     name : clicfenetre
     procedure_id : 4511921535886386557
     type_code : 14
     code : |1+
      Procédure clicfenetre()
      
      info(_eve.wMessage)
      
