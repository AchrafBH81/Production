               //Code WinDev 5.5 remplacé par la migration :
               // tableauprix..etat = actif
                tableauprix..etat = actif; tableauprix..Visible=Vrai
                si tableauprix alors
               	si ajout ou modif alors	
               		produits.btn_tableau..etat = actif
                   sinon
               //Code WinDev 5.5 remplacé par la migration :
               //		produits.btn_tableau..etat = inactif
