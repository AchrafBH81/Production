            -
              code : |1+
               
               selon moimeme
               cas 1
                
               //Code WinDev 5.5 remplacé par la migration :
               // boite..etat = grisé
                boite..etat = grisé; boite..Visible=Vrai
               //Code WinDev 5.5 remplacé par la migration :
               // iprixunite..etat = actif
                iprixunite..etat = actif; iprixunite..Visible=Vrai
