           -
             internal_properties : CQAAAAkAAADUnWWwugtP1ThCKfs438qO6FYYhE0SXfcd+J9+b92Ey0EThE0Ae3NWqh8JWGnJ+a3TX0RnhZHN/Z4f1keD4+RvkwNdJIcmYh/Lde0f5N8Q5Vt8Gp11xrax8YRJ6TM+MjLaBaPIGAIq41+RbYenNk03NR+DdYBl25Z2sUk=
          type : 6
          controls : []
          code_elements :
           type_code : 6
           p_codes :
            -
              code : |1-
               
               
               selon moimeme
               	cas 1
               		hfiltre(invent,itypeiactif,hconstruitvalcle(invent,itypeiactif,1,1))
               	cas 2
               		hfiltre(invent,itypeiactif,hconstruitvalcle(invent,itypeiactif,2,1))
               	cas 3
               		hfiltre(invent,itypeiactif,hconstruitvalcle(invent,itypeiactif,3,1))
               	cas 4
               		hfiltre(invent,itypeiactif,hconstruitvalcle(invent,itypeiactif,4,1))
               	cas 5
               		hfiltre(invent,itypeiactif,hconstruitvalcle(invent,itypeiactif,5,1))
               
               
               FIN
               
               tableaffiche(table,tadebut)
               TableSelectPlus(table,1)
               ExécuteTraitement(table,trtSélection)
               si table..vide alors
               	numpro = ""
               	saisie_desc = ""
               	SAISIE_DESCA = ""
               	idesccourte = ""
               	inumprodfrn = ""
               	SAISIE_DESCFRN = ""	
               	PRO_ONGLET[2]..etat = grise
               	PRO_ONGLET[3]..etat = grise
               	PRO_ONGLET[4]..etat = grise
               	PRO_ONGLET[5]..etat = grise
               	PRO_ONGLET[6]..etat = grise
               
               FIN
              type : 17
