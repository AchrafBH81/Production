               sinon
               	iprixventepeintureM..visible = vrai
               	iprixFuturventepeintureM..visible  = vrai
               	LibelleMetrique..visible = vrai
               	LibelleAnglais = "Anglais"
               FIN
               si moimeme = 3 alors
               	GrpCouleur..visible = vrai
               sinon
               	GrpCouleur..visible = faux
               
               FIN
               
               ExécuteTraitement(iprixventepeinture,trtSortie)
               ExécuteTraitement(iprixfuturventepeinture,trtSortie)
               
               //ExécuteTraitement(iprixunitecoutantFourniture,trtSortie)
