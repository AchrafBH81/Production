   -
     code : |1-
      //entete..VISIBLE = FAUX
      
      // Pour compatibilité 5.5
      MoiMême..Visible=Vrai
      i est un entier
      lFournitureActif est un tableau de 10 booleen
      
      //numeroevenement[1] = evenement("DOUBLECLIC","dateprixfutur",WM_LBUTTONDBLCLK)
      //numeroevenement[2] = evenement("DOUBLECLIC","btn_pbase",WM_LBUTTONDBLCLK)
      //numeroevenement[3] = evenement("DOUBLECLIC","btn_pextra",WM_LBUTTONDBLCLK)
      //numeroevenement[4] = evenement("DOUBLECLIC","btn_pextrat",WM_LBUTTONDBLCLK)
      INITCOMBO(combo_categorie,"Categori","Description","cnumero")
      INITCOMBO(combomesure,"Mesure","unitedescription","unitedescription")
      
      //Code WinDev 5.5 remplacé par la migration :
      //navigation..etat = grisé
      navigation..etat = grisé; navigation..Visible=Vrai
      cleparcours = "inum"
      //execute("pro_onglet..clic")
      //pro_onglet = 1
      //global 
      pos_inv est un entier  // position dans le fichier inventaire
      valeuroriginale est une chaine
      //--Traitement d'ouverture de la fenêtre-------------------------------------------------------
      //--début code généré par l'assistant --
      //initialisation de la combo auto alimentée (à placer en ouverture de fenêtre)
      
      hlitpremier("config","COCLEUNIK")
      tauxconversionam = config.conversionam
      tauxconversionma = config.conversionma
      hfiltre(invent,"iactif=1")
      
      //--fin code généré par l'assistant --
      Evénement("allumebouton",".*",WM_SETFOCUS)
      Evénement("losefocus",".*",WM_killFOCUS)
      ExécuteTraitement(PRO_ONGLET,trtModification)
      ExécuteTraitement(pfiltre,trtModification)
