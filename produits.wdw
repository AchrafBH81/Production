         	fichierversecran(produits,invent)
         	valeuroriginale = sansespace(produits.numpro)
         
         	//Code WinDev 5.5 remplacé par la migration :
         	//entete..etat = actif
         	entete..etat = actif; entete..Visible=Vrai
         	//Code WinDev 5.5 remplacé par la migration :
         	//navigation..etat = GRISé
         	navigation..etat = GRISé; navigation..Visible=Vrai
         	//Code WinDev 5.5 remplacé par la migration :
         	//validation..etat = actif
         	validation..etat = actif; validation..Visible=Vrai
         	//Code WinDev 5.5 remplacé par la migration :
         	//fiche..etat = grisé
         	fiche..etat = grisé; fiche..Visible=Vrai
         	//Code WinDev 5.5 remplacé par la migration :
         	//saisie_base..etat = inactif
         	saisie_base..etat = AffichageSeulement; saisie_base..Visible=Vrai
         	//Code WinDev 5.5 remplacé par la migration :
         	//SAISIE_PRODUIT..etat = actif
         	SAISIE_PRODUIT..etat = actif; SAISIE_PRODUIT..Visible=Vrai
         	//Code WinDev 5.5 remplacé par la migration :
         	//numpro..etat = grisé
         	pfiltre..visible = faux
         	ptype..visible = vrai
         	numpro..etat = grisé; numpro..Visible=Vrai
         	modif = vrai
         
         
         	//ecranpremier("IUNITA")
         	selon ptype
         
         		cas 1
         			//Code WinDev 5.5 remplacé par la migration :
         			//saisie_verre..etat = actif
         			saisie_verre..etat = actif; saisie_verre..Visible=Vrai
         
         		cas 2
         			//Code WinDev 5.5 remplacé par la migration :
         			//saisie_unite..etat = actif		
         			saisie_unite..etat = actif; saisie_unite..Visible=Vrai		
         			//Code WinDev 5.5 remplacé par la migration :
         			//execute("iunitetype..sor")
         			ExecuteTraitement("iunitetype",TRTsortie)
         
         		cas 3
         			//Code WinDev 5.5 remplacé par la migration :
         			//saisie_unite..etat = actif		
         			saisie_unite..etat = actif; saisie_unite..Visible=Vrai		
         		cas 4
         			//Code WinDev 5.5 remplacé par la migration :
         			//saisie_carrelage..etat = actif		
         			saisie_carrelage..etat = actif; saisie_carrelage..Visible=Vrai		
         			ValideFourniture(invent.itypecarr)
         		cas 5
         			//Code WinDev 5.5 remplacé par la migration :
         			//saisie_carrelage..etat = actif		
         			Saisie_peinture..etat = actif; Saisie_peinture..Visible=Vrai		
         	FIN
         	ecranpremier("saisie_desc")
         
         	maj_produit("")
         	si produits.iactif alors
         		btnactif..visible = vrai	
         	sinon
         		btninactif..visible = vrai  
         	fin
         fin
         
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_DETRUIRE
    identifier : 0x3e9d90b848345c92
    internal_properties : 
    properties :
     x : 394
     y : 2
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         drapeau est un booleen = faux
         numero_inv est une chaine = invent.inum
         pos_inv = hsauveposition("invent")
         
         si pas sansespace(numero_inv) = ""  alors
         	hlitpremier("invent","INUM")
         	//Code WinDev 5.5 remplacé par la migration :
         	//tantque pas h.endehors
         	tantque pas HEnDehors()
         		si invent.ipextra = numero_inv  ou invent.ipextrat = numero_inv alors
         			drapeau = vrai
         			sortir   
         		FIN
         		hlitsuivant("invent","INUM")
         	FIN
         fin
         HGèreIntégrité("*","*",hEnSuppression,Faux)
         si drapeau alors
         	erreur("Ce produit est un composant ou un extra","Impossible de le détruire")
         	hretourposition(pos_inv)
         sinon
         
         	si hlitrecherche(ProduitClient,Idproruit,produits.numpro) alors
         		si acso_message("Question","Ce produit à des prix spéciaux pour certains clients.En le supprimant,vous le supprimer de la liste des produits spéciaux de tous les client"+...
         			rc+"Est-ce bien ce que vous désirez ?","OuiNon") = idyes alors
         			pour tout ProduitClient  avec  "idproruit = '"+produits.numpro+"'"
         				hsupprime(produitclient,hNumEnrEnCours)			
         			FIN
         			hretourposition(pos_inv)
         			hsupprime("invent",hNumEnrEnCours)	
         		fin	
         	sinon
         		si acso_message("Question","Supprimer ce produit ?","OuiNon") = idyes alors
         			hretourposition(pos_inv)
         			hsupprime("invent",hNumEnrEnCours)	
         			tableaffiche("TABLE",taCourantPremier)
         		fin	
         	FIN
         FIN
         ExécuteTraitement(PTYPE,trtModification)
         ExécuteTraitement(table,trtSélection)
         restaure_bouton()
         
         HGèreIntégrité("*","*",hEnSuppression,vrai)
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_OK
    identifier : 0x3e9d90b85d695ca6
    internal_properties : 
    properties :
     x : 51
     y : 3
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         
         
         lnoproduit est une chaine = numpro
         lNoAncien est une chaine = invent.inum
         bliblitest est une chaine= produits.IPBASE
         
         restaure_bouton()
         bliblitest2 est une chaine= produits.IPBASE
         ecranversfichier(produits,invent)
         //si pas valide_champ() alors
         //	ACSO_message("Erreur","Vous devez inscrire une date effective pour vos prix futurs","Erreur")
         //	reprisesaisie("produits.idateprixfutur")
         //FIN
         SI PRODUITS.PTYPE = 2 ALORS
         	SI produits.iunitetype = 4 et sansespace(produits.inumeroregroupement) = "" alors
         		erreur("Vous devez inscrire un regroupement")
         		reprisesaisie("produits.inumeroregroupement")
         
         	FIN
         FIN
         HDésactiveFiltre(invent)
         si NUMPRO..modifie et pas ajout alors
         	si ACSO_message("Question","Le numéro de produit à été modifié , voulez-vous répercuter ce changement partout ?" + RC +RC + "(****** Attention cette procédure peut prendre plusieurs minutes ******)","OuiNon") = IDYES alors
         		ModifierNumero(numpro,lNoAncien)
         		si invent.ipextra = lNoAncien alors
         			invent.ipextra = numpro
         		fin
         		si invent.ipextrat = lNoAncien alors
         			invent.ipextrat = numpro
         		fin
         
         	FIN
         FIN
         
         si modif alors
         	hmodifie("invent",hnumenrencours)
         sinon
         	invent.iactif = vrai
         	hajoute("invent")	
         FIN
         
         HActiveFiltre(invent)
         si HErreurDoublon() alors
         	//	info(h.numenr)
         FIN
         debloquefiche()
         navigation..etat =actif; navigation..Visible=Vrai
         validation..etat =GRISé; validation..Visible=Vrai
         fiche..etat = actif; fiche..Visible=Vrai
         entete..etat = AffichageSeulement; entete..Visible=Vrai
         saisie_produit..etat = AffichageSeulement; saisie_produit..Visible=Vrai
         saisie_verre..etat = AffichageSeulement; saisie_verre..Visible=Vrai
         saisie_base..etat = grisé; saisie_base..Visible=Vrai
         saisie_unite_verre..etat = AffichageSeulement; saisie_unite_verre..Visible=Vrai
         saisie_unite..etat = AffichageSeulement; saisie_unite..Visible=Vrai
         Saisie_Fourniture..etat = AffichageSeulement; Saisie_Fourniture..Visible=Vrai
         Saisie_peinture..etat = AffichageSeulement; Saisie_peinture..Visible=Vrai
         
         boite..etat = AffichageSeulement; boite..Visible=Vrai
         regroupement..etat = AffichageSeulement; regroupement..Visible=Vrai
         btnactif..visible = faux
         btninactif..visible = faux
         modif = faux
         ajout = faux
         
         PRO_ONGLET[1]..ETAT = ACTIF; PRO_ONGLET[1]..Visible=Vrai
         BTN_SORTIE..ETAT = ACTIF; BTN_SORTIE..Visible=Vrai
         table..etat = AffichageSeulement; table..Visible=Vrai
         pfiltre..visible = vrai
         ptype..visible = faux
         EteintFourniture()
         
         bliblitest3 est une chaine=produits.IPBASE1
         
         hlitrecherche(invent,INUM,lnoproduit)
         tableaffiche(table,taCourantbandeau)
         ExécuteTraitement(table,trtSélection)
         PRO_ONGLET= 1
         ExecuteTraitement("pro_onglet",trtModification)
         
         reprisesaisie(table)
         
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_ANNULE
    identifier : 0x3e9d90b90be05cd8
    internal_properties : 
    properties :
     x : 84
     y : 3
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         
         restaure_bouton()
         titresuivant("Annulation des modifications")
         
         si ACSO_message("Question","Annuler les mofifications ?","OuiNon")  = idyes alors 
         
         	//Code WinDev 5.5 remplacé par la migration :
         	// navigation..etat = actif
         	navigation..etat = actif; navigation..Visible=Vrai
         	//Code WinDev 5.5 remplacé par la migration :
         	// fiche..etat = actif
         	fiche..etat = actif; fiche..Visible=Vrai
         	//Code WinDev 5.5 remplacé par la migration :
         	// btn_sortie..etat = actif
         	btn_sortie..etat = actif; btn_sortie..Visible=Vrai
         	//Code WinDev 5.5 remplacé par la migration :
         	// validation..etat = GRISé
         	validation..etat = GRISé; validation..Visible=Vrai
         	// pro_onglet = 1
         	//Code WinDev 5.5 remplacé par la migration :
         	// pro_onglet[1]..etat = actif
         	pro_onglet[1]..etat = actif; pro_onglet[1]..Visible=Vrai
         	//Code WinDev 5.5 remplacé par la migration :
         	// entete..etat = inactif
         	entete..etat = AffichageSeulement; entete..Visible=Vrai
         	//Code WinDev 5.5 remplacé par la migration :
         	// saisie_PRODUIT..VISIBLE = FAUX
         	saisie_PRODUIT..Visible=Faux
         	//Code WinDev 5.5 remplacé par la migration :
         	// saisie_verre..etat = inactif
         	saisie_verre..etat = AffichageSeulement; saisie_verre..Visible=Vrai
         	//Code WinDev 5.5 remplacé par la migration :
         	// saisie_unite_verre..etat = inactif
         	saisie_unite_verre..etat = AffichageSeulement; saisie_unite_verre..Visible=Vrai
         	//Code WinDev 5.5 remplacé par la migration :
         	// saisie_unite..etat = inactif
         	saisie_unite..etat = AffichageSeulement; saisie_unite..Visible=Vrai
         	Saisie_Fourniture..etat = AffichageSeulement; Saisie_Fourniture..Visible=Vrai
         	//Code WinDev 5.5 remplacé par la migration :
         	// boite..etat = inactif
         	boite..etat = AffichageSeulement; boite..Visible=Vrai
         	//Code WinDev 5.5 remplacé par la migration :
         	// regroupement..etat = inactif
         	regroupement..etat = AffichageSeulement; regroupement..Visible=Vrai
         	btnactif..visible = faux
         	btninactif..visible = faux
         
         	modif = faux
         	ajout = faux
         	//Code WinDev 5.5 remplacé par la migration :
         	// table..etat = inactif
         	table..etat = AffichageSeulement; table..Visible=Vrai
         	//Code WinDev 5.5 remplacé par la migration :
         	// rechercher..etat = actif
         	//rechercher..etat = actif; rechercher..Visible=Vrai
         	pro_onglet = 1
         	//Code WinDev 5.5 remplacé par la migration :
         	// execute("pro_onglet..clic")
         	pfiltre..visible = vrai
         	ptype..visible = faux
         	EteintFourniture()
         	ExecuteTraitement("pro_onglet",TRTclic)
         	hretourposition(pos_inv)
         	fichierversecran
         	reprisesaisie(table)
         sinon
         	reprisesaisie
         
         fin
         debloquefiche()
         
        type : 18
      -
        type : 161
        enabled : false
