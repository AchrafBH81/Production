    type : 16
    controls : []
    code_elements :
     type_code : 24
     p_codes :
      -
        code : |1-
         
        type : 14
      -
        code : |1+
         //hdesactivefiltre(invent)
         si ajout = vrai alors 
         
         sinon
         
         	selon pro_onglet
         		cas 1
         			ptype..visible = faux
         			selon pfiltre
         				cas 1
         					hfiltre(invent,itypeiactif,hconstruitvalcle(invent,itypeiactif,1,1))
         				cas 2
         					hfiltre(invent,itypeiactif,hconstruitvalcle(invent,itypeiactif,2,1))
         				cas 3
         					hfiltre(invent,itypeiactif,hconstruitvalcle(invent,itypeiactif,3,1))
         				cas 4
         					hfiltre(invent,itypeiactif,hconstruitvalcle(invent,itypeiactif,4,1))
         				cas 5
         					hfiltre(invent,itypeiactif,hconstruitvalcle(invent,itypeiactif,5,1))
         			FIN
         			tableaffiche(TABLE,taCourantBandeau)
         			saisie_produit..Visible=Faux
         			navigation..etat = grisé; navigation..Visible=Vrai
         		cas 2
         
         			saisie_produit..etat = affichageseulement; saisie_produit..Visible=Vrai
         			saisie_verre..etat = affichageseulement; saisie_verre..Visible=Vrai
         			BTN_PBASE..ETAT = AffichageSeulement; BTN_PBASE..Visible=Vrai
         			BTN_PEXTRA..ETAT = AffichageSeulement; BTN_PEXTRA..Visible=Vrai
         			BTN_PEXTRAT..ETAT = AffichageSeulement; BTN_PEXTRAT..Visible=Vrai
         			fichierversecran
         			navigation..etat = actif; navigation..Visible=Vrai	
         			ptype..visible = vrai
         		cas 3
         			saisie_produit..Visible=Faux
         			navigation..etat = actif; navigation..Visible=Vrai	
         			ptype..visible = vrai
         
         		cas 4
         			si modif ou ajout alors
         				ExecuteTraitement("idimensionspeciale",TRTsortie)	
         				ExecuteTraitement("iunitetype",TRTsortie)	
         
         			fin
         			saisie_produit..etat = AffichageSeulement; saisie_produit..Visible=Vrai
         			saisie_unite..etat = AffichageSeulement; saisie_unite..Visible=Vrai
         			//Code WinDev 5.5 remplacé par la migration :
         			//	navigation..etat = actif	
         			navigation..etat = actif; navigation..Visible=Vrai	
         			ptype..visible = vrai
         		cas 5
         			//Code WinDev 5.5 remplacé par la migration :
         			//    saisie_produit..etat = INACTIF
         			saisie_produit..etat = AffichageSeulement; saisie_produit..Visible=Vrai
         			//Code WinDev 5.5 remplacé par la migration :
         			//	navigation..etat = actif	
         			fichierversecran
         			navigation..etat = actif; navigation..Visible=Vrai	
         			ptype..visible = vrai
         		cas 6
         			//Code WinDev 5.5 remplacé par la migration :
         			//    saisie_produit..etat = INACTIF
         			saisie_produit..etat = AffichageSeulement; saisie_produit..Visible=Vrai
         			//Code WinDev 5.5 remplacé par la migration :
         			//	saisie_carrelage..etat = inactif
         			saisie_carrelage..etat = AffichageSeulement; saisie_carrelage..Visible=Vrai
         			//Code WinDev 5.5 remplacé par la migration :
         			//	navigation..etat = actif	
         			navigation..etat = actif; navigation..Visible=Vrai	
         			ptype..visible = vrai
         			execute("produits.ISAISIETOTALCARREAU..mod")
         		cas 7
         			saisie_produit..etat = AffichageSeulement; saisie_produit..Visible=Vrai
         			//Code WinDev 5.5 remplacé par la migration :
         			//	navigation..etat = actif	
         			fichierversecran
         			navigation..etat = actif; navigation..Visible=Vrai	
         			ptype..visible = vrai
         		cas 8
         			saisie_produit..etat = affichageseulement; saisie_produit..Visible=Vrai
         //			saisie_produit..Visible=Faux
         			fichierversecran
         			navigation..etat = actif; navigation..Visible=Vrai	
         			ptype..visible = vrai
         			executetraitement(csUnitePeinture,trtModification)
         
         		cas 9
         			//Code WinDev 5.5 remplacé par la migration :
         			//    saisie_produit..etat = INACTIF
         			saisie_produit..etat = AffichageSeulement; saisie_produit..Visible=Vrai
         			navigation..etat = actif; navigation..Visible=Vrai	
         			ptype..visible = vrai
         			HFiltre(invent,"iactif = 0")
         			tableaffiche(table1,taInit)
         	fin
         
         fin
         
         
        type : 17
      -
        type : 292
        enabled : false
      -
        type : 293
        enabled : false
