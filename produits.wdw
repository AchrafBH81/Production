  -
    name : TABLEAUPRIX
    identifier : 0x3e9d90ba3f6e60b7
    internal_properties : 
    properties :
     x : 1015
     y : 168
     width : 108
     height : 20
    options :
     -
       internal_properties : CQAAAAkAAABiGZDotXMk+2lOuL3bzoWK5e74REXHMsLz5+LHa7uvm+wHP8KesStQ/YH8VgJRFnHhsk1HWleZU4539QsujcPreuiWXTRTiVtp+HCq0xJrvcHLMf4y/yFhhz+2eO5J8biyunQ7yD2TQ22OeHsyxQMqqAyYzMLNMHY/SYfdquiN62VP3w==
    type : 5
    controls : []
    code_elements :
     type_code : 5
     p_codes :
      -
        code : |1+
         si moimeme alors
         //Code WinDev 5.5 remplacé par la migration :
         //   btn_tableau..etat = actif
            btn_tableau..etat = actif; btn_tableau..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         //   iprixunite..etat = grisé
            iprixunite..etat = grisé; iprixunite..Visible=Vrai
         sinon
         //Code WinDev 5.5 remplacé par la migration :
         //   iprixunite..etat = actif
            iprixunite..etat = actif; iprixunite..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         //   btn_tableau..VISIBLE = FAUX		
            btn_tableau..Visible=Faux		
         FIN
         
        type : 16
      -
        code : |1+
         si moimeme alors
            btn_tableau..etat = actif; btn_tableau..Visible=Vrai
            iprixunite = 0
            iprixunite..etat = grisé; iprixunite..Visible=Vrai
         
         sinon
            iprixunite..etat = actif; iprixunite..Visible=Vrai
            btn_tableau..Visible=Faux		
            si modif alors
               si acso_message("Question","Attention , en modifiant cette valeur vous annulerez toutes les dimensions reliées à ce produit",...
         	            "Est-ce bien ce que vous voulez faire","OuiNon") = idyes alors
                 hlitrecherche("dimcoul","dclea",complete(produits.numpro,10)+caract(0))
         		tantque sansespace(dimcoul.dnumero) = sansespace(produits.numpro) et pas HEnDehors()
         			hsupprime("dimcoul")
         			hlitsuivant("dimcoul","dclea")
         		FIN
               fin			
            FIN
         FIN
         
        type : 17
