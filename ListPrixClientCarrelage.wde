        p_codes :
         -
           code : |1+
            si hlitrecherche(invent,INUM,RequeteClientProduit.Idproruit) alors
            	moimeme = invent.IDESC
            
            sinon
            	moimeme = "Produit Inexistant"	
            FIN
            
