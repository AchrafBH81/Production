       code_elements :
        type_code : 29
        p_codes :
         -
           code : |1+
            si RequeteClientProduit.IPprixSpecial alors
            	si client.CalculCarrPied alors
            		piedcarre = RequeteClientProduit.IPrixCarrPiedCarre
            		metrecarre = RequeteClientProduit.IPrixCarrmetCarre
            	sinon
            //		moimeme = RequeteClientProduit.IPrixa
            		rubrique8 = RequeteClientProduit.iprixm
            	fin
            sinon
            	si hlitrecherche(invent,INUM,RequeteClientProduit.Idproruit) alors
            //		moimeme = invent.iprixcarreau
            		rubrique8 = invent.iprixbasecarrelage
            	//	piedcarre = 0
            	//	metrecarre = 0
            	sinon
            		moimeme = 0
            		rubrique8 = 0
            	//	piedcarre = 0
            //		metrecarre = 0
            	fin
            
            FIN
            
           type : 327692
