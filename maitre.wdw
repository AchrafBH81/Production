   -
     name : MajSurcharge
     procedure_id : 5263130818755969412
     type_code : 14
     code : |1-
      Procédure MajSurcharge()
      sablier(vrai)
      pour tout fdetail
      	
      	si fdetail.surchargeenergie <> 0 alors
      		fdetail.SUrchargeafacturer = fdetail.surchargeenergie * fdetail.fdqteafacturer / fdetail.fdqte
      		fdetail.SUrchargedejafacture = fdetail.surchargeenergie * (fdetail.fdqte-fdetail.fdqteafacturer) / fdetail.fdqte
      		hmodifie(fdetail,hNumEnrEnCours)
      	FIN
      	MultitacheRepeint(FenAttente)
      FIN
      
      //pour tout hfacture
      //			pour tout hfdetail avec "HFCLEUNIK = "+hfacture.HFCLEUNIK
      //				si hfdetail.surchargeenergie <> 0 alors
      //					hfdetail.SUrchargeafacturer = hfdetail.surchargeenergie * hfdetail.fdqteafacturer / hfdetail.fdqte
      //					hfdetail.SUrchargedejafacture = hfdetail.surchargeenergie * (hfdetail.fdqte-hfdetail.fdqteafacturer) / hfdetail.fdqte
      //					hmodifie(hfdetail,hNumEnrEnCours)
      //				FIN
      //			fin
      //	MultitacheRepeint(FenAttente)
      //FIN
      
      
      
      pour tout bonlivraison  
      	BonLivraison.btauxtvq = 0
      	bonlivraison.btvq=0
      	hmodifie(BonLivraison,hnumenrencours)
      	si BonLivraison.Bfacture = 0 alors
      //	si BonLivraison.Bnumero = 17620	
      		pour tout hfacture avec "bnumero = "+bonlivraison.Bnumero
      			pour tout hfdetail avec "HFCLEUNIK = "+hfacture.HFCLEUNIK
      			     si hlitrecherche(fdetail,fdnocommfdligne,HConstruitValClé(Fdetail,fdnocommfdligne,hfdetail.fdnocomm,hfdetail.fdligne)) alors
      			        hfdetail.surchargeenergie = Fdetail.surchargeenergie
      			        hfdetail.SUrchargeafacturer = Fdetail.SUrchargeafacturer
      			        hmodifie(hfdetail,hNumEnrEnCours)
      			     fin
      	     	
      			fin
      
      		fin
      
      
      	fin
      
      fin
      
      hlit(config,1)
      config.tauxtvq = 0
      config.gltvq = ""
      hmodifie(config,1)
      
      sablier(faux)
     type : 458752
   -
     name : MajSurchargeH
     procedure_id : 5264822902108297400
     type_code : 14
     code : |1-
      Procédure MajSurchargeH()
      sablier(vrai)
      lpourcenergie est un reel
      lpourenergieU est un reel
      lNoRecEnCours est un entier
      ltotalEnergie est un reel
      
      pour tout bonlivraison 
      	si bonlivraison.BDateFacture > "20081029" alors
      		pour tout hfacture avec "bnumero = "+bonlivraison.Bnumero
      			si HLitRecherche(client,numero,hfacture.faclient) alors
      				lpourcenergie = client.csurchargebase
      				lpourenergieU = client.csurchargeverreunite
      			fin
      
      			pour tout hfdetail avec "HFCLEUNIK = "+hfacture.HFCLEUNIK
      				ltotalEnergie = 0
      				si hfdetail.ftype = 1 et hfdetail.SUrchargeafacturer = 0 alors
      					ltotalEnergie+=hFdetail.fdprixtotal * lpourcenergie / 100
      					si hfdetail.fdcarrelage alors
      						lNoRecEnCours = HSauvePosition(hfdetail)
      						hlitrecherche(hfdetail,fdnocommfdligne1,HConstruitValClé(hfdetail,fdnocommfdligne1,hfdetail.fdnocomm,hfdetail.fdligne))
      						hlitsuivant(hfdetail,fdnocommfdligne1)
      						ltotalEnergie +=  hFdetail.fdcarrprixtotal * lpourcenergie / 100
      						HRetourPosition(lNoRecEnCours)
      
      					FIN
      					hfdetail.surchargeenergie = ltotalEnergie
      					hfdetail.SUrchargeafacturer = ltotalEnergie
      				sinon si hfdetail.ftype = 2 et hfdetail.fdverreunite et hfdetail.SUrchargeafacturer = 0 alors
      					hfdetail.surchargeenergie = hfdetail.fdprixtotal * lpourenergieU / 100
      					hfdetail.surchargeenergie = hfdetail.fdprixtotal * lpourenergieU / 100
      				fin
      
      
      				hmodifie(hfdetail,hNumEnrEnCours)
      
      			fin
      
      		fin
      
      	fin
      fin
      
      sablier(faux)
     type : 458752
   -
     name : MajSurchargeH1
     procedure_id : 5264869790539264155
     type_code : 14
     code : |1-
      Procédure MajSurchargeH1()
      sablier(vrai)
      lpourcenergie est un reel
      lpourenergieU est un reel
      lNoRecEnCours est un entier
      ltotalEnergie est un reel
      
      
      		pour tout facture 
      			si HLitRecherche(client,numero,facture.faclient) alors
      				lpourcenergie = client.csurchargebase
      				lpourenergieU = client.csurchargeverreunite
      			fin
      
      			pour tout fdetail avec "fdnocomm = "+facture.fanumero
      				ltotalEnergie = 0
      				si fdetail.ftype = 1 alors //et fdetail.SUrchargeafacturer = 0 alors
      					ltotalEnergie+=((fdetail.fdqte * fdetail.fdprixupiedfacture * fdetail.fdpiedcarrefacture)+(fdetail.fdqte*fdetail.fdextraforme)) *lpourcenergie / 100
      					si fdetail.fdcarrelage alors
      						ltotalEnergie +=  fdetail.fdcarrprixtotal * lpourcenergie / 100
      					FIN
      					fdetail.surchargeenergie = ltotalEnergie
      					fdetail.SUrchargeafacturer = ltotalEnergie
      				sinon si fdetail.ftype = 2 et fdetail.fdverreunite et fdetail.SUrchargeafacturer = 0 alors
      					fdetail.surchargeenergie = fdetail.fdprixtotal * lpourenergieU / 100
      					fdetail.surchargeafacturer = fdetail.fdprixtotal * lpourenergieU / 100
      				fin
      
      
      				hmodifie(fdetail,hNumEnrEnCours)
      
      			fin
      
      		fin
      
      
      
      sablier(faux)
     type : 458752
   -
     name : MajPrix
     procedure_id : 5264897670450069296
     type_code : 14
     code : |1+
      Procédure MajPrix()
      sablier(vrai)
      pour tout fdetail
      	si fdetail.ftype = 1  alors
      		si fdetail.fdprixtotal = 0 alors
      			fdetail.fdprixupiedfacture = 0
      			fdetail.surchargeenergie = 0
      			fdetail.SUrchargeafacturer = 0
      			fdetail.SUrchargedejafacture = 0
      			
      			hmodifie(fdetail,hNumEnrEnCours)
      			si hlitrecherche(hfdetail,fdnocommfdligne1,HConstruitValClé(hfdetail,fdnocommfdligne1,fdetail.fdnocomm,fdetail.fdligne)) alors
      				hfdetail.fdprixupiedfacture = 0
      				hfdetail.surchargeenergie = 0
      				hfdetail.SUrchargeafacturer = 0
      				hfdetail.SUrchargedejafacture = 0
      			fin
      
      		FIN
      		MultitacheRepeint(FenAttente)
      	FIN
      fin
      
      sablier(faux)
      
     type : 458752
   -
     name : CountIncomingOrders
     internal_properties : CQAAAAkAAAAnfStKZqUcYlKt7xW5Wd1KZPdvqGaAUWTrKdmxz7ZDmYEpvjmB9lGsIG9X8Kk9/MubVD6xlOfu3m6rb7+qlar1D/QQwsdZUOkTa9DIUPmRi8oFjLXgtZe1Y1Bn2xP427Rws/qk15wcPbaNnV3o7JTWPtn+JQoBokbMbbXWJ49QjUHqt7x4
     procedure_id : 2287897111173033089
     type_code : 14
     code : |1-
      // Procédure automatique :
      // La procédure est exécutée manuellement, lors d'un appel dans le code
      // Elle s'exécutera dans un thread (sans avoir besoin d'appeler la fonction ThreadExecute), sans utilisation de HFSQL
      // Elle sera répétée en boucle, en attendant 30 secondes entre chaque appel
      // 
      
      PROCEDURE CountIncomingOrders()
      
      
      //NbOfIncomingOrders+=1
      //nborders est un entier = NbOfIncomingOrders
      //SysIconeModifie("edigreen.ico","Il y a " + NbOfIncomingOrders +" commande(s) en attente")
      //SysIconeAfficheBulle("Il y a " + NbOfIncomingOrders +" commande(s) en attente")
      
      NbOfOrders = allouer un tableau de STNumberOfOrders
      Buforders est un buffer
      Req			est un restRequête
      Response	est un restRéponse
      Req.URL		= WebServiceEDI + "/GetNumberOfOrdersByCustomer"
      Req.Méthode	= httpGet
      
      cpt est un entier
      OldCPT est un entier = NbOfIncomingOrders
      Response	= RESTEnvoie(Req)
      Buforders = Response..contenu
      deserialise(NbOfOrders,Buforders,psdJSON)
      pour chaque order de NbOfOrders
      	cpt+= order.nNumberOfOrders
      FIN
      NbOrderBasco est un STNumberOfOrders =GetNumberOfBascoOrders()
      NbOfOrders.Ajoute(NbOrderBasco)
      cpt+=NbOrderBasco.nNumberOfOrders
      
      
      si cpt = 0 alors
      	SysIconeModifie("edired.ico","Il n'y a aucune commande en attente")
      	SysIconeAfficheBulle("Il n'y a aucune commande en attente")
      sinon si cpt <> OldCPT alors
      	NbOfIncomingOrders = cpt
      	SysIconeModifie("edigreen.ico","Il y a " + cpt +" commande(s) en attente")
      	SysIconeAfficheBulle("Il y a " + cpt +" commande(s) en attente")
      fin
     type : 458752
   -
     name : GetNumberOfBascoOrders
     procedure_id : 2298907311345248966
     type_code : 14
     code : |1-
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] GetNumberOfBascoOrders ()
      //
      // Paramètres :
      //	Aucun
      // Valeur de retour :
      // 	STNumberOfOrders : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE GetNumberOfBascoOrders()
      NbOrderBasco est un STNumberOfOrders
      
      FtpHost est une chaîne UNICODE = gclConfig.m_sBascoFTPAddress
      //FtpHost	est une chaine UNICODE		= ExtraitChaîne(gclConfig.m_sBascoFTPAddress,1)
      //FtpPort	est un entier		= ExtraitChaîne(gclConfig.m_sBascoFTPAddress,2)
      FtpUsername est une chaîne UNICODE = gclConfig.m_sBascoUser
      FtpPassword est une chaîne UNICODE = gclConfig.m_sBascoPassword
      nFtpPort est un entier = extraitchaine(gclConfig.m_sBascoFTPAddress,2)
      FtpFolderRoot est une chaîne UNICODE = "/"
      
      SI EnModeTest() ALORS
      	FtpHost = "ftp://192.168.1.47"
      	FtpUsername  = "trn"
      	FtpPassword  = "trn"
      	FtpFolderRoot  = "/"
      	
      FIN
      po est un PurchaseOrderDto, utile
      cpt est un entier
      
      
      _tabPurchaseOrder est un "List<PurchaseorderDTo>"
      
      
      
      
      //po.BascoFranchise = "Ceci est un test"
      //po.EdiKey = DonneGUID()
      //ajoute(tabPurchaseOrder,po)
      
      
      
      
      _get est un PurchaseOrderProcessor(FtpHost,FtpUsername,FtpPassword,FtpFolderRoot+"PurchaseOrder/") 
      
      
      
      _tabPurchaseOrder.AddRange(_get.get())
      cpt = _tabPurchaseOrder.get_count()
      NbOrderBasco.nNumberOfOrders = cpt
      NbOrderBasco.sCustomerNumber = "139"
      renvoyer NbOrderBasco
     type : 458752
