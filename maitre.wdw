   -
     name : listemenu
     procedure_id : 4570958636553016204
     type_code : 14
     code : |1+
      Procédure listemenu()
      
      i		est entier	= 1
      NomMenu	est une chaîne
      NomMenu = EnumèreMenu (maitre, 1) // lecture du 1er menu de la fenêtre
      sMAster		est une chaîne
      sMaster1	est une chaîne
      sMaster2	est une chaîne
      
      TANTQUE NomMenu <>""
      	Trace(NomMenu)
      	si menuetat(maitre,{nommenu}..valeur) = actif alors
      		optionmenu.NomOption		= NomMenu
      		optionmenu.LibelleOption	= menulibelle({NomMenu})
      		optionmenu.NiveauSuperieur	= ""
      		OptionMenu.NomComplet = nommenu
      		smaster						= nommenu
      		
      		hajoute(OptionMenu)
      		j			est entier	= 1
      		NomSousMenu	est une chaîne
      		NomSousMenu = EnumèreMenu (NomMenu, j) // lecture de la 1er option du menu
      		TANTQUE NomSousMenu <>""
      			Trace("  " + NomSousMenu)
      			si MenuEtat(maitre,{NomSousMenu}..Valeur) = actif _et_ pas sansespace(MenuLibellé({NomSousMenu})) = "" alors
      				optionmenu.NomOption		= NomSousMenu
      				optionmenu.LibelleOption	= menulibelle({NomSousMenu})
      				Optionmenu.NiveauSuperieur	= smaster
      				OptionMenu.NomComplet = smaster+"."+NomSousMenu
      				smaster1					= nomsousmenu
      				hajoute(OptionMenu)
      				k				est un entier	= 1
      				nomsoussousmenu	est une chaine
      				nomsoussousmenu = EnumèreMenu (NomSousMenu, k) // lecture de la 1er option du menu
      				TANTQUE nomsoussousmenu <>""
      					Trace("  " + nomsoussousmenu)
      					SI MenuEtat(maitre,{NomsousSousMenu}..Valeur) = Actif ALORS
      						
      						optionmenu.NomOption		= nomsoussousmenu
      						optionmenu.LibelleOption	= menulibelle({nomsoussousmenu})
      						OptionMenu.NiveauSuperieur	= smaster1
      						OptionMenu.NomComplet = sMAster+"."+smaster1+"."+NomsoussousMenu
      						smaster2					= nomsoussousmenu
      						hajoute(OptionMenu)
      						l					est un entier	= 1
      						nomsoussoussousmenu	est une chaine
      						nomsoussoussousmenu = EnumèreMenu (NomsousSousMenu, l) // lecture de la 1er option du menu
      						TANTQUE nomsoussoussousmenu <>""
      							Trace("  " + nomsoussoussousmenu)
      							SI MenuEtat(maitre,{NomSoussousSousMenu}..Valeur) = Actif ALORS
      								OptionMenu.NomOption		= nomsoussoussousmenu
      								OptionMenu.LibelleOption	= MenuLibellé({nomsoussoussousmenu})
      								OptionMenu.NiveauSuperieur	= sMaster2
      								OptionMenu.NomComplet = sMAster+"."+sMaster1+"."+sMaster2+"."+nomsoussoussousmenu
      								
      								HAjoute(OptionMenu)
      							fin
      							l++
      							nomsoussoussousmenu = EnumèreMenu (nomsoussousmenu, l) // lecture de la 1er option du menu
      							
      						FIN					
      					fin
      					
      					
      					k++
      					nomsoussousmenu = EnumèreMenu (NomSousMenu, k) // lecture de la 1er option du menu
      				fin    
      			fin
      			j++   // option suivante
      			NomSousMenu = EnumèreMenu(NomMenu, j)
      		FIN
      	fin
      	i++     // menu suivant
      	NomMenu = EnumèreMenu(MaFenêtre,i)
      FIN
      
      
     type : 458752
