      Procédure sauvegarde()
      //TitreSuivant("Sauvegarde des données")
      //ouvresoeur(FenAttente,"Sauvegarde en cours.........")
      sablier(vrai)
      
      zipcree("archive",completerep("c:\temp")+"archive.wdz")
      hferme()
      flistefichier(completerep("c:\serveurhf\BDD\thermosrn")+"*.fic","listefic")
      fListeFichier(ComplèteRep("c:\serveurhf\BDD\thermosrn")+"*.ndx","listefic")
      fListeFichier(ComplèteRep("c:\serveurhf\BDD\thermosrn")+"*.mmo","listefic")
      houvre("*")
      zipFerme("archive")
      sablier(faux)
      //ferme(FenAttente)
      jauge()
