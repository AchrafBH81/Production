   -
     name : restauration
     procedure_id : 4680124764494818673
     type_code : 14
     code : |1-
      Procédure restauration()
      nbfichier est un entier
      j est un entier
      fichierliste est une chaine
      fdatefichier est une chaine = dateverschaine(fdate(completerep(repdonnees)+"archive.wdz"))
      fheurefichier est une chaine = gauche(HeureVersChaine(fheure(completerep(repdonnees)+"archive.wdz")),5)
      
      //si acso_message("Message important",GSTYLO(IROUGECLAIR)+"Vous êtes sur le point de récupérer le fichier archive daté du " + fdatefichier + " à " + fheurefichier +rC + ...
      //	+RC+	"!!!!! LA RÉCUPÉRATION EST IRRÉVERSIBLE !!!!! "+rc+RC+"Voulez-vous continuer ?","OuiNon",2) = idyes alors
      	si acso_message("Message important",GSTYLO(IROUGECLAIR)+"Vous êtes sur le point de récupérer le fichier archive daté du " + fdatefichier + " à " + fheurefichier +rC + ...
      		RC+	"!!!!! LA RÉCUPÉRATION EST IRRÉVERSIBLE !!!!! "+rc+RC+"Voulez-vous continuer ?","OuiNon",2) = idyes alors
      
      //TitreSuivant("Restauration des fichiers")
      //ouvresoeur(FenAttente,"Restauration des fichiers..... ")
      sablier(vrai)
      si zipouvre("archive",completerep(repdonnees)+"archive.wdz") = 0 alors 
          fichierliste = zipListeFichier("archive")
          nbfichier = zipNbFichier("archive")
          pour j = 1 a nbfichier
      	  fichieracompresser = extraitchaine(fichierliste,j,rc)
      	  zipextraitfichier("archive",j,zipdisque)
      	fin
      	
      //	zipExtraitTout("archive",zipdisque)
      
      FIN
      zipferme("archive")
      sablier(faux)
      //ferme(FenAttente)
      jauge()
      fin
     type : 458752
   -
     name : AjustePeinture
     procedure_id : 5159090234776708118
     type_code : 14
     code : |1+
      Procédure AjustePeinture()
      
      lNoRec est un entier 
      ltypepeinture est un entier
      lNoPeintureExtTout est une chaine
      lNoPeintureinterieur est une chaine
      ldescpeintureextTout est une chaine
      ldescpeintureInterieur est une chaine
      fPeinture est un booleen
      fPrixcarrpeinture est un reel
      ftotalpeinture est un reel
      ftotalcarrpeinture est un reel
      flibellenbcarreauext est une chaine
      flibellenbcarreauint est une chaine
      lNoComm est un entier
      lNoLigne est un entier
      
      
      
      
      pour tout fdetail 
       si hlitrecherche(hfdetail,fdnocommfdligne1,HConstruitValClé(hfdetail,fdnocommfdligne1,fdetail.fdnocomm,fdetail.fdligne)) alors
          hfdetail.fdlien = fdetail.fdlien
          hmodifie(hfdetail,hNumEnrEnCours)
       fin	
      	si fdetail.ftype = 1 alors
      		si fdetail.fdcarrelage alors
      
      			ltypepeinture = fdetail.fTypePeinture
      			lNoPeintureExtTout = fdetail.fNoPeintureExtTout
      			lNoPeintureinterieur = fdetail.FnopeintureInterieure
      			ldescpeintureextTout = fdetail.fdescpeintureExtTout
      			ldescpeintureInterieur = fdetail.fDescPeintureInterieure
      			fPeinture = fdetail.fpeinture
      			fPrixcarrpeinture = fdetail.fPrixCarreauPeinture
      			ftotalpeinture = fdetail.fTotalPeinture
      			ftotalcarrpeinture = fdetail.Ftotalcarreaupeinture
      			flibellenbcarreauext = fdetail.libelleNbCarreauExtTlt
      			flibellenbcarreauint = fdetail.libelleNbcarreauinterieur
      
      			lNoComm = fdetail.fdnocomm
      			lNoLigne = fdetail.fdligne
      			lNoRec = HSauvePosition(fdetail)
      			pour tout fdetail avec "fdnocomm = "+ lNoComm + "et fdlien = " + lNoLigne
      				fdetail.fTypePeinture = ltypepeinture
      				fdetail.fNoPeintureExtTout = lNoPeintureExtTout 
      				fdetail.FnopeintureInterieure =lNoPeintureinterieur 
      				fdetail.fdescpeintureExtTout =ldescpeintureextTout 
      				fdetail.fDescPeintureInterieure =ldescpeintureInterieur
      				fdetail.fpeinture = fPeinture 
      				fdetail.fPrixCarreauPeinture = fPrixcarrpeinture 
      				fdetail.fTotalPeinture =ftotalpeinture
      				fdetail.Ftotalcarreaupeinture =ftotalcarrpeinture 
      				fdetail.libelleNbCarreauExtTlt = flibellenbcarreauext  
      				fdetail.libelleNbcarreauinterieur=flibellenbcarreauint
      				hmodifie(fdetail,hNumEnrEnCours)
      
      			fin
      
      			HRetourPosition(lNoRec)
      		FIN
      
      
      	FIN
      FIN
      
      
      pour tout hfdetail 
      	si hfdetail.ftype = 1 alors
      		si hfdetail.fdcarrelage alors
      
      			ltypepeinture = hfdetail.fTypePeinture
      			lNoPeintureExtTout = hfdetail.fNoPeintureExtTout
      			lNoPeintureinterieur = hfdetail.FnopeintureInterieure
      			ldescpeintureextTout = hfdetail.fdescpeintureExtTout
      			ldescpeintureInterieur = hfdetail.fDescPeintureInterieure
      			fPeinture = hfdetail.fpeinture
      			fPrixcarrpeinture = hfdetail.fPrixCarreauPeinture
      			ftotalpeinture = hfdetail.fTotalPeinture
      			ftotalcarrpeinture = hfdetail.Ftotalcarreaupeinture
      			flibellenbcarreauext = hfdetail.libelleNbCarreauExtTlt
      			flibellenbcarreauint = hfdetail.libelleNbcarreauinterieur
      
      			lNoComm = hfdetail.fdnocomm
      			lNoLigne = hfdetail.fdligne
      			lNoRec = HSauvePosition(hfdetail)
      			pour tout hfdetail avec "fdnocomm = "+ lNoComm + "et fdlien = " + lNoLigne
      				hfdetail.fTypePeinture = ltypepeinture
      				hfdetail.fNoPeintureExtTout = lNoPeintureExtTout 
      				hfdetail.FnopeintureInterieure =lNoPeintureinterieur 
      				hfdetail.fdescpeintureExtTout =ldescpeintureextTout 
      				hfdetail.fDescPeintureInterieure =ldescpeintureInterieur
      				hfdetail.fpeinture = fPeinture 
      				hfdetail.fPrixCarreauPeinture = fPrixcarrpeinture 
      				hfdetail.fTotalPeinture =ftotalpeinture
      				hfdetail.Ftotalcarreaupeinture =ftotalcarrpeinture 
      				hfdetail.libelleNbCarreauExtTlt = flibellenbcarreauext  
      				hfdetail.libelleNbcarreauinterieur=flibellenbcarreauint
      				hmodifie(hfdetail,hNumEnrEnCours)
      
      			fin
      
      			HRetourPosition(lNoRec)
      		FIN
      
      
      	FIN
      FIN
     type : 458752
   -
     name : AjustePeintureSurcharge
     procedure_id : 5161286485439040115
     type_code : 14
     code : |1+
      Procédure AjustePeintureSurcharge()
      
      lNoRec est un entier 
      ltypepeinture est un entier
      lNoPeintureExtTout est une chaine
      lNoPeintureinterieur est une chaine
      ldescpeintureextTout est une chaine
      ldescpeintureInterieur est une chaine
      fPeinture est un booleen
      fPrixcarrpeinture est un reel
      ftotalpeinture est un reel
      ftotalcarrpeinture est un reel
      flibellenbcarreauext est une chaine
      flibellenbcarreauint est une chaine
      lNoComm est un entier
      lNoLigne est un entier
      
      
      
      
      pour tout hfacture
      	si hlitrecherche(BonLivraison,Bnumero,hfacture.Bnumero) alors
      		si BonLivraison.BStotal > 35 alors
      			hfacture.fsurchargepeinture = 0
      			hmodifie(hfacture,hNumEnrEnCours)
      		FIN
      	fin	
      
      fin
     type : 458752
   -
     name : AjusteSurcharge
     procedure_id : 5163124117199140580
     type_code : 14
     code : |1+
      Procédure AjusteSurcharge()
      lpourcsurcharge est un reel
      pour tout hfdetail avec "ftype= 1 et surchargeenergie = 0"
      	si hlitrecherche(hfacture,HFCLEUNIK,hfdetail.HFCLEUNIK) alors
      		si hlitrecherche(client,numero,hfacture.faclient) ALORS
      			si client.surcharge alors
      				lpourcsurcharge = client.csurchargebase/100
      				hfdetail.surchargeenergie = arrondi(hfdetail.fdprixtotal * lpourcsurcharge,4)
      				hmodifie(hfdetail,hNumEnrEnCours)
      				
      			FIN
      		FIN
      	FIN
      
      fin
     type : 458752
   -
     name : AjusteCarrelage
     procedure_id : 5163298474627170538
     type_code : 14
     code : |1+
      Procédure AjusteCarrelage()
      lnorecord est un entier
      pourcsurcharge est un reel
      lnolien est un entier
      lprixu est un reel
      lprixuc est un reel
      lprixtotal est un reel
      lnocomm est un entier
      
      pour tout hfdetail avec "ftype= 1 et fdcarrelage = 1"
      	lnorecord = HSauvePosition(hfdetail)
      	lprixu =hfdetail.frcarrprixu
      	lprixuc = hfdetail.fdcarrpruxuc
      	lnolien = hfdetail.fdligne
      	lnocomm= hfdetail.fdnocomm
      	pour tout hfdetail avec "fdlien="+ lnolien	+" et fdnocomm	="+lnocomm
      		hfdetail.fdcarrpruxuc= lprixuc
      		hfdetail.frcarrprixu=lprixu
      		hmodifie(hfdetail,hNumEnrEnCours)
      	fin
      	HRetourPosition(lnorecord)
      fin
      
      
      pour tout fdetail avec "ftype= 1 et fdcarrelage = 1"
      	lnorecord = HSauvePosition(fdetail)
      	lprixu =fdetail.frcarrprixu
      	lprixuc = fdetail.fdcarrpruxuc
      	lnolien = fdetail.fdligne
      	lnocomm= fdetail.fdnocomm
      	pour tout fdetail avec "fdlien="+ lnolien	+" et fdnocomm	="+lnocomm
      		fdetail.fdcarrpruxuc= lprixuc
      		fdetail.frcarrprixu=lprixu
      		hmodifie(fdetail,hNumEnrEnCours)
      	fin
      	HRetourPosition(lnorecord)
      fin
      
      pour tout hfdetail avec "ftype= 5 et fdpiedcarrefacture = 0 et fdprixupied <> 0"
      	hfdetail.fdpiedcarrefacture= 1
      	hmodifie(hfdetail,hNumEnrEnCours)
      fin
      pour tout fdetail avec "ftype= 5 et fdpiedcarrefacture = 0 et fdprixupied <> 0"
      	fdetail.fdpiedcarrefacture= 1
      	hmodifie(fdetail,hNumEnrEnCours)
      fin
