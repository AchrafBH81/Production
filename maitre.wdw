   -
     internal_properties : CQAAAAkAAAAMKk0bUnppf9n/DdIx+pD12FdjGBpDdPouTXmKpwRX8VSK7s3EyvfwpbA1UoOIDFhQRWUvEtPmaHQL3DqP9EYkvNp92ZaY8pL88p/fEQhlXNEtBTP55g==
     code : |1-
      // Traitement automatique des exceptions :   exécuter le bloc de code CAS EXCEPTION:
      //
      externe fac
      
      global
      
      
      memcrée("zone")
      memajoute("zone",1,"")
      
      
      //listemenu()
      
      
      
      _menu.client.type_de_crédit1..visible = faux
      	
      
      
      
      // Si acomba on ne permet pas de crééer des comptes de G/L
      // On récupère celle de Acomba
      
      si gLogCompt = "Acomba" alors
      	Grand_Livre..visible = faux
      FIN
      
      //image3..libelle = inilit("COMPAGNIE","NOMCIE","",repencours+"production.ini")
      
      // Affiche le logi présent dans le dossier de l'application
      //info( completerep(frepencours())+"logoprincipal.bmp")
      //maitre.image1 = completerep(frepencours())+"logoprincipal.bmp"
      
      
      
      hlitpremier("config","COCLEUNIK")
      
      // On réassigne les fichier temporaire au dossier courant local
      
      
      
      
      
      
      //chemintempo = completerep(sysrep(srAppDataLocal))+"Production"
      //si pas fRepExiste (chemintempo)alors frepcree(chemintempo)
      //SI PAS HOuvreConnexion("ConnexionLocaleTemp", "", "", chemintempo, "", hAccèsHF7) alors
      //	info("erruer")
      //FIN
      
      si cleusb alors chemintempo = completerep(repencours)+"tempo\"
      
      RADProjetInit()
      //HChangeConnexion(trdetail,"ConnexionLocaleTemp")
      //HCréationSiInexistant(trdetail)
      //HSupprimeTout(trdetail)
      //HChangeConnexion(trdetailliste,"ConnexionLocaleTemp")
      //HCréationSiInexistant(trdetailliste)
      //HSupprimeTout(trdetailliste)
      //HChangeConnexion(transferttempo,"ConnexionLocaleTemp")
      //HCréationSiInexistant(transferttempo)
      //HSupprimeTout(transferttempo)
      //HChangeConnexion(impvideo,"ConnexionLocaleTemp")
      //HCréationSiInexistant(impvideo)
      //HSupprimeTout(impvideo)
      //HChangeConnexion(TigerCarrelage,"ConnexionLocaleTemp")
      //HCréationSiInexistant(TigerCarrelage)
      //HSupprimeTout(TigerCarrelage)
      //HChangeConnexion(tqteprep,"ConnexionLocaleTemp")
      //HCréationSiInexistant(TQtePrep)
      //HSupprimeTout(tqteprep)
      //HChangeConnexion(TCommandeAchatDetail,"ConnexionLocaleTemp")
      //HCréationSiInexistant(TCommandeAchatDetail)
      //HSupprimeTout(TCommandeAchatDetail)
      //HChangeConnexion(tempoliste,"ConnexionLocaleTemp")
      //HCréationSiInexistant(tempoliste)
      //HSupprimeTout(tempoliste)
      //HChangeConnexion(Fdetailtempo,"ConnexionLocaleTemp")
      //HCréationSiInexistant(Fdetailtempo)
      //HSupprimeTout(Fdetailtempo)
      //HChangeConnexion(tempoliste,"ConnexionLocaleTemp")
      //HCréationSiInexistant(tempoliste)
      //HSupprimeTout(tempoliste)
      //hclient.base  =chemintempo+"\trdetail.fic"
      
      
      
      
      //HSupprimeFichier(gConnexionHF,chemintempo+"\trdetail.fic")
      //HSupprimeFichier(gConnexionHF,chemintempo+"\trdetailliste.fic")
      
      
      
      HChangeRep(trdetail,chemintempo)
      HCréationSiInexistant(trdetail)
      HSupprimeTout(trdetail)
      
      //HChangeConnexion(trdetail,cnxConnexionTemp)
      //HCréationSiInexistant(trdetail)
      //HSupprimeTout(trdetail)
      
      HChangeRep(trdetailListe,chemintempo)
      HCréationSiInexistant(trdetailListe)
      HSupprimeTout(trdetailliste)
      
      //HChangeconnexion(trdetailListe,cnxConnexionTemp)
      //HCréationSiInexistant(trdetailListe)
      //HSupprimeTout(trdetailliste)
      
      
      HChangeRep(Transferttempo,chemintempo)
      HCréationSiInexistant(Transferttempo)
      hsupprimetout(transferttempo)
      HChangeRep(impvideo,chemintempo)
      HCréationSiInexistant(impvideo)
      hsupprimetout(impvideo)
      HChangeRep(TigerCarrelage,chemintempo)
      HCréationSiInexistant(TigerCarrelage)
      hsupprimetout(TigerCarrelage)
      HChangeRep(TQtePrep,chemintempo)
      HCréationSiInexistant(TQtePrep)
      hsupprimetout(tqteprep)
      //si HFichierExiste(TCommandeAchatDetail) alors HSupprimeFichier(gConnexionHF,chemintempo+"\tcommandeachatdetail.fic")
      HChangeRep(TCommandeAchatDetail,chemintempo)
      HCréationSiInexistant(TCommandeAchatDetail)
      hsupprimetout(TCommandeAchatDetail)
      HChangeRep(tempoListe,chemintempo)
      HCréationSiInexistant(tempoListe)
      hsupprimetout(tempoliste)
      HChangeRep(Fdetailtempo,chemintempo)
      HCréationSiInexistant(Fdetailtempo)
      hsupprimetout(Fdetailtempo)
      HChangeRep(tempohisto,chemintempo)
      HCréationSiInexistant(tempohisto)
      hsupprimetout(tempohisto)
      
      
      //HChangeRep(trdetail,".\"+NetAdresseIP())
      //HCréation(trdetail)
      //HChangeRep(trdetailListe,".\"+NetAdresseIP())
      //HCréation(trdetailListe)
      //HChangeRep(Transferttempo,".\"+NetAdresseIP())
      //HCréation(Transferttempo)
      //HChangeRep(impvideo,".\"+NetAdresseIP())
      //HCréation(impvideo)
      //HChangeRep(TigerCarrelage,".\"+NetAdresseIP())
      //HCréation(TigerCarrelage)
      //HChangeRep(TQtePrep,".\"+NetAdresseIP())
      //HCréation(TQtePrep)
      //HChangeRep(TCommandeAchatDetail,".\"+NetAdresseIP())
      //HCréation(TCommandeAchatDetail)
      //HChangeRep(tempoListe,".\"+NetAdresseIP())
      //HCréation(tempoListe)
      //HChangeRep(Fdetailtempo,".\"+NetAdresseIP())
      //HCréation(Fdetailtempo)
      //HChangeRep(tempoHisto,".\"+NetAdresseIP())
      //HCréation(tempoHisto)
      
      
      // Vérification de l'affectation de toutes les imprimantes
      
      si imprimantefacture = "" ou imprimanterapport = "" ou ...
      	imprimanteetiquette = "" ou imprimantecarrelage = "" ou imprimanteconfirmation ="" ...
      	ou imprimanteftravail = "" ou imprimantepdf = "" alors
      	ouvre("imprimantes")
      fin   
      
      
      
      
      gImprimeCondPMT = config.ImprimeCondPmt  // imprime ou non les condition de paiement sur les listes de prix clients
      
      // Taux de conversion anglais/métrique
      
      tauxconversionam = config.conversionam               
      tauxconversionma = config.conversionma
      tauxconversionAmlineaire = config.conversionamlineaire
      
      gImpressionFeuilleTravail = config.ImpressionFeuilleTravail  // impression feuille de travail 1=apres chaque commande
      //                               2= A la préparation du fichier de transfert
      
      // Longueur des barres de carrelage pour le calcul du nombre de barre a peinturer
      gLongueurbarrecarrelageA = config.LongueurbarreCarrelageA
      gLongueurbarrecarrelagem = config.LongueurbarreCarrelagem
      
      // Assignation de la province
      
      gProvinceTaxe = config.Province
      
      
      ////////////////////////////////////////
      // Autorisation des options de menu
      
      Feedmenu(Usager.IDGroupe)
      
      //////////////////////////////////////////
      
      
      BTN_PRODUIT..Visible = _Menu.Matériel.Inscription..Visible
      BTN_CONSTRUCTOR..visible = _menu.Matériel.OPT_Thermos..visible
      BTN_COMMANDE..visible = _menu.Production.Commande.Gestion..visible
      BTN_CLIENT..visible = _menu.Client.OPT_Fiche_client..visible
      BTN_CARRELAGE..visible = _menu.Matériel.OPT_Carrelage..visible
      
      
      MoiMême..Visible=Vrai
      
      
      CAS EXCEPTION:
      	
      	erreur(exceptioninfo(errComplet))
      	hferme("*")
      	HFermeConnexion(gConnexionHF)
      	finprogramme()
   -
     code : |1+
      
      
      
      //
      //
      // information nécessaire a la connexion acomba
      
      //tableauinfocie est un tableau dynamique
      //wpathexe est une chaine //inilit("ACOMBA","PATHEXE","",repencours+"production.ini")
      //wpathdata est une chaine //  inilit("ACOMBA","PATHDATA","",repencours+"production.ini")
      //wpathcie est une chaine //= inilit("ACOMBA","CIE","",repencours+"production.ini")
      //nomusager est une chaine= inilit("USAGER","USAGER","",repencours+"production.ini")
      //souvenir est un booleen= inilit("USAGER","SOUVENIR","",repencours+"production.ini")
      //wmotdepasse est une chaine = decrypte(inilit("USAGER","MOTDEPASSE","",repencours+"production.ini"),"planisoft")
      //
      /////////////////////////////////////////////////////////////////
      //
      //
      
      si gLogCompt = "Acomba" alors
      //	///////////////////////////////
      //	// Si Acomba
      //	///////////////////////////////
      //	si pas AcombaX.ACCC_AcombaInit ALORS
      //		ACSO_message("Erreur","Impossible d'initialiser la connection  avec acomba","Erreur")
      //		FinProgramme()
      //	FIN
      //	boucle
      //		wpathexe  = inilit("ACOMBA","PATHEXE","",repencours+"production.ini")
      //		wpathdata = inilit("ACOMBA","PATHDATA","",repencours+"production.ini")
      //		wpathcie = inilit("ACOMBA","CIE","",repencours+"production.ini")
      //		si pas ouvre(acombax.Connection,wpathexe,wpathdata,wpathcie) alors
      //			finprogramme()
      //		sinon
      //			//		si acombax.ACSO_CompagnieConnection(completerep(wpathdata)+sansespace(wpathcie),wpathexe,faux) alors
      //			si acombax.ACSO_CompagnieConnection(completerep(wpathdata),wpathexe,faux) alors
      //				sortir	
      //			FIN
      //		FIN
      //	fin
      //	iniecrit("ACOMBA","PATHEXE",wpathexe,repencours+"production.ini")
      //	iniecrit("ACOMBA","PATHDATA",wpathdata,repencours+"production.ini")
      //	iniecrit("ACOMBA","CIE",wpathcie,repencours+"production.ini")
      //
      //
      //
      //	si ouvre(acombax.motdepasse,nomusager,wmotdepasse,wpathexe,wpathdata,souvenir) alors
      //		//	barredetachemessageaafficher=acomba.aco_nomcie()+" [  "+nomusager+ "  ]"
      //		tableauInfoCie = acombax.ACSO_CompagnieInfo()
      		//message(" " + sansespace(config.NomCompagnie)+" [  "+lusager+ "  ]"+" Version " +  EXEInfo("Version") +  " [Base de données : " + gConnexionHF..BaseDeDonnées + "]")
      		case1 = " " + SansEspace(config.NomCompagnie)+" [  "+lusager+ "  ]" 
      		case3 = " Base de données : [ " + gConnexionHF..BaseDeDonnées + " ] "
      		case2 = " Version " +  EXEInfo("Version")+" "
      	    case4 = acousager
      	
      	
      		
      //
      //		//message(acomba.aco_nomcie()+" [  "+nomusager+ "  ]")
      //		AcombaIni()
      //		lusager = nomusager
      		maitre.btn_usager..LARGEUR = (TAILLE(lusager)+1) * 10
      		//Code WinDev 5.5 remplacé par la migration :
      		//	maitre.btn_usager..colonne = 780 - (TAILLE(lusager) * 10)
      		maitre.btn_usager..x = sysxres() - (TAILLE(lusager) * 10) - 30
      		maitre.btn_usager..libellé  = lusager
      		maitre.btn_usager..etat = actif
      		maitre.BTN_usager..visible = vrai
      		maitre.btn_constructor..etat = actif
      //		ensemblepersoactif = vrai
      //		si pas config.FichierThermosCommun
      //			HChangeRep("PERSOENS",repdonnees+sansespace(lusager))
      //			//    HASSIGNE("Glivre",repdonnees+sansespace(usager))
      //			hcreationsiinexistant("PERSOENS")
      //		fin
      //		si souvenir alors
      //			iniecrit("USAGER","USAGER",nomusager,repencours+"production.ini")
      //			iniecrit("USAGER","MOTDEPASSE",crypte(wmotdepasse,"planisoft"),repencours+"production.ini")
      //			iniecrit("USAGER","SOUVENIR",numeriqueverschaine(souvenir),repencours+"production.ini")
      //		sinon
      //			iniecrit("USAGER","USAGER","",repencours+"production.ini")
      //			iniecrit("USAGER","MOTDEPASSE","",repencours+"production.ini")
      //			iniecrit("USAGER","SOUVENIR","",repencours+"production.ini")
      //
      //		fin
      //
      //
      //		acousager = nomusager
      //		acomotdepasse = wmotdepasse
      //		acosouvenir = souvenir	
      //		acoacomba = wpathexe
      //		acodonnees = wpathdata
      //
      //		//       Avantage.av_deconnecter(nomdelasocket01)
      ////		affiche_menu(acousager)
      //	sinon
      //		maitre.btn_usager..LARGEUR = TAILLE("Login") * 10
      //		maitre.btn_usager..x = sysxres() - (TAILLE("Login") * 10) - 30
      //		maitre.btn_usager..libellé = "Login"
      //		maitre.BTN_usager..visible = vrai
      //		maitre.btn_usager..etat = actif
      //	fin
      sinon
      	ensemblepersoactif = vrai
      	maitre.btn_constructor..etat = actif
      	Case1 = " " + SansEspace(config.NomCompagnie)
      	Case3 = " Base de données : [ " + gConnexionHF..BaseDeDonnées + " ] "
      	Case2 = " Version " +  ExeInfo("Version")+" "
      	case4 = "Utilisateur : "+gsuser + " ("+gsusername+")"
      //
      //
      fin
      si fFichierExiste(completerep(frepencours())+"majhisto.txt") alors
      	ExécuteTraitement(bouton16,trtClic)
      	fSupprime(completerep(frepencours())+"majhisto.txt")
      FIN
      
      evenement("affichejauge","*.*",JaugeCompactage)
      
      // nécessaire pour la gestion du fichier dbase pour camaléon
      //si pas hinithf55(completerep(frepencours())+"forxbase.wdd") alors
      //	info(erreurinfo())
      //FIN
      
      
      
      
      
      
      
      
      // Facon de gérer les intercalaire
      
      Table_Intercallaires..visible = faux
      Table_Intercalaires..visible = faux
      //AjusteFacture()
      
      //pour tout typecarr
      //	si typecarr.EpaisseurCadreAluminium = 0 alors typecarr.EpaisseurCadreAluminium = typecarr.EpaisseurCadre
      //	si typecarr.EpaisseurCadreInex = 0 alors typecarr.EpaisseurCadreInex = typecarr.EpaisseurCadre
