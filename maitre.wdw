     name : Utilitaire
     identifier : 0x3e9d90b46ce849cb
     internal_properties : 
     options :
      -
        name : Autoriser_l_accès_aux_utilitaires
        identifier : 0x51538a9d7d14ceab
        internal_properties : 
        code_elements :
         type_code : 26
         p_codes :
          -
            code : |1-
             si _menu.Utilitaire.Autoriser_l_accès_aux_utilitaires..Libellé = "Autoriser l'accès aux utilitaires" alors
             	si ouvre(fCodeAcces) alors
             		_menu.Utilitaire.Autoriser_l_accès_aux_utilitaires..Libellé = "Interdire l'accès aux utilitaires"
             		_menu.Utilitaire.Restructuration_des_fichiers..etat = actif
             		_menu.Utilitaire.Sauvegarde..etat = actif
             		_menu.Utilitaire.Restauration..etat = actif
             		_menu.Utilitaire.Traduction_..etat = actif
             		_menu.Utilitaire.Opérations_Spéciales..etat = actif
             		_menu.Utilitaire.Code_Externe..etat = actif
             		_menu.Utilitaire.Formes..etat = actif
             		_menu.Utilitaire.Suivi_des_entrées_de_commande..etat = actif
             		_menu.Utilitaire.OPT_Gestion_des_utilisateurs..etat = actif
             		_menu.Utilitaire.OPT_Recalcul_des_commandes..etat = actif
             		_menu.Utilitaire.OPT_Gestion_des_prix..etat = actif
             		
             	fin
             sinon
             	_menu.Utilitaire.Autoriser_l_accès_aux_utilitaires..Libellé = "Autoriser l'accès aux utilitaires"
             	_menu.Utilitaire.Restructuration_des_fichiers..etat = grise
             	_menu.Utilitaire.Sauvegarde..etat = grise
             	_menu.Utilitaire.Restauration..etat = grise
             	_menu.Utilitaire.Traduction_..etat = grise
             	_menu.Utilitaire.Opérations_Spéciales..etat = grise
             	_menu.Utilitaire.Code_Externe..etat = grise
             	_Menu.Utilitaire.Formes..Etat = grise
             	_Menu.Utilitaire.OPT_Gestion_des_utilisateurs..Etat = grise
             	_Menu.Utilitaire.Suivi_des_entrées_de_commande..Etat = grise
             			_Menu.Utilitaire.OPT_Recalcul_des_commandes..Etat = grise
             	_Menu.Utilitaire.OPT_Gestion_des_prix..Etat = grisé
             FIN
             
             EnvoieTouche("%u",maitre)
            type : 32
