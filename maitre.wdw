  -
    name : BTN_USAGER
    identifier : 0x3e9d90b36b5e463c
    internal_properties : 
    properties :
     x : 735
     y : 12
     width : 49
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         //nomdelasocket01 = "connection"
         valeurderetour est un booleen
         valeurderetour  = ouvre(acombax.motdepasse,acousager,acomotdepasse,acoacomba,acodonnees)
         si  valeurderetour alors
         
         
         
         	lusager = acousager
         	maitre.btn_usager..LARGEUR = (TAILLE(lusager)+1) * 10
         	//Code WinDev 5.5 remplacé par la migration :
         	//	maitre.btn_usager..colonne = 780 - (TAILLE(lusager) * 10)
         	maitre.btn_usager..x = sysxres() - (TAILLE(lusager) * 10)  -30
         	maitre.btn_usager..libellé  = lusager
         	maitre.btn_usager..etat = actif
         	maitre.BTN_usager..etat = visible
         	maitre.btn_constructor..etat = actif
         	si frep(repdonnees+sansespace(lusager),frrepertoire) = "" alors
         		//Code WinDev 5.5 remplacé par la migration :
         		//		frepcree(repdonnees+sansespace(lusager))
         		fRepCree_55(repdonnees+sansespace(lusager))
         	FIN
         	ensemblepersoactif = vrai
         	//Code WinDev 5.5 remplacé par la migration :
         	//    HASSIGNE("PERSOENS",repdonnees+sansespace(usager))
         //	HChangeRep("PERSOENS",repdonnees+sansespace(usager))
         	//    HASSIGNE("Glivre",repdonnees+sansespace(usager))
         //	hcreationsiinexistant("PERSOENS")
         	
         //	AFFICHE_MENU(acousager)
         
         sinon
         	maitre.btn_usager..LARGEUR = TAILLE("Login") * 10
         //Code WinDev 5.5 remplacé par la migration :
         //	maitre.btn_usager..colonne = 780 - (TAILLE("Login") * 10)
         	maitre.btn_usager..x = sysxres() - (TAILLE("Login") * 10) -30
         	maitre.btn_usager..libellé = "Login"
         	maitre.btn_usager..etat = actif
         fin
         // fin
         
         
         
        type : 18
      -
        type : 161
        enabled : false
