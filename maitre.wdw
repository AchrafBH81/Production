   -
     name : AffichePeinture
     procedure_id : 5192059773704057467
     type_code : 14
     code : |1-
      Procédure AffichePeinture()
      listeaafficherUnite est une chaine
      listeaafficherLineaireUnite est une chaine
      listeaafficherLineaireContour est une chaine
      hcreation(tempoliste)
      i est un entier
      pour tout fdetail sur fdnocomm
      	si HLitRecherche(Facture,fanumero,fdetail.fdnocomm)  ALORS
      
      
      		si fdetail.ftype = 5 alors
      			si hlitrecherche(invent,INUM,fdetail.fdnumprod) alors
      				selon invent.iUniteMesure
      					cas 1
      						tempoliste.TJOBLIGNE = "Unité"
      					cas 2
      						tempoliste.TJOBLIGNE = "Linéaire Contour"
      					cas 3
      						tempoliste.TJOBLIGNE = "Linéaire Unité"
                          autres cas
                          tempoliste.TJOBLIGNE = ""
      				FIN
                  tempoliste.tcomm = fdetail.fdnocomm
                  tempoliste.tproduit = fdetail.fdnumprod
                  tempoliste.tclient = facture.faclient
                  
                  tempoliste.tligne = fdetail.fdligne
                  hajoute(tempoliste)
      			FIN
      		sinon 
      			//hsupprime(fdetail,hNumEnrEnCours)
      		fin
      
      	FIN
      fin
      iapercu()
      //iImprimeEtat(EtatListeCommandePeinture)
