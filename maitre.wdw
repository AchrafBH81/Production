  procedures :
   -
     name : AcombaIni
     procedure_id : 4511921500311209622
     type_code : 14
     code : |1+
      Procédure AcombaIni(change = faux)
      
      monfichier EST une description de fichier
      marubrique EST UNE DESCRIPTION DE RUBRIQUE
      numeroderecord est un entier = 1
      listegl est un tableau dynamique = ACGL_FicheListe()
      
      
      //info(frep(repavantage,FRRepertoire))
      
      
      //HChangeRep(glivre,frepencours())
      HChangeRep(Glivre,".\"+NetAdresseIP())
      //    HASSIGNE("Glivre",repdonnees+sansespace(usager))
      //hcreationsiinexistant("PERSOENS")
      hcreation(glivre)
      
      i est un entier 
      
      pour i = 1 a dimension(listegl)/2
      	
      	glivre.numerogl = sansespace(listegl[i,1])
      	glivre.Description    = listegl[i,2]
      	hajoute(glivre)
      
      fin
      
      //ouvre(numerodegrandlivre)
      
      
     type : 458752
   -
     name : installeversion
     procedure_id : 4511921501518775988
     type_code : 14
     code : |1+
      Procédure installeversion()
      //Code WinDev 5.5 remplacé par la migration :
      //versioninstalle est une chaine = infoexe("Version")
      versioninstalle est une chaine = EXEInfo("Version")
      cheminini est une chaine = fchemincourt(inilit("installe","installe","vide",repencours+"THERMA.INI"))
      //Code WinDev 5.5 remplacé par la migration :
      //versionainstaller est une chaine = infoexe("Version",...
      versionainstaller est une chaine = EXEInfo("Version",...
      cheminini+"inst\thermafix.exe")
      
      
      si versionainstaller = "" alors
      	
      	erreur("Le numéro de version n'est pas inscrit,aucune mise a jour possible")
      	
      sinon
      
      	si versionainstaller < versioninstalle alors
      		erreur("Le numéro de version courant est plus grand que celui de la version a installer","Aucune mise a jour ne sera effectuée")
      		
      	sinon
      		si versioninstalle <> versionainstaller alors
      			titresuivant("Mise a jour")
      			info("La version n'est pas à jour,Installation de la nouvelle version")
      			ddelance(cheminini+"installe.exe")
      			finprogramme()
      		FIN
      	fin
      fin
      //info(infoexe("Version",fchemincourt(inilit("installe","installe","vide",repencours+"THERMA.INI"))))
      
     type : 458752
   -
     name : LireFichier
     procedure_id : 4511921502022354632
     type_code : 14
     code : |1+
      Procédure LireFichier()
      //--Code généré au niveau du curseur-------------------------------------------------------
      //-- début du code généré par l'assistant -----------
      NumFic est un entier
      NomFichier est une chaine
      UneLigne est une chaine
      //Code WinDev 5.5 remplacé par la migration :
      //LongFichier est un entier long
      LongFichier est un entier  
      //Code WinDev 5.5 remplacé par la migration :
      //LongDejaLue est un entier long
      LongDejaLue est un entier  
      ligne1  = ""
      record EST UNE tableau de 8 chaine
      I EST UN ENTIER = 1
      x est un entier
      NomFichier="dbclitmp"
      
      
      // Ouverture du fichier et vérification du résultat
      
      //Code WinDev 5.5 remplacé par la migration :
      //NumFic=fOuvre(NomFichier,FOLecture+FOBinaire)
      NumFic=fOuvre(NomFichier,FOLecture+0)
      SI NumFic=-1 ALORS
      	Erreur("Impossible d'ouvrir le fichier "+NomFichier)
      	RETOUR
      FIN
      
      // Initialisation des paramètres pour la jauge
      LongFichier=fPositionne(NumFic,0,FPFin)
      LongDejaLue=fPositionne(NumFic,0,FPDebut)
      
      // Lecture complète, ligne par ligne
      
      ouvrefille("FENJAUGE","Récupération des clients Avantage")
      sablier
      I = 1
      BOUCLE
      	UneLigne = fLitLigne(NumFic)
      	SI UneLigne = EOT ALORS 
      	 //Jauge(100,100)
           execute("fenjauge.progression",100)
      	 ferme("FENJAUGE")
      	 SORTIR
      	FIN
      
      	// Mise à jour de la jauge
      	LongDejaLue = LongDejaLue+Taille(UneLigne)+2
      	//Jauge(LongDejaLue/10, LongFichier/10)
          execute("fenjauge.progression",LongDejaLue/LongFichier * 100)
      	//DEBUT TRAITEMENT
      	// Vous pouvez insérer ici un traitement quelconque sur la ligne
      	// qui vient d'être lue.
      	//BOUCLE  // début de la boucle de lecture chaque record
      		//LIGNE1 = EXTRAITCHAINE(UNELIGNE,I,CARACT(10))
      		LIGNE1 = UneLigne
      		//SI LIGNE1 = EOT ALORS SORTIR
              si pas gauche(ligne1,3) = "REQ" alors   // pour sauter la première et dernière ligne
                 
      		   x=1
      		   pour x= 1 a 8 // début de la lecture de chaque champs de chaque record
      		    record[x] = EXTRAITCHAINE(ligne1,2*x,caract(34))
                  
      		    //si record[x] = eot alors sortir
      			
      	        //x++
      	       fin
      		   maj_fichier()
      		fin
      		//I++
      	//FIN
      	//info(UneLigne)
      	//FIN TRAITEMENT
      FIN
      
      //Fermeture du fichier texte
      fFerme(NumFic)
      //Jauge()
      //ferme("FENJAUGE")
      //-- fin du code généré par l'assistant -----------
      
     type : 458752
   -
     name : maj_fichier
     procedure_id : 4511921500735555332
     type_code : 14
     code : |1+
      Procédure maj_fichier()
      i est un entier = 1
      nombre est un entier  // nombre d'enregistrement
      numcli est une chaine
      ouvrefille("FENJAUGE","Transfert au fichier client")
      sablier
      sqlpremier("req1")
      sqlinfogene("req1")
      nombre = sql.nblig	
      
      
      
      tantque pas sql.endehors 
      //	 tableajoute("TABLE1",sqlcol("req1",1)+tab+sqlcol("req1",2))
      //	fin
      	execute("fenjauge.progression",i/nombre * 100)
          
      	//hraz("client")
          numcli         = sqlcol("req1",1) 
      	cl.numero      = numcli
      	cl.nom         = sqlcol("req1",2)
      	cl.crue        = sqlcol("req1",3)
      	cl.cville      = sqlcol("req1",4)
          cl.ccodepostal = sqlcol("req1",5)
          cl.ctelephone  = sqlcol("req1",6)
      	cl.cfax        = sqlcol("req1",7)
      	cl.cemail      = sqlcol("req1",8)
      	
      	hrecherche("client","numero",numcli)
      
      //Code WinDev 5.5 remplacé par la migration :
      //	si h.trouve alors
      	si HTrouve() alors
      	    
      //		hecrit("client",h.numenr)
      	sinon
      		//cl.numero	 = c1.c1numero
              
      		hajoute("client")
      		
      	FIN
      //Code WinDev 5.5 remplacé par la migration :
      //	si herrintegrite() alors
      	si HErreurIntegrite() alors
      	   erreurinfo(errMessage)
      	fin   
      	 sqlsuivant("req1")
            i++
              
      fin
      ferme("FENJAUGE")
      
     type : 458752
   -
     name : maj_fichier_hyper
     procedure_id : 4511921501549053730
     type_code : 14
     code : |1+
      Procédure maj_fichier_hyper()
      nombre est un entier  // nombre d'enregistrement
      //hinfogene("clitmp")
      nombre = hnbenr(clitmp)
      
      ouvrefille("FENJAUGE","Transfert au fichier client")
      sablier
      hlitpremier("clitmp","C1CLEUNIK")
      //Code WinDev 5.5 remplacé par la migration :
      //tantque pas h.endehors
      tantque pas HEnDehors()
      	execute("fenjauge.progression",h.numenr/nombre * 100)
          
          
      	//hraz("client")
          cl.numero      = c1.c1numero
      	cl.nom         = c1.c1nom
      	cl.crue        = c1.c1rue
      	cl.cville      = c1.c1ville  
          cl.ccodepostal = c1.c1codepostal 
          cl.ctelephone  = c1.c1telephone
      	cl.cfax        = c1.c1fax
      	cl.cemail      = c1.c1email 
      	hrecherche("client","numero",c1.c1numero)
      //Code WinDev 5.5 remplacé par la migration :
      //	si h.trouve alors
      	si HTrouve() alors
      	    
      //Code WinDev 5.5 remplacé par la migration :
      //		hecrit("client",h.numenr)
      		hecrit("client",h.numenr,hForceIdAuto)
      	sinon
      		//cl.numero	 = c1.c1numero
              
      		hajoute("client")
      		
      	FIN
      //Code WinDev 5.5 remplacé par la migration :
      //	si herrintegrite() alors
      	si HErreurIntegrite() alors
      	   erreurinfo(errMessage)
      	fin   
      		hlitsuivant("clitmp","C1CLEUNIK")
              
      fin
      ferme("FENJAUGE")
      
