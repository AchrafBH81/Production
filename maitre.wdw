   -
     name : EDI
     identifier : 0x2c3a026609400695
     internal_properties : 
     options :
      -
        name : Récupération_de_commandes
        identifier : 0x2c3a029709d4c6f7
        internal_properties : 
        code_elements :
         type_code : 26
         p_codes :
          -
            code : |1+
             clClient est une mclient = ouvre(SelectEDI)
             si clClient = null alors
             	info("Aucun client n'a été sélectionné")
             sinon
             	selon clClient.m_ediType
             		cas 1
             			ouvre(FEN_CommandesRecues,clClient.m_IDClient,clClient.m_nom,clClient.m_numero)
             		cas 2
             
             			ouvre(fcommanderecubasco,clClient)	
             		AUTRE CAS
             			
             	FIN
             FIN
            type : 32
      -
        name : Table_de_concordances
        identifier : 0x2c3a02b609d63fb1
        internal_properties : 
        code_elements :
         type_code : 26
         p_codes :
          -
            code : |1+
             clClient est une mclient = ouvre(SelectEDI)
             SI clClient = Null ALORS
             	Info("Aucun client n'a été sélectionné")
             SINON
             	SELON clClient.m_ediType
             		CAS 1
             		CAS 2
             			Ouvre(FenGestionRelationThermos,clClient)	
             		AUTRE CAS
             			
             	FIN
             fin
             
             
             
            type : 32
