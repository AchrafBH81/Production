     p_codes :
      -
        code : |1+
         NewNumber est une chaîne
         
         saisie("Nouveau numero",NewNumber)
         sdReqsql est une source de donnees
         
         	
         	si hexecuterequetesql(sdReqsql,hRequêteDéfaut,chaineconstruit("select * from persoens where ennumero = '%1'",sansespace(TABLE.TENNUMERO)))  ALORS
              si pas hlitrecherche(persoens,ennumero,NewNumber) alors
         		hlit(sdReqsql,1)
         		HCopieEnreg(persoens,sdreqsql)
         		persoens.ennumero = Newnumber
         		hajoute(persoens)
         	FIN
         FIN
         
         
