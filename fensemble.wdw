  -
    name : BTN_OK
    identifier : 0x3e9d90af33723786
    internal_properties : 
    properties :
     x : 53
     y : 2
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         //restaure_bouton()
         si ajout alors
         	SI PAS HLITRECHERCHE(PERSOENS,ennumero,FENSEMBLE.ennumero,hIdentique) ALORS
         		ECRANVERSFICHIER
         		persoens.enactif = VRAI
         		si enactif  alors
         			persoens.enprixa = fensemble.enprixa
         			persoens.enprixm = fensemble.enprixm
         			persoens.enprixfutura = fensemble.enprixfutura
         			persoens.enprixfuturm = fensemble.enprixfuturm
         		FIN
         		hajoute(persoens)
         		fiche..etat = actif; fiche..Visible=Vrai
         		validation..etat = grisé; validation..Visible=Vrai
         		ENSEMBLE_DETAIL..ETAT = AffichageSeulement; ENSEMBLE_DETAIL..Visible=Vrai
         		GrpPrix..etat = AffichageSeulement
         		GrpNovy..etat = AffichageSeulement
         		GrpPeinture..etat = AffichageSeulement
         
         		FENSEMBLE.TABLE..ETAT = AffichageSeulement
         		TABLEAFFICHE("TABLE",taCourantPremier)
         		ajout = faux
         		modif = faux
         		REPRISESAISIE(BTN_SORTIE)
         	SINON
         
         		acso_message("Erreur","Numéro déjà existant","Erreur")
         
         		fiche..etat = actif; fiche..Visible=Vrai
         		validation..etat = grisé; validation..Visible=Vrai
         		ENSEMBLE_DETAIL..ETAT = AffichageSeulement; ENSEMBLE_DETAIL..Visible=Vrai
         		FENSEMBLE.TABLE..ETAT = AffichageSeulement
         		GrpPrix..etat = AffichageSeulement
         		GrpNovy..etat = AffichageSeulement
         		GrpPeinture..etat = AffichageSeulement
         
         		TABLEAFFICHE("TABLE",taCourantPremier)
         		EXECUTETRAITEMENT(TABLE,TRTSELECTION)
         	FIN
         
         sinon
         	si fensemble.ennumero..modifié alors
         		si ACSO_message("Question","Le numéro de thermos à été modifié , voulez-vous continuer ?","OuiNon") = IDYES alors
         		    HGèreIntégrité(Contrainte_ThermosClient_persoens,"*",faux)
         		    
         			ModifieNumero(persoens.ennumero,fensemble.ennumero)
         			ECRANVERSFICHIER(fensemble,persoens)
         			si enactif alors
         				persoens.enprixa = fensemble.enprixa
         				persoens.enprixm = fensemble.enprixm
         				persoens.enprixfutura = fensemble.enprixfutura
         				persoens.enprixfuturm = fensemble.enprixfuturm
         			FIN
          //           info(persoens.ennumero)
         			hmodifie(persoens,hnumenrencours)
         //			Erreur(ErreurInfo(errComplet))
         //			info(persoens.ennumero)
         		FIN
         	sinon
         		ECRANVERSFICHIER(fensemble,persoens)
         		si enactif alors
         			persoens.enprixa = fensemble.enprixa
         			persoens.enprixm = fensemble.enprixm
         			persoens.enprixfutura = fensemble.enprixfutura
         			persoens.enprixfuturm = fensemble.enprixfuturm
         		FIN
         		hmodifie(persoens,hnumenrencours)
         	fin
         	fiche..etat = actif; fiche..Visible=Vrai
         	validation..etat = grisé; validation..Visible=Vrai
         	ENSEMBLE_DETAIL..ETAT = AffichageSeulement; ENSEMBLE_DETAIL..Visible=Vrai
         	GrpNovy..etat = AffichageSeulement
         	GrpPeinture..etat = AffichageSeulement
         
         	FENSEMBLE.TABLE..ETAT = AffichageSeulement
         	GrpPrix..etat = AffichageSeulement
         	TABLEAFFICHE("TABLE",taCourantBandeau)
         
         FIN
         ajout = faux
         modif = faux
         
        type : 18
      -
        type : 161
        enabled : false
  -
