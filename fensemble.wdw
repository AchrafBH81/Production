     type_code : 4
     p_codes :
      -
        code : |1+
         
         RequêteTrouveThermos.pNumero = null
         RequêteTrouveThermos.pcomposant1 = null
         RequêteTrouveThermos.pcomposant2 = null
         RequêteTrouveThermos.pcomposant3 = null
         HExécuteRequête(RequêteTrouveThermos,hModifieFichier)
         pour tout RequêteTrouveThermos
         	RequêteTrouveThermos.OrdreTrtXopt = 999
         	RequêteTrouveThermos.nbThermosPArRack = 1
         	HModifie(RequêteTrouveThermos,hNumEnrEnCours)
         FIN
         pour tout OrdreTrtXopt 
         	RequêteTrouveThermos.pnumero = null
         	RequêteTrouveThermos.pcomposant1 = OrdreTrtXopt.Composant1
         	RequêteTrouveThermos.pcomposant2 = OrdreTrtXopt.Composant2
         	RequêteTrouveThermos.pcomposant3 = OrdreTrtXopt.Composant3
         	HExécuteRequête(RequêteTrouveThermos,hModifieFichier)
         
         	pour tout RequêteTrouveThermos
         		si OrdreTrtXopt.QteUnPrep alors
         			RequêteTrouveThermos.nbThermosPArRack = 1 
         		sinon
         			RequêteTrouveThermos.nbThermosPArRack = 2
         		fin
         		RequêteTrouveThermos.OrdreTrtXopt = OrdreTrtXopt.NoOrdre
         		hmodifie(RequêteTrouveThermos,hNumEnrEnCours)
         	FIN
         
         FIN
         fSupprime("Esemble.txt")
         moimeme..Visible = faux
        type : 18
