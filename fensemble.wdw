      -
        code : |1+
         resultatCalcul est une chaine
         FICHIERVERSECRAN
         fensemble.enactif = persoens.enactif
         affichageseul = vrai
         EXECUTETRAITEMENT(encomposant1,trtSortie)
         EXECUTETRAITEMENT(encomposant2,trtSortie)
         EXECUTETRAITEMENT(encomposant3,trtSortie)
         si pas enactif1 et gFormatFacture = 2
         	resultatCalcul = CalculPrixThermos(persoens.ennumero,0,encomposant1,encomposant2,encomposant3,epbase)
         	fensemble.enprixa = val(extraitchaine(resultatCalcul,1,","))
         	fensemble.enprixm = val(extraitchaine(resultatCalcul,2,","))
         	fensemble.enprixfutura = val(extraitchaine(resultatCalcul,4,","))
         	fensemble.enprixfuturm = val(extraitchaine(resultatCalcul,5,","))
         
         sinon
         	fensemble.enprixa = persoens.enprixa
         	fensemble.enprixm = persoens.enprixm
         
         fin
         
         
         affichageseul = faux
         
        type : 33
