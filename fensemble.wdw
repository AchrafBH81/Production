 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1+
      procedure fensemble(mode est une chaine = "")
      // Pour compatibilité 5.5
      MoiMême..Visible=Vrai
      AffichageSeul est UN BOOLEEN = FAUX  // pour savoir si on est en saisie ou en affichage
      
      
      
      
      //numeroevenement[1] = evenement("DOUBLECLIC","btn_composant1",WM_LBUTTONDBLCLK)
      //numeroevenement[2] = evenement("DOUBLECLIC","btn_composant2",WM_LBUTTONDBLCLK)
      //numeroevenement[3] = evenement("DOUBLECLIC","btn_composant3",WM_LBUTTONDBLCLK)
      ensemble_detail..etat = grise
      //hfiltre(persoens,enactif,"1")
      si gFormatFacture = 1 alors
      	GrpPeinture..visible = faux
      	GrpNovy..visible = vrai
      sinon
      	GrpPeinture..visible = vrai
      	GrpNovy..visible = faux
      
      FIN
      
   -
     code : |1+
      
      
      ExécuteTraitement(onglet1,trtModification)
     type : 34
   -
     type : 180
     enabled : false
   -
     type : 230
     enabled : false
   -
     code : |1+
      valide_sortie()
      finevenement(numeroevenement[1])
      finevenement(numeroevenement[2])
      finevenement(numeroevenement[3])
      
     type : 2
   -
     type : 11
   -
     type : 12
   -
     type : 17
   -
     type : 13
  procedures :
   -
     name : existe_produit1
     procedure_id : 5088214857867434306
     type_code : 14
     code : |1+
      Procédure existe_produit1(produit,videpermis=vrai,type = "")
      retourne est un booléen = faux
      si sansespace(produit) = "" alors
      	si videpermis alors
      		retourne = vrai
      	sinon
      		retourne = faux
      	fin	
      
      sinon
      
      	si 	hlitrecherche("invent","INUM",complete(produit,10))   alors
      
      
      		si pas invent.itype = 1 alors
      
      			retourne = faux
      			acso_message("Erreur","Ce produit ne peut pas être une composante","Erreur")
      		sinon
      			retourne = vrai
      		fin
      	sinon
      		acso_message("Erreur","Ce produit ne peut pas être une composante","Erreur")
      	FIN
      FIN
      
      renvoyer retourne
      
     type : 458752
   -
     name : ModifieNumero
     procedure_id : 5589228053874872825
     type_code : 14
     code : |1-
      Procédure ModifieNumero(_ancien,_nouveau)
      
      pour tout fdetail
      	si fdetail.fdnumprod = _ancien alors
      		fdetail.fdnumprod = _nouveau
      	    hmodifie(fdetail,hNumEnrEnCours)
      	FIN
      FIN
      
      pour tout hfdetail
      	si hfdetail.fdnumprod = _ancien alors
      		hfdetail.fdnumprod = _nouveau
      		hmodifie(hfdetail,hNumEnrEnCours)
      	FIN
      FIN
      
      pour tout ThermosClient
      	si ThermosClient.IdThermos = _ancien alors
      		thermosclient.IdThermos = _nouveau
      		hmodifie(ThermosClient,hNumEnrEnCours)
      	FIN
      FIN
     type : 458752
  procedure_templates : []
  property_templates : []
