  -
    name : BTN_AJOUT
    identifier : 0x3e9d90af6d8f37d6
    internal_properties : 
    properties :
     x : 290
     y : 2
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         restaure_bouton()
         
         ajout = vrai
         
         //Code WinDev 5.5 remplacé par la migration :
         //TABLE..ETAT = GRISE
         TABLE..ETAT = GRISE; TABLE..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         //ensemble_detail..etat = actif
         ensemble_detail..etat = actif; ensemble_detail..Visible=Vrai
         si gFormatFacture = 1 alors
         	grpnovy..etat = actif
         sinon
         	Grppeinture..etat  = actif
         FIN
         //Code WinDev 5.5 remplacé par la migration :
         //validation..etat = actif
         validation..etat = actif; validation..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         //fiche..etat = grise
         fiche..etat = grise; fiche..Visible=Vrai
         
         hraz("persoens")
         raz
         ecranpremier("ennumero")
         
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_MODIFIE
    identifier : 0x3e9d90af297137e0
    internal_properties : 
    properties :
     x : 325
     y : 2
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         restaure_bouton()
         
         modif = vrai
         
         //Code WinDev 5.5 remplacé par la migration :
         //navigation..etat = grisé
         navigation..etat = grisé; navigation..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         //fiche..etat = grisé
         fiche..etat = grisé; fiche..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         //validation..etat = actif
         validation..etat = actif; validation..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         //ensemble_detail..etat = actif
         ensemble_detail..etat = actif; ensemble_detail..Visible=Vrai
         si gFormatFacture = 1 alors
         	grpnovy..etat = actif
         sinon
         	Grppeinture..etat  = actif
         FIN
         
         //Code WinDev 5.5 remplacé par la migration :
         //fensemble.ennumero..etat = inactif
         //fensemble.ennumero..etat = AffichageSeulement
         fensemble.table..etat = grise
         fichierversecran(fensemble,persoens)
         fensemble.enactif = persoens.enactif
         si enactif1 ou enVerreUnite alors
         	GrpPrix..etat = actif
         FIN
         
         si gFormatFacture <> 2 alors
         	GrpPrix..etat = actif
         FIN
         reprisesaisie("fensemble.endescription")
         
        type : 18
      -
        type : 161
        enabled : false
