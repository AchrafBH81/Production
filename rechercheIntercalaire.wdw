  internal_properties : CQAAAAkAAAD2PtCjP9C2ZwhtneOX7bkDWPz0AaA+0xtpwpDBzoojtuHSleg9LbEnnlBwQCmCGnMdRMBZjTwcOwA9ZA0VdtIF3CL1yR1UWwPZiL8nA2FYg6JXOSPwyvaLVgmqMQ==
 actionbar : {}
 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1+
      
      fonction rechercheIntercalaire(_type =  1,_numero = "")
      
      
      
      
      // L'appel à cette fenêtre est du type:
      //       OUVRE(nom_fen,SaisieOK)
      //		 si SaisieOK alors 		// Un enregistrement a été sélectionné
      // Vous pouvez aussi utiliser la syntaxe d'appel suivante:
      //       SI OUVRE(nom_fen) alors		// Un enregistrement a été sélectionné
      
      
      // Pour compatibilité 5.5
      MoiMême..Visible=Vrai
      Global
      resultat est une chaine = ""
      chainecouleur est une chaine = ""
      resultatrecherche est un entier
      
      
      
      //hfiltre(spacer,ChaîneConstruit("stype = '%1' et ",_type)+ chainecouleur)
      
      RequeteSpacerClient.pIdIntercalaires = _type
      HExécuteRequête(RequeteSpacerClient)
      
      
      
      
      
      
      
      
      
   -
     code : |1+
      selon gFormatFacture
      	cas 1
      		tableselectplus(table,tablecherche(TABLE.iDimension,_numero))
      	cas 2
      		tableselectplus(table,tablecherche(TABLE.INUM,_numero))
      
      fin
      //TableAffiche(table,taCourantpremier)
      
      
      
     type : 34
   -
     type : 180
     enabled : false
   -
     type : 230
     enabled : false
   -
     code : |1+
      
      
      Renvoyer resultat
      
     type : 2
