   -
     name : CheckIfSpecialProduct
     procedure_id : 1156831707709658319
     type_code : 12
     code : |1-
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] CheckIfSpecialProduct (<sComposant1> est chaîne, <sComposant2> est chaîne, <sComposant3> est chaîne, <Avecpinede>, <Avecsatine>, <AvecUltraClair>)
      //
      // Paramètres :
      //	sComposant1 (chaîne ANSI) : <indiquez ici le rôle de nbcomposant>
      //	sComposant2 (chaîne ANSI) : <indiquez ici le rôle de nbComposantSpeciaux>
      //	sComposant3 (chaîne ANSI) : <indiquez ici le rôle de composant3>
      //	Avecpinede : <indiquez ici le rôle de Avecpinede>
      //	Avecsatine : <indiquez ici le rôle de Avecsatine>
      // 	AvecUltraClair : <indiquez ici le rôle de AvecUltraClair>
      
      // Valeur de retour :
      // 	booléen : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE CheckIfSpecialProduct(sComposant1 est un chaine,sComposant2 est une chaîne ,sComposant3 est une chaine ,Avecpinede,Avecsatine,AvecUltraClair)
      
      nbcomposant est un entier = 0
      nbComposantSpeciaux est un entier = 0
      POUR i = 1 À 3
      	SI SansEspace({"scomposant"+i,indVariable}) <> "" ALORS 
      		nbcomposant++
      	FIN
      	SI HLitRecherche(invent,INUM,{"scomposant"+i,indVariable}) ALORS
      		SI invent.IproduitSpecial ALORS
      			nbComposantSpeciaux++
      		FIN
      		Avecpinede = invent.IPinede
      		Avecsatine = invent.ISatine
      		AvecUltraClair = invent.IsUltraClair
      	FIN
      FIN
      
      renvoyer nbcomposant <> 0 _et_ nbComposantSpeciaux = nbcomposant
     type : 458752
