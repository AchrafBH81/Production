 code_elements :
  type_code : 10
  p_codes :
   -
     code : |1+
      cOrderGenerate est une Classe
      	
      	
      	Customer							est une chaîne 
      	OrderNumber							est une chaîne
      	InvoiceNumber						est une chaîne 
      	ShippingStreet						est une chaîne 
      	ShippingCity						est une chaîne 
      	DateSent							est une DateHeure
      	DateRequested						est une date
      	ShippingPostalCode					est une chaîne 
      	ShippingState						est une chaîne 
      	ShippingCountry						est une chaîne 
      	BillingStreet						est une chaîne 
      	BillingCity							est une chaîne 
      	BillingPostalCode					est une chaîne 
      	BillingState						est une chaîne 
      	BillingCountry						est une chaîne 
      	FranchiseCode						est une chaîne
      	JobNumber							est une chaine
      	DefaultSpacer						est une chaîne
      	DefaultSpacerID						est un entier
      	ClientID							est une entier
      	ShippingCustomerID					est un entier
      	NoClient							est une chaîne 
      	unitedemesure						est un entier 
      	ClientCalculeSurfaceReelle			est un booléen
      	PourcSurchargeCarrelage				est un réel
      	
      	SurchargeEnergieBase				est un réel
      	SurchargeEnergieCarrelage			est un réel
      	SurchargeEnergieForme				est un réel
      	
      	minimuma							est une réel
      	minimumm							est un réel
      	clientcalculCarrelageSpecialContour	est un booléen	//si client calcule contour de carrelage avec la formule spéciale dans typecarr.
      	TexteMessage						est une chaîne
      	NumeroInterne						est une chaîne
      	
      	NbLignetrempee						est un entier
      	NbLigneNonTrempee					est un entier
      	
      	PurchaseOrderItems					est un tableau de cOrderdetailsGenerate
      	
      	CommandeExiste						est une booléen 
      	IsArgon								est un booléen	= Faux
      	
      	m_clCustomerInfo					est un mclient
      	
      	m_clShippingInfo est un cClientLivraison
      	
      	
      	
      	
      	
      	
      	
      FIN
     type : 131072
