 controls : []
 code_elements :
  type_code : 13
  p_codes :
   -
     code : |1-
      procedure EHistoSommaireParVendeur(ldate est une chaine,lidvendeur est un entier = 0)
      
      si lidvendeur <> 0 alors FIN_DOCUMENT..visible = faux
     type : 327680
