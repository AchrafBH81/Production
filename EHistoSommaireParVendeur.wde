     -
       name : EcartMois
       identifier : 0x5629576002d970c4
       internal_properties : 
       properties :
        x : 246.915
        width : 22.45
        height : 5.77
       code_elements :
        type_code : 29
        p_codes :
         -
           code : |1+
            si ventemois = 0 et ventemoisprec = 0 alors 
            	moimeme = 0
            sinon SI VenteMois = 0 alors 
            	moimeme = -1
            sinon si ventemoisprec = 0 alors 
            	moimeme = 1
            sinon
            	moimeme = (ventemois - ventemoisprec) / abs(ventemoisprec) 
            	SI Abs(MoiMême) > 99.9999 ALORS 
            		SI MoiMême > 0 ALORS MoiMême = 99.9999 SINON MoiMême = -99.9999
            	FIN
            fin
           type : 327692
     -
       name : VenteAnnee
       identifier : 0x5629576002da70c4
       internal_properties : 
       properties :
        x : 269.458
        width : 27.
        height : 5.77
       code_elements :
        type_code : 29
        p_codes :
         -
           code : |1+
            moimeme+= ventemois
           type : 327692
     -
       name : VenteAnneePrec
       identifier : 0x5629576002db70c4
       internal_properties : 
       properties :
        x : 296.458
        width : 27.
        height : 5.77
       code_elements :
