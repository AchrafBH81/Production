    controls :
     -
       name : RUBRIQ1
       identifier : 0x4d8356bc3213f2d4
       internal_properties : 
       properties :
        x : 30.9
        width : 117.85
        height : 5.
       code_elements :
        type_code : 29
        p_codes :
         -
           code : |1+
            si hlitrecherche(persoens,ennumero,RequetePersoClient.IdThermos) alors
            	si client.CLangue=1 alors moimeme = sansespace(persoens.endescription) sinon moimeme = sansespace(persoens.endescriptiona)
            sinon
            	si client.CLangue=1 alors moimeme = "Thermos Inexistant" sinon moimeme = "Thermos not found"		
            FIN
            
           type : 327692
         -
           type : 327699
           enabled : false
     -
       name : CALCUL1
       identifier : 0x4d8356bc1cb4f2d4
       internal_properties : 
       properties :
        x : 148.8
        width : 22.
        height : 5.
       code_elements :
        type_code : 29
        p_codes :
         -
           code : |1+
            //calcul1 = calculprix(ENSEMBLE.encomposant1,ENSEMBLE.encomposant2,ENSEMBLE.encomposant3,"A",ENSEMBLE.epbase) //* (100 - spqteint.spqpourcentageescompte) / 100
            resultatcalcul est une chaine = CalculPrixThermosListe(RequetePersoClient.IdThermos,client.IDClient)
            MontantPrixA est un reel = extraitchaine(resultatcalcul,1,",")
            MontantPrixM est un reel = extraitchaine(resultatcalcul,2,",")
            
            
            calcul1 = MontantPrixA
            calcul2 = MontantPrixM
            
            
           type : 327692
         -
           type : 327699
           enabled : false
