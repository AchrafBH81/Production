      	cas 3
      		selon udemesure
      		cas "A"
      		   montant = invent.iprixtriple
      		cas "M"
      		   montant = invent.iprixtriplem
      		fin   
      	FIN
          
      //fin
      FIN
      
      renvoyer montant + totalextra
      
     type : 458752
   -
     name : assigneLibelle
     procedure_id : 5585403328923693749
     type_code : 14
     code : |1-
      Procédure assigneLibelle()
      i est un entier
      
      lTableauLibelle est un tableau de 24 chaines
      lTableauLibelle[1]  = "lentete,lentete"
      lTableauLibelle[2]  = "lentete,lEntete1"
      lTableauLibelle[3]  = "lvigueur,LVigueur"
      lTableauLibelle[4]  = "lvigueur,LVigueur1"
      lTableauLibelle[5]  = "facdate,LDate"
      lTableauLibelle[6]  = "facdate,LDate1"
      lTableauLibelle[7]  = "lremplace,lremplace"
      lTableauLibelle[8]  = "lremplace,lremplace1"
      lTableauLibelle[9]  = "lthermos,lthermos"
      lTableauLibelle[10]  = "lthermos,lthermos1"
      lTableauLibelle[11]  = "lthermossuite,lthermossuite"
      lTableauLibelle[12]  = "lthermossuite,lthermossuite1"
      lTableauLibelle[13]  = "lnumero,lnumero"
      lTableauLibelle[14]  = "lnumero,lnumero1"
      lTableauLibelle[15]  = "facdescription,facdescription"
      lTableauLibelle[16]  = "facdescription,facdescription1"
      lTableauLibelle[17]  = "langlais,langlais"
      lTableauLibelle[18]  = "langlais,langlais1"
      lTableauLibelle[19]  = "lmetrique,lmetrique"
      lTableauLibelle[20]  = "lmetrique,lmetrique1"
      lTableauLibelle[21]  = "lprix,lprix"
      lTableauLibelle[22]  = "lprix,lprix1"
      lTableauLibelle[23]  = "lcondpaiement,LCondpaiement"
      lTableauLibelle[24]  = "lcondpaiement,LCondpaiement1"
      
      selon client.CLangue
      	cas 1
      		pour i = 1 a 24
      			si hlitrecherche(Traduction,TRecherche,extraitchaine(lTableauLibelle[i],1,",")) alors
      				{"ListeThermosPrixClientTRN."+ExtraitChaîne(lTableauLibelle[i],2,",")} = traduction.dFrancais
      			fin
      		FIN
      	cas 2
      		pour i = 1 a 24
      			si hlitrecherche(Traduction,TRecherche,extraitchaine(lTableauLibelle[i],1,",")) alors
      				{"ListeThermosPrixClientTRN."+ExtraitChaîne(lTableauLibelle[i],2,",")} = traduction.danglais
      			fin
      		FIN
      fin
     type : 458752
