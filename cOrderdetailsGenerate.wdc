      //		//		sinon
      //		//			{"DM"+i} = executetraitement("formule1",trtProcédure)
      //		//		fin
      //		si 	{"DM"+i} < 0 alors
      //			{"DM"+i} = 0
      //		FIN
      //		
      //		
      //		
      //		si sansespace(typecarr.conditionsidm[i]) = "" alors
      //			impvideo.vdimensionmorceau[i] = {"DM"+i}
      //		sinon
      //			formule = sansespace(typecarr.conditionsidm[i])
      //			formule = RemplaceFormule(formule)
      //			res = compile("formule2","y est un reel"+RC+"y="+formule+RC+"renvoyer y ")
      //			si res = "" alors
      //				resultatcondition = ExécuteTraitement("formule2",trtProcédure)
