  -
    name : Nouveau
    identifier : 0x262573f94a493ea8
    internal_properties : 
    properties :
     x : 668
     y : 6
     width : 110
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         
         hraz(Vendeur)
         
         // Ajoute l'enregistrement
         hajoute(Vendeur)
         
         tABLEaffiche(Vendeur, taCourantEnreg)
         
         fichierversecran()
        type : 18
      -
        type : 161
        enabled : false
  -
    name : Supprimer
    identifier : 0x262573f94a4a3ea8
    internal_properties : 
    properties :
     x : 668
     y : 36
     width : 110
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         
         // Demande confirmation
         si ouinon("Êtes-vous sûr de vouloir supprimer l'enregistrement sélectionné ?") = Oui ALORS
         
         	tablesupprime(Vendeur)
         	
         	tableaffiche(Vendeur, tacourantenreg)
         
         	executetraitement(Vendeur, trtselection)		
         FIN
        type : 18
      -
        type : 161
        enabled : false
  -
    name : Annuler
    identifier : 0x262573f94a4b3ea8
    internal_properties : 
    properties :
     x : 668
     y : 352
     width : 110
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         
         hlit(Vendeur)
         fichierversecran()
        type : 18
      -
        type : 161
        enabled : false
  -
    name : Appliquer
    identifier : 0x262573f94a4c3ea8
    internal_properties : 
    properties :
     x : 668
     y : 322
     width : 110
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         
         ecranversfichier()
         
         si Vendeur..NouvelEnregistrement ALORS
         	hajoute(Vendeur)
         sinon
         	hmodifie(Vendeur)
         FIN
         
         tableaffiche(Vendeur, taCourantEnreg)
        type : 18
      -
        type : 161
        enabled : false
