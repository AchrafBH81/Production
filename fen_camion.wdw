  -
    name : BTN_ANNULE
    identifier : 0x2d972f8991eccdb3
    internal_properties : 
    properties :
     x : 89
     y : 4
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
             restaure_bouton()
         //    htransactionannule()
         //Code WinDev 5.5 remplacé par la migration :
         //    saisie..etat = inactif
             saisie..etat = AffichageSeulement; saisie..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         //	validation..etat = grisé
         	validation..etat = grisé; validation..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         //	fiche..etat = actif
         	fiche..etat = actif; fiche..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         //    kilo..etat = inactif
             kilo..etat = AffichageSeulement; kilo..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         //    table..etat =inactif
             table..etat =AffichageSeulement; table..Visible=Vrai
             modif = faux
         	ajout = faux
         //Code WinDev 5.5 remplacé par la migration :
         //	tableaffiche("TABLE","*")
         	tableaffiche("TABLE",taCourantPremier)
         //Code WinDev 5.5 remplacé par la migration :
         //    execute("table..len")
             ExecuteTraitement("table",trtENTREELIGNE)
         
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_DETRUIRE
    identifier : 0x2d972f8991edcdc2
    internal_properties : 
    properties :
     x : 283
     y : 4
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         si acso_message("Question","Voulez-vous annuler ce camion","OuiNon",1) = idyes alors
         	
         TABLESUPPRIME(TABLE,TABLE)
         
         
         fin
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_MODIFIE
    identifier : 0x2d972f8991eecdc2
    internal_properties : 
    properties :
     x : 212
     y : 4
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         
         restaure_bouton()
         modif = vrai
         //Code WinDev 5.5 remplacé par la migration :
         //saisie..etat = actif
         saisie..etat = actif; saisie..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         //numero..etat = grisé
         numero..etat = grisé; numero..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         //validation..etat = actif
         validation..etat = actif; validation..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         //fiche..etat = grisé
         fiche..etat = grisé; fiche..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         //table..etat = grisé
         table..etat = grisé; table..Visible=Vrai
         //htransactiondebut("tranport.trx")
         hrecherche(camions,IDCamions,table)
         fichierversecran
         reprisesaisie(NUMERO)
         
         
        type : 18
      -
        type : 161
        enabled : false
