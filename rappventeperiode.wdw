 message_bar :
  internal_properties : CQAAAAkAAABCskQXU3Qa+5z5sYebYS2H3HhwnQwcLRknNE7Ybu7uhkEyJXi9zYGnLtBw4Lly4vu1TDjRBUQ0g9g1fCUdAck4+GrFnRVcN19lBDujh+3Uf75rxZeMdpovCn0ehQ==
 actionbar : {}
 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1+
      
      
      
      // Pour compatibilité 5.5
      MoiMême..Visible=Vrai
      rapperiode est un tableau de 12 par 2 chaine
      lannee est une date = datesys()
      si gFormatFacture <> 2 alors
      	sel_rapType..visible = faux
      	sel_rapType = 1
      sinon
      	cselformat..visible = faux
      FIN
   -
     code : |1+
      
      csdannee = val(lannee..annee)
      ccmois = val(lannee..mois)
