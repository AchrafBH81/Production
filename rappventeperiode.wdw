  -
    name : BOUTON1
    identifier : 0x4616a4147836b0c3
    internal_properties : 
    properties :
     x : 634
     y : 173
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         //Code WinDev 5.5 remplacé par la migration :
         //numerovue est un entier long
         numerovue est un entier  
         choixrapport est une chaine
         choixsommaire est un booleen  
         k EST UN ENTIER = 1
         numeroderecord est un entier
         listeperiode est une chaine
         ListeVendeur est une chaine
         periodeencours est un entier
         tabhistoventeasso est un tableau associatif de histomois
         
         
         
         
         
         
         
         pour k = 1 a 12
         	
         	si ccmois+k <= 12 alors
         		rapperiode[k,1] = remplir_zero(NumériqueVersChaine(ccmois+k),2)
         		rapperiode[k,2] = numeriqueverschaine(csdannee-1)
         	sinon
         		rapperiode[k,1] = remplir_zero(NumériqueVersChaine(k+ccmois-12),2)
         		rapperiode[k,2] = NumériqueVersChaine(csdannee)
         	fin
         	listeperiode+=(rapperiode[k,2]+val(rapperiode[k,1])+";" )
         FIN
         
         
         
         
         si choixsecteur = "0" alors
         	choixrapport = "Tous"
         
         sinon
         	
         	choixrapport = ""	
         FIN
         
         SI ChoixVendeur = "0" ALORS
         	choixrapport = "Tous"
         	POUR TOUT Vendeur 
         		ListeVendeur+=SansEspace(Vendeur.IDVendeur)+";"
         	FIN
         SINON
         	ListeVendeur = choixvendeur
         	choixrapport = ""	
         FIN
         
         si somdet = 1 alors
         	choixsommaire = vrai
         sinon
         	choixsommaire = faux	
         FIN
         iconfigure(imprimanterapport,vrai)
         
         iParamètre("DEFAUT=NON")
         iParamètre("ORIENTATION=PAYSAGE")
         iParamètre("QUALITE=HAUTE")
         
         si destination = 2 alors
         	iapercu(2,"Rapport de vente")
         fin
         sablier(faux)
         selon gFormatFacture
         	cas 1
         		selon cselFormat
         			cas 1
         				iParamètre("FORMATPAPIER=LEGAL")
         				iimprimeetat(RAPPORTVENTEperiode,choixrapport,choixsommaire,rapperiode,choixsecteur,ccmois..ValeurAffichée,csdannee,selectsaut)
         			cas 2
         				iParamètre("FORMATPAPIER=LETTRE")
         				iimprimeetat(RAPPORTVENTEPeriode11pouce,choixrapport,choixsommaire,rapperiode,choixsecteur,ccmois..ValeurAffichée,csdannee,selectsaut)
         		FIN
         	cas 2
         		selon sel_rapType
         			cas 1
         				iParamètre("FORMATPAPIER=LETTRE")
         				iimprimeetat(RAPPORTVENTEperiodetrn11pouce,choixrapport,choixsommaire,rapperiode,choixsecteur,ccmois..ValeurAffichée,csdannee,selectsaut)
         			cas 2
         				RequeteHistoVendeur.pVendeur = ListeVendeur
         				RequeteHistoVendeur.pPeriode = listeperiode
         				HExécuteRequête(RequeteHistoVendeur)
         
         				pour TOUT RequeteHistoVendeur 
         					periodeencours = (val(RequeteHistoVendeur.lmois) - ccmois > 0 ? val(RequeteHistoVendeur.lmois) - ccmois sinon val(RequeteHistoVendeur.lmois) - ccmois + 12 )
         					
         					
         					si tabhistoventeasso[RequeteHistoVendeur.cvendeur+RequeteHistoVendeur.hClient] = null ALORS
         						histomoisstruct est un histomois dynamique
         						
         						histomoisstruct = allouer un histomois 
         						
         						
         						{"histomoisstruct.m"+periodeencours }= RequeteHistoVendeur.lvente
         
         						tabhistoventeasso[RequeteHistoVendeur.cvendeur+RequeteHistoVendeur.hClient]=histomoisstruct
         					 libérer histomoisstruct
         					 
         					 
         					 
         					sinon
         						
         						
         						
         						histomoisstruct1 est un histomois  = tabhistoventeasso[RequeteHistoVendeur.cvendeur+RequeteHistoVendeur.hClient]
         
         					    	
         						{"histomoisstruct1.m"+periodeencours }= RequeteHistoVendeur.lvente
         						tabhistoventeasso[RequeteHistoVendeur.cvendeur+RequeteHistoVendeur.hClient]=histomoisstruct1
         						
         					FIN
         					
         					
         					
         					
         				FIN
         
         				
         				iParamètre("FORMATPAPIER=LETTRE")
         								iImprimeEtat(RAPPORTVENTEPeriodeTRN11PouceVendeur,choixrapport,choixsommaire,rapperiode,CHOIXSECTEUR,ccmois..ValeurAffichée,csdannee,SELECTsaut,tabhistoventeasso)
         		fin		
         FIN
         
         
         hdesactivefiltre(client)
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BOUTON2
    identifier : 0x4616a414224bb0c3
    internal_properties : 
    properties :
     x : 1003
     y : 66
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         //Code WinDev 5.5 remplacé par la migration :
         //numerovue est un entier long
         numerovue est un entier  
         choixrapport est une chaine
         choixsommaire est un booleen  
         k EST UN ENTIER = 1
         numeroderecord est un entier
         sablier(vrai)
         memcree("zonefacture")
         
         HLITPREMIER("config","COCLEUNIK")
         
         
         conditiondeselection est une chaine = "fadate >= "+"'"+ventedebut+"' et fadate <= '"+ventefin+"'"
         hlitpremier("hfacture","HFCLEUNIK")
         //Code WinDev 5.5 remplacé par la migration :
         //tantque pas h.endehors
         tantque pas HEnDehors()
         	si hfacture.fadate >= ventedebut et hfacture.fadate <= ventefin alors
         		numeroderecord = h.numenr
         		si choixsecteur[choixsecteur] <> "0" alors
         			hlitrecherche("client","numero",hfacture.faclient)
         //Code WinDev 5.5 remplacé par la migration :
         //			si pas h.endehors et h.trouve alors
         			si pas HEnDehors() et HTrouve() alors
         				si client.secteur = choixsecteur[choixsecteur] alors
         					memajoute("zonefacture",numeroderecord,numeroderecord)
         				fin
         			FIN
         		sinon
         			
         			memajoute("zonefacture",h.numenr,h.numenr)
         		fin	
         	fin
         		hlitsuivant("hfacture","HFCLEUNIK")
         FIN
         //si choixsecteur[choixsecteur] <> "0" alors
         //  conditiondeselection += " et fasecteur = "+ choixsecteur[choixsecteur]	
         //FIN
         //numerovue = hcréevue("hFacture","fanofacture,fadate,faclient,fatotal,fasecteur","5",conditiondeselection)
         HLITPREMIER("hfacture","HFCLEUNIK")
         
         si choixsecteur[choixsecteur] = "0" alors
         	choixrapport = "Tous"
         sinon
         	choixrapport = ""	
         FIN
         si somdet = 1 alors
         	choixsommaire = vrai
         sinon
         	choixsommaire = faux	
         FIN
         iconfigure(imprimanterapport,vrai)
         iParamètre("DEFAUT=NON")
         iParamètre("ORIENTATION=PAYSAGE")
         iParamètre("FORMATPAPIER=LEGAL")
         
         //Fin du code généré par l'assistant de code de la fonction iParamètre
         si destination = 2 alors
         	iapercu(2,"Rapport de vente")
         fin
         //iimprimeetat("RAPPORT VENTE",numerovue,choixrapport,choixsommaire,ventedebut,ventefin)
         sablier(faux)
         
         iimprimeetat("RAPPORT VENTE","zonefacture",choixrapport,choixsommaire,ventedebut,ventefin)
         
        type : 18
      -
        type : 161
        enabled : false
