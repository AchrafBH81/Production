      -
        code : |1+
         sablier(vrai)
         lidfenetreSource est un entier
         lidfenetreCible est un entier
         HCréationSiInexistant(typecarrAlias)
         hsupprimetout(typecarrAlias)
         si hlitrecherche(typecarr,tcdescription,cstDescCarrelage) alors
         	acso_message("Erreur","Type de carrelage déjà existant","Erreur")
         	reprisesaisie(cstDescCarrelage)
         sinon
         	hlitrecherche(typecarr,TCCLEUNIK,Combo_carrelage)
         	HCopieEnreg(typecarrAlias,typecarr)
         	typecarrAlias.tcdescription = cstDescCarrelage
         	hajoute(typecarralias)
         	hlitpremier(typecarrAlias,tcdescription)
         	HCopieEnreg(typecarr,TypecarrAlias)
         	hajoute(typecarr)
             	
         FIN
         sablier(faux)
         
         ferme()
         
         
