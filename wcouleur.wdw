  -
    name : BTN_DETRUIRE
    identifier : 0x474c942c70d16418
    internal_properties : 
    properties :
     x : 175
     y : 6
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         
         // Suppression
         si TABLE..Nouveau alors
         	si TABLE..occurrence<2 alors
         		REPRISESAISIE("TABLE")
         	sinon
         		TableSupprime("TABLE")
         	fin
         sinon
         	si acso_message("Question","Voulez-vous supprimer l'enregistrement?","OuiNon")=idyes alors
         		TableSupprime("TABLE")
         		si HErreurIntegrite() alors
         			Erreur(HErreurInfo())	// "Erreur d'intégrité"
         			Retour
         		Fin
         	fin
         fin
         
         si TableOccurrence("TABLE")=0 alors
         	REPRISESAISIE("TABLE")
         SINON
         	// Le bouton Supprimer est en interruption
         	// Il faut forcer l'entrée dans la nouvelle ligne
         	ExecuteTraitement("TABLE",trtENTREELIGNE)
         fin
         
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_AJOUT
    identifier : 0x474c942c575c6418
    internal_properties : 
    properties :
     x : 61
     y : 6
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         // Ajoute
         //Code WinDev 5.5 remplacé par la migration :
         //Table..Etat=Actif
         Table..Etat=Actif; Table..Visible=Vrai
         TableAjoute("TABLE")
         TABLE..Etat										= Actif
         TABLE.CNUMERO[TableSelect(TABLE)]..Etat			= actif
         TABLE.DESCRIPTION[TableSelect(TABLE)]..Etat		= Actif
         TABLE.Descriptiona[TableSelect(TABLE)]..Etat		= Actif
         TABLE.cExtraCarreau[TableSelect(TABLE)]..Etat	= Actif
         TABLE.cextraLineaire[TableSelect(TABLE)]..Etat	= Actif
         TABLE.cExtraLineaireM[TableSelect(TABLE)]..Etat	= Actif
         TABLE.cExtraUnite[TableSelect(TABLE)]..Etat		= Actif
         TABLE.cExtraUnite[TableSelect(TABLE)]..Etat		= Actif
         table.COL_IsActive[TableSelect(TABLE)] = vrai
         RepriseSaisie("TABLE")
         
        type : 18
      -
        type : 161
        enabled : false
