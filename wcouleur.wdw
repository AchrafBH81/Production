    code_elements :
     type_code : 9
     p_codes :
      -
        code : |1+
         
         
         
        type : 14
      -
        code : |1+
         
         // Entrée dans une table
         si TABLE..vide alors TableAjoute("TABLE")
         
         
        type : 15
      -
        code : |1+
         
         
        type : 19
      -
        code : |1+
         
         // Mémorise la modification
         si TABLE..Modifie alors
         	si TABLE..Nouveau alors
         		TableEnregistre("TABLE")
         		si HErreurDoublon() alors
         			Acso_message("Erreur","L'enregistrement ne peut être ajouté au fichier.",...
         			"Un enregistrement contient déjà le même identifiant","Erreur")
         		fin
         		si HErreurIntegrite() alors
         			Acso_message("Erreur","Erreur d'intégrité","Erreur")
         			Retour
         		Fin
         	sinon
         		si pas sansespace(table.CNUMERO) = "" et pas  sansespace(table.DESCRIPTION) = "" alors
         			TableEnregistre("TABLE")
         		fin
         		si HErreurDoublon() alors
         			Acso_message("Erreur","L'enregistrement ne peut être ajouté au fichier.",...
         			"Un enregistrement contient déjà le même identifiant","Erreur")
         		fin
         		si HErreurIntegrite() alors
         			Acso_message("Erreur","Erreur d'intégrité","Erreur")
         			Retour
         		Fin
         	fin
         fin
         
         TABLE.cnumero[TableSelect(TABLE)]..Etat		= inActif
         TABLE.DESCRIPTION[TableSelect(TABLE)]..Etat		= inActif
         TABLE.DESCRIPTIONa[TableSelect(TABLE)]..Etat		= inActif
         TABLE.cExtraCarreau[TableSelect(TABLE)]..Etat	= inActif
         TABLE.cextraLineaire[TableSelect(TABLE)]..Etat	= inActif
         TABLE.cExtraLineaireM[TableSelect(TABLE)]..Etat	= inActif
         TABLE.cExtraUnite[TableSelect(TABLE)]..Etat		= inActif
         TABLE.cExtraUnite[TableSelect(TABLE)]..Etat		= inActif
        type : 20
      -
