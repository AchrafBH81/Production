     type : 458752
   -
     name : GetPane
     procedure_id : 1932629734544640728
     type_code : 12
     code : |1-
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] GetPane (<_item> est objet .NET, <_purchaseOrder> est PurchaseOrderBasco)
      //
      // Paramètres :
      //	_item (objet .NET) :<indiquez ici le rôle de _item>
      //	_purchaseOrder (PurchaseOrderBasco) :<indiquez ici le rôle de _purchaseOrder>
      // Valeur de retour :
      // 	Type indéterminé : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE GetPane(_item est un GlassPanItem,_purchaseOrder est un PurchaseOrderBasco)
      
      //SI _item.LowEtypeSupplierCode <> "" _ET_ :EstVerre(_item.LowEtypeSupplierCode) ALORS
      //	RENVOYER _item.LowEtypeSupplierCode
      //FIN
      //
      //si _item.TemperedSupplierCode <> "" _et_ :estverre(_item.TemperedSupplierCode) alors
      //	renvoyer _item.TemperedSupplierCode
      //FIN
      :EstVerre(_item.LowEtypeSupplierCode)
      si :istempered = faux _et_ _item.Tempered alors :istempered = vrai
      TxtReq est une chaine =  [
      
      select * from RelationEDI 
      where relationedi.idclient = '139' and 
      relationedi.ExtraCustomer = '%1' and 
      relationedi.IsTempered = %2  and 
      relationedi.isenergetic = %3 and
      TypeObjet = 1
      
      ]
      TxtReq = ChaîneConstruit(TxtReq,_item.name,_item.Tempered,_item.LowE)
      reqSql est une Source de Données
      _RelationThermos est un cRelationThermos = allouer un cRelationThermos()
      si hexecuterequetesql(reqSql,hRequêteDéfaut,TxtReq) alors
         si hnbenr(reqSql) > 0 alors
         	  hlit(reqSql,1)
         	  si reqSql.isexception alors 
         	  	:ExceptionForcee = Vrai
         	  	:ExceptionForceeTexte = reqSql.ExceptionTexte
         	  	renvoyer _item.name
         	  FIN
         	  renvoyer(reqSql.ExtraSupplier)
         sinon
         	_RelationThermos.ProduitBase = _item.Name
         	_RelationThermos.IsTempered = _item.Tempered
         	_RelationThermos.IsEnergetic = _item.LowE
         	ajoute(_purchaseOrder.RelationComposant,_RelationThermos)
         	renvoyer "Fail"
         fin
      sinon
      	_RelationThermos.ProduitBase = _item.Name
      	_RelationThermos.IsTempered = _item.Tempered
      	_RelationThermos.IsEnergetic = _item.LowE
      	Ajoute(_purchaseOrder.RelationComposant,_RelationThermos)
      	renvoyer "Fail"   		
      FIN
      
      
      //renvoyer _item.name
     type : 458752
   -
     name : EstVerre
     procedure_id : 1932644818542371568
     type_code : 12
     code : |1-
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //EstVerre (<NoProduit> est chaîne)
      //
      // Paramètres :
      //	NoProduit (chaîne ANSI) :<indiquez ici le rôle de NoProduit>
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE EstVerre(NoProduit est une chaine)
      
      si hlitrecherche(invent,INUM,NoProduit) alors
      	si invent.itype = 1 alors
      		//renvoyer vrai
      	sinon 
      		:PutInOption(NoProduit)
      	FIN
      FIN
      
      //renvoyer faux
     type : 458752
   -
     name : PutInOption
     procedure_id : 1932680179008160052
     type_code : 12
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] PutInOption (<NoProduit> est chaîne)
      //
      // Paramètres :
      //	NoProduit (chaîne ANSI) :<indiquez ici le rôle de NoProduit>
      // Valeur de retour :
      // 	booléen : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE PutInOption(NoProduit est une chaine)
      
      si :option1 <> NoProduit et :option2 <> NoProduit et :option3 <> NoProduit alors
      	si :option1 = "0" alors 
      		:option1 = NoProduit
      		renvoyer vrai
      	FIN
      	SI :Option2 = "0" ALORS 
      		:Option2 = NoProduit
      		RENVOYER Vrai
      	FIN
      	SI :Option3 = "0" ALORS 
      		:Option3 = NoProduit
      		RENVOYER Vrai
      	FIN
      	
      	
      FIN
      
      
     type : 458752
   -
     name : SortingThermos
     procedure_id : 2021488776768181742
     type_code : 12
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      // SortingThermos ()
      //
      // Paramètres :
      //	Aucun
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE SortingThermos()
      si :istempered ALORS
      	SI SansEspace(:Shape) <> "" ALORS
      		SELON Droite(SansEspace(:produitdebase),1)
      			CAS "3"
      				:SortingType = 16
      			CAS "4"
      				:SortingType = 17
      			CAS "5"
      				:SortingType = 18
      			CAS "6"
      				:SortingType = 19
      				
      			AUTRE CAS
      				:SortingType = 10
      		FIN
      	sinon	
      		SELON Droite(SansEspace(:ProduitDeBase),1)
      			CAS "3"
      				:SortingType = 11
      			CAS "4"
      				:SortingType = 12
      			CAS "5"
      				:SortingType = 13
      			CAS "6"
      				:SortingType = 14
      				
      			AUTRE CAS
      				:SortingType = 10
      		FIN
      	FIN
      SINON
      	SI SansEspace(:Shape) <> "" ALORS
      		SELON Droite(SansEspace(:ProduitDeBase),1)
      			CAS "3"
      				:SortingType = 6
      			CAS "4"
      				:SortingType = 7
      			CAS "5"
      				:SortingType = 8
      			CAS "6"
      				:SortingType = 9
      				
      			AUTRE CAS
      				:SortingType = 10
      		FIN
      	SINON	
      		SELON Droite(SansEspace(:ProduitDeBase),1)
      			CAS "3"
      				:SortingType = 1
      			CAS "4"
      				:SortingType = 2
      			CAS "5"
      				:SortingType = 3
      			CAS "6"
      				:SortingType = 4
      				
      			AUTRE CAS
      				:SortingType = 10
      		FIN
      	FIN	
      	
      FIN
      
      
      //
      //
      //si sansespace(:Shape) <> "" alors
      //	:sortingtype = 6
      //sinon si :istempered alors
      //	:SortingType = 5
      //sinon	
      //	selon droite(sansespace(:ProduitDeBase),1)
      //		cas "3"
      //			si :Grill = "" alors
      //				:SortingType = 1
      //			sinon	
      //				:SortingType = 1
      //			FIN
      //			
      //		CAS "4"
      //			SI :Grill = "" ALORS
      //				:SortingType = 2
      //			SINON	
      //				:SortingType = 2
      //			FIN
      //		CAS "5"
      //			SI :Grill = "" ALORS
      //				:SortingType = 3
      //			SINON	
      //				:SortingType = 3
      //			FIN
      //		CAS "6"
      //			SI :Grill = "" ALORS
      //				:SortingType = 4
      //			SINON	
      //				:SortingType = 4
      //			FIN
      //			
      //		AUTRE CAS
      //			
      //	FIN
      //fin
      
     type : 458752
   -
     name : TrouveExtraDemi
     internal_properties : CQAAAAkAAAAB4XFS53J8vFz8n2k2fN+nJe8r+BsPZ3cxwGNUePze5ZQbzduUT4EunP/yRyw6YT7ku7ZQRo2IIgV8ds5iJQ==
     procedure_id : 1186218965588892484
     type_code : 12
     code : |1-
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] TrouveExtraDemi (<noclient>)
      //
      // Paramètres :
      //	noclient : <indiquez ici le rôle de noclient>
      // Valeur de retour :
      // 	réel : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE TrouveExtraDemi(noclient)
      valeuraretourner est un reel = 0
      si hlitrecherche(ProduitClient,IdClientIdproruit,HConstruitValClé(ProduitClient,IdClientIdproruit,noclient,gNoExtraDemi)) _et_ PRODUITCLIENT.IPprixSpecial alors
      	valeuraretourner =  produitclient.IPrixa
      sinon si hlitrecherche(invent,inum,gNoExtraDemi) alors
      	si hlitrecherche(invent,INUM,gNoExtraDemi) alors
      		valeuraretourner = invent.iprixcarreau
      	fin
      	
      FIN
      
      renvoyer valeuraretourner
     type : 458752
