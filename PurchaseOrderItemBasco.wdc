      PROCEDURE GetGrillType()
      
      si :grill <> "" alors 
      	//	si hlitrecherche(RelationEDI,IdClientdescriptionEDIClient,["013",4,:Grill+" " +:GrillSeal]) alors
      	//		:GrillNumberInternal = RelationEDI.IDCarrelage
      	si hlitrecherche(invent,INUM,:Grill) alors
