 controls : []
 code_elements :
  type_code : 13
  p_codes :
   -
     code : |1+
      procedure EHistoSommaireParCateg(ldate est une chaine,lcateg est une chaine)
      
     type : 327680
   -
     code : |1+
      si lcateg <> "0" alors
      	si sansespace(tempoHisto.CategClient) <> sansespace(lcateg) alors renvoyer faux
      FIN
