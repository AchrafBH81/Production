    identifier : 0x461900dc7a691e51
    internal_properties : CQAAAAkAAACaVtLfwMIIB/v7RHcdIKRTKIHEl0TXXWfQDk2IuGOesnnIGahaWFlGhTW8jiQtkP0jG0kWpGGbyIvQKq/zg2qKeYAIepGvSXSIG0uPd6j6vipS9lcFy4HrFQkAZvG4sX9M5K15Z7dngRe8gSEN629LBAZ/MKOQZgO1wpAjshA2i1l5VIurYfGJJ7kWKJBImWFbxoH02qJzzIF1G79gkMXQExXucSRRHXHV3LJO+5M3gyCHAUrFfR+CaOtfG0gkCgOW29G+DW/xf3wfawkZng==
    properties :
     y : 106.543
     width : 335.6
     height : 1.515
    code_elements :
     type_code : 30
     p_codes :
      -
        code : |1+
         si RequeteventePeriodeProduit.lperiode >= ltableauperiode[1] et RequeteventePeriodeProduit.lperiode <= ltableauperiode[2] alors
         	TOTALPRODUIT+=RequeteventePeriodeProduit.lvente+RequeteventePeriodeProduit.peinturecarrelage
         	TOTALQTE+=RequeteventePeriodeProduit.lqte
         	surchargeper+=RequeteventePeriodeProduit.lsurcharge
         
         sinon
         	TOTALPRODUITprec+=RequeteventePeriodeProduit.lvente+RequeteventePeriodeProduit.peinturecarrelage
         	TOTALQTEprec+=RequeteventePeriodeProduit.lqte
         	surchargeperprec+=RequeteventePeriodeProduit.lsurcharge
         FIN
         
         
         
        type : 327692
