    code_elements :
     type_code : 30
     p_codes :
      -
        code : |1+
         j est un entier
         indicecarr est un entier
         carrtrouve est un booleen = faux
         carrnogl est une chaine
         si requetesoumission.ftype = 4 alors
         	corps..visible = faux
         sinon
         
         	si requetesoumission.ftype = 2 et pas requetesoumission.fdverreunite alors
         	    CORPS..VISIBLE = VRAI
         		rubrique17 = requetesoumission.fdprixu
         		rubrique16 = 1
         		si anciennumcommande <> requetesoumission.fdnocomm alors
         
         			si pas anciennumcommande = 0 alors
         				si dimensiontableaucarrelage <> 0 alors
         					pour j = 1 a dimensiontableaucarrelage
         						numprodcarr   = tableaucarrelage[j,1]
         						qtecarr24       = tableaucarrelage[j,2]
         						desccarr      = tableaucarrelage[j,3]
         						prixUnitCarr  = tableaucarrelage[j,4]
         						totalcarr = arrondi(val(qtecarr24) * val(prixunitcarr),2)
         						si hlitrecherche(invent,INUM,numprodcarr) alors
         							carrnogl = invent.ICODEGL
         						sinon
         
         							carrnogl = config.glventedefaut
         						fin	
         						Remplir_tableau_gl(carrnogl,totalcarr)
         						calculligne++
         						iimprimebloc(ITERATION1)
         						totalpage +=  totalcarr
         						totalfacture +=  totalcarr
         					fin
         					dimension(tableaucarrelage,0,5)
         					dimensiontableaucarrelage = 0
         				fin		
         				calculligne++
         				iimprimebloc(ITERATION2)
         			fin
         		fin
         		anciennumcommande = requetesoumission.fdnocomm
         		//		rubrique16..visible = faux
         	sinon	
         		corps..visible = vrai
         //		rubrique16..visible = vrai
         		si anciennumcommande <> requetesoumission.fdnocomm alors
         
         			si pas anciennumcommande = 0 alors
         				si dimensiontableaucarrelage <> 0 alors
         					pour j = 1 a dimensiontableaucarrelage
         						numprodcarr   = tableaucarrelage[j,1]
         						qtecarr24       = tableaucarrelage[j,2]
         						desccarr      = tableaucarrelage[j,3]
         						prixUnitCarr  = tableaucarrelage[j,4]
         						totalcarr = arrondi(val(qtecarr24) * val(prixunitcarr),2)
         						si hlitrecherche(invent,INUM,numprodcarr) alors
         							carrnogl = invent.ICODEGL
         						sinon
         							carrnogl = config.glventedefaut
         						fin	
         						Remplir_tableau_gl(carrnogl,totalcarr)
         						calculligne++
         						iimprimebloc(ITERATION1)
         						totalpage +=  totalcarr
         						totalfacture +=  totalcarr
         					fin
         					dimension(tableaucarrelage,0,5)
         					dimensiontableaucarrelage = 0
         				fin		
         				calculligne++
         				iimprimebloc(ITERATION2)
         			fin
         		fin
         		anciennumcommande = requetesoumission.fdnocomm
         	fin
         
         
         	si requetesoumission.fdcarrelage alors
         		pour j = 1 a dimensiontableaucarrelage
         			si tableaucarrelage[j,1] = requetesoumission.fdnumcarr et val(tableaucarrelage[j,4]) = requetesoumission.fdcarrpruxuc alors
         				indicecarr = j
         				carrtrouve = vrai
         			FIN
         		fin
         		si carrtrouve alors
         			tableaucarrelage[indicecarr,2]=numeriqueverschaine(val(tableaucarrelage[indicecarr,2])+(requetesoumission.fdqteafacturer...
         			* requetesoumission.fdcarreauh * requetesoumission.fdcarreauv))
         
         			//	tableaucarrelage[indicecarr,4]=numeriqueverschaine(val(tableaucarrelage[indicecarr,4])+(requetesoumission.fdqteafacturer * ...
         			//	requetesoumission.fdcarreauh * requetesoumission.fdcarreauv))
         			//	tableaucarrelage[indicecarr,5]=numeriqueverschaine(val(tableaucarrelage[indicecarr,5])+((requetesoumission.fdqte-requetesoumission.fdqteafacturer)*...
         			//	requetesoumission.fdcarreauh * requetesoumission.fdcarreauv))
         
         
         
         		sinon
         			dimensiontableaucarrelage++
         			dimension(tableaucarrelage,dimensiontableaucarrelage,5)
         			tableaucarrelage[dimensiontableaucarrelage,1] = requetesoumission.fdnumcarr
         			hlitrecherche(invent,INUM,requetesoumission.fdnumcarr)
         			si htrouve(invent) alors
         				tableaucarrelage[dimensiontableaucarrelage,3] = client.clangue = 1 ? invent.IDESC sinon invent.idesca
         			FIN
         			tableaucarrelage[dimensiontableaucarrelage,2]=numeriqueverschaine(requetesoumission.fdqteafacturer * ...	
         			requetesoumission.fdcarreauh * requetesoumission.fdcarreauv,"5.2f")
         
         			tableaucarrelage[dimensiontableaucarrelage,4]=numeriqueverschaine(requetesoumission.fdcarrpruxuc,"5.2f")
         
         
         			//tableaucarrelage[dimensiontableaucarrelage,5]=numeriqueverschaine((requetesoumission.fdqte-requetesoumission.fdqteafacturer) * ...
         			//requetesoumission.fdcarreauh * requetesoumission.fdcarreauv)
         
         
         
         		fin
         	fin
         	//	si pas facturereimpression alors
         	//		remplir_tableau(rubrique21,arrondi(rubrique4 * (rubrique16 * rubrique17),2))
         	//	FIN
         
         	//	totalpage +=  arrondi(requetesoumission.fdqteafacturer * requetesoumission.fdpiedcarrefacture * requetesoumission.fdprixupiedfacture,2)
         	//	totalfacture +=  arrondi(requetesoumission.fdqteafacturer * requetesoumission.fdpiedcarrefacture * requetesoumission.fdprixupiedfacture,2)
         	si requetesoumission.ftype = 2 et pas requetesoumission.fdverreunite alors
         		totalpage +=  arrondi(requetesoumission.fdqteafacturer * requetesoumission.fdprixu,2)
         
         		totalfacture +=  arrondi(requetesoumission.fdqteafacturer * requetesoumission.fdprixu,2)
         
         	sinon
         		totalpage +=  arrondi(requetesoumission.fdqteafacturer * ((requetesoumission.fdpiedcarrefacture * requetesoumission.fdprixupiedfacture) + ...
         		requetesoumission.fdextraforme),2)
         
         		totalfacture +=  arrondi(requetesoumission.fdqteafacturer * ((requetesoumission.fdpiedcarrefacture * requetesoumission.fdprixupiedfacture)+ ...
         		requetesoumission.fdextraforme),2)
         		totalsurcharge += arrondi(requetesoumission.surchargeenergie,2)
         		totalcap+= arrondi(requetesoumission.FDExtraCap) * requetesoumission.fdqteafacturer
         	fin
         	calculligne++
         fin
         
         
         
         
         
        type : 327692
      -
        code : |1+
         si requetesoumission.ftype <> 4 alors
         
         	si pas facturereimpression alors
         		si requetesoumission.ftype <> 4 alors
                   SI requetesoumission.FDExtraCap <> 0 ALORS
         	remplir_tableau(rubrique21,arrondi(rubrique18,2) - (arrondi(requetesoumission.FDExtraCap) * requetesoumission.fdqteafacturer))
         	remplir_tableau(CONFIG.CapGL,arrondi(requetesoumission.FDExtraCap) * requetesoumission.fdqteafacturer)
         SINON
         			remplir_tableau(rubrique21,arrondi(rubrique18,2))
                   FIN
         		fin
         	FIN
         	
         
         	si pas sansespace(requetesoumission.fnotes) = "" ou requetesoumission.fdextraforme <> 0 ALORS
         
         		calculligne++
         		iImprimeBloc(ITERATION3)	
         		//  totalpage +=  totalextraforme
         		//  totalfacture +=  totalextraforme
         	FIN
         fin
        type : 327693
      -
        type : 327697
        enabled : false
