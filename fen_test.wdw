    name : BTN_SansNom19
    identifier : 0x26d32f9110a0fcf4
    internal_properties : 
    properties :
     x : 910
     y : 327
     width : 242
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         avecenergiverre	est un booleen	= Faux
         avectrempe		est un booleen	= Faux
         sdReqSql		est une source de donnees
         
         pour CHAQUE Facture 
         	avecenergiverre		= Faux
         	avectrempe		    = Faux
         	message(facture.fanumero)
         	MultitâcheRepeint()
         	si HExécuteRequêteSQL(sdReqSql,hRequêteDéfaut,"select * from fdetail where fdetail.fdnocomm =" + facture.fanumero + " AND fdetail.ftype = 1") alors
         		pour CHAQUE sdReqSql 
         			POUR i = 1 À 3
         				SI HLitRecherche(invent,INUM,{"sdreqsql.fdcomposant"+i,indRubrique}) ALORS
         					SI PAS avecenergiverre ALORS avecenergiverre = invent.ienergieverre
         					SI PAS avectrempe ALORS avectrempe = invent.IsTempered
         					
         				FIN
         			FIN
         		FIN
         		
         		facture.AvecEnergiverre	= avecenergiverre
         		facture.Avectrempe		= avectrempe
         		hmodifie(Facture,hNumEnrEnCours)
         		
         	FIN
         FIN
         
         
        type : 18
      -
        type : 161
        enabled : false
