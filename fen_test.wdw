    name : BTN_SansNom4
    identifier : 0x21d5f7ae4d161dcb
    internal_properties : 
    properties :
     x : 29
     y : 651
     width : 198
     height : 56
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         RequeteThermosFabricationClient.pListeDePrix = 1
         RequeteThermosFabricationClient.pSpecial = 1
         HExécuteRequête(RequeteThermosFabrication,hModifieFichier)
         POUR TOUT RequeteThermosFabrication
         	RequeteThermosFabrication.enprixa = Arrondi(RequeteThermosFabrication.enprixa  * (1 + ( 8 /100)),2)
         	RequeteThermosFabrication.enprixm = Arrondi(RequeteThermosFabrication.enprixa * 10.7643,2)	
         	HModifie(RequeteThermosFabrication,hNumEnrEnCours)
         FIN
         
         HExécuteRequête(RequeteThermosFabricationClient)
         
         
         POUR TOUT RequeteThermosFabricationClient
         	Message(RequeteThermosFabricationClient.IdClient)
         	MultitâcheRepeint()
         	RequeteThermosFabricationClient.Tprixa = Arrondi(RequeteThermosFabricationClient.Tprixa * (1 + ( 8 /100)),2)
         	RequeteThermosFabricationClient.Tprixm = Arrondi(RequeteThermosFabricationClient.Tprixa * 10.7643,2)
         	//RequeteThermosFabricationClient.pspecial = vrai	
         	SI HLitRecherche(ThermosClient,IdClientIdhermos,HConstruitValClé(ThermosClient,IdClientIdhermos,Complète(RequeteThermosFabricationClient.IdClient,10),Complète(RequeteThermosFabricationClient.IdThermos,20))) ALORS
         		ThermosClient.Tprixa = RequeteThermosFabricationClient.Tprixa
         		ThermosClient.Tprixm = RequeteThermosFabricationClient.Tprixm
         		//ThermosClient.prixSpecial = Vrai
         		HModifie(ThermosClient,hNumEnrEnCours)
         		
         	FIN
         fin
        type : 18
      -
        type : 161
        enabled : false
