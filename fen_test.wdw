    name : BTN_Testboucle
    identifier : 0x23fea3f92ca2f903
    internal_properties : 
    properties :
     x : 655
     y : 563
     width : 80
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         trace(timesys())
         POUR TOUT Fdetail
         	SI PAS HLitRecherche(Facture,fanumero,Fdetail.fdnocomm) ALORS
