    name : BTN_SansNom11
    identifier : 0x24125e9f600064db
    internal_properties : 
    properties :
     x : 695
     y : 667
     width : 170
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         //
         nPosdebut est un entier
         nPosFin est un entier
         
         hchangerep(BonLivraison,".\hfactureX")
         hlitrecherche(BonLivraison,IDBonLivraison,484506)
         sJBonlivraison est une chaine
         sjbonlivraison = HEnregistrementVersJSON(BonLivraison)
         nPosdebut = Position(sJBonlivraison,"{",2)
         nPosfin = taille(sJBonlivraison)-1
         
         sJBonlivraison = milieu(sJBonlivraison,nPosdebut,nposfin-nposdebut)
         
         
         hchangerep(BonLivraison,"")
         //hraz(BonLivraison)
         //fSauveBuffer("c:\temp\bonlivraison.json",sjbonlivraison)
         HJSONVersEnregistrement(BonLivraison,sjbonlivraison)
         hajoute(BonLivraison)
         
         
         HChangeRep(hfacture,".\hfactureX")
         HLitRecherche(hfacture,HFCLEUNIK,484636)
         sJBonlivraison	= HEnregistrementVersJSON(hfacture)
         nPosdebut		= Position(sJBonlivraison,"{",2)
         nPosFin			= Taille(sJBonlivraison)-1
         
         sJBonlivraison	= Milieu(sJBonlivraison,nPosdebut,nPosFin-nPosdebut)
         
         
         HChangeRep(hfacture,"")
         //hraz(BonLivraison)
         //fSauveBuffer("c:\temp\bonlivraison.json",sjbonlivraison)
         HJSONVersEnregistrement(hfacture,sJBonlivraison)
         HAjoute(hfacture)
         nCurrentHfactureID est un entier sur 8 octets = hfacture.HFCLEUNIK
         hferme(hfacture)
         
         
         
         
         HChangeRep(hfdetail,".\hfactureX")
         HLitRecherche(hfdetail,H0CLEUNIK,1193527)
         sJBonlivraison	= HEnregistrementVersJSON(hfdetail)
         nPosdebut		= Position(sJBonlivraison,"{",2)
         nPosFin			= Taille(sJBonlivraison)-1
         
         sJBonlivraison	= Milieu(sJBonlivraison,nPosdebut,nPosFin-nPosdebut)
         
         
         HChangeRep(hfdetail,"")
         //hraz(BonLivraison)
         //fSauveBuffer("c:\temp\bonlivraison.json",sjbonlivraison)
         HJSONVersEnregistrement(hfdetail,sJBonlivraison)
         hfdetail.HFCLEUNIK = nCurrentHfactureID
         HAjoute(hfdetail,hIgnoreIntégrité)
         
        type : 18
      -
        type : 161
        enabled : false
