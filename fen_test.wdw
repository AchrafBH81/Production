     height : 51
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         nID est un entier = fouvre("PrixDeBase.txt")
         ChaineLUe est une chaîne= flitligne(nID)
         gcnxConnexionHFExternal.Serveur					="192.168.20.14" + ":" + 4900
         gcnxConnexionHFExternal..Utilisateur			= "admin"
         gcnxConnexionHFExternal..MotDePasse				= ""
         gcnxConnexionHFExternal..BaseDeDonnées			= "Thermosrn"
         gcnxConnexionHFExternal..Cryptage				= hCryptageNon
         gcnxConnexionHFExternal..Provider				= hAccèsHFClientServeur
         hchangeconnexion(invent,gcnxConnexionHFExternal)
         tantque ChaineLUe <> EOT
         	trace(ChaineLUe)
             si hlitrecherche(invent,INUM,ExtraitChaîne(ChaineLUe,1,";")) alors
          //      si invent.iprixa = 0 ALORS
                   invent.iprixa = val(extraitchaine(ChaineLUe,2,";"))
                   invent.iprixM = val(extraitchaine(ChaineLUe,3,";"))
                   hmodifie(invent,hnumenrencours)
          //      FIN
                
             fin
                 	
         	ChaineLUe = flitligne(nID)
         FIN
         
        type : 18
      -
        type : 161
        enabled : false
