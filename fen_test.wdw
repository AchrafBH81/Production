  -
    name : BTN_SansNom7
    identifier : 0x231362b70ba384f2
    internal_properties : 
    properties :
     x : 597
     y : 683
     width : 168
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         Pour TOUT Client 
         	pour i =1 a 4
         		si contient(client.ccourrielFacture[i],"jean@thermosrn.ca") alors
         			Client.ccourrielFacture[i] = "melissa@thermosrn.ca"
         //			info("Facture")
         		FIN
         	fin	
         	pour i =1 a 4
         		si contient(client.ccourrielBonLivraison[i],"jean@thermosrn.ca") alors
         			Client.ccourrielBonLivraison[i] = "melissa@thermosrn.ca"
         //			Info("livraison")
         		FIN
         	fin	
         	pour i =1 a 4
         		si contient(client.ccourrielConfirmation[i],"jean@thermosrn.ca") alors
         			Client.ccourrielConfirmation[i] = "melissa@thermosrn.ca"
         //			Info("confirmation")
         		FIN
         	fin	
         	pour i =1 a 4
         		si contient(client.CourrielListePrix[i],"jean@thermosrn.ca") alors
         			Client.CourrielListePrix[i] = "melissa@thermosrn.ca"
         //			Info("liste")
         		FIN
         	fin	
         	hmodifie(Client,hNumEnrEnCours)
         FIN
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_SansNom8
    identifier : 0x23161a98d630d223
    internal_properties : 
    properties :
     x : 910
     y : 6
     width : 80
     height : 47
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         rExtraArgonPrice est une reel = GetArgonExtraPrice("139")
         
         
         
         
         sTxtsql est une chaine = [
         	select distinct facture.fanumero,fdetail.fdpiedcarrefacture,fdetail.fdnumprod ,facture.FPREPARATION ,fdetail.fdligne from facture 
         	inner join fdetail on fdetail.fdnocomm = facture.fanumero
         	where facture.faclient = '139' and facture.fatypedocument = 1 and fdetail.ftype = 1 and (fnotes like '%ARGON%' OR fnotes1 like '%ARGON%') 
         	and (facture.fanumero IN(select distinct facture.fanumero,fdetail.fdqte ,facture.FPREPARATION from facture 
         	inner join fdetail on fdetail.fdnocomm = facture.fanumero
         	where facture.faclient = '139' and facture.fatypedocument = 1 and fdetail.fdnumprod = 'EXTRA7'))
         ]
         
         sdReqsql est un source de donnees
         
         si HExécuteRequêteSQL(sdReqsql,hRequêteDéfaut,sTxtsql) alors
         	pour tout sdReqsql
         		si hlitrecherche(Fdetail,fdnocommfdligne,[sdReqsql.fanumero,sdReqsql.fdligne]) alors
         			fdetail.CalculArgon = Vrai
         			fdetail.PietageArgon = sdReqsql.fdpiedcarrefacture
         			fdetail.ExtraArgonPrice = rExtraArgonPrice
         			hmodifie(Fdetail,hNumEnrEnCours)
         		FIN
         		SI HLitRecherche(hFdetail,fdnocommfdligne1,[sdReqsql.fanumero,sdReqsql.fdligne]) ALORS
         			hFdetail.CalculArgon = Vrai
         			hFdetail.PietageArgon = sdReqsql.fdpiedcarrefacture
         			hFdetail.ExtraArgonPrice = rExtraArgonPrice
         			HModifie(hFdetail,hNumEnrEnCours)
         		FIN
         	fin
         FIN
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_SansNom9
    identifier : 0x233ee6a04fce964c
    internal_properties : 
    properties :
     x : 910
     y : 76
     width : 80
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         pour chaque "fdetail"
         
         	si sansespace(fdetail.fdcomposant1) <> ""
         		si hlitrecherche("invent","INUM",fdetail.fdcomposant1) alors
         			
         			si invent.ienergieverre alors
         				fdetail.fcapgaztube=sansespace(fdetail.fcapgaztube)+"Z" 
         				hmodifie(Fdetail,hnumenrencours)
         		        continuer
         			FIN
         		FIN
         	fin
         	si sansespace(fdetail.fdcomposant2) <> ""
         		si hlitrecherche("invent","INUM",fdetail.fdcomposant2) alors
         			
         			si invent.ienergieverre alors
         				fdetail.fcapgaztube=sansespace(fdetail.fcapgaztube)+"Z" 
         				hmodifie(Fdetail,hnumenrencours)
         		        continuer
         			FIN
         		FIN
         	fin
         	si sansespace(fdetail.fdcomposant3) <> ""
         		si hlitrecherche("invent","INUM",fdetail.fdcomposant3) alors
         			
         			si invent.ienergieverre alors
         				fdetail.fcapgaztube=sansespace(fdetail.fcapgaztube)+"Z" 
         				hmodifie(Fdetail,hnumenrencours)
         		        continuer
         			FIN
         		FIN
         	fin
         FIN
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_SansNom10
    identifier : 0x23508d090cd7ba45
    internal_properties : 
    properties :
     x : 900
     y : 128
     width : 80
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         si hlitrecherche(hfdetail,fdnocomm,"553406") alors
         	oCalculator est un Calculator
         	
         	calculateLargeur est un reel = Arrondi(oCalculator.Compute(FractionToArithmetic(hfdetail.fdlargeuranglais)),3)
         	CalculateHauteur est un reel = Arrondi(oCalculator.Compute(FractionToArithmetic(hfdetail.fdhauteuranglais)),3)
         	
         	Info(calculateLargeur + CalculateHauteur )
         	info(FractionToArithmetic(hfdetail.fdlargeuranglais)+"+"+FractionToArithmetic(hfdetail.fdhauteuranglais))
         	info(oCalculator.compute(FractionToArithmetic(hfdetail.fdlargeuranglais)+"+"+FractionToArithmetic(hfdetail.fdhauteuranglais)) * hfdetail.fdqteafacturer)
         		
         	
         	
         
         FIN
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_Produi_de_base
    identifier : 0x235339f6ef716ba7
    internal_properties : 
    properties :
     x : 804
     y : 404
     width : 80
     height : 82
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         nEpaisseurtempo est une entier
         sNumProd est une chaine
         sComp1 est une chaîne
         sComp2 est une chaîne
         sComp3 est une chaîne
         sPBase est une chaîne
         
         POUR TOUT hfdetail
         	SI hfdetail.ftype = 1 alors
         		sNumProd = hfdetail.fdnumprod
         		sComp1 = hfdetail.fdcomposant1
         		sComp2 = hfdetail.fdcomposant2
         		sComp3 = hfdetail.fdcomposant3
         		SI SansEspace(sNumProd)  <> "" ET HLitRecherche(persoens,ennumero,sNumProd) ALORS
         			nEpaisseurtempo =  Droite(SansEspace(persoens.epbase),1)
         			sPBase = persoens.epbase
         			
         		SINON SI HLitRecherche(persoens,clecomposant,HConstruitValClé(persoens,clecomposant,sComp1,sComp2,sComp3)) ALORS
         			nEpaisseurtempo =  Droite(SansEspace(persoens.epbase),1)
         			sPBase = persoens.epbase
         		SINON
         			nEpaisseurtempo  = Max(Droite(SansEspace(sComp1),1),Droite(SansEspace(sComp2),1),Droite(SansEspace(sComp3),1))
         			sPBase = "CL0"+nEpaisseurtempo
         		FIN
         		hfdetail.fdbase = sPBase
         		hmodifie(hfdetail,hnumenrencours)
         	fin
         	message(hfdetail.fdnocomm)
         	multitacherepeint()
         FIN
         
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_SansNom12
    identifier : 0x23534db2f9388340
    internal_properties : 
    properties :
     x : 890
     y : 306
     width : 80
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         
         
         
         
         
         tabThermos56 est une tableau de stThermos56
         
         
         stCurrentThermos est un stthermos56
         
         sdReqsql est une source de donnees
         sTxtsql est une chaine = [
         	
         	SELECT distinct
         	hfacture.facalcul AS facalcul,	
         	hfdetail.fdbase AS base,	
         	Client.nom AS name,
         	hfacture.faclient as num,	
         	hfdetail.fdnocomm AS fdnocomm	
         	FROM 
         	(
         	(
         	hfdetail
         	INNER JOIN
         	hfacture
         	ON hfacture.fanumero = hfdetail.fdnocomm
         	)
         	INNER JOIN
         	Client
         	ON hfacture.faclient = Client.numero
         	)
         	full outer JOIN
         	BonLivraison
         	ON BonLivraison.Bnumero = hfacture.fanofacture
         	WHERE 
         	(
         	BonLivraison.BDateFacture BETWEEN '%1' AND '%2'
         	AND	BonLivraison.Bfacture <> 0
         	AND	RIGHT(TRIM(hfdetail.fdbase ) ,1)  IN ('5', '6') 
         	
         	)
         	
         	order by faclient,fdnocomm
         ]
         
         sdReqSqlDetail est une source de donnees
         sTxtreqDetail est une chaine = [
         	select hfdetail.fdhauteur,hfdetail.fdlargeur,hfdetail.fdqteafacturer from hfdetail where hfdetail.fdnocomm = '%1' and hfdetail.ftype = 1
         ]
         //sdReqsql.pdebut = "20220101"
         //sdReqsql.pfin = "20221031"
         
         sNumClient est une chaine
         nCpt est un entier
         nCptCommande est un entier
         
         nRes est un entier
         si HExécuteRequêteSQL(sdReqsql,hRequêteDéfaut,ChaîneConstruit(sTxtsql,"20220101","20221031")) alors
         
         	pour TOUT sdReqsql 
         //		message(sdReqsql.fdnocomm)
         //		multitacherepeint()
         		nCptCommande++
         		Jauge(nCptCommande/HNbEnr(sdReqsql)*100,100)
         		sNumClient = sdReqsql.num
         		nRes = TableauCherche(tabThermos56,tcLinéaire,"numclient",sNumClient)
         		si  nRes = -1 alors
         			stCurrentThermos = allouer un stThermos56()
         			stCurrentThermos.numClienttri = Val(sNumClient)
         			stCurrentThermos.numClient = sNumClient
         			stCurrentThermos.sNomClient = sdReqsql.name
         			SI HExécuteRequêteSQL(sdReqSqlDetail,hRequêteDéfaut,ChaîneConstruit(sTxtreqDetail,sdReqsql.fdnocomm)) ALORS
         				
         				//			FIN
         				
         				//			si hlitrecherche(hfdetail,fdnocomm,sdReqsql.fdnocomm) alors
         				pour TOUT sdReqSqlDetail 
         					
         					SELON Droite(SansEspace(sdReqsql.base),1)
         						CAS "5"
         							stCurrentThermos.Qte5 += sdReqSqlDetail.fdqteafacturer
         							stCurrentThermos.Pi25 += val(sdReqSqlDetail.fdlargeur) * val(sdReqSqlDetail.fdhauteur) / (sdReqsql.facalcul = 2 ? 0.0929 sinon 144) * sdReqSqlDetail.fdqteafacturer
         						CAS "6"
         							stCurrentThermos.qte6 += sdReqSqlDetail.fdqteafacturer
         							stCurrentThermos.Pi26 += Val(sdReqSqlDetail.fdlargeur) * Val(sdReqSqlDetail.fdhauteur) / (sdReqsql.facalcul = 2 ? 0.0929 SINON 144) * sdReqSqlDetail.fdqteafacturer
         							
         						AUTRE CAS
         							
         					FIN
         					stCurrentThermos.nQtetotal+=sdReqSqlDetail.fdqteafacturer
         					stCurrentThermos.nPi2Total+=Val(sdReqSqlDetail.fdlargeur) * Val(sdReqSqlDetail.fdhauteur) / (sdReqsql.facalcul = 2 ? 0.0929 SINON 144) * sdReqSqlDetail.fdqteafacturer
         					nCpt++
         				fin
         				tabThermos56.Ajoute(stCurrentThermos)
         			fin
         			
         		sinon	
         			SI HExécuteRequêteSQL(sdReqSqlDetail,hRequêteDéfaut,ChaîneConstruit(sTxtreqDetail,sdReqsql.fdnocomm)) ALORS
         				POUR TOUT sdReqSqlDetail 
         					
         					SELON Droite(SansEspace(sdReqsql.base),1)
         						CAS "5"
         							tabThermos56[nRes].Qte5 += sdReqSqlDetail.fdqteafacturer
         							tabThermos56[nRes].pi25 += Val(sdReqSqlDetail.fdlargeur) * Val(sdReqSqlDetail.fdhauteur) / (sdReqsql.facalcul = 2 ? 0.0929 SINON 144) * sdReqSqlDetail.fdqteafacturer
         						CAS "6"         
         							tabThermos56[nRes].Qte6 += sdReqSqlDetail.fdqteafacturer
         							tabThermos56[nRes].pi26 += Val(sdReqSqlDetail.fdlargeur) * Val(sdReqSqlDetail.fdhauteur) / (sdReqsql.facalcul = 2 ? 0.0929 SINON 144) * sdReqSqlDetail.fdqteafacturer
         							
         						AUTRE CAS
         							
         					FIN
         					tabThermos56[nRes].nQtetotal+=sdReqSqlDetail.fdqteafacturer
         					tabThermos56[nRes].nPi2Total+=Val(sdReqSqlDetail.fdlargeur) * Val(sdReqSqlDetail.fdhauteur) / (sdReqsql.facalcul = 2 ? 0.0929 SINON 144) * sdReqSqlDetail.fdqteafacturer
         					
         					nCpt++
         				fin
         				
         			fin
         		fin
         	FIN
         
         
         	
         sinon
         	info(herreurinfo())
         FIN
         
         tableautrie(tabThermos56,ttMembre,"numclienttri")
         iapercu(100)
         
         iimprimeetat(ETAT_Ventes56,tabThermos56)
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_SansNom13
