   -
     name : TransfertPo
     procedure_id : 1913790286226841856
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //TransfertPo (<_Purchaseorder>, <_po>)
      //
      // Paramètres :
      // 	_Purchaseorder : <indiquez ici le rôle de _Purchaseorder>
      // 	_po : <indiquez ici le rôle de _po>
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE TransfertPo(_Purchaseorder,_po)
      
      _Purchaseorder.PurchaseOrderId   = _po.PurchaseOrderId
      _Purchaseorder.EdiKey            = _po.EdiKey
      _Purchaseorder.Display           = _po.Display
      _Purchaseorder.BascoFranchise    = _po.BascoFranchise
      _Purchaseorder.Customer          = _po.Customer
      _Purchaseorder.OrderNumber       = _po.OrderNumber
      _Purchaseorder.InvoiceNumber     = _po.InvoiceNumber
      _Purchaseorder.DateSent          = _po.DateSent
      _Purchaseorder.ShippingStreet    = _po.ShippingStreet
      _Purchaseorder.ShippingCity      = _po.ShippingCity
      _Purchaseorder.ShippingPostalCode= _po.ShippingPostalCode
      _Purchaseorder.ShippingState     = _po.ShippingState
      _Purchaseorder.ShippingCountry   = _po.ShippingCountry
      _Purchaseorder.BillingStreet     = _po.BillingStreet
      _Purchaseorder.BillingCity       = _po.BillingCity
      _Purchaseorder.BillingPostalCode = _po.BillingPostalCode
      _Purchaseorder.BillingState      = _po.BillingState
      _Purchaseorder.BillingCountry    = _po.BillingCountry
      
      _purchaseorderitem est un PurchaseOrderItemBasco
      pour chaque _item de _po.PurchaseOrderItems
      	_purchaseorderitem = allouer une PurchaseOrderItemBasco
      
      	_purchaseorderitem.PurchaseOrderId = _item.PurchaseOrderId
      	_purchaseorderitem.PurchaseOrderItemId = _item.PurchaseOrderItemId
      	_purchaseorderitem.VisibleIndex = _item.VisibleIndex
      //	_purchaseorderitem.TrnNumber = _item.TrnNumber
      	_purchaseorderitem.Note = _item.Note
      	_purchaseorderitem.Spacer = _item.Spacer
      	_purchaseorderitem.Finish = _item.Finish
      	_purchaseorderitem.Energetic = _item.Energetic
      	_purchaseorderitem.Pane1 = _item.Pane1
      	_purchaseorderitem.Pane2 = _item.Pane2
      	_purchaseorderitem.Pane3 = _item.Pane3
      	_purchaseorderitem.Grill = _item.Grill
      	_purchaseorderitem.Tempered = _item.Tempered
      	_purchaseorderitem.Quantity = _item.Quantity
      	_purchaseorderitem.GrillBase = _item.GrillBase
      	_purchaseorderitem.GrillHeight = _item.GrillHeight
      	_purchaseorderitem.Height =  _item.Height
      	_purchaseorderitem.Width = _item.Width
          _purchaseorderitem.Shape = _item.Shape
      	
      	
      	
      	
      	
      	
      	ajoute(_Purchaseorder.purchaseorderitems,_purchaseorderitem)
      	
      FIN
      
     type : 458752
   -
     name : AfficherJourLivraisonPourUnMois
     procedure_id : 2088073375451459092
     type_code : 14
     code : |1+
      PROCEDURE AfficherJourLivraisonPourUnMois()
      
      
      
      
      
      //datedernierelivraison est une date = "20190924"
      //NoSemainederniereLivraison est un entier = NuméroDeSemaine("20190924")
      //
      //NoReference est un entier = modulo(NoSemainederniereLivraison,saiFrequence)
      
      Frequence est un entier = saiFrequence
      GetJoursLivraisonClient(19)
      
      UneDate est une date = CalendrierPosition(CalendrierLivraison)
      //UneDate..Jour = 31
      UneDate = DernierJourDuMois(UneDate)
      LeNombreDeJour est un entier = UneDate..jour
      IdEnCours est un entier = 0
      NoSemaine est un entier = 0
      UneDate..Jour = 1
      NoRefLocal est un entier = noreference
      POUR i = 1 A LeNombreDeJour
      	
      	
      	UneDate..Jour = i
      	IdEnCours = GetidSaison(UneDate,gtabSaison)
      	si EstJourFerie(UneDate) alors
      		CalendrierLivraison[UneDate]..CouleurFond = iRougeClair
      		CalendrierLivraison[UneDate]..Couleur = iblanc
      		continuer
      	fin	
      	si Frequence > 1 alors
      		NoSemaine = NuméroDeSemaine(UneDate,iso8601)
      		si modulo(DateDifférence(PremierJourDeLaSemaine(DateReference),PremierJourDeLaSemaine(unedate)),frequence*7) <> 0
      
      //		si modulo(NoSemaine,Frequence) <> NoRefLocal alors
      			CalendrierLivraison[UneDate]..CouleurFond = iTransparent
      			CONTINUER
      			
      		fin
      	fin
      	
      	
      	si IdEnCours <> 0 alors
      		SI gJoursLivraisonClient[GtabSaison[IdEnCours].IdSaison][DateVersJour(UneDate)] = 1 ALORS
      			CalendrierLivraison[UneDate]..CouleurFond = VertClair
      		SINON SI gJoursLivraisonClient[GtabSaison[IdEnCours].IdSaison][DateVersJour(UneDate)] = 0
      			CalendrierLivraison[UneDate]..CouleurFond = iTransparent
      		SINON
      			CalendrierLivraison[UneDate]..CouleurFond = iGrisClair
      			
      		FIN
      	sinon
      		CalendrierLivraison[UneDate]..CouleurFond = iTransparent
      		
      	fin
      	
      	
      	
      FIN
      
     type : 458752
   -
     name : GetJoursLivraison
     procedure_id : 2088077889543223102
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] GetJoursLivraison (<IdSaison>, <IdClient>)
      //
      // Paramètres :
      //	IdSaison : <indiquez ici le rôle de IdSaison>
      //	IdClient : <indiquez ici le rôle de IdClient>
      // Valeur de retour :
      // 	tableau : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE GetJoursLivraison(IdSaison,IdClient)
      
      ValeurJourLivraisonClient  = 0
      valeurjourlivraison   = 0
      lJoursLivraison est un tableau de 7 entier
      SI HLitRecherche(SaisonLivraison,IDSaisonLivraison,IdSaison) ALORS
      	valeurjourlivraison = SaisonLivraison.JoursLivraison
      FIN
      SI HLitRecherche(JourLivraisonClient,IDClientIDSaisonLivraison,[IdClient,IdSaison]) ALORS
      	ValeurJourLivraisonClient = JourLivraisonClient.JourLivraison
      FIN
      POUR i = 1 À 7
      	lJoursLivraison[i] = 0
      FIN
      
      
      i est entier
      si valeurjourlivraison <> 0 alors
      	POUR i = 1 À 7
      		SI valeurjourlivraison & Puissance(2,i-1) = 0 ALORS
      			lJoursLivraison[i]  = 2
      		SINON	
      			lJoursLivraison[i] = 0
      		FIN
      	FIN
      fin
      
      //renvoyer lJoursLivraison
      
      
      
      
      
      
      //si hlitrecherche(JourLivraisonClient,IDClientIDSaisonLivraison,[client.idclient,gPeriodeLivraison]) alors
      //jliv = JourLivraisonClient.JourLivraison
      SI ValeurJourLivraisonClient <> 0 ALORS
      	POUR i = 1 À 7
      		SI ValeurJourLivraisonClient & Puissance(2,i-1) > 0 ALORS
      			lJoursLivraison[i] = lJoursLivraison[i] <> 2 ? 1 SINON 2
      		SINON
      			lJoursLivraison[i] = lJoursLivraison[i] <> 2 ? 0 SINON 2
      		FIN
      	FIN
      	
      fin
      renvoyer lJoursLivraison
     type : 458752
   -
     name : GetSaison
     procedure_id : 2088080213120678444
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] GetSaison (<UneDate> est date, <tabsaison> est tableau)
      //
      // Paramètres :
      //	UneDate (date) : <indiquez ici le rôle de UneDate>
      //	tabsaison (tableau) : <indiquez ici le rôle de tabsaison>
      // Valeur de retour :
      // 	entier : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE GetSaison(UneDate est une date,tabsaison est un tableau de 2 stLivraison)
      
      Res est un entier 
      
      pour i = 1 a 2
      	si tabsaison[i].ddatedebut <= UneDate <= tabsaison[i].ddatefin alors
      		 renvoyer i
      		 
      		 
      	FIN
      FIN
      
      
      
     type : 458752
   -
     name : ValideSaison
     procedure_id : 2088105454651451422
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //ValideSaison (<tabSaison> est tableau)
      //
      // Paramètres :
      //	tabSaison (tableau) : <indiquez ici le rôle de tabSaison>
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE ValideSaison(tabSaison est un tableau de stLivraison)
      dateOK est un booleen
      pour tout _saison de tabSaison
      	pour tout _saison1 de tabSaison 
      		dateOK = vrai
      		si _saison1.idsaison <> _saison.IdSaison et _saison1.ddatedebut > _saison.ddatefin alors
      			si datedifférence(_saison.ddatefin,_saison1.ddatedebut) = 1 alors
      				
      				sortir
      			sinon
      				dateOK = faux
      			FIN
      		FIN
      		
      	fin
      	si pas dateOK alors info("date pas bonne")
      FIN
      
      
     type : 458752
