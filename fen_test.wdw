    name : Bouton11
    identifier : 0x207607e82385667b
    internal_properties : 
    properties :
     x : 134
     y : 636
     width : 80
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         txtreq est une chaine = "select * from BonLivraison where bonlivraison.BDateFacture >= %1 and bonlivraison.Bfacture<> 0 and bonlivraison.bclient = '139       ' order by bonlivraison.Bfacture"
         //txtreq est une chaine = [
         //	select * from BonLivraison inner join hfacture on hfacture.fanumero = bonlivraison.BnoCommande
         //	where bonlivraison.BDateFacture >= '20210201' and bonlivraison.Bfacture<> 0 and bonlivraison.bclient = '139       ' 
         //	order by hfacture.idlivraison,bonlivraison.Bfacture
         //]
         reqsql est une source de donnees
         Prixu est un reel
         pdebase est une chaine
         Ajustement est un reel = 0
         HLitRecherche(Client,IDClient,181)
         si hexecuterequetesql(reqsql,hRequêteDéfaut,ChaîneConstruit(txtreq,"20210201")) ALORS
         	pour TOUT reqsql 
         		Ajustement = 0
         		pour tout hfdetail avec "fdnofact = "+reqsql.bnumero
         			
         			//			hlitrecherche(Client,numero,reqsql.bclient)
         			si hfdetail.ftype = 1 et pas hfdetail.FDprixmodifie alors
         				pdebase = getpdebase(hfdetail.fdnumprod,sansespace(hfdetail.fdcomposant1),sansespace(hfdetail.fdcomposant2),sansespace(hfdetail.fdcomposant3))
         				Prixu  = 	CalculPrixThermos(hFdetail.fdnumprod,181,majuscule(hFdetail.fdcomposant1),majuscule(hFdetail.fdcomposant2),majuscule(hFdetail.fdcomposant3),pdebase)
         				si Arrondi((hfdetail.fdqteafacturer * hfdetail.fdpiedcarrefacture * Prixu) - (hfdetail.fdqteafacturer * hfdetail.fdprixu),2) <> 0 alors
         					tableajouteligne(table3,reqsql.bfacture,hfdetail.fdcomposant1,hfdetail.fdcomposant2,hfdetail.fdcomposant3,hfdetail.fdprixupiedfacture,hfdetail.fdqteafacturer,...
         					hfdetail.fdpiedcarrefacture,Prixu,arrondi((hfdetail.fdqteafacturer * hfdetail.fdpiedcarrefacture * Prixu) - (hfdetail.fdqteafacturer * hfdetail.fdprixu),2))
         					Ajustement += arrondi((hfdetail.fdqteafacturer * hfdetail.fdpiedcarrefacture * Prixu) - (hfdetail.fdqteafacturer * hfdetail.fdprixu),2)
         				fin
         			fin
         		fin
         		si Ajustement <> 0 alors
         			TableAjouteLigne(Table3,reqsql.bfacture,"Total","","","","","","",Ajustement)
         			tableajouteligne(Table3)
         			TableAjouteLigne(Table2,reqsql.Bfacture,reqsql.bdatefacture,reqsql.bstotal,reqsql.btps,reqsql.btvq,Ajustement)
         		fin
         		Message(reqsql.bfacture)
         		MultitâcheRepeint()		
         	FIN
         	
         FIN
         tableaffiche(Table2)
         
        type : 18
      -
        type : 161
        enabled : false
