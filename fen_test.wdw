     p_codes :
      -
        code : |1+
         reqsql est une source de données
         
         //pour TOUT Fdetail 
         //	si fdetail.ftype = 1  ALORS
         //		fdetail.ThermosType = gauche(ThermosType[CalculNombreVerre(Fdetail.fdcomposant1,Fdetail.fdcomposant2,Fdetail.fdcomposant3)],1)
         //		fdetail.PoidsUnitaire = CalculPoidsthermos(fdetail.fdpiedcarrereel,fdetail.thermostype,fdetail.fdbase,1)
         //		hmodifie(Fdetail,hnumenrencours)
         //	FIN
         //FIN
         nbtotal est un entier = HNbEnr(facture)
         cpt est un entier
         
         pour TOUT Facture 
            cpt++
            facture.AvecTriple = faux
            message(cpt +"/" + nbtotal)
         	SI HExécuteRequêteSQL(reqsql,hRequêteDéfaut,"select * from fdetail where fdetail.fdnocomm = " + facture.fanumero + "and fdetail.ftype = 1 ") ALORS
         		POUR TOUT reqsql
         			si reqsql.thermostype = "T" alors
         				facture.AvecTriple = vrai
         				
         				sortir
         			FIN
         		FIN
         	fin
         	HModifie(Facture,hNumEnrEnCours)
         FIN
        type : 18
