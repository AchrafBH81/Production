     width : 238
     height : 48
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         reqsql est une requête SQL = 
         [
         	select * from hfacture <§cs:3§>
         	where hfacture.bnumero not in (select BonLivraison.bnumero from bonlivraison) <§cs:3§>
         	and hfacture.fadate < '20180101'<§cs:3§>
         ]
         
         si HExécuteRequêteSQL(reqsql) alors
         	pour TOUT reqsql 
         		si hlitrecherche(hfacture,HFCLEUNIK,reqsql.HFCLEUNIK) alors
         			hsupprime(hfacture,hNumEnrEnCours)
         		FIN
         	FIN
         FIN
         
         info("terminé")
        type : 18
      -
        type : 161
        enabled : false
