        enabled : false
  -
    name : Compression_des_fichiers_PDF
    identifier : 0x20b6b9a30981727d
    internal_properties : 
    properties :
     x : 673
     y : 418
     width : 219
     height : 37
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         sZipFileName est une chaine
         sZipFile est un zipArchive
         
         tabfileToZip est une tableau de chaînes
         
         
         ListeRepertoire est tableau de  chaine
         NbFileToZip est un entier
         Lowerdate est une date = ZipDateFin
         UpperDate est une date = "19990101"
         ChaîneVersTableau(fListeRépertoire(ComplèteRep(repdonnees)+"PDF",frNonRécursif),ListeRepertoire,rc)
         
         pour tout sRepertoire de ListeRepertoire
         	fListeFichier(sRepertoire+[fsep]+"*.pdf",FileValidation)
         FIN
         sZipFileName  = Lowerdate+"_"+UpperDate+".zip"
         ResCréation est un entier = zipcree(sZipFile, fRépertoireTemp()+[fsep]+sZipFileName)
         
         NbFileToZip = tabfileToZip.Occurrence()
         cpt est un entier
         sZipFile.NiveauCompression = 9
         si ResCréation = 0 alors
         	pour tout sfile de tabfileToZip
         	   zipAjouteFichier(sZipFile,sfile,zipRépertoire)
         //	   fsupprime(sfile)
         	   cpt++
         	   JaugeZip = cpt/NbFileToZip * 100
             fin
             
         FIN
         
         
         	procédure interne FileValidation(sRep,Sfile)
         	FileDate est une date = fDate(sRep+Sfile)
         	
         	si FileDate <= zipdatefin alors
         		
         		SI FileDate < lowerdate ALORS lowerdate = FileDate
         		SI FileDate > upperdate ALORS upperdate = FileDate
         		tabfileToZip.ajoute(sRep+Sfile)
         	FIN
         	renvoyer vrai
         	FIN
         
        type : 18
      -
        type : 161
        enabled : false
