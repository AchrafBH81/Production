     p_codes :
      -
        code : |1+
         ThermosVerre est une chaine 
         pour TOUT CommandeAchat 
         	ThermosVerre = "V"
         	si HLitRecherchePremier(CommandeAchatDetail,IDCommandeAchat,CommandeAchat.IDCommandeAchat) alors
         		si hlitrecherche(invent,INUM,CommandeAchatDetail.cadNoProduit) alors
         			ThermosVerre = "V"
         		sinon
         			si hlitrecherche(persoens,ennumero,CommandeAchatDetail.cadNoProduit) alors
         				si sansespace(persoens.encomposant2) = "" et sansespace(persoens.encomposant3) = ""  alors
         					ThermosVerre = "V"
         				sinon
         					ThermosVerre = "T"
         					
         				FIN
         			FIN
         		FIN
         	FIN
         	CommandeAchat.CaThermosVerre = ThermosVerre
         	hmodifie(commandeachat,hNumEnrEnCours)
         	message(CommandeAchat.CanoCommande)
         	MultitâcheRepeint()
         FIN
        type : 18
      -
