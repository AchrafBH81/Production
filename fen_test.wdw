      -
        code : |1-
         tabOrderTotest			est un tableau de cCustomerOrderToPrint
         clCurrentCustomer		est un cCustomerOrderToPrint
         clCurrentOrder			est un cordertoprint
         clCurrentOrderDetail	est un corderdetail
         
         tabOrderToprocess est un tableau d'entier =[796097,797387]
         
         pour chaque nOrdernumber de tabOrderToprocess
         	si hlitrecherche(Facture,fanumero,nOrdernumber) alors
         		clCurrentCustomer.m_nCustomerID			= facture.IDClient
         		clCurrentCustomer.m_nShippingCustomerID	= facture.idLivraison
         		clCurrentOrder							= allouer un cordertoprint()
         		clCurrentOrder.m_nordernumber			= nOrdernumber
         		clCurrentOrder.m_sCustomerNumberJob		= facture.fanojob
         		clCurrentOrder.m_sCustomerOrderNumber	= facture.fanocommande
         		clCurrentOrder.m_dOrderRequiredDate     = facture.fadate
         		hlitrecherche(Fdetail,fdnocomm,nOrdernumber)
         		tantque fdetail.fdnocomm = nOrdernumber
         			si fdetail.ftype <> 4 ALORS
         				clCurrentOrderDetail					= allouer un cOrderDetail()
         				clCurrentOrderDetail.m_nLineNumber		= fdetail.fdligne
         				clCurrentOrderDetail.m_nQtyProduced		= fdetail.fdqteafacturer
         				
         				clCurrentOrderDetail.m_sProductNumber	= fdetail.fdnumprod
         				clCurrentOrder.m_tabOrderDetail.ajoute(clCurrentOrderDetail)
         			FIN
         			hlitsuivant(fdetail,fdnocomm)
         		FIN
         		
         		clCurrentCustomer.m_tabOrder.ajoute(clCurrentOrder)
         	FIN
         FIN
         tabOrderTotest.ajoute(clCurrentCustomer)
         PrintBatchShippingBills(tabOrderTotest)
