  -
    name : Alimente_facture_forme_carrelage_speciaux
    identifier : 0x2db2d5ae96008695
    internal_properties : 
    properties :
     x : 19
     y : 316
     width : 221
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         AvecCarrelage est un booleen
         AvecForme est un booleen
         EpaisseurVerre est un entier
         AvecProduitSpeciaux est un booleen
         
         pour tout facture avec facture.EpaisseurVerre = 0
         	AvecCarrelage = faux
         	AvecForme = faux
         	AvecProduitSpeciaux = faux
         	EpaisseurVerre = 0
         	message(facture.fanumero)
         	hlitrecherche(fdetail,fdnocomm,facture.fanumero)
         	tantque fdetail.fdnocomm = facture.fanumero et pas hendehors(fdetail)	
         		SI Fdetail.fdcarrelage ALORS
         			AvecCarrelage = Vrai
         		FIN
         		SI SansEspace(Fdetail.fdforme) <> "" ALORS
         			AvecForme = Vrai
         		FIN
         		si EpaisseurVerre = 0 alors
         			EpaisseurVerre = Val(Droite(SansEspace(Fdetail.fdbase),1))
         		FIN
         		nbcomposant est un entier = 0
         		nbComposantSpeciaux est un entier = 0
         		POUR i = 1 À 3
         			SI SansEspace({"fdetail.fdcomposant"+i,indRubrique}) <> "" ALORS 
         				nbcomposant++
         			FIN
         			SI HLitRecherche(invent,INUM,{"fdetail.fdcomposant"+i,indRubrique}) ALORS
         				SI invent.IproduitSpecial ALORS
         					nbComposantSpeciaux++
         				FIN
         			FIN
         		FIN
         		
         		SI nbcomposant <> 0 _ET_ nbComposantSpeciaux = nbcomposant ALORS AvecProduitSpeciaux = Vrai
         		facture.AvecProduitSpeciaux = AvecProduitSpeciaux
         		facture.AvecForme = AvecForme
         		facture.AvecCarrelage = AvecCarrelage
         		facture.EpaisseurVerre = EpaisseurVerre
         //		facture.IDCamions = 1
         		hmodifie(facture,hNumEnrEnCours)
         		hlitsuivant(Fdetail,fdnocomm)
         	fin
         fin
        type : 18
      -
        type : 161
        enabled : false
  -
    name : Alimenter_ThermosType_de_fdetail
    identifier : 0x2db3140566d405f4
    internal_properties : 
    properties :
     x : 19
     y : 346
     width : 221
     height : 24
    type : 4
    code_elements :
