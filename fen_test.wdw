  -
    name : BTN_Alimenter_la_date_d_adhésion_client_edi
    identifier : 0x275c8b7b32665d49
    internal_properties : 
    properties :
     x : 551
     y : 354
     width : 206
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         sdReqClient		est une source de donnees
         sdReqdate		est une source de donnees
         
         sTxtreqclient	est une chaine	= [
         select * from client where client.ediType = 1
         
         ]
         
         sTxtreqdate est une chaine = [
         select top 1 cotationdate as adhesion from cotation where cotation.IdCustomer = %1
         union 
         select top 1 cotationdate as adhesion from ExternalOrder where ExternalOrder.IdCustomer = %1
         order by cotationdate asc
         ]
         
         si HExécuteRequêteSQL(sdReqClient,hRequêteDéfaut,stxtreqclient) alors
         	pour TOUT sdReqClient 
         		message(client.nom)
         		multitacherepeint()
         		
         		si HExécuteRequêteSQL(sdReqdate,hRequêteDéfaut,ChaîneConstruit(sTxtreqdate,sdReqClient.idclient)) alors
         			si hnbenr(sdReqdate) <> 0 alors
         				hlit(sdReqdate,1)
         				si HLitRecherche(Client,IDClient,sdReqClient.idclient) alors
         					client.DateAdhesion = sdReqdate.adhesion
         					hmodifie(client,hnumenrencours)
         				FIN
         			sinon
         				info(client.nom)
         				
         			FIN
         			
         		FIN
         	FIN
         FIN
         
         info("Terminé")
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_SansNom21
    identifier : 0x281f95192727571e
    internal_properties : 
    properties :
     x : 910
     y : 357
     width : 242
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         avecenergiverre	est un booleen	= Faux
         avecenergiverreESC	est un booleen	= Faux
         avectrempe		est un booleen	= Faux
         sdReqSql		est une source de donnees
         
         pour CHAQUE Facture avec "facture.fadate > 20250401"
         	avecenergiverre		= Faux
         	avecenergiverreESC		= Faux
         	avectrempe		    = Faux
         	message(facture.fanumero)
         	MultitâcheRepeint()
         	si HExécuteRequêteSQL(sdReqSql,hRequêteDéfaut,"select * from fdetail where fdetail.fdnocomm =" + facture.fanumero + " AND fdetail.ftype = 1") alors
         		pour CHAQUE sdReqSql 
         			POUR i = 1 À 3
         				SI HLitRecherche(invent,INUM,{"sdreqsql.fdcomposant"+i,indRubrique}) ALORS
         					SI PAS avecenergiverre ALORS avecenergiverre = invent.ienergieverre
         					SI PAS avecenergiverreESC ALORS avecenergiverreESC = invent.ienergieverreESC
         					SI PAS avectrempe ALORS avectrempe = invent.IsTempered
         					
         				FIN
         			FIN
         		FIN
         		
         		facture.AvecEnergiverre	= avecenergiverre
         		facture.AvecEnergiverreESC	= avecenergiverreESC
         		facture.Avectrempe		= avectrempe
         		hmodifie(Facture,hNumEnrEnCours)
         		
         	FIN
         FIN
         
         
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_SansNom22
    identifier : 0x284c198b3c0e9f48
    internal_properties : 
    properties :
     x : 916
     y : 400
     width : 242
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         avecenergiverre		est un booleen	= Faux
         avecenergiverreESC	est un booleen	= Faux
         avectrempe			est un booleen	= Faux
         sdReqSql			est une source de donnees
         bArgon				est un booleen
         
         pour CHAQUE Facture avec "facture.fadate > 20250101"
         	avecenergiverre			= Faux
         	avecenergiverreESC		= Faux
         	avectrempe				= Faux
         	message(facture.fanumero)
         	MultitâcheRepeint()
         	
         	si HExécuteRequêteSQL(sdReqSql,hModifieFichier,"select * from fdetail where fdetail.fdnocomm =" + facture.fanumero + " AND fdetail.ftype = 1") alors
         		bArgon = faux
         		pour CHAQUE sdReqSql 
         			POUR i = 1 À 3
         				SI HLitRecherche(invent,INUM,{"sdreqsql.fdcomposant"+i,indRubrique}) ALORS
         					SI  invent.ienergieverreESC alors
         						bArgon = vrai
         					FIN
         					
         				FIN
         			FIN
         			si bArgon _et_ Position(sdReqSql.fcapgaztube,"Z") = 0 alors
         				sdReqSql.fcapgaztube="Z"
         				hmodifie(sdReqSql,hNumEnrEnCours)
         				
         			FIN
         		FIN
         		
         		
         	FIN
         FIN
         
         
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_SansNom23
    identifier : 0x285aa23f3950ae86
    internal_properties : 
    properties :
     x : 1182
     y : 76
     width : 80
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         NoTrxaliberer est un entier = 81201
         
         boucle
         message(NoTrxaliberer+" "+HTransactionLibère(LogFile,NoTrxaliberer))
         multitacherepeint(mafenetre)
         NoTrxaliberer++
         
         
         
         a faire tantque NoTrxaliberer < 500000
         
         
         
         
         
         
         
         
         
         
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_Alimente_QuotationByCustomer
    identifier : 0x28bd8a74a8da25df
    internal_properties : 
    properties :
     x : 1044
     y : 316
     width : 205
     height : 44
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         pour CHAQUE Cotation 
         	si pas cotation.IsDeleted alors
         		si HLitRecherche(QuotationByCustomer,IdCustomerQuotationdate,[COTATION.IdCustomer,cotation.CotationDate]) alors
         			QuotationByCustomer.TotalNumber+=1
         			hmodifie(QuotationByCustomer,hNumEnrEnCours)
         		sinon
         			QuotationByCustomer.IdCustomer		= Cotation.IdCustomer
         			QuotationByCustomer.TotalNumber		= 1	
         			QuotationByCustomer.Quotationdate	= cotation.CotationDate
         			si hlitrecherche(client,IDClient,QuotationByCustomer.IdCustomer) alors
         				QuotationByCustomer.CustomerNumber = client.numero
         			FIN
         			hajoute(QuotationByCustomer)
         			
         		FIN
         	FIN
         	
         FIN
         info("terminé")
        type : 18
      -
        type : 161
        enabled : false
