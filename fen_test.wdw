     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] GetArgonExtraPrice (<CustomerNumber> est chaîne)
      //
      // Paramètres :
      //	CustomerNumber (chaîne ANSI) : <indiquez ici le rôle de CustomerNumber>
      // Valeur de retour :
      // 	Type indéterminé : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE GetArgonExtraPrice(CustomerNumber est une chaine)
      clederecherche est une chaine = HConstruitValClé(ProduitClient,IdClientIdproruit,CustomerNumber,gsExtraArgon)
      
      SI HLitRecherche(ProduitClient,IdClientIdproruit,clederecherche) ET ProduitClient.IPprixSpecial ALORS
      		renvoyer = ProduitClient.IPrixa
      sinon
      	si hlitrecherche(invent,INUM,gsExtraArgon) ALORS
      		renvoyer = invent.iprixunite
      	FIN
      FIN
      
     type : 458752
   -
     name : calculTotalCommandeAvecTaxe
     internal_properties : CQAAAAkAAAAPmjo3Cwbow3PBobCzogtEEGXInRoTa+/XFJ9MrNa2bBy0AyDKvbyAd7hPxzoKpFOQdsaRLo5axdUADA==
     procedure_id : 1440776857237264714
     type_code : 14
     code : |1+
      Procédure calculTotalCommandeAvecTaxe(NoCommande est un entier)
      rTotalquantite est un reel = 0
      _totalcommande est un reel = 0
      lbonlivraison est un booleen
      _mult est un entier 
      tottps est un reel
      tottvq est un reel
      totalLigne est un reel
      lQteAjuste est un reel
      //SI MODIF ALORS
      
      
      RequeteCommandePourLimite.PIdClient = Null
      RequeteCommandePourLimite.pNoComm = NoCommande
      si pas HExécuteRequête(RequeteCommandePourLimite)  ALORS
      	erreur("Erreur lors de l'exécution de la requete")
      	renvoyer 0
      FIN
      
      
      
      
      
      Pour TOUT RequeteCommandePourLimite 
      	totalLigne = 0
      	lbonlivraison = (RequeteCommandePourLimite.FPREPARATION = "B" )
      	lQteAjuste = lbonlivraison ? 1 sinon requetecommandepourlimite.fdqteafacturer / requetecommandepourlimite.fdqte
      	_mult = requetecommandepourlimite.fatypedocument = 2 ? -1 sinon 1
      	selon requetecommandepourlimite.ftype
      		cas 1
      			totalLigne+=((arrondi(requetecommandepourlimite.fdprixtotal,2)+arrondi(requetecommandepourlimite.surchargeenergie,2)) ) + ((requetecommandepourlimite.FDextra10X+requetecommandepourlimite.FDextra5x))
      		cas 2
      			totalLigne+=((arrondi(requetecommandepourlimite.fdprixtotal,2)+arrondi(requetecommandepourlimite.surchargeenergie,2)) ) + ((requetecommandepourlimite.FDextra10X+requetecommandepourlimite.FDextra5x))
      		cas 3
      			totalLigne+=(arrondi(requetecommandepourlimite.fdprixtotal,2)) 
      		cas 4
      			totalLigne+=(arrondi(requetecommandepourlimite.fdprixtotal,2)) 
      			si requetecommandepourlimite.fpeinture alors
      				totalLigne+=(arrondi(requetecommandepourlimite.fTotalPeinture,2)) * requetecommandepourlimite.fdqteafacturer
      			fin
      		cas 5
      			totalLigne+=(arrondi(requetecommandepourlimite.fdprixtotal,2)) 
      
      	FIN
      	tottps = Arrondi(totalLigne * RequeteCommandePourLimite.fatps / 100 ,2)
      	tottvq = Arrondi(totalLigne * RequeteCommandePourLimite.fatvq / 100 ,2)
      
         _totalcommande+= (( totalLigne + tottps + tottvq ) * _mult) 
      //   _totalcommande+=  totalLigne * _mult 
        
      fin		 
      
      
      renvoyer _totalcommande
      
      
      
      
     type : 458752
   -
     name : LPSolveResoudre
     internal_properties : CQAAAAkAAAAETzEdwRNMKZCPH5biRPuGIhjJRSEy3U5JTZLOlnghFVmFZRAIgAj/DndRQNodyJtsm+0/ZceFTWe1eMnQaGiLmgPfLUoNfKg7ZDSdjQfgE4hHDRZHlxXQX2O7phicXMgmI90vZoTwQshKoz41fdqz8xIKS6ylpZC1pX+bK8EWsw4U
     procedure_id : 1654044871501589757
     type_code : 14
     code : |1-
      // Traitement automatique des exceptions :   exécuter le bloc de code CAS EXCEPTION:
      //
      
      PROCEDURE LPSolveResoudre(sFormulationLP, pnObjectif, psSolution, psMessage)
      
      // Variables
      nInstanceDLL est un entier systeme
      
      nLP		     est un entier sur 8 octet
      sNomPL	     est une chaine 
      nRésolution  est un entier sur 8 octets
      sLig		 est une chaine
      sSol		 est une chaine
      bDébutSolOk  est un booléen
      
      gsFichierLP		est une chaîne
      gsFichierLOG	est une chaîne
      gsFichierSOL	est une chaîne
      
      tabResult est un tableau de chaine ANSI
      // Initialisation
      sNomPL = <§$0010§>
      nInstanceDLL = ChargeDLL(DLL_NOM)
      bDébutSolOk = Faux
      
      // Chargement de la DLL LpSolve
      SI nInstanceDLL = 0 ALORS
      	psMessage = <§$0002§>+"lpsolve55.dll"
      	RENVOYER tabresult
      FIN
      
      // Récupération de noms de fichiers temporaires pour la résolution du problème
      gsFichierLP  = fFichierTemp("FLP", fRepExe()) // Fichier contenant la Formulation du Problème Linéaire
      gsFichierLOG = fFichierTemp("LOG", fRepExe()) // Fichier contenant la log d'exécution des fonctions de la DLL lpsolve55.dll
      gsFichierSOL = fFichierTemp("SOL", fRepExe()) // Fichier contenant la solution trouvée par la fonction lpsolve de la DLL lpsolve55.dll
      
      // On sauvegarde la formulation dans le fichier qui sera lu par la fonction read_LP
      fSauveTexte(gsFichierLP, sFormulationLP)
      
      // Chargement du problème linaire
      nLP = API(DLL_NOM, "read_LP", gsFichierLP, CST_VERBOSE_NORMAL, sNomPL)
      SI nLP = 0 ALORS
      	psMessage = <§$0003§>+RC+<§$0004§>
      	RENVOYER tabresult
      FIN
      
      // On définit le fichier de log pour les fonctions de la DLL LP Solve
      API(DLL_NOM, "set_outputfile", nLP, gsFichierLOG)
      
      // Résolution du problème
      nRésolution = API(DLL_NOM, "solve", nLP)
      
      SELON nRésolution
      	CAS CST_RES_NOMEMORY
      		psMessage = <§$0005§>
      		RENVOYER tabresult
      		
      	CAS CST_RES_OPTIMAL			
      		psMessage = <§$0006§>
      		
      	CAS CST_RES_SUBOPTIMAL
      		psMessage = <§$0007§>
      		
      	CAS CST_RES_INFEASIBLE		
      		psMessage = <§$0008§>
      		RENVOYER tabresult
      		
      	CAS CST_RES_UNBOUNDED	
      		psMessage = <§$0009§>
      		RENVOYER tabresult
      		
      	CAS CST_RES_DEGENERATE	
      		psMessage = <§$000a§>
      		RENVOYER tabresult
      		
      	CAS CST_RES_NUMFAILURE	
      		psMessage = <§$000b§>
      		RENVOYER tabresult
      		
      	CAS CST_RES_USERABORT	
      		psMessage = <§$000c§>
      		RENVOYER tabResult
      		
      	CAS CST_RES_TIMEOUT		
      		psMessage = <§$000d§>
      		
      	CAS CST_RES_FEASFOUND	
      		psMessage = <§$000e§>
      		
      	CAS CST_RES_NOFEASFOUND		
      		psMessage = <§$000f§>
      		RENVOYER tabresult
      FIN
      
      // On définit le fichier qui contient la solution
      API(DLL_NOM, "set_outputfile", nLP, gsFichierSOL)
      API(DLL_NOM, "print_objective", nLP)
      API(DLL_NOM, "print_solution", nLP, 1)
      
      // On parcours le fichier de solution pour afficher les valeurs dans l'application
      sSol = fChargeTexte(gsFichierSOL)
      psSolution = ""
      i est un entier = 1
      tantque sLig <> eot
      	sLig = ExtraitChaîne(sSol,i,rc)
      	si sLig = eot alors sortir
      	SI sLig [= "Value of objective function:" ALORS
      		pnObjectif = Val(sLig[[Taille("Value of objective function:")+1 A ]])
      	SINON SI sLig [= "Actual values of the variables:" ALORS
      		bDébutSolOk = Vrai
      	SINON SI bDébutSolOk
      		sVar est une chaine	= ExtraitChaîne(sLig, 1, " ")
      		SI sVar<>"" ALORS
      			nVal est un entier	= val(SansEspace(sLig[[taille(sVar)+1 a ]]))
      			psSolution += [RC]+ sVar + TAB + nVal 
      		FIN
      	FIN
      	i++
      FIN
      
      
      SI nLP <> 0 ALORS
      	API(DLL_NOM, "set_outputfile", nLP, "") //Ferme le fichier de sortie pour pouvoir le supprimer
      	fSupprime(gsFichierLP,frLectureSeule)
      	fSupprime(gsFichierLOG,frLectureSeule)
      	fSupprime(gsFichierSOL,frLectureSeule)
      FIN
      DéchargeDLL(nInstanceDLL)
      
      
      ChaîneVersTableau(psSolution,tabResult,rc)
      RENVOYER tabResult
      
      
      
      //FIN:
      //
      ////Suppression des fichiers temporaires
      //SI nLP <> 0 ALORS
      //	API(DLL_NOM, "set_outputfile", nLP, "") //Ferme le fichier de sortie pour pouvoir le supprimer
      //	fSupprime(gsFichierLP,frLectureSeule)
      //	fSupprime(gsFichierLOG,frLectureSeule)
      //	fSupprime(gsFichierSOL,frLectureSeule)
      //FIN
      //DéchargeDLL(nInstanceDLL)
      
      
      CAS EXCEPTION:
      	
      	info(exceptioninfo(errMessage))
     type : 458752
   -
     name : RecalculateRack
     procedure_id : 1654346803286923456
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] RecalculateRack (<tabCurrentrack> est tableau (stOrder), <nRackNumber> est entier)
      //
      // Paramètres :
      //	tabCurrentrack (tableau (stOrder)) : <indiquez ici le rôle de tabCurrentrack>
      //	nRackNumber (entier) : <indiquez ici le rôle de nRackNumber>
      // Valeur de retour :
      // 	STAllrack : <indiquez ici le rôle de la valeur de retour>
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure RecalculateRack(tabCurrentrack est un tableau de storder,nRackNumber est un entier)
      
      stCurrentAllRack	est un stallrack
      
      
      nCptLow				est un entier		= 23
      nCpthigh			est un entier		= 24
      tabCurrentRack.Trie(ttMembre,"-nLargeur")
      bLowHigh est un booleen = Vrai
      POUR z = 1 _À_ tabCurrentRack..Occurrence
      	SI bLowHigh ET tabCurrentRack[z].nQuantity >  nCptLow ALORS
      		bLowHigh = Faux
      	SINON SI PAS bLowHigh ET tabCurrentRack[z].nQuantity >  47 - nCpthigh
      		bLowHigh = Vrai
      	FIN	
      	SI bLowHigh ALORS
      		
      		
      		si ncptlow > 0 alors
      			stCurrentAllRack.OneRack[nCptLow]								= tabCurrentRack[z].nLargeur
      			stCurrentAllRack.OneRackHauteur[nCptLow]						= tabCurrentRack[z].nHauteur
      			tabCurrentRack[z].nRackLineNumber								= nCptLow
      			stCurrentAllRack.tabCurrentOrder.Ajoute(tabCurrentRack[z])
      			nCptLow--
      		sinon
      			stCurrentAllRack.OneRack[nCpthigh]								= tabCurrentrack[z].nLargeur
      			stCurrentAllRack.OneRackHauteur[nCpthigh]						= tabCurrentrack[z].nHauteur
      			tabCurrentrack[z].nRackLineNumber								= nCpthigh
      			stCurrentAllRack.tabCurrentOrder.Ajoute(tabCurrentrack[z])
      			nCpthigh++
      		fin
      		
      		
      		tabCurrentRack[z].bProcess	= Vrai
      		bLowHigh					= Faux
      	SINON
      		
      		SI nCpthigh <= 47 ALORS
      			stcurrentallrack.OneRack[nCpthigh]								= tabCurrentRack[z].nLargeur
      			stCurrentAllRack.OneRackHauteur[nCpthigh]						= tabCurrentRack[z].nHauteur
      			tabCurrentRack[z].nRackLineNumber								= nCpthigh
      			stcurrentallrack.tabCurrentOrder.Ajoute(tabCurrentRack[z])
      			nCpthigh++
      		sinon
      			stCurrentAllRack.OneRack[nCptLow]								= tabCurrentrack[z].nLargeur
      			stCurrentAllRack.OneRackHauteur[nCptLow]						= tabCurrentrack[z].nHauteur
      			tabCurrentrack[z].nRackLineNumber								= nCptLow
      			stCurrentAllRack.tabCurrentOrder.Ajoute(tabCurrentrack[z])
      			nCptLow--
      		fin
      		
      		
      		tabCurrentRack[z].bProcess	= Vrai
      		bLowHigh					= Vrai
      		
      	FIN
      FIN
      
      
      renvoyer stcurrentallrack
      
      
     type : 458752
   -
     name : Recentrer
     procedure_id : 1654359391849419287
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //Recentrer (<tabCurrentrack> est tableau (stOrder))
      //
      // Paramètres :
      //	tabCurrentrack (tableau (stOrder)) : <indiquez ici le rôle de tabCurrentrack>
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure Recentrer(tabCurrentrack est un tableau de storder)
      nNoCamion	= Milieu(extraitchaine(SAI_SansNom1,1,tab),7)
      nNoRack	= milieu(ExtraitChaîne(SAI_SansNom1,2,tab),5)
      
      SI nNoRack = 0 OU nNoCamion = 0 ALORS RENVOYER Vrai
      
      nLowEmptyCell	est un entier = 0
      nHighEmptyCell	est un entier = 51
      nStartingCell	est un entier
      cpt				est un entier
      nCptEmptyCell	est un entier 
      
      
      
      
      pour i = 1 a 23
      	si TABLE_TabOneRack[i].COL_RackID = 0 alors
      		nLowEmptyCell = i
      	sinon
      		sortir
      	FIN
      FIN
      POUR i = 47 a 24 pas -1
      	nCptEmptyCell++
      	SI TABLE_TabOneRack[i].COL_RackID = 0 ALORS
      		nhighEmptyCell = i
      		
      	SINON
      		SORTIR
      	FIN
      FIN
      
      si ((48-nHighEmptyCell)-nLowEmptyCell )/2 < 0 alors
      	nStartingCell = Arrondisupérieur(((48-nHighEmptyCell)-nLowEmptyCell )/2)
      sinon
      	nStartingCell =  Arrondiinférieur(((48-nHighEmptyCell)-nLowEmptyCell )/2)
      FIN
      
      si nStartingCell <> 0 alors
      	
      	si nStartingCell > 0 alors
      		pour i = nHighEmptyCell-1 _a_ nLowEmptyCell+1 pas -1
      			TABLE_TabOneRack.DéplaceLigne(i, i+nStartingCell,tdDéplace) 
      		FIN
      	sinon
      		POUR i = nLowEmptyCell+1 _a_ nHighEmptyCell-1 
      			TABLE_TabOneRack.DéplaceLigne(i, i+nStartingCell,tdDéplace) 
      		FIN
      		
      	fin
      	
      	tabOneRack.SupprimeTout()
      	POUR TOUTE LIGNE DE TABLE_TabOneRack 
      		cpt++
      		tabOneRack.Ajoute(TABLE_TabOneRack.COL_Width)
      		SI TABLE_TabOneRack.COL_RackID <> 0 ALORS
      			//		nRes est un entier = gtaAllRack[SAI_SansNom1].tabCurrentOrder.cherche(tcLinéaire,"nRackLineNumber",COL_RackID)
      			//		si nres <> -1 alors
      			gtaAllTruckrack[nNoCamion].taAllTruckRack[nNoRack].tabCurrentOrder[TABLE_TabOneRack.COL_RackID].nRackLineNumber = cpt
      //			gtaAllRack[SAI_SansNom1].tabCurrentOrder[COL_RackID].nRackLineNumber = cpt
      			//		Fin
      			
      		FIN
      	FIN
      	POUR i = 1 a 47
      //		TableAjouteLigne(TABLE_TabOneRack)
      		TABLE_TabOneRack[i].COL_Pos = i
      	FIN
      	ExécuteTraitement(BTN_Dessine,trtClic)
      fin
      
      
      
      
     type : 458752
   -
     name : SetBestCombine
     procedure_id : 1657016490419618911
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] SetBestCombine (<tabCurrentmasterUniqueRack> est tableau (STMasterOrder), <nMaxToReach> est entier)
      //
      // Paramètres :
      //	tabCurrentmasterUniqueRack (tableau (STMasterOrder)) : <indiquez ici le rôle de tabCurrentmasterUniqueRack>
      //	nMaxToReach (entier) : <indiquez ici le rôle de nMaxToReach>
      
      // Valeur de retour :
      // 	tableau (chaîne ANSI) : <indiquez ici le rôle de la valeur de retour>
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure SetBestCombine(tabCurrentmasterUniqueRack est un tableau de STMasterOrder,nMaxToReach est un entier)
      
      
      
      
      formula		est une chaîne
      sObjectif	est une chaîne
      sOlution	est une chaîne
      s_message	est une chaîne
      _groupe		est un entier	= 0
      _max		est une chaîne	= "max : "
      _formula	est une chaîne
      _Init1		est une chaîne 
      _Int		est une chaîne	= "int "
      _ldebut		est un booléen	= Vrai
      
      boucle
      	_max		= "max : "
      	_formula	= ""
      	_Init1		= ""
      	_Int		= "int "
      	_ldebut		= Vrai
      	_groupe+=1
      	
      	
      	
      	POUR t = 1 _À_ tabCurrentmasterUniqueRack..Occurrence
      		
      		SI PAS _ldebut ALORS  
      			_max += " + x"+NumériqueVersChaîne(t) 
      			_formula  +="+ " + NumériqueVersChaîne(tabCurrentmasterUniqueRack[t].nTotalQuantity)+ " x"+NumériqueVersChaîne(t)
      			_Int+= ","+ "x"+NumériqueVersChaîne(t)
      		SINON  
      			_ldebut = Faux
      			_max += " x"+NumériqueVersChaîne(t)
      			_formula  += NumériqueVersChaîne(tabCurrentmasterUniqueRack[t].nTotalQuantity)+ " x"+NumériqueVersChaîne(t)
      			_Int+= "x"+NumériqueVersChaîne(t)
      		FIN
      		_Init1 += "x"+NumériqueVersChaîne(t)+ "<=1;"+RC
      		
      	FIN
      	_max += ";"
      	_formula+= " <="+nmaxtoreach+";"
      	_Int+=";"
      	
      	
      	formula = _max+RC+RC+_formula+RC+_Init1+RC+_Int+RC
      	
      	tabCombineResult est un tableau de chaine = LPSolveResoudre(formula,"","","")
      //	cpt est un entier = 0
      //	pour chaque scombine de tabcombineresult
      //		si Val(ExtraitChaîne(sCombine,2,TAB)) = 1 alors
      //		   cpt++
      //		fin
      //	FIN
      	
      	
      	nMaxToReach-=1
      a faire tantque nmaxtoreach = 0
      
      
      renvoyer tabCombineResult
      
     type : 458752
   -
     name : checkIfEmptySlot
     procedure_id : 1659532258885951078
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] checkIfEmptySlot (<NoRack> est entier)
      //
      // Paramètres :
      //	NoRack (entier) : <indiquez ici le rôle de Param1>
      // Valeur de retour :
      // 	multi-valeur : <indiquez ici le rôle de la valeur de retour>
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure checkIfEmptySlot(NoRack est un entier)
      nCPT est une entier
      nLowestEmpty est un entier
      nHighestEmpty est un entier
      
      pour i = 1 a 47
         si gtaAllRack[norack].OneRack[i]	= 0 alors
           si i < 23 alors
           	
           		nlowestempty = i
           	
           sinon
      			
      				si nHighestEmpty = 0 alors nHighestEmpty = i
      			
           FIN
           ncpt++
         fin
         	
       FIN
       SI nHighestEmpty = 0 ALORS nHighestEmpty = 51
      renvoyer (ncpt,nLowestEmpty,nHighestEmpty)
     type : 458752
   -
     name : checkIfEmptySlotForTransfer
