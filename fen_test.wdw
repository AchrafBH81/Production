  -
    name : BTN_Calculer_Lpsolve
    identifier : 0x26fef9bc272f6382
    internal_properties : 
    properties :
     x : 202
     y : 15
     width : 170
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        internal_properties : CQAAAAkAAAAMKk0bUnppf9n/DdIx+pD12FdjGBpDdPouTXmKpwRX8VSK7s3EyvfwpbA1UoOIDFhQRWUvEtPmaHQL3DqP9EYkvNp92ZaY8pL88p/fEQhlXNEtBTP55g==
        code : |1-
         si BTN_getTruck..visible alors
         	si pas ouinon(0,"Le racking a déjà été calculé et sauvegardé pour cette date","Voulez-vous quand même le recalculer ?") alors
         		renvoyer faux
         	FIN
         FIN
         ouvresoeur(FEN_AttenteGif,"Calcul des racks en cours.....")
         tabCurrentOneRack est un tableau de 47 reel
         tabOneRack = tabCurrentOneRack
         GRF_Rack.Dessine()
         TABLE_RackAuMur.supprimetout()
         LIB_DateTraitée = CAL_Rack
         nCpt								est un entier
         tabRackAll							est un tableau de storder
         tabRack								est un tableau de storder
         tabRackMur							est un tableau de storder
         tabLastRack							est un tableau de storder
         tabCurrentRack						est un tableau de storder
         tabMasterRack						est un tableau de STMasterOrder
         tabMasterUniqueRack					est un tableau de STMasterOrder
         tabMasterNonUniqueRack				est un tableau de STMasterOrder
         stCurrentmasterRack					est un STMasterOrder
         tabCurrentmasterRack				est un tableau de STMasterOrder
         tabCurrentmasterUniqueRack			est un tableau de STMasterorder
         tamasterCustomer					est un tableau associatif  de STMasterCustomer
         bNewCamion							est un booleen 
         Maxrack								est un entier 
         NewrackMandatory					est un booleen
         
         DayNumber							est un entier	= Dateversjour(CAL_Rack)
         Cpt									est un entier	// compteur pour savoir si on est sur un compteur pair/impair pour sasvoir si on met le thermos au début ou à la fin du rack
         nNbRack								est un entier	// Nombre de rack
         nNBSlotCurrentRack					est un entier
         nNbThermos							est un entier
         nCurrentrack						est un entier
         bQuit								est un booleen
         bIsFirstOrder						est un booleen	// pour savoir si c,est la première commande du rack
         sCurrentOrderNumber					est une chaine
         sOldOrderNumber						est une chaine
         nRackNumber							est un entier	// numéro de rack en traitement.
         bIsRackUnique						est un booleen	// Pour identifier les racks unique pour un client.
         sLastCustomerNumber					est une chaîne	// dernier client traité dans la boucle de rack unique
         
         nCptNbRackPerOrder					est une entier
         nOverQtyOnOneLine est un entier
         nQtyToAdd est un entier
         
         
         
         taHighLowSlot						est un tableau associatif de cptslot
         
         sTxtsql								est une chaine	= [
         	select camions.NoCamion,facture.fanumero,facture.faclient,facture.FDATEREQUISE,fdetail.fdnumprod,fdetail.fddesc, fdetail.fdqteafacturer +fdetail.fdqtedejafacture
         	as qty,facture.faclient,fdetail.fdlargeuranglais,fdetail.fdhauteuranglais,fdlargeur,fdhauteur,fdlargeura,fdhauteura,fdforme,idlivraison,client.idclient,fdetail.fdligne
         	as OrderDetailLine , facture.facalcul  from facture 
         	inner join camions on camions.IDCamions	= facture.IDCamions
         	inner join FDETAIL on FDETAIL.fdnocomm	= facture.fanumero
         	inner join client on client.numero		= facture.faclient
         	where  facture.FDATEREQUISE = {pdate} and camions.PickUp = 0 and fdetail.ftype = 1 and camions.NoCamion = {pNoCamion} and facture.fatypedocument = 1
         	order by camions.NoCamion,fdetail.fdlargeuranglais asc
         ]
         sTxtsqlCamion est une chaine = [
         	select distinct camions.NoCamion from facture 
         	inner join camions on camions.IDCamions	= facture.IDCamions
         	inner join FDETAIL on FDETAIL.fdnocomm	= facture.fanumero
         	inner join client on client.numero		= facture.faclient
         	where  facture.FDATEREQUISE = {pDate} and camions.PickUp = 0 and fdetail.ftype = 1  and facture.fatypedocument = 1
         	order by camions.nocamion
         ]
         
         sdReqsqlCamion est une source de donnees
         sdReqsqlCamion.pdate = CAL_Rack
         gtaAllTruckrack.SupprimeTout()
         gtaAllRack.SupprimeTout()
         ARBRE_Rack.SupprimeTout()
         si HExécuteRequêteSQL(sdReqsqlCamion,hRequêteDéfaut,sTxtsqlCamion) alors
         	
         	pour TOUT sdReqsqlCamion 
         		//		pour c = 4 a 4
         		bNewCamion = vrai
         		tabrackall.supprimetout()
         		tamasterCustomer.supprimetout()
         		tabMasterUniqueRack.supprimetout()
         		sOldOrderNumber = ""
         		sdReqsql est une source de donnees
         		sdReqsql.pdate		= cal_rack
         		sdreqsql.pnocamion	= sdReqsqlCamion.NoCamion
         		//		sdreqsql.pnocamion	= c
         		si HExécuteRequêteSQL(sdReqsql,hRequêteDéfaut,stxtsql) alors
         			
         			pour TOUT sdReqsql 
         				//		pour i = 1 a sdreqsql.qty
         				//			ncpt++
         				message(ncpt)
         				multitacherepeint()
         				stCurrentOrder est un storder
         
         				si sdreqsql.facalcul = 1 alors
         					stCurrentOrder.nLargeur						= InchFractionToMillimeter(sdreqsql.fdlargeuranglais)
         					stCurrentOrder.nHauteur						= InchFractionToMillimeter(sdReqsql.fdhauteuranglais)
         					si stCurrentOrder.nLargeur > stCurrentOrder.nhauteur alors
         						stCurrentOrder.nLargeur						= InchFractionToMillimeter(sdReqsql.fdhauteuranglais)
         						stCurrentOrder.nHauteur						= InchFractionToMillimeter(sdReqsql.fdlargeuranglais)
         					FIN
         				sinon
         					stCurrentOrder.nLargeur						= sdReqsql.fdlargeura
         					stCurrentOrder.nHauteur						= sdReqsql.fdhauteura
         					SI stCurrentOrder.nLargeur > stCurrentOrder.nHauteur ALORS
         						stCurrentOrder.nLargeur						= sdReqsql.fdhauteura
         						stCurrentOrder.nHauteur						= sdReqsql.fdlargeura
         					FIN
         				FIN
         				
         				
         				stCurrentOrder.nLargeurhauteur				= stCurrentOrder.nlargeur+stCurrentOrder.nhauteur
         				stCurrentOrder.OrderNumber					= sdreqsql.fanumero
         				stCurrentOrder.CustomerNumber				= sdReqsql.faclient
         				stCurrentOrder.sShapeNumber					= sansespace(sdReqsql.FdForme)
         				stcurrentorder.nIdClientLivraison			= sdreqsql.idlivraison
         				stcurrentorder.nIdClient					= sdreqsql.idclient
         				nOverQtyOnOneLine = sdReqsql.qty - 47
                         si nOverQtyOnOneLine > 0 alors
                         	nQtyToAdd = 47
                         sinon
                             nQtyToAdd = sdReqsql.qty
                         FIN
         				stCurrentOrder.nQuantity					= nQtyToAdd
         				stCurrentOrder.nOrderDetailLine				= sdreqsql.OrderDetailLine
         				tabrackAll.ajoute(stCurrentOrder)
         				nNbThermos+= nqtytoadd
         				si nOverQtyOnOneLine > 0 alors
         				boucle
                              				
         					stCurrentOrder.nQuantity					= min(nOverQtyOnOneLine,47)
         					tabRackAll.Ajoute(stCurrentOrder)
                             nOverQtyOnOneLine -= 47
         				
                         a faire tantque noverqtyononeline > 0 
                         fin
         				//		FIN
         				
         			FIN
         			
         		FIN
         		
         		//tabrackAll.Trie(ttMembre,"nLargeur;CustomerNumber")
         		tabrackAll.Applique(rackAuMur)
         		tabrackAll.Applique(ShippingSequence)
         		
         		//		tabrackAll.Trie(ttMembre,"-nshippingsequence;CustomerNumber;OrderNumber")
         		tabrackAll.Trie(ttMembre,"-nshippingsequence;CustomerNumber;OrderNumber")
         		
         		
         		tabRack				= tabRackAll.filtre(SuppressRackAuMur)
         		nCptNbRackPerorder	= 0
         		pour chaque stOrderLine de tabRack
         			si storderline.OrderNumber <> sOldOrderNumber ou (nCptNbRackPerOrder + stOrderLine.nQuantity > 47) ALORS
         				si sOldOrderNumber <> "" ou (nCptNbRackPerOrder + stOrderLine.nQuantity > 47) alors
         					stCurrentmasterRack.OrderNumber			= tabCurrentRack[1].OrderNumber
         					stCurrentmasterRack.nShippingSequence	= tabCurrentRack[1].nShippingSequence
         					stCurrentmasterRack.sCustomerNumber		= tabCurrentRack[1].CustomerNumber
         					stCurrentmasterRack.nTotalQuantity		= tabCurrentRack.somme("nQuantity")
         					stCurrentmasterRack.tabLine				= tabcurrentrack
         					tabMasterRack.ajoute(stCurrentmasterRack)
         				FIN
         				stCurrentmasterRack	= allouer un stmasterorder()
         				tabCurrentRack.supprimetout()
         				sOldOrderNumber		= stOrderLine.OrderNumber
         				nCptNbRackPerOrder	= 0
         			FIN
         			tabCurrentRack.Ajoute(storderline)
         			nCptNbRackPerOrder	+= storderline.nQuantity
         			
         		FIN
         		tabmasterRack.Applique(RackLiftShipping)
         		//tabmasterNonUniquerack	= tabMasterRack.filtre(MasterRack => MasterRack.bIsRackLiftShipping = faux)
         		//tabmasterUniquerack		= tabMasterRack.filtre(MasterRack => MasterRack.bIsRackLiftShipping = vrai)
         		tabmasterUniquerack		= tabMasterRack
         		pour chaque stMaster de tabMasterUniqueRack
         			tamasterCustomer[stmaster.sCustomerNumber].tabAllCustomerOrder.ajoute(stmaster)
         			tamasterCustomer[stmaster.scustomerNumber].nShippingSequence	= stmaster.nshippingSequence
         			tamasterCustomer[stmaster.scustomerNumber].bIsRackLiftShipping	= stmaster.bIsRackLiftShipping
         			
         		FIN
         		tamasterCustomer.trie(ttmembre,"nShippingSequence;bIsRackLiftShipping")
         		tabMasterRack.trie(ttMembre,"bIsRackLiftShipping;-nshippingsequence;-nTotalQuantity")
         		
         		tabRackMur	= tabRackAll.filtre(OnlyRackAuMur)
         		gtaAllTruckrack[sdReqsqlCamion.Nocamion].tabRackAuMur <= tabRackMur
         		
         		
         			procédure interne RackAuMur(t est un storder)
         				si t.sShapeNumber <> "" alors t.bRackAuMur = vrai
         				si t.nHauteur > 2100 _ou_ t.nLargeur > 2100 ALORS
         					t.bRackAuMur = vrai
         				FIN
         				si t.nHauteur > 850 _et_ t.nLargeur > 850 alors
         					t.bRackAuMur = vrai 
         				FIN
         				
         			FIN 
         			PROCÉDURE INTERNE ShippingSequence(t est un STorder)
         				si hlitrecherche(ClientLivraison,IDClientLivraison,t.nIdClientLivraison) alors
         					si clientlivraison.lJourCamionMaster alors
         						
         						si hlitrecherche(JourLivraisonClient,IDClientIDSaisonLivraison,[t.nIdClient,gPeriodeLivraison,0]) alors
         							t.nShippingSequence = JourLivraisonClient.ShippingSequence[DayNumber]
         						FIN
         					sinon
         						SI HLitRecherche(JourLivraisonClient,IDClientIDSaisonLivraison,[t.nIdClient,gPeriodeLivraison,t.nIdClientLivraison]) ALORS
         							t.nShippingSequence = JourLivraisonClient.ShippingSequence[DayNumber]
         						FIN
         						
         						
         					FIN
         				FIN
         				si t.nShippingSequence = 0 alors
         					trace(t.OrderNumber)
         				FIN
         				
         			FIN
         		
         			PROCÉDURE INTERNE RackLiftShipping(t est un stmasterorder)
         				SI HLitRecherche(Client,numero,t.sCustomerNumber) ALORS
         					SI Client.IDLoadingType <= 2 alors
         						
         						t.bIsRackLiftShipping = vrai
         						pour chaque stOrder de t.tabLine
         							storder.bIsRackLiftShipping = vrai
         							
         						FIN
         					SINON
         						t.bIsRackLiftShipping = faux
         						
         						
         					FIN
         				sinon
         					t.bIsRackLiftShipping = Faux
         					
         				FIN
         				
         			FIN
         		
         			PROCÉDURE INTERNE SuppressRackAuMur(t est un storder)
         				si t.bRackAuMur alors 
         					nNbThermos-=t.nQuantity
         					renvoyer Faux
         				FIN
         				renvoyer vrai	
         			FIN
         			PROCÉDURE INTERNE OnlyRackAuMur(t est un storder)
         				SI t.bRackAuMur ALORS RENVOYER vrai
         				RENVOYER faux
         			FIN
         		
         		
         //		nnbrack			= PartieEntière(nNbThermos/50) 
         		
         		
         		nCptLow		est un entier	= 1
         		nCpthigh	est un entier	= 47
         		//j			est un entier	= 1
         		nTotRack	est un entier
         		bLowHigh	est un booleen	// vrai = low
         		
         		//pour i = 1 _a_ tabRack..occurrence
         		
         		
         		
         		
         		// Boucle pour traiter les client avec Rack unique.
         		
         		// trouver tous les numéro de client qui ont un rack
         		
         		tabMasterUniqueRack.Trie(ttMembre,"nshippingsequence")
         		
         		tabCustomerWithRack est un tableau de chaînes
         		tabMasterUniqueRack.Applique(SeekUniqueCustomer)
         		
         			procédure interne SeekUniqueCustomer(stRack est un STMasterOrder)
         				nRes est un entier = tabCustomerWithRack.cherche(tcLinéaire,strack.sCustomerNumber)
         				si nres = -1 alors tabCustomerWithRack.ajoute(stRack.sCustomerNumber)
         				
         			FIN
         		
         		
         		
         		pour chaque stMasterCustomer de tamasterCustomer
         			
         			stMasterCustomer.tabAllCustomerOrder.Applique(SeekGreatestWidth)
         			stMasterCustomer.tabAllCustomerOrder.trie(ttMembre,"-nGreatestWidth")
         			tabCurrentmasterUniqueRack = stMasterCustomer.tabAllCustomerOrder
         			pour chaque stCurrentRAck de tabCurrentmasterRack
         				
         			FIN
         			
         			
         				Procédure interne checkCustomer(stMasterRack est un STMasterOrder)
         					si stMasterRack.sCustomerNumber = sCustomerWithRack alors
         						renvoyer Vrai
         					sinon
         						renvoyer Faux
         					Fin
         					
         					
         				Fin
         			
         				procédure interne SeekGreatestWidth(stMasterRack est un STMasterOrder)
         					nGreatestWidth est un entier = 0
         					pour chaque st_Order de stMasterRack.tabLine
         						nValueToCheck est un entier = st_Order.nLargeur + (24 - modulo(st_order.nlargeur,24))
         						si st_order.nLargeur > nGreatestWidth alors
         							stMasterRack.nGreatestWidth	= nvaluetocheck
         							nGreatestWidth				= nvaluetocheck
         						Fin
         						
         						
         					Fin	
         					
         					
         				fin
         			
         			cpt			= 0
         			Maxrack		= 47
         			
         			BOUCLE 
         				nRackNumber++
         				cpt=0
         				tabCurrentRack.SupprimeTout()
         				tabCurrentmasterRack.supprimetout()
         				nTotRack					= 0
         				si nRackNumber > 1 _et_ pas bnewcamion  et pas NewRackmandatory alors
         					
         					soit (nNbEmptySlot,nLowest,nHighest) = checkIfEmptySlot(nRackNumber-1)
         					si nNbEmptySlot > 0 ALORS
         						nRackNumber--
         						maxrack		= nNbEmptySlot
         						nCptLow		= nlowest
         						nCpthigh	= nhighest
         					sinon
         						maxrack		= 47	
         						nCptLow		= 23
         						nCpthigh	= 24
         					fin
         				sinon
         					Maxrack				= 47	
         					nCptLow				= 23
         					nCpthigh			= 24  
         					bNewCamion			= faux	
         					NewrackMandatory	= Faux
         				Fin
         				
         				si tabCurrentmasterUniqueRack.somme("nTotalQuantity") > maxrack alors
         					soit tabCombineResult = SetBestCombine(tabCurrentmasterUniqueRack,maxrack)
         					pour chaque sCombine  de tabcombineresult
         						cpt++
         						si val(extraitchaine(sCombine,2,tab)) = 1 alors
         							tabCurrentmasterRack.ajoute(tabCurrentmasterUniqueRack[Cpt])
         							POUR CHAQUE stLine de tabCurrentmasterUniqueRack[cpt].tabLine
         								tabCurrentRack.Ajoute(stline)
         							FIN
         							tabCurrentmasterUniqueRack[Cpt].bToSuppress = vrai
         						FIN
         						
         					FIN
         					si tabCurrentmasterRack..Occurrence = 0 alors
         						maxrack				= 47
         						nCptLow				= 23
         						nCpthigh			= 24  
         						NewrackMandatory	= vrai
         					Fin
         					
         				sinon
         					pour chaque stRack de tabCurrentmasterUniqueRack
         						cpt++
         						tabCurrentmasterRack.Ajoute(tabCurrentmasterUniqueRack[Cpt])
         						POUR CHAQUE stLine de tabCurrentmasterUniqueRack[Cpt].tabLine
         							tabCurrentRack.Ajoute(stline)
         						FIN
         						tabCurrentmasterUniqueRack[Cpt].bToSuppress = Vrai
         					FIN
         				Fin
         				
         				//		nCptLow		= 25
         				//		nCpthigh	= 26
         				//		tabCurrentRack.Trie(ttMembre,"OrderNumber;-nLargeur")
         				tabCurrentMasterRack.Trie(ttMembre,"-ngreatestWidth;-nTotalQuantity")
         				blowhigh = faux
         				
         				POUR chaque stCurrentmaster de tabCurrentmasterRack
         					blowhigh = pas blowhigh
         					stCurrentmaster.tabLine.trie(ttmembre,"-nLargeur")
         					pour z = 1 _A_ stCurrentmaster.tabline..occurrence
         						
         						//			SI EstImpair(z) ALORS
         						si bLowHigh et stcurrentmaster.tabline[z].nQuantity >  ncptlow alors
         							blowhigh = faux
         						sinon si pas bLowHigh et stcurrentmaster.tabline[z].nQuantity >  47 - ncpthigh
         							bLowHigh = vrai
         						FIN
         						si blowhigh alors
         							POUR q = 1 _a_ stcurrentmaster.tabline[z].nQuantity  
         								si ncptlow > 0 alors
         									gtaAllRack[nRackNumber].OneRack[nCptLow]								= stcurrentmaster.tabline[z].nLargeur
         									gtaAllRack[nRackNumber].OneRackHauteur[nCptLow]							= stcurrentmaster.tabline[z].nHauteur
         									stcurrentmaster.tabline[z].nRackLineNumber								= nCptLow
         									gtaAllRack[nRackNumber].tabCurrentOrder.Ajoute(stcurrentmaster.tabline[z])
         									nCptLow--
         								sinon
         									gtaAllRack[nRackNumber].OneRack[nCpthigh]								= stCurrentmaster.tabLine[z].nLargeur
         									gtaAllRack[nRackNumber].OneRackHauteur[nCpthigh]						= stCurrentmaster.tabLine[z].nHauteur
         									stCurrentmaster.tabLine[z].nRackLineNumber								= nCpthigh
         									gtaAllRack[nRackNumber].tabCurrentOrder.Ajoute(stCurrentmaster.tabLine[z])
         									nCpthigh++
         								Fin
         								gtaAllRack[nRackNumber].bIsRackLiftShipping = stCurrentmaster.bIsRackLiftShipping
         								
         							FIN
         							stcurrentmaster.tabline[z].bProcess	= Vrai
         							//					blowhigh					= faux
         						SINON
         							POUR q = 1 _a_ stcurrentmaster.tabline[z].nQuantity
         								si ncpthigh <= 47 alors
         									gtaAllRack[nRackNumber].OneRack[nCpthigh]								= stcurrentmaster.tabline[z].nLargeur
         									gtaAllRack[nRackNumber].OneRackHauteur[nCpthigh]						= stcurrentmaster.tabline[z].nHauteur
         									stcurrentmaster.tabline[z].nRackLineNumber								= nCpthigh
         									gtaAllRack[nRackNumber].tabCurrentOrder.Ajoute(stcurrentmaster.tabline[z])
         									nCpthigh++
         								sinon
         									gtaAllRack[nRackNumber].OneRack[nCptLow]								= stCurrentmaster.tabLine[z].nLargeur
         									gtaAllRack[nRackNumber].OneRackHauteur[nCptLow]							= stCurrentmaster.tabLine[z].nHauteur
         									stCurrentmaster.tabLine[z].nRackLineNumber								= nCptLow
         									gtaAllRack[nRackNumber].tabCurrentOrder.Ajoute(stCurrentmaster.tabLine[z])
         									nCptLow--
         								fin
         								gtaAllRack[nRackNumber].bIsRackLiftShipping = stCurrentmaster.bIsRackLiftShipping
         							FIN
         							stcurrentmaster.tabline[z].bProcess	= Vrai
         							//					blowhigh					= vrai
         						FIN
         					FIN
         				Fin
         				
         				//////////////////
         				// Recalculer pour avoir une demilune
         				
         				//gtaAllRack[nRackNumber]		= RecalculateRackNew(gtaAllRack[nRackNumber].tabCurrentOrder,nRackNumber)
         				gtaAllRack[nRackNumber]		= RegenerateOrderOnRack(gtaAllRack[nRackNumber].tabCurrentOrder)
         				////////////////
         				//////////////
         				gtaAllTruckrack[val(sdReqsqlCamion.NoCamion)].taAllTruckRack[nRackNumber]	= gtaAllRack[nRackNumber]	
         	           	
         	           			
         				
         				
         				
         				tabCurrentmasterUniqueRack													= tabCurrentmasterUniqueRack.filtre(Rack => Rack.bToSuppress = faux)
         				
         			À FAIRE TANTQUE tabCurrentmasterUniqueRack.Occurrence() > 0
         			
         			
         		Fin
         		
         	FIN
         FIN
         
         pour chaque stTruck,nKeytruck de gtaAllTruckrack
         	pour chaque stCurrentRAck,sKeyrack de sttruck.taAllTruckRack
         		 gtaAllTruckrack[nkeytruck].taAllTruckRack[sKeyrack] =  CenterRack(stCurrentrack)
         	FIN
         FIN
         
         
         
         imgChart is Image
         //pour i = 1 _a_ gtaAllRack..occurrence
         //	ArbreAjoute(ARBRE_Rack,"Rack"+i,aDéfaut,aDéfaut,i,aDernier,"Rack" + i)
         //	
         //	MaFenêtre..plan	= 5
         //	tabOneRack		= gtaAllRack[i].OneRack
         //	grf_rack.CouleurSérie(1,Vertfoncé)
         //	grdessine(GRF_Rack)
         //	
         //	imgChart	= grSaveImage(GRF_Rack)
         //	IMG_Graph	= IMGchart
         //	MaFenêtre..Plan	= 5
         //FIN
         
         Showrack()
         ferme(FEN_AttenteGif)
         
         CAS EXCEPTION:
         
         erreur(Exceptioninfo(errComplet))
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_Transférer
    identifier : 0x27081a1a394cdee7
    internal_properties : 
    properties :
     x : 1307
     y : 120
     width : 80
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         //sai_rack est un entier
         //saisie("transférer sur quel rack",sai_rack)
         //
         //soit (nNbSlot,nLowerSlot,nHigherslot) = checkIfEmptySlot(sai_rack)
         //
         //si nNbSlot <> 0 alors
         //	si nLowerSlot > 0 alors
         //		info("Slot : "+ nLowerSlot)
         //	sinon
         //		Info("Slot : "+ nHigherSlot)
         //	FIN
         //FIN
         
         stCurrentOrder est un storder
         nRackTo est une entier
         nTruckTo est une entier
         bCancel est un booleen
         
         (ntruckTo,nRackTo,bcancel) = ouvre(FEN_SwapRack,nNoCamion,nNoRack,gtaAllTruckrack,Faux)
         
         si bcancel alors renvoyer faux
         sRackTo est une chaine = "Rack"+nrackto
         si sRackTo = "Rack0" alors renvoyer Faux
         
         soit (NbEmptySlot,nLowest,nHighest) = checkIfEmptySlotForTransfer(ntruckto,nrackTo)
         
         si NbEmptySlot < TABLE_TabOneRack.SelectOccurrence() alors
         	erreur("Il n'y a pas assez d'espaces diponibles sur le rack demandé")
         	renvoyer faux
         FIN
         
         nRes		est un entier
         tabOrder	est un tableau d'entier
         tabOrder.SupprimeTout()
         pour i = 1 _a_ TABLE_TabOneRack.SelectOccurrence()
         	si TABLE_TabOneRack[TABLE_TabOneRack.Select(i)].COL_RackID <> 0 alors taborder.ajoute(TABLE_TabOneRack[TABLE_TabOneRack.Select(i)].COL_RackID)
         FIN
         
         pour CHAQUE nRackID de tabOrder 
              stcurrentorder = allouer un storder
              stCurrentOrder = gtaAllTruckrack[nNoCamion].taAllTruckRack[nNoRack].tabCurrentOrder[nRackID]
              
              si nLowest > 0 alors
              	stCurrentOrder.nRackLineNumber = nlowest
              	nLowest--
              sinon
         		stCurrentOrder.nRackLineNumber = nHighest
         		nhighest++
         		
              FIN
              
              gtaAllTruckrack[ntruckTo].taAllTruckRack[nRackTo].tabCurrentOrder.ajoute(stcurrentorder)
              gtaAllTruckrack[ntruckTo].taAllTruckRack[nRackTo].OneRack[stCurrentOrder.nRackLineNumber] = stCurrentOrder.nLargeur
              
         	 gtaAllTruckrack[nnocamion].taAllTruckRack[nNoRack].tabCurrentOrder[nRackID].bTodelete = vrai
         FIN
         
         TABLE_TabOneRack.SupprimeTout()
         POUR i = 1 À 47
         	TableAjouteLigne(TABLE_TabOneRack)
         	TABLE_TabOneRack[i].COL_Pos = i
         FIN
         //tabOneRack.SupprimeTout()
         //nCptline est un entier
         //
         //POUR TOUTE LIGNE DE TABLE_TabOneRack 
         //	ncptline++
         //	tabOneRack.Ajoute(COL_TabOneRack)
         //	SI COL_RackID <> 0 ALORS
         //		gtaAllTruckrack[nNoCamion].taAllTruckRack[nNoRack].tabCurrentOrder[COL_RackID].nRackLineNumber = ncptline
         //		
         //	FIN
         //FIN
         
         nCpt est un entier
         
         POUR CHAQUE st_Order DE gtaAllTruckrack[nnocamion].taAllTruckRack[nNoRack].tabCurrentOrder
         	nCpt++
         	si pas st_Order.bTodelete alors
         		TABLE_TabOneRack[st_Order.nRackLineNumber].COL_Width	= st_Order.nLargeur
         		TABLE_TabOneRack[st_Order.nRackLineNumber].COL_Height	= st_Order.nhauteur
         		TABLE_TabOneRack[st_Order.nRackLineNumber].COL_RackID		= nCpt
         		TABLE_TabOneRack[st_Order.nRackLineNumber].COL_Order		= st_Order.OrderNumber
         		TABLE_TabOneRack[st_Order.nRackLineNumber].COL_Sequence		= st_Order.nShippingSequence
         		TABLE_TabOneRack[st_Order.nRackLineNumber].COL_Customer		= st_Order.CustomerNumber
         		TABLE_TabOneRack[st_Order.nRackLineNumber].COL_Lift			= st_Order.bIsRackLiftShipping
                 
         	fin
         	
         FIN
         TABLE_TabOneRack.Affiche(taDébut)
         ExécuteTraitement(BTN_Dessine,trtClic)
         
         
        type : 18
      -
        type : 161
        enabled : false
  -
    name : CAL_Rack
    identifier : 0x270bc6a803f842e5
    internal_properties : 
    properties :
     x : 6
     y : 11
     width : 182
     height : 230
    type : 47
    code_elements :
     type_code : 100
     p_codes :
      -
        code : |1+
         BTN_getTruck..visible = faux
         si hlitrecherche(racking,RackingdateTruckNumberRackNumber,[CAL_Rack]) alors
         	BTN_getTruck..Visible = vrai
