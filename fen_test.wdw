      -
        code : |1+
         ChaineTexte est une chaine = ComplèteRep(repdonnees)+"PDF\%1%2.pdf;"
         lnomfichier est une chaine
         reqsql est une source de donnees
         txtsql est une chaine = [
         	select * from archiveemail where ArchiveEmail.lFichierAttaché like '%%%1%'
         ]
         pour TOUT Facture 
         	message(facture.fanumero)
         	MultitâcheRepeint(fen_test)
         	selon facture.fatypedocument
         		cas 1,2
         			lnomfichier = ChaîneConstruit(ChaineTexte,sansespace(facture.faclient)+"\Confirmation\Conf",facture.fanumero)
         		cas 3
         			lnomfichier = ChaîneConstruit(ChaineTexte,SansEspace(Facture.faclient)+"\Soumission\Soum",Facture.fanumero)	
         		AUTRE CAS
         			
         	FIN
         	
         	
         	si HExécuteRequêteSQL(reqsql,hRequêteDéfaut,ChaîneConstruit(txtsql,lnomfichier)) alors
         		si hnbenr(reqsql) > 0 alors
         			facture.ConfirmationSended = Vrai
         			hmodifie(facture,hnumenrencours)
         		FIN
         		
         	FIN
         	
         fin
        type : 18
      -
        type : 161
        enabled : false
