    name : recalcule_Commande
    identifier : 0x2075ac7acc233a24
    internal_properties : 
    properties :
     x : 936
     y : 665
     width : 80
     height : 42
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         prixu est un réel
         Ligneencours est un entier
         
         pour tout facture //avec "facture.faclient = 120"
         	//hlitrecherche(Facture,fanumero,"435917")
         	//si facture.fatypedocument <> 3 alors
         	message(facture.fanumero)
         	multitacherepeint()
         	si hlitrecherche(Client,numero,facture.faclient) alors
         		pour tout fdetail avec "fdetail.fdnocomm = " + facture.fanumero
         
         			Message(facture.fanumero+"-"+fdetail.fdligne)
         			si fdetail.ftype = 1 et pas fdetail.FDprixmodifie alors
         				
         				prixu  = 	CalculPrixThermos(fdetail.fdnumprod,client.IDClient,fdetail.fdcomposant1,fdetail.fdcomposant2,fdetail.fdcomposant3,fdetail.fdbase)
         //				Ligneencours = TableAjouteLigne(Table1,Facture.fanumero,Fdetail.fdcomposant1,Fdetail.fdcomposant2,Fdetail.fdcomposant3,Fdetail.fdprixupied,prixu,facture.fpreparation)
         				//			info(prixu)
         				fdetail.fdprixupied = prixu
         				fdetail.fdprixupiedfacture = prixu
         				fdetail.fdprixu = fdetail.fdpiedcarrefacture * prixu
         				fdetail.fdprixtotal = Fdetail.fdpiedcarrefacture * prixu * Fdetail.fdqte
         				fdetail.surchargeenergie = fdetail.fdprixtotal * 0.10
         				hmodifie(Fdetail,hNumEnrEnCours)
         				si facture.FPREPARATION = "B" alors
         					si hlitrecherche(hfdetail,fdnocommfdligne1,[fdetail.fdnocomm,fdetail.fdligne]) alors
         						hfdetail.fdprixupied = prixu
         						hfdetail.fdprixupiedfacture = prixu
         						hfdetail.fdprixu = hfdetail.fdpiedcarrefacture * prixu
         						hfdetail.fdprixtotal = hfdetail.fdpiedcarrefacture * prixu * hfdetail.fdqteafacturer
         						hfdetail.surchargeenergie = hfdetail.fdprixtotal * 0.10
         						HModifie(hfdetail,hNumEnrEnCours)
         					FIN
         				fin
         			fin
         		fin
         		
         		//		si facture.FPREPARATION = "B" alors
         		//			POUR TOUT hFdetail AVEC "hfdetail.fdnocomm = " + Facture.fanumero
         		//				SI hFdetail.ftype = 1 ET PAS hFdetail.FDprixmodifie ALORS
         		//					prixu  = 	CalculPrixThermos(hFdetail.fdnumprod,client.IDClient,hFdetail.fdcomposant1,hFdetail.fdcomposant2,hFdetail.fdcomposant3,hFdetail.fdbase)
         		//					hFdetail.fdprixupied = prixu
         		//					hFdetail.fdprixupiedfacture = prixu
         		//					hFdetail.fdprixu = hFdetail.fdpiedcarrefacture * prixu
         		//					hFdetail.fdprixtotal = hFdetail.fdpiedcarrefacture * prixu * hFdetail.fdqteafacturer
         		//					hFdetail.surchargeenergie = hFdetail.fdprixtotal * 0.10
         		//					HModifie(hFdetail,hNumEnrEnCours)
         		//				FIN
         		//			FIN	
         		//		FIN
         	fin
         fin
         
         info("Recalcul terminé")
