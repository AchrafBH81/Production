  -
    name : ListeFichier
    identifier : 0x2a8dd10639be7554
    internal_properties : 
    properties :
     x : 16
     y : 36
     width : 80
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         //soit FtpHost = "ftp://influencefx.ddns.net"
         //
         //soit FtpUsername = "trn"
         //soit FtpPassword = "trn123"
         //soit FtpFolderRoot = "/Sandbox/Suppliers/ThermosRiveNord/"
         
         //FtpHost est une chaîne UNICODE = "ftp://prod1.seigma.com"
         //FtpUsername est une chaîne UNICODE = "basco-trn"
         //FtpPassword est une chaîne UNICODE = "hJ6ef7p3ZLj3"
         FtpHost		est une chaîne UNICODE	= gclConfig.m_sBascoFTPAddress
         FtpUsername	est une chaîne UNICODE	= gclConfig.m_sBascoUser
         FtpPassword	est une chaîne UNICODE	= gclConfig.m_sBascoPassword
         
         FtpFolderRoot est une chaîne UNICODE = "/"
         
         tabPurchaseOrderBasco est un tableau de PurchaseOrderBasco
         
         
         _listeFichier est une chaine
         _fichier est une chaine
         ResConnexionFtp est un entier = ftpconnecte(FtpHost,FtpUsername,FtpPassword)
         po est un PurchaseOrderBasco
         frepcree(ComplèteRep(fRepEnCours())+"Ftp")
         
         FTPRécupère(ResConnexionFtp,FtpFolderRoot+"PurchaseOrder/Open",completerep(frepencours())+"Ftp")
         _listeFichier = fListeFichier(ComplèteRep(fRepEnCours())+"Ftp\*.*")
         
         POUR TOUTE CHAÎNE UnFichier DE _listeFichier SEPAREE PAR RC
         po = allouer un PurchaseOrderBasco()
         _fichier = fChargeTexte(UnFichier)
         désérialise(po,_fichier,psdJSON)
         tableauajoute(tabPurchaseOrderBasco,po)
         
         	// Ajout du fichier dans la table TABLE_TableFic
         	
         FIN
         //info(FTPListeFichier(ResConnexionFtp,"/Sandbox/Suppliers/ThermosRiveNord/PurchaseOrder/Open",ListeFichier,ftpFichier))
         
         
         
         
