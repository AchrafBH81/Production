         pour tout client
         		POUR j = 1 À 4
         		si SansEspace(Client.ccourrielBonLivraison[j]) = "jpierre@thermosrn.ca" ALORS Client.ccourrielBonLivraison[j] = "mandre@thermosrn.ca"
         		si SansEspace(Client.ccourrielConfirmation[j]) = "jpierre@thermosrn.ca" ALORS Client.ccourrielconfirmation[j] = "mandre@thermosrn.ca"
         		si SansEspace(Client.ccourrielfacture[j]) = "jpierre@thermosrn.ca" ALORS Client.ccourrielfacture[j] = "mandre@thermosrn.ca"
         		si SansEspace(Client.CourrielListePrix[j]) = "jpierre@thermosrn.ca" ALORS Client.CourrielListePrix[j] = "mandre@thermosrn.ca"
         	FIN
         	hmodifie(Client,hNumEnrEnCours)
         	message(client.nom)
         FIN
