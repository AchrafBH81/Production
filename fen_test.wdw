  -
    name : Majuscules_Notes
    identifier : 0x2a8cc32300c63b7e
    internal_properties : 
    properties :
     x : 274
     y : 385
     width : 80
     height : 45
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         //info(loaddll("Ifx.Engine.Edi.dll"))
         pour CHAQUE Fdetail 
         	si fdetail.FDJOBLIGNE <> "" alors
         		fdetail.FDJOBLIGNE = majuscule(fdetail.FDJOBLIGNE)
         	FIN
         	SI Fdetail.Fnotes <> "" ALORS
         		Fdetail.Fnotes = Majuscule(Fdetail.Fnotes)
         	FIN
         	SI Fdetail.fnotes1 <> "" ALORS
         		Fdetail.fnotes1 = Majuscule(Fdetail.fnotes1)
         	FIN
         	hmodifie(Fdetail,hNumEnrEnCours)
         	message(fdetail.fdnocomm)
         FIN
         
         
         
         
          
          
         
         
         
         
         
         
         
         
         
         
         
