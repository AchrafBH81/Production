    name : BTN_Récupérer_bon_de_livraison_épurés
    identifier : 0x2a2c08bd2dc908d3
    internal_properties : 
    properties :
     x : 132
     y : 212
     width : 238
     height : 52
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         BonLivraisonH	est une source de donnees	<description = bonlivraison>
         HfactureH		est une source de donnees	<description = hfacture>
         HfdetailH		est une source de donnees	<description = hfdetail>
         halias(BonLivraison,BonLivraisonH)
         halias(hfacture,HfactureH)
         halias(hfdetail,HfdetailH)
         hchangerep(BonLivraisonH,".\BonLivraisonOld")
         hchangenom(BonLivraisonH,"BonLivraison")
         hchangerep(HfactureH,".\BonLivraisonOld")
         
         hchangerep(HfdetailH,".\BonLivraisonOld")
         hchangenom(HfactureH,"hfacture")
         hchangenom(HfdetailH,"hfdetail")
         
         houvre(BonLivraisonH)
         houvre(HfactureH)
         houvre(HfdetailH)
         
         
         
         
         
         HLitRecherchepremier(BonLivraisonH,Bnumero,16599)
         hgeredoublon(hfdetail,fdcle,faux)
         BOUCLE 
         	message(BonLivraisonH.bnumero)
         	MultitâcheRepeint(mafenetre)
         	HCopieEnreg(BonLivraison,BonLivraisonH)
         	hajoute(BonLivraison)
         	si hlitrecherche(HfactureH,Bnumero,BonLivraisonH.bnumero) alors
         		HCopieEnreg(hfacture,HfactureH)
         		HAjoute(hfacture)
         		hlitrecherchepremier(HfdetailH,HFCLEUNIK,HfactureH.HFCLEUNIK)		
         		BOUCLE 
         //          si hlitrecherche(hfdetail,fdcle,[HfdetailH.fdnofact,HfdetailH.fdnocomm,HfdetailH.fdligne]) alors
         //          	trace(HfdetailH.H0CLEUNIK,hfdetail.H0CLEUNIK)			
         //          FIN
         
                   
         			HCopieEnreg(Hfdetail,HfdetailH)
         			hfdetail.HFCLEUNIK = hfacture.HFCLEUNIK
         			hajoute(hfdetail)     
         			hlitsuivant(HfdetailH,HFCLEUNIK)          
         		a faire tantque HfdetailH.hfcleunik = HfactureH.hfcleunik
         		
         	FIN
         	hlitsuivant(BonLivraisonH,bnumero)
         	
         À FAIRE TANTQUE BonLivraisonH.Bnumero < 180610
         
         info("termine")
         
         
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_Supprimer_les_facture_orpheline_de_bon_de_livraison
