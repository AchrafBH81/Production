      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure checkIfEmptySlotForTransfer(nTruckNumber est un entier,NoRack est un entier)
      
      nCPT est une entier
      nLowestEmpty est un entier
      nHighestEmpty est un entier
      
      pour i = 1 a 47
         si gtaAllTruckrack[ntruckNumber].taAllTruckRack[norack].OneRack[i]	= 0 alors
           si i < 23 alors
           	
           		nlowestempty = i
           	
           sinon
      			
      				si nHighestEmpty = 0 alors nHighestEmpty = i
      			
           FIN
           ncpt++
         fin
         	
       FIN
      
      renvoyer (ncpt,nLowestEmpty,nHighestEmpty)
     type : 458752
   -
     name : Showrack
     procedure_id : 1663237595941975896
     type_code : 14
     code : |1-
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //Showrack ( [<bDraw> est booléen])
      //
      // Paramètres :
      // 	bDraw (booléen - valeur par défaut=1) : <indiquez ici le rôle de bDraw>
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      // 	imgChart : <indiquez ici le rôle de imgChart>
      procédure Showrack(bDraw est un booleen = vrai)
      
      
      ARBRE_Rack.SupprimeTout()
      POUR CHAQUE stTruckRack,sCle de gtaAllTruckrack
      	POUR CHAQUE stRack,sClerack de stTruckRack.taAllTruckRack
      		
      		ArbreAjoute(ARBRE_Rack,"Camion"+sansespace(sCle)+TAB+"Rack"+sClerack,aDéfaut,aDéfaut,sClerack,aDernier,"Rack" + sClerack)
      		MaFenêtre..Plan	= 5
      		si bdraw alors
      			tabOneRack		<= strack.OneRack
      			GRF_Rack.CouleurSérie(1,VertFoncé)
      			grDessine(GRF_Rack)
      		fin		
      		//		imgChart		= grSaveImage(GRF_Rack)
      		//		IMG_Graph		= imgChart
      		MaFenêtre..Plan	= 5
      	FIN
      FIN
      
      soit bRes = ARBRE_Rack.SelectPlus("Camion1"+TAB+"Rack1")
      ExécuteTraitement(ARBRE_Rack,trtSélection)
      MaFenêtre..Plan = 5
     type : 458752
   -
     name : FillrackAuMur
     procedure_id : 1664126645581169781
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //FillrackAuMur (<nNoCamion> est entier)
      //
      // Paramètres :
      //	nNoCamion (entier) : <indiquez ici le rôle de nNoCamion>
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure FillrackAuMur(nNoCamion est un entier)
      
      TABLE_RackAuMur.SupprimeTout()
      nCurrentLine est un entier
      
      pour chaque stOrder de gtaAllTruckrack[nNoCamion].tabRackAuMur
      	
      	ncurrentline = TABLE_RackAuMur.ajouteligne()
      	TABLE_RackAuMur[nCurrentLine].COL_CustomerNumber =storder.CustomerNumber
      	TABLE_RackAuMur[nCurrentLine].COL_OrderNumber =storder.OrderNumber
      	TABLE_RackAuMur[nCurrentLine].COL_Width =storder.nLargeur
      	TABLE_RackAuMur[nCurrentLine].COL_height =storder.nHauteur
      	TABLE_RackAuMur[nCurrentLine].COL_shape =storder.sShapeNumber
      	
      FIN
     type : 458752
   -
     name : RecalculateRackNew
     procedure_id : 1664440586197015797
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] RecalculateRackNew (<tabCurrentrack> est tableau (stOrder), <nRackNumber> est entier)
      //
      // Paramètres :
      //	tabCurrentrack (tableau (stOrder)) : <indiquez ici le rôle de tabCurrentrack>
      //	nRackNumber (entier) : <indiquez ici le rôle de nRackNumber>
      
      // Valeur de retour :
      // 	STAllrack : <indiquez ici le rôle de la valeur de retour>
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure RecalculateRackNew(tabCurrentrack est un tableau de storder,nRackNumber est un entier)
      
      stCurrentAllRack	est un stallrack
      
      
      nCptLow				est un entier		= 23
      nCpthigh			est un entier		= 24
      tabCurrentRack.Trie(ttMembre,"-nLargeur;nhauteur")
      bLowHigh est un booleen = Vrai
      POUR z = 1 _À_ tabCurrentRack..Occurrence
      	SI bLowHigh ET tabCurrentRack[z].nQuantity >  nCptLow ALORS
      		bLowHigh = Faux
      	SINON SI PAS bLowHigh ET tabCurrentRack[z].nQuantity >  47 - nCpthigh
      		bLowHigh = Vrai
      	FIN	
      	SI bLowHigh ALORS
      		
      		
      		si ncptlow > 0 alors
      			stCurrentAllRack.OneRack[nCptLow]								= tabCurrentRack[z].nLargeur
      			stCurrentAllRack.OneRackHauteur[nCptLow]						= tabCurrentRack[z].nHauteur
      			tabCurrentRack[z].nRackLineNumber								= nCptLow
      			stCurrentAllRack.tabCurrentOrder.Ajoute(tabCurrentRack[z])
      			nCptLow--
      		sinon
      			stCurrentAllRack.OneRack[nCpthigh]								= tabCurrentrack[z].nLargeur
      			stCurrentAllRack.OneRackHauteur[nCpthigh]						= tabCurrentrack[z].nHauteur
      			tabCurrentrack[z].nRackLineNumber								= nCpthigh
      			stCurrentAllRack.tabCurrentOrder.Ajoute(tabCurrentrack[z])
      			nCpthigh++
      		fin
      		
      		
      		tabCurrentRack[z].bProcess	= Vrai
      		bLowHigh					= Faux
      	SINON
      		
      		SI nCpthigh <= 47 ALORS
      			stcurrentallrack.OneRack[nCpthigh]								= tabCurrentRack[z].nLargeur
      			stCurrentAllRack.OneRackHauteur[nCpthigh]						= tabCurrentRack[z].nHauteur
      			tabCurrentRack[z].nRackLineNumber								= nCpthigh
      			stcurrentallrack.tabCurrentOrder.Ajoute(tabCurrentRack[z])
      			nCpthigh++
      		sinon
      			stCurrentAllRack.OneRack[nCptLow]								= tabCurrentrack[z].nLargeur
      			stCurrentAllRack.OneRackHauteur[nCptLow]						= tabCurrentrack[z].nHauteur
      			tabCurrentrack[z].nRackLineNumber								= nCptLow
      			stCurrentAllRack.tabCurrentOrder.Ajoute(tabCurrentrack[z])
      			nCptLow--
      		fin
      		
      		
      		tabCurrentRack[z].bProcess	= Vrai
      		bLowHigh					= Vrai
      		
      	FIN
      FIN
      
      
      renvoyer stcurrentallrack
      
      
     type : 458752
   -
     name : RegenerateOrderOnRack
     procedure_id : 1664753423553824791
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] RegenerateOrderOnRack (<tabCurrentOrder> est tableau (stOrder))
      //
      // Paramètres :
      //	tabCurrentOrder (tableau (stOrder)) : <indiquez ici le rôle de tabCurrentOrder>
      // Valeur de retour :
      // 	STAllrack : <indiquez ici le rôle de la valeur de retour>
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure RegenerateOrderOnRack(tabCurrentOrder est un tableau de storder)
      
      stCurrentmaster est un STMasterOrder
      bLowHigh est un booleen
      nCptlow est un entier
      nCpthigh est un entier
      stAllRAck est un STAllrack
      nOldWidth est un entier
      
      
      pour chaque stCurrentOrder de tabCurrentOrder
      	nRes est un entier =  stCurrentmaster.tabLine.cherche(tcLinéaire,"OrderNumber;nOrderDetailLine",stcurrentorder.OrderNumber,stCurrentOrder.nOrderDetailLine) 
      	si nres <> -1 alors
      		stCurrentmaster.tabLine[nres].nQuantity += 1
      	sinon
      			stCurrentOrder.nQuantity = 1
      			stCurrentmaster.tabLine.Ajoute(stCurrentOrder)
      	FIN
      FIN
      
      nCptLow				= 23
      nCpthigh			= 24 
      
      
      	stCurrentmaster.tabLine.Trie(ttMembre,"-nLargeur")
      	POUR z = 1 _A_ stCurrentmaster.tabline..occurrence
      	si nOldWidth <> stCurrentmaster.tabLine[z].nLargeur alors
      		 bLowHigh = PAS bLowHigh
      	     
      	FIN
      		nOldWidth = stCurrentmaster.tabLine[z].nLargeur
      		
      		//			SI EstImpair(z) ALORS
      		SI bLowHigh ET stCurrentmaster.tabLine[z].nQuantity >  nCptLow ALORS
      			bLowHigh = Faux
      		SINON SI PAS bLowHigh ET stCurrentmaster.tabLine[z].nQuantity >  47 - nCpthigh
      			bLowHigh = Vrai
      		FIN
      		SI bLowHigh ALORS
      			POUR q = 1 _a_ stCurrentmaster.tabline[z].nQuantity  
      				SI nCptLow > 0 ALORS
      					stallrack.OneRack[nCptLow]								= stCurrentmaster.tabLine[z].nLargeur
      					stAllRack.OneRackHauteur[nCptLow]							= stCurrentmaster.tabLine[z].nHauteur
      					stCurrentmaster.tabLine[z].nRackLineNumber								= nCptLow
      					stAllRack.tabCurrentOrder.Ajoute(stCurrentmaster.tabLine[z])
      					nCptLow--
      				SINON
      					stAllRack.OneRack[nCpthigh]								= stCurrentmaster.tabLine[z].nLargeur
      					stAllRack.OneRackHauteur[nCpthigh]						= stCurrentmaster.tabLine[z].nHauteur
      					stCurrentmaster.tabLine[z].nRackLineNumber								= nCpthigh
      					stAllRack.tabCurrentOrder.Ajoute(stCurrentmaster.tabLine[z])
      					nCpthigh++
      				FIN
      				stAllRack.bIsRackLiftShipping = stCurrentmaster.bIsRackLiftShipping
      				
      			FIN
      			stCurrentmaster.tabLine[z].bProcess	= Vrai
      			//					blowhigh					= faux
      		SINON
      			POUR q = 1 _a_ stCurrentmaster.tabline[z].nQuantity
      				SI nCpthigh <= 47 ALORS
      					stAllRack.OneRack[nCpthigh]								= stCurrentmaster.tabLine[z].nLargeur
      					stAllRack.OneRackHauteur[nCpthigh]						= stCurrentmaster.tabLine[z].nHauteur
      					stCurrentmaster.tabLine[z].nRackLineNumber								= nCpthigh
      					stAllRack.tabCurrentOrder.Ajoute(stCurrentmaster.tabLine[z])
      					nCpthigh++
      				SINON
      					stAllRack.OneRack[nCptLow]								= stCurrentmaster.tabLine[z].nLargeur
      					stAllRack.OneRackHauteur[nCptLow]							= stCurrentmaster.tabLine[z].nHauteur
      					stCurrentmaster.tabLine[z].nRackLineNumber								= nCptLow
      					stAllRack.tabCurrentOrder.Ajoute(stCurrentmaster.tabLine[z])
      					nCptLow--
      				FIN
      				stAllRack.bIsRackLiftShipping = stCurrentmaster.bIsRackLiftShipping
      			FIN
      			stCurrentmaster.tabLine[z].bProcess	= Vrai
      			//					blowhigh					= vrai
      		FIN
      	FIN
      
      
      
      
      renvoyer stallrack
      
     type : 458752
   -
     name : CenterRack
     procedure_id : 1665498887622030321
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] CenterRack (<stCurrentrack> est STAllrack)
      //
      // Paramètres :
      //	stCurrentrack (STAllrack) : <indiquez ici le rôle de tabCurrentrack>
      // Valeur de retour :
      // 	STAllrack : <indiquez ici le rôle de la valeur de retour>
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure CenterRack(stCurrentrack est un stallrack)
      
      TABLE_CenterRack.supprimetout()
      pour i = 1 a 47
      	TABLE_CenterRack.AjouteLigne()
      FIN
      pour chaque stCurrentOrder,nKeyOrder de  stCurrentrack.tabCurrentOrder
         si stcurrentorder.nRackLineNumber <> 0 alors
            TABLE_CenterRack[stCurrentOrder.nRackLineNumber].COL_Width = stCurrentOrder.nLargeur
      		TABLE_CenterRack[stCurrentOrder.nRackLineNumber].COL_RackID = nKeyOrder
      		
         FIN
         	
         		
      	
      	
      	
      FIN
      
      
      
      nLowEmptyCell	est un entier = 0
      nHighEmptyCell	est un entier = 48
      nStartingCell	est un entier
      cpt				est un entier
      nCptEmptyCell	est un entier 
      
      
      
      
      pour i = 1 a 23
      	si TABLE_CenterRack[i].COL_Width = 0 alors
      		nLowEmptyCell = i
      	sinon
      		sortir
      	FIN
      FIN
      POUR i = 47 a 24 pas -1
      	nCptEmptyCell++
      	SI TABLE_CenterRack[i].COL_Width = 0 ALORS
      		nhighEmptyCell = i
      		
      	SINON
      		SORTIR
      	FIN
      FIN
      
      si ((48-nHighEmptyCell)-nLowEmptyCell )/2 < 0 alors
      	nStartingCell = Arrondisupérieur(((48-nHighEmptyCell)-nLowEmptyCell )/2)
      sinon
      	nStartingCell =  Arrondiinférieur(((48-nHighEmptyCell)-nLowEmptyCell )/2)
      FIN
      
      si nStartingCell <> 0 alors
      	
      	si nStartingCell > 0 alors
      		pour i = nHighEmptyCell-1 _a_ nLowEmptyCell+1 pas -1
      			TABLE_CenterRack.DéplaceLigne(i, i+nStartingCell,tdDéplace) 
      		FIN
      	sinon
      		POUR i = nLowEmptyCell+1 _a_ nHighEmptyCell-1 
      			TABLE_CenterRack.DéplaceLigne(i, i+nStartingCell,tdDéplace) 
      		FIN
      		
      	fin
      	
      	tabOneRack.SupprimeTout()
      	POUR TOUTE LIGNE DE TABLE_CenterRack 
      		cpt++
      		tabOneRack.Ajoute(TABLE_CenterRack.COL_Width)
      		SI TABLE_CenterRack.COL_RackID <> 0 ALORS
      			//		nRes est un entier = gtaAllRack[SAI_SansNom1].tabCurrentOrder.cherche(tcLinéaire,"nRackLineNumber",COL_RackID)
      			//		si nres <> -1 alors
      			stCurrentrack.tabCurrentOrder[TABLE_CenterRack.COL_RackID].nRackLineNumber = cpt
      //			gtaAllRack[SAI_SansNom1].tabCurrentOrder[COL_RackID].nRackLineNumber = cpt
      			//		Fin
      			
      		FIN
      	FIN
      
      fin
      
      renvoyer stCurrentrack
      
      
      
     type : 458752
