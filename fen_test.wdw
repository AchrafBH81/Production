    internal_properties : 
    properties :
     x : 890
     y : 404
     width : 80
     height : 50
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         pour TOUT BonLivraison avec "bfacture = 0"
         	si HLitRecherche(hfacture,fanofacture,bonlivraison.bnumero)
         		POUR TOUT hFdetail AVEC "HFCLEUNIK = "+hfacture.HFCLEUNIK
         			SI hFdetail.ftype = 1 ALORS
         				
         				SELON hFacture.facalcul
         					CAS 1
         						SI SansEspace(hFdetail.fdforme) <> "" _OU_ (Arrondi(InchFractionToMillimeter(hFdetail.fdlargeura)) > 850 _ET_ Arrondi(InchFractionToMillimeter(hFdetail.fdhauteura)) > 850)   ALORS
         							hFdetail.ExceptionForShippingBill =  Vrai
         						FIN
         						
         					CAS 2
         						SI SansEspace(hFdetail.fdforme) <> "" _OU_ (Val(hFdetail.fdlargeura) > 850 _ET_ Val(hFdetail.fdhauteura) > 850) ALORS
         							hFdetail.ExceptionForShippingBill =  Vrai
         						FIN
         						
         					AUTRE CAS
         						
         				FIN
         				HModifie(hFdetail,hNumEnrEnCours)
         			FIN
         			message(hfdetail.fdnocomm)
         			multitacherepeint()
         		fin
         	fin
         	
         fin
        type : 18
      -
        type : 161
        enabled : false
