  -
    name : Envoi_confirmation
    identifier : 0x2a90094c563140d8
    internal_properties : 
    properties :
     x : 26
     y : 66
     width : 80
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         //FtpHost est une chaine unicode = "ftp://influencefx.ddns.net"
         //FtpUsername est une chaine unicode = "trn"
         //FtpPassword est une chaine unicode = "trn123"
         //FtpFolderRoot est une chaine unicode = "/Sandbox/Suppliers/ThermosRiveNord/"
         
         //FtpHost est une chaîne UNICODE = "ftp://prod1.seigma.com"
         //FtpUsername est une chaîne UNICODE = "basco-trn"
         //FtpPassword est une chaîne UNICODE = "hJ6ef7p3ZLj3"
         FtpHost		est une chaîne UNICODE	= gclConfig.m_sBascoFTPAddress
         FtpUsername	est une chaîne UNICODE	= gclConfig.m_sBascoUser
         FtpPassword	est une chaîne UNICODE	= gclConfig.m_sBascoPassword
         
         FtpFolderRoot est une chaîne UNICODE = "/"
         reqsql est un sources de donnees
         txtsql est une chaîne
         NoLigne est un entier
         SubTotInvoice est un reel
         tableautaxe = trouvetauxtaxe("139",datesys())
         
         //
         //
         //tabPurchaseOrder est tableau dynamique de PurchaseOrderDTo
         //tabPurchaseOrderBasco est un tableau de PurchaseOrderbasco
         //
         //po est un PurchaseOrderDto
         //ponet est un PurchaseOrderDto
         //po1 est un PurchaseOrderBasco
         ////_item est un PurchaseOrderItemBasco
         //_Purchaseorder est un PurchaseOrderBasco
         //cpt est un entier
         //cptItem est un entier
         //Buf est un buffer
         //
         //_tabTestPurchase est un "List<PurchaseorderDTo>"
         //
         ////po.BascoFranchise = "Ceci est un test"
         ////po.EdiKey = DonneGUID()
         ////ajoute(tabPurchaseOrder,po)
         //
         //
         //
         //
         //_get est un PurchaseorderProcessor(FtpHost,FtpUsername,FtpPassword,FtpFolderRoot+"PurchaseOrder/") 
         //_tabTestPurchase.AddRange(_get.get())
         //cpt = _tabTestPurchase.get_count()
         //
         ////info(_tabTestPurchase.get_Count())
         //
         //PUOR est un PurchaseOrderDto 
         //PI est un PurchaseOrderItemDto
         //pour i = 0 a cpt
         //	
         //	PUOR <- _tabTestPurchase.get_Item(i)
         //	info(PUOR.Display)
         //	cptItem = PUOR.PurchaseOrderItems.get_count()
         //	
         //	pour ii = 0 a cptItem
         //		PI  <- PUOR.PurchaseOrderItems.get_Item(ii)
         //		Info(PI.PurchaseOrderItemId)
         //		
         //		
         //		
         //	FIN
         //FIN
         //
         //
         //
         //
         //
         //
         //
         //POUR CHAQUE _po de _get.get()
         //	//  ajoute(tabPurchaseOrder,null)		
         //	//  cpt = TableauOccurrence(tabPurchaseOrder)
         //	//  tabPurchaseOrder[cpt] <- _po
         //	_Purchaseorder = allouer un PurchaseOrderBasco()
         //	TransfertPo(_Purchaseorder,_po)
         //	Ajoute(tabPurchaseOrderBasco,_Purchaseorder)
         //	
         //FIN
         //
         //
         //
         //
         //
         //
         ////tabPurchaseOrder = _get.get()
         //
         //
         //
         //
         //
         //
         //
         
         NoCommande est une chaine
         Saisie("Numéro de commande",NoCommande)
         
         
         
         
         confirm est un PurchaseConfirmationDto
         
         
         
         
         
         _WriteConfirm est un PurchaseConfirmationProcessor(FtpHost,FtpUsername,FtpPassword,FtpFolderRoot+"PurchaseConfirmation/") 
         
         //_Purchaseorder1 est un PurchaseOrderbasco = tabPurchaseOrderBasco[1]
         //_Confirmationdetail est un PurchaseConfirmationItemDto 
         
         //tabConfDetail est un tableau de PurchaseConfirmationItemDto
         tabtest est un "List<PurchaseConfirmationItemDto>"
         
         _date est un dateheure
         
         
         
         //confirm.BillingCity = _Purchaseorder1.BillingCity
         //confirm.BillingCountry = _Purchaseorder1.BillingCountry
         //confirm.BillingPostalCode = _Purchaseorder1.BillingPostalCode
         //confirm.BillingState = _Purchaseorder1.BillingState
         //confirm.BillingStreet = _Purchaseorder1.BillingStreet
         //confirm.Display = _Purchaseorder1.Display
         //confirm.EdiKey = _Purchaseorder1.EdiKey
         //confirm.PurchaseOrderId = _Purchaseorder1.PurchaseOrderId
         //
         //
         ////_Confirmationdetail.Description = "Test de confirmation"
         //_Confirmationdetail.PurchaseOrderId = confirm.PurchaseOrderId
         //_Confirmationdetail.PurchaseOrderItemId = _Purchaseorder1.PurchaseOrderItems[1].PurchaseOrderItemId
         ////_Confirmationdetail.SquareFootPrice = 5
         SI HLITRECHERCHE(FACTURE,fanumero,NoCommande) ALORS
         	hlitrecherche(client,numero,facture.faclient)
         	confirm.BillingCity = client.Cville
         	confirm.BillingCountry = "Canada"
         	confirm.BillingPostalCode = client.cCodePostal
         	confirm.BillingState = "Québec"
         	confirm.BillingStreet = client.crue
         	confirm.Display = facture.fanocommande
         	confirm.EdiKey = facture.IdEdiKey
         	confirm.PurchaseOrderId = facture.IdPurchaseOrderEdi
         	confirm.Shippingstreet = facture.lRue
         	confirm.shippingcity = facture.lVille
         	confirm.ShippingPostalCode = facture.lCodePostal
         	confirm.ShippingCountry = "Canada"
         	confirm.ShippingState = "Québec"
         	confirm.SubTotal = facture.fatotal
         	confirm.ReferenceNumber = facture.fanumero
         	_date = ChaîneVersDate(Facture.FDATEREQUISE,"AAAAMMJJ")
         	confirm.etadate = _date
         	txtsql = [
         	select  distinct IDPurchaseOrderItemEdi,fdligneedi,fdqte,ffini,
         	fdespace,fdnumcarr,fdhauteura,fdlargeura,fdcarreauh,fdcarreauv,
         	fnopeintureinterieure,fnopeintureexttout
         	 from fdetail 
         	where fdetail.fdnocomm = %1 and fdetail.ftype = 1
         	]
         	txtsql = ChaîneConstruit(txtsql,NoCommande)
         	
         HExécuteRequêteSQL(reqsql,hRequêteDéfaut,txtsql)
         
         
         	pour tout reqsql
         		_Confirmationdetail est un PurchaseConfirmationItemDto 
         		NoLigne = reqsql.fdligneedi
         		_Confirmationdetail.PurchaseOrderId = confirm.PurchaseOrderId
         		_Confirmationdetail.PurchaseOrderItemId = reqsql.IDPurchaseOrderItemEdi
         		_Confirmationdetail.UnitCost = CalculPrixLigne(val(NoCommande),NoLigne)
         		SubTotInvoice+= _Confirmationdetail.UnitCost
         		_Confirmationdetail.Quantity = reqsql.fdqte
         		_Confirmationdetail.Finish = reqsql.ffini
         		_Confirmationdetail.Spacer = reqsql.fdespace
         		_Confirmationdetail.GrillSupplierCode = reqsql.fdnumcarr
         		_Confirmationdetail.Height = reqsql.fdhauteura
         		_Confirmationdetail.Width = reqsql.fdlargeura
         		_Confirmationdetail.GrillHeight = reqsql.fdcarreauh
         		_Confirmationdetail.GrillBase = reqsql.fdcarreauv
         		_Confirmationdetail.GrillInteriorColor = reqsql.fnopeintureinterieure
         		_Confirmationdetail.GrillExteriorColor = reqsql.fnopeintureexttout
         		
         		tabtest.add(_Confirmationdetail)
         		
         	fin
         fin
         
         
         confirm.SubTotal = SubTotInvoice
         TotalTVH est un reel = Arrondi((confirm.SubTotal) * val(tableautaxe[1,2]) / 100,2)
         TotalTVQ est un reel = Arrondi((confirm.SubTotal+(tableautaxe[2,4] ? TotalTVH SINON 0)) * val(tableautaxe[2,2]) / 100,2)
         GrandTotal est un reel = confirm.SubTotal + TotalTVH + TotalTVQ
         confirm.TPS = TotalTVH
         confirm.TVQ = TotalTVQ
         confirm.Total = GrandTotal
         
         	 
         
         
         
         //confirm.BillingCity = _Purchaseorder1.BillingCity
         //confirm.BillingCountry = _Purchaseorder1.BillingCountry
         //confirm.BillingPostalCode = _Purchaseorder1.BillingPostalCode
         //confirm.BillingState = _Purchaseorder1.BillingState
         //confirm.BillingStreet = _Purchaseorder1.BillingStreet
         //confirm.Display = _Purchaseorder1.Display
         //confirm.EdiKey = _Purchaseorder1.EdiKey
         //confirm.PurchaseOrderId = _Purchaseorder1.PurchaseOrderId
         //
         //
         ////_Confirmationdetail.Description = "Test de confirmation"
         //_Confirmationdetail.PurchaseOrderId = confirm.PurchaseOrderId
         //_Confirmationdetail.PurchaseOrderItemId = _Purchaseorder1.PurchaseOrderItems[1].PurchaseOrderItemId
         ////_Confirmationdetail.SquareFootPrice = 5
         ////_Confirmationdetail.Description = "Test de confirmation"
         //_Confirmationdetail.PurchaseOrderId = confirm.PurchaseOrderId
         //_Confirmationdetail.PurchaseOrderItemId = _Purchaseorder1.PurchaseOrderItems[1].PurchaseOrderItemId
         //_Confirmationdetail.SquareFootPrice = 5
         //tabtest.add(_Confirmationdetail)
         
         
         
         
         
         confirm.set_PurchaseConfirmationItems(tabtest)
         
         
         
         
         
         
         
         
         
         
         
         _WriteConfirm.Put(confirm)
         
         
         
         
         
         
         
         
         
         
         //tabPurchaseOrder = _get.get()
         
         
         
         
         
         
