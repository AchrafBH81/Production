      -
        type : 262
        enabled : false
      -
        code : |1+
         
         //On commence le DND
         //On mémorise le numéro de ligne que l'on veut déplacer
         //nLigneADeplacer = MoiMême
         
        type : 101
      -
        code : |1-
         
         //On récupère le numéro de ligne du curseur pour savoir où l'utilisateur veut lâcher sa ligne 
         //nNouvelleLigne est un entier = MoiMême.InfoXY(tiNumLigne,SourisPosX(spChamp), SourisPosY(spChamp))
         //
         ////Et on déplace la ligne 
         //MoiMême.DéplaceLigne( nLigneADeplacer, nNouvelleLigne, tdDéplace)
         //tabOneRack.Déplace(nLigneADeplacer,nNouvelleLigne)
         cpt est un entier
         
         tabOneRack.SupprimeTout()
         pour toute ligne de TABLE_TabOneRack 
         	cpt++
         	tabOneRack.ajoute(COL_Width)
         	si COL_RackID <> 0 alors
         //		nRes est un entier = gtaAllRack[SAI_SansNom1].tabCurrentOrder.cherche(tcLinéaire,"nRackLineNumber",COL_RackID)
         //		si nres <> -1 alors
         //		gtaAllRack[SAI_SansNom1].tabCurrentOrder[COL_RackID].nRackLineNumber = cpt
         		gtaAllTruckrack[nNoCamion].taAllTruckRack[nNoRack].tabCurrentOrder[COL_RackID].nRackLineNumber = cpt
         //		Fin
         		
         	fin
         FIN
         POUR i = 1 À TABLE_TabOneRack..Occurrence
         	TABLE_TabOneRack[i].COL_Pos = i
         FIN
         ExécuteTraitement(BTN_Dessine,trtclic)
        type : 106
      -
        code : |1+
         //Changement du curseur pendant le survol pour montrer le DND en cours à l'utilisateur 
         //DnDCurseur(dndDéplacer)
        type : 103
      -
        type : 222
        enabled : false
      -
        type : 223
        enabled : false
      -
        type : 224
        enabled : false
  -
    name : BTN_Recupere
    identifier : 0x26f4a0aa0cef6a16
    internal_properties : 
    properties :
     x : 1312
     y : 81
     width : 80
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         nNoCamion	= Milieu(extraitchaine(SAI_SansNom1,1,tab),7)
         nNoRack		= milieu(ExtraitChaîne(SAI_SansNom1,2,tab),5)
         
         si nnorack = 0 ou nnocamion = 0 alors renvoyer vrai
         MaFenêtre..Plan	= 5
         //gtabCurrentRackAdjustment <- gtaAllRack[SAI_SansNom1].tabCurrentOrder
         gtabCurrentRackAdjustment <- gtaAlltruckrack[nNoCamion].taAllTruckRack[nnorack].tabCurrentOrder
         
         bIsLift est un booleen = gtaAllRack[SAI_SansNom1].bIsRackLiftShipping
         
         TABLE_TabOneRack.SupprimeTout()
         pour i = 1 a 47
         	TableAjouteLigne(TABLE_TabOneRack)
         	TABLE_TabOneRack[i].COL_pos = i
         FIN
         nCpt est un entier
         
         pour chaque st_Order de gtabCurrentRackAdjustment
         	SI PAS st_Order.bTodelete ALORS
         		ncpt++
         		TABLE_TabOneRack[st_Order.nRackLineNumber].COL_Width	= st_Order.nLargeur
         		TABLE_TabOneRack[st_Order.nRackLineNumber].COL_Height	= st_Order.nhauteur
         		TABLE_TabOneRack[st_Order.nRackLineNumber].COL_RackID		= ncpt
         		TABLE_TabOneRack[st_Order.nRackLineNumber].COL_Order		= st_order.OrderNumber
         		TABLE_TabOneRack[st_Order.nRackLineNumber].COL_Sequence		= st_Order.nShippingSequence
         		TABLE_TabOneRack[st_Order.nRackLineNumber].COL_Customer		= st_Order.CustomerNumber
         		TABLE_TabOneRack[st_Order.nRackLineNumber].COL_lift			= st_Order.bIsRackLiftShipping
         	FIN
         	
         FIN
         TABLE_TabOneRack.Affiche(taDébut)
         ExécuteTraitement(BTN_Dessine,trtClic)
         
         
         
         
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_Recalculer_un_rack
    identifier : 0x26f56de993c92d3f
    internal_properties : 
    properties :
     x : 1432
     y : 81
     width : 170
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         nNoCamion = Milieu(extraitchaine(SAI_SansNom1,1,tab),7)
         nNoRack		= milieu(ExtraitChaîne(SAI_SansNom1,2,tab),5)
         
         SI nNoRack = 0 OU nNoCamion = 0 ALORS RENVOYER Vrai
         
         MaFenêtre..Plan	= 5
         //gtabCurrentRackAdjustment = gtaAllRack[SAI_SansNom1].tabCurrentOrder
         gtabCurrentRackAdjustment <- gtaAllTruckrack[nNoCamion].taAllTruckRack[nNoRack].tabCurrentOrder
         //gtaAllRack[SAI_SansNom1] = RecalculateRack(gtabCurrentRackAdjustment,SAI_SansNom1)
         gtaAllTruckrack[nNoCamion].taAllTruckRack[nNoRack] = RecalculateRack(gtabCurrentRackAdjustment,0)
         //gtabCurrentRackAdjustment <- gtaAllRack[SAI_SansNom1].tabCurrentOrder
         gtabCurrentRackAdjustment <- gtaAllTruckrack[nNoCamion].taAllTruckRack[nNoRack].tabCurrentOrder
         
         TABLE_TabOneRack.SupprimeTout()
         pour i = 1 a 47
         	TableAjouteLigne(TABLE_TabOneRack)
         	TABLE_TabOneRack[i].COL_Pos = i
         FIN
         nCpt est un entier
         
         pour chaque st_Order de gtabCurrentRackAdjustment
             SI PAS st_Order.bTodelete ALORS
             ncpt++
         	TABLE_TabOneRack[st_Order.nRackLineNumber].COL_Width = st_Order.nLargeur
         	TABLE_TabOneRack[st_Order.nRackLineNumber].COL_height = st_Order.nhauteur
         	
         	TABLE_TabOneRack[st_Order.nRackLineNumber].COL_RackID = ncpt
         	TABLE_TabOneRack[st_Order.nRackLineNumber].COL_Order = st_Order.OrderNumber
         	TABLE_TabOneRack[st_Order.nRackLineNumber].COL_Sequence = st_Order.nShippingSequence
         	TABLE_TabOneRack[st_Order.nRackLineNumber].COL_Customer = st_Order.CustomerNumber
         	TABLE_TabOneRack[st_Order.nRackLineNumber].COL_Lift = st_Order.bIsRackLiftShipping
         	fin
         FIN
         TABLE_TabOneRack.Affiche(taDébut)
         ExécuteTraitement(BTN_Dessine,trtclic)
         
         
         
