    name : Transform
    identifier : 0x20268c6e08b314d7
    internal_properties : 
    properties :
     x : 551
     y : 34
     width : 80
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         tabdirectory est un tableau de chaine
         tabFichier est un tableau de chaînes
         //ResListeFichier est une chaine = fListeRépertoire(ComplèteRep(repdonnees)+"PDF\001",frNonRécursif)
         CurrentDirectory est une chaine = ComplèteRep(repdonnees)+"PDF\001"
         invoicenumber est un entier = 0
         
         lNomFichier est une chaine = ""
         LnomfichierDocClient est une chaîne = ""
         LNomFichierConfirmation est une chaîne = ""
         
         //ChaîneVersTableau(ResListeFichier,tabdirectory,RC)
         //POUR CHAQUE _repertoire de tabdirectory
         //	resfiles est une chaine = flistefichier(_repertoire+"\Facture\*.pdf")
         sablier(vrai)
         resfiles est une chaine = flistefichier(CurrentDirectory+"\Facture\*.pdf")
         ChaîneVersTableau(resfiles,tabFichier,rc)
         
         pour chaque Files de tabFichier
         	si fextraitchemin(Files,ffichier) = "Facture"+sansespace(SAI_FIC) alors
         		info(Files)
         		sortir
         	sinon
         		
         		si ChaîneOccurrence(Files,"_") <> 0 alors
         			//			SaisiePDF = PDFVersTexte(Files)
         			StringToSearch = PDFVersTexte(Files)
         			invoicenumber = SearchInvoiceNumber(Files,sansespace(sai_fic))
         			si invoicenumber = val(sai_fic) alors
         				info(Files)
         				sortir
         			FIN
         			
         		fin
         	fin
         fin
         //fin
         
         sablier(faux)
        type : 18
      -
        type : 161
        enabled : false
