   -
     name : getpdebase
     procedure_id : 1186150456426854498
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] getpdebase (<fdnumprod>, <fdcomposant1>, <fdcomposant2>, <fdcomposant3>)
      //
      // Paramètres :
      //	fdnumprod : <indiquez ici le rôle de fdnumprod>
      //	fdcomposant1 : <indiquez ici le rôle de fdcomposant1>
      //	fdcomposant2 : <indiquez ici le rôle de fdcomposant2>
      //	fdcomposant3 : <indiquez ici le rôle de fdcomposant3>
      // Valeur de retour :
      // 	chaîne ANSI : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      
      //
      PROCEDURE getpdebase(fdnumprod,fdcomposant1,fdcomposant2,fdcomposant3)
      pdebase est une chaine
      pdebaseextrait est un entier = 0
      
      si hlitrecherche(persoens,ennumero,fdnumprod) alors
      	pdebase = persoens.epbase
      sinon
      	SI Val(Droite(fdcomposant1,1)) > pdebaseextrait ALORS pdebaseextrait = Val(Droite(fdcomposant1,1))
      	SI Val(Droite(fdcomposant2,1)) > pdebaseextrait ALORS pdebaseextrait = Val(Droite(fdcomposant2,1))
      	SI Val(Droite(fdcomposant3,1)) > pdebaseextrait ALORS pdebaseextrait = Val(Droite(fdcomposant3,1))
      	pdebase = Complète("CL0"+NumériqueVersChaîne(pdebaseextrait),10)
      	
      		
      
      FIN
      
      renvoyer pdebase
