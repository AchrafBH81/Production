  -
    name : Calcul_Nb_thermos
    identifier : 0x28d31aa18685bf6c
    internal_properties : 
    properties :
     x : 1044
     y : 419
     width : 80
     height : 42
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         prixu			est un réel
         Ligneencours	est un entier
         nNbThermos est un entier
         
         
         pour tout facture //avec "facture.faclient = 120"
         	//hlitrecherche(Facture,fanumero,"435917")
         	nNbThermos = 0
         	si facture.fatypedocument = 3 et facture.NumberOfThermosToProduce = 0 alors
         		message(facture.fanumero)
         		multitacherepeint()
         		si hlitrecherche(Client,numero,facture.faclient) alors
         			pour tout fdetail avec "fdetail.fdnocomm = " + facture.fanumero
         				
         				Message(facture.fanumero+"-"+fdetail.fdligne)
         				si fdetail.ftype = 1 alors
                             nNbThermos+= fdetail.fdqteafacturer				
         				fin
         			fin
         			facture.NumberOfThermosToProduce = nNbThermos
         			hmodifie(Facture,hNumEnrEnCours)
         
         		FIN
         	fin
         fin
         
         info("Recalcul terminé")
        type : 18
      -
        type : 161
        enabled : false
