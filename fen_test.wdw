  -
    name : _39706
    identifier : 0x2079a6d50b2ae9f1
    internal_properties : 
    properties :
     x : 360
     y : 436
     width : 80
     height : 37
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         
         Prixu est un reel
         pdebase est une chaine
         
         POUR TOUT hfdetail AVEC "hfdetail.fdnocomm = 439706" 
         
         		pdebase = getpdebase(hfdetail.fdnumprod,SansEspace(hfdetail.fdcomposant1),SansEspace(hfdetail.fdcomposant2),SansEspace(hfdetail.fdcomposant3))
         		
         		Prixu  = 	CalculPrixThermos(hFdetail.fdnumprod,181,hFdetail.fdcomposant1,hFdetail.fdcomposant2,hFdetail.fdcomposant3,pdebase)
         		
         		hfdetail.fdprixupied = Prixu
         		hfdetail.fdprixupiedfacture = Prixu
         		hfdetail.fdprixu = hfdetail.fdpiedcarrefacture * Prixu
         		hfdetail.fdprixtotal = hfdetail.fdpiedcarrefacture * Prixu * hfdetail.fdqteafacturer
         		hfdetail.surchargeenergie = hfdetail.fdprixtotal * 0.10
         		HModifie(hfdetail,hNumEnrEnCours)
         
         FIN	
        type : 18
      -
        type : 161
        enabled : false
  -
    name : Bouton12
    identifier : 0x2079a8840ce77e83
    internal_properties : 
    properties :
     x : 791
     y : 212
     width : 143
     height : 88
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         prixu est un reel
         pdebase est une chaîne
         ajustement est un reel
         nobon est une chaine = "349149"
         POUR TOUT hfdetail AVEC "fdnofact = " + nobon
         	
         	//			hlitrecherche(Client,numero,reqsql.bclient)
         	SI hfdetail.ftype = 1 ET PAS hfdetail.FDprixmodifie ALORS
         		pdebase = getpdebase(hfdetail.fdnumprod,SansEspace(hfdetail.fdcomposant1),SansEspace(hfdetail.fdcomposant2),SansEspace(hfdetail.fdcomposant3))
         		prixu  = 	CalculPrixThermos(hfdetail.fdnumprod,181,Majuscule(hfdetail.fdcomposant1),Majuscule(hfdetail.fdcomposant2),Majuscule(hfdetail.fdcomposant3),pdebase)
         		SI Arrondi((hfdetail.fdqteafacturer * hfdetail.fdpiedcarrefacture * prixu) - (hfdetail.fdqteafacturer * hfdetail.fdprixu),2) <> 0 ALORS
         			TableAjouteLigne(Table3,nobon,hfdetail.fdcomposant1,hfdetail.fdcomposant2,hfdetail.fdcomposant3,hfdetail.fdprixupiedfacture,hfdetail.fdqteafacturer,...
         			hfdetail.fdpiedcarrefacture,prixu,Arrondi((hfdetail.fdqteafacturer * hfdetail.fdpiedcarrefacture * prixu) - (hfdetail.fdqteafacturer * hfdetail.fdprixu),2))
         			ajustement += Arrondi((hfdetail.fdqteafacturer * hfdetail.fdpiedcarrefacture * prixu) - (hfdetail.fdqteafacturer * hfdetail.fdprixu),2)
         		FIN
         	FIN
         FIN
         SI ajustement <> 0 ALORS
         	TableAjouteLigne(Table3,nobon,"Total","","","","","","",ajustement)
         
         fin
         	
        type : 18
      -
        type : 161
        enabled : false
  -
    name : Surcharge
    identifier : 0x207ed33407ab3be0
    internal_properties : 
    properties :
     x : 791
     y : 306
     width : 143
     height : 88
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         Surchargereelle est un reel 
         Ajustement est un reel
         Totalfacture est un reel
         SurchargeFic est un reel
         SurchargereelleTot est un reel
         
         pour tout hfacture avec "hfacture.fadate >= 20210414 et hfacture.fadate <= 20210420 et hfacture.faclient = 139"
         	si hlitrecherche(bonlivraison,Bnumero,hfacture.Bnumero) _et_ BonLivraison.Bfacture <> 0 alors
         		Ajustement = 0
         		SurchargeFic = 0
         		SurchargereelleTot = 0
         
         		pour tout hfdetail avec "hfdetail.fdnofact = " + BonLivraison.bnumero +"et hfdetail.ftype = 1"
         			
         			Totalfacture = hfdetail.fdqteafacturer * (hfdetail.fdprixu+hfdetail.FDextra5x + hfdetail.FDextra10X )
         			Surchargereelle = Totalfacture * 0.10
         			tableajouteligne(table2,hfdetail.fdnocomm,hfacture.fadate,Totalfacture,hfdetail.surchargeenergie,Surchargereelle,Surchargereelle - hfdetail.surchargeenergie)
         			Ajustement += (Surchargereelle - hfdetail.surchargeenergie)
         			SurchargeFic += hfdetail.surchargeenergie
         			SurchargereelleTot += Surchargereelle
         		FIN
         		si abs(Ajustement) > 0.01 alors TableAjouteLigne(Table3,bonlivraison.Bfacture,Totalfacture,SurchargereelleTot,SurchargeFic,Ajustement)
         	fin
         FIN
         
         
        type : 18
      -
        type : 161
        enabled : false
  -
    name : Surcharge_Commande_active
    identifier : 0x207eed890f181b15
    internal_properties : 
    properties :
     x : 791
     y : 400
     width : 143
     height : 88
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         Surchargereelle est un reel 
         Ajustement est un reel
         Totalfacture est un reel
         pour tout facture avec "facture.faclient = 139 and facture.fadate > 20200601 et facture.fatypedocument <> 3"
         	POUR TOUT fdetail AVEC "fdetail.fdnocomm = " + facture.fanumero +"et fdetail.ftype = 1"
         		Totalfacture = fdetail.fdqteafacturer * (fdetail.fdprixu+fdetail.FDextra5x + fdetail.FDextra10X )
         		Surchargereelle = Totalfacture * 0.10
         	//	si Totalfacture <> 0 alors
         			tableajouteligne(table2,facture.fanumero+"-"+fdetail.fdligne,facture.fadate,fdetail.SUrchargeafacturer,fdetail.SUrchargedejafacture,...
         			fdetail.surchargeenergie * fdetail.fdqteafacturer / fdetail.fdqte,fdetail.fdqteafacturer,...
         			Totalfacture,Surchargereelle,Surchargereelle-(Fdetail.surchargeenergie * Fdetail.fdqteafacturer / Fdetail.fdqte))
         	//	fin
         		
         	FIN
         	//tableajouteligne(Table2,facture.fanumero)
         FIN
         
         
        type : 18
      -
        type : 161
        enabled : false
  -
    name : Surcharge_Commande_active_Calculer
    identifier : 0x207f0f9a176b3db9
    internal_properties : 
    properties :
     x : 791
     y : 494
     width : 143
     height : 88
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         Surchargereelle est un reel 
         Ajustement est un reel
         Totalfacture est un reel
         pour tout facture avec "facture.faclient = 139 and facture.fadate > 20200601 et facture.fatypedocument <> 3"
         	POUR TOUT fdetail AVEC "fdetail.fdnocomm = " + facture.fanumero +"et fdetail.ftype = 1"
         		
         		Totalfacture = fdetail.fdqte * (fdetail.fdprixu+fdetail.FDextra5x + fdetail.FDextra10X )
         		Surchargereelle = Totalfacture * 0.10
         	//	si Totalfacture <> 0 alors
                     fdetail.surchargeenergie = Surchargereelle
                     fdetail.SUrchargedejafacture = fdetail.fdqtedejafacture / fdetail.fdqte * fdetail.surchargeenergie
                     fdetail.SUrchargeafacturer = fdetail.surchargeenergie - fdetail.SUrchargedejafacture
                     hmodifie(Fdetail,hNumEnrEnCours)
         //			tableajouteligne(table2,facture.fanumero+"-"+fdetail.fdligne,facture.fadate,fdetail.SUrchargeafacturer,fdetail.SUrchargedejafacture,...
         //			fdetail.surchargeenergie * fdetail.fdqteafacturer / fdetail.fdqte,fdetail.fdqteafacturer,...
         //			Totalfacture,Surchargereelle,Surchargereelle-(Fdetail.surchargeenergie * Fdetail.fdqteafacturer / Fdetail.fdqte))
         	//	fin
         		message(fdetail.fdnocomm)
         		MultitâcheRepeint()
         	FIN
         	
         	
         	
         	SI facture.FPREPARATION = "B" ALORS
         		POUR TOUT hfdetail AVEC "hfdetail.fdnocomm = " + facture.fanumero
         			SI hFdetail.ftype = 1 ET PAS hFdetail.FDprixmodifie ALORS
         				
         				Totalfacture = hfdetail.fdqteafacturer * (hFdetail.fdprixu+hFdetail.FDextra5x + hFdetail.FDextra10X )
         				Surchargereelle = Totalfacture * 0.10
         				//	si Totalfacture <> 0 alors
         				hFdetail.surchargeenergie = Surchargereelle
         				hfdetail.SUrchargeafacturer = Surchargereelle
         //				hfdetail.fdprixupied = prixu
         //				hfdetail.fdprixupiedfacture = prixu
         //				hfdetail.fdprixu = hfdetail.fdpiedcarrefacture * prixu
         //				hfdetail.fdprixtotal = hfdetail.fdpiedcarrefacture * prixu * hfdetail.fdqteafacturer
         //				hfdetail.surchargeenergie = hfdetail.fdprixtotal * 0.10
         				HModifie(hfdetail,hNumEnrEnCours)
         			FIN
         		FIN	
         	FIN
         	//tableajouteligne(Table2,facture.fanumero)
         FIN
         
         
        type : 18
      -
        type : 161
        enabled : false
