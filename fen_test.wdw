  -
    name : BTN_Remettre_une_crédit_actif_pour_transférer_en_Bon_de_livraison
    identifier : 0x2128ebb50cc3ae0b
    internal_properties : 
    properties :
     x : 257
     y : 530
     width : 263
     height : 89
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         si hlitrecherche("Facture","fanumero",sai_nocommande) alors
         	facture.FPREPARATION = ""
         	hmodifie("Facture",hNumEnrEnCours)
         FIN
         
         hlitrecherche("Fdetail","fdnocomm",SAI_NoCommande)
         tantque fdetail.fdnocomm = sai_nocommande
         	fdetail.fdqteafacturer = fdetail.fdqtedejafacture
         	fdetail.fdqtedejafacture = 0
         	hmodifie("Fdetail",hNumEnrEnCours)
         	hlitsuivant("Fdetail","fdnocomm")
         FIN
         
         SI HLitRecherche("HFacture","fanumero",SAI_NoCommande) ALORS
         	hsupprime("hfacture",hNumEnrEnCours)
         FIN
         HLitRecherche("hFdetail","fdnocomm",SAI_NoCommande)
         
         TANTQUE hFdetail.fdnocomm = SAI_NoCommande
         	Fdetail.fdqteafacturer = Fdetail.fdqtedejafacture
         	Fdetail.fdqtedejafacture = 0
         	HModifie("hFdetail",hNumEnrEnCours)
         	HLitSuivant("hFdetail","fdnocomm")
         FIN
         
        type : 18
      -
        type : 161
        enabled : false
