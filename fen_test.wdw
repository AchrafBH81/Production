    internal_properties : 
    properties :
     x : 789
     y : 6
     width : 80
     height : 42
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         nHauteurMetrique	est un entier
         nLargeurMetrique	est un entier
         
         pour tout hfacture avec "hfacture.fadate > 20240424" 
         	multitacherepeint()
         	message("Facture en cours:"+hfacture.fanumero)
         	POUR TOUT hFdetail AVEC "fdnocomm = "+hfacture.fanumero
         		SI hFdetail.ftype = 1 ALORS
         			hFdetail.ExceptionForShippingBill = Faux
         			SELON hFacture.facalcul
         				CAS 1
         					nHauteurMetrique	= Arrondi(InchFractionToMillimeter(hFdetail.fdhauteura))
         					nLargeurMetrique	= Arrondi(InchFractionToMillimeter(hFdetail.fdlargeura))
         					
         					SI SansEspace(Fdetail.fdforme) <> "" _OU_ (nLargeurMetrique > 850 _ET_ nHauteurMetrique > 850) _OU_ (nLargeurMetrique > 2100 _OU_ nHauteurMetrique > 2100)  ALORS
         						hFdetail.ExceptionForShippingBill =  Vrai
         					sinon
         						hFdetail.ExceptionForShippingBill =  faux
         					FIN
         					
         				CAS 2
         					SI SansEspace(hFdetail.fdforme) <> "" _OU_ (Val(hFdetail.fdlargeura) > 850 _ET_ Val(hFdetail.fdhauteura) > 850) _OU_ (Val(hFdetail.fdlargeura) > 2100 _OU_ Val(hFdetail.fdhauteura) > 2100) ALORS
         						hFdetail.ExceptionForShippingBill =  Vrai
         					SINON
         						hFdetail.ExceptionForShippingBill =  Faux
         					FIN
         					
         				AUTRE CAS
         					
         			FIN
         			HModifie(hFdetail,hNumEnrEnCours)
         		sinon
         			hfdetail.ExceptionForShippingBill =  Faux
         			HModifie(hfdetail,hNumEnrEnCours)
         			
         		FIN
         	FIN
         	
         FIN
        type : 18
      -
        type : 161
        enabled : false
