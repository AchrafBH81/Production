 menu :
  name : _Menu
  identifier : 0x2aa437fc5bc8fc71
  internal_properties : 
  options : []
 languages :
  - fr-FR
 popup_menus : []
 message_bar :
  internal_properties : CQAAAAkAAACmjuBzz8CGl3hd7dPnHYkTCIxEkXBEPUz/1goh39uXtm2GvZxFAWkzmkTs3LXmtIkzXjLTG26GRQbzfu9zZPMbyALPp9lYK1NpGM/X85GoU5JHKTPg2gabptn64Q==
 actionbar : {}
 code_elements :
  type_code : 1
  p_codes :
   -
     internal_properties : CQAAAAkAAAAMKk0bUnppf9n/DdIx+pD12FdjGBpDdPouTXmKpwRX8VSK7s3EyvfwpbA1UoOIDFhQRWUvEtPmaHQL3DqP9EYkvNp92ZaY8pL88p/fEQhlXNEtBTP55g==
     code : |1-
      // Traitement automatique des exceptions :   exécuter le bloc de code CAS EXCEPTION:
      //
      PROCEDURE fcommanderecubasco(clclient est un mclient)
      //po est un PurchaseOrderDto, utile
      
      GetArgonExtraPrice()
      
      			ToastAffiche("Récupération des commandes en cours",toastLong,cvMilieu,chCentre,noir)
      tabRelationCarrelage est un tableau de cRelationCarrelage
      tabrelationComposant est un tableau de cRelationThermos
      
      //_tabPurchaseorder est un "List<PurchaseorderDTo>" <- RecupereCommandeEDIBasco()
      _tabPurchaseorder est un TabPurchaseOrderBasco //<- RecupereCommandeEDIBasco()
      reqSql est une source de donnees
      sablier(vrai)
      Boucle
      	TableauSupprimeTout(tabrelationComposant)
      
      	_tabPurchaseOrder <- RecupereCommandeEDIBasco()
      	pour chaque _po de _tabPurchaseOrder._tabPurchaseorderBasco
      		SI HExécuteRequêteSQL(reqsql,hRequêteDéfaut,ChaîneConstruit("select fanumero from facture where fanocommande = '%1'",_po.Display)) ALORS
      			SI HNbEnr(reqsql) = 0 ALORS
      				POUR CHAQUE _relation de _po.RelationComposant
      					SI  TableauCherche(tabrelationComposant,tcLinéaire,"ProduitBase;IsEnergetic;IsTempered",_relation.ProduitBase,_relation.IsEnergetic,_relation.IsTempered) = -1 ALORS
      						Ajoute(tabrelationComposant,_relation)
      					FIN
      				FIN
      				
      			FIN
      		FIN
      
      	fin
      	Sablier(faux)
      	si tabrelationComposant..Occurrence <> 0 alors
      		si ouvre(frelationthermos,tabrelationComposant,"139") = "Quit" alors 
      			
      			ferme(mafenetre)
      		FIN
      	sinon
      		SORTIR
      	FIN
      	
      fin
      Sablier(faux)
      _date est une DateTime
      _NoPo est une chaîne
      _Description est une chaîne
      _qte est un entier
      
      
      CAS EXCEPTION:
      	Erreur(ExceptionInfo(errMessage))
      	
   -
     code : |1+
      //si tabRelationCarrelage..Occurrence <> 0 alors
      //	ouvre(fRelationcarrelage,tabRelationCarrelage,"013")
      //FIN
      
      
      POUR chaque _po de _tabPurchaseOrder._tabPurchaseorderBasco
      	
      	
          _date = _po.DateSent
          _Description = _po.Customer
          _NoPo = _po.display
          _qte = 0
          
          si HExécuteRequêteSQL(reqSql,hRequêteDéfaut,ChaîneConstruit("select fanumero from facture where fanocommande = '%1'",_po.Display)) alors
          	 si hnbenr(reqsql) > 0 alors
          	 	_po.CommandeExiste = vrai
          	
          	fin
          fin	
          	
      	
      	POUR chaque _POItems de _po.PurchaseOrderItems
      
      		_qte+=_POItems.quantity
      		
      		
      		
      	FIN
