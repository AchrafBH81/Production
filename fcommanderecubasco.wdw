  -
    name : Générer
    identifier : 0x2aa46bde60b6a57c
    internal_properties : 
    properties :
     x : 900
     y : 68
     width : 50
     height : 50
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         sordertocheck est une chaine
         sdReqsql est une source de donnees
         
         
         stxtSql est une chaine = [
         	select top 30 * from (
         	select Facture.fanumero as commande,Facture.fadate as datecommande,facture.fpreparation as Prep,'' as NoFacture,facture.fatypedocument as typededocument  from Facture WHERE Facture.faclient = '%1' AND Facture.fanocommande = '%2'
         	union select hfacture.fanumero as commande,bonlivraison.bdatefacture as dateCommande,'X' as prep,BonLivraison.Bfacture as NoFacture,'4' as typededocument from hfacture inner join BonLivraison on BonLivraison.BnoCommande = hfacture.fanumero WHERE 
         	bonlivraison.bfacture <> 0 and hfacture.faclient = '%1' AND hfacture.fanocommande = '%2' 
         	) order by datecommande desc
         ]
         
         sordertocheck	= sansespace(Replace(tableCommandeRecu.Description,"'","''"))
         stxtSql			= ChaîneConstruit(stxtSql,"139",sordertocheck)
         
         si HExécuteRequêteSQL(sdReqsql,hRequêteDéfaut,stxtSql) ALORS
         	si hnbenr(sdReqsql) <> 0 alors
         		Si pas ouinon(0,"Cette commande à déjà été récupérée", "Voulez-vous continuer ?") alors retour
         
         	FIN
         FIN
         
         
         
         bufPurchaseorder est un buffer
         
         sablier(vrai)
         i est un entier 
         NbSelectionne est un entier 
         NbSelectionne = TableSelectOccurrence(tableCommandeRecu,tsligne)
         _po est un PurchaseOrderBasco
         cpt est un entier 
         POUR i = 1 A NbSelectionne
         	si tableCommandeRecu[TableSelect(tableCommandeRecu, TableSelect(tableCommandeRecu, i))].CommandeExiste alors
         	  si pas ouinon(0,"Commande déjà récupérée","Voulez-vous continuer ?") alors retour
             fin
         		_po =tableCommandeRecu[TableSelect(tableCommandeRecu, i)]
         		pour chaque _poitem de _po.PurchaseOrderItems
         			cpt++
         			_poitem.bligne = cpt
         			
         			_poitem.GenererDetail(_po)
         		fin
         		serialise(_po,bufPurchaseorder,psdJSON)
         		fSauveBuffer("c:\temp\Purchaseorder.buf",bufPurchaseorder)
         
         		_po.GenererCommande()
         	
         //	ClosePurchaseorder(_po.EdiKey)
         	ClosePurchaseorder(_po.PurchaseOrderId)
         	sablier(faux)
         	iapercu(100)
         	iimprimeetat(EtatExceptionEDI,_po)
         
         	tableCommandeRecu.CommandeExiste[TableSelect(tableCommandeRecu, i)] = vrai
          //   tableCommandeRecu.Supprime(TableSelect(tableCommandeRecu, i))
             nCurrentIndex est un entier = _tabPurchaseorder._tabPurchaseorderBasco.cherche(tcLinéaire,"PurchaseOrderID",_po.PurchaseOrderId)    
             si nCurrentIndex > 0 alors _tabPurchaseorder._tabPurchaseorderBasco.supprime(nCurrentIndex)    
            	tableCommandeRecu.affiche()
         	si tableCommandeRecu..Occurrence = 0 alors generer..etat = grise
         	
         FIN
         
         
         
         
        type : 18
      -
        type : 161
        enabled : false
