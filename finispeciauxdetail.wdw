  procedures :
   -
     name : remplirComboIntercalaireCouleur
     procedure_id : 5858988387714536123
     type_code : 14
     code : |1+
      Procédure remplirComboIntercalaireCouleur(_IDInterClient)
      
      RequeteInterClientDetail.pIdInterClient = _IDInterClient
      HExécuteRequête(RequeteInterClientDetail)
      
      pour tout IntercalaireCouleurs 
      	si pas hlitrecherche(RequeteInterClientDetail,"idintercalairecouleurs" ,IntercalaireCouleurs.IDIntercalaireCouleurs) alors
      		listeajoute(ComboInterCouleur,IntercalaireCouleurs.Description+glien(numeriqueverschaine(IntercalaireCouleurs.IDIntercalaireCouleurs)))
      	FIN
      FIN
      glienactive(ComboInterCouleur)
      listeselectplus(ComboInterCouleur,1)
      
      
     type : 458752
   -
     name : remplirComboNumero
     procedure_id : 1355981334974948359
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //remplirComboNumero (<_IdIntercalaireCouleur> [, <_spacer1> [, <_spacer2>]])
      //
      // Paramètres :
      //	_IdIntercalaireCouleur : <indiquez ici le rôle de _IdIntercalaireCouleur>
      // 	_spacer1 (valeur par défaut=1) : < indiquez ici le rôle de _spacer1 >
      // 	_spacer2 (valeur par défaut=1) : < indiquez ici le rôle de _spacer2 >
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE remplirComboNumero(_IdIntercalaireCouleur,_spacer1 ="",_spacer2="")
      
      _selectcomboespace1 est un entier
      _selectcomboespace2 est un entier
      
      ListeSupprimeTout(Comboespace1)
      ListeSupprimeTout(ComboEspace2)
      
      HLitRecherche(IntercalaireCouleurDimensions,IDIntercalaireCouleurs,_IdIntercalaireCouleur)
      tANTQUE PAS HEnDehors(IntercalaireCouleurDimensions) ET IntercalaireCouleurDimensions.IDIntercalaireCouleurs = _IdIntercalaireCouleur
      	ListeAjoute(Comboespace1,glien(IntercalaireCouleurDimensions.numero)+IntercalaireCouleurDimensions.numero)
      	SI SansEspace(IntercalaireCouleurDimensions.numero) = sansespace(_spacer1) ALORS
      		_selectcomboespace1 = Comboespace1..Occurrence
      	FIN
      	si pas TypeThermos = "D" alors
      		ListeAjoute(ComboEspace2,gLien(IntercalaireCouleurDimensions.numero)+IntercalaireCouleurDimensions.numero)
      		SI SansEspace(IntercalaireCouleurDimensions.numero) = sansespace(_spacer2) ALORS 
      			_selectcomboespace2 = Comboespace2..Occurrence
      		FIN
      	fin
      	HLitSuivant(IntercalaireCouleurDimensions,IDIntercalaireCouleurs)
      FIN
      
      gLienActive(Comboespace1)
      gLienActive(Comboespace2)
      
      listetrie(Comboespace1,vrai)
      listetrie(ComboEspace2,vrai)
      si _spacer1 = "" alors
      	listeselectplus(Comboespace1,1)
      sinon
      	Comboespace1 = _spacer1 
      FIN
      si pas TypeThermos = "D" alors
      	SI _spacer2 = "" ALORS
      		ListeSelectPlus(Comboespace2,1)
      	SINON
      		Comboespace2 = _spacer2 
      	FIN
      fin
      //listeselectplus(Comboespace1,_selectcomboespace1)
      //ListeSelectPlus(Comboespace2,_selectcomboespace2)
      
      
     type : 458752
  procedure_templates : []
  property_templates : []
