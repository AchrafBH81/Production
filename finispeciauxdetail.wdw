    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         
         // Validation de la fiche
         
         EcranVersFichier				// Transfert champs vers rubriques
         interclient.idclient = CL.idclient
         interclient.iClient = cl.numero
         
         
         // Enregistrement 
         selon ModeAppel
         	cas "Création"
         		EcranVersFichier()
         		InterClientDetail.Spacer1 = Comboespace1..ValeurAffichée
         		InterClientDetail.Spacer2 = ComboEspace2..ValeurAffichée
         		InterClientDetail.IdInterClient = _idinterclient
         		InterClientDetail.idintercalairecouleurs = ComboInterCouleur[ComboInterCouleur]
         		hajoute(InterClientDetail)
         	cas "Modif"
         		EcranVersFichier()
         		InterClientDetail.Spacer1 = Comboespace1..ValeurAffichée
         		InterClientDetail.Spacer2 = Comboespace2..ValeurAffichée
         		
         		hmodifie(InterClientDetail,hnumenrencours)
         		
         	autre cas
         		Erreur("Mode incorrect: "+ModeAppel)
         		retour
         fin
         si HErreurDoublon() alors
         	Erreur("Erreur de doublon sur clé unique")
         	Retour
         fin
         si HErreurIntegrite() alors
         	Erreur(HErreurInfo())
         	Retour
         fin
         
         Ferme			// Ferme la fenêtre
         
         
