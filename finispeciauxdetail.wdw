 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1+
      Procedure finispeciauxdetail(_idinterclient,ModeAppel = "Création")
      MoiMême..Visible=Vrai
      
      Global
      	NomFic			est une chaine		// Nom du fichier associé à la fenêtre
      NomFic="interClient"
      loriginal est une chaine
      TypeThermos est une chaine = sansespace(interclient.icomposant3) <> ""  ? "T" sinon "D"
      si typethermos = "D" alors
      	 ComboEspace2..visible = faux
      FIN
      
      selon ModeAppel
      	cas "Création"
      		remplirComboIntercalaireCouleur(_idinterclient)
      		ExécuteTraitement(ComboInterCouleur,trtSélection)
      		GR_Champ..Etat=Actif; GR_Champ..Visible=Vrai
      		// Efface les rubriques
      
      		// Tapez ici le code d'initialisation des champs
      
      	cas "Modif"
      		FichierVersEcran()
      		si hlitrecherche(IntercalaireCouleurs,IDIntercalaireCouleurs,InterClientDetail.idintercalairecouleurs) alors
      			listeajoute(ComboInterCouleur,IntercalaireCouleurs.Description)
      		fin
      		listeselectplus(ComboInterCouleur,1)
      	    ComboInterCouleur..etat = inactif
      	    
      	    remplirComboNumero(InterClientDetail.idintercalairecouleurs,InterClientDetail.Spacer1,InterClientDetail.Spacer2)
      	autre cas
      		Erreur("Mode d'appel de fenêtre incorrect: "+ModeAppel)
      		Ferme
      Fin
      //NUMEROEVENEMENT[1] = EVENEMENT("DOUBLECLIC","BTN_PRODUIT",WM_LBUTTONDBLCLK)
      //NUMEROEVENEMENT[2] = EVENEMENT("DOUBLECLIC","BTN_CATEGORIE",WM_LBUTTONDBLCLK)
      
      moimeme..ValeurRenvoyée = 0
      _Identifiant est un tableau de 4 chaine
      
   -
     code : |1+
      
      
     type : 34
