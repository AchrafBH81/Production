 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1+
      moimeme..ValeurRenvoyée = ""
      
   -
     code : |1+
      selon client.CImpressionAngMet
      	cas 1
      		selon commandetrn.facalcul
      			cas 1	
      				csnSurfaceReelle = commandetrn.fdpiedcarrereel
      				csnprix=commandetrn.cdprixupied 
      			cas 2
      				csnSurfaceReelle = arrondi(val(commandetrn.fdpiedcarrereel) / config.conversionma,2)
      				csnprix = ARRONDI(commandetrn.cdprixupied  * CONFIG.CONVERSIONma,2)
      		fin
      
      	cas 2
      		selon commandetrn.facalcul
      			cas 1	
      				csnSurfaceReelle = arrondi(val(commandetrn.fdpiedcarrereel) / config.conversionam,4)
      				csnprix = ARRONDI(commandetrn.cdprixupied  / CONFIG.CONVERSIONma,2)
      			cas 2
      				csnSurfaceReelle = commandetrn.fdpiedcarrereel
      				csnprix = commandetrn.cdprixupied  
      		fin
      
      FIN
      
      csnSurfaceFacture =commandetrn.CdSurfaceFacture
      csnSurfaceNormalise = commandetrn.fdpiedcarre
      
      
