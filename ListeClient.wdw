    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         lOrdre est une chaine = "Nom"
         
         iconfigure(sansespace(imprimanterapport),vrai)
         iparametre("DEFAUT=NON")
         iParamètre("QUALITE=HAUTE")
         iAperçu(100, "Aperçu", Vrai)
         si SélecteurOrdre = 2 alors
         	lOrdre = "Numero"
         	
         FIN
         si IntEtiquette alors
         	iImprimeEtat(client1,lOrdre,SélecteurType)
         	
         sinon
         	iImprimeEtat(EListeClientSommaire,lOrdre,selecteurtype)
         fin
         ferme(Listeclient)
        type : 18
      -
        type : 161
        enabled : false
