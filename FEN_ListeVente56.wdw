  -
    name : Btn_Ok
    identifier : 0x2353fbf001d124f3
    internal_properties : 
    properties :
     x : 705
     y : 82
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         
         
         
         
         
         
         tabThermos56 est une tableau de stThermos56
         
         
         stCurrentThermos est un stthermos56
         
         sdReqsql est une source de donnees
         sTxtsql est une chaine = [
         	
         	SELECT distinct
         	hfacture.facalcul AS facalcul,	
         	hfdetail.fdbase AS base,	
         	Client.nom AS name,
         	hfacture.faclient as num,	
         	hfdetail.fdnocomm AS fdnocomm	
         	FROM 
         	(
         	(
         	hfdetail
         	INNER JOIN
         	hfacture
         	ON hfacture.fanumero = hfdetail.fdnocomm
         	)
         	INNER JOIN
         	Client
         	ON hfacture.faclient = Client.numero
         	)
         	full outer JOIN
         	BonLivraison
         	ON BonLivraison.Bnumero = hfacture.fanofacture
         	WHERE 
         	(
         	BonLivraison.BDateFacture BETWEEN '%1' AND '%2'
         	AND	BonLivraison.Bfacture <> 0
         	AND	RIGHT(TRIM(hfdetail.fdbase ) ,1)  IN ('5', '6') 
         
         	)
         	
         	order by faclient,fdnocomm
         ]
         
         sdReqsql1 est une source de donnees
         sTxtsql1 est une chaine = [
         	
         	SELECT distinct
         	facture.facalcul AS facalcul,	
         	fdetail.fdbase AS base,	
         	Client.nom AS name,
         	facture.faclient as num,	
         	fdetail.fdnocomm AS fdnocomm	
         	FROM 
         	(
         	(
         	fdetail
         	INNER JOIN
         	facture
         	ON facture.fanumero = fdetail.fdnocomm
         	)
         	INNER JOIN
         	Client
         	ON facture.faclient = Client.numero
         	)
         	WHERE 
         	(
         	facture.fadate BETWEEN '%1' AND '%2'
         	AND	RIGHT(TRIM(fdetail.fdbase ) ,1)  IN ('5', '6') 
         	AND facture.fatypedocument = 1
         	
         	 
         	)
         	
         	order by faclient,fdnocomm
         ]
         
         sdReqSqlDetail est une source de donnees
         sTxtreqDetail est une chaine = [
         	select hfdetail.fdhauteur,hfdetail.fdlargeur,hfdetail.fdqteafacturer from hfdetail where hfdetail.fdnocomm = '%1' and hfdetail.ftype = 1
         ]
         
         sdReqSqlDetail1 est une source de donnees
         sTxtreqDetail1 est une chaine = [
         	select fdetail.fdhauteur,fdetail.fdlargeur,fdetail.fdqteafacturer from fdetail where fdetail.fdnocomm = '%1' and fdetail.ftype = 1
         ]
         
         //sdReqsql.pdebut = "20220101"
         //sdReqsql.pfin = "20221031"
         
         sNumClient est une chaine
         nCpt est un entier
         nCptCommande est un entier
         nTotRecord est un entier
         rTotalPI2 est un reel
         
         
         nRes est un entier
         SI HExécuteRequêteSQL(sdReqsql,hRequêteDéfaut,ChaîneConstruit(sTxtsql,FEN_ListeVente56.csddatedebut ,FEN_ListeVente56.csddatefin))  _et_ HExécuteRequêteSQL(sdReqsql1,hRequêteDéfaut,ChaîneConstruit(sTxtsql1,FEN_ListeVente56.csddatedebut ,FEN_ListeVente56.csddatefin)) ALORS
         	nTotRecord = hnbenr(sdReqsql)+hnbenr(sdReqsql1)
         	POUR TOUT sdReqsql 
         		//		message(sdReqsql.fdnocomm)
         		//		multitacherepeint()
         		nCptCommande++
         		Jauge(nCptCommande/nTotRecord*100,100)
         		sNumClient = sdReqsql.num
         		nRes = TableauCherche(tabThermos56,tcLinéaire,"numclient",sNumClient)
         		SI  nRes = -1 ALORS
         			stCurrentThermos = allouer un stThermos56()
         			stCurrentThermos.NumClienttri = Val(sNumClient)
         			stCurrentThermos.numClient = sNumClient
         			stCurrentThermos.sNomClient = sdReqsql.name
         			SI HExécuteRequêteSQL(sdReqSqlDetail,hRequêteDéfaut,ChaîneConstruit(sTxtreqDetail,sdReqsql.fdnocomm)) ALORS
         				
         				//			FIN
         				
         				//			si hlitrecherche(hfdetail,fdnocomm,sdReqsql.fdnocomm) alors
         			POUR TOUT sdReqSqlDetail 
         					rTotalPI2 =  Val(sdReqSqlDetail.fdlargeur) * Val(sdReqSqlDetail.fdhauteur) / (sdReqsql.facalcul = 2 ? 0.0929 SINON 144) //* sdReqSqlDetail.fdqteafacturer
         					SI rTotalPI2 < SAI_TotalPi2 ALORS CONTINUER
         					SELON Droite(SansEspace(sdReqsql.base),1)
         						CAS "5"
         							stCurrentThermos.Qte5 += sdReqSqlDetail.fdqteafacturer
         							stCurrentThermos.Pi25 += rTotalPI2 * sdReqSqlDetail.fdqteafacturer
         
         						CAS "6"
         							stCurrentThermos.qte6 += sdReqSqlDetail.fdqteafacturer
         							stCurrentThermos.Pi26 +=  rTotalPI2 * sdReqSqlDetail.fdqteafacturer
         							
         						AUTRE CAS
         							
         					FIN
         //					SI rTotalPI2 < SAI_TotalPi2 ALORS CONTINUER
         					stCurrentThermos.nQtetotal+=sdReqSqlDetail.fdqteafacturer
         					stCurrentThermos.nPi2Total+=Val(sdReqSqlDetail.fdlargeur) * Val(sdReqSqlDetail.fdhauteur) / (sdReqsql.facalcul = 2 ? 0.0929 SINON 144) * sdReqSqlDetail.fdqteafacturer
         					nCpt++
         				FIN
         
         				
         				si stCurrentThermos.nQtetotal <> 0 alors tabThermos56.Ajoute(stCurrentThermos)
         			FIN
         			
         		SINON	
         			SI HExécuteRequêteSQL(sdReqSqlDetail,hRequêteDéfaut,ChaîneConstruit(sTxtreqDetail,sdReqsql.fdnocomm)) ALORS
         				POUR TOUT sdReqSqlDetail 
         					rTotalPI2 =  Val(sdReqSqlDetail.fdlargeur) * Val(sdReqSqlDetail.fdhauteur) / (sdReqsql.facalcul = 2 ? 0.0929 SINON 144) //* sdReqSqlDetail.fdqteafacturer
         					SI rTotalPI2 < SAI_TotalPi2 ALORS CONTINUER
         					
         					SELON Droite(SansEspace(sdReqsql.base),1)
         						CAS "5"
         							tabThermos56[nRes].Qte5 += sdReqSqlDetail.fdqteafacturer
         							tabThermos56[nRes].pi25 += rTotalPI2 * sdReqSqlDetail.fdqteafacturer
         						CAS "6"         
         							tabThermos56[nRes].Qte6 += sdReqSqlDetail.fdqteafacturer
         							tabThermos56[nRes].pi26 += rTotalPI2* sdReqSqlDetail.fdqteafacturer
         							
         						AUTRE CAS
         							
         					FIN
         //					SI rTotalPI2 < SAI_TotalPi2 ALORS CONTINUER
         					tabThermos56[nRes].nQtetotal+=sdReqSqlDetail.fdqteafacturer
         					tabThermos56[nRes].nPi2Total+=Val(sdReqSqlDetail.fdlargeur) * Val(sdReqSqlDetail.fdhauteur) / (sdReqsql.facalcul = 2 ? 0.0929 SINON 144) * sdReqSqlDetail.fdqteafacturer
         					
         					nCpt++
         				FIN
         				
         			FIN
         		FIN
         	FIN
         	
         	POUR TOUT sdReqsql1 
         		//		message(sdReqsql.fdnocomm)
         		//		multitacherepeint()
         		nCptCommande++
         		Jauge(nCptCommande/nTotRecord*100,100)
         		sNumClient = sdReqsql1.num
         		nRes = TableauCherche(tabThermos56,tcLinéaire,"numclient",sNumClient)
         		SI  nRes = -1 ALORS
         			stCurrentThermos = allouer un stThermos56()
         			stCurrentThermos.NumClienttri = Val(sNumClient)
         			stCurrentThermos.numClient = sNumClient
         			stCurrentThermos.sNomClient = sdReqsql1.name
         			SI HExécuteRequêteSQL(sdReqSqlDetail1,hRequêteDéfaut,ChaîneConstruit(sTxtreqDetail1,sdReqsql1.fdnocomm)) ALORS
         				
         				//			FIN
         				
         				//			si hlitrecherche(hfdetail,fdnocomm,sdReqsql.fdnocomm) alors
         				POUR TOUT sdReqSqlDetail1 
         					rTotalPI2 =  Val(sdReqSqlDetail1.fdlargeur) * Val(sdReqSqlDetail1.fdhauteur) / (sdReqsql1.facalcul = 2 ? 0.0929 SINON 144) //* sdReqSqlDetail1.fdqteafacturer
         					si rTotalPI2 < SAI_TotalPi2 alors continuer
         					SELON Droite(SansEspace(sdReqsql1.base),1)
         						CAS "5"
         							stCurrentThermos.Qte5 += sdReqSqlDetail1.fdqteafacturer
         							stCurrentThermos.Pi25 += rTotalPI2 * sdReqSqlDetail1.fdqteafacturer
         						CAS "6"
         							stCurrentThermos.qte6 += sdReqSqlDetail1.fdqteafacturer
         							stCurrentThermos.Pi26 += rTotalPI2 * sdReqSqlDetail1.fdqteafacturer
         							
         						AUTRE CAS
         							
         					FIN
         					//si rTotalPI2 < SAI_TotalPi2 alors continuer
         					stCurrentThermos.nQtetotal+=sdReqSqlDetail1.fdqteafacturer
         					stCurrentThermos.nPi2Total+=Val(sdReqSqlDetail1.fdlargeur) * Val(sdReqSqlDetail1.fdhauteur) / (sdReqsql1.facalcul = 2 ? 0.0929 SINON 144) * sdReqSqlDetail1.fdqteafacturer
         					nCpt++
         				FIN
         				SI stCurrentThermos.nQtetotal <> 0 ALORS tabThermos56.Ajoute(stCurrentThermos)
         			FIN
         			
         		SINON	
         			SI HExécuteRequêteSQL(sdReqSqlDetail1,hRequêteDéfaut,ChaîneConstruit(sTxtreqDetail1,sdReqsql1.fdnocomm)) ALORS
         				POUR TOUT sdReqSqlDetail1 
         					rTotalPI2 =  Val(sdReqSqlDetail1.fdlargeur) * Val(sdReqSqlDetail1.fdhauteur) / (sdReqsql1.facalcul = 2 ? 0.0929 SINON 144) //* sdReqSqlDetail1.fdqteafacturer
         					SI rTotalPI2 < SAI_TotalPi2 ALORS CONTINUER
         					
         					SELON Droite(SansEspace(sdReqsql1.base),1)
         						CAS "5"
         							tabThermos56[nRes].Qte5 += sdReqSqlDetail1.fdqteafacturer
         							tabThermos56[nRes].pi25 += rTotalPI2* sdReqSqlDetail1.fdqteafacturer
         						CAS "6"         
         							tabThermos56[nRes].Qte6 += sdReqSqlDetail1.fdqteafacturer
         							tabThermos56[nRes].pi26 += rTotalPI2* sdReqSqlDetail1.fdqteafacturer
         							
         						AUTRE CAS
         							
         					FIN
         //					SI rTotalPI2 < SAI_TotalPi2 ALORS CONTINUER
         					tabThermos56[nRes].nQtetotal+=sdReqSqlDetail1.fdqteafacturer
         					tabThermos56[nRes].nPi2Total+=Val(sdReqSqlDetail1.fdlargeur) * Val(sdReqSqlDetail1.fdhauteur) / (sdReqsql1.facalcul = 2 ? 0.0929 SINON 144) * sdReqSqlDetail1.fdqteafacturer
         					
         					nCpt++
         				FIN
         				
         			FIN
         		FIN
         	FIN
         	
         	
         SINON
         	Info(HErreurInfo())
         FIN
         
         
         selon SélecteurCleTri
         	// Client
         	CAS 1
         		TableauTrie(tabThermos56,ttMembre,"numclienttri")
         	// Quantité
         	CAS 2
         		
         		selon SélecteurOrdreAffichage 
         			// Ascendant
         			CAS 1
         				TableauTrie(tabThermos56,ttMembre,"nqtetotal")
         			// Descendant
         			CAS 2
         				TableauTrie(tabThermos56,ttMembre,"-nqtetotal")
         				
         		FIN
         		
         	// Pied Carré
         	CAS 3
         		selon SélecteurOrdreAffichage
         			cas 1
         			TableauTrie(tabThermos56,ttMembre,"npi2total")
         			cas 2
         				TableauTrie(tabThermos56,ttMembre,"-npi2total")
         				
         			AUTRE CAS
         				
         		FIN
         		
         FIN
         
         iConfigure(imprimanterapport,Vrai)
         iParamètre("DEFAUT=NON")
         iParamètre("ORIENTATION=PORTRAIT")
         iParamètre("QUALITE=HAUTE")
         
         selon SélecteurDestination
         	// Écran
         	CAS 1
         		iAperçu(100)
         		
         	// Imprimante
         	CAS 2
         		
         FIN
         
         iImprimeEtat(ETAT_Ventes56,tabThermos56)
         
        type : 18
      -
        type : 161
        enabled : false
