  -
    name : BTN_Print
    identifier : 0x267d9eb129b2e89e
    internal_properties : 
    properties :
     x : 428
     y : 30
     width : 42
     height : 42
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         
         sTriColumn est une chaine = TABLEH_OrderWEB.ColonnesTriées()
         sInverseTriWay est une chaine = ""
         nMinusPosition est un entier = Position(sTriColumn,"-",1)
         sColumnName est une chaine 
         
         
         si nMinusPosition = 1 alors
         	sinverseTriWay = "-"
         FIN
         scolumnname =  minuscule(sTriColumn[nMinusPosition+1 A]) 
         selon scolumnname
         	CAS ""
             cas "col_nbediweb"  
             	tabWebInvoices.Trie(ttMembre+tccRespecteNumérique,ChaîneConstruit("ssellername;%1ninvoicesnumber",sInverseTriWay))
             cas "col_nbtotal"  
             	tabWebInvoices.Trie(ttMembre+tccRespecteNumérique,ChaîneConstruit("ssellername;%1ninvoicesnumbertotal",sInverseTriWay))
             cas "col_percentage"  
             	tabWebInvoices.Trie(ttMembre+tccRespecteNumérique,ChaîneConstruit("ssellername;%1spercentage",sInverseTriWay))
          	AUTRE CAS
         FIN
         
         
         
         
         
         iapercu()
         iImprimeEtat(ETAT_OrderEDIWEB,tabWebInvoices,csddatedebut,csddatefin)
        type : 18
      -
        type : 161
        enabled : false
