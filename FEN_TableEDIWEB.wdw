  -
    name : BtnRefresh
    identifier : 0x2678a3f8461086b1
    internal_properties : 
    properties :
     x : 342
     y : 11
     width : 80
     height : 80
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         
         tabWebInvoices.supprimetout()
         TABLEH_OrderWEB.supprimetout()
         stCurrentInvoices est un STFactureEDIWEB 
         nRes est un entier
         
         sdReqsql			est une Source de Données
         sTxtsql				est une chaîne ANSI
         sdReqsqlTot			est une Source de Données
         sTxtsqlTot			est une chaîne ANSI
         
         nSellerTotalEDIWEB	est un entier	= 0
         nSellerTotal		est un entier	= 0
         nSellerTotalEDIQuotationWEB	est un entier	= 0
         nSellerTotalQuotation		est un entier	= 0
         
         nTotalEDIWEB est un entier = 0
         nTotal est un entier = 0
         nTotalQuotation est un entier = 0
         ngTotalQuotation est un entier = 0
         
         
         sdReqSqlNbClient	est une source de donnees
         sTxtsqlnbclient		est un chaine	= [
         select count(nom) as nbclient,cvendeur from client where client.ediType = 1 and client.dateadhesion between {pBeginningdate} and {pEndingdate} group by cvendeur 
         ]
         
         sdReqSqlNbClient.pbeginningdate = csddatedebut
         sdReqSqlNbClient.pendingdate = csddatefin
         
         
         SI HExécuteRequêteSQL(sdReqSqlNbClient,hRequêteDéfaut,sTxtsqlnbclient) ALORS
         	pour TOUT sdReqSqlNbClient 
         	gtaNbClientPeriod[sdReqSqlNbClient.cvendeur] = sdReqSqlNbClient.nbclient
         	SAI_NBClient1 += sdReqSqlNbClient.nbclient
         	FIN
         	
         FIN
         
         
         
         sTxtsql = [
         Select distinct  scustomernumber, 
         scustomername , ssellername , nsellerid ,dcreationdate ,
         count(invoicenumber) as nInvoicesNumber
         from
         (
         select 
         tracking.InvoiceNumber,
         hfacture.faclient as scustomernumber,
         client.nom as scustomername,
         vendeur.idvendeur as nsellerid,
         client.dateadhesion as dcreationdate,
         vendeur.nom as ssellername
         from tracking
         inner join hfacture on hfacture.fanumero  = tracking.InvoiceNumber
         inner join  client on client.numero = hfacture.faclient
         inner join vendeur on vendeur.IDVendeur = client.cvendeur
         where invoicedate between {pDebut} and {pFin} and isedi = 1 and tracking.DocumentType = 'F' and client.ediType = 1 and client.cvendeur = {pVendeur} 
         
         
         union 
         
         select 
         tracking.invoicenumber,
         facture.faclient as scustomernumber,
         client.nom as scustomername,
         vendeur.idvendeur as nsellerid,
         client.dateadhesion as dcreationdate,
         vendeur.nom as ssellername
         from tracking
         inner join facture on facture.fanumero  = tracking.InvoiceNumber
         inner join  client on client.numero = facture.faclient
         inner join vendeur on vendeur.IDVendeur = client.cvendeur
         where invoicedate between {pDebut} and {pFin} and tracking.isedi = 1 and tracking.DocumentType = 'F' and client.ediType = 1 and client.cvendeur = {pVendeur}
         
         )
         
         group by scustomernumber,scustomername , ssellername , nsellerid , dcreationdate
         order by scustomernumber
         
         
         ]
         
         sTxtsqlQuotationProd est une chaine= [
         Select distinct  scustomernumber, 
         scustomername , ssellername , nsellerid ,dcreationdate ,
         count(invoicenumber) as nQuotationNumber
         from
         (
         select 
         tracking.InvoiceNumber,
         hfacture.faclient as scustomernumber,
         client.nom as scustomername,
         vendeur.idvendeur as nsellerid,
         client.dateadhesion as dcreationdate,
         vendeur.nom as ssellername
         from tracking
         inner join hfacture on hfacture.fanumero  = tracking.InvoiceNumber
         inner join  client on client.numero = hfacture.faclient
         inner join vendeur on vendeur.IDVendeur = client.cvendeur
         where invoicedate between {pDebut} and {pFin} and tracking.DocumentType = 'S'   and client.ediType = 1 and client.cvendeur = {pVendeur} 
         
         
         union 
         
         select 
         tracking.invoicenumber,
         facture.faclient as scustomernumber,
         client.nom as scustomername,
         vendeur.idvendeur as nsellerid,
         client.dateadhesion as dcreationdate,
         vendeur.nom as ssellername
         from tracking
         inner join facture on facture.fanumero  = tracking.InvoiceNumber
         inner join  client on client.numero = facture.faclient
         inner join vendeur on vendeur.IDVendeur = client.cvendeur
         where invoicedate between {pDebut} and {pFin} and tracking.DocumentType = 'S' and client.ediType = 1 and client.cvendeur = {pVendeur}
         
         )
         
         group by scustomernumber,scustomername , ssellername , nsellerid , dcreationdate
         order by scustomernumber
         
         
         ]
         
         stxtsqlQuotation est une chaine = [
         select sum(TotalNumber) as QuotationTotal ,
         client.nom as scustomername,
         customerNumber as scustomernumber, 
         
         dateadhesion as dcreationDate,
         vendeur.idvendeur as nsellerid,
         vendeur.nom as ssellername
          from QuotationByCustomer 
         inner join client on client.idclient = QuotationByCustomer.idcustomer
         inner join vendeur on vendeur.IDVendeur = client.cvendeur
         where quotationdate  between {pDebut} and {pFin}
         group by customernumber,client.nom,dcreationdate,nsellerid,ssellername
         
         
         ]
         
         sdReqSqlQuotation est une source de donnees
         sdReqSqlQuotationProd est une source de donnees
         
         sdReqsql.pdebut	= csddatedebut
         sdReqsql.pfin	= csddatefin
         si Combo_vendeur = 0 alors
         	sdReqsql.pvendeur = null
         sinon
         	sdReqsql.pvendeur = Combo_vendeur		
         FIN
         SI HExécuteRequêteSQL(sdReqsql,hRequêteDéfaut,sTxtsql) ALORS
         	FichierVersMémoire(tabWebInvoices,sdReqsql)
         FIN
         
         
         sTxtsqlTot = [
         Select distinct  scustomernumber, 
         scustomername , ssellername , nsellerid,dcreationdate ,
         count(invoicenumber) as nInvoicesNumberTotal
         from
         (
         select 
         tracking.InvoiceNumber,
         hfacture.faclient as scustomernumber,
         client.nom as scustomername,
         client.dateadhesion as dcreationdate,
         vendeur.idvendeur as nsellerid,
         vendeur.nom as ssellername
         
         from tracking
         inner join hfacture on hfacture.fanumero  = tracking.InvoiceNumber
         inner join  client on client.numero = hfacture.faclient
         inner join vendeur on vendeur.IDVendeur = client.cvendeur
         where invoicedate between {pDebut} and {pFin}  and tracking.DocumentType = 'F' and client.ediType = 1 and client.cvendeur = {pVendeur}
         
         
         union 
         
         select 
         tracking.invoicenumber,
         facture.faclient as scustomernumber,
         client.nom as scustomername,
         client.dateadhesion as dcreationdate,
         vendeur.idvendeur as nsellerid,
         vendeur.nom as ssellername
         from tracking
         inner join facture on facture.fanumero  = tracking.InvoiceNumber
         inner join  client on client.numero = facture.faclient
         inner join vendeur on vendeur.IDVendeur = client.cvendeur
         where invoicedate between {pDebut} and {pFin}  and tracking.DocumentType = 'F' and client.ediType = 1 and client.cvendeur = {pVendeur}
         
         )
         
         group by scustomernumber,scustomername , ssellername , nsellerid , dcreationdate
         order by scustomernumber
         ]
         
         sablier(vrai)
         sdReqsqlTot.pdebut	= csddatedebut
         sdReqsqlTot.pfin	= csddatefin
         SI Combo_vendeur = 0 ALORS
         	sdReqsqlTot.pvendeur = Null
         SINON
         	sdReqsqlTot.pvendeur = Combo_vendeur		
         FIN
         
         SI HExécuteRequêteSQL(sdReqsqlTot,hRequêteDéfaut,sTxtsqlTot) ALORS
         	pour TOUT sdReqsqlTot 
         		nRes  = tabWebInvoices.cherche(tclineaire,"sCustomerNumber",sdReqsqlTot.scustomernumber)
         		si nRes <> -1 alors
         			tabWebInvoices[nRes].nInvoicesNumberTotal = sdReqsqlTot.ninvoicesnumbertotal
         			si sdReqsqlTot.ninvoicesnumbertotal <> 0 alors
         				tabWebInvoices[nRes].sPercentage = numeriqueverschaine(arrondi(tabWebInvoices[nRes].nInvoicesNumber / tabWebInvoices[nRes].nInvoicesNumberTotal * 100,2),"6,2f") + "%"
         			sinon
         				tabWebInvoices[nRes].sPercentage = "0.00%"
         			FIN
         			nTotalEDIWEB += tabWebInvoices[nRes].nInvoicesNumber
         			nTotal += tabWebInvoices[nRes].nInvoicesNumberTotal
         		sinon
         			stCurrentInvoices = allouer un STFactureEDIWEB()
         			stCurrentInvoices.sCustomerNumber		= sdReqsqlTot.scustomernumber
         			stCurrentInvoices.sCustomerName			= sdReqsqlTot.scustomername
         			stCurrentInvoices.nInvoicesNumberTotal	= sdReqsqlTot.ninvoicesnumbertotal
         			stCurrentInvoices.sSellerName			= sdReqsqlTot.ssellername
         			stCurrentInvoices.nSellerID			= sdReqsqlTot.nsellerid
         			stCurrentInvoices.dCreationdate     = sdReqsqlTot.dcreationdate
         			SI sdReqsqlTot.ninvoicesnumbertotal <> 0 ALORS
         				stCurrentInvoices.sPercentage = NumériqueVersChaîne(arrondi(stCurrentInvoices.nInvoicesNumber / stCurrentInvoices.nInvoicesNumberTotal * 100),"6,2f")+"%"
         			sinon
         				stCurrentInvoices.sPercentage = "0.00%"
         			FIN
         			tabWebInvoices.ajoute(stCurrentInvoices)
         			nTotalEDIWEB += stCurrentInvoices.nInvoicesNumber
         			nTotal +=       stCurrentInvoices.nInvoicesNumberTotal
         			
         		FIN
         		
         	FIN
         FIN
         
         sdReqSqlQuotation.pdebut	= csddatedebut
         sdReqSqlQuotation.pfin	= csddatefin
         
         si HExécuteRequêtesql(sdReqSqlQuotation,hRequêteDéfaut,stxtsqlQuotation) alors
         	pour TOUT sdReqSqlQuotation 
         		nRes  = tabWebInvoices.cherche(tclineaire,"sCustomerNumber",sdReqSqlQuotation.scustomernumber)
         		SI nRes <> -1 ALORS
         			tabWebInvoices[nRes].nWebQuotationNumber = sdReqSqlQuotation.Quotationtotal
         			
         			
         		SINON
         			stCurrentInvoices  = allouer un STFactureEDIWEB()
         			stCurrentInvoices.sCustomerNumber		= sdReqSqlQuotation.scustomernumber
         			stCurrentInvoices.sCustomerName			= sdReqSqlQuotation.scustomername
         			stCurrentInvoices.sSellerName			= sdReqSqlQuotation.ssellername
         			stCurrentInvoices.nSellerID				= sdReqSqlQuotation.nsellerid
         			stCurrentInvoices.dCreationdate			= sdReqSqlQuotation.dcreationdate
         			stCurrentInvoices.nWebQuotationNumber = sdReqSqlQuotation.Quotationtotal
         			tabWebInvoices.Ajoute(stCurrentInvoices)
         			
         		FIN
         	FIN
         	
         FIN
         sdReqSqlQuotationProd.pdebut	= csddatedebut
         sdReqSqlQuotationProd.pfin	= csddatefin
         
         si HExécuteRequêtesql(sdReqSqlQuotationProd,hRequêteDéfaut,sTxtsqlQuotationProd) alors
         	pour TOUT sdReqSqlQuotationProd 
         		nRes  = tabWebInvoices.cherche(tclineaire,"sCustomerNumber",sdReqSqlQuotationProd.scustomernumber)
         		SI nRes <> -1 ALORS
         			tabWebInvoices[nRes].nprodQuotationNumber = sdReqSqlQuotationProd.nQuotationNumber
         			
         			
         		SINON
         			stCurrentInvoices  = allouer un STFactureEDIWEB()
         			stCurrentInvoices.sCustomerNumber		= sdReqSqlQuotationProd.scustomernumber
         			stCurrentInvoices.sCustomerName			= sdReqSqlQuotationProd.scustomername
         			stCurrentInvoices.sSellerName			= sdReqSqlQuotationProd.ssellername
         			stCurrentInvoices.nSellerID				= sdReqSqlQuotationProd.nsellerid
         			stCurrentInvoices.dCreationdate			= sdReqSqlQuotationProd.dcreationdate
         			stCurrentInvoices.nProdQuotationNumber = sdReqSqlQuotationProd.nQuotationNumber
         			tabWebInvoices.Ajoute(stCurrentInvoices)
         			
         		FIN
         	FIN
         	
         FIN
         
         tabWebInvoices.Applique(CalculQuotation)
         	procedure interne CalculQuotation(stCurrentQuotation est un STFactureEDIWEB)
         		stCurrentQuotation.nQuotationNumberTotal = stCurrentQuotation.nprodQuotationNumber+stCurrentQuotation.nWebQuotationNumber
         		SI stCurrentQuotation.nQuotationNumberTotal <> 0 ALORS
         			stCurrentQuotation.sPercentageQuotation = NumériqueVersChaîne(Arrondi(stCurrentQuotation.nWebQuotationNumber / stCurrentQuotation.nQuotationNumberTotal * 100,2),"6,2f") + "%"
         		SINON
         			stCurrentQuotation.sPercentageQuotation = "0.00%"
         		FIN
         	
         		
         		
         	FIN
         
         
         si sCurrentTri = "" alors
         	tabWebInvoices.trie(ttMembre+tccRespecteNumérique,"ssellername;sCustomerNumber")
         sinon
         	
         	sTriColumn		est une chaine	= scurrenttri
         	sInverseTriWay	est une chaine	= ""
         	nMinusPosition	est un entier	= Position(sTriColumn,"-",1)
         	sColumnName		est une chaine 
         	
         	
         	SI nMinusPosition = 1 ALORS
         		sInverseTriWay = "-"
         	FIN
         	sColumnName =  Minuscule(sTriColumn[nMinusPosition+1 À]) 
         	SELON sColumnName
         		CAS ""
         		CAS "col_nbediweb"  
         			tabWebInvoices.Trie(ttMembre+tccRespecteNumérique,ChaîneConstruit("ssellername;%1ninvoicesnumber",sInverseTriWay))
         		CAS "col_nbtotal"  
         			tabWebInvoices.Trie(ttMembre+tccRespecteNumérique,ChaîneConstruit("ssellername;%1ninvoicesnumbertotal",sInverseTriWay))
         		CAS "col_percentage"  
         			tabWebInvoices.Trie(ttMembre+tccRespecteNumérique,ChaîneConstruit("ssellername;%1spercentage",sInverseTriWay))
         		AUTRE CAS
         	FIN
         	
         FIN
         
         
         
         
         sLastSeller			est une chaine	= ""
         nLastsellerid est un entier
         
         nCurrentCustomer	EST UN ENTIER	= 0
         
         nCurrentLine		est un entier
         nSellerTotalEDIWEB		= 0
         nSellerTotal			= 0
         nSellerTotalEDIQuotationWEB		= 0
         nSellerTotalQuotation			= 0
         pour chaque stCustomer de tabWebInvoices
         	si stCustomer.sSellerName <> sLastSeller ALORS
         		si sLastSeller <> "" alors
         			nCurrentLine								= TABLEH_OrderWEB.Ajouteligne("Nombre de clients :" + gtaNbClient[nLastsellerid],repete(" ",80)+"Total","",nSellerTotalEDIWEB,nSellerTotal,"",nTotalQuotation,ngTotalQuotation)
         			TABLEH_OrderWEB[nCurrentLine]..PoliceGras	= Vrai
         			TABLEH_OrderWEB[nCurrentLine]..couleur		= blanc
         			TABLEH_OrderWEB[nCurrentLine]..CouleurFond	= GrisFoncé
         			nCurrentLine								= TABLEH_OrderWEB.AjouteLigne("Nouveaux clients :" + gtaNbClientPeriod[nLastsellerid],"","")
         			TABLEH_OrderWEB[nCurrentLine]..PoliceGras	= Vrai
         			TABLEH_OrderWEB[nCurrentLine]..Couleur		= Blanc
         			TABLEH_OrderWEB[nCurrentLine]..CouleurFond	= GrisFoncé
         			
         			
         			nCurrentLine								= TABLEH_OrderWEB.ajouteligne()
         			nSellerTotal								= 0
         			nSellerTotalEDIWEB							= 0
         			nSellerTotalEDIQuotationWEB		= 0
         			nSellerTotalQuotation			= 0
         		FIN
         		nCurrentCustomer													= TABLEH_OrderWEB.ajouteligne(stCustomer.sSellerName)
         		sLastSeller															= stCustomer.sSellerName
         		nLastsellerid = stCustomer.nSellerID
         		TABLEH_OrderWEB.COL_CustomerNumber[nCurrentCustomer]..PoliceGras	= vrai
         	fin   
         	
         	nSellerTotalEDIWEB += stCustomer.nInvoicesNumber
         	nSellerTotal += stCustomer.nInvoicesNumbertotal
         	nSellerTotalEDIQuotationWEB += stCustomer.nWebQuotationNumber
         	nSellerTotalQuotation += stCustomer.nQuotationNumberTotal
         	nTotalQuotation += stCustomer.nWebQuotationNumber
         	ngTotalQuotation += stCustomer.nQuotationNumberTotal
         		
         	TABLEH_OrderWEB.AjouteFils(nCurrentCustomer,stCustomer.sCustomerNumber,stCustomer.sCustomerName,stCustomer.dCreationdate,stCustomer.nInvoicesNumber,stCustomer.nInvoicesNumberTotal,stCustomer.sPercentage,stCustomer.nWebQuotationNumber,stCustomer.nQuotationNumberTotal,stCustomer.sPercentageQuotation)
         FIN
         
         nCurrentLine												= TABLEH_OrderWEB.Ajouteligne("Nombre de clients :" + gtaNbClient[nLastsellerid],Répète(" ",80)+"Total","",nSellerTotalEDIWEB,nSellerTotal,"",nSellerTotalEDIQuotationWEB,nSellerTotalQuotation)
         TABLEH_OrderWEB[nCurrentLine]..PoliceGras					= Vrai
         TABLEH_OrderWEB[nCurrentLine]..Couleur						= Blanc
         TABLEH_OrderWEB[nCurrentLine]..CouleurFond					= GrisFoncé
         nCurrentLine								= TABLEH_OrderWEB.AjouteLigne("Nouveaux clients :" + gtaNbClientPeriod[nLastsellerid],"","")
         //TABLEH_OrderWEB.COL_CustomerName[nCurrentLine].fusion = fusionCelluleSuivante
         TABLEH_OrderWEB[nCurrentLine]..PoliceGras	= Vrai
         TABLEH_OrderWEB[nCurrentLine]..Couleur		= Blanc
         TABLEH_OrderWEB[nCurrentLine]..CouleurFond	= GrisFoncé
         
         sablier(faux)
         
         SAI_QtyTotalWeb	= nTotalEDIWEB
         SAI_QtyTotal	= nTotal
         si SAI_QtyTotal <> 0 alors SAI_Percentage = SAI_QtyTotalWeb / SAI_QtyTotal
         SAI_QtyTotalWebQuotation	= nTotalQuotation
         SAI_QtyTotalQuotation	= ngTotalQuotation
         SI SAI_QtyTotalQuotation <> 0 ALORS SAI_PercentageQuotation = SAI_QtyTotalWebQuotation / SAI_QtyTotalQuotation
         
        type : 18
      -
        type : 161
        enabled : false
