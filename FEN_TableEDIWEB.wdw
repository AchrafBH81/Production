 popup_menus : []
 message_bar :
  internal_properties : CQAAAAkAAAAjFWXItEk/EPvcbGR+hALkgRfdOpVtIn+yZNxHnmSRFJegE/AnD2HbGAaMfhGCqfzkryHG9FVhjtF+iQYkZ59QBQ88Okhh0vjCoVhOagox2hvIqrJnU30QK15/ZA==
 actionbar : {}
 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1+
      PROCEDURE MaFenêtre()
      
      tabWebInvoices	est un tableau de STFactureEDIWEB
      sCurrentTri est une chaine
      gtaNbClient est un tableau associatif d'entier
      gtaNbClientPeriod est un tableau associatif d'entier
   -
     code : |1+
      sCurrentTri  = ChargeParamètre("EDIWEBTRI")
      sdReqSqlNbClient est une source de donnees
      sTxtsqlnbclient est un chaine = [
      select count(cvendeur) as NBClient,cvendeur from client where client.ediType = 1 group by cvendeur
      ]
      
      si HExécuteRequêteSQL(sdReqSqlNbClient,hRequêteDéfaut,sTxtsqlnbclient) alors
      	pour TOUT sdReqSqlNbClient 
      		gtaNbClient[sdReqSqlNbClient.cvendeur] = sdReqSqlNbClient.nbclient
      		SAI_NBClient+= sdReqSqlNbClient.nbclient
      	FIN
      FIN
      
      
     type : 34
   -
     code : |1+
      
      
      
     type : 177
   -
     type : 180
     enabled : false
   -
     type : 230
     enabled : false
   -
     code : |1+
      SauveParamètre("EDIWEBTRI",scurrenttri)
      
     type : 2
  procedures :
   -
     name : SetTableTRI
     internal_properties : CQAAAAkAAABk4YC7Fka7H4MLsX+Fscjmy27HYufty5JBAsOc5/G2Gq7Xmq74pwc0Bu/eKQY0Up6j/pIWhguUy8Q+DhbAVsXogHiuYExFPE8fipL1VgyvM9YojdBxzVXk
     procedure_id : 1620722935747090009
     type_code : 14
     code : |1-
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //SetTableTRI ()
      //
      // Paramètres :
      //	Aucun
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //// Procédure automatique :
      // La procédure est exécutée automatiquement, après le code d'initialisation de la fenêtre, avec un différé de 1 seconde
      // Elle sera répétée en boucle, en attendant 5 secondes entre chaque appel
      // Un nouveau timer est créé pour chaque appel à la procédure
      // 
      
      procédure SetTableTRI()
      
      si TABLEH_OrderWEB.ColonnesTriées() <> "" alors
      	sCurrentTri = TABLEH_OrderWEB.ColonnesTriées()
      FIN
     type : 458752
