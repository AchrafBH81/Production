 controls :
  -
    name : Combo_IntercalaireCouleurs
    identifier : 0x5145ec1115501cb0
    internal_properties : 
    properties :
     x : 119
     y : 74
     width : 320
     height : 24
    dropdown :
     internal_properties : 
     properties :
      height : 152
     type : 7
    type : 14
    code_elements :
     type_code : 23
     p_codes :
      -
        code : |1+
         ListeSelectPlus(Combo_IntercalaireCouleurs,1)
         
         
        type : 14
      -
        code : |1+
         HExécuteRequête(RequeteIntercalaire,hModifieFichier,Combo_IntercalaireCouleurs)
         TableAffiche(Table_Intercalaire,taDébut)
        type : 33
      -
        type : 17
        enabled : false
  -
    name : Bouton1
    identifier : 0x5145ec45671ae8e3
    internal_properties : 
    properties :
     x : 860
     y : 24
     width : 80
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         
         
         pour tout CatSpacer 
         	hraz(Intercalaires)
         	intercalaires.Abreviation = CatSpacer.Abreviation
         	intercalaires.Description = catspacer.Description
         	Intercalaires.OrdreAffichage =  CatSpacer.OrdreAffichage
         	selon catspacer.Identifiant 
         		cas "T"
         			intercalaires.dimdoublescellantA = config.cDoubleScellantAT
         			intercalaires.dimdoublescellantM = config.cDoubleScellantMT
         		cas "I"
         			intercalaires.dimdoublescellantA = config.cDoubleScellantAi
         			intercalaires.dimdoublescellantM = config.cDoubleScellantMi
         		cas "A"
         			intercalaires.dimdoublescellantA = config.cDoubleScellantA
         			intercalaires.dimdoublescellantM = config.cDoubleScellant
         	FIN
             hajoute(Intercalaires)
         FIN
         
         pour tout typespac
         	IntercalaireCouleurs.DescriptionCourte = typespac.tdesccourte
         	IntercalaireCouleurs.Description = typespac.tdescription
         	IntercalaireCouleurs.DescriptionAnglais = typespac.tdescriptiona
         	IntercalaireCouleurs.DesctiptionCourteAnglais = typespac.tdesccourtea
         	IntercalaireCouleurs.CouleurFond = typespac.icOuleur
         	IntercalaireCouleurs.CouleurTexte = typespac.icOuleurtexte
         	hlitrecherche(Intercalaires,IDIntercalaires,typespac.ttype)
         	IntercalaireCouleurs.idIntercalaires = Intercalaires.IDIntercalaires
         	IntercalaireCouleurs.ordreaffichage = Intercalaires.OrdreAffichage
         	hajoute(IntercalaireCouleurs)
         	
         FIN
         
         
         pour tout spacer sur snumero
         
         	selon spacer.stype
         		cas "A"
         			IntercalaireCouleurDimensions.Description = spacer.sdescription
         			IntercalaireCouleurDimensions.DimensionI = spacer.Sdimension
         			IntercalaireCouleurDimensions.numero = spacer.snumero
         			IntercalaireCouleurDimensions.DimensionI = spacer.Sdimension
         			IntercalaireCouleurDimensions.IDIntercalaireCouleurs = 4
         			IntercalaireCouleurDimensions.ToleranceMoins = spacer.stoleranceBMoins
         			IntercalaireCouleurDimensions.TolerancePlus = spacer.stoleranceB
         			hajoute(IntercalaireCouleurDimensions)
         
         		cas "I"
         			si spacer.Sinexblanc
         				IntercalaireCouleurDimensions.Description = spacer.sdescription
         				IntercalaireCouleurDimensions.DimensionI = spacer.Sdimension
         				IntercalaireCouleurDimensions.numero = spacer.snumero
         				IntercalaireCouleurDimensions.DimensionI = spacer.Sdimension
         				IntercalaireCouleurDimensions.IDIntercalaireCouleurs = 1
         				IntercalaireCouleurDimensions.ToleranceMoins = spacer.stoleranceBMoins
         				IntercalaireCouleurDimensions.TolerancePlus = spacer.stoleranceB
         				hajoute(IntercalaireCouleurDimensions)
         			fin
         			si spacer.Sinexnoir
         				IntercalaireCouleurDimensions.Description = spacer.sdescription
         				IntercalaireCouleurDimensions.DimensionI = spacer.Sdimension
         				IntercalaireCouleurDimensions.numero = spacer.snumero
         				IntercalaireCouleurDimensions.DimensionI = spacer.Sdimension
         				IntercalaireCouleurDimensions.IDIntercalaireCouleurs = 3
         				IntercalaireCouleurDimensions.ToleranceMoins = spacer.stoleranceNMoins
         				IntercalaireCouleurDimensions.TolerancePlus = spacer.stoleranceN
         				hajoute(IntercalaireCouleurDimensions)
         			fin
         			si spacer.Sinexgris
         				IntercalaireCouleurDimensions.Description = spacer.sdescription
         				IntercalaireCouleurDimensions.DimensionI = spacer.Sdimension
         				IntercalaireCouleurDimensions.numero = spacer.snumero
         				IntercalaireCouleurDimensions.DimensionI = spacer.Sdimension
         				IntercalaireCouleurDimensions.IDIntercalaireCouleurs = 2
         				IntercalaireCouleurDimensions.ToleranceMoins = spacer.stoleranceGMoins
         				IntercalaireCouleurDimensions.TolerancePlus = spacer.stoleranceB
         				hajoute(IntercalaireCouleurDimensions)
         			fin
         		cas "T"
         			si spacer.Sinexblanc
         				IntercalaireCouleurDimensions.Description = spacer.sdescription
         				IntercalaireCouleurDimensions.DimensionI = spacer.Sdimension
         				IntercalaireCouleurDimensions.numero = spacer.snumero
         				IntercalaireCouleurDimensions.DimensionI = spacer.Sdimension
         				IntercalaireCouleurDimensions.IDIntercalaireCouleurs = 5
         				IntercalaireCouleurDimensions.ToleranceMoins = spacer.stoleranceBMoins
         				IntercalaireCouleurDimensions.TolerancePlus = spacer.stoleranceB
         				hajoute(IntercalaireCouleurDimensions)
         			fin
         			si spacer.Sinexnoir
         				IntercalaireCouleurDimensions.Description = spacer.sdescription
         				IntercalaireCouleurDimensions.DimensionI = spacer.Sdimension
         				IntercalaireCouleurDimensions.numero = spacer.snumero
         				IntercalaireCouleurDimensions.DimensionI = spacer.Sdimension
         				IntercalaireCouleurDimensions.IDIntercalaireCouleurs = 6
         				IntercalaireCouleurDimensions.ToleranceMoins = spacer.stoleranceNMoins
         				IntercalaireCouleurDimensions.TolerancePlus = spacer.stoleranceN
         				hajoute(IntercalaireCouleurDimensions)
         			fin
         			si spacer.Sinexgris
         				IntercalaireCouleurDimensions.Description = spacer.sdescription
         				IntercalaireCouleurDimensions.DimensionI = spacer.Sdimension
         				IntercalaireCouleurDimensions.numero = spacer.snumero
         				IntercalaireCouleurDimensions.DimensionI = spacer.Sdimension
         				IntercalaireCouleurDimensions.IDIntercalaireCouleurs = 0
         				IntercalaireCouleurDimensions.ToleranceMoins = spacer.stoleranceGMoins
         				IntercalaireCouleurDimensions.TolerancePlus = spacer.stoleranceB
         				hajoute(IntercalaireCouleurDimensions)
         			fin
         
         
         	FIN
         
         
         FIN
        type : 18
      -
        type : 161
        enabled : false
