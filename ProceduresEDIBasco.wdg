   -
     name : ConvertAnglais
     procedure_id : 1919711015649468223
     type_code : 15
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] ConvertAnglais (<variable> [, <provenance>])
      //
      // Paramètres :
      // 	variable : <indiquez ici le rôle de variable>
      // 	provenance (valeur par défaut="") : < indiquez ici le rôle de provenance >
      // Valeur de retour :
      // 	réel : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE ConvertAnglais(variable,provenance = "")
      MemCrée("Tableau_millimetre")
      MemCrée("Tableau_anglais")
      MemCrée("Tableau_metrique")
      remplittableauAnglaisMetrique()
      
      //variable est une chaine = moimeme
      HLitPremier("config","COCLEUNIK")
      longueur est un entier = taille(variable)
      position_espace est un entier = position(variable," ")
      //position_espace1 est un entier = position(variable," ",position_espace+1)
      resultat_gauche est une chaine  
      resultat_droit est une chaine        
      valeuraretourner est un reel
      SI position_espace = 0 ALORS
      	SI Position(variable,"/") = 0 ALORS
      		resultat_gauche = ""
      	SINON
      		resultat_gauche = "0"
      	FIN	
      SINON	
      	
      	resultat_gauche = Gauche(variable,position_espace-1)
      	
      FIN
      SI position_espace = 0 ALORS
      	
      	resultat_droit = variable
      	
      SINON	
      	
      	resultat_droit = Milieu(variable,position_espace +1, longueur - position_espace)
      	
      FIN
      
      
      SI PAS Position(resultat_droit,"/") = 0 ALORS
      	resultat_droit = MemRecherche("tableau_metrique",resultat_droit)
      FIN
      
      
      
      
      
      SI provenance = "fini" ALORS
      	valeuraretourner = resultat_gauche+resultat_droit
      	
      SINON
      	MoiMême = resultat_gauche+resultat_droit
      	valeuraretourner = Vrai
      	
      FIN
      
      SI Val(MoiMême) > gclConfig.m_rDimensionmaxanglais ET PAS MoiMême = "" ALORS
      
      	valeuraretourner = Faux
      FIN
      
      
      
      RENVOYER valeuraretourner
      
      
     type : 458752
   -
     name : CalculAnglais
     procedure_id : 1919711015649795903
     type_code : 15
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] CalculAnglais (<dimensionacalculer>)
      //
      // Paramètres :
      // 	dimensionacalculer : <indiquez ici le rôle de dimensionacalculer>
      // Valeur de retour :
      // 	chaîne : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE CalculAnglais(dimensionacalculer)
      
      // ramener une valeur décimale en anglais
      
      j est un entier = memoccurrence("tableau_anglais")
      k est un entier = 1
      lapartiedecimaletexte est une chaine = ""
      lapartieentiere est une chaine = sansespace(numeriqueverschaine(partieentiere(val(dimensionacalculer)/25.4)))
      lapartiedecimale est un entier = arrondi(partiedecimale(val(dimensionacalculer)/25.4),3)*1000
      
      SI lapartiedecimale > 0 ALORS
      	MemPremier("tableau_anglais")
      	TANTQUE MemValClé("tableau_anglais") < lapartiedecimale 
      		SI MemEnCours("tableau_anglais") = j ALORS
      			SORTIR
      		SINON	
      			MemSuivant("tableau_anglais")
      		FIN
      	FIN
      	
      	SI MemValClé("tableau_anglais") < lapartiedecimale ALORS
      		lapartiedecimaletexte = ""
      		lapartieentiere = NumériqueVersChaîne(Val(lapartieentiere)+1)
      	SINON
      		
      		lapartiedecimaletexte = MemRécupère("tableau_anglais",MemEnCours("tableau_anglais"))
      	FIN
      SINON
      	lapartiedecimaletexte = ""
      FIN
      
      RENVOYER lapartieentiere + " "+lapartiedecimaletexte
     type : 458752
   -
     name : CalculFraction
     procedure_id : 1919711015649861439
     type_code : 15
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] CalculFraction (<dimensionacalculer>)
      //
      // Paramètres :
      // 	dimensionacalculer : <indiquez ici le rôle de dimensionacalculer>
      // Valeur de retour :
      // 	chaîne : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE CalculFraction(dimensionacalculer)
      // ramener une valeur décimale en anglais
      
      j est un entier = memoccurrence("tableau_anglais")
      k est un entier = 1
      lapartiedecimaletexte est une chaine = ""
      lapartieentiere est une chaine = partieentiere(dimensionacalculer)
      lapartiedecimale est un entier = arrondi(partiedecimale(dimensionacalculer)*1000)
      //lapartiedecimale -= config.ToleranceMilli  // tolérance millimetre pour calcul des fractions
      //lapartiedecimale -= client.Tolerancei  // tolérance millimetre pour calcul des fractions
      SI lapartiedecimale > 0 ALORS
      	MemPremier("tableau_anglais")
      	
      	TANTQUE MemValClé("tableau_anglais") < lapartiedecimale 
      		SI MemEnCours("tableau_anglais") = j ALORS
      			SORTIR
      		SINON	
      			MemSuivant("tableau_anglais")
      		FIN
      	FIN
      	SI MemValClé("tableau_anglais") < lapartiedecimale ALORS
      		lapartiedecimaletexte = ""
      		lapartieentiere = NumériqueVersChaîne(Val(lapartieentiere)+1)
      	SINON
      		
      		lapartiedecimaletexte = MemRécupère("tableau_anglais",MemEnCours("tableau_anglais"))
      	FIN
      	
      SINON
      	lapartiedecimaletexte = ""
      FIN
      
      RENVOYER lapartieentiere + " "+lapartiedecimaletexte
      
