   -
     name : ConvertMetrique
     procedure_id : 1919711015649992511
     type_code : 15
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] ConvertMetrique (<variable>)
      //
      // Paramètres :
      //	variable : <indiquez ici le rôle de variable>
      // Valeur de retour :
      // 	Type indéterminé : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      //	videpermis (valeur par défaut=1) : < indiquez ici le rôle de videpermis >
      PROCEDURE ConvertMetrique(variable)
      
      
      longueur est un entier = taille(variable)
      partie_decimale est une chaine
      partie_entier est une chaine
      SI longueur <> 0 ALORS
      	SI Position(variable,".") = 0 ALORS
      		SI longueur <= 3 ALORS
      			variable = "."+Répète("0",3-longueur)+variable
      		SINON
      			partie_decimale = Droite(variable,3)
      			partie_entier   = Gauche(variable,longueur-3)
      			variable = partie_entier+"."+partie_decimale
      		FIN
      	FIN
      FIN 	
      
      
      RENVOYER variable
      
      
