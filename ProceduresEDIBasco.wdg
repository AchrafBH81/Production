   -
     name : ValideCondition
     procedure_id : 1924892874808943130
     type_code : 15
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] ValideCondition (<condition>, <ocalculator> est Calculator)
      //
      // Paramètres :
      //	condition :<indiquez ici le rôle de condition>
      //	ocalculator (Calculator) :<indiquez ici le rôle de ocalculator>
      // Valeur de retour :
      // 	Type indéterminé : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE ValideCondition(condition,ocalculator est un calculator)
      
      
      
      _formule est une chaine = sansespace(condition)
      si _formule = "" alors renvoyer faux
      _comparaison est une chaîne = GetPositionComparaison(_formule)
      si _comparaison = "" alors renvoyer Faux
      
      
      ChaineGauche est une chaine = sansespace(ExtraitChaîne(condition,1,_comparaison))
      ChaineDroite est une chaine = sansespace(ExtraitChaîne(condition,2,_comparaison))
      ValeurGauche est un reel = ocalculator.Compute(ChaineGauche)
      ValeurDroite est un reel = ocalculator.Compute(ChaineDroite)
      
      
      renvoyer evalueexpression(ValeurGauche +_comparaison + ValeurDroite)
      
     type : 458752
   -
     name : GetPositionComparaison
     procedure_id : 1924905557867622613
     type_code : 15
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] GetPositionComparaison (<condition>)
      //
      // Paramètres :
      //	condition :<indiquez ici le rôle de contition>
      // Valeur de retour :
      // 	chaîne ANSI : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE GetPositionComparaison(condition)
      
      SI Position(condition,">=") ALORS RENVOYER ">="
      SI Position(condition,"<=") ALORS RENVOYER "<="
      SI Position(condition,"<>") ALORS RENVOYER "<>"
      SI Position(condition,"<") ALORS RENVOYER "<"
      SI Position(condition,">") ALORS RENVOYER ">"
      SI Position(condition,"=") ALORS RENVOYER "="
      
      RENVOYER ""
      
      
      
     type : 458752
   -
     name : CalculPrixLigne
     procedure_id : 1983584663760242419
     type_code : 15
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] CalculPrixLigne (<IdCommande> est entier, <NoLigne> est entier)
      //
      // Paramètres :
      //	IdCommande (entier) :<indiquez ici le rôle de IdCommande>
      //	NoLigne (entier) :<indiquez ici le rôle de NoLigne>
      // Valeur de retour :
      // 	variant : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE CalculPrixLigne(IdCommande est un entier,NoLigne est un entier)
      
      TotalLigne est un numerique
      reqsql1 est une source de données
      txtsql est une chaîne = [
      	select ftype, fdnumprod,fdqte,fdprixu,fdprixtotal,surchargeenergie,ftotalpeinture,fdextra5x,fdextra10x 
      	from fdetail where fdetail.fdnocomm = %1 and fdetail.fdligneEdi = %2
      	]
      	
      		
      		
      
      
      si HExécuteRequêteSQL(reqsql1,hRequêteDéfaut,ChaîneConstruit(txtsql,IdCommande,NoLigne)) alors
      	    pour TOUT reqsql1 
      	    	selon reqsql1.ftype
      	    		cas 1
      	    		  TotalLigne+= reqsql1.fdprixtotal+reqsql1.surchargeenergie+reqsql1.fdextra5x+reqsql1.fdextra10x
      			CAS 2
      				TotalLigne+= reqsql1.fdprixtotal
      				
      			CAS 4
      				TotalLigne+= reqsql1.fdprixtotal+reqsql1.ftotalpeinture
      				
      	    		
      	    	
      	    	fin	
      	    	
      	    FIN
      	sinon
      	 //
      FIN
      
      renvoyer arrondi(TotalLigne,2)
     type : 458752
   -
     name : SendEdiBascoConfirmation
     procedure_id : 2031776722248016099
     type_code : 15
     code : |1+
      PROCEDURE SendEdiBascoConfirmation(SaisieNo)
      
      //FtpHost est une chaîne UNICODE = "ftp://influencefx.ddns.net"
      //FtpUsername est une chaîne UNICODE = "trn"
      //FtpPassword est une chaîne UNICODE = "trn123"
      //FtpFolderRoot est une chaîne UNICODE = "/Sandbox/Suppliers/ThermosRiveNord/"
      
      //FtpHost est une chaîne UNICODE = "ftp://prod1.seigma.com"
      //FtpUsername est une chaîne UNICODE = "basco-trn"
      //FtpPassword est une chaîne UNICODE = "hJ6ef7p3ZLj3"
      FtpHost			est une chaîne UNICODE		= gclconfig.m_sBascoFTPAddress
      //FtpHost		est une chaine UNICODE		= ExtraitChaîne(gclConfig.m_sBascoFTPAddress,1)
      //FtpPort		est un entier				= ExtraitChaîne(gclConfig.m_sBascoFTPAddress,2)
      FtpUsername		est une chaîne UNICODE		= gclConfig.m_sBascoUser
      FtpPassword		est une chaîne UNICODE		= gclConfig.m_sBascoPassword
      FtpFolderRoot	est une chaîne UNICODE		= "/"
      TotalAvantTaxe	est un MONETAIRE
      TPS				est un MONETAIRE
      TVQ				est un MONETAIRE
      TaxeTaux1		est un reel
      TaxeTaux2		est un reel
      TaxeCombine		est un booleen
      GrandTotal		est un MONETAIRE
      _tableautaxe	est un tableau dynamique
      
      SI EnModeTest() ALORS
      	FtpHost			= "ftp://192.168.1.47"
      	FtpUsername		= "trn"
      	FtpPassword		= "trn"
      	FtpFolderRoot	= "/"
      	
      FIN
      
      
      _item est une Structure
      	Quantity			est un entier
      	UnitCost			est un réel
      	Width				est une chaîne
      	height				est une chaîne
      	Finish				est une chaîne
      	GrillBase			est une chaîne
      	GrillHeight			est une chaîne
      	GrillSupplierCode	est une chaîne
      	ShapeSupplierCode	est une chaîne
      	GrillHalfThermos	est un booléen
      	GrillInteriorColor	est une chaîne 
      	GrillExteriorColor	est une  chaîne 
      	_Spacer				est une chaîne
      	PurchaseOrderItemID	est une chaîne
      FIN
      
      
      txtsql est une chaîne =  [
      	select fdqteafacturer,fdligneedi,fdlargeur,fdhauteur,ffini,fdcarreauv,fdcarreauh,ftypespacer,idpurchaseorderitemEDI,fdnumcarr,Tdemicarrelage 
      	, fnopeintureexttout,fnopeintureinterieure from fdetail where ftype = 1 and fdetail.fdnocomm = %1 order by fdligneedi
      ]
      txtsql = ChaîneConstruit(txtsql,SaisieNo)
      reqsql			est une source de Données
      reqsqlPeinture	est une source de Données
      tabLigne		est un tableau associatif de _item
      SI HExécuteRequêteSQL(reqsql,hRequêteDéfaut,txtsql) ALORS
      	POUR TOUT reqsql 
      		_Unitem est un _item
      		_Unitem.Quantity			= reqsql.fdqteafacturer
      		_Unitem.Width				= reqsql.fdlargeur
      		_Unitem.height				= reqsql.fdhauteur
      		_Unitem.Finish				= reqsql.ffini
      		_Unitem.GrillBase			= reqsql.fdcarreauv
      		_Unitem.GrillHeight			= reqsql.fdcarreauh
      		_Unitem.GrillSupplierCode	= reqsql.fdnumcarr
      		_Unitem.GrillExteriorColor	= reqsql.fnopeintureexttout
      		_Unitem.GrillInteriorColor	= reqsql.fnopeintureinterieure
      		_Unitem.GrillHalfThermos	= reqsql.Tdemicarrelage
      		SI HLitRecherche(IntercalaireCouleurs,IDIntercalaireCouleurs,reqsql.ftypespacer) ALORS
      			_Unitem._Spacer = IntercalaireCouleurs.DescriptionCourte
      		FIN
      		_Unitem.PurchaseOrderItemID	= reqsql.idpurchaseorderitemedi
      		tabLigne[reqsql.fdligneedi]	=  _Unitem
      	FIN
      	
      FIN
      
      txtsql =  [
      	select sum(round(fdprixtotal,2)) as totthermos,sum(round(fdetail.surchargeenergie,2)) as totSurcharge,sum(round((fdetail.FDextra5x+fdetail.FDextra10X)*fdetail.fdqte,2)) as totextra
      	,sum(round(fdetail.PietageArgon*fdetail.ExtraArgonPrice*fdetail.fdqte,2)) as TotExtraArgon,sum(fdetail.ftotalpeinture) as TotPeinture,IDPurchaseOrderItemEdi,fdligneEdi ,fdqte,fdqteafacturer
      	from fdetail where fdnocomm = %1 AND FDnumprod <> '%2' group by IDPurchaseOrderItemEdi,fdligneedi ,fdqte,fdqteafacturer order by fdligneedi
      ]
      sTxtsqlpeinture est une chaine = [
      	select sum(round(fdetail.ftotalpeinture*fdetail.fdqte,2)) as TotPeinture,IDPurchaseOrderItemEdi,fdligneEdi ,fdqte,fdqteafacturer
      	from fdetail where fdnocomm = %1 AND FDnumprod <> '%2' and ftype <> 4 group by IDPurchaseOrderItemEdi,fdligneedi ,fdqte,fdqteafacturer order by fdligneedi
      ]
      
      txtsql			= ChaîneConstruit(txtsql,SaisieNo,gsExtraArgon)
      sTxtsqlpeinture	= chaineconstruit(sTxtsqlpeinture,SaisieNo,gsExtraArgon)
      SI HExécuteRequêteSQL(reqsqlPeinture,hRequêteDéfaut,sTxtsqlpeinture) ALORS
      	
      fin
      
      rTotPeinture est un reel	
      
      
      SI HExécuteRequêteSQL(reqsql,hRequêteDéfaut,txtsql) ALORS
      	POUR TOUT reqsql 
      		si reqsql.fdqte <> 0 alors
      			si hlitrecherche(reqsqlPeinture,fdligneedi,reqsql.fdligneedi) alors
      				rTotPeinture = reqsqlPeinture.totpeinture
      			sinon
      				rTotPeinture = 0
      				
      			fin
      			TotalAvantTaxe += (reqsql.totthermos+ reqsql.totsurcharge+reqsql.totextra+reqsql.totExtraArgon+rTotPeinture) * reqsql.fdqteafacturer / reqsql.fdqte
      			si reqsql.fdligneedi <> 0 alors
      				si tabLigne[reqsql.fdligneedi].Quantity <> 0 alors
      					tabLigne[reqsql.fdligneedi].UnitCost = (reqsql.totthermos+ reqsql.totsurcharge+reqsql.totextra+reqsql.totExtraArgon+rTotPeinture) /   tabLigne[reqsql.fdligneedi].Quantity
      				sinon
      					tabLigne[reqsql.fdligneedi].UnitCost = 0
      				fin
      			FIN
      			
      		fin
      	FIN
      FIN
      
      
      //TotalTVH = Arrondi(TotalAvantTaxe * TaxeTaux1 / 100,2)
      //TotalTVQ = Arrondi((totalfacture + totalsurcharge+TotalSurchargeTaux+(TaxeCombine ? TotalTVH SINON 0)) * TaxeTaux2 / 100,2)
      //GrandTotal = Totaldefacture + TotalTVH + TotalTVQ
      
      SI HLitRecherche(Facture,fanumero,SaisieNo) ALORS
      	_tableautaxe = trouvetauxtaxe("139",DateValide(Facture.fadate) ? Facture.fadate SINON DateSys())
      	SI Dimension(_tableautaxe) >= 4 ALORS
      		TaxeTaux1 = _tableautaxe[1,2]
      		//	TaxeGL1 = _tableautaxe[1,3]
      	FIN
      	SI Dimension(_tableautaxe) = 8 ALORS
      		TaxeTaux2	= _tableautaxe[2,2]
      		//	TaxeGL2 = _tableautaxe[2,3]
      		TaxeCombine	= _tableautaxe[2,4]
      	FIN
      	
      	
      	
      	
      	TPS			= Arrondi(TotalAvantTaxe * TaxeTaux1 / 100,2)
      	TVQ			= Arrondi((TotalAvantTaxe+(TaxeCombine ? TPS SINON 0)) * TaxeTaux2 / 100,2)
      	GrandTotal	= TotalAvantTaxe+ TPS + TVQ
      	
      	
      	_purchaseConfirmation est un PurchaseConfirmationDto
      	//	_purchaseConfirmation.OrderNumber = sansespace(facture.fanojob)
      	_purchaseConfirmation.SubTotal			= TotalAvantTaxe
      	_purchaseConfirmation.TPS				= TPS
      	_purchaseConfirmation.TVQ				= TVQ
      	_purchaseConfirmation.Total				= GrandTotal
      	_purchaseConfirmation.ReferenceNumber	= Facture.fanumero
      	_purchaseConfirmation.EdiKey			= Facture.IdEdiKey
      	_purchaseConfirmation.PurchaseOrderId	= Facture.IdPurchaseOrderEdi
      	_purchaseConfirmation.set_Display(SansEspace(remplace(Facture.fanocommande,""""," ")))
      	
      	eta est un datetime = Facture.FDATEREQUISe
      	_purchaseConfirmation.ETADate				= eta
      	//	_purchaseConfirmation.BascoFranchise = facture.lNom
      	_purchaseConfirmation.BillingStreet			= Facture.adresse
      	_purchaseConfirmation.BillingCity			= Facture.ville
      	_purchaseConfirmation.BillingPostalCode		= Facture.CodePostal
      	
      	//	si hlitrecherche(ClientLivraison,IDClientLivraison,facture.idLivraison) alors
      	_purchaseConfirmation.ShippingStreet		= ClientLivraison.lRue
      	_purchaseConfirmation.ShippingCity			= ClientLivraison.lVille
      	_purchaseConfirmation.ShippingPostalCode	= ClientLivraison.lCodePostal
      	//	FIN
      	tabPurchaseconfirmationitem est un "List<PurchaseConfirmationItemDTo>"	
      	POUR CHAQUE _ligne de tabLigne
      		_purchaseitemconfirmation est un PurchaseConfirmationItemDto
      		_purchaseitemconfirmation.PurchaseOrderId		= Facture.IdPurchaseOrderEdi
      		_purchaseitemconfirmation.PurchaseOrderItemId	= _ligne.PurchaseOrderItemID
      		_purchaseitemconfirmation.Quantity				= _ligne.Quantity
      		_purchaseitemconfirmation.UnitCost				= _ligne.UnitCost
      		_purchaseitemconfirmation.Finish				= _ligne.Finish
      		_purchaseitemconfirmation.width					= _ligne.Width
      		_purchaseitemconfirmation.Height				= _ligne.height
      		_purchaseitemconfirmation.GrillBase				= _ligne.GrillBase
      		_purchaseitemconfirmation.Grillheight			= _ligne.GrillHeight
      		_purchaseitemconfirmation.GrillHalfThermos		= _ligne.GrillHalfThermos
      		_purchaseitemconfirmation.spacer				= _ligne._Spacer
      		_purchaseitemconfirmation.GrillSupplierCode		= _ligne.GrillSupplierCode
      		_purchaseitemconfirmation.GrillInteriorColor	=  _ligne.GrillInteriorColor
      		_purchaseitemconfirmation.GrillExteriorColor	= _ligne.GrillExteriorColor
      		tabPurchaseconfirmationitem.add(_purchaseitemconfirmation)
      	FIN
      	_purchaseConfirmation.set_PurchaseConfirmationItems(tabPurchaseconfirmationitem)
      FIN
      
      
      
      
      
      
      //_purchaseConfirmation est un PurchaseConfirmationDto
      //_purchaseConfirmation.OrderNumber = "Salut les amis"
      //_purchaseConfirmation.EdiKey = edikeyPO
      //_purchaseConfirmation.PurchaseOrderId = idPO
      //_purchaseConfirmation.set_Display("TestCF-1234")
      
      //_purchaseitemconfirmation est un PurchaseConfirmationItemDto
      ////_purchaseitemconfirmation.set_PurchaseOrderId("123456")
      //_purchaseitemconfirmation.set_PurchaseOrderItemId(DonneGUID())
      //_purchaseitemconfirmation.set_PurchaseOrderId(idPO)
      ////_purchaseitemconfirmation.set_VisibleIndex(1)
      ////_purchaseitemconfirmation.set_Sku("Sku")
      ////_purchaseitemconfirmation.set_SquareFootPrice(10)
      ////_purchaseitemconfirmation.set_SquareFootQty(6.2)
      //
      //
      //tabPurchaseconfirmationitem est un "List<PurchaseConfirmationItemDTo>"
      //tabPurchaseconfirmationitem.add(_purchaseitemconfirmation)
      ////info(tabPurchaseconfirmationitem.get_Count())
      ////info(_purchaseitemconfirmation.sku)
      //_purchaseConfirmation.set_PurchaseConfirmationItems(tabPurchaseconfirmationitem)
      //
      //testItem est un "List<PurchaseConfirmationItemDTo>"
      //testItem <- _purchaseConfirmation.get_PurchaseConfirmationItems()
      //_TestItemUn est un PurchaseConfirmationItemDto
      //_TestItemUn <- testItem.get_Item(0)
      //
      
      
      
      
      
      
      
      
      
      _put est un PurchaseConfirmationProcessor(FtpHost,FtpUsername,FtpPassword,FtpFolderRoot+"PurchaseConfirmation/")
      _put.Put(_purchaseConfirmation)
      
      
      
      
      
      
     type : 458752
   -
     name : ClosePurchaseorder
     procedure_id : 2086248229142781583
     type_code : 15
     code : |1-
      PROCEDURE ClosePurchaseorder(sPurchaseOrderID est une chaine)
      
      
      
      //FtpHost est une chaîne UNICODE = "ftp://prod1.seigma.com"
      //FtpUsername est une chaîne UNICODE = "basco-trn"
      //FtpPassword est une chaîne UNICODE = "hJ6ef7p3ZLj3"
      FtpHost		est une chaîne UNICODE	= gclconfig.m_sBascoFTPAddress
      //FtpHost		est une chaine UNICODE		= ExtraitChaîne(gclConfig.m_sBascoFTPAddress,1)
      //FtpPort		est un entier				= ExtraitChaîne(gclConfig.m_sBascoFTPAddress,2)
      FtpUsername	est une chaîne UNICODE		= gclConfig.m_sBascoUser
      FtpPassword	est une chaîne UNICODE	= gclConfig.m_sBascoPassword
      FtpFolderRoot est une chaîne UNICODE = "/"
      _tabTestPurchase est un "List<PurchaseorderDTo>"
      cpt est un entier
      SI EnModeTest() ALORS
      	FtpHost = "ftp://192.168.1.47"
      	FtpUsername  = "trn"
      	FtpPassword  = "trn"
      	FtpFolderRoot  = "/"
      	
      FIN
      
      //_get est un PurchaseorderProcessor(FtpHost,FtpUsername,FtpPassword,FtpFolderRoot+"PurchaseOrder/") 
      _get est un PurchaseorderProcessor(FtpHost,FtpUsername,FtpPassword,FtpFolderRoot+"PurchaseOrder") 
      
      //_get.close(_po)
      //
      //renvoyer Vrai
      
      //Liste les commandes en cours sur le FTP
      _tabTestPurchase.AddRange(_get.get())
      // retrouve le nombre de commande
      cpt = _tabTestPurchase.get_count()
      
      
      PUOR est un PurchaseOrderDto
      
      //PI est un PurchaseOrderItemDto
      //Boucle dans toutes les commandes actives pour retrouver la commande a fermer
      POUR i = 0 _a_ cpt -1
      	
      	PUOR <- _tabTestPurchase.get_Item(i)
      	
      	SI PUOR.PurchaseOrderId = SansEspace(sPurchaseOrderID) ALORS
      		
      		_get.Close(PUOR)
      		sortir
      	FIN
      	
      FIN
     type : 458752
   -
     name : SendEdiBascoFacture
     procedure_id : 2034837882891288234
     type_code : 15
     code : |1+
      PROCEDURE SendEdiBascoFacture(SaisieNo)
      SI HLitRecherche(hfacture,fanofacture,SaisieNo) ALORS
      	si sansespace(hfacture.IdEdiKey) = "" alors renvoyer vrai
      sinon 
      	renvoyer vrai
      FIN
      //FtpHost est une chaîne UNICODE = "ftp://influencefx.ddns.net"
      //FtpUsername est une chaîne UNICODE = "trn"
      //FtpPassword est une chaîne UNICODE = "trn123"
      //FtpFolderRoot est une chaîne UNICODE = "/Sandbox/Suppliers/ThermosRiveNord/"
      
      //FtpHost est une chaîne UNICODE = "ftp://prod1.seigma.com"
      //FtpUsername est une chaîne UNICODE = "basco-trn"
      //FtpPassword est une chaîne UNICODE = "hJ6ef7p3ZLj3"
      ftpHost			est une chaîne UNICODE		= gclconfig.m_sBascoFTPAddress
      //FtpHost		est une chaine UNICODE		= ExtraitChaîne(gclConfig.m_sBascoFTPAddress,1)
      //FtpPort		est un entier				= ExtraitChaîne(gclConfig.m_sBascoFTPAddress,2)
      FtpUsername		est une chaîne UNICODE		= gclConfig.m_sBascoUser
      FtpPassword		est une chaîne UNICODE		= gclConfig.m_sBascoPassword
      FtpFolderRoot	est une chaîne UNICODE		= "/"
      TotalAvantTaxe	est un reel
      TPS				est un reel
      TVQ				est un reel
      rTaxeTaux1		est un reel
      rTaxeTaux2		est un reel
      bTaxeCombine	est un booleen
      GrandTotal		est un reel
      SubTotal		est un reel
      eta				est un datetime
      NoComm			est une chaine 
      _tableautaxe	est un tableau dynamique
      SI HLitRecherche(hfacture,fanofacture,SaisieNo) ALORS
      	//	NoComm = hfacture.fanumero
      	NoComm = hfacture.fanofacture
      FIN
      
      SI EnModeTest() ALORS
      	ftpHost			= "ftp://192.168.1.47"
      	FtpUsername		= "trn"
      	FtpPassword		= "trn"
      	FtpFolderRoot	= "/"
      	
      FIN
      _item est une Structure
      	Quantity			est un entier
      	UnitCost			est un réel
      	Width				est une chaîne
      	height				est une chaîne
      	Finish				est une chaîne
      	GrillBase			est une chaîne
      	GrillHeight			est une chaîne
      	GrillSupplierCode	est une chaîne
      	ShapeSupplierCode	est une chaîne
      	GrillHalfThermos	est un booléen
      	GrillInteriorColor	est une chaîne 
      	GrillExteriorColor	est une  chaîne 
      	_Spacer				est une chaîne
      	PurchaseOrderItemID	est une chaîne
      FIN
      
      
      
      //txtsql est une chaîne =  [
      //	select fdqte,fdligneedi,fdlargeur,fdhauteur,ffini,fdcarreauv,fdcarreauh,ftypespacer,idpurchaseorderitemEDI,fdnumcarr from hfdetail where ftype = 1 and hfdetail.fdnocomm = %1 order by fdligneedi
      //]
      txtsql est une chaîne =  [
      	select fdqteafacturer,fdligneedi,fdlargeur,fdhauteur,ffini,fdcarreauv,fdcarreauh,ftypespacer,idpurchaseorderitemEDI,fdnumcarr, fnopeintureexttout,fnopeintureinterieure 
      	from hfdetail where ftype = 1 and hfdetail.fdnofact = %1 order by fdligneedi
      ]
      txtsql = ChaîneConstruit(txtsql,NoComm)
      reqsql			est une source de Données
      reqsqlPeinture	est une source de Données
      tabLigne		est un tableau associatif de _item
      SI HExécuteRequêteSQL(reqsql,hRequêteDéfaut,txtsql) ALORS
      	POUR TOUT reqsql 
      		
      		_Unitem est un _item
      		_Unitem.Quantity			= reqsql.fdqteafacturer
      		//		_Unitem.Quantity = reqsql.fdqte
      		_Unitem.Width				= reqsql.fdlargeur
      		_Unitem.height				= reqsql.fdhauteur
      		_Unitem.Finish				= reqsql.ffini
      		_Unitem.GrillBase			= reqsql.fdcarreauv
      		_Unitem.GrillHeight			= reqsql.fdcarreauh
      		_Unitem.GrillSupplierCode	= reqsql.fdnumcarr
      		_Unitem.GrillExteriorColor	= reqsql.fnopeintureexttout
      		_Unitem.GrillInteriorColor	= reqsql.fnopeintureinterieure
      		
      		SI HLitRecherche(IntercalaireCouleurs,IDIntercalaireCouleurs,reqsql.ftypespacer) ALORS
      			_Unitem._Spacer = IntercalaireCouleurs.DescriptionCourte
      		FIN
      		_Unitem.PurchaseOrderItemID	= reqsql.idpurchaseorderitemedi
      		tabLigne[reqsql.fdligneedi]	=  _Unitem
      		
      		
      	FIN
      	
      FIN
      //txtsql =  [
      //	select sum(round(fdprixtotal,2)) as totthermos,sum(round(hfdetail.surchargeenergie,2)) as totSurcharge,IDPurchaseOrderItemEdi,fdligneEdi from hfdetail where fdnocomm = %1 group by IDPurchaseOrderItemEdi,fdligneedi order by fdligneedi
      //]
      txtsql =  [
      	select sum(round(fdprixu+frcarrprixu,2)* fdqteafacturer) as totthermos,sum(round(hfdetail.surchargeenergie,2)) as totSurcharge,
      	sum(round((hfdetail.FDextra10X+hfdetail.FDextra5x) * hfdetail.fdqteafacturer,2)) as totExtra,
      	sum(round((hfdetail.FDExtraForme) * hfdetail.fdqteafacturer,2)) as totExtraForme,
      	sum(round(hfdetail.extraArgonPrice * hfdetail.PietageArgon * hfdetail.fdqteafacturer,2)) as totExtraArgon,
      	IDPurchaseOrderItemEdi,fdligneEdi from hfdetail where hfdetail.ftype <> 4 and fdnofact = %1 and FDnumprod <> '%2'group by IDPurchaseOrderItemEdi,fdligneedi order by fdligneedi
      	//select sum(round(fdprixtotal,2)) as totthermos,sum(round(hfdetail.surchargeenergie,2)) as totSurcharge,IDPurchaseOrderItemEdi,fdligneEdi from hfdetail where fdnofact = %1 group by IDPurchaseOrderItemEdi,fdligneedi order by fdligneedi
      	
      ]
      
      sTxtsqlpeinture est une chaine = [
      	select sum(round(hfdetail.ftotalpeinture*hfdetail.fdqteafacturer,2)) as TotPeinture,IDPurchaseOrderItemEdi,fdligneEdi ,fdqte,fdqteafacturer
      	from hfdetail where fdnofact = %1 AND FDnumprod <> '%2' and ftype <> 4 group by IDPurchaseOrderItemEdi,fdligneedi ,fdqte,fdqteafacturer order by fdligneedi
      ]
      
      
      txtsql			= ChaîneConstruit(txtsql,NoComm,gsExtraArgon)
      sTxtsqlpeinture	= ChaîneConstruit(sTxtsqlpeinture,NoComm,gsExtraArgon)
      SI HExécuteRequêteSQL(reqsqlPeinture,hRequêteDéfaut,sTxtsqlpeinture) ALORS
      	
      FIN
      
      rTotPeinture est un reel	
      
      
      
      
      SI HExécuteRequêteSQL(reqsql,hRequêteDéfaut,txtsql) ALORS
      	POUR TOUT reqsql 
      		si sansespace(reqsql.IDPurchaseOrderItemEdi) <> "" alors
      			SI HLitRecherche(reqsqlPeinture,fdligneedi,reqsql.fdligneedi) ALORS
      				rTotPeinture = reqsqlPeinture.totpeinture
      			SINON
      				rTotPeinture = 0
      			FIN
      			
      			si tabLigne[reqsql.fdligneedi].Quantity <> 0 alors 
      				TotalAvantTaxe += (reqsql.totthermos+ reqsql.totsurcharge+reqsql.totextra+rTotPeinture)
      				tabLigne[reqsql.fdligneedi].UnitCost = (reqsql.totthermos+ reqsql.totsurcharge+reqsql.totextra+reqsql.totextraForme+reqsql.totExtraArgon+rTotPeinture) /   tabLigne[reqsql.fdligneedi].Quantity
      			SINON
      				tabLigne[reqsql.fdligneedi].UnitCost = 0 
      			FIN
      		FIN
      		
      	FIN
      FIN
      
      
      //TotalTVH = Arrondi(TotalAvantTaxe * TaxeTaux1 / 100,2)
      //TotalTVQ = Arrondi((totalfacture + totalsurcharge+TotalSurchargeTaux+(TaxeCombine ? TotalTVH SINON 0)) * TaxeTaux2 / 100,2)
      //GrandTotal = Totaldefacture + TotalTVH + TotalTVQ
      
      SI HLitRecherche(hfacture,fanofacture,SaisieNo) ALORS
      	SI HLitRecherche(BonLivraison,Bnumero,SaisieNo) ALORS
      		TPS			= BonLivraison.BTPS
      		TVQ			= BonLivraison.BTVQ
      		GrandTotal	= BonLivraison.BStotal+ BonLivraison.BTPS + BonLivraison.BTVQ
      		SubTotal	= BonLivraison.BStotal
      		eta			= BonLivraison.bdate
      	FIN
      	_tableautaxe = trouvetauxtaxe("139",DateValide(Facture.fadate) ? Facture.fadate SINON DateSys())
      	
      	
      	
      	_PurchaseInvoice est un PurchaseInvoiceDto
      	//	_PurchaseInvoice.OrderNumber = sansespace(facture.fanojob)
      	_PurchaseInvoice.SubTotal				= SubTotal
      	_PurchaseInvoice.TPS					= TPS
      	_PurchaseInvoice.TVQ					= TVQ
      	_PurchaseInvoice.Total					= GrandTotal
      	_PurchaseInvoice.SupplierInvoiceNumber	= BonLivraison.Bfacture
      	_PurchaseInvoice.EdiKey					= Facture.IdEdiKey
      	_PurchaseInvoice.PurchaseOrderId		= hfacture.IdPurchaseOrderEdi
      	_PurchaseInvoice.set_Display(SansEspace(hfacture.fanocommande))
      	//	eta est un datetime = hFacture.fadate
      	_PurchaseInvoice.ETADate			= eta
      	//	_PurchaseInvoice.BascoFranchise = facture.lNom
      	_PurchaseInvoice.BillingStreet		= hfacture.Adresse
      	_PurchaseInvoice.BillingCity		= hfacture.Ville
      	_PurchaseInvoice.BillingPostalCode	= hfacture.CodePostal
      	
      	//	si hlitrecherche(ClientLivraison,IDClientLivraison,facture.idLivraison) alors
      	_PurchaseInvoice.ShippingStreet		= hfacture.lRue
      	_PurchaseInvoice.ShippingCity		= hfacture.lVille
      	//		_PurchaseInvoice.ShippingPostalCode = clientlivraison.lCodePostal
      	//	FIN
      	tabPurchaseinvoiceitem est un "List<PurchaseInvoiceItemDTo>"	
      	POUR CHAQUE _ligne de tabLigne
      		_PurchaseItemInvoice est un PurchaseInvoiceItemDto
      		_PurchaseItemInvoice.PurchaseOrderId		= hfacture.IdPurchaseOrderEdi
      		_PurchaseItemInvoice.PurchaseOrderItemId	= _ligne.PurchaseOrderItemID
      		_PurchaseItemInvoice.Quantity				= _ligne.Quantity
      		_PurchaseItemInvoice.UnitCost				= _ligne.UnitCost
      		_PurchaseItemInvoice.Finish					= _ligne.Finish
      		_PurchaseItemInvoice.width					= _ligne.Width
      		_PurchaseItemInvoice.Height					= _ligne.height
      		_PurchaseItemInvoice.GrillBase				= _ligne.GrillBase
      		_PurchaseItemInvoice.Grillheight			= _ligne.GrillHeight
      		_PurchaseItemInvoice.spacer					= _ligne._Spacer
      		_PurchaseItemInvoice.GrillSupplierCode		= _ligne.GrillSupplierCode
      		_PurchaseItemInvoice.GrillInteriorColor		= _ligne.GrillInteriorColor
      		_PurchaseItemInvoice.GrillExteriorColor		= _ligne.GrillExteriorColor
      		
      		tabPurchaseinvoiceitem.add(_PurchaseItemInvoice)
      	FIN
      	_PurchaseInvoice.set_PurchaseInvoiceItems(tabPurchaseinvoiceitem)
      FIN
      
      
      
      
      
      
      
      
      
      
      
      
      
      
      _put est un PurchaseInvoiceProcessor(ftpHost,FtpUsername,FtpPassword,FtpFolderRoot+"PurchaseInvoice/")
      _put.Put(_PurchaseInvoice)
      
      
      
      
      
      
     type : 458752
   -
     name : CountBascoOrders
     procedure_id : 2287899902911076132
     type_code : 15
     code : |1-
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] CountBascoOrders ()
      //
      // Paramètres :
      //	Aucun
      // Valeur de retour :
      // 	entier : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE CountBascoOrders()
      
      //FtpHost est une chaîne UNICODE = "ftp://prod1.seigma.com"
      //FtpUsername est une chaîne UNICODE = "basco-trn"
      //FtpPassword est une chaîne UNICODE = "hJ6ef7p3ZLj3"
      FtpHost		est une chaîne UNICODE	= gclconfig.m_sBascoFTPAddress
      //FtpHost	est une chaine UNICODE		= ExtraitChaîne(gclConfig.m_sBascoFTPAddress,1)
      //FtpPort	est un entier				= ExtraitChaîne(gclConfig.m_sBascoFTPAddress,2)
      
      FtpUsername	est une chaîne UNICODE	= gclConfig.m_sBascoUser
      FtpPassword	est une chaîne UNICODE	= gclConfig.m_sBascoPassword
      FtpFolderRoot est une chaîne UNICODE = "/"
      
      SI EnModeTest() ALORS
      	FtpHost = "ftp://192.168.1.47"
      	FtpUsername  = "trn"
      	FtpPassword  = "trn"
      	FtpFolderRoot  = "/"
      	
      FIN
      po est un PurchaseOrderDto, utile
      cpt est un entier
      nCptItem est un entier
      
      _tabPurchaseOrder est un "List<PurchaseorderDTo>"
      cl_TabPurchaseOrderBasco est un TabPurchaseOrderBasco
      cl_purchaseorder est un PurchaseOrderBasco
      
      
      
      //po.BascoFranchise = "Ceci est un test"
      //po.EdiKey = DonneGUID()
      //ajoute(tabPurchaseOrder,po)
      
      
      
      
      _get est un PurchaseOrderProcessor(FtpHost,FtpUsername,FtpPassword,FtpFolderRoot+"PurchaseOrder/") 
      
      
      
      _tabPurchaseOrder.AddRange(_get.get())
      cpt = _tabPurchaseOrder.get_count()
      
      renvoyer cpt
