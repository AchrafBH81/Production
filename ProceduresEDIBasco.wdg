   -
     name : VerifieSiEnergiverre
     procedure_id : 1919711015650320191
     type_code : 15
     code : |1-
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] VerifieSiEnergiverre (<comp1> est chaîne, <comp2> est chaîne, <comp3> est chaîne)
      //
      // Paramètres :
      //	comp1 (chaîne) : <indiquez ici le rôle de comp1>
      //	comp2 (chaîne) : <indiquez ici le rôle de comp2>
      //	comp3 (chaîne) : <indiquez ici le rôle de comp3>
      // Valeur de retour :
      // 	booléen : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE VerifieSiEnergiverre(comp1 est une chaine,comp2 est une chaine,comp3 est une chaine)
      
      si sansespace(comp1) <> "" _et_ hlitrecherche(invent,INUM,comp1) alors
      	si (invent.ienergieverre OU invent.ienergieverreESC) alors renvoyer vrai
      FIN
      SI SansEspace(comp2) <> "" _ET_ HLitRecherche(Invent,INUM,comp2) ALORS
      	SI (invent.ienergieverre OU invent.ienergieverreESC) ALORS RENVOYER Vrai
      FIN
      SI SansEspace(comp3) <> "" _ET_ HLitRecherche(Invent,INUM,comp3) ALORS
      	SI (invent.ienergieverre OU invent.ienergieverreESC) ALORS RENVOYER Vrai
      FIN
      
      renvoyer faux
     type : 458752
   -
     name : RecupereCommandeEDIBasco
     procedure_id : 1919711015650385727
     type_code : 15
     code : |1+
      PROCEDURE RecupereCommandeEDIBasco()
      //FtpHost est une chaîne UNICODE = "ftp://influencefx.ddns.net"
      //FtpUsername est une chaîne UNICODE = "trn"
      //FtpPassword est une chaîne UNICODE = "trn123"
      //FtpFolderRoot est une chaîne UNICODE = "/Sandbox/Suppliers/ThermosRiveNord/"
      
      //FtpHost est une chaîne UNICODE = "ftp://prod1.seigma.com"
      //FtpUsername est une chaîne UNICODE = "basco-trn"
      //FtpPassword est une chaîne UNICODE = "hJ6ef7p3ZLj3"
      //FtpHost		est une chaîne UNICODE	= gclconfig.m_sBascoFTPAddress
      //FtpHost		est une chaine UNICODE		= ExtraitChaîne(gclConfig.m_sBascoFTPAddress,1,":")+ExtraitChaîne(gclConfig.m_sBascoFTPAddress,2,":") 
      
      //FtpPort		est un entier				= ExtraitChaîne(gclConfig.m_sBascoFTPAddress,3,":")
      
      FtpUsername	est une chaîne UNICODE		= gclConfig.m_sBascoUser
      FtpPassword	est une chaîne UNICODE	= gclConfig.m_sBascoPassword
      FtpFolderRoot est une chaîne UNICODE = "/"
      FtpHost	est une chaine		= ExtraitChaîne(gclConfig.m_sBascoFTPAddress,1,":")+":"+ExtraitChaîne(gclConfig.m_sBascoFTPAddress,2,":")
      FtpPort	est un entier		= ExtraitChaîne(gclConfig.m_sBascoFTPAddress,3,":")
      FTPHostForDotNet est une chaine UNICODE = sansespace(gclconfig.m_sBascoFTPAddress)
      
      si enmodetest() alors
      	FtpHost = "ftp://192.168.1.47"
      	FtpUsername  = "trn"
      	FtpPassword  = "trn"
      	FtpFolderRoot  = "/"
      	ftpport = 21
      	FTPHostForDotNet = "ftp://192.168.1.47"
      FIN
      nid est un entier = ftpconnecte(FtpHost,FtpUsername,FtpPassword,ftpport)
      si nid = -1 alors
      	erreur("Serveur FTP non disponible !!!! ")
      	ferme(mafenetre)
      FIN
      po est un PurchaseOrderDto, utile
      cpt est un entier
      nCptItem est un entier
      
      _tabPurchaseOrder est un "List<PurchaseorderDTo>"
      _TabPurchaseOrderBasco est un TabPurchaseOrderBasco
      _purchaseorder est un PurchaseOrderBasco
      
      
      
      //po.BascoFranchise = "Ceci est un test"
      //po.EdiKey = DonneGUID()
      //ajoute(tabPurchaseOrder,po)
      
      
      
      
      _get est un PurchaseOrderProcessor(FtpHostfordotnet,FtpUsername,FtpPassword,FtpFolderRoot+"PurchaseOrder/") 
      
       
       
      _tabPurchaseOrder.AddRange(_get.get())
      cpt = _tabPurchaseOrder.get_count()
      
      
      sdReqsql est une source de donnees
      
      POUR CHAQUE _po de _tabPurchaseOrder
      	_purchaseorder = allouer un PurchaseOrderBasco()
      
      //	SI HExécuteRequêteSQL(reqsql,hRequêteDéfaut,ChaîneConstruit("select fanumero from facture where fanocommande = '%1'",_po.Display)) ALORS
      //		SI HNbEnr(reqsql) > 0 ALORS
      //			continuer
      //			
      //		FIN
      //	FIN
      	
      	_purchaseorder.TransfertPo(_po)
      	//	si _purchaseorder.unitedemesure = 0 alors _purchaseorder.unitedemesure = _po.unitedemesure
      	//	TransfertPoBasco(_purchaseorder,_po)
      	Ajoute(_TabPurchaseOrderBasco._tabPurchaseorderBasco,_purchaseorder)
      
      FIN
      
      
      renvoyer _TabPurchaseOrderBasco
      
      
      
      
      
      
      
      
      
      
      
      
      
      
      
      
     type : 458752
