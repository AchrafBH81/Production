  -
    name : Bouton1
    identifier : 0x201d8c690beb3479
    internal_properties : 
    properties :
     x : 616
     y : 252
     width : 40
     height : 40
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         si DocumentNumber = "" alors
         	erreur("Numéro de document obligatoire")
         	reprisesaisie(documentnumber)
         FIN
         tabFichier est un tableau de chaînes
         
         //ResListeFichier est une chaine = fListeRépertoire(ComplèteRep(repdonnees)+"PDF\001",frNonRécursif)
         CurrentDirectory est une chaine = ComplèteRep(repdonnees)+"PDF\"+sansespace(fclient)
         invoicenumber est un entier = 0
         bfactureTrouvée est un booleen = faux
         
         
         
         tabdirectory est un tableau de chaine
         si ffichierexiste(fRépertoireTemp()+"Affiche.pdf") alors fsupprime(fRépertoireTemp()+"Affiche.pdf")
         
         
         ResListeFichier est une chaine = fListeRépertoire(ComplèteRep(repdonnees)+"PDF\",frNonRécursif)
         
         
         lNomFichier est une chaine = ""
         LnomfichierDocClient est une chaîne = ""
         LNomFichierConfirmation est une chaîne = ""
         lNomFichierSoumission est une chaine = ""
         ordernumber est un entier
         
         ChaîneVersTableau(ResListeFichier,tabdirectory,rc)
         pour chaque _repertoire de tabdirectory
         	SELON SélType
         		// Commande
         		CAS 1
         			si fFichierExiste(_repertoire+"\Confirmation\Conf"+sansespace(DocumentNumber)+".pdf") alors 
         				lNomFichier =  _repertoire+"\Confirmation\Conf"+SansEspace(DocumentNumber)+".pdf"
         				LnomfichierDocClient  = GetCustomerDoc(_repertoire,documentnumber)
         				
         				sortir
         			FIN
         			
         			
         		// Soumission
         		CAS 2
         			SI fFichierExiste(_repertoire+"\Soumission\Soum"+SansEspace(DocumentNumber)+".pdf") ALORS 
         				lNomFichier = _repertoire+"\Soumission\Soum"+SansEspace(DocumentNumber)+".pdf"
         				
         				SI fFichierExiste(_repertoire+"\Confirmation\Conf"+SansEspace(DocumentNumber)+".pdf") ALORS 
         					LNomFichierConfirmation =  _repertoire+"\Confirmation\Conf"+SansEspace(DocumentNumber)+".pdf"
         					
         				FIN
         				LnomfichierDocClient  = GetCustomerDoc(_repertoire,documentnumber)
         				sortir
         			FIN
         			
         			
         		// Facture
         		CAS 3
         			si fclient = "" alors
         				erreur("Numéro de client obligatoire")
         				reprisesaisie(fclient)
         			FIN
         			Sablier(Vrai)
         			resfiles est une chaine = flistefichier(CurrentDirectory+"\Facture\*.pdf")
         			ChaîneVersTableau(resfiles,tabFichier,RC)
         			
         			POUR CHAQUE Files de tabFichier
         				SI fExtraitChemin(Files,fFichier) = "Facture"+SansEspace(documentnumber) ALORS
         					lNomFichier = Files
         					bfactureTrouvée = vrai
         					ordernumber = GetorderNumber(DocumentNumber)
         					SI ordernumber <> 0 ALORS
         						SI fFichierExiste(CurrentDirectory+"\Confirmation\Conf"+SansEspace(ordernumber)+".pdf") ALORS 
         							LNomFichierConfirmation = CurrentDirectory+"\Confirmation\Conf"+SansEspace(ordernumber)+".pdf"
         						FIN
         						SI fFichierExiste(CurrentDirectory+"\Soumission\Soum"+SansEspace(ordernumber)+".pdf") ALORS 
         							lNomFichierSoumission = CurrentDirectory+"\Soumission\Soum"+SansEspace(ordernumber)+".pdf"
         						FIN
         						LnomfichierDocClient  = GetCustomerDoc(CurrentDirectory,SansEspace(NumériqueVersChaîne(ordernumber)))
         						
         					FIN
         					
         					SORTIR
         				SINON
         					
         					SI ChaîneOccurrence(Files,"_") <> 0 ALORS
         						//			SaisiePDF = PDFVersTexte(Files)
         						StringToSearch = PDFVersTexte(Files)
         						invoicenumber = SearchInvoiceNumber(Files,SansEspace(documentnumber))
         						SI invoicenumber = Val(documentnumber) ALORS
         							lNomFichier = Files
         							bfactureTrouvée = Vrai
         							ordernumber = GetorderNumber(DocumentNumber)
         							si ordernumber <> 0 alors
         								SI fFichierExiste(CurrentDirectory+"\Confirmation\Conf"+SansEspace(ordernumber)+".pdf") ALORS 
         									LNomFichierConfirmation = CurrentDirectory+"\Confirmation\Conf"+SansEspace(ordernumber)+".pdf"
         								FIN
         								SI fFichierExiste(CurrentDirectory+"\Soumission\Soum"+SansEspace(ordernumber)+".pdf") ALORS 
         									lNomFichierSoumission = CurrentDirectory+"\Soumission\Soum"+SansEspace(ordernumber)+".pdf"
         								FIN
         								LnomfichierDocClient  = GetCustomerDoc(CurrentDirectory,sansespace(numeriqueverschaine(ordernumber)))
         								
         							FIN
         							SORTIR
         						FIN
         						
         					FIN
         				FIN
         			FIN
         			//fin
         			si bfactureTrouvée alors sortir
         			Sablier(Faux)
         			//			SI fFichierExiste(_repertoire+"\Facture\Facture"+SansEspace(DocumentNumber)+".pdf") ALORS 
         			//				lNomFichier =  _repertoire+"\Facture\Facture"+SansEspace(DocumentNumber)+".pdf"
         			//				sortir
         			//			FIN
         			
         			
         	FIN	
         FIN
         
         si lNomFichier = "" _et_ LnomfichierDocClient = "" _ET_ LNomFichierConfirmation = "" alors
         	erreur("Aucun fichier trouvé !!!!")
         	renvoyer vrai
         FIN
         
         tableauPDF est un tableau de chaînes
         
         si LnomfichierDocClient <> "" _ou_ LNomFichierConfirmation <> "" _ou_ lNomFichierSoumission <> "" alors
         	TableauAjoute(tableauPDF,lNomFichier)
         	
         	si lNomFichierSoumission <> "" alors
         	  tableauajoute(tableauPDF,lNomFichierSoumission)
         	fin
         	SI LNomFichierConfirmation <> "" ALORS
         		TableauAjoute(tableauPDF,LNomFichierConfirmation)
         	FIN
         	SI LnomfichierDocClient <> "" ALORS
         		TableauAjoute(tableauPDF,LnomfichierDocClient)
         	FIN
         	
         	PDFFusionne(fRépertoireTemp()+"Affiche.pdf",tableauPDF)
         		
         	LecteurDeDocumentsPDF= fRépertoireTemp()+"Affiche.pdf"
         sinon
         	LecteurDeDocumentsPDF = lNomFichier
         	
         fin
         
         //SI LnomfichierDocClient <> "" _OU_ LNomFichierConfirmation <> "" _OU_ lNomFichierSoumission <> "" ALORS
         //	
         //	SI LnomfichierDocClient <> "" _ET_ LNomFichierConfirmation <> ""
         //		PDFFusionne(fRépertoireTemp()+"Affiche.pdf",lNomFichier,LNomFichierConfirmation,LnomfichierDocClient)
         //	SINON SI LnomfichierDocClient <> "" _ET_ LNomFichierConfirmation = ""
         //		PDFFusionne(fRépertoireTemp()+"Affiche.pdf",lNomFichier,LnomfichierDocClient)
         //	SINON SI LnomfichierDocClient = "" _ET_ LNomFichierConfirmation <> ""
         //		PDFFusionne(fRépertoireTemp()+"Affiche.pdf",lNomFichier,LNomFichierConfirmation)
         //		
         //	FIN
         //	LecteurDeDocumentsPDF= fRépertoireTemp()+"Affiche.pdf"
         //SINON
         //	LecteurDeDocumentsPDF = lNomFichier
         //	
         //FIN
         
         
         
         
         mafenetre..plan = 2	
        type : 18
      -
        type : 161
        enabled : false
