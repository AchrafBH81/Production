  procedures :
   -
     name : GetCustomerDoc
     procedure_id : 1163163760394330210
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] GetCustomerDoc (<_repertoire> est chaîne, <DocumentNumber> est chaîne)
      //
      // Paramètres :
      //	_repertoire (chaîne ANSI) : <indiquez ici le rôle de _repertoire>
      //	DocumentNumber (chaîne ANSI) : <indiquez ici le rôle de DocumentNumber>
      // Valeur de retour :
      // 	chaîne ANSI : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      //	DocumentNumber (chaîne ANSI) : <indiquez ici le rôle de DocumentNumber>
      PROCEDURE GetCustomerDoc(_repertoire est une chaine,DocumentNumber est une chaine)
      TabDirectory est un tableau de chaîne
      lNomFichier est une chaine = ""
      
      tabFileList.SupprimeTout()
      tabfolder.SupprimeTout()
      customerdocument = ""
      ResListeFichier est une chaine = fListeRépertoire(_repertoire,"getFolder",frNonRécursif)
      
      
      //ChaîneVersTableau(ResListeFichier,tabdirectory,RC)
      POUR CHAQUE _repertoire de tabfolder
      	
      	SI fFichierExiste(completerep(_repertoire)+SansEspace(DocumentNumber)+".pdf") ALORS 
      		lNomFichier =  completerep(_repertoire)+SansEspace(DocumentNumber)+".pdf"
      		
      		SORTIR
      	fin
      fin
      si lNomFichier = "" alors
      	pour chaque _repertoire1 de tabfolder
      		resfiles est une chaine = flistefichier(_repertoire1+"\*.pdf","getfiles",frNonRécursif)
      		si CustomerDocument <> "" alors lNomFichier = CustomerDocument
      	fin
      FIN
      
      
      renvoyer lNomFichier
      
      
     type : 458752
   -
     name : GetFolder
     procedure_id : 1163477104120758113
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //GetFolder (<MasterForder>, <SubFolder>)
      //
      // Paramètres :
      //	MasterForder : <indiquez ici le rôle de param1>
      //	SubFolder : <indiquez ici le rôle de param2>
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      
      PROCEDURE GetFolder(MasterForder,SubFolder)
      
      si Contient(SubFolder,"Commande",SansCasse) alors
      	tabfolder.Ajoute(MasterForder+subfolder)
      FIN
      
     type : 458752
   -
     name : GetFiles
     procedure_id : 1163482541549441607
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] GetFiles (<p1>, <p2>, <p3>, <p4>)
      //
      // Paramètres :
      //	p1 : <indiquez ici le rôle de p1>
      //	p2 : <indiquez ici le rôle de p2>
      //	p3 : <indiquez ici le rôle de p3>
      //	p4 : <indiquez ici le rôle de p4>
      // Valeur de retour :
      // 	booléen : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE GetFiles(p1,p2,p3,p4)
      TabChaine est un tableau de chaine
      res est un entier
      si ChaîneOccurrence(p2,"-") > 0 alors
      	ChaîneVersTableau(extraitchaine(p2,1,"."),TabChaine,"-")
      	res = tableaucherche(TabChaine,tcLinéaire,DocumentNumber)
      	si res <> -1 alors
      		CustomerDocument = p1+p2
      		renvoyer faux
      	FIN
      	
      fin
      
      
     type : 458752
   -
     name : SearchInvoiceNumber
     procedure_id : 1163883163121808132
     type_code : 14
     code : |1-
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] SearchInvoiceNumber (<NomDeFichier>, <InvoiceToSearch>)
      //
      // Paramètres :
      //	NomDeFichier : <indiquez ici le rôle de NomDeFichier>
      //	InvoiceToSearch : <indiquez ici le rôle de InvoiceToSearch>
      // Valeur de retour :
      // 	entier : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE SearchInvoiceNumber(NomDeFichier,InvoiceToSearch)
      Invoicenumber est un entier
      tabligne est un tableau de chaînes
      facturePos est un entier
      //ChaîneVersTableau(SaisiePDF,tabligne,RC)
      //ChaîneVersTableau(StringToSearch,tabligne,RC)
      
      //Info(ChaîneOccurrence(SaisiePDF,"Facture #"))
      //POUR i =  1 _a_ ChaîneOccurrence(SaisiePDF,"Facture #")
      //	facturePos = PositionOccurrence(SaisiePDF,"Facture #",i)
      //	Invoicenumber = SaisiePDF[[facturePos+10 À facturePos+16]]
      //	si Invoicenumber = 0 alors sortir
      //FIN
      //
      //si Invoicenumber = 0 alors
      //	POUR i =  1 _a_ ChaîneOccurrence(SaisiePDF,"1 de 1")
      //		facturePos = PositionOccurrence(SaisiePDF,"1 de 1",i)
      //		Invoicenumber = SaisiePDF[[facturePos+7 À facturePos+13]]
      //	FIN
      //	
      //FIN
      
      
      POUR i =  1 _a_ ChaîneOccurrence(StringToSearch,"Facture #")
      	facturePos = PositionOccurrence(StringToSearch,"Facture #",i)
      	Invoicenumber = StringToSearch[[facturePos+10 À facturePos+16]]
      	
      	SI Invoicenumber = 0 ALORS 
      		SORTIR
      	sinon
      	    si Invoicenumber = InvoiceToSearch alors sortir
      	FIN
      FIN
      
      SI Invoicenumber = 0 ALORS
      	POUR i =  1 _a_ ChaîneOccurrence(StringToSearch,"1 de 1")
      		facturePos = PositionOccurrence(stringtosearch,"1 de 1",i)
      		Invoicenumber = stringtosearch[[facturePos+7 À facturePos+13]]
      		SI Invoicenumber = InvoiceToSearch ALORS SORTIR
      	FIN
      	
      FIN
      
      
      //trace(Invoicenumber)
      renvoyer Invoicenumber
     type : 458752
