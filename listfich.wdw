  -
    name : TVREPERTOIRE
    identifier : 0x3e9d90e2116800c0
    internal_properties : 
    properties :
     x : 12
     y : 29
     width : 223
     height : 357
    type : 19
    code_elements :
     type_code : 25
     p_codes :
      -
        code : |1+
         DebutChemin est une chaine
         PartieChemin est une chaine
         Indice		est un entier
         
         RempliTVRep(moimeme..nom)
         
         //ouverture sur le chemin passé en paramètre
         //le chemin existe ?
         si frep(RepertoireInitial,frrepertoire)<>"" alors
         	Indice=1
         	DebutChemin=""
         	boucle
         		PartieChemin=extraitchaine(RepertoireInitial,Indice,"\")
         		si PartieChemin=eot alors
         			sortir
         		sinon
         			si DebutChemin="" alors
         				DebutChemin=DebutMaj(PartieChemin)
         			sinon
         				DebutChemin+="\"+DebutMaj(PartieChemin)
         			fin
         			AjoutsousRep(moimeme..nom,DebutChemin)
         			Indice++
         		fin
         	fin
         	//selection du repertoire dont le chemin est mis dans le TV
         	arbreselectplus(moimeme..nom,...
         					CheminTV(moimeme..nom,ChangeCar1parCar2(DebutChemin,"\",tab),vrai))
         	//Pour la maj de la liste des fichiers dans la table
         	execute(moimeme..nom+"..modifie")
         fin
         
        type : 14
      -
        type : 35
        enabled : false
      -
        type : 19
        enabled : false
      -
        type : 20
        enabled : false
      -
        code : |1+
         //-------------------------------------
         //MAJ des repertoires du TV
         //-------------------------------------
         
         sCheminIni 		est une chaine
         sCheminEnCours 	est une chaine
         	
         //Traitement déjà an cours ?	
         si pas gbEnCours alors
         	//MAJ du booleen permettant de determiner si le traitement est deja en cours
         	gbEnCours=vrai
         	//Initialisation du booleen d'annulation
         	gbAnnuler=faux
         	
         
         	//Recuperation du chemen en cours dans le TV
         	sCheminIni=ArbreSelect(moimeme..nom)
         	sCheminEnCours=sCheminIni
         	
         //Code WinDev 5.5 remplacé par la migration :
         //	MESSATTENTE..etat=actif
         	MESSATTENTE..etat=actif; MESSATTENTE..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         //	GRPBTN..etat=grise
         	GRPBTN..etat=grise; GRPBTN..Visible=Vrai
         	
         	//Branche déroulée ou feuille ?
         	si ArbreEtat(moimeme..nom, sCheminEnCours)=aderoule ou ...
         		ArbreTypeElément(moimeme..nom, sCheminEnCours)=afeuille alors
         		//MAJ de la sous arboresence
         		//suppression du debut du TV
         		sCheminEnCours=CheminTv(moimeme..nom,sCheminEnCours)
         		si sCheminEnCours="" alors
         			RempliTVRep(moimeme..nom)
         			tablesupprimetout("TABLEFICHIER")
         			SAITITRETABLE..valeur=""
         		sinon
         			//Remplacement des tabulation par des "\"
         			sCheminEnCours=ChangeCar1parCar2(sCheminEnCours,tab,"\")
         
         			//ajout des sous repertoires
         			AjoutsousRep(moimeme..nom,sCheminEnCours)
         		fin
         		arbreselectplus(moimeme..nom,sCheminIni)
         	fin
         	
         	//-------------------------------------
         	//MAJ des fichiers de la table
         	//-------------------------------------
         
         	sCheminEnCours=ArbreSelect(moimeme..nom)
         
         	sCheminEnCours=CheminTv(moimeme..nom,sCheminEnCours)
         		si sCheminEnCours<>"" alors
         			//Remplacement des tabulation par des "\"
         			sCheminEnCours=ChangeCar1parCar2(sCheminEnCours,tab,"\")
         		
         			//MAJ du champ de saisie au-dessu de la table des fichiers
         			SAITITRETABLE..valeur=sCheminEnCours
         		
         			//ajout des fichiers
         			MajListeFichier("TableFichier",gsFiltre,sCheminEnCours)
         		fin
         		gbEnCours=faux
         //Code WinDev 5.5 remplacé par la migration :
         //	MESSATTENTE..etat=invisible
         	MESSATTENTE..Visible=Faux
         //Code WinDev 5.5 remplacé par la migration :
         //	GRPBTN..etat=actif
         	GRPBTN..etat=actif; GRPBTN..Visible=Vrai
         fin
         
        type : 33
      -
        code : |1+
         execute(moimeme..nom+"..modifie")
         
        type : 31
      -
        type : 17
        enabled : false
