 menu :
  name : _Menu
  identifier : 0x3e9d90e2339200a2
  internal_properties : 
  options : []
 languages :
  - fr-FR
 popup_menus : []
 message_bar :
  internal_properties : CQAAAAkAAACkjOJB0fbkdR5/M3kd46cJFoJel3LWl5MB2vCogpyl7Pc4K+jPVwlLmEbc3rl67fiwu61icMmtSgXqvYowZ+c0wlzX67u2LVVvHsXZ/WdS+TjtRxUC+BittNf44w==
 actionbar : {}
 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1+
      procedure Listfich(RepertoireInitial="",lefiltre="*.*")
      
      // Pour compatibilité 5.5
      MoiMême..Visible=Vrai
      
      global
      gsFiltre			est une chaine=lefiltre
      gbAnnuler			est un booleen
      gbEnCours			est un booleen=faux
      //Code WinDev 5.5 remplacé par la migration :
      //geNumFicheEnCours   est un entier long=0
      geNumFicheEnCours   est un entier  =0
      gsResultat			est une chaine=""
      
      //************Debut Pour la table multiselection
      gcNomZone				est une chaine="Zone1"	//nom d'une zone mémoire
      //Code WinDev 5.5 remplacé par la migration :
      //glCouleurSelectFond 	est un entier long=ibleufonce //couleur des lignes selectionnées
      glCouleurSelectFond 	est un entier  =ibleufonce //couleur des lignes selectionnées
      //Code WinDev 5.5 remplacé par la migration :
      //glCouleurSelectTexte	est un entier long=iblanc		//couleur du texte selectionné
      glCouleurSelectTexte	est un entier  =iblanc		//couleur du texte selectionné
      geEvenementClic			est un entier
      gslisteColonne			est une chaine="NUMIDFICH,NOM,TAILLEFICHIER,MODIFICATION,TYPEFICHIER,EXECUTABLEASSOCIE,REPERTOIRE"
      gsColIdunique			est une chaine="NUMIDFICH"
      gsNomTable				est une chaine="TableFichier"
      
      
      si RepertoireInitial="" alors
      	RepertoireInitial=frepencours()
      fin
      
      //Creation de la zone mémoire
      memcree(gcNomZone)
      
      //evenement du clic
      geEvenementClic=evenement("ClicSelectTable",FenEnCours(),514)
      //************Fin Pour la table multiselection
      
   -
     type : 180
     enabled : false
   -
     type : 230
     enabled : false
   -
     code : |1+
      finevenement(geEvenementClic)
      memsupprimetout(gcNomZone)
      
      renvoyer gsResultat
      
     type : 2
   -
     type : 11
   -
     type : 12
   -
     type : 17
   -
     type : 13
  procedures :
   -
     name : AfficheIcone
     procedure_id : 4511921706977591689
     type_code : 14
     code : |1+
      Procédure AfficheIcone(NomFichier,NomChampImage,IndiceIcone=0)
      //Affiche l'icone associé au fichier "NomFichier" dans le champ image "NomChampImage"
      NomExe 			est une chaine   //Nom du fichier dans lequel l'exe doit être recherché
      TypeDuFichier	est une chaine	 //type du fichier
      ExeAssocie		est une chaine   //Programme associé au fichier
      LectureOK		est un booleen
      
      
      //Type du fichier et exécutable associé au fichier
      TypeDuFichier=Registrelit("HKEY_CLASSES_ROOT\."+ExtentionFichier(NomFichier),"")
      
      //Lecture de l'exécutable associé aux icones, et de l'indice de l'icone
      ExeAssocie=registrelit("HKEY_CLASSES_ROOT\"+TypeDuFichier+"\DefaultIcon","",LectureOK)
      
      //la lecture de la base de registre c'est bien passée ET le fichier existe
      si LectureOK et frep(extraitchaine(ExeAssocie,1,","))<>"" alors
      	IndiceIcone=val(extraitchaine(ExeAssocie,2,","))
      	NomExe=extraitchaine(ExeAssocie,1,",")
      sinon
      	IndiceIcone=0
      	//Un programme associé
      	si  frep(ExeAssocie)<>"" alors
      		//C'est un fichier de "données"
      		//Executable associe
      		NomExe=ExeAssocie
      	sinon
      		//Pas de programme associé, le fichier existe bien ?
      		si frep(NomFichier)<>"" alors
      			NomExe=NomFichier
      			IndiceIcone=0
      		sinon
      			NomExe=""
      		fin
      	fin
      fin
      
      
      renvoyer AfficheIconEXE(NomExe,NomChampImage,IndiceIcone)
      
     type : 458752
   -
     name : AfficheIconEXE
     procedure_id : 4511921707052106161
     type_code : 14
     code : |1+
      procedure AfficheIconEXE(NomExe,NomChamp="IMAGE",IndiceIcone=0)
      
      	// Affichage de l'icone dans la liste
      	// Extraction de l'icone de l'exécutable
      	
      	// ENTREE :
      	// PointExe		répertoire+nom de l'exécutable
      	// NomChamp		nom du champ d'accueil de l'image
      	// NomExe		nom de l'exécutable seul
      	
      	// Déclarations pour l'exécution en 16 bits
      	HInst16		est un entier //Instance du programme en cours
      	HImage16	est un entier systeme//Handle du champ image
      	HICON16		est un entier systeme//Handle de l'icone du programme
      	HDC16		est un entier //Device Context pour le dessin dans le champ image
      	HBOOL16		est un entier //Resultat du dessin de l'icone dans le champ image
      	HImage		est un entier  systeme
      	
      
      	
      	// Déclarations pour l'exécution en 32 bits
      //Code WinDev 5.5 remplacé par la migration :
      //	HInst32		est un entier long //Instance du programme en cours
      	HInst32		est un entier système  //Instance du programme en cours
      //Code WinDev 5.5 remplacé par la migration :
      //	HImage32	est un entier long //Handle du champ image
      	HImage32	est un entier systeme   //Handle du champ image
      //Code WinDev 5.5 remplacé par la migration :
      //	HICON32		est un entier long //Handle de l'icone du programme
      	HICON32		est un entier systeme  //Handle de l'icone du programme
      //Code WinDev 5.5 remplacé par la migration :
      //	HICO32,HICO16 sont des entier long
      	HICO32,HICO16 sont des entier  
      	NbIcones	est un entier=2
      //Code WinDev 5.5 remplacé par la migration :
      //	HDC32		est un entier long //Device Context pour le dessin dans le champ image
      	HDC32		est un entier systeme
      	  //Device Context pour le dessin dans le champ image
      //Code WinDev 5.5 remplacé par la migration :
      //	HBOOL32		est un entier long //Resultat du dessin de l'icone dans le champ image
      	HBOOL32		est un entier   //Resultat du dessin de l'icone dans le champ image
      	
      	//Declaration pour l'appel 16 et 32 bits
      	Appli		est une chaine asciiz de 255	//Nom de l'exécutable
      	_UINT		est un entier sans signe = 0	// Pour typage
      	_INT		est un entier = 0				// Pour typage
      	
      	
      	RecuperationIconeOK est un booleen
      	
      	//Nom de l'exe dont on doit extraire l'icone
      	Appli = NomExe
      	
      	dfindessin(NomChamp)
      	//Indoice de l'icone à récuperer
      	_UINT=IndiceIcone
      
      	si versionwindows()="32" alors
      		//Instance du programme en cours
      		HInst32 = instance()
      		//Handle du champ image
      		HImage32 = handle(NomChamp)
      		//Handle de l'icone du programme
      		HICON32 = AppelDLL32("shell32.dll","ExtractIconExA" , &Appli, _UINT, &HICO32,&HICO16, NbIcones)
      		//Device Context pour le dessin dans le champ image
      		HDC32 = ddebutdessin(NomChamp)
      		//Dessine un rectangle magenta clair dans le champ image (pour avoir un fond transparent)
      		drectangle(0,0,32,32,imagentaclair)
      		//Dessin de l'icone dans le champ image
      		//HBOOL32 = appeldll32("User32","DrawIcon",HDc32,_INT,_INT,HIcO32) //Pour dessiner l'icone 32x32
      		HBOOL32 = appeldll32("User32","DrawIcon",HDC32,_INT,_INT,HICO16) //Pour dessiner l'icone 16x16
      		
      		//MAj du booléen qui indique si l'opération c'est bien passée
      		RecuperationIconeOK=(HBOOL32<>0)
      		//Cette instruction est équivalente à : 
      		//si HBOOL32<>0 alors
      		//	RecuperationIconeOK=vrai
      		//sinon
      		//	RecuperationIconeOK
      		//fin
      			
      		si RecuperationIconeOK alors
      			//destruction de l'icone créé
      			Appeldll32("User32","DestroyIcon",HICO16)
      			Appeldll32("User32","DestroyIcon",HICO32)
      		fin
      	sinon
      		//Instance du programme en cours
      		HInst16 = poidsfaible(instance())
      		//Handle de l'icone du programme
      		HImage16 = handle(NomChamp)
      		//Handle de l'icone du programme
      //Code WinDev 5.5 remplacé par la migration :
      //		HIcon16 = Appeldll("SHELL","ExtractIcon",HInst16,&Appli,_UINT)
      // Votre programme utilise ici une commande 16 bits. 
      // Cette version ne permet que des exécutables 32 bits.
      // 		HIcon16 = Appeldll("SHELL","ExtractIcon",HInst16,&Appli,_UINT)
      // Code ajouté par la migration
      Erreur("Votre programme utilise ici une commande 16 bits. Cette version ne permet que des exécutables 32 bits.")
      
      		//Device Context pour le dessin dans le champ image
      		HDC16 = EntierSystèmeVersEntier(ddebutdessin(NomChamp))
      		//Dessine un rectangle magenta clair dans le champ image (pour avoir un fond transparent)
      		drectangle(0,0,32,32,imagentaclair)
      		//Dessin de l'icone dans le champ image
      //Code WinDev 5.5 remplacé par la migration :
      //		HBOOL16 = appeldll("User","DrawIcon",HDc16,_INT,_INT,HIcon16)
      // Votre programme utilise ici une commande 16 bits. 
      // Cette version ne permet que des exécutables 32 bits.
      // 		HBOOL16 = appeldll("User","DrawIcon",HDc16,_INT,_INT,HIcon16)
      // Code ajouté par la migration
      Erreur("Votre programme utilise ici une commande 16 bits. Cette version ne permet que des exécutables 32 bits.")
      
      		
      		//MAj du booléen qui indique si l'opération c'est bien passée
      		RecuperationIconeOK=(HBOOL16<>0)
      		//Cette instruction est équivalente à : 
      		//si HBOOL16<>0 alors
      		//	RecuperationIconeOK=vrai
      		//sinon
      		//	RecuperationIconeOK
      		//fin
      		si RecuperationIconeOK alors
      			//destruction de l'icone créé
      //Code WinDev 5.5 remplacé par la migration :
      //			Appeldll("User","DestroyIcon",HIcon16)
      // Votre programme utilise ici une commande 16 bits. 
      // Cette version ne permet que des exécutables 32 bits.
      // 			Appeldll("User","DestroyIcon",HIcon16)
      // Code ajouté par la migration
      Erreur("Votre programme utilise ici une commande 16 bits. Cette version ne permet que des exécutables 32 bits.")
      
      		fin
      	fin
      
      renvoyer RecuperationIconeOK
      
     type : 458752
   -
     name : AjouteSousRepPremNiveau
     procedure_id : 4511921706334028319
     type_code : 14
     code : |1+
      fonction AjouteSousRepPremNiveau(sNomTV,sNomRepinitial,bMemoriser=Faux)
      //Ajout du repertoires sNomRepinitial et de ses sous repertoires direct dans le TV sNomTV
      //si bMemoriser=Vrai alors les sous repertoires direct de sNomRepinitial sont mémoriser
      // dans une zone mémoire du nom sNomTV
      
      sUnRep 			est une chaine
      sDecompRepini 	est une chaine
      sImageArbre		est une chaine=""
      AjoutOk 		est un booleen
      
      //creation de la zone memoire si elle n'existe pas
      si pas memexist(sNomTV)  alors
      	memcree(sNomTV)
      fin
      
      //remplacement des "\" par des tabulations
      sDecompRepini=ChangeCar1parCar2(sNomRepinitial)
      sDecompRepini=CheminTv(sNomTV,sDecompRepini,Vrai)
      
      si bMemoriser alors
      	//suppression du repertoire initial (pour MAJ)
      	sImageArbre=arbrerecupereidentifiant(sNomTV,sDecompRepini)
      	arbresupprime(sNomTV,sDecompRepini)
      fin
      
      //Creation du repertoire initial
      si sImageArbre="" ou sImageArbre="0" alors
      	arbreajoute(sNomTV,sDecompRepini,adefaut,adefaut, null, aTriAlpha)
      	
      sinon
      	arbreajoute(sNomTV,sDecompRepini,sImageArbre,sImageArbre, sImageArbre, aTriAlpha)
      fin
      //Vérification que l'ajout c'est bien fait
      AjoutOk=(ArbreTypeElement(sNomTV,sDecompRepini)<>aerreur)
      
      arbrederoule(sNomTV,sDecompRepini)
      
      //recherche de tous les sous repertoires direct
      sUnRep=DebutMaj(frep(sNomRepinitial+"\*.*",FRRepertoire))
      TantQue sUnRep<>"" et AjoutOk
      	//Ajout d'un sous repertoire dans le TV
         	arbreajoute(sNomTV,sDecompRepini+tab+sUnRep,adefaut,adefaut, null, aTriAlpha)
      	//Vérification que l'ajout c'est bien fait
      	AjoutOk=(ArbreTypeElement(sNomTV,sDecompRepini)<>aerreur)
      
      	//mémoriser les sous repertoire ?
      	si bMemoriser alors
      		memajoute(sNomTV,sUnRep,sNomRepinitial+"\"+sUnRep)
      	fin
      	//recherche des sous repertoires suivant
        	sUnRep = DebutMaj(fRep(""))
      Fin
      
      renvoyer AjoutOk
      
     type : 458752
   -
     name : AjouteUnFichier
     procedure_id : 4511921707349508699
     type_code : 14
     code : |1+
      Procedure AjouteUnFichier(sChemin, sNomFichier, eChange, psNomtable)
      sNomTable est une chaine fixe sur 4096
      NomBmp		est une chaine		//Nom pour l'image BMP associé à l'icone
      NomChampDest est une chaine= "IMGDEST"  //Nom du champ image où RE-dessiner l'icone en 16x16
      NomChampImage est une chaine="IMAGE"
      ExeAssocie		est une chaine
      IndiceExeIcone	est un entier
      IndiceListeIcone est un entier
      
      //Recupoeration du nom de la table
      transfer(&sNomTable,psNomtable,4096)
      
      
      
      //10 lignes ajoutées ?
      si modulo(tableoccurrence(sNomTable),10)=0 alors
      	//Annulation utilisateur ?
      	multitache(-1)
      	si gbAnnuler alors
      		renvoyer faux
      	fin
      fin
      
      si eChange=1 et INTSOUSREP[1]=0 alors
      	//Changement de repertoire, fin de l'ajout dans la table
      	renvoyer faux
      sinon
      	geNumFicheEnCours++
      	
      	
      	//Ajout dans la table des fichiers
      	si pas tableajoute(sNomTable,majuscule(sNomFichier[[1]])+minuscule(sNomFichier[[2 a]])+tab+...
      				geNumFicheEnCours+tab+ftaille(sChemin+sNomFichier)+tab+fdate(sChemin+sNomFichier)+tab+...
      				RechercheType(ExtentionFichier(sNomFichier))+tab+sChemin) alors
      		acso_message("Erreur","Nombre maximum de fichier atteint :"+tableoccurrence(sNomTable)+" fichiers.","erreur")
      		renvoyer faux
      	fin
      
      fin
      
      
     type : 458752
   -
     name : AjoutsousRep
     procedure_id : 4511921708070535821
     type_code : 14
     code : |1+
      Procédure AjoutSousRep(sNomTV,sNomRep)
      //ajoute OU MAJ le TV pour le repertoire passé en parametre
      
      sNomRepSuivant est une chaine
      AjoutArbreOk	est un booleen
      
      //Ajout des sous-repertoire de premier niveau
      AjoutArbreOk=AjouteSousRepPremNiveau(sNomTV,sNomRep,vrai)
      
      //Ajout des sous-repertoire de second niveau
      //Les repertoire de premier niveau ont été mis dans une zone mémoire 
      //du même nom que le TV
      sNomRepSuivant=mempremier(sNomTV)
      tantque pas memendehors(sNomTV) et AjoutArbreOk
      	//parcours total de la zone mémoire
      	AjoutArbreOk=AjouteSousRepPremNiveau(sNomTV,sNomRepSuivant)
      	memsupprime(sNomTV,memencours(sNomTV))
      	//suppression du repertoire de la zone mémoire
      	sNomRepSuivant=mempremier(sNomTV)
      fin
      //destruction de la zone mémoire
      memsupprimetout(sNomTV)
      
      si pas AjoutArbreOk alors
      	ACSO_message("Erreur","Nombre maximum de répertoire affichable atteint: "+arbreoccurrence(sNomTV)+" répertoires.","Erreur")
      fin
      
     type : 458752
   -
     name : ChangeCar1parCar2
     procedure_id : 4511921707509940897
     type_code : 14
     code : |1+
        fonction ChangeCar1parCar2(sNomRep,sCar1="\",sCar2=tab)
        
      //Code WinDev 5.5 remplacé par la migration :
      //  lIndiceAntiSlach est un entier long
        lIndiceAntiSlach est un entier  
        sChaineretour est une chaine
        
        lIndiceAntiSlach=position(sNomRep,sCar1)
        
        si lIndiceAntiSlach>0 alors
        		sChaineretour= sNomRep[[a lIndiceAntiSlach-1]]+sCar2+ChangeCar1parCar2(sNomRep[[lIndiceAntiSlach+1 a]],sCar1,sCar2)
      	sinon
      		sChaineretour= sNomRep
        fin
      
      renvoyer sChaineretour
      
     type : 458752
   -
     name : CheminTV
     procedure_id : 4511921707545592501
     type_code : 14
     code : |1+
      fonction CheminTV(sNomTV,sCheminEncours,bAjoute=faux,sDebutTV="Poste de travail")
      
      eTailleDebutTV	est un entier
      sCheminRetour 	est une chaine
      
      
      eTailleDebutTV=taille(sDebutTV)
      
      //contient le debut ?
      si sCheminEncours[[a eTailleDebutTV]]=sDebutTV alors
      	//oui
      	si bAjoute alors
      		//on ne change rien
      		sCheminRetour=sCheminEncours
      	sinon
      		//on enleve le debut
      		sCheminRetour=sCheminEncours[[eTailleDebutTV+2 a]]
      	fin
      sinon
      	//non
      	si bAjoute alors
      		//on ajoute
      		sCheminRetour=sDebutTV+tab+sCheminEncours
      	sinon
      		//on ne change rien
      		sCheminRetour=sCheminEncours
      	fin
      fin
      
      renvoyer sCheminRetour
      
     type : 458752
   -
     name : ClicSelectTable
     procedure_id : 4511921708261245641
     type_code : 14
     code : |1+
      ////************Pour la table multiselection a intégrer dans le code d'Ouverture de la fenêtre ***********
      //GLOBAL
      //	gcNomZone				est une chaine="Zone1"	//nom d'une zone mémoire
      //	glCouleurSelectFond 	est un entier long=ibleufonce //couleur des lignes selectionnées
      //	glCouleurSelectTexte	est un entier long=iblanc		//couleur du texte selectionné
      //	geEvenementClic			est un entier
      //	gslisteColonne			est une chaine="FOCLEUNIK,STEFOURNISS,NOMFOURNISS" //Liste des noms de colonnes de la table
      //	gsColIdunique			est une chaine="NOM" //Nom de la colonne (identifiant unique) de la table
      //	gsNomTable				est une chaine="Table1" //nom de la table
      //
      ////Creation de la zone mémoire
      //memcree(gcNomZone)
      //
      ////evenement du clic
      //geEvenementClic=evenement("ClicSelectTable",FenEnCours(),514)
      
      
      ////************Pour la table multiselection a intégrer dans le code de Fermeture de la fenêtre ***********
      //finevenement(geEvenementClic)
      
      ////************Pour la table multiselection a intégrer dans le code d'affichage d'une ligne de la table
      //MajLigneSel(gcNomZone)
      
      //clic sur une colonne de la table ?
      //Code WinDev 5.5 remplacé par la migration :
      //si position(gslisteColonne,infoobjet(11))>0 alors
      si position(gslisteColonne,ChampSurvol(VRAI, VRAI))>0 alors
      	//Oui
      	VerifSelection(gcNomZone)
      fin
      
     type : 458752
   -
     name : DebutMaj
     procedure_id : 4511921706329899731
     type_code : 14
     code : |1+
      fonction DebutMaj(Texte="")
      //renvoie le test=xte passé en paramètre avec la première lettre en majuscule
      
      selon taille(Texte)
      	cas 0 : renvoyer Texte
      	cas 1 : renvoyer majuscule(Texte)
      	autre cas : renvoyer majuscule(Texte[[1]])+Texte[[2 a]]
      fin
      
     type : 458752
   -
     name : ExtentionFichier
     procedure_id : 4511921706648273619
     type_code : 14
     code : |1+
      fonction ExtentionFichier(NomDeFichier)
      //renvoie l'extention du fichier
      Pos	est un entier
      
      Pour Pos=Taille(NomDeFichier) à 1 pas -1
      	si NomDeFichier[[Pos]]="." ou NomDeFichier[[Pos]]="\" alors sortir
      fin
      si NomDeFichier[[Pos]]="." alors
      	renvoyer NomDeFichier[[Pos+1 a]]
      sinon
      	renvoyer ""			// pas de "." trouvé
      fin
      
     type : 458752
   -
     name : ExtraitNomCourt
     procedure_id : 4511921707614995175
     type_code : 14
     code : |1+
      fonction ExtraitNomCourt(NomCompletFichier="")
      //Convertion complete d'un chemin + d'un nom de fichier long en chemin+nom court
      Resultat 		est une chaine=""	//Résultat de la convertion
      PartieChemin	est une chaine=""	//Derniere partie extraite
      n 				est un entier		//Indice de la dernierre partie extraite
      
      n=1
      boucle
      	//Extraction d'un nom de répertoire (ou nom de fichier)
      	PartieChemin=extraitchaine(NomCompletFichier,n,"\")
      	//L'extraction est terminée ?
      	si PartieChemin=eot alors
      		sortir
      	sinon
      		//Le résultat est une chaine vide (1iere partie) ?
      		si Resultat="" alors
      			//C'est le début, donc le nom de l'unité
      			Resultat=PartieChemin
      		sinon
      			//Le résultat copntient déjà une partie, ajout d'un "\" lors de a concaténation
      			Resultat+="\"+fnomcourt(Resultat+"\"+PartieChemin)
      		fin
      		//Partie suivante
      		n++
      	fin
      fin
      
      //renvoye du résultat
      renvoyer Resultat 
      
     type : 458752
   -
     name : MajLigneSel
     procedure_id : 4511921707030807291
     type_code : 14
     code : |1+
      Procédure MajLigneSel(cNomzone)
      //recherche de l'enregistrement en cours du fichier "produit" dans la zone mémoire des "séléctions"
      //affiche la couleur la table en fonction de l'enregistrement de la zone mémoire 
      //cNomZone est la zone mémoire des "séléctions" des produits
      MemRecherche(cNomzone,{gsColIdunique})
      
      si memtrouve(cNomzone) alors
      	//element trouvé
      	//La ligne est donc selectionnee
      	{gsNomTable}[{gsNomTable}]..couleur=glCouleurSelectTexte
      	{gsNomTable}[{gsNomTable}]..couleurfond=glCouleurSelectFond
      sinon
      	//element non trouvé
      	//La ligne n'est donc pas selectionnee
      	{gsNomTable}[{gsNomTable}]..couleur=icouleurdefaut
      	{gsNomTable}[{gsNomTable}]..couleurfond=icouleurdefaut
      fin
      
     type : 458752
   -
     name : MajListeFichier
     procedure_id : 4511921706582541061
     type_code : 14
     code : |1+
      Procédure MajListeFichier(sNomtable,sfiltre,sCheminEnCours)
      //Pour passer le nom de la table en parametre à la procedure appelée par fListeFichier
      spNomTable est une chaine fixe sur 4096
      
      //Vide la table des fichiers
      tablesupprimetout(sNomtable)
      //Code WinDev 5.5 remplacé par la migration :
      //tabletri(sNomtable,faux)
      TableTrie(sNomtable,faux)
      
      			
      //Vide la zone mémoire des lignes selectionnées dans la table
      memsupprimetout(gcNomzone)
      memcree(gcNomzone)
      
      //Nom de la table fichier
      spNomTable=complete(sNomtable,4096)
      
      
      //Recherche recursive ?
      si INTSOUSREP[1] alors
      	//Oui, affichage du repertoire
      //Code WinDev 5.5 remplacé par la migration :
      //	repertoire..etat=inactif
      	repertoire..etat=AffichageSeulement; repertoire..Visible=Vrai
      sinon
      	//Non, on cache la colonne repertoire
      //Code WinDev 5.5 remplacé par la migration :
      //	repertoire..etat=invisible
      	repertoire..Visible=Faux
      fin
      
      //initialisation du nombre de fichier en cours
      geNumFicheEnCours=0
      
      //recherche de tous les fichiers
      flistefichier(sCheminEnCours+"\"+sfiltre,"AjouteUnFichier",&spNomTable)
      
      si tableoccurrence(sNomtable)>1 alors
      	//tri initial
      //Code WinDev 5.5 remplacé par la migration :
      //	tabletri("Nom")
      	TableTrie("Nom")
      	//selection de la premiere ligne
      	tableselectplus(sNomtable,1)
      fin
      
     type : 458752
   -
     name : RechercheType
     procedure_id : 4511921707805311779
     type_code : 14
     code : |1+
      fonction RechercheType(extension)
      
      //Declaration des variables utilisée dans la procédure
      TypeFich,TypeAffiche,LigneCmd,NomExe sont des chaines
      res est un entier
      
      si versionwindows() = "16" 
      	//Recherche dans Win.ini
      	NomExe=inilit("Extensions",extension)
      	res=position(NomExe,"^")
      	NomExe=gauche(NomExe,res-1)
      sinon
      	//Recherche dans les registres pour Windows95 et NT
      	TypeFich=Registrelit("HKEY_CLASSES_ROOT\."+extension,"")
      	TypeAffiche=Registrelit("HKEY_CLASSES_ROOT\"+TypeFich,"")
      	LigneCmd=registrelit("HKEY_CLASSES_ROOT\"+TypeFich+"\shell\open\command","")
      	si LigneCmd[[1]]="""" alors
      		NomExe=extraitchaine(LigneCmd,2,"""")
      	sinon
      		NomExe=extraitchaine(LigneCmd,1," ")
      	fin
      	si position(NomExe,"%1")>0 alors NomExe=extraitchaine(NomExe,1,"%1")
      	
      	si NomExe="" alors
      		//Pas trouvé dans la base de registre
      		//vérification pour les appli. 16 bits dans le fichier Win.ini
              NomExe=inilit("Extensions",extension)
      		res=position(NomExe,"^")
      		NomExe=gauche(NomExe,res-1)
      	fin
      fin
      
      renvoyer TypeAffiche+tab+NomExe
      
     type : 458752
   -
     name : RempliTVRep
     procedure_id : 4511921706422960971
     type_code : 14
     code : |1+
      Procédure RempliTVRep(sNomTV)
      //Initialise le champ TreeView "TVREPERTOIRE" avec les répertoires de l'unité sUnite
      //et initialise le repertoire sRepInitial comme repertoire initial
      
      sUnRep 			est une Chaîne
      sCheminEnCours 	est une chaine
      sNomRepSuivant est une chaine
      sDebutTVaIgnore est une chaine="Poste de travail"
      eTyp			est un entier
      sCh 			est une chaine
      sAfficheDisq 	est une chaine
      eid				est un entier
      
      
      //Initialisation
      arbresupprimetout(sNomTV)
      
      arbreAjoute(sNomTV,"Poste de travail",POSTETRAVAIL,POSTETRAVAIL)//,"POSTETR.BMP","POSTETR.BMP")
      
      // initialisation de la combo Lecteur disponible
      ChargeImage(1,IMAGE1..valeur,1,8)
      pour eid=1 à 26
      	sCh=Caract(Asc("A")+eid-1)+":"
      	// Demande le type du lecteur
      //Code WinDev 5.5 remplacé par la migration :
      //	selon fTypeDisque(sCh)
      	selon fDisqueInfo(sCh,fdTypeDisque)
      		cas 0: eTyp=0
      		cas 1
      			 eTyp=4	// Disquette
      			 //sAfficheDisq=LECTEURDISQUETTE
      			 sAfficheDisq=gimage(1,4)
      		cas 2
      			eTyp=5	// Disque dur
      			//sAfficheDisq=DISQUEDUR
      			sAfficheDisq=gimage(1,5)
      		cas 4
      			 eTyp=6	// Réseau
      			 //sAfficheDisq=DISQUERESEAU
      			 sAfficheDisq=gimage(1,6)
      		cas 8
      			eTyp=7	// CD
      			//sAfficheDisq=LECTEURCD
      			sAfficheDisq=gimage(1,7)
      		cas 16
      			eTyp=8	// RAM
      			//sAfficheDisq=DISQUERAM
      			sAfficheDisq=gimage(1,8)
      		autre cas
      			eTyp=7	// Inconnu: comme si réseau
      			//sAfficheDisq=DISQUEDUR
      			sAfficheDisq=gimage(1,5)
      	fin
      	//si pas DisquetteOK et eTyp=4 alors eTyp=0		// Ignore les disquettes
      	si eTyp>0 alors
      		// Disque ou réseau: ignore les disquettes
      		//sAfficheDisq=+" ("+sCh+")"+sAfficheDisq
          	arbreAjoute(sNomTV,"Poste de travail"+tab+sCh,sAfficheDisq,sAfficheDisq,sAfficheDisq)
      	fin   
      fin
      
      arbrederoule(sNomTV,"Poste de travail")
      
     type : 458752
   -
     name : RendNomSeul
     procedure_id : 4511921707615716231
     type_code : 14
     code : |1+
      fonction RendNomSeul(pNomComplet)
      // Rend le nom seul (sans "\" en fin)
      
      Ind			est un entier
      NomComplet	est une chaine
      
      NomComplet=SansEspace(pNomComplet)
      
      si NomComplet="" alors renvoyer ""
      
      // Recherche le dernier "\" ou ":"
      pour Ind=Taille(NomComplet) à 1 pas -1
      	si NomComplet[[Ind]]="\" ou NomComplet[[Ind]]=":" alors
      		renvoyer Milieu(NomComplet,Ind+1)	// Fin du nom
      	fin
      fin
      
      renvoyer NomComplet		// Pas de chemin
      
     type : 458752
   -
     name : RendRepSeul
     procedure_id : 4511921706557637521
     type_code : 14
     code : |1+
      fonction RendRepSeul(NomComplet)
      // Rend le répertoire seul (sans "\" en fin)
      
      Ind	est un entier
      
      // Recherche le dernier "\"
      pour Ind=Taille(NomComplet) à 1 pas -1
      	si NomComplet[[Ind]]="\" ou NomComplet[[Ind]]=":" alors
      		sortir
      	fin
      fin
      
      si NomComplet[[Ind]]="\" alors renvoyer gauche(NomComplet,Ind-1)	// Sans "\" en fin
      si NomComplet[[Ind]]=":" alors renvoyer gauche(NomComplet,Ind)
      // Pas de répertoire
      renvoyer ""
      
     type : 458752
   -
     name : RetourneListeFichSelect
     procedure_id : 4511921707241374629
     type_code : 14
     code : |1+
      Fonction RetourneListeFichSelect(cNomZone)
      sLigneSel	est une chaine
      sUnFich		est une chaine
      sResultat 	est une chaine=""
      eIndLigne	est un entier
      
      //Lecture de la zone mémoire qui contient le numéro des lignes selectionnées
      sLigneSel=Mempremier(cNomZone)
      eIndLigne=tablecherche(gsColIdunique,sLigneSel)
      
      //Au moins une ligne de selectionnée ?
      si pas memendehors(cNomZone)alors
      	//Recuperation du nom du repertoire et du nom du fichier
      	sUnFich=repertoire[eIndLigne]+NOM[eIndLigne]
      	//Initialisation du resultat
      	sResultat=sUnFich 
      	//poursuite de la recherche
      	sLigneSel=Memsuivant(cNomZone)
      fin
      
      //D'autres lignes selectionnées ?
      tantque pas memendehors(cNomZone)
      	eIndLigne=tablecherche(gsColIdunique,sLigneSel)
      	//Recuperation du nom du repertoire et du nom du fichier
      	sUnFich=repertoire[eIndLigne]+NOM[eIndLigne]
      	//Taille limite des chaine de caracteres depassée avec ce fichier ?
      	si (taille(sUnFich)+ taille(sResultat))>(32*1024)
      		//Oui, merssage d'erreur et sortie
      //Code WinDev 5.5 remplacé par la migration :
      //		erreur(messtraduit(2011))   //2011:La selection contient trop de fichiers, les derniers fichiers selectionnés ne seront pas pris en com...
      		erreur(<§$000b§>)   //2011:La selection contient trop de fichiers, les derniers fichiers selectionnés ne seront pas pris en com...
      		sortir
      	fin
      	//ajout au resultat
      	sResultat=sResultat+rc+sUnFich
      	//poursuite de la recherche
      	sLigneSel=Memsuivant(cNomZone)
      fin
      
      
      renvoyer sResultat
      
     type : 458752
   -
     name : SansExt
     procedure_id : 4511921707115545559
     type_code : 14
     code : |1+
      fonction SansExt(NomFic)	// Rend sans l'extension (ni le ".")
      
      Pos	est un entier
      
      Pour Pos=Taille(NomFic) à 1 pas -1
      	si NomFic[[Pos]]="." ou NomFic[[Pos]]="\" alors sortir
      fin
      si NomFic[[Pos]]="." alors
      	renvoyer NomFic[[1 à Pos-1]]
      sinon
      	renvoyer NomFic			// pas de "." trouvé
      fin
      
     type : 458752
   -
     name : VerifSelection
     procedure_id : 4511921706543416289
     type_code : 14
     code : |1+
      Procédure VerifSelection(cNomzone="Zone1")
      //recherche de l'enregistrement en cours du fichier "produit" dans la zone mémoire des "séléctions"
      //cNomZone est la zone mémoire des "séléctions" des produits
      
      bRafraichir		est un booleen=faux
      eLignePrec		est un entier
      eIndice			est un entier
      
      //uneligne selectionnée dans la table ?
      si {gsNomTable}<>-1 alors
      	//Oui
      	//Touche Ctrl enfoncée ?
      //Code WinDev 5.5 remplacé par la migration :
      //	si toucheenfonce(teControl) alors
      	si ToucheEnfoncée(teControl) alors
      		//Oui
      		//Element déja selectionné ?
      		MemRecherche(cNomzone,{gsColIdunique})
      		si memtrouve(cNomzone) alors
      			//element trouvé
      			//La ligne est donc déjà selectionnée, on la déselectionne
      			{gsNomTable}[{gsNomTable}]..couleur=icouleurdefaut
      			{gsNomTable}[{gsNomTable}]..couleurfond=icouleurdefaut
      			memsupprime(cNomzone,MemEnCours(cNomzone))
      		sinon
      			//element non trouvé
      			//La ligne n'est donc pas selectionnée, on la deselectionne
      			{gsNomTable}[{gsNomTable}]..couleur=glCouleurSelectTexte
      			{gsNomTable}[{gsNomTable}]..couleurfond=glCouleurSelectFond
      			memajoute(cNomzone,{gsColIdunique},{gsColIdunique})
      		fin
      	sinon
      		//Touche Ctrl non enfoncée
      	
      		//Touche Shift enfoncée ?
      //Code WinDev 5.5 remplacé par la migration :
      //		si toucheenfonce(teshift) alors
      		si ToucheEnfoncée(teshift) alors
      			//Oui : selection de toutes les lignes entre la precedente ligne du bandeau 
      			//de selection et la ligne actuelle du bandeau de selection
      		
      			//Numéro de la ligne précédente du bandeau de selection
      			eLignePrec=val({gsNomTable}..note)
      		
      //Code WinDev 5.5 remplacé par la migration :
      //			MESSATTENTE..etat=actif
      			MESSATTENTE..etat=actif; MESSATTENTE..Visible=Vrai
      			gbAnnuler=faux
      			si eLignePrec>{gsNomTable} alors
      				pour eIndice=eLignePrec a {gsNomTable} pas -1
      					//recherche si deja selectionné
      					memrecherche(cNomzone,{gsColIdunique}[eIndice])
      					si pas memtrouve(cNomzone) alors
      						//element non trouvé
      						//on selectionne
      						{gsNomTable}[{gsNomTable}]..couleur=glCouleurSelectTexte
      						{gsNomTable}[{gsNomTable}]..couleurfond=glCouleurSelectFond
      						memajoute(cNomzone,{gsColIdunique}[eIndice],{gsColIdunique}[eIndice])
      					fin
      					//10 lignes ajoutées ?
      					si modulo(eIndice,10)=0 alors
      						//Annulation utilisateur ?
      						multitache(-1)
      						si gbAnnuler alors
      							sortir
      						fin
      					fin
      				fin
      			sinon
      				pour eIndice=eLignePrec a {gsNomTable} 
      					//recherche si deja selectionné
      					memrecherche(cNomzone,{gsColIdunique}[eIndice])
      					si pas memtrouve(cNomzone) alors
      						//element non trouvé
      						//on selectionne
      						{gsNomTable}[{gsNomTable}]..couleur=glCouleurSelectTexte
      						{gsNomTable}[{gsNomTable}]..couleurfond=glCouleurSelectFond
      						memajoute(cNomzone,{gsColIdunique}[eIndice],{gsColIdunique}[eIndice])
      					fin
      					//10 lignes ajoutées ?
      					si modulo(eIndice,10)=0 alors
      						//Annulation utilisateur ?
      						multitache(-1)
      						si gbAnnuler alors
      							sortir
      						fin
      					fin
      				fin
      			fin
      //Code WinDev 5.5 remplacé par la migration :
      //			MESSATTENTE..etat=invisible
      			MESSATTENTE..Visible=Faux
      		sinon
      			//Non
      			//Vide la zone mémoire
      			memsupprimetout(cNomzone)
      			memcree(cNomzone)
      			//deselection de la ligne en cours
      			{gsNomTable}[{gsNomTable}]..couleur=icouleurdefaut
      			{gsNomTable}[{gsNomTable}]..couleurfond=icouleurdefaut
      		
      			//La ligne n'est donc pas selectionnée, on la deselectionne
      			{gsNomTable}[{gsNomTable}]..couleur=glCouleurSelectTexte
      			{gsNomTable}[{gsNomTable}]..couleurfond=glCouleurSelectFond
      			memajoute(cNomzone,{gsColIdunique},{gsColIdunique})
      		fin
      	fin
      	//Maj de tout l'affichage de la table
      //Code WinDev 5.5 remplacé par la migration :
      //	tableaffiche(gsNomTable,"P")
      	tableaffiche(gsNomTable,taCourantBandeau)
      
      	//Numero de ligne du bandeau de selection en cours
      	{gsNomTable}..note={gsNomTable}
      fin
      
     type : 458752
