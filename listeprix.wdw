 message_bar :
  internal_properties : CQAAAAkAAAA6emzPW3wSw7QhKZ8jWTVfxFBoZQQGKzt5ElBnL5eSVJdgY0CHD1G7yMasviFy8UTcl5lezL2ZtonWgT68YPWjcFa5reFQP2d97BOLr9XsF9YDbX+UbpInMlVmfQ==
 actionbar : {}
 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1-
      fonction rapportclient(numeroclient = "")
      
      // Pour compatibilité 5.5
      MoiMême..Visible=Vrai
      
      global
      	totalcategorie est une chaine
      	totalcatadditionnel est une chaine
      	totalcatunite est une chaine
      	totalcatcontenant est une chaine
      	totalcatcarrelage est une chaine
      	totalcatverreunite est une chaine
      	totalcatthermos est une chaine
      	chaineordre est un chaine = inilit("LISTEPRIX","Ordre","1234567",repencours+"production.ini")
      	NouvelleListe est un booleen = faux
      	filtreactif est une chaine
      	ListeImprimee est un booleen
      	
      SaisieOrdreUnite = chaineordre[[1]]
      SaisieOrdrecarrelage = chaineordre[[2]]
      SaisieOrdreVerre = chaineordre[[3]]
      SaisieOrdrePeinture = chaineordre[[4]]
      SaisieOrdreThermos = chaineordre[[5]]
      SaisieOrdreforme = chaineordre[[6]]
      SaisieOrdreExtra = chaineordre[[7]]
      
      
      //si gimprimantepdfstatus alors
      //	BtnPdfStatusVert..visible = vrai
      //	BtnPdfStatusrouge..visible = faux
      //sinon
      //	BtnPdfStatusVert..visible = faux
      //	BtnPdfStatusrouge..visible = vrai
      //FIN
      
      
      chargeimage(1,maitre.FichierImage,1,13)
      ListeAjoute("crochet",gImage(1,7))
      
      //Code WinDev 5.5 remplacé par la migration :
      //_onglet1..etat = actif
      MaFenetre..Plan=1
      
      hlitpremier("Categori","Description")
      
      //Code WinDev 5.5 remplacé par la migration :
      //tantque pas h.endehors
      tantque pas HEnDehors()
      	tableajoute("TABLE1",faux+tab+Categori.Description+tab+Categori.cnumero)
      	totalcategorie += categori.cnumero+"_"
      	hlitsuivant("Categori","Description")
      FIN
      totalcatadditionnel = totalcategorie
      totalcatunite  = totalcategorie
      totalcatcontenant  = totalcategorie
      totalcatcarrelage = totalcategorie
      totalcatverreunite  = totalcategorie
      
      listeprix.rapportaimprimer[1] = vrai
      listeprix.rapportaimprimer[2] = vrai
      listeprix.rapportaimprimer[3] = vrai
      listeprix.rapportaimprimer[4] = vrai
      listeprix.rapportaimprimer[5] = vrai
      listeprix.rapportaimprimer[6] = vrai
      si gFormatFacture = 2 
      	listeprix.rapportaimprimer[7] = vrai
      	listeprix.rapportaimprimer[7]..Visible = vrai
      	listeprix.SaisieOrdreExtra..visible =vrai
      sinon
      	listeprix.rapportaimprimer[7] = faux
      	listeprix.rapportaimprimer[7]..Visible = Faux
      
      
      fin
      
      //Code WinDev 5.5 remplacé par la migration :
      //boutondetail..etat = actif
      //boutondetail..etat = actif; boutondetail..Visible=Vrai
      choixdetail = faux
      affichageclient = sansespace(client.nom)
      
      si sansespace(client.CourrielListePrix[1]) <> "" ou sansespace(client.CourrielListePrix[2]) <> "" ou sansespace(client.CourrielListePrix[3]) <> "" ...
      	ou sansespace(client.CourrielListePrix[4]) <> "" alors
      	BtnEmail..etat = actif
      	BtnEmail1..etat = actif
      sinon
      	BtnEmail..etat = grise
      	BtnEmail1..etat = grise
      
      FIN
      hexecuterequete(requeteperso)
      //hexecuterequete(requetepersoclient,hRequêteDéfaut,client.numero)
      
      executetraitement(ListeEffective,trtModification)
      
      HLitRecherche(UserGroup,IDUserGroup,Usager.IDGroupe)
      SI UserGroup.ModifPrix = Faux  ALORS GR_ModifcationPrix..Etat = Grisé
   -
