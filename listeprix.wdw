  procedures :
   -
     name : remplirtablecat
     procedure_id : 4511921620667708346
     type_code : 14
     code : |1+
      Procédure remplirtablecat(lefiltre)
      j est un entier
      
      pour j = 1 a tableoccurrence("TABLE1")
      	si position(lefiltre,complete(cat[j],3)) <> 0 alors
      		crochet[j] = vrai
      	sinon
      		crochet[j] = faux
      			
      	FIN
      	
      FIN
      
     type : 458752
   -
     name : sauvetablecat
     procedure_id : 4511921621185508292
     type_code : 14
     code : |1+
      Procédure sauvetablecat()
      lefiltre est une chaine = ""
      j est un entier
      
      pour j = 1 a tableoccurrence("TABLE1")
      	si crochet[j] alors
      		lefiltre += complete(cat[j],3)+"_"
      	FIN 
      FIN
      
      
      renvoyer(lefiltre)
      
     type : 458752
