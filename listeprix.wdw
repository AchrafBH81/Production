  -
    name : BtnEmail1
    identifier : 0x48f5f54315cc9d08
    internal_properties : 
    properties :
     x : 399
     y : 230
     width : 32
     height : 32
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         lnomfichier est une chaine
         listefichier est une chaine
         lsujet est une chaine
         lmessage est une chaine
         ladressecourriel est une chaine
         i est un entier
         
         //pdfc>>cPrinterStop = 1
         si frep(completerep(repdonnees)+"PDF\"+sansespace(client.numero)+"\ListePrix",frRépertoire) = "" alors
         	fRepCrée(completerep(repdonnees)+"PDF\"+sansespace(client.numero)+"\ListePrix")
         fin
         //pdfc>>cOption("AutosaveDirectory") = completerep(repdonnees)+"PDF\"+sansespace(client.numero)+"\ListePrix"
         //pdfc>>cOption("AutosaveFilename")  ="ListePrix"+Table_ListeHisto.ldate[Table_ListeHisto]
         //pdfc>>cOption("AutosaveFilename")  ="ListePrix"+Table_ListeHisto.lDate[Table_ListeHisto]+".pdf"
         //lnomfichier = pdfc>>cOption("AutosaveDirectory")+"\ListePrix"+Table_ListeHisto.ldate[Table_ListeHisto]+".pdf"
         lnomfichier =  ComplèteRep(repdonnees)+"PDF\"+SansEspace(Client.numero)+"\ListePrix\ListePrix"+Table_ListeHisto.lDate[Table_ListeHisto]+".pdf"
         si fFichierExiste(lnomfichier) alors
         	fSupprime(lnomfichier)
         fin
         
         sablier(vrai)
         ouvresoeur(FenAttentePetite,"Préparation du fichier PDF en cours"+rc+"Veuillez patienter ......")
         iConfigure(SansEspace(imprimantefacture),Vrai)
         iParamètre("DEFAUT=NON")
         iParamètre("FORMATPAPIER=LETTRE")
         iDestination(iPDFGénérique,lnomfichier)
         iFenêtreAbandon(faux)
         
         iimprimeetat(historique,Table_ListeHisto.Identifiant)
         
         
         //		multitache(500)
         //		frenomme(sansespace(config.DossierFichierPDF),...
         //		fExtraitChemin(config.DossierFichierPDF, fDisque+fRépertoire)+"Facture"+BonLivraison.bfacture+".pdf")
         //tantque pas pdfc>>ccountofprintjobs() = 1
         //fin
         //pdfc>>cPrinterStop = 0
         //tantque pdfc>>ccountofprintjobs() >= 1
         //	//	tantque sansespace(pdfc>>cOutputFilename) = ""
         //	//		si modulo(i,1000) = 0 alors
         //	//			message(pdfc>>cOutputFilename)
         //	//		fin
         //	i++
         //FIN
         multitache(100)
         ferme(FenAttentePetite)
         //pdfc>>cPrinterStop = 1
         
         listefichier+=lnomfichier
         
         
         
         si hlitrecherche(client,numero,client.numero) alors
         	pour i = 1 a 4
         		si sansespace(client.CourrielListePrix[i]) <> "" alors
         			ladressecourriel += sansespace(client.CourrielListePrix[i])+";"
         		fin
         	fin
         	si client.CLangue = 1 alors
         		lsujet = "Liste de prix"
         		lmessage = config.TexteFrancais[1]
         	sinon
         		lsujet = "Price List"
         		lmessage = config.Texteanglais[1]
         	fin	
         fin
         
         sablier(faux)
         
         ouvre(FenEmail,ladressecourriel,lsujet,lmessage,listefichier,client.numero,faux,4)
         
        type : 18
      -
        type : 161
        enabled : false
