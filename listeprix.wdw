  -
    name : Bouton3
    identifier : 0x268aa42c7d930861
    internal_properties : 
    properties :
     x : 524
     y : 86
     width : 80
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         
         lrapportaimprimer est un entier
         chaineordre  = INILit("LISTEPRIX","Ordre","123456",repencours+"production.ini")
         
         
         
         
         
         
         
         POUR i = 1 a 7
         	lrapportaimprimer = Position(chaineordre,NumériqueVersChaîne(i))
         	
         	SELON lrapportaimprimer
         		CAS 1	
         			SI listeprix.RAPPORTAIMPRIMER[1] ALORS
         				pEtatsRegroupés.AjouteEtat("Listeuniteclient" )
         			fin
         			
         			
         		CAS 2	
         			SI listeprix.RAPPORTAIMPRIMER[2]
         				pEtatsRegroupés.AjouteEtat("ListeCarrelageClient")
         				
         			FIN
         		CAS 3
         			SI listeprix.RAPPORTAIMPRIMER[3]
         				pEtatsRegroupés.AjouteEtat("ListeVerreUniteClient")
         			FIN
         		CAS 4
         			SI listeprix.RAPPORTAIMPRIMER[4]	
         				pEtatsRegroupés.AjouteEtat("listepeintureclient")
         			FIN
         		CAS 5
         			SI listeprix.RAPPORTAIMPRIMER[5]
         				SELON gFormatFacture
         					CAS 1	
         						pEtatsRegroupés.AjouteEtat("ListeThermosPrixClient")
         						
         					CAS 2
         						pEtatsRegroupés.AjouteEtat("ListeThermosPrixClienttrn")
         				FIN
         				
         			FIN
         			
         		CAS 6
         			SI listeprix.RAPPORTAIMPRIMER[6]
         				pEtatsRegroupés.AjouteEtat("ListeFormeClient"+tab+client.numero)
         			FIN
         			
         		CAS 7
         			SI listeprix.RAPPORTAIMPRIMER[7]
         				
         				//				iImprimeEtat(ListeExtraPrixClient,client.numero)
         				pEtatsRegroupés.AjouteEtat("ListeExtraPrixClientTrieStandard"+tab+client.numero+tab+"1")
         //				si HExécuteRequête(RequeteExtraTrie,2) _et_ pas hnbenr(RequeteExtraTrie) = 0 alors
         //					pEtatsRegroupés.AjouteEtat("ListeExtraPrixClientTrieStandard1"+tab+Client.numero+tab+"2")
         //				fin
         				
         			FIN
         			
         	FIN
         	
         FIN
         
         
         //SI PAS FenEtat(FenAttentePetite)=Inexistant ALORS
         //	Multitâche(200)
         //	Ferme(FenAttentePetite)
         //FIN
         
         
         ListeImprimee = faux
         iAperçu(i100) // La destination peut être l'imprimante, un PDF ...
         pEtatsRegroupés.sImprimeEtatAvecParametres(pEtatsRegroupés.sImprimeEtats())
         
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BtnEmail2
    identifier : 0x26dcb2b13e9b16b2
    internal_properties : 
    properties :
     x : 547
     y : 139
     width : 32
     height : 32
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         lnomfichier est une chaine
         lextensionNomfichier est une chaine = ""
         listefichier est une chaine
         lsujet est une chaine
         lmessage est une chaine
         ladressecourriel est une chaine
         i est un entier
         wborne1 est une chaine = sansespace(numeroclient)
         
         iniecrit("LISTEPRIX","Ordre",SaisieOrdreUnite+SaisieOrdrecarrelage+SaisieOrdreVerre+SaisieOrdrePeinture...
         +SaisieOrdreThermos+saisieordreforme+SaisieOrdreExtra,repencours+"production.ini")
         chaineordre  = inilit("LISTEPRIX","Ordre","12345",repencours+"production.ini")
         
         si nouvelleliste alors
         	listehisto.lClient = sansespace(numeroclient)
         	listehisto.lDate = DateEffective
         	listehisto.IdateRemplace = client.cDateDerniereListe
         	hajoute(ListeHisto)
         	client.cDateDerniereListe = dateeffective
         	hmodifie(client,hnumenrencours)
         	lextensionNomfichier = DateEffective
         FIN
         
         
         pdfc>>cPrinterStop = 1
         si frep(completerep(repdonnees)+"PDF\"+sansespace(client.numero)+"\ListePrix",frRépertoire) = "" alors
         	fRepCrée(completerep(repdonnees)+"PDF\"+sansespace(client.numero)+"\ListePrix")
         fin
         pdfc>>cOption("AutosaveDirectory") = completerep(repdonnees)+"PDF\"+sansespace(client.numero)+"\ListePrix"
         //pdfc>>cOption("AutosaveFilename")  ="ListePrix"+lextensionNomfichier
         pdfc>>cOption("AutosaveFilename")  ="ListePrix"+lextensionNomfichier+".pdf"
         lnomfichier = pdfc>>cOption("AutosaveDirectory")+"\ListePrix"+lextensionNomfichier+".pdf"
         si fFichierExiste(lnomfichier) alors
         	fSupprime(lnomfichier)
         fin
         
         sablier(vrai)
         ouvresoeur(FenAttentePetite,"Préparation du fichier PDF en cours"+rc+"Veuillez patienter...........")
         iconfigure(sansespace(imprimantepdf),vrai)
         iFenêtreAbandon(faux)
         iImprimeEtat(ListeNonHistorique,chaineordre)
         
         
         
         //		multitache(500)
         //		frenomme(sansespace(config.DossierFichierPDF),...
         //		fExtraitChemin(config.DossierFichierPDF, fDisque+fRépertoire)+"Facture"+BonLivraison.bfacture+".pdf")
         tantque pas pdfc>>ccountofprintjobs() = 1
         fin
         pdfc>>cPrinterStop = 0
         tantque pdfc>>ccountofprintjobs() >= 1
         	//	tantque sansespace(pdfc>>cOutputFilename) = ""
         	//		si modulo(i,1000) = 0 alors
         	//			message(pdfc>>cOutputFilename)
         	//		fin
         	i++
         FIN
         multitache(100)
         si FenEtat(FenAttentePetite) <> Inexistant alors
         	ferme(FenAttentePetite)
         fin
         pdfc>>cPrinterStop = 1
         
         listefichier+=lnomfichier+";"
         
         
         
         si hlitrecherche(client,numero,client.numero) alors
         	pour i = 1 a 4
         		si sansespace(client.CourrielListePrix[i]) <> "" alors
         			ladressecourriel += sansespace(client.CourrielListePrix[i])+";"
         		fin
         	fin
         
         	si client.CLangue = 1 alors
         		lsujet = "Liste de prix pour" + client.nom
         		lmessage = config.TexteFrancais[1]
         	sinon
         		lsujet = "Price List for" + Client.nom
         		lmessage = config.Texteanglais[1]
         	fin	
         fin
         
         sablier(faux)
         
         ouvre(FenEmail,ladressecourriel,lsujet,lmessage,listefichier,client.numero,faux,4)
         
        type : 18
      -
        type : 161
        enabled : false
