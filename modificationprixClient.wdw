 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1+
      procedure modificationprixClient(TypeModif = "Thermos")
      // Pour compatibilité 5.5
      MoiMême..Visible=Vrai
      
      global
      
      	totalcategorie est une chaine
      	totalcatadditionnel est une chaine
      	totalcatunite est une chaine
      	totalcatcarrelage est une chaine
      	totalcatverreunite est une chaine
      
      	filtreactif est une chaine
      //ListeAjoute("crochet",gImage("MarquTab.ICO"))
      
      	//Code WinDev 5.5 remplacé par la migration :
      	//_onglet1..etat = actif
      MaFenetre..Plan=1
      
      
      selon TypeModif
      	cas "Thermos"
      		grpthermos..etat = actif
      		grpproduit..etat = grise
      //		CaseExtra = vrai
      		CASEVUNITE=vrai
      		CaseThermos = vrai
      
      	autres cas
      		grpthermos..etat = grise
      		grpproduit..etat = actif
      		CaseThermos = Faux
      		Casevunite = Faux
      		
      FIN
      GrpPourc..etat = grise
      
      ExécuteTraitement(CASEPBASE,trtModification)
      ExécuteTraitement(CASEExtra,trtModification)
      ExécuteTraitement(CaseThermos,trtModification)
      ExécuteTraitement(CASEPUNITE,trtModification)
      ExécuteTraitement(CASECARR,trtModification)
      ExécuteTraitement(CaseForme,trtModification)
      ExécuteTraitement(CASEPeinture,trtModification)
      ExécuteTraitement(CASEVUNITE,trtModification)
   -
     code : |1+
      
      
     type : 34
