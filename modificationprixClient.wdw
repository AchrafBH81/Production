#To edit and compare internal_properties, use WINDEV integrated tools.
#Internal properties refer to the properties of controls in windows, reports, etc.
info :
 name : modificationprixClient
 major_version : 29
 minor_version : 0
 type : 2
 description : Modification de prix
 subtype : 0
window :
 name : modificationprixClient
 identifier : 0x41884e682f2503db
 internal_properties : 
 properties :
  x : 120
  y : 50
  width : 498
  height : 575
  widthClient : 496
  heightClient : 543
 controls :
  -
    name : BTN_OK
    identifier : 0x41884e6873eb03db
    internal_properties : 
    properties :
     x : 345
     y : 187
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         i est un entier
         FlagModifspecial est un booleen    // savoir si on fait la modif de la case a cocher special de la ligne 
         flagmodif est un booleen           // savoir si on fait la modif de la ligne
         FlagModifCommande est un booleen = faux
         modificationprixClient..etat = grise
         lPourcentage est un reel
         
         
         selon TypeModif
         
         	cas "Thermos" 
         
         		pour i = 1 a tableoccurrence(fenclient.table1)
         			si estverreunite(i) alors
         				lPourcentage = modificationprixClient.POURVUNITE
         			sinon
         				lPourcentage = modificationprixClient.POURthermos
         			fin
         
         			si InterrupteurChoix[1] alors
         				fenclient.table1.tenprixa[i] = arrondi(fenclient.table1.tenprixa[i]  * (1 + ( lPourcentage /100)),2)
         				fenclient.table1.tenprixm[i] = arrondi(fenclient.table1.tenprixm[i]  * (1 + (  lPourcentage /100)),2)
         				fenclient.table1.tspecial[i] = vrai
         			sinon
         				si InterrupteurChoix[2]  et fenclient.table1.timprime[i]  alors
         					fenclient.table1.tenprixa[i] = arrondi(fenclient.table1.tenprixa[i]  * (1 + (  lPourcentage /100)),2)
         					fenclient.table1.tenprixm[i] = arrondi(fenclient.table1.tenprixm[i]  * (1 + (  lPourcentage /100)),2)
         					fenclient.table1.tspecial[i] = vrai
         				sinon
         					si InterrupteurChoix[3]  et fenclient.table1.tspecial[i]  alors
         						fenclient.table1.tenprixa[i] = arrondi(fenclient.table1.tenprixa[i]  * (1 + (  lPourcentage /100)),2)
         						fenclient.table1.tenprixm[i] = arrondi(fenclient.table1.tenprixm[i]  * (1 + (  lPourcentage /100)),2)
         					fin
         				fin
         			fin
         
         		FIN
         		fenclient.gModificationPrixThermos = vrai
         
         	autres cas   // carrelage
         		pour i = 1 a tableoccurrence(fenclient.table_1)
         			si InterrupteurChoix[1] alors
         				flagmodif = vrai
         			sinon
         				si InterrupteurChoix[2]  et fenclient.table_1.cimprime[i]  alors
         					flagmodif = vrai
         					FlagModifspecial = vrai
         				sinon
         					si InterrupteurChoix[3]  et fenclient.table_1.cspecial[i]  alors
         						flagmodif = vrai
         					sinon 
         						flagmodif = faux
         					FIN
         				fin
         			FIN
         
         			si flagmodif alors
         				selon fenclient.table_1.ptype[i]
         
         					cas 1                        // produit a l'unite
         						si modificationprixClient.CASEPUNITE alors
         							fenclient.table_1.pprixa[i] = arrondi(fenclient.table_1.pprixa[i]  * (1 + ( modificationprixclient.POURPUNITE /100)),2)
         							fenclient.table_1.pprixm[i] = arrondi(fenclient.table_1.pprixm[i]  * (1 + ( modificationprixclient.POURPUNITE /100)),2)
         							fenclient.table_1.cspecial[i] = vrai
         						fin
         
         					cas 2                        // Verre a l'unite
         						si modificationprixClient.CASEvUNITE alors
         							fenclient.table_1.pprixa[i] = arrondi(fenclient.table_1.pprixa[i]  * (1 + ( modificationprixclient.POURvUNITE /100)),2)
         							fenclient.table_1.pprixm[i] = arrondi(fenclient.table_1.pprixm[i]  * (1 + ( modificationprixclient.POURvUNITE /100)),2)
         							fenclient.table_1.cspecial[i] = vrai
         						fin
         
         					cas 4                        // carrelage
         						si modificationprixClient.CASECARR alors
         							fenclient.table_1.pprixm[i] = arrondi(fenclient.table_1.pprixm[i]  * (1 + ( modificationprixclient.POURcarr /100)),2)
         							fenclient.table_1.cspecial[i] = vrai
         						fin
         						si modificationprixClient.CASECARRcarreau alors
         							fenclient.table_1.pprixa[i] = arrondi(fenclient.table_1.pprixa[i]  * (1 + ( modificationprixclient.POURCARRCARREAU /100)),2)
         							fenclient.table_1.cspecial[i] = vrai
         						fin
         						si modificationprixClient.CASECARRpied alors
         							fenclient.table_1.prixcarrpc[i] = arrondi(fenclient.table_1.prixcarrpc[i]  * (1 + ( modificationprixclient.POURCARRPIED /100)),2)
         							fenclient.table_1.prixcarrm[i] = arrondi(fenclient.table_1.prixcarrm[i]  * (1 + ( modificationprixclient.POURCARRPIED /100)),2)
         							fenclient.table_1.cspecial[i] = vrai
         						fin
         
         					cas 5                        // Peinture
         						si modificationprixClient.CASEPeinture alors
         							fenclient.table_1.pprixa[i] = arrondi(fenclient.table_1.pprixa[i]  * (1 + ( modificationprixclient.POURPeinture /100)),2)
         							fenclient.table_1.pprixm[i] = arrondi(fenclient.table_1.pprixm[i]  * (1 + ( modificationprixclient.POURPeinture /100)),2)
         							fenclient.table_1.cspecial[i] = vrai
         							fenclient.gModificationPrixPeinture = vrai
         						fin
         				fin
         			fin
         		fin
         
         		pour i = 1 a tableoccurrence(fenclient.TableCouleurExtra)
         			si InterrupteurChoix[1] alors
         				flagmodif = vrai
         			sinon
         				si InterrupteurChoix[3]  et fenclient.TableCouleurExtra.coulspecial[i]  alors
         					flagmodif = vrai
         				sinon 
         					flagmodif = faux
         				FIN
         			fin
         			si flagmodif alors
         				fenclient.TableCouleurExtra.coulextralineaire[i] = arrondi(fenclient.TableCouleurExtra.coulextralineaire[i]  * (1 + ( modificationprixclient.POURPeinture /100)),2)
         				fenclient.TableCouleurExtra.coulextralineairem[i] = arrondi(fenclient.TableCouleurExtra.coulextralineairem[i]  * (1 + ( modificationprixclient.POURPeinture /100)),2)
         				fenclient.TableCouleurExtra.coulextracarreau[i] = arrondi(fenclient.TableCouleurExtra.coulextracarreau[i]  * (1 + ( modificationprixclient.POURPeinture /100)),2)
         				fenclient.TableCouleurExtra.coulspecial[i] = vrai
         			fin
         			//		fin
         		fin
         
                 // Formes
                 
         		pour i = 1 a tableoccurrence(fenclient.tableforme)
         			si InterrupteurChoix[1] alors
         				flagmodif = vrai
         			sinon
         				si InterrupteurChoix[2]  et fenclient.tableforme.fimprime[i]  alors
         					flagmodif = vrai
         					FlagModifspecial = vrai
         				sinon
         					si InterrupteurChoix[3]  et fenclient.tableforme.fspecial[i]  alors
         						flagmodif = vrai
         					sinon 
         						flagmodif = faux
         				    FIN
         			    fin
         		    FIN
         		si flagmodif alors
         			fenclient.Tableforme.fprixdouble[i] = arrondi(fenclient.Tableforme.fprixdouble[i]  * (1 + ( modificationprixclient.POURformes /100)),2)
         			fenclient.Tableforme.fprixtriple[i] = arrondi(fenclient.Tableforme.fprixtriple[i]  * (1 + ( modificationprixclient.POURformes /100)),2)
         			fenclient.Tableforme.fspecial[i] = vrai
         		fin
         
         
         
                fin
         
         
         
         si modificationprixClient.CASEPeintureCarreau alors
         	fenclient.CPrixSpecialPeintureCarrelage = arrondi(fenclient.CPrixSpecialPeintureCarrelage  * (1 + ( modificationprixclient.POURPeintureCarreau /100)),2)
         	fenclient.gModificationPrixpeinture = vrai
         fin
         fin
         
         multitache(100)
         ferme(modificationprixClient)
         
         
        type : 18
      -
        type : 161
        enabled : false
