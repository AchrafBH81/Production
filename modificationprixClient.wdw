  procedures :
   -
     name : EstVerreUnite
     procedure_id : 5262257513996183652
     type_code : 14
     code : |1+
      Procédure EstVerreUnite(NoLigne)
      cpt est un entier=0
      
      si pas sansespace(fenclient.table1.tencomp1[NoLigne]) = "" alors
      	cpt++
      FIN
      
      si pas sansespace(fenclient.table1.tencomp2[NoLigne]) = "" alors
      	cpt++
      FIN
      
      si pas sansespace(fenclient.table1.tencomp3[NoLigne]) = "" alors
      	cpt++
      FIN
      
      si cpt = 1 alors renvoyer vrai
      
      renvoyer faux
      
     type : 458752
