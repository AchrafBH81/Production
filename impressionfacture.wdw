         btn_ecran..etat = actif; btn_ecran..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         //btn_imprime..etat = actif
         btn_imprime..etat = actif; btn_imprime..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         //moimeme..etat = grisé
         moimeme..etat = grisé; moimeme..Visible=Vrai
                tableselectplus("TABLE_FACTURE",1)
         		
         		pour j = 1 a tableoccurrence("TABLE_FACTURE")
         		  si j > tableoccurrence("TABLE_FACTURE",1) alors
         		    tableselectplus("TABLE_FACTURE",j)
         		  fin
         			si cimprime[j] et ctransfert[j] = 0  alors
                       si hlitrecherche(BonLivraison,Bnumero,table_facture.TBonLivraison[j]) alors
         				si transfert_facture(table_facture.TBonLivraison[j]) alors
         					
         				
         								    ctransfert[j] = 1
         		            
         				sinon
         		            ctransfert[j] = 2
         			    fin
         			   fin 
         			fin	
         //         multitache(100)
         	   FIN
         
