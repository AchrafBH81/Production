        code : |1+
         j est un entier
         AuMoinsUneFactureChoisie=faux
         pasmemeclient = faux
         lnumeroclient est un chaine
         i est un entier
         
         pour j = 1 to tableoccurrence(TABLE_FACTURE)
         	choix[j] = Vrai
         	table_facture.DATEF[j] = csdDateFacture
         FIN
         
         pour i =1 a TableOccurrence(TABLE_FACTURE)
         	si TABLE_FACTURE.CHOIX[i] alors
         		AuMoinsUneFactureChoisie=vrai
         		si Table_Facture.tclient[i] <> lnumeroclient et pas lnumeroclient = "" alors
         			pasmemeclient = vrai
         		sinon
         			lnumeroclient = Table_Facture.tclient[i]	
         		FIN
         	FIN
         FIN
         
         allumeboutonimpression(AuMoinsUneFactureChoisie)
         si AuMoinsUneFactureChoisie alors
         	si pasmemeclient alors
         		csDestination[2]..etat= grise
         	sinon
