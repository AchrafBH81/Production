  -
    name : BTN_Refresh
    identifier : 0x283c6b92c7ac3ac8
    internal_properties : 
    properties :
     x : 188
     y : 24
     width : 25
     height : 25
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         nResRecherche est un entier
         TABLE_RackNumber.SupprimeTout()
         sTxtsql est une chaîne = [
         select distinct racking.rackNumber from racking where racking.RackingDate = {pDate} and Racking.RackNumber <> 99 ORDER BY RackNumber
         ]
         sdReqsql est une Source de données
         sTxtSqlNewRack est une chaine = [
           select * from CustomerRackNumber where CustomerrackNumber.Rackdate = {pDate}
         ]
         sdReqsqlNewRack est une Source de données
         
         sdReqsql.pDate = SAI_DateToProcess
         si HExécuteRequêteSQL(sdReqsql,hRequêteDéfaut,sTxtsql) alors
         	pour CHAQUE sdReqsql 
         		TABLE_RackNumber.Ajouteligne(sdReqsql.RackNumber,0)
         	FIN
         FIN
         
         sdReqsqlNewRack.pDate = SAI_DateToProcess
         SI HExécuteRequêteSQL(sdReqsqlNewRack,hRequêteDéfaut,sTxtSqlNewRack) ALORS
         	POUR CHAQUE sdReqsqlNewRack 
         		nResRecherche = tablecherche("COL_CurrentNumber",sdReqsqlNewRack.currentracknumber,rechercheIdentique)
                 si nResRecherche <> -1 alors
                    TABLE_RackNumber.COL_NewNumber[nResRecherche] = sdReqsqlNewRack.newracknumber
                	fin
                 	 
         	FIN
         FIN
         
         
         
         BTN_Save..etat = grise
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_Save
    identifier : 0x283c6eb8c7b687a5
    internal_properties : 
    properties :
     x : 547
     y : 81
     width : 25
     height : 25
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         pour chaque ligne de TABLE_RackNumber
         	si TABLE_RackNumber.COL_NewNumber <> 0 alors
         		si hlitrecherche(CustomerrackNumber,RackdateCurrentRackNumber,[SAI_DateToProcess,TABLE_RackNumber.COL_CurrentNumber]) alors
         			CustomerrackNumber.NewRackNumber = TABLE_RackNumber.COL_NewNumber
         			hmodifie(CustomerrackNumber,hNumEnrEnCours)
         		SINON
         			HRAZ(CustomerrackNumber)
         			CustomerrackNumber.Rackdate				= SAI_DateToProcess
         			CustomerrackNumber.CurrentRackNumber	= TABLE_RackNumber.COL_CurrentNumber
         			CustomerrackNumber.newRackNumber		= TABLE_RackNumber.COL_NewNumber
         			hajoute(CustomerrackNumber)
         		FIN
         	Fin
         FIN
         btn_save..Etat = grise
        type : 18
      -
        type : 161
        enabled : false
