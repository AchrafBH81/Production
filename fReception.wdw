   -
     name : ConcaneteDimension
     procedure_id : 5437075521528449608
     type_code : 14
     code : |1+
      Procédure ConcaneteDimension(llargeur="",lhauteur="")
      
      si llargeur <> "" et lhauteur <> "" alors
      	renvoyer llargeur + " X " + lhauteur
      sinon
      	renvoyer ""	
      FIN
     type : 458752
