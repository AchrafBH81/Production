     type : 458752
   -
     name : VerifieSiToutRecu
     procedure_id : 5429581374443434267
     type_code : 14
     code : |1-
      Procédure VerifieSiToutRecu()
      lToutRecu est un entier = 0
      ltotalcommande est un entier = 0
      ltotalrecu est un entier = 0
      
      hlitrecherche(CommandeAchatDetail,IDCommandeAchat,lIdCommandeAchat)
      TANTQUE PAS HEnDehors(CommandeAchatDetail) ET CommandeAchatDetail.IDCommandeAchat = lIDCommandeAchat
      	
      	ltotalcommande += CommandeAchatDetail.cadQte
      	ltotalrecu += CommandeAchatDetail.cadQteRecue
      	
      	HLitSuivant(CommandeAchatDetail,IDCommandeAchat)
      FIN
      
      SI ltotalrecu = 0 ALORS
      	lToutRecu = 0
      SINON SI ltotalcommande > ltotalrecu ALORS
      	lToutRecu = 1
      SINON
      	lToutRecu = 2		
      FIN
      
      
      renvoyer lToutRecu
     type : 458752
