     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         //lidfacture est un entier
         //lsauveposition est un entier
         //lToutRecu est un booleen
         //si cstNoDocument = "" alors
         //	av_message("Erreur","Le numéro de document est obligatoire","Erreur")
         //	reprisesaisie(cstNoDocument)
         //FIN
         //
         //si pas DateValide(csddatereception) alors
         //	av_message("Erreur","Date invalide","Erreur")
         //	csddatereception = datesys()
         //	reprisesaisie(csddatereception)
         //FIN
         //
         //Reception.IDCommandeAchat = lIdCommandeAchat
         //Reception.RDate = csddatereception
         //reception.RNumero = cstNoDocument
         //hajoute(reception)
         //
         //i est un entier
         letat est un entier = 0
         pour i = 1 a TableOccurrence(TableAchatDetail)
         	si TableAchatDetail.tQteReception[i] <> 0 alors
         		si hlitrecherche(CommandeAchatDetail,IDCommandeAchatDetail,TableAchatDetail.tIdCommandeAchatDetail[i]) alors
         			CommandeAchatdetail.cadQteRecue+=TableAchatDetail.tQteReception[i]
         			hmodifie(CommandeAchatDetail,hNumEnrEnCours)		
         		FIN
         	fin
         FIN
         
         //
         letat = VerifieSiToutRecu()
         SI HLitRecherche(CommandeAchat,IDCommandeAchat,lIdCommandeAchat) ALORS
         	CommandeAchat.CaRecuPartiel = Faux
         	CommandeAchat.caetat = letat
         	HModifie(CommandeAchat,hNumEnrEnCours)
         FIN
         
         //si VerifieSiToutRecu()  alors
         //	si HLitRecherche(CommandeAchat,IDCommandeAchat,lIdCommandeAchat) alors
         //		CommandeAchat.CaEtat = 2
         //		CommandeAchat.CaRecuPartiel = faux
         //		hmodifie(CommandeAchat,hNumEnrEnCours)
         //	FIN
         //sinon
         //	si HLitRecherche(CommandeAchat,IDCommandeAchat,lIdCommandeAchat) alors
         //		CommandeAchat.CaEtat = 1
         //		CommandeAchat.CaRecuPartiel = vrai
         //		hmodifie(CommandeAchat,hNumEnrEnCours)
         //	fin
         //FIN
         //
         //
         //
         Ferme(fReception)
        type : 18
      -
        type : 161
