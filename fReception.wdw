  procedures :
   -
     name : RemplirDetailQte
     procedure_id : 5429561184258913825
     type_code : 14
     code : |1+
      Procédure RemplirDetailQte()
      
      hlitrecherche(CommandeAchatDetail,IDCommandeAchat,lIdCommandeAchat)
      tantque pas hendehors(CommandeAchatDetail) et CommandeAchatDetail.IDCommandeAchat = lIdCommandeAchat
      	si CommandeAchatDetail.cadQte-CommandeAchatDetail.cadQteRecue	<> 0 alors
      	tableajouteligne(TableAchatDetail,CommandeAchatDetail.cadNoProduit,CommandeAchatDetail.cadDescription,...
      	CommandeAchatDetail.cadQte,CommandeAchatDetail.cadQteRecue,...
      	CommandeAchatDetail.cadQte-CommandeAchatDetail.cadQteRecue,CommandeAchatDetail.IDCommandeAchatDetail)
      	fin
      	
      	hlitsuivant(CommandeAchatDetail,IDCommandeAchat)
      FIN
      
     type : 458752
