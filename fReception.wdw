  -
    name : csnnoFournisseur
    identifier : 0x4b58c9f320546968
    internal_properties : 
    properties :
     x : 29
     y : 121
     width : 176
     height : 24
    type : 2
    code_elements :
     type_code : 3
     p_codes :
      -
        code : |1+
         
         si moimeme = "" alors
         	av_message("Erreur","Le numéro de fournisseur est obligatoire","Erreur")
         	reprisesaisie()
         sinon
             moimeme = remplir_zero(moimeme,10)
         	si hlitrecherche(Fournisseur,Fnumero,moimeme) alors
         		cstNomFournisseur = fournisseur.fnom
         		csdIdFrn = fournisseur.IDFournisseur
         	sinon
         		av_message("Erreur","Fournisseur inexistant dans le fichier","Erreur")
         		moimeme = ""
         		cstNomFournisseur = ""
         		csdIdFrn = 0
         		reprisesaisie()
         		
         	FIN
         FIN
         si csddate = "" alors
         	av_message("Erreur","La date est obligatoire","Erreur")
         	reprisesaisie(csddate)
         
         FIN
         pageDetail()
        type : 16
