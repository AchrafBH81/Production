       identifier : 0x49357f876e21bc2b
       internal_properties : 
       properties :
        x : 21.5
        width : 148.581
        height : 5.
       code_elements :
        type_code : 29
        p_codes :
         -
           code : |1+
            si hlitrecherche(invent,INUM,RequeteClientProduit.Idproruit) alors
            	si client.CLangue=1 alors moimeme = sansespace(invent.IDESC) sinon moimeme = sansespace(invent.idesca)
            sinon
            	si client.CLangue=1 alors moimeme = "Produit Inexistant" sinon moimeme = "Product not found"	
            FIN
           type : 327692
         -
           type : 327699
           enabled : false
     -
       name : PRIXUNITE
       identifier : 0x49357f873871bc2b
       internal_properties : 
       properties :
        x : 170.181
        width : 25.2
        height : 5.
       code_elements :
        type_code : 29
        p_codes :
         -
           code : |1+
            //Code WinDev 5.5 remplacé par la migration :
            //escompte est un reel double = 0.00
            si RequeteClientProduit.IPprixSpecial alors
            //Code WinDev 5.5 remplacé par la migration :
            //	si pas h.endehors et h.trouve alors
             moimeme = RequeteClientProduit.IPrixa
            sinon
            	si hlitrecherche(invent,INUM,RequeteClientProduit.Idproruit) alors
            		moimeme = invent.iprixunite
            	sinon
            		moimeme = 0	 
            	FIN
            FIN
            
            
           type : 327692
         -
           type : 327699
           enabled : false
