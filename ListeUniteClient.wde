     type_code : 30
     p_codes :
      -
        code : |1+
         compteur est un entier = 1
         hlitrecherche("spinter","spcleclientproduitnumero",numeroclient+invent.inum+caract(0))
         
         //Code WinDev 5.5 remplacé par la migration :
         //tantque pas h.endehors et ...
         tantque pas HEnDehors() et ...
         	numeroclient+invent.inum = ...
         	spinter.spclient+spinter.spproduit
         compteur++
         hlitsuivant("spinter","spcleclientproduitnumero")
         
         fin
         //Code WinDev 5.5 remplacé par la migration :
         //si (compteur * 5) + _.debv > ihauteurpage() alors
         si (compteur * 5) + iHauteurRestantePage() > ihauteurpage() alors
            iterminepage()
         fin						  
         
        type : 327692
      -
        code : |1+
         selon invent.iunitetype 
         
         cas 4 
         //Code WinDev 5.5 remplacé par la migration :
         // IIMPRIMEETAT("LIGNEESCPIETAGEDETAIL",numeroclient+invent.INUM,numeroclient+invent.INUM)
          iHautBasPageImbriqué(Vrai); iImprimeEtat("LIGNEESCPIETAGEDETAIL",numeroclient+invent.INUM,numeroclient+invent.INUM)
         cas 1
         
         
         
         fin
         
        type : 327693
      -
        type : 327697
        enabled : false
 controls : []
 code_elements :
  type_code : 13
  p_codes :
   -
     code : |1+
      Procedure _LISTE_UNITE_UNITE_CLIENT(_pParam1="", _pParam2="", _pParam3="", _pParam4="")
      
      GLOBAL
      numeroclient est une chaine = _pparam1
      si pas listeprix.nouvelleliste alors
      	grpdaterempl..visible = faux
      	lvigueur..visible = faux
      	ldate..visible = vrai
      sinon
      	grpdaterempl..visible = vrai
      FIN
      si pas gImprimeCondPMT alors
      	GrpCondPmt..visible=faux
      FIN
      
      listeprix.ListeImprimee = Faux
     type : 327680
   -
     code : |1+
      
      
     type : 327695
   -
     code : |1+
      si hlitrecherche(invent,INUM,Requeteclientproduit.Idproruit) et pas invent.iactif alors renvoyer faux 
      SI pas (RequeteClientProduit.ITypeProduit = 1) ALORS RENVOYER FAUX
      SI pas RequeteClientProduit.IlisteDePrix ALORS RENVOYER FAUX
      
     type : 327696
   -
     code : |1+
      lNombreenrImprime = monetat..NbEnrImprimé
      
      
     type : 327682
  procedures :
   -
     name : assigneLibelle
     procedure_id : 5275262758286375901
     type_code : 14
     code : |1-
      Procédure assigneLibelle()
      i est un entier
      
      lTableauLibelle est un tableau de 10 chaines
      lTableauLibelle[1]  = "lentete,lentete"
      lTableauLibelle[2]  = "lvigueur,lvigueur"
      lTableauLibelle[3]  = "lremplace,lremplace"
      lTableauLibelle[4]  = "lproduitunite,lproduitunite"
      lTableauLibelle[5]  = "lproduitunitesuite,lproduitunitesuite"
      lTableauLibelle[6]  = "lnumero,lnumero"
      lTableauLibelle[7]  = "facdescription,facdescription"
      lTableauLibelle[8]  = "lprix,lprix"
      lTableauLibelle[9]  = "facdate,ldate"
      lTableauLibelle[10]  = "lcondpaiement,lcondpaiement"
      
      selon client.CLangue
      	cas 1
      		pour i = 1 a 10
      			si hlitrecherche(Traduction,TRecherche,extraitchaine(lTableauLibelle[i],1,",")) alors
      				{"ListeUniteClient."+ExtraitChaîne(lTableauLibelle[i],2,",")} = traduction.dFrancais
      			fin
      		FIN
      	cas 2
      		pour i = 1 a 10
      			si hlitrecherche(Traduction,TRecherche,extraitchaine(lTableauLibelle[i],1,",")) alors
      				{"ListeUniteClient."+ExtraitChaîne(lTableauLibelle[i],2,",")} = traduction.danglais
      			fin
      		FIN
      fin
     type : 458752
  procedure_templates : []
  property_templates : []
