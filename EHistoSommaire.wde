     -
       name : EcartMois
       identifier : 0x545c00df052b2743
       internal_properties : 
       properties :
        x : 246.915
        width : 22.45
        height : 5.77
       code_elements :
        type_code : 29
        p_codes :
         -
           code : |1+
            si ventemois = 0 et ventemoisprec = 0 alors 
            	moimeme = 0
            sinon SI VenteMois = 0 alors 
            	moimeme = -1
            sinon si ventemoisprec = 0 alors 
            	moimeme = 1
            sinon
            	moimeme = (ventemois - ventemoisprec) / abs(ventemoisprec) 
            	SI Abs(MoiMême) > 99.9999 ALORS 
            		SI MoiMême > 0 ALORS MoiMême = 99.9999 SINON MoiMême = -99.9999
            	FIN
            fin
           type : 327692
     -
       name : VenteAnnee
       identifier : 0x545c0651054d6abe
       internal_properties : 
       properties :
        x : 269.458
        width : 27.
        height : 5.77
       code_elements :
        type_code : 29
        p_codes :
         -
           code : |1+
            moimeme+= ventemois
           type : 327692
     -
       name : VenteAnneePrec
       identifier : 0x545c065105526ace
       internal_properties : 
       properties :
        x : 296.333
        width : 29.29
        height : 5.715
       code_elements :
        type_code : 29
        p_codes :
         -
