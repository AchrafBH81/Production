           type : 327692
     -
       name : EcartAnnee
       identifier : 0x545c065105576ace
       internal_properties : 
       properties :
        x : 325.623
        width : 19.817
        height : 5.715
       code_elements :
        type_code : 29
        p_codes :
         -
           code : |1+
            si venteannee = 0 et venteanneeprec = 0 alors 
            	moimeme = 0
            sinon SI Venteannee = 0 alors 
            	moimeme = -1
            sinon si venteanneeprec = 0 alors 
            	moimeme = 1
            sinon
            	moimeme = (VenteAnnee - venteanneeprec) / abs(venteanneeprec) 
            	si abs(moimeme) > 99.9999 alors 
            		si moimeme > 0 alors moimeme = 99.9999 sinon moimeme = -99.9999
            	FIN
            fin
           type : 327692
