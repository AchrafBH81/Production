   -
     name : assigneLibelle
     procedure_id : 5275280066344139214
     type_code : 14
     code : |1-
      Procédure assigneLibelle()
      i est un entier
      
      lTableauLibelle est un tableau de 20 chaines
      lTableauLibelle[1]  = "lentete,lentete"
      lTableauLibelle[2]  = "lentete,lEntete1"
      lTableauLibelle[3]  = "lvigueur,LVigueur"
      lTableauLibelle[4]  = "lvigueur,LVigueur1"
      lTableauLibelle[5]  = "lremplace,lremplace"
      lTableauLibelle[6]  = "lremplace,lremplace1"
      lTableauLibelle[7]  = "lthermos,lthermos"
      lTableauLibelle[8]  = "lthermos,lthermos1"
      lTableauLibelle[9]  = "lnumero,lnumero"
      lTableauLibelle[10]  = "lnumero,lnumero1"
      lTableauLibelle[11]  = "facdescription,facdescription"
      lTableauLibelle[12]  = "facdescription,facdescription1"
      lTableauLibelle[13]  = "langlais,langlais"
      lTableauLibelle[14]  = "langlais,langlais1"
      lTableauLibelle[15]  = "lmetrique,lmetrique"
      lTableauLibelle[16]  = "lmetrique,lmetrique1"
      lTableauLibelle[17]  = "lprix,lprix"
      lTableauLibelle[18]  = "lprix,lprix1"
      lTableauLibelle[19]  = "lcondpaiement,LCondpaiement"
      lTableauLibelle[20]  = "lcondpaiement,LCondpaiement1"
      
      selon client.CLangue
      	cas 1
      		pour i = 1 a 20
      			si hlitrecherche(Traduction,TRecherche,extraitchaine(lTableauLibelle[i],1,",")) alors
      				{"ListeThermosPrixClientHisto."+ExtraitChaîne(lTableauLibelle[i],2,",")} = traduction.dFrancais
      			fin
      		FIN
      	cas 2
      		pour i = 1 a 20
      			si hlitrecherche(Traduction,TRecherche,extraitchaine(lTableauLibelle[i],1,",")) alors
      				{"ListeThermosPrixClientHisto."+ExtraitChaîne(lTableauLibelle[i],2,",")} = traduction.danglais
      			fin
      		FIN
      fin
