     name : calculprix
     procedure_id : 5585070953921808943
     type_code : 14
     code : |1+
      Procédure calculprix(no_produit1,no_produit2,no_produit3,udemesure = "A",produitdebase="")
      montant est un reel  = 0
      nombredeverre est un entier = 0
      totalextra est un reel = 0
      hpos est un entier
      
      j est un entier
      
      si pas sansespace(no_produit1) = ""
          hlitrecherche("invent","INUM",no_produit1)
      //Code WinDev 5.5 remplacé par la migration :
      //	si pas h.endehors et h.trouve alors
      	si pas HEnDehors() et HTrouve() alors
             si pas sansespace(invent.ipextra) = ""
      			si invent.ipextra <> invent.inum alors
      				hpos = hsauveposition("invent")
                      hlitrecherche("invent","INUM",invent.ipextra)
      //Code WinDev 5.5 remplacé par la migration :
      //				si pas h.endehors et h.trouve alors
      				si pas HEnDehors() et HTrouve() alors
      					selon udemesure
      					 cas "A"
      						totalextra += invent.IPRIXA
                           cas "M"
      						totalextra += invent.iprixm
      				     FIN
      				FIN
      			    hretourposition(hpos)
      		    sinon
      					selon udemesure
      					 cas "A"
      						totalextra += invent.IPRIXA
                           cas "M"
      						totalextra += invent.iprixm
      				     FIN
      				
      		    FIN
      		FIN
      	   fin
             si pas sansespace(invent.ipextrat) = ""
      			si invent.ipextrat <> invent.inum alors
      				hpos = hsauveposition("invent")
                      hlitrecherche("invent","INUM",invent.ipextrat)
      //Code WinDev 5.5 remplacé par la migration :
      //				si pas h.endehors et h.trouve alors
      				si pas HEnDehors() et HTrouve() alors
      					selon udemesure
      					 cas "A"
      						totalextra += invent.IPRIXA
                           cas "M"
      						totalextra += invent.iprixm
      				     FIN
      				FIN
      			    hretourposition(hpos)
      			 
      		    sinon
      					selon udemesure
      					 cas "A"
      						totalextra += invent.IPRIXA
                           cas "M"
      						totalextra += invent.iprixm
      				     FIN
      				
      		    FIN
      	   fin
      		nombredeverre++
      FIN
      si pas sansespace(no_produit2) = ""
            hlitrecherche("invent","INUM",no_produit2)
      //Code WinDev 5.5 remplacé par la migration :
      //	si pas h.endehors et h.trouve alors
      	si pas HEnDehors() et HTrouve() alors
             si pas sansespace(invent.ipextra) = ""
      			si invent.ipextra <> invent.inum alors
      				hpos = hsauveposition("invent")
                      hlitrecherche("invent","INUM",invent.ipextra)
      //Code WinDev 5.5 remplacé par la migration :
      //				si pas h.endehors et h.trouve alors
      				si pas HEnDehors() et HTrouve() alors
      					selon udemesure
      					 cas "A"
      						totalextra += invent.IPRIXA
                           cas "M"
      						totalextra += invent.iprixm
      				     FIN
      				FIN
      			    hretourposition(hpos)
      		    sinon
      					selon udemesure
      					 cas "A"
      						totalextra += invent.IPRIXA
                           cas "M"
      						totalextra += invent.iprixm
      				     FIN
      				
      		    FIN
      		FIN
      	   fin
             si pas sansespace(invent.ipextrat) = ""
      			si invent.ipextrat <> invent.inum alors
      				hpos = hsauveposition("invent")
                      hlitrecherche("invent","INUM",invent.ipextrat)
      //Code WinDev 5.5 remplacé par la migration :
      //				si pas h.endehors et h.trouve alors
      				si pas HEnDehors() et HTrouve() alors
      					selon udemesure
      					 cas "A"
      						totalextra += invent.IPRIXA
                           cas "M"
      						totalextra += invent.iprixm
      				     FIN
      				FIN
      			    hretourposition(hpos)
      			 
      		    sinon
      					selon udemesure
      					 cas "A"
      						totalextra += invent.IPRIXA
                           cas "M"
      						totalextra += invent.iprixm
      				     FIN
      				
      		    FIN
      	   fin
      
      		nombredeverre++
      FIN
      si pas sansespace(no_produit3) = ""
              hlitrecherche("invent","INUM",no_produit3)
      //Code WinDev 5.5 remplacé par la migration :
      //	si pas h.endehors et h.trouve alors
      	si pas HEnDehors() et HTrouve() alors
             si pas sansespace(invent.ipextra) = ""
      			si invent.ipextra <> invent.inum alors
      				hpos = hsauveposition("invent")
                      hlitrecherche("invent","INUM",invent.ipextra)
      //Code WinDev 5.5 remplacé par la migration :
      //				si pas h.endehors et h.trouve alors
      				si pas HEnDehors() et HTrouve() alors
      					selon udemesure
      					 cas "A"
      						totalextra += invent.IPRIXA
                           cas "M"
      						totalextra += invent.iprixm
      				     FIN
      				FIN
      			    hretourposition(hpos)
      		    sinon
      					selon udemesure
      					 cas "A"
      						totalextra += invent.IPRIXA
                           cas "M"
      						totalextra += invent.iprixm
      				     FIN
      				
      		    FIN
      		FIN
      	   fin
             si pas sansespace(invent.ipextrat) = ""
      			si invent.ipextrat <> invent.inum alors
      				hpos = hsauveposition("invent")
                      hlitrecherche("invent","INUM",invent.ipextrat)
      //Code WinDev 5.5 remplacé par la migration :
      //				si pas h.endehors et h.trouve alors
      				si pas HEnDehors() et HTrouve() alors
      					selon udemesure
      					 cas "A"
      						totalextra += invent.IPRIXA
                           cas "M"
      						totalextra += invent.iprixm
      				     FIN
      				FIN
      			    hretourposition(hpos)
      			 
      		    sinon
      					selon udemesure
      					 cas "A"
      						totalextra += invent.IPRIXA
                           cas "M"
      						totalextra += invent.iprixm
      				     FIN
      				
      		    FIN
      	   fin
      
      		nombredeverre++
      FIN
      	
      //hlitrecherche("ENSEMBLE","clecomposant",spqteint.spqcomposant1+spqteint.spqcomposant2+spqteint.spqcomposant3)
      //si pas h.endehors et h.trouve alors
          hpos = hsauveposition("invent")
      	hlitrecherche("invent","INUM",produitdebase)
      //Code WinDev 5.5 remplacé par la migration :
      //    si pas h.endehors et h.trouve alors
          si pas HEnDehors() et HTrouve() alors
      	selon nombredeverre
      	cas 2
      		selon udemesure
      		cas "A"
      		   montant = invent.iprixdouble
      		cas "M"
      		   montant = invent.iprixdoublem
      	
               FIN
      	cas 3
      		selon udemesure
      		cas "A"
      		   montant = invent.iprixtriple
      		cas "M"
      		   montant = invent.iprixtriplem
      		fin   
      	FIN
          
      //fin
      FIN
      
      renvoyer montant + totalextra
      
