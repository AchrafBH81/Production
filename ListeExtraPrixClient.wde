    controls :
     -
       name : RUBRIQ1
       identifier : 0x4d82287134728a4e
       internal_properties : 
       properties :
        x : 30.9
        width : 89.01
        height : 4.762
       code_elements :
        type_code : 29
        p_codes :
         -
           code : |1+
            si client.CLangue=1 alors moimeme = RequeteProduitExtra.IDESC sinon moimeme = RequeteProduitExtra.idesca
            
           type : 327692
         -
           type : 327699
           enabled : false
     -
       name : CALCUL1
       identifier : 0x4d82287176eb8a4e
       internal_properties : 
       properties :
        x : 119.91
        width : 18.721
        height : 4.762
       code_elements :
        type_code : 29
        p_codes :
         -
           code : |1+
            //si hlitrecherche(FclientExtra,IdClientNoProduit,HConstruitValClé(FclientExtra,IdClientNoProduit,client.IDClient,sansespace(RequeteProduitExtra.INUM))) alors
            resultat est une chaine
            si fclientextra.prixSpecial alors
            	si RequeteProduitExtra.ibase alors
            		calcul1 = FclientExtra.PrixAnglaisD
            		calcul2 = FclientExtra.PrixMetriqueD
            		calcul3 = FclientExtra.PrixAnglaisT
            		calcul4 = FclientExtra.PrixMetriqueT
            		calcul3..CouleurFond = iCouleurDéfaut
            		calcul4..CouleurFond = iCouleurDéfaut
            	sinon
            			
            		calcul1 = FclientExtra.PrixAnglais
            		calcul2 = FclientExtra.PrixMetrique
            		calcul3 = 0
            		calcul4 = 0
            		calcul3..CouleurFond = iGrisClair
            		calcul4..CouleurFond = iGrisClair
            
            		
            	FIN
            sinon
            	si RequeteProduitExtra.ibase alors
            		calcul1 = RequeteProduitExtra.IPRIXDOUBLE
            		calcul2 = RequeteProduitExtra.iprixdoublem
            		calcul3 = RequeteProduitExtra.IPRIXtriple
            		calcul4 = RequeteProduitExtra.iprixtriplem
            		calcul3..CouleurFond = iCouleurDéfaut
            		calcul4..CouleurFond = iCouleurDéfaut
            	sinon
                    resultat = calculprixextra(requeteproduitextra.INUM)
            		calcul1 = val(extraitchaine(resultat,1,","))
            		calcul2 = val(extraitchaine(resultat,2,","))
            		calcul3 = 0
            		calcul4 = 0
            		calcul3..CouleurFond = iGrisClair
            		calcul4..CouleurFond = iGrisClair
            	FIN
            
            FIN
            
           type : 327692
         -
           type : 327699
           enabled : false
     -
