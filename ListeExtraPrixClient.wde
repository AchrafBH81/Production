     code : |1+
      Procedure _LISTE_THERMOS_CLIENT(_pParam1="", _pParam2="", _pParam3="", _pParam4="")
      
      GLOBAL
      	NUMEROCLIENT EST UNE CHAINE = _PPARAM2
      	clederecherche est une chaine
      	// Ne sauvegarde pas les paramètres spécifiés
      si pas listeprix.NouvelleListe alors
      	GrpDateRempl..visible = faux
      	lvigueur..visible = faux
      	ldate..visible = vrai
      sinon
      	GrpDateRempl..visible = vrai
      //
      FIN
      si pas gImprimeCondPMT alors
      	GrpCondPmt..visible=faux
      fin
      
      assigneLibelle()
     type : 327680
   -
     code : |1-
      
     type : 327695
   -
     code : |1+
      // Vérification de la condition
      si hlitrecherche(FclientExtra,IdClientNoProduit,HConstruitValClé(FclientExtra,IdClientNoProduit,client.IDClient,sansespace(RequeteProduitExtra.INUM))) alors
      	si pas FclientExtra.ListeDePrix alors
      		renvoyer faux
      	fin
      sinon
      renvoyer faux
      fin
      
      
      RENVOYER VRAI		// Enregistrement accepté
      
      
