      					fin	
      					
      					// Options
      					
      				fin
      			fin
      		FIN
      		netpbase = prixdebase * (100 - escpbase) /100
      		
      	fin
      	resultat = net[1]+ ...
      	net[2]+...
      	net[3]+...
      	nett[1]+...
      	nett[2]+...
      	nett[3]+...
      	netpbase 
      	
      	renvoyer resultat
      
