   -
     name : lAlimenteFichier
     procedure_id : 5073317694360415494
     type_code : 14
     code : |1+
      Procédure lAlimenteFichier()
      lcoutthermos est un reel
      lSurchargeBase est un reel
      
      si hlitrecherche(client,numero,hfacture.faclient) alors
      	si client.csurchargebase <> 0.00 alors
      		lSurchargeBase = client.csurchargebase
      	sinon
      		lSurchargeBase = config.surchargebase
      	FIN
      sinon
      	lSurchargeBase = config.surchargebase
      
      fin
      
      pour tout hfacture avec "nolot <> 0"
      	si hfacture.fadatecommande >= csddate alors
      		csnnofacture = hfacture.fanumero
      		si hlitrecherche(BonLivraison,Bnumero,hfacture.fanofacture) alors
      			lnobon = BonLivraison.Bnumero
                  ldatelivraison = bonlivraison.bdate
                  ldatefacture = BonLivraison.BDateFacture
      			
      		FIN
      		pour tout hfdetail avec "HFCLEUNIK = " + hfacture.HFCLEUNIK
      
      			lcoutthermos=hfdetail.fdprixtotal+(hfdetail.fdprixtotal*lSurchargeBase/100)
      			selon hfdetail.ftype
      				cas 1
      					CalculCoutantVerre(lcoutthermos)
      				cas 4
      					CalculCoutantcarrelage(hfdetail.fdnumcarr,lcoutthermos)
      			FIN
      		FIN
      	fin
      
      FIN
      
      
      multitache(200)
      ferme()
      
      
      
     type : 458752
   -
     name : CalculCoutantcarrelage
     procedure_id : 5073329510354085818
     type_code : 14
     code : |1+
      Procédure CalculCoutantcarrelage(lnumcarr,lcout)
      // fcoutant.ftype 
      //
      // 1 = verre
      // 2 = Spacer
      // 3 = cap
      // 4 = gaz
      // 5 = carrelage
      // 6 = Main d'oeuvre
      // 7 = Frais généraux
      // 8 = Autres frais
      // 9 = Main d'oeuvre Carrelage
      i est un entier
      
      lNoRecEnCours est un entier
      lnoproduitassocie est une chaine
      lresultat est un reel
      resultatcondition est un booleen = faux
      ltotaldimension est un reel
      lCoutantProduit est un reel
      lpourperte est un reel
      lperte est un reel
      lCoutantTotalLigne est un reel = 0
      
      SupprimeLigneCoutant(hfacture.fanumero,hfdetail.fdligne)
      AssigneVariableCarrelage()
      
      
      // carrelage
      si position(hfdetail.fCAPGAZTUBE,"C") <> 0 alors
      	H1-= 0.004
      	L1-= 0.004
      FIN
      
      // MDO
      
      
      
      formule = sansespace(config.cMDOFormuleCarrelage)
      res = compile("formule1","y est un reel"+rc+"y="+formule+rc+"renvoyer y") 
      si res = ""
      	lresultat= ExécuteTraitement("formule1",trtProcédure)
      	selon config.cUniteMDOCarrelage 
      		cas 1
      		cas 2
      			lresultat = lresultat / 1000
      		cas 3		
      			lresultat = lresultat / 1000000
      	FIN
      
      	//	info(lresultat * config.cmdo)
      	hraz(Fcoutant)
      	fcoutant.cNoCommande = hfacture.fanumero
      	fcoutant.cNoLigne = hfdetail.fdligne
      	fcoutant.cType = 9
      	fcoutant.cSousType = 0
      	si config.cUniteMDOCarrelage = 4 alors
      		fcoutant.cqte = config.cMDOCarrelage
      		fcoutant.cCoutUnitaire = lcout
      		fcoutant.ccouttotal = arrondi(lcout * config.cMDOCarrelage/ 100,2)
      
      	sinon
      		fcoutant.cqte = lresultat
      		fcoutant.cCoutUnitaire = config.cMDOCarrelage
      		fcoutant.ccouttotal = arrondi(lresultat * config.cMDOCarrelagem,2)* hfdetail.fdqteafacturer
      
      	FIN
      
      	//	fcoutant.cqte = lresultat
      	//	fcoutant.cCoutUnitaire = config.cMDOCarrelage
      	//	fcoutant.ccouttotal = arrondi(lresultat * config.cMDOCarrelage,2)
      	fcoutant.cNoClient = hfacture.faclient
      	fcoutant.Cdatecommande = hfacture.fadate
      	fcoutant.nolot = hfacture.NoLot
      	lCoutantTotalLigne+=fcoutant.ccouttotal
      	hajoute(Fcoutant)
      fin
      
      
      /// Frais generaux seulement si calcul au pourcentage 
      
      // frais generaux
      
      si config.cunitefrg = 4 alors
      	hraz(Fcoutant)
      	fcoutant.cNoCommande = hfacture.fanumero
      	fcoutant.cNoLigne = hfdetail.fdligne
      	fcoutant.cType = 7
      	fcoutant.cSousType = 0
      	fcoutant.cqte = config.CFraisGeneraux
      	fcoutant.cCoutUnitaire = lcout
      	fcoutant.ccouttotal = arrondi(lcout * config.CFraisGeneraux / 100,2)
      
      	//	fcoutant.cqte = lresultat
      	//	fcoutant.cCoutUnitaire = config.CFraisGeneraux
      	//	fcoutant.ccouttotal = arrondi(lresultat * config.CFraisGeneraux,2)
      	lCoutantTotalLigne+=fcoutant.ccouttotal
      	fcoutant.cNoClient = hfacture.faclient
      	fcoutant.Cdatecommande = hfacture.fadate
      	fcoutant.nolot = hfacture.NoLot
      	hajoute(Fcoutant)
      fin
      
      
      /// Fourniture autre seulement si calcul au pourcentage 
      
      
      
      si config.cuniteaut = 4 alors
      	hraz(Fcoutant)
      	fcoutant.cNoCommande = hfacture.fanumero
      	fcoutant.cNoLigne = hfdetail.fdligne
      	fcoutant.cType = 8
      	fcoutant.cSousType = 0
      	fcoutant.cqte = config.CFournitureAutre
      	fcoutant.cCoutUnitaire = lcout
      	fcoutant.ccouttotal = arrondi(lcout * config.CFournitureAutre / 100,2)
      
      	//	fcoutant.cqte = lresultat
      	//	fcoutant.cCoutUnitaire = config.CFraisGeneraux
      	//	fcoutant.ccouttotal = arrondi(lresultat * config.CFraisGeneraux,2)
      	lCoutantTotalLigne+=fcoutant.ccouttotal
      	fcoutant.cNoClient = hfacture.faclient
      	fcoutant.Cdatecommande = hfacture.fadate
      	fcoutant.nolot = hfacture.NoLot
      	hajoute(Fcoutant)
      fin
      
      
      /// carrelage
      
      si hlitrecherche(typecarr,tcdescription,hfdetail.fdtypecalcul) alors
      	pour i = 1 a 10
      
      		formule = sansespace(typecarr.nbmorceau[i])
      		res = compile("formule1","y est un reel"+rc+"y="+formule+rc+"renvoyer y") 
      		si res = "" alors
      
      			si pas valideformule(formule) alors
      				{"NM"+i} = 0
      			sinon
      				{"NM"+i} = executetraitement("formule1",trtProcédure)
      			fin
      			si 	{"NM"+i} < 0 alors
      				{"NM"+i} = 0
      			FIN
      
      			si sansespace(typecarr.conditionsinm[i]) = "" alors
      				impvideo.vnbmorceau[i] = {"NM"+i}
      			sinon
      				formule = sansespace(typecarr.conditionsinm[i])
      				res = compile("formule2","y est un reel"+RC+"y="+formule+RC+"renvoyer y ")
      				si res = "" alors
      					resultatcondition = ExécuteTraitement("formule2",trtProcédure)
      
      					si resultatcondition  alors
      						formule = sansespace(typecarr.conditionalorsnm[i])
      						res = compile("formule2","y est un reel"+RC+"y="+formule+RC+"renvoyer y ")
      						si res = "" ALORS
      							{"NM"+i} = (ExécuteTraitement("formule2",trtProcédure))
      
      							impvideo.vnbmorceau[i] = {"NM"+i}
      						sinon
      							{"NM"+i} = 0
      
      						fin
      
      					sinon
      						impvideo.vnbmorceau[i] = {"NM"+i}
      
      					fin
      				sinon
      					{"NM"+i} = 0
      
      				fin
      
      			fin
      
      	FIN
      
      
      
      
      	formule = sansespace(typecarr.nbdimension[i])
      	res = compile("formule1","y est un reel"+rc+"y="+formule+rc+"renvoyer y") 
      	si res = "" alors
      		si pas valideformule(formule) alors
      			{"DM"+i} = 0
      		sinon
      			{"DM"+i} = executetraitement("formule1",trtProcédure)
      	fin
      	si 	{"DM"+i} < 0 alors
      		{"DM"+i} = 0
      	FIN
      
      
      
      	si sansespace(typecarr.conditionsidm[i]) = "" alors
      		impvideo.vdimensionmorceau[i] = {"DM"+i}
      	sinon
      		formule = sansespace(typecarr.conditionsidm[i])
      		res = compile("formule2","y est un reel"+RC+"y="+formule+RC+"renvoyer y ")
      		si res = "" alors
      			resultatcondition = ExécuteTraitement("formule2",trtProcédure)
      
      			si resultatcondition  alors
      				formule = sansespace(typecarr.conditionalorsdm[i])
      				res = compile("formule2","y est un reel"+RC+"y="+formule+RC+"renvoyer y ")
      				si res = "" ALORS
      					{"DM"+i} = (ExécuteTraitement("formule2",trtProcédure))
      
      					impvideo.vdimensionmorceau[i] = {"DM"+i}
      				sinon
      					{"DM"+i} = 0
      
      				fin
      
      			sinon
      				impvideo.vdimensionmorceau[i] = {"DM"+i}
      			fin
      		sinon
      			{"DM"+i} = 0
      
      	fin
      
      fin
      
      lresultat = {"DM"+i} / 1000
      lCoutantProduit = 0
      lpourperte =  config.cPourcPerteCarrelage
      
      si hlitrecherche(invent,INUM,lnumcarr) alors
      	lCoutantProduit = arrondi(invent.icoutantcarrelageM,2)
      fin
      lperte = arrondi({"NM"+i} * lresultat *  lCoutantProduit * lpourperte / 100,2)
      
      //info(lresultat * invent.iprixunite)
      hraz(Fcoutant)
      fcoutant.cNoCommande = hfacture.fanumero
      fcoutant.cNoLigne = hfdetail.fdligne
      fcoutant.cType = 5
      fcoutant.cSousType = 0
      fcoutant.cqte = {"NM"+i}
      fcoutant.CPourPerte = lpourperte
      fcoutant.cPerte = lperte
      fcoutant.CDimension = arrondi(lresultat * 1000,2)
      fcoutant.cCoutUnitaire = lCoutantProduit
      fcoutant.ccouttotal = arrondi(({"NM"+i} * lresultat * lCoutantProduit) + lperte,2)* hfdetail.fdqteafacturer
      lCoutantTotalLigne+=fcoutant.ccouttotal
      fcoutant.CFourniture = lnumcarr
      fcoutant.cNoClient = hfacture.faclient
      fcoutant.Cdatecommande = hfacture.fadate
      fcoutant.nolot = hfacture.NoLot
      hajoute(Fcoutant)
      
      
      FIN
      
      fin
      
      
      // Recherche des fournitures associées à ce carrelage
      
      
      //	si hlitrecherche(invent,INUM,lnumcarr) ALORS
      pour i = 1 a 10
      	si sansespace(typecarr.TformuleQteFourniture[i]) <> "" alors
      		lnoproduitassocie = typecarr.TProduitAssocie[i]
      
      		lNoRecEnCours = HSauvePosition(invent)
      		si hlitrecherche(invent,INUM,lnoproduitassocie) alors
      			formule = sansespace(typecarr.TformuleQteFourniture[i])
      			res = compile("formule1","y est un reel"+rc+"y="+formule+rc+"renvoyer y") 
      			si res = "" alors
      				lresultat= ExécuteTraitement("formule1",trtProcédure)
      				selon invent.iUniteMesure 
      					cas 1
      					cas 2
      						lresultat = lresultat / 1000
      					cas 3		
      						lresultat = lresultat / 1000000
      				FIN
      
      			fin
      			hraz(Fcoutant)
      			fcoutant.cNoCommande = hfacture.fanumero
      			fcoutant.cNoLigne = hfdetail.fdligne
      			fcoutant.cType = 5
      			fcoutant.cSousType = 1
      			fcoutant.cqte = lresultat
      			fcoutant.cCoutUnitaire = invent.icoutUnitem
      			fcoutant.ccouttotal = arrondi(lresultat * invent.icoutUnitem,2)* hfdetail.fdqteafacturer
      			lCoutantTotalLigne+=fcoutant.ccouttotal
      			fcoutant.CFourniture = invent.inum
      			fcoutant.cNoClient = hfacture.faclient
      			fcoutant.Cdatecommande = hfacture.fadate
      			fcoutant.nolot = hfacture.NoLot
      			hajoute(Fcoutant)
      
      
      	FIN
      	HRetourPosition(lNoRecEnCours)
      FIN
      FIN
      
      //	FIN
      
      
      
      
      FIN
      
      
      FcoutantLigne.cNoCommande = hfacture.fanumero
      FcoutantLigne.cNoLigne = hfdetail.fdligne
      fcoutantligne.cdesc = hfdetail.fddesc
      fcoutantligne.ctype = hfdetail.ftype
      FcoutantLigne.ccouttotal = lCoutantTotalLigne
      fcoutantligne.cNoClient = hfacture.faclient
      fcoutantligne.Cdatecommande = hfacture.fadate
      fcoutantligne.nolot = hfacture.NoLot
      fcoutantligne.CdateLivraison = ldatelivraison
      fcoutantligne.CNoBlivraison = lnobon
      
      hajoute(FcoutantLigne)
      
      
      
     type : 458752
   -
     name : CalculCoutantVerre
     procedure_id : 5073329609712386233
     type_code : 14
     code : |1+
      Procédure CalculCoutantVerre(lcout)
      
      
      hlit(config,1)
      lCoutantTotal est un reel  = 0
      lCoutantTotalLigne est un reel = 0
      lresultat est un reel
      lCoutItem est un reel
      lperte est un reel
      SurfaceReelle est un reel = calculsurfaceAnglaisreelle(hfacture.facalcul)
      i est un entier
      litem est une chaine
      lArgon est un booleen
      
      // fcoutant.ftype 
      //
      // 1 = verre
      // 2 = Spacer
      // 3 = cap
      // 4 = gaz
      // 5 = carrelage
      // 6 = Main d'oeuvre
      // 7 = Frais généraux
      // 8 = Autres frais
      // 9 = Main d'oeuvre Carrelage
      // 10 = Coin
      
      
      
      // fcoutant.soustype
      //
      // 0 = aucun
      // 1 = fourniture relie au carrelage
      SupprimeLigneCoutant(hfacture.fanumero,hfdetail.fdligne)
      assignevariableverre()
      
      
      // Cap
      
      si position(hfdetail.fCAPGAZTUBE,"C") alors
      
      	si hlitrecherche(invent,INUM,config.cProduitAssocieCap) alors
      
      		formule = sansespace(config.CFormulecap)
      		res = compile("formule1","y est un reel"+rc+"y="+formule+rc+"renvoyer y") 
      		si res = "" alors
      			lresultat= ExécuteTraitement("formule1",trtProcédure)
      			selon invent.iUniteMesure 
      				cas 1
      				cas 2
      					lresultat = lresultat / 1000
      				cas 3		
      					lresultat = lresultat / 1000000
      			FIN
      			//info(lresultat * invent.iprixunite)
      			hraz(Fcoutant)
      			fcoutant.cNoCommande = hfacture.fanumero
      			fcoutant.cNoLigne = hfdetail.fdligne
      			fcoutant.cType = 3
      			fcoutant.cSousType = 0
      			fcoutant.cqte = lresultat
      			fcoutant.cCoutUnitaire = invent.icoutUnitem
      			fcoutant.ccouttotal = arrondi(lresultat * invent.icoutUnitem,2) * hfdetail.fdqteafacturer
      			lCoutantTotalLigne+=fcoutant.ccouttotal
      			fcoutant.CFourniture = invent.inum
      			fcoutant.cNoClient = hfacture.faclient
      			fcoutant.Cdatecommande = hfacture.fadate
      			fcoutant.nolot = hfacture.NoLot
      			hajoute(Fcoutant)
      		fin
      
      
      
      	fin
      
      FIN
      
      
      // Gaz
      
      si position(hfdetail.fCAPGAZTUBE,"Z") alors
      	lArgon = vrai
      	si hlitrecherche(invent,INUM,config.cProduitAssociegaz) alors
      
      		formule = sansespace(config.CFormulegaz)
      		res = compile("formule1","y est un reel"+rc+"y="+formule+rc+"renvoyer y") 
      		si res = "" alors
      			lresultat= ExécuteTraitement("formule1",trtProcédure)
      			selon invent.iUniteMesure 
      				cas 1
      				cas 2
      					lresultat = lresultat / 1000
      				cas 3		
      					lresultat = lresultat / 1000000
      			FIN
      
      			//			info(lresultat * invent.iprixunite)
      			hraz(Fcoutant)
      			fcoutant.cNoCommande = hfacture.fanumero
      			fcoutant.cNoLigne = hfdetail.fdligne
      			fcoutant.cType = 4
      			fcoutant.cSousType = 0
      			fcoutant.cqte = lresultat
      			fcoutant.cCoutUnitaire = invent.icoutUnitem
      			fcoutant.ccouttotal = arrondi(lresultat * invent.icoutUnitem,2)* hfdetail.fdqteafacturer
      			lCoutantTotalLigne+=fcoutant.ccouttotal
      			fcoutant.CFourniture = invent.inum
      			fcoutant.cNoClient = hfacture.faclient
      			fcoutant.Cdatecommande = hfacture.fadate
      			fcoutant.nolot = hfacture.NoLot
      			hajoute(Fcoutant)
      		fin
      
      
      	fin
      
      sinon
      	lArgon = faux
      FIN
      
      
      
      // MDO
      
      
      formule = sansespace(config.CMDOformule)
      res = compile("formule1","y est un reel"+rc+"y="+formule+rc+"renvoyer y") 
      si res = "" alors
      	lresultat= ExécuteTraitement("formule1",trtProcédure)
      	selon config.cUniteMDO 
      		cas 1
      		cas 2
      			lresultat = lresultat / 1000
      		cas 3		
      			lresultat = lresultat / 1000000
              cas 4
              
      	FIN
      
      	//	info(lresultat * config.cmdo)
      	hraz(Fcoutant)
      	fcoutant.cNoCommande = hfacture.fanumero
      	fcoutant.cNoLigne = hfdetail.fdligne
      	fcoutant.cType = 6
      	fcoutant.cSousType = 0
      	si config.cunitemdo = 4 alors
      		fcoutant.cqte = config.cmdo
      		fcoutant.cCoutUnitaire = lcout
      		fcoutant.ccouttotal = arrondi(lcout * config.CMDO / 100,2)
      
      	sinon
      		fcoutant.cqte = lresultat
      		fcoutant.cCoutUnitaire = config.cmdo
      		fcoutant.ccouttotal = arrondi(lresultat * config.CMDOm,2)* hfdetail.fdqteafacturer
      
      	FIN
      	fcoutant.cNoClient = hfacture.faclient
      	fcoutant.Cdatecommande = hfacture.fadate
      	lCoutantTotalLigne+=fcoutant.ccouttotal
      	fcoutant.nolot = hfacture.NoLot
      	hajoute(Fcoutant)
      fin
      
      
      // frais generaux
      
      
      formule = sansespace(config.CFraisGenerauxFormule)
      res = compile("formule1","y est un reel"+rc+"y="+formule+rc+"renvoyer y") 
      si res = "" alors
      	lresultat= ExécuteTraitement("formule1",trtProcédure)
      	selon config.cUnitefrg 
      		cas 1
      		cas 2
      			lresultat = lresultat / 1000
      		cas 3		
      			lresultat = lresultat / 1000000
      	FIN
      
      	//	info(lresultat * config.CFraisGeneraux)
      	hraz(Fcoutant)
      	fcoutant.cNoCommande = hfacture.fanumero
      	fcoutant.cNoLigne = hfdetail.fdligne
      	fcoutant.cType = 7
      	fcoutant.cSousType = 0
      	si config.cunitefrg = 4 alors
      		fcoutant.cqte = config.CFraisGeneraux
      		fcoutant.cCoutUnitaire = lcout
      		fcoutant.ccouttotal = arrondi(lcout * config.CFraisGeneraux / 100,2)
      
      	sinon
      		fcoutant.cqte = lresultat
      		fcoutant.cCoutUnitaire = config.CFraisGeneraux
      		fcoutant.ccouttotal = arrondi(lresultat * config.CFraisGenerauxm,2)* hfdetail.fdqteafacturer
      
      	FIN
      //	fcoutant.cqte = lresultat
      //	fcoutant.cCoutUnitaire = config.CFraisGeneraux
      //	fcoutant.ccouttotal = arrondi(lresultat * config.CFraisGeneraux,2)
      	lCoutantTotalLigne+=fcoutant.ccouttotal
      	fcoutant.cNoClient = hfacture.faclient
      	fcoutant.Cdatecommande = hfacture.fadate
      	fcoutant.nolot = hfacture.NoLot
      	hajoute(Fcoutant)
      fin
      
      // Autres
      
      
      formule = sansespace(config.cFournitureAutreFormule)
      
      
      res = compile("formule1","y est un reel"+rc+"y="+formule+rc+"renvoyer y") 
      si res = "" alors
      	lresultat= ExécuteTraitement("formule1",trtProcédure)
      	selon config.cUniteaut
      		cas 1
      		cas 2
      			lresultat = lresultat / 1000
      		cas 3		
      			lresultat = lresultat / 1000000
      	FIN
      
      	//	info(lresultat * config.CFournitureAutre)
      	hraz(Fcoutant)
      	fcoutant.cNoCommande = hfacture.fanumero
      	fcoutant.cNoLigne = hfdetail.fdligne
      	fcoutant.cType = 8
      	fcoutant.cSousType = 0
      	si config.cUniteAut = 4 alors
      		fcoutant.cqte = config.CFournitureAutre
      		fcoutant.cCoutUnitaire = lcout
      		fcoutant.ccouttotal = arrondi(lcout * config.CFournitureAutre / 100,2)
      
      	sinon
      		fcoutant.cqte = lresultat
      		fcoutant.cCoutUnitaire = config.CFournitureAutre
      		fcoutant.ccouttotal = arrondi(lresultat * config.CFournitureAutrem,2)* hfdetail.fdqteafacturer
      
      	FIN
      	
      //	fcoutant.cqte = lresultat
      //	fcoutant.cCoutUnitaire = config.CFournitureAutre
      //	fcoutant.ccouttotal = arrondi(lresultat * config.CFournitureAutre,2)
      	fcoutant.cNoClient = hfacture.faclient
      	fcoutant.Cdatecommande = hfacture.fadate
      	lCoutantTotalLigne+=fcoutant.ccouttotal
      	fcoutant.nolot = hfacture.NoLot
      	hajoute(Fcoutant)
      fin
      si sansespace(hfdetail.fdcomposant1) <> "" alors
      	si hlitrecherche(invent,INUM,hfdetail.fdCOMPOSANT1) alors
      		//		info((surfacereelle * invent.icoutanta)+(surfacereelle * invent.icoutanta * config.cPourcPerteVerre / 100))
      		hraz(Fcoutant)
      		fcoutant.cNoCommande = hfacture.fanumero
      		fcoutant.cNoLigne = hfdetail.fdligne
      		fcoutant.cType = 1
      		fcoutant.cSousType = 0
      		fcoutant.cqte = SurfaceReelle
      		fcoutant.cCoutUnitaire = invent.icoutantm
      		fcoutant.CPourPerte = config.cPourcPerteVerre
      		fcoutant.CPerte = SurfaceReelle * invent.icoutantm * config.cPourcPerteVerre / 100
      		fcoutant.ccouttotal = (arrondi((SurfaceReelle * invent.icoutantm)+(SurfaceReelle * invent.icoutantm * config.cPourcPerteVerre / 100),2))...
      		* hfdetail.fdqteafacturer
      		fcoutant.cNoClient = hfacture.faclient
      		fcoutant.Cdatecommande = hfacture.fadate
      		lCoutantTotalLigne+=fcoutant.ccouttotal
      		fcoutant.CFourniture = invent.inum
      		fcoutant.nolot = hfacture.NoLot
      
      		hajoute(Fcoutant)
      
      
      	FIN
      FIN
      
      si sansespace(hfdetail.fdCOMPOSANT2) <> "" alors
      	si hlitrecherche(invent,INUM,hfdetail.fDCOMPOSANT2) alors
      		//		info((surfacereelle * invent.icoutanta)+(surfacereelle * invent.icoutanta * config.cPourcPerteVerre / 100))
      		hraz(Fcoutant)
      		fcoutant.cNoCommande = hfacture.fanumero
      		fcoutant.cNoLigne = hfdetail.fdligne
      		fcoutant.cType = 1
      		fcoutant.cSousType = 0
      		fcoutant.cqte = SurfaceReelle
      		fcoutant.cCoutUnitaire = invent.icoutantm
      		fcoutant.CPourPerte = config.cPourcPerteVerre
      		fcoutant.CPerte = SurfaceReelle * invent.icoutantm * config.cPourcPerteVerre / 100
      		fcoutant.ccouttotal = (arrondi((SurfaceReelle * invent.icoutantm)+(SurfaceReelle * invent.icoutantm * config.cPourcPerteVerre / 100),2))...
      		* hfdetail.fdqteafacturer
      				lCoutantTotalLigne+=fcoutant.ccouttotal
      		fcoutant.cNoClient = hfacture.faclient
      		fcoutant.CFourniture = invent.inum
      		fcoutant.Cdatecommande = hfacture.fadate
      		fcoutant.nolot = hfacture.NoLot
      		hajoute(Fcoutant)
      	FIN
      FIN
      si sansespace(hfdetail.fDCOMPOSANT3) <> "" alors
      	si hlitrecherche(invent,INUM,hfdetail.fDCOMPOSANT3) alors
      		//	info((surfacereelle * invent.icoutanta)+(surfacereelle * invent.icoutanta * config.cPourcPerteVerre / 100))
      		hraz(Fcoutant)
      		fcoutant.cNoCommande = hfacture.fanumero
      		fcoutant.cNoLigne = hfdetail.fdligne
      		fcoutant.cType = 1
      		fcoutant.cSousType = 0
      		fcoutant.cqte = SurfaceReelle
      		fcoutant.cCoutUnitaire = invent.icoutantm
      		fcoutant.CPourPerte = config.cPourcPerteVerre
      		fcoutant.CPerte = SurfaceReelle * invent.icoutantm * config.cPourcPerteVerre / 100
      		fcoutant.ccouttotal = (arrondi((SurfaceReelle * invent.icoutantm)+(SurfaceReelle * invent.icoutantm * config.cPourcPerteVerre / 100),2))...
      		* hfdetail.fdqteafacturer
      			lCoutantTotalLigne+=fcoutant.ccouttotal
      		fcoutant.cNoClient = hfacture.faclient
      		fcoutant.CFourniture = invent.inum
      		fcoutant.Cdatecommande = hfacture.fadate
      		fcoutant.nolot = hfacture.NoLot
      		hajoute(Fcoutant)
      	FIN
      FIN
      
      
      // Intercallaire
      lCoutItem = 0
      lperte = 0
      litem = ""
      lresultat = 0
      
      //hlitrecherche(TypeSpacDim,CleDimension,hconstruitvalcle(TypeSpacDim,CleDimension,)
      
                                                                         
      si hlitrecherche(typespac,tnumero,hfdetail.ftypespacer) ALORS
      	formule = sansespace(typespac.tcformuleSpacer)
      	si hlitrecherche(TypeSpacDim,CleDimension,HConstruitValClé(TypeSpacDim,CleDimension,typespac.TYCLEUNIK,sansespace(hfdetail.fdespace))) alors
      		si hlitrecherche(invent,INUM,TypeSpacDim.TSProduit) alors
      			lCoutItem = invent.icoutunitem
      			litem = invent.inum
      	fin
      fin	
      
      
      
      res = compile("formule1","y est un reel"+rc+"y="+formule+rc+"renvoyer y") 
      si res = "" alors
      	lresultat= ExécuteTraitement("formule1",trtProcédure)
      	selon invent.iUniteMesure 
      		cas 1
      		cas 2
      			lresultat = lresultat / 1000
      		cas 3		
      			lresultat = lresultat / 1000000
      	FIN
      	//			info(lresultat * lcoutitem)
      	lperte = val(lresultat) * lCoutItem * config.cPourcPerteSpacer / 100
      	hraz(Fcoutant)
      	fcoutant.cNoCommande = hfacture.fanumero
      	fcoutant.cNoLigne = hfdetail.fdligne
      	fcoutant.cType = 2
      	fcoutant.cSousType = 0
      	fcoutant.cqte = lresultat
      	fcoutant.cCoutUnitaire = lCoutItem
      	fcoutant.CPourPerte = config.cPourcPerteSpacer
      	fcoutant.CPerte = lperte
      	fcoutant.ccouttotal = arrondi((lresultat * lCoutItem) + lperte,2)* hfdetail.fdqteafacturer
      	lCoutantTotalLigne+=fcoutant.ccouttotal
      	fcoutant.CFourniture = litem
      	fcoutant.cNoClient = hfacture.faclient
      	fcoutant.Cdatecommande = hfacture.fadate
      	fcoutant.nolot = hfacture.NoLot
      	hajoute(Fcoutant)
      fin
      fin
      
      
      
      // Coin
      lCoutItem = 0
      lperte = 0
      litem = ""
      lresultat = 0
      
      //hlitrecherche(TypeSpacDim,CleDimension,hconstruitvalcle(TypeSpacDim,CleDimension,
      si hlitrecherche(typespac,tnumero,hfdetail.ftypespacer) alors
      	formule = sansespace(typespac.tformulecoin)
      	si hlitrecherche(TypeSpacDim,CleDimension,HConstruitValClé(TypeSpacDim,CleDimension,typespac.TYCLEUNIK,sansespace(hfdetail.fdespace))) alors
      
      		si hlitrecherche(invent,INUM,TypeSpacDim.Tscoin) alors
      			lCoutItem = invent.icoutunitem
      			litem = invent.inum
      	fin
      
      
      fin
      
      
      
      fin	
      res = compile("formule1","y est un reel"+rc+"y="+formule+rc+"renvoyer y") 
      si res = "" alors
      	lresultat= ExécuteTraitement("formule1",trtProcédure)
      	selon invent.iUniteMesure 
      		cas 1
      		cas 2
      			lresultat = lresultat / 1000
      		cas 3		
      			lresultat = lresultat / 1000000
      	FIN
      	//			info(lresultat * lcoutitem)
      	lperte = val(lresultat) * lCoutItem * config.cPourcPerteSpacer / 100
      	hraz(Fcoutant)
      	fcoutant.cNoCommande = hfacture.fanumero
      	fcoutant.cNoLigne = hfdetail.fdligne
      	fcoutant.cType = 10
      	fcoutant.cSousType = 0
      	fcoutant.cqte = lresultat
      	fcoutant.cCoutUnitaire = lCoutItem
      	fcoutant.ccouttotal = arrondi((lresultat * lCoutItem),2)* hfdetail.fdqteafacturer
      	lCoutantTotalLigne+=fcoutant.ccouttotal
      	fcoutant.CFourniture = litem
      	fcoutant.cNoClient = hfacture.faclient
      	fcoutant.Cdatecommande = hfacture.fadate
      	fcoutant.nolot = hfacture.NoLot
      	hajoute(Fcoutant)
      fin
      
               
      // Coin Argon
      lCoutItem = 0
      lperte = 0
      litem = ""
      lresultat = 0
      
      //hlitrecherche(TypeSpacDim,CleDimension,hconstruitvalcle(TypeSpacDim,CleDimension,
      si hlitrecherche(typespac,tnumero,hfdetail.ftypespacer) alors
      	formule = sansespace(typespac.Tfornulecoinargon)
      	si hlitrecherche(TypeSpacDim,CleDimension,HConstruitValClé(TypeSpacDim,CleDimension,typespac.TYCLEUNIK,sansespace(hfdetail.fDESPACE))) alors
      
      		si hlitrecherche(invent,INUM,TypeSpacDim.TscoinArgon) alors
      			lCoutItem = invent.icoutunitem
      			litem = invent.inum
      	fin
      
      
      fin
      
      
      
      fin	
      res = compile("formule1","y est un reel"+rc+"y="+formule+rc+"renvoyer y") 
      si res = "" alors
      	lresultat= ExécuteTraitement("formule1",trtProcédure)
      	selon invent.iUniteMesure 
      		cas 1
      		cas 2
      			lresultat = lresultat / 1000
      		cas 3		
      			lresultat = lresultat / 1000000
      	FIN
      	//			info(lresultat * lcoutitem)
      	hraz(Fcoutant)
      	fcoutant.cNoCommande = hfacture.fanumero
      	fcoutant.cNoLigne = hfdetail.fdligne
      	fcoutant.cType = 10
      	fcoutant.cSousType = 0
      	fcoutant.cqte = lresultat
      	fcoutant.cCoutUnitaire = lCoutItem
      	fcoutant.ccouttotal = arrondi((lresultat * lCoutItem),2)* hfdetail.fdqteafacturer
      	lCoutantTotalLigne+=fcoutant.ccouttotal
      	fcoutant.CFourniture = litem
      	fcoutant.cNoClient = hfacture.faclient
      	fcoutant.Cdatecommande = hfacture.fadate
      	fcoutant.nolot = hfacture.NoLot
      	hajoute(Fcoutant)
      fin
      
      
      
      // moleculaire
      lCoutItem = 0
      lperte = 0
      litem = ""
      lresultat = 0
      
      //hlitrecherche(TypeSpacDim,CleDimension,hconstruitvalcle(TypeSpacDim,CleDimension,
      si hlitrecherche(typespac,tnumero,hfdetail.ftypespacer) alors
      	formule = sansespace(typespac.tformulemoleculaire)
      	si hlitrecherche(TypeSpacDim,CleDimension,HConstruitValClé(TypeSpacDim,CleDimension,typespac.TYCLEUNIK,sansespace(hfdetail.fdespace))) alors
      
      		si hlitrecherche(invent,INUM,TypeSpacDim.TsMoleculaire) alors
      			lCoutItem = invent.icoutunitem
      			litem = invent.inum
      	fin
      
      
      fin
      
      
      
      fin	
      res = compile("formule1","y est un reel"+rc+"y="+formule+rc+"renvoyer y") 
      si res = "" alors
      	lresultat= ExécuteTraitement("formule1",trtProcédure)
      	selon invent.iUniteMesure 
      		cas 1
      		cas 2
      			lresultat = lresultat / 1000
      		cas 3		
      			lresultat = lresultat / 1000000
      	FIN
      	//			info(lresultat * lcoutitem)
      	lperte = val(lresultat) * lCoutItem * config.cPourcPerteSpacer / 100
      	hraz(Fcoutant)
      	fcoutant.cNoCommande = hfacture.fanumero
      	fcoutant.cNoLigne = hfdetail.fdligne
      	fcoutant.cType = 11
      	fcoutant.cSousType = 0
      	fcoutant.cqte = lresultat
      	fcoutant.cCoutUnitaire = lCoutItem
      	fcoutant.ccouttotal = arrondi((lresultat * lCoutItem),2)* hfdetail.fdqteafacturer
      	lCoutantTotalLigne+=fcoutant.ccouttotal
      	fcoutant.CFourniture = litem
      	fcoutant.cNoClient = hfacture.faclient
      	fcoutant.Cdatecommande = hfacture.fadate
      	fcoutant.nolot = hfacture.NoLot
      	hajoute(Fcoutant)
      fin
      
      
      // Colle
      lCoutItem = 0
      lperte = 0
      litem = ""
      lresultat = 0
      
      //hlitrecherche(TypeSpacDim,CleDimension,hconstruitvalcle(TypeSpacDim,CleDimension,
      si hlitrecherche(typespac,tnumero,hfdetail.ftypespacer) alors
      	formule = sansespace(typespac.tformulecolle)
      	si hlitrecherche(TypeSpacDim,CleDimension,HConstruitValClé(TypeSpacDim,CleDimension,typespac.TYCLEUNIK,sansespace(hfdetail.fdespace))) alors
      
      		si hlitrecherche(invent,INUM,TypeSpacDim.Tscolle) alors
      			lCoutItem = invent.icoutunitem
      			litem = invent.inum
      	fin
      
      
      fin
      
      
      
      fin	
      res = compile("formule1","y est un reel"+rc+"y="+formule+rc+"renvoyer y") 
      si res = "" alors
      	lresultat= ExécuteTraitement("formule1",trtProcédure)
      	selon invent.iUniteMesure 
      		cas 1
      		cas 2
      			lresultat = lresultat / 1000
      		cas 3		
      			lresultat = lresultat / 1000000
      	FIN
      	//			info(lresultat * lcoutitem)
      	lperte = val(lresultat) * lCoutItem * config.cPourcPerteSpacer / 100
      	hraz(Fcoutant)
      	fcoutant.cNoCommande = hfacture.fanumero
      	fcoutant.cNoLigne = hfdetail.fdligne
      	fcoutant.cType = 11
      	fcoutant.cSousType = 0
      	fcoutant.cqte = lresultat
      	fcoutant.cCoutUnitaire = lCoutItem
      	fcoutant.ccouttotal = arrondi((lresultat * lCoutItem),2)* hfdetail.fdqteafacturer
      	lCoutantTotalLigne+=fcoutant.ccouttotal
      	fcoutant.CFourniture = litem
      	fcoutant.cNoClient = hfacture.faclient
      	fcoutant.Cdatecommande = hfacture.fadate
      	fcoutant.nolot = hfacture.NoLot
      	hajoute(Fcoutant)
      fin
      
      
      
      FcoutantLigne.cNoCommande = hfacture.fanumero
      FcoutantLigne.cNoLigne = hfdetail.fdligne
      fcoutantligne.cdesc = hfdetail.fddesc
      fcoutantligne.ctype = hfdetail.ftype
      FcoutantLigne.ccouttotal = lCoutantTotalLigne
      FcoutantLigne.cNoClient = hfacture.faclient
      fcoutantligne.Cdatecommande = hfacture.fadate
      fcoutantligne.nolot = hfacture.NoLot
      fcoutantligne.CdateLivraison = ldatelivraison
      fcoutantligne.cDAteFacture = ldatefacture
      fcoutantligne.CNoBlivraison = lnobon
      hajoute(FcoutantLigne)
      
      
      
      
      
      
