     type : 458752
   -
     name : AssigneVariableVerre
     procedure_id : 5073329715389473293
     type_code : 14
     code : |1+
      Procédure AssigneVariableVerre()
      i est un entier
      selon hfacture.facalcul
      	cas 1	
      		H1 = val(hfdetail.fDHAUTEUR) * 25.4 
      		L1 = val(hfdetail.fdlargeur) * 25.4 
      	cas 2
      		H1 = val(hfdetail.fDHAUTEURa) 
      		L1 = val(hfdetail.fdlargeura)
      FIN
      
      
      
      //NBL = commande.CDCARREAUV
      //NBH = commande.CDCARREAUH
      //si commande.CDCARRELAGE alors
      //	si hlitrecherche(typecarr,tcdescription,commande.typecalcul..ValeurAffichée) alors
      //		C = typecarr.EpaisseurCadre
      //		ETL = typecarr.EpaisseurTigeLargeur
      //		eth = typecarr.EpaisseurTigeHauteur
      //		vx = typecarr.VariableUtil
      //		vx1 = typecarr.VariableUtil1
      //		pour i = 1 a 20
      //
      //			{"k"+i} = typecarr.TConstantes[1]
      //		FIN
      //	sinon
      //		C = 0
      //		ETL = 0
      //		eth = 0
      //		vx = 0
      //		vx1 = 0
      //fin
      //DDV = commande.fdDDV
      //DDH = commande.fdddh
      //
      //sinon
      //	C = 0
      //	ETL = 0
      //	eth = 0
      //	vx = 0
      //	vx1 = 0
      //	DDV = 0
      //	DDH = 0
      //fin
      
      si sansespace(hfdetail.fDCOMPOSANT3) <> "" alors
      	TDT = 2
      sinon
      	tdt = 1
      FIN
      
      si position(hfdetail.fcapgaztube,"Z") <> 0  alors    
      	Z = 1
      sinon
      	Z = 0
      fin
      
      
      
     type : 458752
   -
     name : AssigneVariableCarrelage
     procedure_id : 5073329831851494726
     type_code : 14
     code : |1+
      Procédure AssigneVariableCarrelage()
      i est un entier
      selon hfacture.facalcul
      	cas 1	
      		H1 = val(hfdetail.fDHAUTEUR) * 25.4 
      		L1 = val(hfdetail.fdlargeur) * 25.4 
      	cas 2
      		H1 = val(hfdetail.fDHAUTEURa) 
      		L1 = val(hfdetail.fdlargeura)
      FIN
      
      
      
      NBL = hfdetail.fDCARREAUV
      NBH = hfdetail.fDCARREAUH
      	si hlitrecherche(typecarr,tcdescription,hfdetail.fdtypecalcul) alors
      		C = typecarr.EpaisseurCadre
      		ETL = typecarr.EpaisseurTigeLargeur
      		eth = typecarr.EpaisseurTigeHauteur
      		vx = typecarr.VariableUtil
      		vx1 = typecarr.VariableUtil1
      //		pour i = 1 a 20
      //
      //			{"k"+i} = typecarr.TConstantes[1]
      //		FIN
      	sinon
      		C = 0
      		ETL = 0
      		eth = 0
      		vx = 0
      		vx1 = 0
      fin
      DDV = hfdetail.fdddV
      DDH = hfdetail.fdddh
      dth = hfdetail.fdt
      si sansespace(hfdetail.fDCOMPOSANT3) <> "" alors
      	TDT = 2
      sinon
      	tdt = 1
      FIN
      
      
      
      
      
      
     type : 458752
   -
     name : SupprimeLigneCoutant
     procedure_id : 5073329880240994733
     type_code : 14
     code : |1+
      Procédure SupprimeLigneCoutant(lnocommande,lnoligne)
      
      pour tout fcoutant avec "cNoCommande = "+lnocommande+" et cnoligne =" + lnoligne
      	hsupprime(fcoutant,hNumEnrEnCours)
      FIN
      pour tout fcoutantligne avec "cNoCommande = "+lnocommande+" et cnoligne =" + lnoligne
      	hsupprime(fcoutantligne,hNumEnrEnCours)
      FIN
      
     type : 458752
   -
     name : valideformule
     procedure_id : 5073330700104475353
     type_code : 14
     code : |1+
      Procédure valideformule(Formulaverifier)
      xposition est un entier = 0  // position du caractere /
      xposition1 est un entier = 1 // position du caractere )
      souschaine est une chaine
      i est un entier = 1
      formule1 est une chaine
      res est une chaine
      boucle
      	xposition = position(Formulaverifier,"/",xposition+1)
      	si xposition = 0 alors
      		sortir
      	FIN
      	xposition1 = position(Formulaverifier,")",xposition)
          si xposition1 = 0 alors
             xposition1 = taille(Formulaverifier)
          fin
          	
      	souschaine = milieu(Formulaverifier,xposition+1,xposition1-xposition)
      	souschaine = remplace(souschaine,"(","")
      	souschaine = remplace(souschaine,")","")
      	formule1 = "y est un reel"+RC+"y="+souschaine+RC+"renvoyer y "
      	res = compile("formule2",formule1)
      	si ExécuteTraitement("formule2",trtProcédure) = 0 alors
      		renvoyer faux
      	FIN
      FIN
      
      renvoyer vrai
      
      
      
     type : 458752
   -
     name : calculsurfaceAnglaisreelle
     procedure_id : 5073332957941115600
     type_code : 14
     code : |1+
      Procédure calculsurfaceAnglaisreelle(lunitedemesure)
      surface_entier_largeur est un reel
      surface_fraction_largeur est un reel
      surface_entier_hauteur est un reel
      surface_fraction_hauteur est un reel
      largeur_calcul est un reel
      hauteur_calcul est un reel
      surfaceanglaise est un reel
      surfacemetrique est un reel
      
      
      
      selon lunitedemesure
      
      cas 1 
      
      surface_entier_largeur = partieentiere(val(hfdetail.fdlargeur))
      surface_fraction_largeur = partiedecimale(val(hfdetail.fdlargeur))
      surface_entier_hauteur = partieentiere(val(hfdetail.fdhauteur))
      surface_fraction_hauteur = partiedecimale(val(hfdetail.fdhauteur))
      
      largeur_calcul = val(hfdetail.fdlargeur)
      
      hauteur_calcul = val(hfdetail.fdhauteur) 
      
      surfaceanglaise = arrondi(hauteur_calcul * largeur_calcul / 144,2)
      surfacemetrique = arrondi(calcul_surface_metrique(largeur_calcul*25.4/1000,hauteur_calcul*25.4/1000,vrai),4)
      
      renvoyer surfacemetrique
      
      
      cas 2
      	largeur_calcul = val(hfdetail.fdlargeura)
      
      	hauteur_calcul = val(hfdetail.fdhauteura) 
      	
      
      
      //surfaceanglaise = 0
      surfaceanglaise = arrondi(calcul_surface_anglais(val(hfdetail.fDLARGEURa)/ 25.4,val(hfdetail.fDhauteura)/ 25.4,vrai),3)
      surfacemetrique = arrondi(hauteur_calcul * largeur_calcul/1000000,4)
      
      renvoyer surfacemetrique
      
      
      fin	
      
      
      
     type : 458752
   -
     name : calcul_surface_anglais
     procedure_id : 5073333246109920821
     type_code : 14
     code : |1+
      Procédure calcul_surface_anglais(largeur,hauteur,reelle=faux)
      surface_entier_largeur est un reel
      surface_fraction_largeur est un reel
      surface_entier_hauteur est un reel
      surface_fraction_hauteur est un reel
      largeur_calcul est un reel
      hauteur_calcul est un reel
      si pas reelle alors
      	surface_entier_largeur = partieentiere(val(largeur))
      	//surface_fraction_largeur = partiedecimale(val(largeur))
      	//	surface_fraction_largeur = partiedecimale(val(largeur))-(config.Tolerancemilli/1000)
      		surface_fraction_largeur = partiedecimale(val(largeur))-(client.Tolerancei/1000)
      	surface_entier_hauteur = partieentiere(val(hauteur))
      	//surface_fraction_hauteur = partiedecimale(val(hauteur))
      	//	surface_fraction_hauteur = partiedecimale(val(hauteur))-(config.Tolerancemilli/1000)
      		surface_fraction_hauteur = partiedecimale(val(hauteur))-(client.Tolerancei/1000)
      
      	si surface_fraction_hauteur < 0 alors
      		surface_fraction_hauteur = 0
      	FIN
      	si surface_fraction_largeur < 0 alors
      		surface_fraction_largeur = 0
      	FIN
      
      	si modulo(surface_entier_largeur,2) = 0 alors
      		si pas surface_fraction_largeur = 0  alors
      			largeur_calcul = surface_entier_largeur + 2
      		sinon
      			largeur_calcul = surface_entier_largeur 
      		fin	
      	sinon
      		largeur_calcul = surface_entier_largeur + 1
      	fin	
      
      	si modulo(surface_entier_hauteur,2) = 0 alors
      		si pas surface_fraction_hauteur = 0  alors
      			hauteur_calcul = surface_entier_hauteur + 2
      		sinon
      			hauteur_calcul = surface_entier_hauteur 
      		fin	
      	sinon
      		hauteur_calcul = surface_entier_hauteur + 1
      	fin	
      sinon
      	hauteur_calcul = hauteur
      	largeur_calcul = largeur
      fin
      
      
      renvoyer hauteur_calcul * largeur_calcul / 144
      
      
      
     type : 458752
   -
     name : calcul_surface_metrique
     procedure_id : 5073333362342762803
     type_code : 14
     code : |1+
      Procédure calcul_surface_metrique(largeur,hauteur,reelle=faux)
      surface_entier_largeur est un reel
      surface_fraction_largeur est un reel
      surface_entier_hauteur est un reel
      surface_fraction_hauteur est un reel
      largeur_calcul est un reel
      hauteur_calcul est un reel
      
      
      
      //largeur_calcul = val(commande.cdlargeur) * 1000
      si pas reelle alors
      	largeur_calcul = largeur * 1000
      	hauteur_calcul = hauteur * 1000
      	
      	si pas modulo(largeur_calcul,20) = 0 alors
      
      		largeur_calcul = arrondi(largeur_calcul + (20 - modulo(largeur_calcul,20)),0)
      
      	fin
      
      	largeur_calcul = largeur_calcul / 1000
      
      	si pas modulo(hauteur_calcul,20) = 0 alors
      
      		hauteur_calcul = arrondi(hauteur_calcul + (20 - modulo(hauteur_calcul,20)),0)
      
      	fin
      	hauteur_calcul = hauteur_calcul / 1000
      
      sinon
      	largeur_calcul = largeur
      	hauteur_calcul = hauteur 
      
      fin
      
      
      renvoyer hauteur_calcul * largeur_calcul
      
      
      
     type : 458752
