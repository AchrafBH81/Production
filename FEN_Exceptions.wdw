     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         
         
         
        type : 14
      -
        code : |1+
         sTxtSql est une chaine = [
         	select Bonlivraison.bnumero as noBon,hfacture.fanumero As NoCommande,hfacture.faclient as noclient ,
         	hfacture.nom as nomclient,fdnumprod as NoProduit,hfdetail.fdlargeura as largeur,hfdetail.fdhauteura as hauteur,hfdetail.fdforme as NoForme,
         	 camions.description as NoCamion,Forme.fdescription as sFormedescription,
         	hfdetail.fdqte as nqte,hfdetail.fddesc as sDescriptionThermos,
         	hfacture.facalcul as CalculType
         	  from BonLivraison 
         	inner join hfacture on hfacture.fanofacture = bonlivraison.bnumero
         	inner join hfdetail on hfacture.HFCLEUNIK = hfdetail.HFCLEUNIK
         	inner join facture on facture.fanumero = hfacture.fanumero
         	left outer join forme on forme.fnumero = hfdetail.fdforme
         	LEFT OUTER JOIN
         	Camions
         	ON hfacture.IDCamions = Camions.IDCamions
         	where facture.fdaterequise = {pdate} and BonLivraison.bfacture = 0 and hfdetail.ExceptionForShippingBill = 1
         	order by camions.Abreviation
         ]
         sdReqsql est une source de donnees
         sdReqsql.pdate = csddatedebut
         si HExécuteRequêteSQL(sdReqsql,hRequêteDéfaut,sTxtSql) alors
         	FichierVersMémoire(tabShippingExceptions,sdReqsql)
         	
         	iConfigure(imprimanterapport,Vrai)
         	iParamètre("DEFAUT=NON")
         //	iParamètre("ORIENTATION=PORTRAIT")
         	iParamètre("QUALITE=HAUTE")
         	
         	SELON SélecteurDestination
         		// Écran
         		CAS 1
         			iAperçu(100)
         			
         		// Imprimante
         		CAS 2
         			
         	FIN
         	
         	iImprimeEtat(ETAT_ShippingExceptions,tabShippingExceptions)
         FIN
         
         
        type : 18
      -
        type : 161
        enabled : false
