   -
     name : BtnClicDroite
     procedure_id : 5055525032474223648
     type_code : 14
     code : |1+
      Procédure BtnClicDroite()
      AncienneValeur est une chaine = moimeme
      numerocomposante est une chaine
      si Minuscule(gauche(moimeme..nom,9)) = "tcformule" alors
      	si pas moimeme..etat <> actif  alors
      		moimeme = AncienneValeur + ouvre(FenetreAbrev)
      
      		moimeme..curseur = taille(moimeme + 1)
      		reprisesaisie(moimeme)
      	fin
      FIN
      
      
      
      
     type : 458752
   -
     name : CreePolice
     procedure_id : 5225486711540159977
     type_code : 14
     code : |1+
      Procédure CreePolice(lintgras=faux,lintitalique=faux,ltype = "MS Sans Serif",lpitch=10)
      
      lattribut est un entier
      si lintgras alors
      	lattribut +=igras
      FIN
      si lintitalique alors
      	lattribut +=iItalique
      FIN
      
      policetexte = policecree(ltype,lpitch,lattribut)
     type : 458752
