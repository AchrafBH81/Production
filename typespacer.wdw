     type_code : 4
     p_codes :
      -
        code : |1+
         EcranVersFichier(typespacer,typespac)
         i est un entier
         si lajout alors
         	hajoute(typespac)
         sinon
         	hmodifie(typespac,hNumEnrEnCours)	
         FIN
         pour i = 1 a TableOccurrence(Table_TypeSpacDim)
         	Table_TypeSpacDim.TYCLEUNIK[i] = typespac.TYCLEUNIK
