    properties :
     y : 33.019
     width : 213.9
     height : 47.62
    code_elements :
     type_code : 30
     p_codes :
      -
        code : |1+
         nCpt est un entier
         si sansespace(lib_w) <> "" alors
         	LIB_Largeur..visible = vrai
         	LIB_Largeur..y = 10 + (nCpt*5)
         	lib_w..y = 10 + (nCpt*5)
         	ncpt++
         sinon
         	LIB_Largeur..Visible = faux
         	
         FIN
         si sansespace(lib_w1) <> "" alors
         	LIB_Largeur1..visible = vrai
         	LIB_Largeur1..y = 10 + (nCpt*5)
         	lib_w1..y = 10 + (nCpt*5)
         	ncpt++
         sinon
         	LIB_Largeur1..Visible = faux
         	
         FIN
         si sansespace(lib_w2) <> "" alors
         	LIB_Largeur2..visible = vrai
         	LIB_Largeur2..y = 10 + (nCpt*5)
         	lib_w2..y = 10 + (nCpt*5)
         	ncpt++
         sinon
         	LIB_Largeur2..Visible = faux
         	
         FIN
         
         si sansespace(lib_h) <> "" alors
             lib_hauteur..visible = vrai
             LIB_Hauteur..y = 10 + (nCpt*5)
             LIB_H..y = 10 + (nCpt*5)
         	ncpt++
         sinon
         	lib_hauteur..visible = faux
         FIN
         si sansespace(lib_h1) <> "" alors
             lib_hauteur1..visible = vrai
             LIB_Hauteur1..y = 10 + (nCpt*5)
             LIB_H1..y = 10 + (nCpt*5)
         	ncpt++
         sinon
         	lib_hauteur1..visible = faux
         FIN
         si sansespace(lib_h2) <> "" alors
             lib_hauteur2..visible = vrai
             LIB_Hauteur2..y = 10 + (nCpt*5)
             LIB_H2..y = 10 + (nCpt*5)
         	ncpt++
         sinon
         	lib_hauteur2..visible = faux
         FIN
         
         SI SansEspace(LIB_D) <> "" ALORS
         	LIB_Diametre..Visible	= Vrai
         	LIB_Diametre..Y			= 10 + (nCpt*5)
         	LIB_d..Y				= 10 + (nCpt*5)
         	nCpt++
         SINON
         	LIB_Diametre..Visible = Faux
         FIN
         SI SansEspace(LIB_R) <> "" ALORS
         	LIB_Rayon..Visible	= Vrai
         	LIB_Rayon..Y			= 10 + (nCpt*5)
         	LIB_r..Y				= 10 + (nCpt*5)
         	nCpt++
         SINON
         	LIB_Rayon..Visible = Faux
         FIN
         SI SansEspace(LIB_R1) <> "" ALORS
         	LIB_Rayon1..Visible	= Vrai
         	LIB_Rayon1..Y			= 10 + (nCpt*5)
         	LIB_r1..Y				= 10 + (nCpt*5)
         	nCpt++
         SINON
         	LIB_Rayon1..Visible = Faux
         FIN
         SI SansEspace(LIB_R2) <> "" ALORS
         	LIB_Rayon2..Visible	= Vrai
         	LIB_Rayon2..Y			= 10 + (nCpt*5)
         	LIB_r2..Y				= 10 + (nCpt*5)
         	nCpt++
         SINON
         	LIB_Rayon2..Visible = Faux
         FIN
         
         
         
        type : 327692
