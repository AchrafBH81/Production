  -
    name : BTN_Annule1
    identifier : 0x415ae6864f48ae50
    internal_properties : 
    properties :
     x : 88
     y : 10
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         si acso_message("Question","Voulez-vous enlever la commande # " +requeteBlFacture.fanumero +" du bon de livraison # " + numerodebon ,"OuiNon") = idyes alors
            
            si hlitrecherche(Facture,fanumero,RequeteBlFacture.fanumero) alors
         		facture.FPREPARATION = "F"
         		hmodifie(facture)
         	fin
         
            hlitrecherche(hfdetail,HFCLEUNIK,RequeteBlFacture.HFCLEUNIK)
            tantque hfdetail.HFCLEUNIK = RequeteBlFacture.HFCLEUNIK et pas hendehors(hfdetail)
         	si hlitrecherche(fdetail,fdnocommfdligne,HConstruitValClé(fdetail,fdnocommfdligne,hfdetail.fdnocomm,hfdetail.fdligne)) alors
         		fdetail.fdqtedejafacture-=hfdetail.fdqteafacturer
         		fdetail.fdqteafacturer = fdetail.fdqte-fdetail.fdqtedejafacture
         		fdetail.SUrchargedejafacture-=hfdetail.SUrchargeafacturer
         		fdetail.SUrchargeafacturer = fdetail.surchargeenergie - fdetail.SUrchargedejafacture
         		HModifie(fdetail,hNumEnrEnCours)
         	fin
         
            	 hsupprime(hfdetail)
            	 hlitsuivant(hfdetail,HFCLEUNIK)
            FIN
            si hlitrecherche(hfacture,HFCLEUNIK,requeteBlFacture.HFCLEUNIK) alors
               hsupprime(hfacture,hNumEnrEnCours)
             fin	
         	
         FIN
         
         //acso_message("Message","La commande # " +requeteBlFacture.fanumero +" à été supprimée du bon de livraison # " + numerodebon,"Info")
         hexecuterequete(RequeteBlFacture,hRequêteDéfaut,numerodebon)
         si hnbenr(RequeteBlFacture) = 0 alors
         	si hlitrecherche(BonLivraison,Bnumero,numerodebon) alors
         		hsupprime(BonLivraison)
         	FIN
         ferme()
         FIN
         tableaffiche(Table_BlFacture)
         si acso_message("Question","Des modifications ont été apportées au bon de livraison # "+numerodebon+rc+"Voulez-vous le réimprimer","OuiNon") = idyes alors
         	hexecuterequete(RequeteBlEtat,hRequêteDéfaut,numerodebon)
         	iParamètre("DEFAUT=NON")
         	iParamètre("QUALITE=HAUTE")
         	iParamètre("COPIES="+CONFIG.nbcopieBlivraison)
         	iimprimeetat(bonlivraison)
         
         FIN
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_IMPRIME
    identifier : 0x415b00bb666a0ebd
    internal_properties : 
    properties :
     x : 205
     y : 10
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         hexecuterequete(RequeteBlEtat,hRequêteDéfaut,numerodebon)
         iconfigure(sansespace(imprimantefacture),vrai)
         iParamètre("DEFAUT=NON")
         iParamètre("QUALITE=HAUTE")
         iParamètre("COPIES="+CONFIG.nbcopieBlivraison)
         selon gFormatFacture
         	cas 1
         		iimprimeetat(bonlivraison)
         	cas 2
         		iimprimeetat(bonlivraisontrn)
         
         FIN
         
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_ecran
    identifier : 0x466ffa062c94190a
    internal_properties : 
    properties :
     x : 260
     y : 10
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         hexecuterequete(ReqGroupShippingBill,hRequêteDéfaut,numerodebon)
         iconfigure(sansespace(imprimantebon),vrai)
         iParamètre("DEFAUT=NON")
         iParamètre("QUALITE=HAUTE")
         iParamètre("COPIES="+CONFIG.nbcopieBlivraison)
         iAperçu(i100, "Aperçu écran")
         
         	iimprimeetat(EGroupShippingBill)
         
        type : 18
      -
        type : 161
        enabled : false
