  -
    name : BTN_Annule
    identifier : 0x415abd881fb58cae
    internal_properties : 
    properties :
     x : 136
     y : 10
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         si acso_message("Question","Voulez-vous supprimer entièrement le bon de commande numéro "+ numerodebon ,"OuiNon") = idyes alors
         
         	hlitpremier(RequeteBlFacture,RequeteBlFacture.fanumero)
         	tantque pas hendehors(RequeteBlFacture)
         		si hlitrecherche(Facture,fanumero,RequeteBlFacture.fanumero) alors
         			facture.FPREPARATION = "F"
         			hmodifie(facture)
         	        pour tout hfdetail avec "HFCLEUNIK= "+RequeteBlFacture.HFCLEUNIK
         	            si hlitrecherche(fdetail,fdnocommfdligne,HConstruitValClé(fdetail,fdnocommfdligne,hfdetail.fdnocomm,hfdetail.fdligne)) alors
         	              fdetail.fdqtedejafacture-=hfdetail.fdqteafacturer
         	              fdetail.fdqteafacturer = fdetail.fdqte-fdetail.fdqtedejafacture
                           fdetail.SUrchargedejafacture-=hfdetail.SUrchargeafacturer
                           fdetail.SUrchargeafacturer = fdetail.surchargeenergie - fdetail.SUrchargedejafacture
         
                           HModifie(fdetail,hNumEnrEnCours)
         	            fin
         	            	
         	        
         	        fin
         	        	
         		fin
              
         		hlitsuivant(RequeteBlFacture,RequeteBlFacture.fanumero)
         	fin
         
         	si hlitrecherche(BonLivraison,Bnumero,numerodebon) alors
         		hsupprime(BonLivraison)
         	FIN
         	si HLitRecherche(BonLivraison,BnoCommande,RequeteBlFacture.fanumero) ALORS
         		facture.livrepartiel = "P"
         		hmodifie(facture)
         	sinon
         		facture.livrepartiel = " "
         		hmodifie(facture)
         
         	FIN
         	acso_message("Message","Le bon de livraison # "+numerodebon+" à été complétement supprimé","Info")
         FIN
         
         ferme(fModifBL)
         
         
        type : 18
      -
        type : 161
        enabled : false
  -
    name : lNumeroBon
    identifier : 0x415abf2d4b5dfa7c
    internal_properties : 
