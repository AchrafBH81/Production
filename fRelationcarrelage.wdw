  -
    name : Bouton1
    identifier : 0x278447b0acb4797d
    internal_properties : 
    properties :
     x : 36
     y : 29
     width : 139
     height : 38
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         HSurErreur(RelationEDI,hErrDoublon,"")
         
         pour i = 1 _a_ TableOccurrence(Table__tabrelationcarrelage)
         	hraz(RelationEDI)
         	relationedi.TYpeObjet = 4  // Carrelage
         	RelationEDI.IdClient = idclientcourant
         	
         	relationedi.descriptionEDIClient = Table__tabrelationcarrelage.Description[i]
         	relationedi.IDCarrelage = sansespace(Table__tabrelationcarrelage.IDCarrelage[i])
         	hajoute(relationedi)
         	si HErreurDoublon() alors
         		
         	FIN
         FIN
         MaFenêtre..ValeurRenvoyée = Vrai
         
         ferme(mafenetre)
        type : 18
      -
        type : 161
        enabled : false
  -
    name : Bouton2
    identifier : 0x27900ff24aa310e9
    internal_properties : 
    properties :
     x : 909
     y : 118
     width : 71
     height : 65
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         valeurretournee est une chaine = Ouvre("Recherche de produit","","carrelage")
         
         si valeurretournee <> "" alors
         //	Table__tabrelationCarrelage.Colonne1 = invent.idesc
         	Table__tabrelationCarrelage.IDCarrelage = ExtraitChaîne(valeurretournee,1,";")
         	si hlitrecherche(invent,inum,Table__tabrelationCarrelage.IDCarrelage) alors
         		Table__tabrelationCarrelage.Colonne1 = invent.IDESC
         		
         	FIN
         FIN
        type : 18
      -
        type : 161
        enabled : false
  -
    name : Bouton3
    identifier : 0x27901037601c1eee
    internal_properties : 
    properties :
