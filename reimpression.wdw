      Procédure RemplirTableBonLivraison()
      
      hlitpremier(RequeteBonLivraison)
      tantque pas HEnDehors(RequeteBonLivraison)
      	tableajouteligne(Table_Facture,RequeteBonLivraison.Btransfere,...
      	RequeteBonLivraison.bnumero,...
      	RequeteBonLivraison.bdate,...
      	RequeteBonLivraison.bfacture,...
      	RequeteBonLivraison.bnocommande,...
      	RequeteBonLivraison.BCommandeClient,...
      	RequeteBonLivraison.BDateFacture,...
      	RequeteBonLivraison.bclient,...
      	RequeteBonLivraison.brien,...
      	RequeteBonLivraison.berreur,...
      	RequeteBonLivraison.brien)
      	hlitsuivant(RequeteBonLivraison)
      FIN
      
      TableAffiche(Table_Facture,taDébut)
      //tabletrie(Table_Facture,"-ffacture")
      tableselectplus(Table_Facture,1)
      reprisesaisie(Table_Facture)
     type : 458752
   -
     name : ValideClientUnique
     procedure_id : 5247734941223709316
     type_code : 14
     code : |1+
      Procédure ValideClientUnique()
      i est un entier
      j est un entier
      lnumeroclient est une chaine
      
      si TableSelectOccurrence(Table_Facture) > 1 alors
      	BTN_IMPRIME1..etat = grise
      	pour j = 1 a TableSelectOccurrence(Table_Facture)
      		si Table_Facture.#client[TABLESELECT(Table_Facture,j)] <> lnumeroclient et pas lnumeroclient = "" alors
      			BtnCourriel..etat = grise
      			renvoyer vrai
      		sinon
      			lnumeroclient = Table_Facture.#client[TABLESELECT(Table_Facture,j)]	
      		fin
      	FIN
      
      //	si gImprimantePdfStatus alors
      
      		BtnCourriel..etat = actif
      //	sinon
      //		BtnCourriel..etat = grise
      //	fin
      
      sinon
      	BTN_IMPRIME1..etat = actif
      //	si gImprimantePdfStatus alors
      		BtnCourriel..etat = actif
      //	sinon
      //		BtnCourriel..etat = grise
      //	fin
      	lnumeroclient = Table_Facture.#client[Table_Facture]	
      FIN
      
      si HLitRecherche(client,numero,lnumeroclient) alors
      
      //	si gImprimantePdfStatus alors
      
      		selon reimpression.selecteurdoc
      			cas 1
      				si sansespace(client.ccourrielFacture[1]) = "" et sansespace(client.ccourrielFacture[2]) = "" et sansespace(client.ccourrielFacture[3]) = "" ...
      					et sansespace(client.ccourrielFacture[4]) = "" alors
      					BtnCourriel..etat = grise
      				FIN
      			cas 2
      				si sansespace(client.ccourrielBonLivraison[1]) = "" et sansespace(client.ccourrielBonLivraison[2]) = "" et sansespace(client.ccourrielBonLivraison[2]) = "" ...
      					et sansespace(client.ccourrielBonLivraison[4]) = "" alors
      					BtnCourriel..etat = grise
      				FIN
      
      		fin
      	fin
      //sinon
      //	BtnCourriel..etat = grise
      //fin
     type : 458752
