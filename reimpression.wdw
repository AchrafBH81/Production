        code : |1-
         libérer fac_detail
         i					est un entier
         j					est un entier
         SousTotal			est un reel
         TotalTaxetps		est un reel
         TotalTaxetvq		est un reel
         TotalSurchargeTaux	est un reel
         multiplicateur		est un entier
         TotalSurcharge		est un reel
         ltauxtaxetps		est un reel		= 0
         ltauxtaxetvq		est un reel		= 0
         lTauxCombine		est un booleen	= faux
         lPositionTable		est un entier
         
         ltvqcharge			est un booleen
         selon config.Province 
         	cas 0,1
         		ltvqcharge = faux
         	cas 2
         		ltvqcharge = vrai
         		
         FIN
         si invoicestable = -1 alors
         	retour
         FIN
         sablier(vrai)
         lPositionTable = invoicestable
         pour j = 1 _a_ TableSelectOccurrence(invoicestable)
         	fac_detail		= allouer un tableau de 1 par 4 chaine
         	fac_detail[1,1]	= ""
         	fac_detail[1,2]	= "0.00"
         	SousTotal		= 0 
         	TotalTaxetps	= 0 
         	TotalTaxetvq	= 0 
         	TotalSurcharge	= 0 
         	si hlitrecherche(BonLivraison,Bnumero,invoicestable.Bnumero[tableselect(invoicestable,j)]) alors
         		ltauxtaxetps = BonLivraison.bTauxTaxe1
         		si ltvqcharge alors
         			ltauxtaxetvq = BonLivraison.bTauxTaxe2
         		fin
         		lTauxCombine = bonlivraison.bCalculTaux2sur1
         	sinon
         		ltauxtaxetps = config.tauxtps	
         		si ltvqcharge alors
         			ltauxtaxetvq = config.tauxtvq
         		fin
         	FIN
         	
         	
         	hlitrecherche(hfacture,Bnumero,invoicestable.Bnumero[tableselect(invoicestable,j)])
         	BOUCLE
         		
         		
         		
         		
         		
         		
         		si hfacture.fatypedocument = 2 alors
         			multiplicateur = -1
         		sinon
         			multiplicateur = 1
         			
         		FIN
         //		hlitrecherche(hfdetail,fdnofact,invoicestable.Bnumero[tableselect(invoicestable,j)])
         //		tantque hfdetail.fdnofact = invoicestable.Bnumero[tableselect(invoicestable,j)] et pas hendehors(hfdetail) 
         		hlitrecherche(hfdetail,fdnocomm,hfacture.fanumero)
         		tantque hfdetail.fdnocomm = hfacture.fanumero et pas hendehors(hfdetail) 
         			si hfdetail.ftype <> 4 alors
         				
         				si hfdetail.ftype = 2 et pas hfdetail.fdverreunite alors
         					//			Remplir_tableau(hfdetail.fdcodegl,(arrondi(hfdetail.fdprixu * hfdetail.fdqteafacturer,2)))//* multiplicateur)
         					Remplir_tableau(hfdetail.fdcodegl,(arrondi(hfdetail.fdqteafacturer*hfdetail.fdprixu,2)))//* multiplicateur)
         					SousTotal+= arrondi(hfdetail.fdqteafacturer*hfdetail.fdprixu,2)  //* multiplicateur
         				sinon si hfdetail.ftype = 5 alors
         					Remplir_tableau(hfdetail.fdcodegl,(arrondi(hfdetail.fdqteafacturer*hfdetail.fdpiedcarrefacture*hfdetail.fdprixupied,2)))//* multiplicateur)
         					SousTotal+= arrondi(hfdetail.fdqteafacturer*hfdetail.fdpiedcarrefacture*hfdetail.fdprixupied,2)  //* multiplicateur
         				sinon si hfdetail.ftype = 3 alors
         					Remplir_tableau(hfdetail.fdcodegl,(arrondi(hfdetail.fdqteafacturer*hfdetail.fdprixupied,2)))//* multiplicateur)
         					SousTotal+= arrondi(hfdetail.fdqteafacturer*hfdetail.fdprixupied,2)  //* multiplicateur
         				sinon
         					
         					Remplir_tableau(hfdetail.fdcodegl,arrondi(hfdetail.fdqteafacturer * hfdetail.fdprixupiedfacture * ...
         					hfdetail.fdpiedcarrefacture,2)-(arrondi(hfdetail.FDExtraCap * hfdetail.fdqteafacturer,2)))
         					SousTotal+=arrondi(hfdetail.fdqteafacturer * hfdetail.fdprixupiedfacture * ...
         					hfdetail.fdpiedcarrefacture,2)-(arrondi(hfdetail.FDExtraCap * hfdetail.fdqteafacturer,2))
         					SI hfdetail.FDExtraCap <> 0 ALORS
         						remplir_tableau(CONFIG.CapGL,(arrondi(hfdetail.FDExtraCap * hfdetail.fdqteafacturer,2)))
         						SousTotal+=arrondi(hfdetail.FDExtraCap * hfdetail.fdqteafacturer,2) 
         					fin
         					SI hfdetail.fdextraforme <> 0 ALORS
         						remplir_tableau(CONFIG.ExtraFormeGL,(arrondi(hfdetail.FDExtraforme * hfdetail.fdqteafacturer,2)) )
         						SousTotal+= arrondi(hfdetail.FDExtraforme * hfdetail.fdqteafacturer,2) 
         					fin
         					SI hfdetail.fdextra5X <> 0 ou hfdetail.FDextra10X <> 0 ALORS
         						remplir_tableau(hfdetail.fdcodegl,(arrondi((hfdetail.FDExtra5X+hfdetail.FDextra10X) * hfdetail.fdqteafacturer,2)) )
         						SousTotal+= arrondi((hfdetail.FDExtra5X+hfdetail.FDextra10X) * hfdetail.fdqteafacturer,2) 
         					fin
         					TotalSurcharge+= arrondi(hfdetail.surchargeenergie,2) //* multiplicateur
         					
         					
         					
         					//			soustotal+= arrondi(hfdetail.fdprixtotal,2)  * multiplicateur
         				FIN
         				
         				
         			sinon
         				//			Remplir_tableau(hfdetail.fdcodegl,arrondi(hfdetail.fdprixtotal,2)*multiplicateur)
         				Remplir_tableau(hfdetail.fdcodegl,arrondi(((hfdetail.fdcarrpruxuc * hfdetail.fdnbcarreau) + hfdetail.fdcarrprixdebase)* hfdetail.fdqteafacturer,2)*multiplicateur)
         				Remplir_tableau(hfdetail.fdcodegl,arrondi(hfdetail.fdnbcarreau *hfdetail.FDextraCarrelagedemi * hfdetail.fdqteafacturer,2)*multiplicateur)
         				//			soustotal+= arrondi(hfdetail.fdprixtotal,2)*multiplicateur
         				SousTotal+= arrondi(((hfdetail.fdcarrpruxuc * hfdetail.fdnbcarreau) + hfdetail.fdcarrprixdebase)* hfdetail.fdqteafacturer,2) * multiplicateur
         				SousTotal+= arrondi(hfdetail.fdnbcarreau *hfdetail.FDextraCarrelagedemi * hfdetail.fdqteafacturer,2)*multiplicateur
         				
         				//			soustotal+= arrondi(hfdetail.fdnbcarreau *hfdetail.FDextraCarrelagedemi * hfdetail.fdqteafacturer,2)
         				si hfdetail.fTotalPeinture <> 0 alors
         					//				Remplir_tableau(config.GlPeinturecarrelage,arrondi(hfdetail.fTotalPeinture * hfdetail.fdqteafacturer,2))
         					Remplir_tableau(config.GlPeinturecarrelage,arrondi(((hfdetail.Ftotalcarreaupeinture*hfdetail.fPrixCarreauPeinture)...
         					+(hfdetail.FDnbcarreauPeinture1*hfdetail.fdprixcarreaupeinture1))...
         					* hfdetail.fdqteafacturer ,2))//*multiplicateur)
         					SousTotal+= arrondi(((hfdetail.Ftotalcarreaupeinture*hfdetail.fPrixCarreauPeinture)...
         					+(hfdetail.FDnbcarreauPeinture1*hfdetail.fdprixcarreaupeinture1))...
         					* hfdetail.fdqteafacturer ,2)//*multiplicateur
         					//				soustotal+= arrondi(hfdetail.fTotalPeinture* hfdetail.fdqteafacturer,2)
         				FIN
         			fin
         			hlitsuivant(hfdetail,fdnocomm)
         		FIN
         		
         		si hfacture.fsurchargepeinture <> 0 ALORS
         			SousTotal+= arrondi(hfacture.fsurchargepeinture,2)*multiplicateur
         			Remplir_tableau_gl(hfacture.NoGlSurchargePeinture,arrondi(hfacture.fsurchargepeinture,2))
         		fin
         
         
         		hlitsuivant(hfacture,bnumero) 
         	À FAIRE TANTQUE PAS HEnDehors(hfacture) _et_ hfacture.Bnumero = Invoicestable.Bnumero[TableSelect(Invoicestable,j)]
         	
         	
         	TotalSurcharge	= TotalSurcharge * multiplicateur
         	////////////////////
         	//totaltaxetps = arrondi((soustotal+totalsurcharge) * config.tauxtps / 100,2)
         	////////////////////
         	TotalTaxetps	= arrondi((SousTotal+TotalSurcharge) *  ltauxtaxetps / 100,2)
         	si ltvqcharge alors
         		TotalTaxetvq = arrondi((SousTotal+TotalSurcharge+(lTauxCombine ? TotalTaxetps sinon 0) )*  ltauxtaxetvq / 100,2)
         	sinon
         		TotalTaxetvq =  0
         	fin
         	
         	
         	
         	si TotalSurcharge <> 0 alors
         		Remplir_tableau(config.surchargegl,TotalSurcharge)
         	fin
         	
         	HLit(config,1)
         	si config.SUrchargeTauxActive et hfacture.surchargetauxchange <> 0 alors
         		TotalSurchargeTaux = Arrondi(SousTotal+( config.calculTauxSurSurcharge ? TotalSurcharge SINON 0 ),2) * hfacture.surchargeTauxChange / 100
         		Remplir_tableau(config.SUrchargeTauxGl,TotalSurchargeTaux)
         	FIN
         	
         	Remplir_tableau(config.gltps,arrondi(TotalTaxetps,2),vrai)
         	si ltvqcharge alors
         		Remplir_tableau(config.gltvq,arrondi(TotalTaxetvq,2),vrai)
         	fin
         	
         	
         	fac_detail[1,2] = (SousTotal+TotalTaxetps+TotalTaxetvq+TotalSurcharge) * -1
         	
         	
         	
         	
         	
         	pour tout DetailCompta avec "NumeroBL = '"+invoicestable.Bnumero[tableselect(invoicestable,j)]+"'"
         		hsupprime(detailcompta)
         	FIN
         	
         	si hlitrecherche(BonLivraison,Bnumero,invoicestable.Bnumero[tableselect(invoicestable,j)]) ALORS
         		BonLivraison.BStotal	= SousTotal+TotalSurcharge
         		BonLivraison.BTPS		= TotalTaxetps
         		BonLivraison.BTVQ		= TotalTaxetvq
         		BonLivraison.Bsurcharge	= TotalSurcharge
         		HMODIFIE(BonLivraison,hNumEnrEnCours)
         	FIN
         	
         	maj_detail_comptable(invoicestable.Bnumero[tableselect(invoicestable,j)])
         	liberer fac_detail
         	
         	
         fin
         tableselectmoins(invoicestable)
         tableaffiche(invoicestable,tadebut)
         TablePosition(invoicestable,lPositionTable)
         tableselectplus(invoicestable,lPositionTable)
         sablier(faux)
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BtnCourriel
    identifier : 0x46128a977e550f12
    internal_properties : 
    properties :
     x : 161
     y : 6
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         j est un entier
         lAdresseCourriel est une chaine
         lNumeroClient est une chaine
         ListeFichier est une chaine
         ListeNoFacture est une chaine
         lNbLigneAffiche est un entier = TableOccurrence(invoicestable,toAffichée)
         lFactureEnCours  est un entier= invoicestable
         hlit(config,1)
         
         
         lSujet est une chaine
         lMessage est une chaine 
         
         restaure_bouton()
         
         si TableSelectOccurrence(Invoicestable) > 1 alors
         	pour j = 1 a TableSelectOccurrence(Invoicestable)
         		si Invoicestable.#client[TABLESELECT(Invoicestable,j)] <> lNumeroClient et pas lNumeroClient = "" alors
         			acso_message("Erreur","Toutes les factures ou bon de livraison doivent appartenir au même client","Erreur")
         			renvoyer vrai
         		sinon
         			lNumeroClient = Invoicestable.#client[TABLESELECT(Invoicestable,j)]	
         		FIN
         	FIN
         sinon
         	lNumeroClient = Invoicestable.#client[Invoicestable]	
         FIN
         
         
         si hlitrecherche(client,numero,lNumeroClient) alors
         	si selecteurdoc = 1 alors
         		pour j = 1 a 4
         			si sansespace(client.ccourrielFacture[j]) <> "" alors
         				lAdresseCourriel += sansespace(client.ccourrielFacture[j])+";"
         			fin
         		fin
         
         		si client.CLangue = 1 alors
         			lSujet = SANSESPACE(config.SujetFrancais[1])+" "
         			lMessage = config.TexteFrancais[1]
         		sinon
         			lSujet = SANSESPACE(config.Sujetanglais[1])+" "
         			lMessage = config.Texteanglais[1]
         		fin	
         
         	sinon
         		pour j = 1 a 4
         			si sansespace(client.ccourrielBonLivraison[j]) = "" alors
         				lAdresseCourriel += sansespace(client.ccourrielBonLivraison[j])+";"
         			fin
         		fin
         		si client.CLangue = 1 alors
         			lSujet = SANSESPACE(config.SujetFrancais[2])+" "
         			lMessage = config.TexteFrancais[2]
         		sinon
         			lSujet = SANSESPACE(config.Sujetanglais[2])+" "
         			lMessage = config.Texteanglais[2]
         		fin	
         	fin
         
         fin	
         
         sablier(vrai)
         iconfigure(sansespace(imprimantepdf),vrai)
         //iconfigure()
         //iparametre()
         POUR j = 1 A TableSelectOccurrence(invoicestable)
         
         
         	si TABLESELECT(invoicestable,j) > TablePosition(invoicestable)+lNbLigneAffiche-1 alors
         		tableposition(invoicestable,TABLESELECT(invoicestable,j))
         	sinon si TABLESELECT(invoicestable,j) < TablePosition(invoicestable) alors
         		tableposition(invoicestable,TABLESELECT(invoicestable,j))
         
         	fin
         
         
         
         	hlitrecherche(BonLivraison,Bnumero,invoicestable.Bnumero[TABLESELECT(invoicestable,j)])
         
         	si htrouve(BonLivraison) alors
         
         		hexecuterequete(ReqGroupShippingBill,hRequêteDéfaut,BONLIVRAISON.BNUMERO)
         		//	iAperçu(i100, "Aperçu écran", Vrai)
         		si selecteurdoc = 1 alors
         			iFenêtreAbandon(faux)
         
         			si frep(completerep(repdonnees)+"PDF\"+sansespace(lNumeroClient)+"\Facture",frRépertoire) = "" alors
         				fRepCrée(completerep(repdonnees)+"PDF\"+sansespace(lNumeroClient)+"\Facture")
         			fin
         //			pdfc>>cPrinterStop = 1
         //			pdfc>>cOption("AutosaveDirectory") = completerep(repdonnees)+"PDF\"+sansespace(lnumeroclient)+"\Facture"
         //			i = 1
         //			pdfc>>cOption("AutosaveFilename")  ="Facture"+invoicestable.ffacture[TABLESELECT(invoicestable,J)]
         //			lnomfichier = pdfc>>cOption("AutosaveDirectory")+"\Facture"+invoicestable.Ffacture[TableSelect(invoicestable,j)]+".pdf"
         			lnomfichier = ComplèteRep(repdonnees)+"PDF\"+SansEspace(lNumeroClient)+"\Facture\Facture"+invoicestable.Ffacture[TableSelect(invoicestable,j)]+".pdf"
         			
         			i = 0
         			iConfigure(SansEspace(imprimantefacture),Vrai)
         			iParamètre("DEFAUT=NON")
         			iParamètre("FORMATPAPIER=LETTRE")
         			iDestination(iPDFGénérique,lnomfichier)
         			
         			ifenetreabandon(faux)
         
         			iimprimeetat(EGroupInvoice,vrai,BONLIVRAISON.BNUMERO)
         
         
         			invoicestable.transfere[TABLESELECT(invoicestable,j)] = 3
         			ListeFichier+= lnomfichier+";"
         			
         			ListeNoFacture+=sansespace(BonLivraison.bfacture)+","
         		sinon
         			iFenêtreAbandon(faux)
         
         			si frep(completerep(repdonnees)+"PDF\"+sansespace(lNumeroClient)+"\BonLivraison",frRépertoire) = "" alors
         				fRepCrée(completerep(repdonnees)+"PDF\"+sansespace(lNumeroClient)+"\BonLivraison")
         			fin
         
         			lnomfichier = ComplèteRep(repdonnees)+"PDF\"+SansEspace(lNumeroClient)+"\BonLivraison\BdeL"+invoicestable.Bnumero[TableSelect(invoicestable,j)]+".pdf"
         			i = 0
         			
         			iConfigure(SansEspace(imprimantefacture),Vrai)
         			iParamètre("DEFAUT=NON")
         			iParamètre("FORMATPAPIER=LETTRE")
         			iDestination(iPDFGénérique,lnomfichier)
         			ifenetreabandon(faux)
         			iimprimeetat(EGroupShippingBill)
         			invoicestable.transfere[TABLESELECT(invoicestable,j)] = 3
         			ListeFichier+= lnomfichier+";"
         			ListeNoFacture+=sansespace(BonLivraison.bnumero)+","
         		fin
         
         	fin 
         
         
         
         FIN
         sablier(faux)
         lSujet+=ListeNoFacture[[1 a taille(ListeNoFacture)-1]]
         ouvre(FenEmail,lAdresseCourriel,lSujet,lMessage,ListeFichier,lNumeroClient,faux,selecteurdoc+1)
         //ExécuteTraitement(HFACTUREFILTRE,trtModification)
         TablePosition(invoicestable,lFactureEnCours)
         tableselectplus(invoicestable,lFactureEnCours)
        type : 18
      -
        type : 161
        enabled : false
  -
    name : Bouton1
    identifier : 0x462ea3a428bef07a
    internal_properties : 
    properties :
     x : 833
     y : 64
     width : 80
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         RequeteCoutantCommandeArchive.pDateDebut = "20070419"
         RequeteCoutantCommandeArchive.pDatefin = "20070420"
         RequeteCoutantCommandeArchive.pNoClient = "3364044   "
         HExécuteRequête(RequeteCoutantCommandeArchive)
         iapercu()
         iImprimeEtat(ECoutantCommandeDetailleeUnClient, "20070419", "20070420","3364044   ")
        type : 18
      -
