     type_code : 4
     p_codes :
      -
        code : |1+
         si table_facture.transfere[table] = 0 alors
         	si acso_message("Question","Voulez-vous marquer cette facture comme transférée à la comptabilité ?","OuiNon") = idyes alors
         		Table_Facture.transfere[table] = vrai
         		tableenregistre("TABLE")
         	fin
         fin 
         
        type : 18
