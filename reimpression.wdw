   -
     name : maj_detail_comptable
     procedure_id : 4622977445626824656
     type_code : 14
     code : |1+
      Procédure maj_detail_comptable(numeroBL)
      i est un entier
      hlit(config,1)
      pour i = 1 a dimension(fac_detail)/4
      	detailcompta.numeroBL = numeroBL
      	si pas sansespace(fac_detail[i,1]) = "" ou i = 1 alors
      		detailcompta.NoGlivre = fac_detail[i,1]
      	sinon
      		detailcompta.noglivre = config.glventedefaut
      	fin
      	detailcompta.MontantGlivre = fac_detail[i,2]
      	detailcompta.noLigne = i
          detailcompta.EstTaxe = fac_detail[i,3]
      	hajoute(DetailCompta)
      FIN
      
      
      
     type : 458752
   -
     name : Remplir_tableau
     procedure_id : 4807242813390291963
     type_code : 14
     code : |1+
      Procédure Remplir_tableau(codegl,montantgl,taxegl=faux)
      codegltrouve est un booleen = faux
      si codegl = "" alors
      	codegl = config.glventedefaut
      FIN
      j est un entier = (dimension(fac_detail)/4)
      k est un entier
      si pas j = 1 alors
      pour k = 2 a j
      	si fac_detail[k,1] = codegl alors
      		codegltrouve = vrai
      		fac_detail[k,2]=numeriqueverschaine(val(fac_detail[k,2])+montantgl)
      	    sortir
      	FIN
      FIN
      fin
      
      si pas codegltrouve alors
          
      	dimension(fac_detail,j+1,4)
      	fac_detail[j+1,1] = codegl
      	fac_detail[j+1,2] = numeriqueverschaine(montantgl)
          si taxegl alors
          	fac_detail[j+1,3] = "1"
          fin	
      FIN
      
      
      
