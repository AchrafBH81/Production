  -
    name : BTN_IMPRIME1
    identifier : 0x3fbb91b9431eece3
    internal_properties : 
    properties :
     x : 215
     y : 6
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         j est un entier
         
         restaure_bouton()
         
         nParentLine est un entier
         
         
         
         iconfigure(sansespace(imprimantebon),vrai)
         
         POUR j = 1 _A_ TableSelectOccurrence(invoicestable)
         	
         	// si on est positionné sur une branche fils
         	nParentLine = TableRécupèreParent(Invoicestable,TableSelect(Invoicestable,j))
             //
             // 
         	si  nParentLine <> 0 alors
         		hlitrecherche(BonLivraison,Bnumero,Invoicestable.Bnumero[nParentLine])
         	SINON
         		HLitRecherche(BonLivraison,Bnumero,Invoicestable.Bnumero[TableSelect(Invoicestable,j)])
         	FIN
         	
         	
         	si htrouve(BonLivraison) alors
         		
         		hexecuterequete(ReqGroupShippingBill,hRequêteDéfaut,BONLIVRAISON.BNUMERO)
         		//	iAperçu(i100, "Aperçu écran", Vrai)
         		si selecteurdoc = 1 alors
         			// Ne sauvegarde pas les paramètres spécifiés
         			iAperçu(i100, "Aperçu écran")
         			iParamètre("DEFAUT=NON")
         			
         			iimprimeetat(EGroupInvoice,vrai,BONLIVRAISON.BNUMERO)
         		sinon
         			iParamètre("DEFAUT=NON")
         			iAperçu(i100, "Aperçu écran")
         			//Nombre de copies à imprimer
         			iParamètre("COPIES="+CONFIG.nbcopieBlivraison)
         			
         			iimprimeetat(EGroupShippingBill)
         			
         			
         		fin
         		//		 Aco_AjoutTrxRcv(fac_entete,fac_detail)
         		
         		//majhistorique(fenregistrement[j])
         		multitache(50)
         	fin 
         	
         FIN
         
         
         
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_DETRUIRE
    identifier : 0x4033f70b3bb13a03
    internal_properties : 
    properties :
     x : 453
     y : 6
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         restaure_bouton()
         nReponse est un entier
         si acso_message("Question","Voulez-vous supprimer cette facture"+RC+RC+"Cette action est définitive, aucun retour en arrière possible","OuiNon") = idyes aLORS
         	si table_facture.transfere[Table_Facture] = 1  ALORS
         		si acso_message("Question","Cette facture à été transférée à la comptabilité"+crlf+"Voulez-vous quand même la supprimer","OuiNon") = idno alors
         			renvoyer vrai
         		FIN
         	fin
         
         
         
         //	htransactiondebut("transaction","bonlivraison,hfacture,hfdetail")
         	hgereintegrite(Contrainte_hfacture_hfdetail,hfdetail,faux)
         	hgereintegrite(Contrainte_hfacture_hfdetail,hfacture,faux)
         	hgereintegrite(Contrainte_BonLivraison_hfacture,bonlivraison,faux)
         	hgereintegrite(Contrainte_BonLivraison_hfacture,hfacture,faux)
         	hlitrecherche(hfdetail,fdnofact,table_facture.bnumero[Table_Facture])
         	tantque hfdetail.fdnofact = table_facture.Bnumero[Table_Facture] et pas hendehors(hfdetail)
         		hsupprime(hfdetail)
         		hlitsuivant(hfdetail,fdnofact)
         	FIN
         	HLITRECHERCHE(DetailCompta,numeroBL,table_facture.bnumero[Table_Facture])
         	tantque DetailCompta.numeroBL = table_facture.Bnumero[Table_Facture] et pas hendehors(DETAILCOMPTA)
         		hsupprime(DETAILCOMPTA)
         		hlitsuivant(DETAILCOMPTA,numeroBL)
         	FIN
         
         	si hlitrecherche(hfacture,Bnumero,Table_Facture.Bnumero[table_facture]) alors
         		hsupprime(hfacture)
         	fin
         	si hlitrecherche(bonlivraison,Bnumero,Table_Facture.Bnumero[table_facture]) alors
         		hsupprime(bonlivraison)
         	fin
         
             MajLogManuel(Table_Facture.Bnocommande,"F","HSupprime")
             
         	tablesupprime(table_facture,table_facture)
         	//   	tableaffiche("TABLE_1","I")
         	hgereintegrite(Contrainte_hfacture_hfdetail,hfdetail,vrai)
         	hgereintegrite(Contrainte_hfacture_hfdetail,hfacture,vrai)
         	hgereintegrite(Contrainte_BonLivraison_hfacture,bonlivraison,vrai)
         	hgereintegrite(Contrainte_BonLivraison_hfacture,hfacture,vrai)
         //	htransactionfin()
         	//Code WinDev 5.5 remplacé par la migration :
         	//	tableaffiche("TABLE","P")
         	tableaffiche(table_facture,taCourantBandeau)
         	//Code WinDev 5.5 remplacé par la migration :
         	//    execute("table..LEn")
         FIN
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_DETRUIRE1
    identifier : 0x403df3ab2b0f50eb
    internal_properties : 
    properties :
     x : 349
     y : 6
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         nShippingBillNumber	est un entier
         nInvoiceNumber		est un entier
         nTypedoc			est un entier
         CustomerNumber		est une chaîne
         
         ParentLineNumber	est un entier	= Invoicestable.RécupèreParent(Invoicestable) 
         si ParentLineNumber <> 0 alors
         	nShippingBillNumber		=  Invoicestable.Bnumero[ParentLineNumber]	
         	nInvoiceNumber			=  Invoicestable.ffacture[ParentLineNumber]	
         	nTypedoc				=  Invoicestable.typedoc[ParentLineNumber]	
         	CustomerNumber			=  Invoicestable.#client[ParentLineNumber]	
         SINON 
         	nShippingBillNumber	= Invoicestable.Bnumero
         	nInvoiceNumber		=  Invoicestable.Ffacture
         	nTypedoc			=  Invoicestable.TypeDoc	
         	CustomerNumber		=  Invoicestable.#client	
         FIN
         ouvre(FdetailComptacameleon,nShippingBillNumber,nInvoiceNumber,nTypedoc,CustomerNumber)
         
         
         
         //ExécuteTraitement(HFACTUREFILTRE,trtModification)
         tableaffiche(invoicestable,taCourantBandeau)
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_SYNCHRO
    identifier : 0x4054a3d52123b97a
    internal_properties : 
    properties :
     x : 609
     y : 6
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         restaure_bouton()
         reponse est un entier
         i est un entier
         numeroachercher est un entier
         ouvrefille(FenAttente,"Synchronisation en cours ... ",ijaunebulle,ivertfonce)
         //htransactiondebut("transaction","bonlivraison,hfacture,hfdetail")
         hgereintegrite(Contrainte_hfacture_hfdetail,hfdetail,faux)
         hgereintegrite(Contrainte_hfacture_hfdetail,hfacture,faux)
         hgereintegrite(Contrainte_BonLivraison_hfacture,bonlivraison,faux)
         hgereintegrite(Contrainte_BonLivraison_hfacture,hfacture,faux)
         hlitpremier(hfacture,Bnumero)
         tantque pas hendehors(hfacture)
         
         	si pas hlitrecherche(BonLivraison,Bnumero,hfacture.Bnumero) alors
         
         		hlitrecherche(hfdetail,fdnofact,hfacture.bnumero)
         		tantque hfdetail.fdnofact = hfacture.bnumero et pas hendehors(hfdetail)
         			hsupprime(hfdetail)
         			hlitsuivant(hfdetail,fdnofact)
         		fin
         		hlitrecherche(DetailCompta,numeroBL,hfacture.bnumero)
         		tantque DetailCompta.numeroBL = hfacture.bnumero et pas hendehors(DetailCompta)
         			hsupprime(detailcompta)
         			hlitsuivant(detailcompta,numeroBL)
         		fin
         		hsupprime(hfacture)
         	fin
         
         	hlitsuivant(hfacture,Bnumero)
         FIN
         HExécuteRequête(RequeteDetailComptaUnique)
         hlitpremier(RequeteDetailComptaUnique)
         tantque pas hendehors(RequeteDetailComptaUnique)
         	si pas hlitrecherche(BonLivraison,Bnumero,detailcompta.numeroBL) alors
         		tantque detailcompta.numeroBL = RequeteDetailComptaUnique.numeroBL et pas hendehors(DetailCompta)
         			hsupprime(DetailCompta)
         			hlitsuivant(DetailCompta,numeroBL)
         		FIN
         	FIN
            hlitsuivant(RequeteDetailComptaUnique)
         fin
         
         hgereintegrite(Contrainte_hfacture_hfdetail,hfdetail,vrai)
         hgereintegrite(Contrainte_hfacture_hfdetail,hfacture,vrai)
         hgereintegrite(Contrainte_BonLivraison_hfacture,bonlivraison,vrai)
         hgereintegrite(Contrainte_BonLivraison_hfacture,hfacture,vrai)
         //htransactionfin()
         multitache(200)
         ferme(fenattente)
         //Code WinDev 5.5 remplacé par la migration :
         //	tableaffiche("TABLE","P")
         //Code WinDev 5.5 remplacé par la migration :
         //    execute("table..LEn")
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BoutonTrsf
    identifier : 0x409ada693d0d8411
    internal_properties : 
    properties :
     x : 554
     y : 6
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         j est un entier
         letat est un entier
         tabLineToDeselect est un tableau d'entier
         POUR i = 1 À TableSelectOccurrence(Invoicestable)
         	SI Invoicestable.RécupèreParent(TableSelect(InvoicesTable, i)) <> 0 ALORS
         		tabLineToDeselect.Ajoute(TableSelect(Invoicestable, i)) 
         	FIN
         	
         FIN
         
         
         POUR CHAQUE nLinenumber de tabLineToDeselect
         	Invoicestable.SelectMoins(nLinenumber)
         FIN
         
         
         
         
         
         si TableSelectOccurrence(InvoicesTable) > 1 alors
         	si acso_message("Question","Voulez avez sélectionné plusieurs factures.Voulez-vous inverser l'état de ces factures ?","OuiNon") = idyes alors
         		pour j=1 _a_ tableselectoccurrence(InvoicesTable)
                     
         			si hlitrecherche(BonLivraison,Bnumero,InvoicesTable.Bnumero[tableselect(InvoicesTable,j)]) alors
         				letat = abs(val(InvoicesTable.transfere[tableselect(InvoicesTable,j)])-1)
         				InvoicesTable.transfere[tableselect(InvoicesTable,j)] = letat
         				BonLivraison.btransfere = letat
         				InvoicesTable.erreur[tableselect(InvoicesTable,j)] = ""
         				BonLivraison.berreur = ""
         				hmodifie(BonLivraison,hNumEnrEnCours)
         //				hvueversfichier(mavue)
         			fin
         
         		fin
         	fin
         
         sinon
         
         	si InvoicesTable.transfere = 1 alors
         		si acso_message("Question","Voulez vous marquer cette facture comme étant NON transférée à la comptabilité","OuiNon") = idyes alors
         			si hlitrecherche(BonLivraison,Bnumero,InvoicesTable.Bnumero[InvoicesTable]) alors
         				InvoicesTable.transfere[InvoicesTable] = 0
         				BonLivraison.btransfere = 0
         				InvoicesTable.erreur[InvoicesTable] = ""
         				BonLivraison.berreur = ""
         				hmodifie(BonLivraison,hNumEnrEnCours)
         //				hvueversfichier(mavue)
         			fin
         		fin
         	sinon
         		si acso_message("Question","Voulez vous marquer cette facture comme étant transférée à la comptabilité","OuiNon") = idyes alors
         			si hlitrecherche(BonLivraison,Bnumero,InvoicesTable.Bnumero[InvoicesTable]) alors
         				InvoicesTable.transfere[InvoicesTable] = 1
         				BonLivraison.btransfere = 1
         				InvoicesTable.erreur[InvoicesTable] = ""
         				BonLivraison.berreur = ""
         				hmodifie(BonLivraison,hNumEnrEnCours)
         //				hvueversfichier(mavue)
         			fin
         		fin
         
         	fin
         
         fin
        type : 18
      -
        type : 161
        enabled : false
