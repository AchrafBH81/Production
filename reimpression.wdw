 actionbar : {}
 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1-
      formule est une chaine
      lnomfichier est une chaine
      valeuralentree est un entier
      
      STShippingBill				est une structure
      	nShippingBillNumber			est un entier
      	dShippingBillDate			est une Date
      	sShippingBillCustomerNumber	est une chaîne
      	sShippingBillCustomername	est une chaine
      	nShippingBillIsPaint		est un entier
      	dShippingInvoicedate est une date
      	nRien est un entier
      	nCfacture					est un entier
      	nNumberOfOrder				est un entier
      	nInvoiceNumber est un entier
      	bTransfered est un booleen
      	tabOrderDetail				est un tableau de storderdetail    
      FIN
      
      
      
      
      
      STOrderdetail est une structure
      	nOrderNumber			est un entier
      	dhOrderdate				est une DateTime
      	sCustomerOrderNumber	est une chaine
      	norderIsPaint			est un entier
      FIN
      
      gtaShippingBill est un tableau associatif (*, *, wlEntier) de STShippingBill
      gtaShippingBillFilter est un tableau associatif (*, *, wlEntier) de STShippingBill
      
      
      
      
      
      si gFormatFacture = 1 alors
      	Table_Facture.Bnocommande..visible=faux
      	Table_Facture.Bcommandeclient..visible = faux
      	Table_Facture.NomClient..Largeur= Table_Facture.NomClient..LargeurInitiale+185
      	BtnListe..visible = faux
      	BtnRecherche..visible = faux
      FIN
      
      
      
      
      
      
      //gImprimantePdfStatus est un booleen = vrai
      //gImprimantePdfStatusNumber est un entier  = PrinterGetStatus(imprimantepdf)
      //
      
      
      // Initialisation de la fonction Hasard() 
      
      InitHasard()
      
      // Construction de la chaîne
      sChaîneGénérée est une chaîne
      nNombre est un entier
      i est un entier
      pour i=1 à 8
      	// Génération aléatoire du caractère ASCII d'une lettre
      	BOUCLE
      		nNombre = Hasard(65,122)
      		SELON nNombre
      			CAS 91,92,93,94,95,96
      			// Caractères situés entre les majuscules et les minuscules
      			AUTRE CAS
      				sortir
      		FIN
      	FIN
      	// On construit la chaîne
      	sChaîneGénérée+=Caract(nNombre)
      FIN
      
      
      //mavue est une source de donnees
      
      
      // Création de la vue
      
      
      
      
      //HCréeVue(MaVue, BonLivraison, "Btransfere,Bnumero,Bdate,Bfacture,Bdatefacture,Bclient,Bclient,Berreur", "Bdate", "Btransfere>=0", hVueBlocage)
      //FichierVersTableMemoire(Table_facture,mavue)
      
      // Parcours de la vue
      
      // Pour compatibilité 5.5
      MoiMême..Visible=Vrai
      
      hlitpremier("config","COCLEUNIK")
      chargeimage(1,maitre.FichierImage..valeur,1,13)
      ListeAjoute("transfere",gImage(1,12))
      ListeAjoute("transfere",gImage(1,13))
      ListeAjoute("transfere",gImage(1,8))
      ListeAjoute("transfere",gImage(1,9))
      
      
      hfacturefiltre = 3
      reimpression.DEMARCATION = entierversdate(dateversentier(datesys())- config.nombredejour)
      reimpression.sai_EndingDate = DateDuJour()
      FillShippingBill()
      //hexecuterequete(RequeteFacture,hRequêteDéfaut,"20030101","'0'")
      executetraitement(HFACTUREFILTRE,trtModification)
      //tableaffiche(Table_Facture)
      
      si gLogCompt <> "Acomba" alors
      	BTN_ACOMBA..visible = faux
      sinon	
      	BTN_ACOMBA..visible = vrai
      FIN
      
      memcrée("Tableau_metrique")
      memcrée("Tableau_anglais")
      memcrée("Tableau_millimetre")
      
      //remplit_tableau_metrique()
