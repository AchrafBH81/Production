    name : BTN_ACOMBA
    identifier : 0x3f85af680a6c85d6
    internal_properties : 
    properties :
     x : 290
     y : 6
     width : 32
     height : 32
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         toutelesfacture est un booleen = faux
         messageerreur est une chaine
         j est un entier
         btn_imprime..etat = actif; btn_imprime..Visible=Vrai
         si pas table_facture.transfere[table_facture] <> 1 alors
         	renvoyer vrai
         fin
         si acso_message("Question","Transférer toutes les factures ?","OuiNon") = idyes alors
         	toutelesfacture = vrai
         FIN
         
         si pas toutelesfacture alors		
         	si table_facture.transfere[table_facture] <> 1 alors
         
         		si hlitrecherche(RequeteBonLivraison,bnumero,table_facture.Bnumero[table_facture])
         //		si hlitrecherche(mavue,"Bnumero",table_facture.Bnumero[table_facture]) alors
         			si transfert_facture(table_facture.Bnumero[table_facture],vrai,messageerreur) alors
         				table_facture.transfere[table_facture] = 1
         				RequeteBonLivraison.btransfere = 1
         				table_facture.erreur[table_facture] = ""
         				RequeteBonLivraison.berreur = ""
         
         			sinon
         				table_facture.transfere[table_facture] = 2
         				table_facture.erreur[table_facture] = messageerreur
         				RequeteBonLivraison.btransfere = 2
         				RequeteBonLivraison.berreur = messageerreur
         
         			fin
         			hmodifie(RequeteBonLivraison,hNumEnrEnCours)
         //			hvueversfichier(mavue)
         		fin 
         	fin	
         sinon
         	tableselectplus(Table_Facture,1)
         	pour j = 1 a tableoccurrence("TABLE_FACTURE")
         		si j > tableoccurrence("TABLE_FACTURE",1) alors
         			tableselectplus("TABLE_FACTURE",j)
         		fin
         		si table_facture.transfere[j] <> 1 alors
         			si hlitrecherche(BonLivraison,Bnumero,table_facture.Bnumero[j]) alors
         				si transfert_facture(table_facture.Bnumero[j],faux,messageerreur) alors
         
         					table_facture.transfere[j] = 1
         					table_facture.erreur[j] = ""
         					RequeteBonLivraison.btransfere = 1
         					RequeteBonLivraison.berreur = ""
         
         				sinon
         					//RequeteFacture.Btransfere = 2
         
         					table_facture.transfere[j] = 2
         					table_facture.erreur[j] = messageerreur
         					RequeteBonLivraison.btransfere = 2
         					RequeteBonLivraison.berreur = messageerreur
         				fin
         			fin 
         		fin	
         		//         multitache(100)
         		hmodifie(RequeteBonLivraison,hnumenrencours)
         //		hvueversfichier(mavue)
         	FIN
         
         fin
        type : 18
      -
        type : 161
        enabled : false
