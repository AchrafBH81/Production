     type : 458752
   -
     name : FillShippingBill
     procedure_id : 1845096458509127268
     type_code : 14
     code : |1+
      Procédure FillShippingBill()
      lnocommande					est une chaine	= ""
      lnocommandeclient			est une chaine	= ""
      sLchaine						est une chaine
      lpeinture					est un entier
      nCurrentLine				est un entier
      nCurrentOrderLine est un entier
      
      
      reqsql est une requête SQL = 
      [
      	SELECT <§cs:3§>
      	BonLivraison.Bnumero AS Bnumero,	<§cs:3§>
      	BonLivraison.Bdate AS Bdate,	<§cs:3§>
      	BonLivraison.Bclient AS Bclient,<§cs:3§>
      	BonLivraison.Btransfere AS Btransfere,<§cs:3§>
      	BonLivraison.bDatefacture as Invoicedate,<§cs:3§>
      	Bonlivraison.brien as brien,<§cs:3§>
      	hfacture.fadate AS fadate,	<§cs:3§>
      	client.nom AS nom,<§cs:3§>
      	hfacture.fanumero,<§cs:3§>
      	hfacture.fanocommande,		<§cs:3§>
      	Client.cfacture AS cfacture,<§cs:3§>
      	<§cs:3§>
      	BonLivraison.Bfacture AS Bfacture<§cs:3§>
      	FROM <§cs:3§>
      	BonLivraison<§cs:3§>
      	<§cs:3§>
      	inner join client on client.numero = bonlivraison.Bclient<§cs:3§>
      	inner join hfacture on hfacture.bnumero = bonlivraison.bnumero<§cs:3§>
      	WHERE <§cs:3§>
      	<§cs:3§>
      	(<§cs:3§>
      	BonLivraison.Bfacture <> 0<§cs:3§>
      	AND	BonLivraison.Bdate Between {PDateDemarcation} AND {pEndingDate}<§cs:3§>
      	)<§cs:3§>
      	ORDER BY <§cs:3§>
      	Bnumero ASC<§cs:3§>
      ]
      //reqsql est une source de Données
      
      OuvreSoeur(FEN_AttenteGif,"Récupération des informations en cours.....",mafenetre..x+(mafenetre..largeur/2),mafenetre..y+(mafenetre..hauteur/2))
      
      reqsql.pdateDemarcation = demarcation
      reqsql.pEndingdate = sai_EndingDate
      
      
      HExécuteRequêteSQL(reqsql,hRequêteDéfaut)
      
      cpt est un entier = 1
      nBEnr est un entier = hnbenr(reqsql)
      
      gtaShippingBill.SupprimeTout()
      pour tout reqsql
      //	lchaine				= TrouveCommande(reqsql.Bnumero)
      //	lnocommande			= ExtraitChaîne(lchaine,1,",")
      //	lnocommandeclient	= ExtraitChaîne(lchaine,2,",")
      	lnocommande			= reqsql.fanumero
      	lnocommandeclient	= reqsql.fanocommande
      	SI HLitRecherche(Facture,fanumero,reqsql.fanumero) ALORS
      		lpeinture = Facture.fpeinture
      	SINON
      		lpeinture = 0	
      	FIN
      	si pas gtaShippingBill[reqsql.bnumero]..Existe ALORS
      		gtaShippingBill[reqsql.bnumero].nShippingBillNumber			= reqsql.bnumero
      		gtaShippingBill[reqsql.bnumero].dShippingBillDate			= reqsql.bdate
      		gtaShippingBill[reqsql.bnumero].sShippingBillCustomerNumber	= reqsql.bclient
      		gtaShippingBill[reqsql.bnumero].sShippingBillCustomername	= reqsql.nom
      		gtaShippingBill[reqsql.bnumero].dShippingInvoicedate = reqsql.invoicedate
      		gtaShippingBill[reqsql.bnumero].nCfacture					= reqsql.cfacture
      		gtaShippingBill[reqsql.bnumero].bTransfered				= reqsql.btransfere
      		gtaShippingBill[reqsql.bnumero].nInvoiceNumber  = reqsql.bfacture
      		gtaShippingBill[reqsql.bnumero].nrien  = reqsql.brien
      		
      		si gtaShippingBill[reqsql.bnumero].nShippingBillIsPaint = 0 alors gtaShippingBill[reqsql.bnumero].nShippingBillIsPaint = lpeinture 
      	FIN
      	stCurrentOrderDetail est un STOrderdetail = allouer un storderdetail()
      	stCurrentOrderDetail.dhOrderdate			= reqsql.fadate
      	stCurrentOrderDetail.nOrderNumber			= reqsql.fanumero
      	stCurrentOrderDetail.sCustomerOrderNumber	= reqsql.fanocommande
      	stCurrentOrderDetail.norderIsPaint			= lpeinture
      	gtaShippingBill[reqsql.bnumero].nNumberOfOrder++
      	gtaShippingBill[reqsql.bnumero].tabOrderDetail.ajoute(stCurrentOrderDetail)
      	cpt++
          jauge(cpt / nBEnr * 100, 100)
          
      	
      FIN
      gtaShippingBill.trie(ttmembre,"-nShippingBillNumber")
      
      
      ferme(FEN_AttenteGif)
      
      
      
     type : 458752
   -
     name : FillShippingBillTable
     procedure_id : 1845119625574079887
     type_code : 14
     code : |1+
      Procédure FillShippingBillTable()
      tabCurrentTabOrderDetail est un tableau de STOrderdetail
      
      
      nCurrentline est un entier
      nCurrentOrderline est un entier
      Invoicestable.supprimetout()
      OuvreSoeur(FEN_AttenteGif,"Remplissage de la table.....",MaFenêtre..X+(MaFenêtre..Largeur/2),MaFenêtre..Y+(MaFenêtre..Hauteur/2))
      cpt est un entier = 0
      
      pour CHAQUE stCurrentShippingBill de gtaShippingBillFilter
      	 
      	 cpt++
           jauge(cpt,gtaShippingBillFilter..occurrence)
      	nCurrentline = TableAjouteLigne(Invoicestable,"",stCurrentShippingBill.bTransfered,stCurrentShippingBill.nShippingBillNumber,...
      	stCurrentShippingBill.dShippingBillDate,stCurrentShippingBill.ninvoicenumber,"","",stCurrentShippingBill.dShippingInvoicedate,stCurrentShippingBill.sShippingBillCustomerNumber,...
      	stCurrentShippingBill.nrien,"",stCurrentShippingBill.sShippingBillCustomername,...
      	"","","")
      	si stCurrentShippingBill.nNumberOfOrder = 1 alors
      		invoicestable.Bnocommande[nCurrentline]	= stCurrentShippingBill.tabOrderDetail[1].nOrderNumber
      		invoicestable.Bcommandeclient[nCurrentline]	= stCurrentShippingBill.tabOrderDetail[1].sCustomerOrderNumber
        //      table_facture.ffacture[nCurrentline] = stCurrentShippingBill.tabOrderDetail[1].nOrderNumber		
      	SINON
      		
      		invoicestable[nCurrentline]..CouleurFond = iGrisClair
      		tabCurrentTabOrderDetail = stCurrentShippingBill.tabOrderDetail
      		Invoicestable[nCurrentline]..AjouteFilsDifféré = addChildInTable
      //		pour chaque stCurrentOrder de stCurrentShippingBill.tabOrderDetail
      //			nCurrentOrderline = Invoicestable.Ajoutefils(nCurrentline,"","","","","",...)
      //			stCurrentOrder.nOrderNumber,stCurrentOrder.sCustomerOrderNumber)
      //			invoicestable[nCurrentOrderline]..couleurfond = iGrisClair
      //		FIN
      			procédure interne addChildInTable(nCurrentlineToAdd est une entier)
      				
      				POUR CHAQUE stCurrentOrder de gtaShippingBillFilter[Invoicestable[nCurrentlineToAdd].bnumero].tabOrderDetail
      					nCurrentOrderline = Invoicestable.AjouteFils(nCurrentlineToAdd,"","","","","",...)
      					stCurrentOrder.nOrderNumber,stCurrentOrder.sCustomerOrderNumber)
      					Invoicestable[nCurrentOrderline]..CouleurFond = iGrisClair
      				FIN
      //			
      //				
      			FIN
      		
      		
      	FIN
      FIN
      
      tableaffiche(invoicestable,taDebut)
      invoicestable.EnrouleTout()
      ferme(FEN_AttenteGif)
      
      
