  -
    name : BTN_IMPRIME
    identifier : 0x3e9d90c920769ea4
    internal_properties : 
    properties :
     x : 107
     y : 6
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         j				est un entier
         lNbLigneAffiche	est un entier	= TableOccurrence(Invoicestable,toAffichée)
         lfactureencours	est un entier	= Invoicestable
         restaure_bouton()
         nParentLine			est un entier
         nShippingBillNumber	est un entier
         nCurrentLine est une entier
         
         
         iconfigure(sansespace(imprimantebon),vrai)
         //iconfigure()
         //iparametre()
         sablier(vrai)
         tableposition(Invoicestable,1)
         POUR j = 1 _A_ TableSelectOccurrence(invoicestable)
         	
         	nParentLine = Invoicestable.RécupèreParent(tableselect(Invoicestable,j))
         	si nParentLine <> 0 alors
         		nShippingBillNumber = Invoicestable.bnumero[nParentLine]
         	SINON
         		nShippingBillNumber = Invoicestable.Bnumero[TableSelect(Invoicestable,j)]
         	FIN
         	
         	hexecuterequete(ReqGroupShippingBill,hRequêteDéfaut,nShippingBillNumber)
         	//	iAperçu(i100, "Aperçu écran", Vrai)
         	si selecteurdoc = 1 alors
         		iParamètre("DEFAUT=NON")
         		iParamètre("QUALITE=HAUTE")
         		iParamètre("ORIENTATION=PAYSAGE")
         		//Nombre de copies à imprimer
         		iParamètre("COPIES="+CONFIG.nbcopiefacture)
         		iparametre("ASSEMBLE=OUI")
         //		si pas iparametre() alors
         //			renvoyer faux
         //		fin
         		
         		iFenêtreAbandon(faux)
         		iimprimeetat(EGroupInvoice,vrai,nShippingBillNumber)
         		
         		
         		
         	sinon
         		iParamètre("DEFAUT=NON")
         		iParamètre("QUALITE=HAUTE")
         		
         		//Nombre de copies à imprimer
         		
         		iFenêtreAbandon(faux)
         
         				
         				iimprimeetat(EGroupShippingBill,config.nbcopieBlivraison)
         		
         	fin
         	
         	
         	
         	multitache(10)
         	Invoicestable.transfere[TABLESELECT(Invoicestable,j)] = 4
         //	Invoicestable.selectmoins(TableSelect(Invoicestable,j))
         FIN
         multitache(100)
         //ExécuteTraitement(HFACTUREFILTRE,trtModification)
         TablePosition(Invoicestable,lfactureencours)
         tableselectmoins(Invoicestable)
         tableselectplus(Invoicestable,lfactureencours)
         sablier(faux)
        type : 18
      -
        type : 161
        enabled : false
  -
