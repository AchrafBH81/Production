   -
     name : RemplirTableInfo
     procedure_id : 5183578948481370507
     type_code : 14
     code : |1+
      Procédure RemplirTableInfo(lNumLigne=0,Libcolonne="",ltoucheenfoncee=0)
      i est un entier
      TableSupprimeTout(Tableinfo)
      si hlitrecherche(client,numero,sansespace(table_facture.#client[lNumLigne])) alors
      	tableajouteligne(Tableinfo,"Nom",client.nom )
      	tableajouteligne(Tableinfo,"Adresse",client.crue )
      	tableajouteligne(Tableinfo,"Ville/Province",client.cville )
      	tableajouteligne(Tableinfo,"Code Postal",client.ccodepostal )
      	tableajouteligne(Tableinfo,"Téléphone",client.ctelephone )
      	tableajouteligne(Tableinfo,"Télécopieur",client.cfax )
      	tableajouteligne(Tableinfo,"Cond. de paiement",client.ccondpaiement )
      
      
      
      FIN
      
      si pas Tableinfo..vide alors
      	pGestionSurvol.AfficherTable(tableinfo..nom,Const_Centré,0,vrai)
      fin
      
      
      
     type : 458752
   -
     name : RemplirTableContact
     procedure_id : 5183579030655407246
     type_code : 14
     code : |1+
      Procédure RemplirTableContact(lNumLigne=0,Libcolonne="",ltoucheenfoncee=0)
      i est un entier
      TableSupprimeTout(TableContact)
      si hlitrecherche(client,numero,sansespace(table_facture.#client[lNumLigne])) alors
      	pour i = 1 a 3
      		si sansespace(client.ccontact[i]) <> "" ou sansespace(client.ccontacttitre[i]) <> "" alors
      			tableajouteligne(TableContact,client.ccontacttitre[i],client.ccontact[i],client.ccontactTel[i] )
      		fin
      	FIn
      FIN
      
      //si pas TableContact..vide alors
      //	pGestionSurvol.AfficherTable(tablecontact..nom,Const_Centré,0,vrai)
      //fin
      
      
      
