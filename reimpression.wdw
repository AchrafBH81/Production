         lResultat EST UNE CHAINE =  ouvre(wRechercheGenerique)
         lligne est un entier
         si pas lResultat = "" alors
         
         	lligne = tablecherche("Table_Facture.Bnumero",lResultat)
         	si lligne <> -1 alors
         	    TableSelectMoins(Table_Facture)
         		TablePosition(Table_Facture,lligne)
         		TableSelectPlus(Table_Facture,lligne)
         	fin
         fin
