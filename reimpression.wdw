        enabled : false
  -
    name : BtnListe
    identifier : 0x4757fb755942cef6
    internal_properties : 
    properties :
     x : 401
     y : 6
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         ouvre(ListeFacture)
         //ExécuteTraitement(HFACTUREFILTRE,trtModification)
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BtnCourriel1
    identifier : 0x48c6c8845625ecbb
    internal_properties : 
    properties :
     x : 846
     y : -9
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         j est un entier
         lAdresseCourriel est une chaine
         lNumeroClient est une chaine
         ListeFichier est une chaine
         ListeNoFacture est une chaine
         lNbLigneAffiche est un entier = TableOccurrence(Table_Facture,toAffichée)
         hlit(config,1)
         
         
         lSujet est une chaine
         lMessage est une chaine 
         
         restaure_bouton()
         
         si TableSelectOccurrence(Table_Facture) > 1 alors
         	pour j = 1 a TableSelectOccurrence(Table_Facture)
         		si Table_Facture.#client[TABLESELECT(Table_Facture,j)] <> lNumeroClient et pas lNumeroClient = "" alors
         			acso_message("Erreur","Toutes les factures ou bon de livraison doivent appartenir au même client","Erreur")
         			renvoyer vrai
         		sinon
         			lNumeroClient = Table_Facture.#client[TABLESELECT(Table_Facture,j)]	
         		FIN
         	FIN
         sinon
         	lNumeroClient = table_facture.#client[Table_Facture]	
         FIN
         
         si hlitrecherche(client,numero,lNumeroClient) alors
         	si selecteurdoc = 1 alors
         		pour j = 1 a 4
         			si sansespace(client.ccourrielFacture[j]) <> "" alors
         				lAdresseCourriel += sansespace(client.ccourrielFacture[j])+";"
         			fin
         		fin
         
         		si client.CLangue = 1 alors
         			lSujet = SANSESPACE(config.SujetFrancais[1])+" "
         			lMessage = config.TexteFrancais[1]
         		sinon
         			lSujet = SANSESPACE(config.Sujetanglais[1])+" "
         			lMessage = config.Texteanglais[1]
         		fin	
         
         	sinon
         		pour j = 1 a 4
         			si sansespace(client.ccourrielBonLivraison[j]) = "" alors
         				lAdresseCourriel += sansespace(client.ccourrielBonLivraison[j])+";"
         			fin
         		fin
         
         		si client.CLangue = 1 alors
         			lSujet = SANSESPACE(config.SujetFrancais[2])+" "
         			lMessage = config.TexteFrancais[2]
         		sinon
         			lSujet = SANSESPACE(config.Sujetanglais[2])+" "
         			lMessage = config.Texteanglais[2]
         		fin	
         	fin
         
         fin	
         
         sablier(vrai)
         iconfigure(sansespace(imprimantepdf),vrai)
         //iconfigure()
         //iparametre()
         POUR j = 1 A TableSelectOccurrence(Table_Facture)
         
         
         	si TABLESELECT(Table_Facture,j) > TablePosition(Table_Facture)+lNbLigneAffiche-1 alors
         		tableposition(Table_Facture,TABLESELECT(Table_Facture,j))
         	sinon si TABLESELECT(Table_Facture,j) < TablePosition(Table_Facture) alors
         		tableposition(Table_Facture,TABLESELECT(Table_Facture,j))
         
         	fin
         
         
         
         	hlitrecherche(BonLivraison,Bnumero,table_facture.Bnumero[TABLESELECT(Table_Facture,j)])
         
         	si htrouve(BonLivraison) alors
         
         		hexecuterequete(RequeteBlEtat,hRequêteDéfaut,BONLIVRAISON.BNUMERO)
         		//	iAperçu(i100, "Aperçu écran", Vrai)
         		si selecteurdoc = 1 alors
         			iconfigure(sansespace(imprimantepdf),vrai)
         			iParamètre("DEFAUT=NON")
         			iParamètre("QUALITE=HAUTE")
         			ifenetreabandon(faux)
         			selon gFormatFacture
         				cas 1
         					iimprimeetat(laFactureNovy,vrai,BONLIVRAISON.BNUMERO)
         				cas 2
         //					iapercu(0,"Facture 123456")
         					iimprimeetat(facturetrn,vrai,BONLIVRAISON.BNUMERO)
         
         			fin
         //			iimprimeetat(FactureTRN,vrai,BONLIVRAISON.BNUMERO)
         			Table_Facture.transfere[TABLESELECT(Table_Facture,j)] = 3
         
         			sablier(vrai)
         			multitache(500)
         			frenomme(sansespace(config.DossierFichierPDF),...
         			fExtraitChemin(config.DossierFichierPDF, fDisque+fRépertoire)+"Facture"+BonLivraison.Bfacture+".pdf")
         			ListeFichier+=fExtraitChemin(config.DossierFichierPDF, fDisque+fRépertoire)+"Facture"+BonLivraison.Bfacture+".pdf"+";"
         			ListeNoFacture+=sansespace(BonLivraison.bfacture)+","
         
         		sinon
         			iconfigure(sansespace(imprimantepdf),vrai)
         			iParamètre("DEFAUT=NON")
         			iParamètre("QUALITE=HAUTE")
         			ifenetreabandon(faux)
         			selon gFormatFacture
         				cas 1
         					iimprimeetat(BonLivraison)
         				cas 2
         					iimprimeetat(BonLivraisonTRN)
         
         			fin
         //			iimprimeetat(bonlivraison)
         			sablier(vrai)
         			Table_Facture.transfere[TABLESELECT(Table_Facture,j)] = 3
         			multitache(500)
         			frenomme(sansespace(config.DossierFichierPDF),...
         			fExtraitChemin(config.DossierFichierPDF, fDisque+fRépertoire)+"BdeL"+BonLivraison.Bnumero+".pdf")
         			ListeFichier+=fExtraitChemin(config.DossierFichierPDF, fDisque+fRépertoire)+"BdeL"+BonLivraison.Bnumero+".pdf"+";"
         			ListeNoFacture+=sansespace(BonLivraison.bnumero)+","
         		fin
         		//		 Aco_AjoutTrxRcv(fac_entete,fac_detail)
         
         		//majhistorique(fenregistrement[j])
         		multitache(50)
         	fin 
         
         
         
         FIN
         sablier(faux)
         lSujet+=ListeNoFacture[[1 a taille(ListeNoFacture)-1]]
         ouvre(FenEmail,lAdresseCourriel,lSujet,lMessage,ListeFichier,lNumeroClient)
         ExécuteTraitement(HFACTUREFILTRE,trtModification)
         tableselectplus(Table_Facture,1)
        type : 18
      -
        type : 161
        enabled : false
