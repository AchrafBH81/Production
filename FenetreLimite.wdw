  p_codes :
   -
     code : |1+
      txtreq est une chaine
      reqsql est une source de donnees
      ListeAjoute(lmessage,"Aucun Message")
      ListeAjoute(lMessage,"Avertir comptabilité")
      ListeAjoute(lMessage,"Laisser passer jusqu'a une date")
      ListeAjoute(lMessage,"Compte Bloqué")
   -
     code : |1+
      txtreq = "select nom,limiteCredit,soldefacture,TotalCommande,SoldeDisponible,TYpeQuestionCredit,datelimite from client where limitecredit <> 0"
      si HExécuteRequêteSQL(reqsql,hRequêteDéfaut,txtreq) ALORS
      	FichierVersTableMémoire(Table1,reqsql)
      FIN
       
