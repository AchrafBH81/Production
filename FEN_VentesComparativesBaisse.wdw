  -
    name : Btn_Ok
    identifier : 0x2629520b95ef12fe
    internal_properties : 
    properties :
     x : 735
     y : 47
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         
         
         rOtalQuantite		est un réel
         rTotalArgent		est un réel
         sLtypeligne			est une chaîne
         sdReqsql			est une Source de Données
         sdReqsql1			est une Source de Données
         sTxtsql				est une chaîne 
         sLastclient			est une chaîne	= ""
         nLastVendeur		est un entier	= 0
         sLastNomClient		est une chaîne	= ""
         sLresult			est une chaîne	= ""
         rGtotalArgent		est un réel		= 0
         sdatefin			est une chaîne	= datedujour()
         datetempo			est une Date	= datedujour()
         datetempo..jour-=Sai_NbJours
         sDatedebut	est une chaîne	= datetempo
         
         datetempo..Année--
         sDatedebutPrec est une chaine = datetempo
         datetempo..jour+=Sai_NbJours
         sDateFinPrec						est une chaîne	= datetempo
         
         
         sLdatedurapportanneeprec			est une chaîne	=  datetempo..jour-30
         
         sLdatepremierjourmoisanneeprec		est une chaîne	//= PremierJourDuMois(ldatedurapportanneeprec)
         sLdateannee							est une chaîne	//= Gauche(sdatefin,4)
         sLdateanneeprec						est une chaîne	//= Gauche(ldatedurapportanneeprec,4)
         lmois								est une chaîne 
         
         gtabReportDates = [sdatedebut,sdatefin,sDatedebutPrec,sDateFinPrec]
         
         
         POUR i =1 _À_ (Val(Milieu(sdatefin,5,2))-1)
         	lmois+=i+";"
         FIN
         
         Sablier(Vrai)
         
         
         
         
         //HCréation(tempoHisto)
         
         message("Récupération des données de l'année en cours")
         RequeteHistoFactureDateParVendeur.bdateDebut	= sDatedebut
         RequeteHistoFactureDateParVendeur.bDateFin		= sdatefin
         HExécuteRequête(RequeteHistoFactureDateParVendeur)
         gtabSales.SupprimeTout()
         stCurrentSale	est un stsales
         nResult			est un entier
         
         POUR TOUT RequeteHistoFactureDateParVendeur 
         	
         	stCurrentSale							= allouer un STSales()
         	stCurrentSale.moSalesCurrentYear		= RequeteHistoFactureDateParVendeur.la_somme_BStotal
         	stCurrentSale.sCustomerNumber			= SansEspace(RequeteHistoFactureDateParVendeur.Bclient)
         	stCurrentSale.sCustomerName				= RequeteHistoFactureDateParVendeur.nom
         	stCurrentSale.nSalesPersonNumber		= RequeteHistoFactureDateParVendeur.cvendeur
         	stCurrentSale.sSalesPersonName			= RequeteHistoFactureDateParVendeur.nom_Ve
         	gtabSales.ajoute(stCurrentSale)
         FIN
         
         
         message("Récupération des données de l'année précédente")
         RequeteHistoFactureDateParVendeur.bdateDebut	= sDatedebutPrec
         RequeteHistoFactureDateParVendeur.bDateFin		= sDateFinPrec
         HExécuteRequête(RequeteHistoFactureDateParVendeur)
         POUR TOUT RequeteHistoFactureDateParVendeur 
         	nResult = gtabSales.Cherche(tcLinéaire,"sCustomerNumber",sansespace(RequeteHistoFactureDateParVendeur.Bclient))
         	
         	SI  nresult <> -1  ALORS
         		
         		gtabSales[nresult].moSalesLastYear	= RequeteHistoFactureDateParVendeur.la_somme_BStotal
         		gtabsales[nResult].moGap			= (gtabSales[nResult].moSalesLastYear-gtabSales[nResult].moSalesCurrentYear) * -1
         		si gTabSales[nResult].moSalesLastYear <> 0 alors
         			gtabSales[nresult].rGapPercentage	= gtabSales[nResult].moGap / 	gtabSales[nResult].moSalesLastYear //* 100	
         		sinon
         			gTabSales[nResult].rGapPercentage = -1
         		FIN
         		
         		
         	SINON
         		stCurrentSale							= allouer un STSales()
         		stCurrentSale.moSalesLastYear			= RequeteHistoFactureDateParVendeur.la_somme_BStotal
         		stCurrentSale.sCustomerNumber			= SansEspace(RequeteHistoFactureDateParVendeur.Bclient)
         		stCurrentSale.sCustomerName				= RequeteHistoFactureDateParVendeur.nom
         		stCurrentSale.sSalesPersonName			= RequeteHistoFactureDateParVendeur.nom_Ve
         		stCurrentSale.nSalesPersonNumber		= RequeteHistoFactureDateParVendeur.cvendeur
         		stcurrentsale.moGap						= RequeteHistoFactureDateParVendeur.la_somme_BStotal * -1
         		stcurrentsale.rGapPercentage			= -1 //* 100	
         		gtabSales.Ajoute(stCurrentSale)
         	FIN
         FIN
         
         Message("Triage des données en cours .........")
         
         gTabFinalSales = gtabsales.filtre(Callback)
         gTabFinalSales.Trie(ttMembre,"nSalesPersonNumber;sCustomerName")
         Sablier(Faux)
         SI SélecteurDestination = 1 ALORS
         	iAperçu()
         FIN
         
         iImprimeEtat(EBaisseClientParVendeur,datedujour(),Combo_Vendeur = "0" ? 0 SINON Combo_Vendeur,gTabFinalSales,gtabReportDates)
         
         
         
         
         
         
         
         
         	procédure interne Callback(stCurrentSales est un stsales) : booléen
         		
         		si stcurrentsales.rGapPercentage <= (Sai_pourcentage / 100 * -1 ) alors 
         			si Combo_Vendeur = 0 alors
         				renvoyer vrai
         			sinon
         				si stCurrentSales.nSalesPersonNumber = Combo_Vendeur alors renvoyer vrai
         			FIN
         			
         		FIN
         		renvoyer faux
         		
         		
         	fin
        type : 18
      -
        type : 161
        enabled : false
