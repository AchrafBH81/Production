 controls : []
 code_elements :
  type_code : 13
  p_codes :
   -
     code : |1+
      procedure EGroupShippingBill(_NbCopies = 1,param2="",param3="",param4="")
      tableaucarrelage est un tableau dynamique
      tableaucarrelage = allouer un tableau de 0 par 5 chaine
      dimensiontableaucarrelage est un entier = 0
      calculligne est un entier = 0
      gnNbThermosByOrder est un entier = 0
      AncienNumCommande est un entier = 99999999
      AncienNumCarrelage est une chaine = ""
      ldebut est un booleen = vrai
      lnombrethermos est un entier
      ltypeligne est une chaine
      OldOrderNumber est un entier = ""
      
      hlit(config,1)
      
      
      iNumPage(1)
      
      //EGroupShippingBill.NbCopie = _NbCopies
     type : 327680
  procedures :
   -
     name : Rupturefdcomm
     procedure_id : 1842580016705726101
     type_code : 14
     code : |1+
      Procédure Rupturefdcomm()
      
      
      
     type : 458752
   -
     name : assigneLibelle
     procedure_id : 1842580016705791637
     type_code : 14
     code : |1+
      Procédure assigneLibelle()
      i est un entier
      
      lTableauLibelle est un tableau de  30 chaines
      lTableauLibelle[1]  = "blentete"
      lTableauLibelle[2]  = "facpage"
      lTableauLibelle[3]  = "facpagede"
      lTableauLibelle[4]  = "blnoShippingbill"
      lTableauLibelle[5]  = "facdate"
      lTableauLibelle[6]  = "facnumcommande"
      lTableauLibelle[7]  = "facjobdetail"
      lTableauLibelle[8]  = "facquantite"
      lTableauLibelle[9]  = "faclargeur"
      lTableauLibelle[10] = "fachauteur"
      lTableauLibelle[11] = "facdescription"
      //lTableauLibelle[12] = "facfini"
      //lTableauLibelle[13] = "facspacer"
      //lTableauLibelle[14] = "faccarrelage"
      lTableauLibelle[15] = "facrecupar"
      //lTableauLibelle[16] = "facnumlot"
      lTableauLibelle[17] = "vendua"
      lTableauLibelle[18] = "livrea"
      //lTableauLibelle[19] = "votrecommande"
      //lTableauLibelle[20] = "notrereference"
      lTableauLibelle[21] = "NbThermos"
      lTableauLibelle[22] = "NbGrill"
      //lTableauLibelle[23] = "votrereference" 
      
      
      
      selon client.CLangue
      	cas 0,1
      		pour i = 1 a 30
      			si hlitrecherche(Traduction,TRecherche,lTableauLibelle[i]) alors
      				{"EGroupShippingBill."+lTableauLibelle[i]} = traduction.dFrancais
      			fin
      		FIN
      
      	cas 2
      		pour i = 1 a 30
      			si hlitrecherche(Traduction,TRecherche,lTableauLibelle[i]) alors
      				{"EGroupShippingBill."+lTableauLibelle[i]} = traduction.danglais
      			fin
      		FIN
      fin
      
      //EGroupShippingBill.Facnumlot1 = EGroupShippingBill.facnumlot
      EGroupShippingBill.Facnumcommande1 = EGroupShippingBill.facnumcommande
      EGroupShippingBill.Facjobdetail1 = EGroupShippingBill.Facjobdetail
      EGroupShippingBill.Facquantite1 = EGroupShippingBill.Facquantite
      //EGroupShippingBill.Faclargeur1 = EGroupShippingBill.faclargeur
      //EGroupShippingBill.Fachauteur1 = EGroupShippingBill.fachauteur
      EGroupShippingBill.Facdescription1 = EGroupShippingBill.Facdescription
      //EGroupShippingBill.Facfini1 = EGroupShippingBill.facfini
      //EGroupShippingBill.Facspacer1 = EGroupShippingBill.facspacer
      //EGroupShippingBill.Faccarrelage1 = EGroupShippingBill.Faccarrelage
      //EGroupShippingBill.Facnorack1 = EGroupShippingBill.Facnorack
      EGroupShippingBill.blentete1 = EGroupShippingBill.blentete
      //EGroupShippingBill.Facpage1 = EGroupShippingBill.Facpage
      //EGroupShippingBill.Facpagede1 = EGroupShippingBill.Facpagede
      EGroupShippingBill.BlnoBonLivraison1 = EGroupShippingBill.Blnobonlivraison
      EGroupShippingBill.Facdate1 = EGroupShippingBill.Facdate
      //EGroupShippingBill.VotreCommande1 =EGroupShippingBill.VotreCommande
      //EGroupShippingBill.NotreReference1 = EGroupShippingBill.NotreReference
      //EGroupShippingBill.votreReference1 = EGroupShippingBill.votreReference
     type : 458752
  procedure_templates : []
  property_templates : []
