    properties :
     width : 215.9
     height : 70.645
     width : 215.9
     height : 70.645
    code_elements :
     type_code : 30
     p_codes :
      -
        code : |1+
         hlitrecherche(client,numero,reqgroupShippingBill.bclient)
         si client.IDHeuresOuverture <> 0 alors
         	si hlitrecherche(HeuresOuverture,IDHeuresOuverture,client.IDHeuresOuverture) alors
         		SELON Client.CLangue
         			CAS 0,1
         				SI HLitRecherche(Traduction,trecherche,"libheureouverture") ALORS
         					EGroupShippingBill.libheureouverture = Traduction.dfrancais + " " + HeuresOuverture.HODescription
         				FIN
         			cas 2
         				SI HLitRecherche(Traduction,trecherche,"libheureouverture") ALORS
         					EGroupShippingBill.LibHeureOuverture = Traduction.danglais + " " + HeuresOuverture.HODescription
         				FIN
         		fin		
         //		LibHeureOuverture = "Heures d'ouverture :"+ HeuresOuverture.HODescription
         	FIN
         FIN
         
         assigneLibelle()
         
         si reqgroupShippingBill.lnom <> "" alors
         	NomClient2 = reqgroupShippingBill.lNom
         	AdresseClient1 = reqgroupShippingBill.lRue
         	VilleClient1 = reqgroupShippingBill.lVille
         	CodePostalClient1 = reqgroupShippingBill.lCodePostal	
         sinon
         	NomClient2 = "  M Ê M E / S A M E  "
         	AdresseClient1 = ""
         	VilleClient1 = ""
         	CodePostalClient1 = ""
         	TelephoneClient1 = ""	
         	
         FIN
         
         //si reqgroupShippingBill.idlivraison <> 0 alors
         //	si hlitrecherche(ClientLivraison,IDClientLivraison,reqgroupShippingBill.idlivraison) alors
         //		nomclient2 = ClientLivraison.lNom
         //		adresseclient1 = ClientLivraison.lRue
         //		VilleClient1 = ClientLivraison.lVille+","+ClientLivraison.lprovince
         //		CodePostalClient1 = ClientLivraison.lCodePostal	
         //		TelephoneClient1 = clientlivraison.ltelephone
         //	FIN
         //sinon
         //	nomclient2 = "  M Ê M E / S A M E  "
         //	adresseclient1 = ""
         //	VilleClient1 = ""
         //	CodePostalClient1 = ""
         //	TelephoneClient1 = ""	
         //FIN
         si sansespace(reqgroupShippingBill.fnopeinture) = "" alors
         	grppeinture..visible = faux
         	
         sinon
         	CCouleurPeinture = reqgroupShippingBill.fnopeinture
         	Cdescpeinture = reqgroupShippingBill.fdescpeinture
         	CCouleurPeinture2 = reqgroupShippingBill.fnopeinture
         	Cdescpeinture2 = reqgroupShippingBill.fdescpeinture
         	si reqgroupShippingBill.ftypepeinture1 = 1 alors
         		libelle10 = "Peinture extérieure:"
         		libelle12 = "Peinture extérieure:"
         		
         	FIN
         FIN
         si SansEspace(reqgroupShippingBill.fnopeinture1) <> "" alors
         	CCouleurPeinture1 = reqgroupShippingBill.fnopeinture1
         	Cdescpeinture1 = reqgroupShippingBill.fdescpeinture1
         	CCouleurPeinture3 = reqgroupShippingBill.fnopeinture1
         	Cdescpeinture3 = reqgroupShippingBill.fdescpeinture1
         	libelle10 = "Peinture extérieure:"
         	libelle12 = "Peinture extérieure:"
         	GrpPeintureInt..visible = vrai
         sinon
         	GrpPeintureInt..visible = faux    
         FIN
        type : 327692
      -
        code : |1+
         
         
        type : 327693
      -
        type : 327697
        enabled : false
