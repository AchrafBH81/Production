         	si gnNbThermosByOrder <> 0 alors
         		iImprimeBloc(iNbThermosByOrder)
         	FIN
         	iImprimeBloc(iOrderHeader)
         	OldOrderNumber = LIB_OrderNumber
         FIN
         
         ////************** Nouveau code ***************************
         
         	calculligne++
         	si reqgroupShippingBill.fdcarreauv _et_  reqgroupShippingBill.fdcarreauh = 0 alors
         		libelle6 = ""
         	sinon
         		libelle6 = "X"	
         	FIN
         	si reqgroupShippingBill.ftype = 1 alors
         		lTypeLigne = "Verre"
         		cnombrethermos +=  reqgroupShippingBill.fdqteafacturer
         		gnNbThermosByOrder+=ReqGroupShippingBill.fdqteafacturer
         	sinon si reqgroupShippingBill.ftype = 2 
         		si pas reqgroupShippingBill.fdverreunite alors
         			lTypeLigne = "Unite"
         		sinon
         			lTypeLigne = "Verre"
         		fin
         	sinon si reqgroupShippingBill.ftype = 4
         		CNombreThermosCarrelage +=  reqgroupShippingBill.fdqteafacturer
         		ltypeligne = "Carrelage" 
         	sinon si reqgroupShippingBill.ftype = 5
         		ltypeligne = "Peinture" 
         	fin
         	
         	selon lTypeLigne
         		cas "Unite"
         			CORPS..VISIBLE = VRAI
         		cas "Verre"	
         			corps..visible = vrai
         
         
         		cas "Carrelage"
         			corps..visible = faux
         			iImprimeBloc(ITERATION1)
         		cas "Peinture"
         			corps..visible = faux
         			iImprimeBloc(ITERATION2)
         	fin
         
         SlotNumber = ""
         
         sTxtreqsqlTop est un chaine = [
         select top 1 racking.LineNumber,Racking.RackNumber from racking where racking.ordernumber = {pOrderNumber} and racking.OrderDetailLine = {pLineNumber} order by linenumber
         ]
         
         sTxtreqsqlBottom est un chaine = [
         select bottom 1 racking.LineNumber from racking where racking.ordernumber = {pOrderNumber} and racking.OrderDetailLine = {pLineNumber} order by linenumber
         ]
         
         
         
         sdReqSqlTop est une source de donnees
         sdReqSqlBottom est une source de donnees
         sdReqSqlTop.pOrderNumber	= remplace(Noreference," ","")
         sdReqSqlTop.plineNumber	= DetailLineNumber
         sdReqSqlBottom.pOrderNumber	= Remplace(Noreference," ","")
         sdReqSqlBottom.plineNumber	= DetailLineNumber
         sTopLineNumber est une chaine = ""
         sBottomLineNumber est une chaine = ""
         
         
         
         si hexecuterequetesql(sdReqSqlTop,hRequêteDéfaut,sTxtreqsqlTop) alors
         	si hnbenr(sdReqSqlTop) <> 0 alors
         		hlit(sdReqSqlTop,1)
         		sTopLineNumber = sdReqSqlTop.LineNumber
         	FIN
         FIN
         
         SI HExécuteRequêteSQL(sdReqSqlBottom,hRequêteDéfaut,sTxtreqsqlBottom) ALORS
         	SI HNbEnr(sdReqSqlBottom) <> 0 ALORS
         		HLit(sdReqSqlBottom,1)
         		sBottomLineNumber = sdReqSqlBottom.LineNumber
         	FIN
         FIN
         
         si sTopLineNumber <> "" _et_ sBottomLineNumber <> "" alors
         	si sTopLineNumber = sBottomLineNumber alors
         		SlotNumber = (sTopLineNumber = 0 ? "" sinon sTopLineNumber )
         	sinon
         		SlotNumber = sTopLineNumber + "-"+ sBottomLineNumber	
         	FIN
         FIN
         
         si hlitrecherche(CustomerrackNumber,RackdateCurrentRackNumber,[reqgroupShippingBill.fadate,sdReqSqlTop.RackNumber]) alors
         	slotnumber =  CustomerrackNumber.NewRackNumber +" / " + slotnumber
         //	LIB_RackNumber = CustomerrackNumber.NewRackNumber
         SINON
         	SlotNumber = sdReqSqlTop.RackNumber +" / " + SlotNumber
         //		LIB_RackNumber = sdReqSqlTop.RackNumber
         		
         FIN
         
         
         
         
         
        type : 327692
      -
        code : |1+
         si reqgroupShippingBill.ftype <> 4 alors
         	si pas sansespace(reqgroupShippingBill.fdforme) = "" alors
         		calculligne++
         		iImprimeBloc(ITERATION5)
         	FIN
         	si pas sansespace(reqgroupShippingBill.fnotes) = "" alors
         		calculligne++
         		iImprimeBloc(ITERATION3)
         	FIN
         	si pas sansespace(reqgroupShippingBill.fnotes1) = "" alors
         		calculligne++
         		iImprimeBloc(ITERATION4)
         	FIN
         sinon
         	si reqgroupShippingBill.fpeinture alors
         		calculligne++
         		iImprimeBloc(ITERATION6)	
         	FIN
         
         fin
        type : 327693
      -
        type : 327697
        enabled : false
