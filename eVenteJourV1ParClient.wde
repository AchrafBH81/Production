     width : 269.4
     height : 3.44000000000003
    code_elements :
     type_code : 30
     p_codes :
      -
        code : |1+
         //QteCarr7 = requetedetailunjourv1.fanocommande
         //numprodcarr1 = requetedetailunjourv1.fp
         qtecarr9 = requetedetailunjourv1.fdqte
         qtecarr28 = requetedetailunjourv1.fdcarreauv
         qtecarr64 = requetedetailunjourv1.fdcarreauh
         qtecarr65 = requetedetailunjourv1.fdcarreauv * requetedetailunjourv1.fdcarreauh
         PrixUnitCarr1 = requetedetailunjourv1.fPrixCarreauPeinture
         TotalCarr1 =qtecarr65 * PrixUnitCarr1 * qtecarr9
         selon requetedetailunjourv1.fTypePeinture
         	cas 2
         		DescriptionPeinture = "Peint.TLT" + requetedetailunjourv1.fNoPeintureExtTout + " " + sansespace(requetedetailunjourv1.fdescpeintureExtTout)
         	cas 1
         		DescriptionPeinture = "Peint. ext." + requetedetailunjourv1.fNoPeintureExtTout + " " + sansespace(requetedetailunjourv1.fdescpeintureExtTout)
         FIN
        type : 327692
      -
        code : |1+
         
         si sansespace(requetedetailunjourv1.FnopeintureInterieure) <> "" alors
         	iImprimeBloc(ITERATION8)
         fin
         
        type : 327693
      -
        type : 327697
        enabled : false
