    properties :
     y : 63.392
     width : 269.4
     height : 3.969
    code_elements :
     type_code : 30
     p_codes :
      -
        code : |1-
         
        type : 327694
      -
        code : |1+
         
         //// ****************** Nouveau code ****************************
         
         j est un entier
         indicecarr est un entier
         carrtrouve est un booleen = faux//A FAIRE :
         carrnogl est une chaine
         si requetedetailunjourv1.ftype = 1 alors
         	lTypeLigne = "Verre"
         sinon si requetedetailunjourv1.ftype = 2 
         	si pas requetedetailunjourv1.fdverreunite alors
         		lTypeLigne = "Unite"
         	sinon
         		lTypeLigne = "Verre"
         	fin
         sinon si requetedetailunjourv1.ftype = 3
         	ltypeligne = "Fourniture" 
         sinon si requetedetailunjourv1.ftype = 4
         	ltypeligne = "Carrelage" 
         sinon si requetedetailunjourv1.ftype = 5
         	ltypeligne = "Peinture" 
         fin
         
         //si requetedetailunjourv1.ftype = 4 alors
         //	corps..visible = faux
         //sinon
         
         
         selon lTypeLigne
         	cas "Unite"
         	//	CORPS..VISIBLE = VRAI
         		rubrique17 = requetedetailunjourv1.fdprixu
         		rubrique16 = 1
         		//		rubrique16..visible = faux
         	cas "Verre"	
         //		corps..visible = vrai
         		//		rubrique16..visible = vrai
         	cas "Carrelage"
         //		corps..visible = faux
                 iImprimeBloc(ITERATION1)
         	cas "Peinture"
         //		corps..visible = faux
         		iImprimeBloc(ITERATION2)
         fin
         
         
         
         
         
         //	si pas facturereimpression alors
         //		remplir_tableau(rubrique21,arrondi(rubrique4 * (rubrique16 * rubrique17),2))
         //	FIN
         
         //	totalpage +=  arrondi(requetedetailunjourv1.fdqte * requetedetailunjourv1.fdpiedcarrefacture * requetedetailunjourv1.fdprixupiedfacture,2)
         //	totalfacture +=  arrondi(requetedetailunjourv1.fdqte * requetedetailunjourv1.fdpiedcarrefacture * requetedetailunjourv1.fdprixupiedfacture,2)
         
         
         selon lTypeLigne
         	cas "Unite"
         		//		FIN
         		//		si requetedetailunjourv1.ftype = 2 et pas requetedetailunjourv1.fdverreunite alors
         		totalpage +=  arrondi(requetedetailunjourv1.fdqteafacturer * requetedetailunjourv1.fdprixu,2)
         		totalfacture +=  arrondi(requetedetailunjourv1.fdqteafacturer * requetedetailunjourv1.fdprixu,2)
         	cas "Fourniture"
         //		totalpage +=  arrondi(requetebletat.fdqte * requetebLETAT.fdprixupied,2)
         		totalfacture +=  arrondi(requetedetailunjourv1.fdqteafacturer * RequeteDetailUnJourV1.fdprixupied,2)
         
         
         	cas "Verre"
         		//sinon
         //		totalpage +=  arrondi(requetedetailunjourv1.fdqte * ((requetedetailunjourv1.fdpiedcarrefacture * requetedetailunjourv1.fdprixupiedfacture) + ...
         //		requetedetailunjourv1.fdextraforme),2)
         		totalfacture +=  arrondi(requetedetailunjourv1.fdqteafacturer * (requetedetailunjourv1.fdpiedcarrefacture * requetedetailunjourv1.fdprixupiedfacture),2)+ ...
         		arrondi(requetedetailunjourv1.fdqteafacturer *requetedetailunjourv1.fdextraforme,2)+arrondi(requetedetailunjourv1.fdqteafacturer *requetedetailunjourv1.FDextra10X,2)+...
         		arrondi(requetedetailunjourv1.fdqteafacturer *requetedetailunjourv1.FDextra5x,2)
         
         //		totalfacture +=  arrondi(requetedetailunjourv1.fdqte * ((requetedetailunjourv1.fdpiedcarrefacture * requetedetailunjourv1.fdprixupiedfacture)+ ...
         //		requetedetailunjourv1.fdextraforme),2)
         
         		totalthermos+=requetedetailunjourv1.fdqteafacturer 
         
         		totalsurcharge += arrondi(requetedetailunjourv1.surchargeenergie,2) //* requetedetailunjourv1.fdqteafacturer / requetedetailunjourv1.fdqte
         		totalcap+= arrondi(requetedetailunjourv1.FDExtraCap * requetedetailunjourv1.fdqteafacturer,2)
         
         
         
         	cas "Carrelage"
         		//		FIN
         		//		si requetedetailunjourv1.ftype = 2 et pas requetedetailunjourv1.fdverreunite alors
         		totalpage +=  arrondi(requetedetailunjourv1.fdcarrprixtotal+requetedetailunjourv1.fTotalPeinture,2)
         
         		totalfacture +=  arrondi((requetedetailunjourv1.frcarrprixu + requetedetailunjourv1.fdcarrprixdebase)* requetedetailunjourv1.fdqteafacturer,2)...
         		+arrondi(((requetedetailunjourv1.Ftotalcarreaupeinture*requetedetailunjourv1.fPrixCarreauPeinture)...
         		+(requetedetailunjourv1.FDnbcarreauPeinture1*requetedetailunjourv1.fdprixcarreaupeinture1))...
         		* requetedetailunjourv1.fdqteafacturer ,2)
         
         
         //		totalfacture +=  arrondi(requetedetailunjourv1.fdcarrprixtotal+requetedetailunjourv1.fTotalPeinture,2)
         		//		AlimenteHistoriqueProduit(sansespace(client.numero),requetedetailunjourv1.BDateFacture,2,requetedetailunjourv1.fdnumprod,"","","", arrondi(requetedetailunjourv1.fdqte * requetedetailunjourv1.fdprixu,2),...
         		//		requetedetailunjourv1.surchargeenergie,requetedetailunjourv1.fddesc,requetedetailunjourv1.fdqte)
         		totalcarrelage+=requetedetailunjourv1.fdqteafacturer * requetedetailunjourv1.fdcarreauh * requetedetailunjourv1.fdcarreauv
         
         	cas "Peinture"
         		//		FIN
         		//		si requetedetailunjourv1.ftype = 2 et pas requetedetailunjourv1.fdverreunite alors
         		totalpage +=  arrondi(requetedetailunjourv1.fdprixtotal,2)
         		totalfacture +=  arrondi(requetedetailunjourv1.fdqteafacturer * (requetedetailunjourv1.fdpiedcarrefacture * requetedetailunjourv1.fdprixupied),2)
         //		totalfacture +=  arrondi(requetedetailunjourv1.fdprixtotal,2)
         		totaldepeinture+= arrondi(requetedetailunjourv1.fdprixtotal,2) * requetedetailunjourv1.fdqteafacturer / requetedetailunjourv1.fdqte
         		//		AlimenteHistoriqueProduit(sansespace(client.numero),requetedetailunjourv1.BDateFacture,2,requetedetailunjourv1.fdnumprod,"","","", arrondi(requetedetailunjourv1.fdqte * requetedetailunjourv1.fdprixu,2),...
         		//		requetedetailunjourv1.surchargeenergie,requetedetailunjourv1.fddesc,requetedetailunjourv1.fdqte)
         	
         fin
         
         
         
         
         
         
         
         
         
         
        type : 327692
      -
        code : |1+
         si requetedetailunjourv1.ftype <> 4 alors
         
         
         
         
         	si pas sansespace(requetedetailunjourv1.fnotes) = ""  ou requetedetailunjourv1.fdextraforme <> 0 ALORS
         
         		iImprimeBloc(ITERATION3)	
         		//  totalpage +=  totalextraforme
         		//  totalfacture +=  totalextraforme
         	FIN
         	si pas sansespace(requetedetailunjourv1.fnotes1) = ""   ALORS
         
         		iImprimeBloc(ITERATION5)	
         		//  totalpage +=  totalextraforme
         		//  totalfacture +=  totalextraforme
         	FIN
         sinon
         	si requetedetailunjourv1.fpeinture alors
         
         		iImprimeBloc(ITERATION6)	
         
         	FIN
         fin
         
        type : 327693
      -
        type : 327697
        enabled : false
