 controls : []
 code_elements :
  type_code : 13
  p_codes :
   -
     code : |1+
      procedure etransfertfacture(ldatedebut="",ldatefin="",lunclient=faux)
      
      i est un entier = 1
      
      
      si lunclient alors
      	FIN_DOCUMENT..visible = faux
      FIN
      
     type : 327680
