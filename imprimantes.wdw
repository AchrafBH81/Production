  procedures :
   -
     name : ecritimprimanteini
     procedure_id : 4511921491623035124
     type_code : 14
     code : |1+
      Procédure ecritimprimanteini()
      
      iniecrit("imprimante","facture",imprimantes.ifacture[imprimantes.ifacture],repencours+"production.ini")
      iniecrit("imprimante","rapport",imprimantes.irapport[imprimantes.irapport],repencours+"production.ini")
      iniecrit("imprimante","etiquette",imprimantes.ietiquette[imprimantes.ietiquette],repencours+"production.ini")
      iniecrit("imprimante","confirmation",imprimantes.iconfirmation[imprimantes.iconfirmation],repencours+"production.ini")
      iniecrit("imprimante","carrelage",imprimantes.icarrelage[imprimantes.icarrelage],repencours+"production.ini")
      iniecrit("imprimante","pdf",imprimantes.ipdf[imprimantes.ipdf],repencours+"production.ini")
      INIEcrit("imprimante","bon",imprimantes.IBDL[imprimantes.IBDL],repencours+"production.ini")
      INIEcrit("imprimante","fax",imprimantes.IFAX[imprimantes.IFAX],repencours+"production.ini")
      INIEcrit("imprimante","ftravail",imprimantes.IFTRAVAIL[imprimantes.IFTRAVAIL],repencours+"production.ini")
      INIEcrit("imprimante","achat",imprimantes.IACHAT[imprimantes.IACHAT],repencours+"production.ini")
      
      
     type : 458752
  procedure_templates : []
  property_templates : []
