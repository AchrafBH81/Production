      -
        code : |1+
         restaure_bouton()
         //ecranversfichier
         //hmodifie("config")
         ecritimprimanteini()
         imprimanterapport   = imprimantes.irapport[imprimantes.irapport]
         imprimantefacture   = imprimantes.ifacture[imprimantes.ifacture]
         imprimanteetiquette = imprimantes.ietiquette[imprimantes.ietiquette]
         imprimantecarrelage = imprimantes.icarrelage[imprimantes.icarrelage]
         imprimantepdf = imprimantes.ipdf[imprimantes.ipdf]
         imprimanteconfirmation = imprimantes.iConfirmation[imprimantes.iConfirmation]
         imprimanteftravail = imprimantes.IFTRAVAIL[imprimantes.IFTRAVAIL]
         imprimantebon = imprimantes.ibdl[imprimantes.ibdl]
         imprimantefax = imprimantes.IFAX[imprimantes.IFAX]
         imprimanteachat = imprimantes.IACHAT[imprimantes.IACHAT]
         
         //Code WinDev 5.5 remplacé par la migration :
         //bouton..etat = grisé
         bouton..etat = grisé; bouton..Visible=Vrai
         
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_ANNULE
