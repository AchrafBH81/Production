 menu :
  name : _Menu
  identifier : 0x3e9d90b16b744090
  internal_properties : 
  options : []
 languages :
  - fr-FR
 popup_menus : []
 message_bar :
  internal_properties : CQAAAAkAAADCMsSX0/Saexx5MQcb4a0HXPjwHYycrZmntM5YC+4Y1DPEyzRH6xkHDLLYAmX2B1Y+FfeUhjuvfEPob3Su9B64eOpFHZXct9/lhLsjB21U/z7rRRcM9hqviv2eBQ==
 actionbar : {}
 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1+
      
      // Pour compatibilité 5.5
      MoiMême..Visible=Vrai
      
      NOMIMP,CH est une chaine
      i est un entier
      j est un entier
      PORT est une chaine
      hlitpremier("config","COCLEUNIK")
      fichierversecran
      NOMIMP=INILit("Devices")
      
      ch="ZZZ"
      i=1
      
      TANTQUE SansEspace(CH)<>""
      	Ch = ExtraitChaîne(NOMIMP,I,RC)
      	PORT=extraitchaine(inilit("Devices",Ch),2,",")
      	I++
      	SI SansEspace(CH)<>""
      		listeajoute(IFACTURE,CH)	
      		listeajoute(IETIQUETTE,CH)	
      		listeajoute(Iconfirmation,CH)	
      		listeajoute(IRAPPORT,CH)	
      		listeajoute(Icarrelage,CH)	
      		listeajoute(Ipdf,CH)
      		listeajoute(IFTRAVAIL,ch)
      		ListeAjoute(IBDL,CH)
      		ListeAjoute(IFAX,CH)
      		ListeAjoute(IAchat,CH)
      		
      			
      
      	FIN
      FIN
      
      //cherche imprimante facture
      
      j = ListeCherche("ifacture",litimprimantesini("facture"))
      //j = ListeCherche("ifacture",config.imprimantefacture)
      si j<>-1 alors
      	ListeSelectPlus("ifacture",j)
      Fin
      
      //cherche imprimante etiquette
      
      j = ListeCherche("ietiquette",litimprimantesini("etiquette"))
      //j = ListeCherche("ietiquette",config.imprimanteetiquette)
      si j<>-1 alors
      	ListeSelectPlus("ietiquette",j)
      Fin
      j = ListeCherche("iconfirmation",litimprimantesini("confirmation"))
      //j = ListeCherche("ietiquette",config.imprimanteetiquette)
      si j<>-1 alors
      	ListeSelectPlus("iconfirmation",j)
      Fin
      
      //cherche imprimante rapport
      j = ListeCherche("irapport",litimprimantesini("rapport"))
      //j = ListeCherche("irapport",config.imprimanterapport)
      si j<>-1 alors
      	ListeSelectPlus("irapport",j)
      Fin
      
      //cherche imprimante rapport
      j = ListeCherche("icarrelage",litimprimantesini("carrelage"))
      //j = ListeCherche("irapport",config.imprimanterapport)
      si j<>-1 alors
      	ListeSelectPlus("icarrelage",j)
      Fin
      
      //cherche imprimante rapport
      j = ListeCherche(ipdf,litimprimantesini("pdf"))
      //j = ListeCherche("irapport",config.imprimanterapport)
      si j<>-1 alors
      	ListeSelectPlus(ipdf,j)
      Fin
      
      j = ListeCherche(IFTRAVAIL,litimprimantesini("ftravail"))
      //j = ListeCherche("irapport",config.imprimanterapport)
      si j<>-1 alors
      	ListeSelectPlus(IFTRAVAIL,j)
      Fin
      
      j = ListeCherche(Ibdl,litimprimantesini("bon"))
      //j = ListeCherche("irapport",config.imprimanterapport)
      SI j<>-1 ALORS
      	ListeSelectPlus(Ibdl,j)
      FIN
      
      j = ListeCherche(Ifax,litimprimantesini("fax"))
      //j = ListeCherche("irapport",config.imprimanterapport)
      SI j<>-1 ALORS
      	ListeSelectPlus(Ifax,j)
      FIN
      
      j = ListeCherche(IACHAT,litimprimantesini("achat"))
      //j = ListeCherche("irapport",config.imprimanterapport)
      SI j<>-1 ALORS
      	ListeSelectPlus(iACHAT,j)
      FIN
      
   -
     type : 180
