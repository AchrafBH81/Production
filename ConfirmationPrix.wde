         //
         //	fin
         //	calculligne++
         //fin
         
         //// ****************** Nouveau code ****************************
         
         j est un entier
         indicecarr est un entier
         carrtrouve est un booleen = faux//A FAIRE :
         carrnogl est une chaine
         si requeteconfirmationcommande.ftype = 4 alors
         	corps..visible = faux
         sinon
         
         	si requeteconfirmationcommande.ftype = 2 et pas requeteconfirmationcommande.fdverreunite alors
         		CORPS..VISIBLE = VRAI
         		rubrique17 = requeteconfirmationcommande.fdprixu
         		rubrique16 = 1
         		si anciennumcommande <> requeteconfirmationcommande.fdnocomm alors
         
         			si pas anciennumcommande = 0 alors
         				si dimensiontableaucarrelage <> 0 alors
         					pour j = 1 a dimensiontableaucarrelage
         						numprodcarr   = tableaucarrelage[j,1]
         						qtecarr24       = tableaucarrelage[j,2]
         						desccarr      = tableaucarrelage[j,3]
         						prixUnitCarr  = tableaucarrelage[j,4]
         						totalcarr = arrondi(val(qtecarr24) * val(prixunitcarr),2)
         						si hlitrecherche(invent,INUM,numprodcarr) alors
         							carrnogl = invent.ICODEGL
         						sinon
         
         							carrnogl = config.glventedefaut
         						fin	
         						Remplir_tableau_gl(carrnogl,totalcarr)
         						calculligne++
         						iimprimebloc(ITERATION1)
         						totalpage +=  totalcarr
         						totalfacture +=  totalcarr
         					fin
         					dimension(tableaucarrelage,0,5)
         					dimensiontableaucarrelage = 0
         				fin		
         
         			fin
         			si pas ldebut alors
         				calculligne++
         				iimprimebloc(ITERATION2)
         			sinon
         				ldebut = faux
         			fin
         			anciennumcommande = requeteconfirmationcommande.fdnocomm
         			AncienNumcarrelage = ""
         		fin
         
         		//		rubrique16..visible = faux
         	sinon	
         		corps..visible = vrai
         		//		rubrique16..visible = vrai
         		si anciennumcommande <> requeteconfirmationcommande.fdnocomm alors
         
         			si pas anciennumcommande = 0 alors
         				si dimensiontableaucarrelage <> 0 alors
         					pour j = 1 a dimensiontableaucarrelage
         						numprodcarr   = tableaucarrelage[j,1]
         						qtecarr24       = tableaucarrelage[j,2]
         						desccarr      = tableaucarrelage[j,3]
         						prixUnitCarr  = tableaucarrelage[j,4]
         						totalcarr = arrondi(val(qtecarr24) * val(prixunitcarr),2)
         						si hlitrecherche(invent,INUM,numprodcarr) alors
         							carrnogl = invent.ICODEGL
         						sinon
         							carrnogl = config.glventedefaut
         						fin	
         						Remplir_tableau_gl(carrnogl,totalcarr)
         						calculligne++
         						iimprimebloc(ITERATION1)
         						totalpage +=  totalcarr
         						totalfacture +=  totalcarr
         					fin
         					dimension(tableaucarrelage,0,5)
         					dimensiontableaucarrelage = 0
         				fin		
         			fin
         			si pas ldebut alors
         				calculligne++
         				iimprimebloc(ITERATION2)
         			sinon
         				ldebut = faux
         			fin
         			anciennumcommande = requeteconfirmationcommande.fdnocomm
         			AncienNumcarrelage = ""
         		fin
         	fin
         
         
         	si requeteconfirmationcommande.fdcarrelage alors
         
         		//		si AncienNumCarrelage <> requeteconfirmationcommande.fdnumcarr alors
         		//			si dimensiontableaucarrelage <> 0 alors
         		//				pour j = 1 a 1
         		//					numprodcarr   = tableaucarrelage[j,1]
         		//					qtecarr24       = tableaucarrelage[j,2]
         		//					desccarr      = tableaucarrelage[j,3]
         		//					prixUnitCarr  = tableaucarrelage[j,4]
         		//					totalcarr = arrondi(val(qtecarr24) * val(prixunitcarr),2)
         		//					si hlitrecherche(invent,INUM,numprodcarr) alors
         		//						carrnogl = invent.ICODEGL
         		//					sinon
         		//						carrnogl = config.glventedefaut
         		//					fin	
         		//					Remplir_tableau_gl(carrnogl,totalcarr)
         		//					calculligne++
         		//					totalpage +=  totalcarr
         		//					totalfacture +=  totalcarr
         		//					iimprimebloc(ITERATION1)
         		//				fin
         		//				dimension(tableaucarrelage,0,5)
         		//				dimensiontableaucarrelage = 0
         		//			fin
         		//
         		//			AncienNumCarrelage = requeteconfirmationcommande.fdnumcarr
         		//
         		//
         		//		fin
         
         
         
         
         		pour j = 1 a dimensiontableaucarrelage
         			si tableaucarrelage[j,1] = requeteconfirmationcommande.fdnumcarr et val(tableaucarrelage[j,4]) = requeteconfirmationcommande.fdcarrpruxuc alors
         				indicecarr = j
         				carrtrouve = vrai
         			FIN
         		fin
         		si carrtrouve alors
         //			tableaucarrelage[indicecarr,2]=numeriqueverschaine(val(tableaucarrelage[indicecarr,2])+(requeteconfirmationcommande.fdqteafacturer...
         //			* requeteconfirmationcommande.fdcarreauh * requeteconfirmationcommande.fdcarreauv))
                     // modification pour avoir le nombre de carreau exact
                     
         			tableaucarrelage[indicecarr,2]=numeriqueverschaine(val(tableaucarrelage[indicecarr,2])+(requeteconfirmationcommande.fdqteafacturer...
         			* requeteconfirmationcommande.fdnbcarreau))
         
         			//	tableaucarrelage[indicecarr,4]=numeriqueverschaine(val(tableaucarrelage[indicecarr,4])+(requeteconfirmationcommande.fdqteafacturer * ...
         			//	requeteconfirmationcommande.fdcarreauh * requeteconfirmationcommande.fdcarreauv))
         			//	tableaucarrelage[indicecarr,5]=numeriqueverschaine(val(tableaucarrelage[indicecarr,5])+((requeteconfirmationcommande.fdqte-requeteconfirmationcommande.fdqteafacturer)*...
         			//	requeteconfirmationcommande.fdcarreauh * requeteconfirmationcommande.fdcarreauv))
         
         
         
         		sinon
         			si dimensiontableaucarrelage <> 0 alors
         				pour j = 1 a 1
         					numprodcarr   = tableaucarrelage[j,1]
         					qtecarr24       = tableaucarrelage[j,2]
         					desccarr      = tableaucarrelage[j,3]
         					prixUnitCarr  = tableaucarrelage[j,4]
         					totalcarr = arrondi(val(qtecarr24) * val(prixunitcarr),2)
         					si hlitrecherche(invent,INUM,numprodcarr) alors
         						carrnogl = invent.ICODEGL
         					sinon
         						carrnogl = config.glventedefaut
         					fin	
         					Remplir_tableau_gl(carrnogl,totalcarr)
         					calculligne++
         					totalpage +=  totalcarr
         					totalfacture +=  totalcarr
         					iimprimebloc(ITERATION1)
         				fin
         				dimension(tableaucarrelage,0,5)
         				dimensiontableaucarrelage = 0
         			fin
         
         			AncienNumCarrelage = requeteconfirmationcommande.fdnumcarr
         
         			dimensiontableaucarrelage++
         			dimension(tableaucarrelage,dimensiontableaucarrelage,5)
         			tableaucarrelage[dimensiontableaucarrelage,1] = requeteconfirmationcommande.fdnumcarr
         			hlitrecherche(invent,INUM,requeteconfirmationcommande.fdnumcarr)
         			si htrouve(invent) alors
         				tableaucarrelage[dimensiontableaucarrelage,3] = client.clangue = 1 ? invent.IDESC   sinon invent.idesca
         			FIN
         //			tableaucarrelage[dimensiontableaucarrelage,2]=numeriqueverschaine(requeteconfirmationcommande.fdqteafacturer * ...	
         //			requeteconfirmationcommande.fdcarreauh * requeteconfirmationcommande.fdcarreauv,"5.2f")
         
         
         //           pour avoir le nombre exact de carreau
         
         			tableaucarrelage[dimensiontableaucarrelage,2]=numeriqueverschaine(requeteconfirmationcommande.fdqteafacturer * ...	
         			requeteconfirmationcommande.fdnbcarreau,"5.2f")
         			
         //
         
         			tableaucarrelage[dimensiontableaucarrelage,4]=numeriqueverschaine(requeteconfirmationcommande.fdcarrpruxuc,"5.2f")
         
         
         			//tableaucarrelage[dimensiontableaucarrelage,5]=numeriqueverschaine((requeteconfirmationcommande.fdqte-requeteconfirmationcommande.fdqteafacturer) * ...
         			//requeteconfirmationcommande.fdcarreauh * requeteconfirmationcommande.fdcarreauv)
         
         
         
         		fin
         	fin
         	//	si pas facturereimpression alors
         	//		remplir_tableau(rubrique21,arrondi(rubrique4 * (rubrique16 * rubrique17),2))
         	//	FIN
         
         	//	totalpage +=  arrondi(requeteconfirmationcommande.fdqteafacturer * requeteconfirmationcommande.fdpiedcarrefacture * requeteconfirmationcommande.fdprixupiedfacture,2)
         	//	totalfacture +=  arrondi(requeteconfirmationcommande.fdqteafacturer * requeteconfirmationcommande.fdpiedcarrefacture * requeteconfirmationcommande.fdprixupiedfacture,2)
         
         	si requeteconfirmationcommande.ftype = 2 et pas requeteconfirmationcommande.fdverreunite alors
         		totalpage +=  arrondi(requeteconfirmationcommande.fdqteafacturer * requeteconfirmationcommande.fdprixu,2)
         		totalfacture +=  arrondi(requeteconfirmationcommande.fdqteafacturer * requeteconfirmationcommande.fdprixu,2)
         	sinon
         				totalpage +=  arrondi(requeteconfirmationcommande.fdqteafacturer * ((requeteconfirmationcommande.fdpiedcarrefacture * requeteconfirmationcommande.fdprixupiedfacture) + ...
         				requeteconfirmationcommande.fdextraforme),2)
         				totalfacture +=  arrondi(requeteconfirmationcommande.fdqteafacturer * ((requeteconfirmationcommande.fdpiedcarrefacture * requeteconfirmationcommande.fdprixupiedfacture)+ ...
         				requeteconfirmationcommande.fdextraforme),2)
         
         //		totalpage +=  arrondi(requeteconfirmationcommande.fdqteafacturer * requeteconfirmationcommande.fdpiedcarrefacture * requeteconfirmationcommande.fdprixupiedfacture,2) + ...
         //		arrondi(requeteconfirmationcommande.fdqteafacturer * requeteconfirmationcommande.fdextraforme,2)
         //		totalfacture +=  arrondi(requeteconfirmationcommande.fdqteafacturer * requeteconfirmationcommande.fdpiedcarrefacture * requeteconfirmationcommande.fdprixupiedfacture,2) + ...
         //		arrondi(requeteconfirmationcommande.fdqteafacturer * requeteconfirmationcommande.fdextraforme,2)
         
         
         		totalsurcharge += arrondi(requeteconfirmationcommande.surchargeenergie,2)
         		totalcap+= arrondi(requeteconfirmationcommande.FDExtraCap * requeteconfirmationcommande.fdqteafacturer,2)
         
         
         
         	fin
         	calculligne++
         fin
         
         
         
         
         
        type : 327692
      -
        code : |1+
         si requeteconfirmationcommande.ftype <> 4 alors
         
         	si pas facturereimpression alors
         		si requeteconfirmationcommande.ftype <> 4 alors
         			SI requeteconfirmationcommande.FDExtraCap <> 0 ALORS
         				remplir_tableau(rubrique21,arrondi(rubrique18,2) - (arrondi(requeteconfirmationcommande.FDExtraCap,2) * requeteconfirmationcommande.fdqteafacturer))
         				remplir_tableau(CONFIG.CapGL,arrondi(requeteconfirmationcommande.FDExtraCap,2) * requeteconfirmationcommande.fdqteafacturer)
         			SINON
         				remplir_tableau(rubrique21,arrondi(rubrique18,2))
         			FIN
         		fin
         	FIN
         
         
         
         	si pas sansespace(requeteconfirmationcommande.fnotes) = ""  ou requeteconfirmationcommande.fdextraforme <> 0 ALORS
         		calculligne++
         		iImprimeBloc(ITERATION3)	
         		//  totalpage +=  totalextraforme
         		//  totalfacture +=  totalextraforme
         	FIN
         	si pas sansespace(requeteconfirmationcommande.fnotes1) = ""   ALORS
         		calculligne++
         		iImprimeBloc(ITERATION5)	
         		//  totalpage +=  totalextraforme
         		//  totalfacture +=  totalextraforme
         	FIN
         fin
         
         si CORPS..visible ALORS
         	TotaldePage+=rubrique18
         FIN
        type : 327693
      -
        type : 327697
        enabled : false
