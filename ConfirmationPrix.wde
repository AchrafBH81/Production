         //		requeteconfirmationcommande.fdextraforme),2)
         //		totalsurcharge += arrondi(requeteconfirmationcommande.surchargeenergie,2)
         //		totalcap+= arrondi(requeteconfirmationcommande.FDExtraCap) * requeteconfirmationcommande.fdqteafacturer
         //
         //		AlimenteHistoriqueProduit(sansespace(client.numero),requeteconfirmationcommande.BDateFacture, requeteconfirmationcommande.ftype,requeteconfirmationcommande.fdnumprod,requeteconfirmationcommande.fdcomposant1,...
         //		requeteconfirmationcommande.fdcomposant2,requeteconfirmationcommande.fdcomposant3,arrondi(requeteconfirmationcommande.fdqteafacturer * ((requeteconfirmationcommande.fdpiedcarrefacture * requeteconfirmationcommande.fdprixupiedfacture)+ ...
         //	    requeteconfirmationcommande.fdextraforme),2),...
