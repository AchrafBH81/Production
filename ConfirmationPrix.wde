    properties :
     width : 269.4
     height : 61.971
    code_elements :
     type_code : 30
     p_codes :
      -
        code : |1-
         hlitrecherche(client,numero,requeteconfirmationcommande.faclient)
         tableautaxe = trouvetauxtaxe(client.numero,RequeteConfirmationCommande.fadate,client.CLangue)
         
         assigneLibelle()
         selon client.CImpressionAngMet
         	cas 0,1
         		Facpiedcarre..visible = vrai
         		Facpiedcarrefacture..visible = vrai
         		Facprixuni..visible = vrai
         		Facmetrecarre..visible = faux
         		Facmetrecarrefacture..visible = faux
         		Facprixunimetre..visible = faux
         
         	cas 2 
         		Facpiedcarre..visible = faux
         		Facpiedcarrefacture..visible = faux
         		Facprixuni..visible = faux
         		Facmetrecarre..visible = vrai
         		Facmetrecarrefacture..visible = vrai
         		Facprixunimetre..visible = vrai
         FIN
         
         si RequeteConfirmationCommande.idlivraison <> 0 alors
         	si hlitrecherche(ClientLivraison,IDClientLivraison,requeteconfirmationcommande.idlivraison) alors
         		nomclient2 = ClientLivraison.lNom
         		adresseclient1 = ClientLivraison.lRue
         		VilleClient1 = ClientLivraison.lVille+","+ClientLivraison.lprovince
         		CodePostalClient1 = ClientLivraison.lCodePostal	
         FIN
         sinon
         	GrpLivreA..visible=faux	
         FIN
        type : 327692
      -
        type : 327697
        enabled : false
