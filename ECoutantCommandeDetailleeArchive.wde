 controls : []
 code_elements :
  type_code : 13
  p_codes :
   -
     code : |1+
      procedure ECoutantCommandeSommaireDetaillee(lDateDebut = "20070419",ldatefin = "20070420",lNoClient = "")
      CDateDebut = ldatedebut
      CDatefin = ldatefin
      si lnoclient <> "" alors
      	LibelleClient = "Pour le client"
      	RNoClient..visible = faux
      FIN
     type : 327680
   -
     code : |1+
      si RequeteCoutantCommandeArchivev1.ctype = 4 alors
      	iSubstBloc(CORPS,ITERATION1)
      sinon
      	iSubstBloc(CORPS,"")
      
      FIN
     type : 327695
