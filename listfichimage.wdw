 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1+
      //procedure Listfichimage
      //************Fin Pour la table multiselection
      
      // Pour compatibilité 5.5
      MoiMême..Visible=Vrai
      
      GLOBAL
      X EST UN ENTIER = 0
      X1 EST UN ENTIER = 0
      Y EST UN ENTIER = 0
      Y1 EST UN ENTIER = 0
      cadreactif est une chaine  // cadre qui a le focus
      pointeurpremiercadre est une chaine
      numeve est un entier
      valeuraretourner est une chaine = ""
       // Début du code généré par l'assistant 'Evénement'
      WM_LBUTTONCLICK EST UN ENTIER = 513
      MATRICENUMERO EST UN TABLEAU DE 12 CHAINE
      // Ce code généré par l'assistant de code utilise des constantes W-Langage
      // tel que WM_COMMAND. Ces constantes sont définies dans le fichier 
      // WINCONST.WL localisé dans le répertoire de WinDev.
      // La commande EXTERNE permet d'inclure automatiquement ce fichier
      // à la compilation.
      
      
      //EXTERN "WINCONST.wl"
      //numeve =Evenement("affichecadre",".*",WM_LBUTTONCLICK)
      // Fin du code généré par l'assistant 'Evénement'
      
      hcreationsiinexistant("forme")
      hlitpremier("forme","fnumero")
      afficheimage()
      
   -
     type : 180
     enabled : false
   -
     type : 230
     enabled : false
   -
     code : |1+
      
      renvoyer valeuraretourner
      
     type : 2
   -
     type : 11
   -
     type : 12
   -
     type : 17
   -
     type : 13
  procedures :
   -
     name : AFFICHECADRE
     procedure_id : 4511921710908966839
     type_code : 14
     code : |1+
      Procédure AFFICHECADRE(NUMERO)
      //RECTANGLE(X,Y,X1,Y1)
      //Y = {"CLICAGE"+NUMERO}..LIGNE - 4
      //X = {"CLICAGE"+NUMERO}..COLONNE - 4 
      //Y1 = {"CLICAGE"+NUMERO}..LIGNE+{"CLICAGE"+NUMERO}..HAUTEUR + 4
      //X1 = {"CLICAGE"+NUMERO}..COLONNE+{"CLICAGE"+NUMERO}..LARGEUR + 4
      //RECTANGLE(X,Y,X1,Y1)
      si matricenumero[val(NUMERO)] <> "" alors
      //Code WinDev 5.5 remplacé par la migration :
      //cadre..ligne = {"CLICAGE"+NUMERO}..LIGNE - 2
      cadre..y = {"CLICAGE"+NUMERO}..y - 2
      //Code WinDev 5.5 remplacé par la migration :
      //cadre..colonne = {"CLICAGE"+NUMERO}..colonne - 3
      cadre..x = {"CLICAGE"+NUMERO}..x - 3
      //Code WinDev 5.5 remplacé par la migration :
      //cadre..etat = actif
      cadre..etat = actif; cadre..Visible=Vrai
      
      //Code WinDev 5.5 remplacé par la migration :
      //LOUPE..LIGNE = {"CLICAGE"+NUMERO}..LIGNE + {"CLICAGE"+NUMERO}..HAUTEUR- 22 
      LOUPE..y = {"CLICAGE"+NUMERO}..y + {"CLICAGE"+NUMERO}..HAUTEUR- 22 
      //Code WinDev 5.5 remplacé par la migration :
      //LOUPE..COLONNE = {"CLICAGE"+NUMERO}..COLONNE + {"CLICAGE"+NUMERO}..LARGEUR + 6
      LOUPE..x = {"CLICAGE"+NUMERO}..x + {"CLICAGE"+NUMERO}..LARGEUR + 6
      //Code WinDev 5.5 remplacé par la migration :
      //LOUPE..ETAT = ACTIF
      LOUPE..ETAT = ACTIF; LOUPE..Visible=Vrai
      cadreactif = NUMERO
      
      //Code WinDev 5.5 remplacé par la migration :
      //accepte..LIGNE = {"CLICAGE"+NUMERO}..LIGNE + {"CLICAGE"+NUMERO}..HAUTEUR- 50 
      accepte..y = {"CLICAGE"+NUMERO}..y + {"CLICAGE"+NUMERO}..HAUTEUR- 50 
      //Code WinDev 5.5 remplacé par la migration :
      //accepte..COLONNE = {"CLICAGE"+NUMERO}..COLONNE + {"CLICAGE"+NUMERO}..LARGEUR + 6
      accepte..x = {"CLICAGE"+NUMERO}..x + {"CLICAGE"+NUMERO}..LARGEUR + 6
      //Code WinDev 5.5 remplacé par la migration :
      //accepte..ETAT = ACTIF
      accepte..ETAT = ACTIF; accepte..Visible=Vrai
      cadreactif = NUMERO
      fin
      
     type : 458752
   -
     name : afficheimage
     procedure_id : 4511921711262992331
     type_code : 14
     code : |1+
      Procédure afficheimage()
      j	est un entier
      i	est une chaine
      pointeurpremiercadre = forme.fnumero
      pour j = 1 a 12
      	i = sansespace(numeriqueverschaine(j,"2d"))
      	{"listfichimage.clicage"+i} = ""
      	matricenumero[j] = ""
      FIN
      
      
      j = 1
      hlit("forme",h.numenr)
      //Code WinDev 5.5 remplacé par la migration :
      //tantque pas h.endehors et j < 13
      tantque pas HEnDehors() et j < 13
      	si forme.IsActive alors
      		i = sansespace(numeriqueverschaine(j,"2d"))
      		
      		{"listfichimage.clicage"+i} = completerep(config.Dossierforme)+forme.fchemin
      		matricenumero[j] = forme.fnumero
      		j++
      	fin
      	HLitSuivant("forme","fnumero")
      FIN
      affichecadre("1")
      
     type : 458752
   -
     name : RECTANGLE
     procedure_id : 4511921711022868447
     type_code : 14
     code : |1+
      procedure Rectangle(X1,Y1, X2, Y2)
      // Trace un cadre en XOR
      // Pour effacer ce cadre, il suffit d'appeler à nouveau cette routine avec
      // les mêmes paramètres
      
      Rect	est compose de
      //Code WinDev 5.5 remplacé par la migration :
      //	RX1	est un entier
      	RX1	est un entier sur 2 octets
      //Code WinDev 5.5 remplacé par la migration :
      //	RY1	est un entier
      	RY1	est un entier sur 2 octets
      //Code WinDev 5.5 remplacé par la migration :
      //	RX2	est un entier
      	RX2	est un entier sur 2 octets
      //Code WinDev 5.5 remplacé par la migration :
      //	RY2	est un entier
      	RY2	est un entier sur 2 octets
      fin
      hDC	est un entier systeme
      
      	
      Rect32	est compose de
      //Code WinDev 5.5 remplacé par la migration :
      //	RX132	est un entier long
      	RX132	est un entier  
      //Code WinDev 5.5 remplacé par la migration :
      //	RY132	est un entier long
      	RY132	est un entier  
      //Code WinDev 5.5 remplacé par la migration :
      //	RX232	est un entier long
      	RX232	est un entier  
      //Code WinDev 5.5 remplacé par la migration :
      //	RY232	est un entier long
      	RY232	est un entier  
      fin
      //Code WinDev 5.5 remplacé par la migration :
      //hDC32	est un entier long
      hDC32	est un entier  systeme
      
      
      si VersionWindows()="32" alors	
      	Rect32.RX132=X1; Rect32.RY132=Y1; Rect32.RX232=X2; Rect32.RY232=Y2
      	hDC32=sysrecuperedc(handle(""))
      	appelDLL32("User32","DrawFocusRect",hDC32,&Rect32)
      	appeldll32("User32","ReleaseDC",0,hDC32)
      sinon
      	Rect.RX1=X1; Rect.RY1=Y1; Rect.RX2=X2; Rect.RY2=Y2
      	hDC=sysrecuperedc(handle(""))
      //Code WinDev 5.5 remplacé par la migration :
      //	appelDLL("USER","DrawFocusRect",hDC,&Rect)
      // Votre programme utilise ici une commande 16 bits. 
      // Cette version ne permet que des exécutables 32 bits.
      // 	appelDLL("USER","DrawFocusRect",hDC,&Rect)
      // Code ajouté par la migration
      Erreur("Votre programme utilise ici une commande 16 bits. Cette version ne permet que des exécutables 32 bits.")
      
      //Code WinDev 5.5 remplacé par la migration :
      //	appeldll("User","ReleaseDC",0,hDC)
      // Votre programme utilise ici une commande 16 bits. 
      // Cette version ne permet que des exécutables 32 bits.
      // 	appeldll("User","ReleaseDC",0,hDC)
      // Code ajouté par la migration
      Erreur("Votre programme utilise ici une commande 16 bits. Cette version ne permet que des exécutables 32 bits.")
      
      fin
      
     type : 458752
  procedure_templates : []
  property_templates : []
