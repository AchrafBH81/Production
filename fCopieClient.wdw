  -
    name : Btn_Ok
    identifier : 0x49d4bf5a61b0cf20
    internal_properties : 
    properties :
     x : 368
     y : 44
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         sablier(vrai)
         formeclientalias est une source de donnees
         Produitclientalias est une source de donnees
         fcouleurclientalias est une source de donnees
         fclientproduitcouleurtalias est une source de donnees
         thermosclientalias est une source de donnees
         variablexclientalias est une source de donnees
         
         lidclientSource est une chaine = sansespace(Combo_client)
         lidclientCible est une chaine = sansespace(lnumero)
         
         halias(FormeClient,formeclientalias)
         HCréation(formeclientalias)
         halias(produitClient,Produitclientalias)
         HCréation(Produitclientalias)
         halias(fcouleurClient,fcouleurclientalias)
         HCréation(fcouleurclientalias)
         halias(FClientProduitCouleur,fclientproduitcouleurtalias)
         HCréation(fclientproduitcouleurtalias)
         halias(thermosClient,thermosclientalias)
         HCréation(thermosclientalias)
         halias(VariableXclient,variablexclientalias)
         HCréation(variablexclientalias)
         
         si IntChoix[1] alors
         	// Forme
         
         	HLitRecherche(FormeClient,NoClient,lidclientCible)
         	tantque pas hendehors(FormeClient) et formeclient.NoClient = lidclientCible
         		hsupprime(FormeClient,hNumEnrEnCours)
         		HLitSuivant(FormeClient,NoClient)
         	FIN
         
         	HLitRecherche(FormeClient,NoClient,lidclientSource)
         	tantque pas hendehors(FormeClient) et formeclient.NoClient = lidclientSource
         		HCopieEnreg(formeclientalias,FormeClient)
         		formeclientalias.noclient = lidclientCible
         		HAjoute(formeclientalias)
         		HLitSuivant(FormeClient,NoClient)
         	FIN
         
         	pour tout formeclientalias
         		HCopieEnreg(formeclient,formeclientalias)
         		HAjoute(formeclient)
         
         	FIN
         fin
         HAnnuleAlias(formeclientalias)
         
         si IntChoix[2] alors
         	// Couleur
         
         	HLitRecherche(fcouleurClient,NoClient,lidclientCible)
         	tantque pas hendehors(fcouleurClient) et fcouleurclient.NoClient = lidclientCible
         		hsupprime(fcouleurClient,hNumEnrEnCours)
         		HLitSuivant(FcouleurClient,NoClient)
         	FIN
         
         	HLitRecherche(FCouleurClient,NoClient,lidclientSource)
         	tantque pas hendehors(FCouleurClient) et FCouleurClient.NoClient = lidclientSource
         		HCopieEnreg(fcouleurclientalias,FCouleurClient)
         		fcouleurclientalias.noclient = lidclientCible
         		HAjoute(fcouleurclientalias)
         		HLitSuivant(fcouleurclient,NoClient)
         	FIN
         
         	pour tout fcouleurclientalias
         		HCopieEnreg(FCouleurClient,fcouleurclientalias)
         		HAjoute(FCouleurClient)
         
         	FIN
         fin
         HAnnuleAlias(fcouleurclientalias)
         
         si IntChoix[3] alors
         
         	// produit
         
         	HLitRecherche(produitClient,IdClientIdproruit,HConstruitValClé(ProduitClient,IdClientIdproruit,lidclientCible))
         	tantque pas hendehors(produitClient) et produitclient.IdClient = lidclientCible
         		hsupprime(produitClient,hNumEnrEnCours)
         		HLitSuivant(produitClient,IdClientIdproruit)
         	FIN
         
         	HLitRecherche(produitClient,IdClientIdproruit,HConstruitValClé(ProduitClient,IdClientIdproruit,lidclientSource))
         	tantque pas hendehors(produitClient) et produitclient.IdClient = lidclientSource
         		HCopieEnreg(Produitclientalias,ProduitClient)
         		Produitclientalias.idclient = lidclientCible
         		HAjoute(Produitclientalias)
         		HLitSuivant(ProduitClient,IdClientIdproruit)
         	FIN
         
         	pour tout Produitclientalias
         		HCopieEnreg(Produitclient,Produitclientalias)
         		HAjoute(ProduitClient)
         
         	FIN
         
         
         	HLitRecherche(FClientProduitCouleur,noClient,lidclientCible)
         	tantque pas hendehors(FClientProduitCouleur) et FClientProduitCouleur.noClient = lidclientCible
         		hsupprime(FClientProduitCouleur,hNumEnrEnCours)
         		HLitSuivant(FClientProduitCouleur,noClient)
         	FIN
         
         
         
         
         	HLitRecherche(FClientProduitCouleur,noClient,lidclientSource)
         	tantque pas hendehors(FClientProduitCouleur) et FClientProduitCouleur.noClient = lidclientSource
         		HCopieEnreg(fclientproduitcouleurtalias,FClientProduitCouleur)
         		fclientproduitcouleurtalias.noclient = lidclientCible
         		HAjoute(fclientproduitcouleurtalias)
         		HLitSuivant(FClientProduitCouleur,noClient)
         	FIN
         
         	pour tout fclientproduitcouleurtalias
         		HCopieEnreg(FClientProduitCouleur,fclientproduitcouleurtalias)
         		HAjoute(FClientProduitCouleur)
         
         	FIN
         
         fin
         
         HAnnuleAlias(Produitclientalias)
         HAnnuleAlias(fclientproduitcouleurtalias)
         
         
         
         
         si IntChoix[4] alors
         	//Thermos
         
         	HLitRecherche(ThermosClient,IdClientIdhermos,HConstruitValClé(ThermosClient,IdClientIdhermos,lidclientCible))
         	tantque pas hendehors(ThermosClient) et ThermosClient.IdClient = lidclientCible
         		hsupprime(ThermosClient,hNumEnrEnCours)
         		HLitSuivant(ThermosClient,IdClientIdhermos)
         	FIN
         
         	HLitRecherche(ThermosClient,IdClientIdhermos,HConstruitValClé(ThermosClient,IdClientIdhermos,lidclientSource))
         	tantque pas hendehors(ThermosClient) et ThermosClient.IdClient = lidclientSource
         		HCopieEnreg(thermosclientalias,ThermosClient)
         		thermosclientalias.idclient = lidclientCible
         		HAjoute(thermosclientalias)
         		HLitSuivant(ThermosClient,IdClientIdhermos)
         	FIN
         
         	pour tout thermosclientalias
         		HCopieEnreg(ThermosClient,thermosclientalias)
         		HAjoute(ThermosClient)
         
         	FIN
         fin
         HAnnuleAlias(thermosclientalias)
         
         si IntChoix[5] alors
         	//VariableX
         
         	HLitRecherche(VariableXclient,noClientTypeCalcul,HConstruitValClé(VariableXclient,noClientTypeCalcul,lidclientCible))
         	tantque pas hendehors(VariableXclient) et VariableXclient.noClient = lidclientCible
         		hsupprime(variablexclient,hNumEnrEnCours)
         		HLitSuivant(VariableXclient,noClientTypeCalcul)
         	FIN
         
         	HLitRecherche(VariableXclient,noClientTypeCalcul,HConstruitValClé(VariableXclient,noClientTypeCalcul,lidclientSource))
         	tantque pas hendehors(VariableXclient) et VariableXclient.noClient = lidclientSource
         		HCopieEnreg(variablexclientalias,VariableXclient)
         		variablexclientalias.noclient = lidclientCible
         		HAjoute(variablexclientalias)
         		HLitSuivant(VariableXclient,noClientTypeCalcul)
         	FIN
         
         	pour tout variablexclientalias
         		HCopieEnreg(VariableXclient,variablexclientalias)
         		HAjoute(VariableXclient)
         
         	FIN
         fin
         HAnnuleAlias(variablexclientalias)
         
         
         
         //Produitclientalias est une source de donnees
         //fcouleurclientalias est une source de donnees
         //fclientproduitcouleurtalias est une source de donnees
         //thermosclientalias est une source de donnees
         
         sablier(faux)
         
         ferme()
         
         
        type : 18
      -
        type : 161
        enabled : false
