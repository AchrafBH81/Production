     p_codes :
      -
        code : |1+
         numerofacture est un entier 
         ltotaltps est un reel
         ltotaltvq est un reel
         ltotalsurcharge est un reel
         
         
         selon sTypeTrsf
         //	cas 1                  //Transférer la commande en facture
