         //			bonlivraison.Bfacture = prochainnumerodefacture
         //			hmodifie(BonLivraison,hNumEnrEnCours)
         //			fac_entete[1] = bonlivraison.Bclient
         //			fac_entete[2] = dateverschaine(bonlivraison.Bdatefacture,"JJ/MM/AAAA")
         //			fac_entete[3] = numeriqueverschaine(bonlivraison.Bfacture) 
         //
         //			fac_entete[4] = numeriqueverschaine(bonlivraison.Bnumero)
         //			fac_entete[5] = "Transfert / Logiciel de production"
         //			prochainnumerodefacture++
         //
         //			hexecuterequete(RequeteBlEtat,hRequêteDéfaut,numerofacture)
         //			selon simpression
         //				cas 2
         //					iAperçu(i100, "Aperçu écran", Vrai)
         //			fin	
         //			//iAperçu(i100, "Aperçu écran", Vrai)
         //			// Ne sauvegarde pas les paramètres spécifiés
         //			si simpression <> 3 alors
         //				iParamètre("DEFAUT=NON")
         //				iParamètre("QUALITE=HAUTE")
         //				iParamètre("COPIES="+config.nbcopiefacture)
         //				selon gFormatFacture
         //					cas 2
         //						iimprimeetat(Facturetrn,faux,numerofacture)
         //					autres cas
         //						iimprimeetat(laFactureNovy,faux,numerofacture,noglcredit)
         //				fin
         //			fin
         //			selon gFormatFacture
         //				cas 1
         //					bonlivraison.BStotal = (val(fac_detail[1,2] ) * -1) -val(fac_detail[dimension(fac_detail)/4,2] ) 
         //					bonlivraison.BTVH = val(fac_detail[dimension(fac_detail)/4,2] ) 
         //				cas 2	
         //					bonlivraison.BStotal = (val(fac_detail[1,2] ) * -1) -val(fac_detail[dimension(fac_detail)/4,2] ) 
         //					ltotaltvq = val(fac_detail[dimension(fac_detail)/4,2] )
         //					ltotaltps = val(fac_detail[(dimension(fac_detail)/4)-1,2] )
         //					ltotalsurcharge = val(fac_detail[(dimension(fac_detail)/4)-2,2] )
         //					bonlivraison.BTps = ltotaltps 
         //					bonlivraison.BTVQ = ltotaltvq
         //					bonlivraison.Bsurcharge = ltotalsurcharge 
         //					bonlivraison.BStotal = (val(fac_detail[1,2] ) * -1) - (ltotaltps+ltotaltvq) 
         //			fin
         //
         //			//majhistorique(fenregistrement[j])
         //			multitache(50)
         //			bonlivraison.Btransfere = faux
         //			//			 hmodifie("hfacture")
         //
         //			hmodifie(BonLivraison)
         //			hdebloquenumenr("Facture",hNumEnrEnCours)
         //			hsupprime(facture)
         //			maj_detail_comptable(bonlivraison.Bnumero)
         //			si sComptabilite = 1 alors
         //				transfert_facture(bonlivraison.Bnumero)
         //			FIN
         //
         //		fin 
         //
         //
         //		hlitpremier("config","COCLEUNIK")
         //		config.NumFact = prochainnumerodefacture
         //		hmodifie("config",1)
         //
         //
         //
         
         	cas 1                // transfere la commande en bon de livraison immédiatement
         		hlit(config,1)
         		numerofacture = config.numbl
         		config.numbl++
         		hmodifie(config,1)
         		hraz(BonLivraison)
         		epurefacturecredit(lnumenr,numerofacture)
                 bonlivraison.BnoCommande =hfacture.fanumero
         		bonlivraison.Bclient = hfacture.faclient
         		bonlivraison.bdate = hfacture.fadatecommande
         		bonlivraison.Bnumero = numerofacture
         		bonlivraison.bstotal = hfacture.fatotal
         //		bonlivraison.btvh = hfacture.fatps
         //		bonlivraison.bTauxTvh = config.tauxtps
         //		bonlivraison.bTauxTvq = config.tauxtvq
         
         		BonLivraison.btvh = hfacture.fatps
         		BonLivraison.bTauxTvh = hfacture.fatps
         		BonLivraison.bTauxTvq = hfacture.fatvq
         		BonLivraison.bTauxTaxe1 = hfacture.fatps
         		BonLivraison.bTauxTaxe2 = hfacture.fatvq		
         		
         		
         		bonlivraison.brien = numeriqueverschaine(hfacture.fatypedocument)
         		        BonLivraison.cvendeur = hfacture.cvendeur
         		hajoute(BonLivraison)
         
         		selon simpression
         			cas 2
         				iAperçu(i100, "Aperçu écran", Vrai)
         		fin	
         		si simpression <> 3 alors
         			hexecuterequete(RequeteBlEtat,hrequetedefaut,bonlivraison.bnumero)
         			iconfigure(sansespace(imprimantefacture),vrai)
         			// Ne sauvegarde pas les paramètres spécifiés
         			iParamètre("DEFAUT=NON")
         			iParamètre("QUALITE=HAUTE")
         			//Nombre de copies à imprimer
         			iParamètre("COPIES="+config.nbcopieBlivraison)
         
         			iimprimeetat(BonLivraison)
         		fin
         FIN
         
         
         ferme()
        type : 18
      -
        type : 161
        enabled : false
