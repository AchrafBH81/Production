  -
    name : Btn_Ok
    identifier : 0x47d842db2faccd20
    internal_properties : 
    properties :
     x : 427
     y : 47
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         lunclient est un booleen = faux
         RequeteFactureclient.pdateDebut = csddatedebut
         RequeteFactureclient.pdatefin = csddatefin
         lnomfichier est une chaine
         i est un entier
         si SELECTCLIENT = 1 alors
         	requetefactureclient.pclient = 	null
         sinon
         	requetefactureclient.pclient = 	CHOIXCLIENT
             lunclient = vrai
         FIN
         	
         HExécuteRequête(RequeteFactureclient)
         
         
         si hnbenr(RequeteFactureclient) = 0 alors
         	ACSO_message("Erreur","Aucune facture ne correspond à votre demande","Erreur")
         	ferme(ListeFactureclient)
         FIN
         si SélecteurDestination = 1 alors
         	iapercu()
         sinon si SélecteurDestination = 3
         //	pdfc>>cPrinterStop = 1
         	si frep(completerep(repdonnees)+"PDF\"+"Listefacture",frRépertoire) = "" alors
         		fRepCrée(completerep(repdonnees)+"PDF\"+"ListeFacture")
         	fin
         //	pdfc>>cOption("AutosaveDirectory") = completerep(repdonnees)+"PDF\"+"ListeFacture"
         //	pdfc>>cOption("AutosaveFilename")  ="Listefacture"+csddatedebut+"_"+csddatefin
         //		pdfc>>cOption("AutosaveFilename")  ="Listefacture"+csddatedebut+"_"+csddatefin+".pdf"
         //	lnomfichier = pdfc>>cOption("AutosaveDirectory")+"\Listefacture"+csddatedebut+"_"+csddatefin+".pdf"
         	lnomfichier = completerep(repdonnees)+"PDF\"+"ListeFacture\Listefacture"+csddatedebut+"_"+csddatefin+".pdf"
         	si fFichierExiste(lnomfichier) alors
         		fSupprime(lnomfichier)
         	fin
         
         	sablier(vrai)
         	ouvresoeur(FenAttentePetite,"Préparation du fichier PDF en cours"+rc+"Veuillez patienter...........")
         	iConfigure(SansEspace(imprimantefacture),Vrai)
         	iParamètre("DEFAUT=NON")
         	iParamètre("FORMATPAPIER=LETTRE")
         	iDestination(iPDFGénérique,lnomfichier)
         	iFenêtreAbandon(faux)	
         fin
         
         iimprimeetat(EclientFacture,csddatedebut,csddatefin,lunclient)
         
         si SélecteurDestination = 3 ALORS
         //	tantque pas pdfc>>ccountofprintjobs() = 1
         //	fin
         //	pdfc>>cPrinterStop = 0
         //	tantque pdfc>>ccountofprintjobs() >= 1
         //		i++
         //	FIN
         //	multitache(100)
         	si FenEtat(FenAttentePetite) <> Inexistant alors
         		ferme(FenAttentePetite)
         	fin
         //	pdfc>>cPrinterStop = 1
         
         FIN
         
         
         
         
         
         
        type : 18
