         	CoutantTotal+=arrondi(RequeteCoutantCommandeUneLigne.ccouttotal,2)
         //	couttotal+=arrondi(RequeteCoutantCommandeUneLigne.ccouttotal,2)
         FIN
         si RequeteCoutantCommandeArchiveV2.Cdatelivraison <> "" alors
