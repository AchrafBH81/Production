         	si hlitrecherche(fdetail,fdcle,HConstruitValClé(fdetail,fdcle,RequeteCoutantCommandeArchivev2.cnocommande,...
         		RequeteCoutantCommandeArchivev2.cNoLigne))
         		lqte = fdetail.fdqteafacturer
         		Lnumprod = fdetail.fdnumprod
         		Ldesc = fdetail.fddesc
         		llargeur = fdetail.fdlargeur
         		lhauteur = fdetail.fdhauteur
         
         	FIN
         
         fin
         
         
