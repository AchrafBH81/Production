      -
        code : |1+
         HExécuteRequête(RequeteCoutantCommandeUneLigne,hRequêteDéfaut,RequeteCoutantCommandeArchivev2.cnocommande,...
         RequeteCoutantCommandeArchivev2.cNoLigne)
