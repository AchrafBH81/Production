 controls :
  -
    name : BTN_SORTIE
    identifier : 0x3f6f7cc217b2242f
    internal_properties : 
    properties :
     x : 25
     y : 9
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         pour chaque clUser de gtabuser 
         	si clUser.m_bIsModified alors
         		si clUser.m_IDUsager <> 0  alors
         			si HLitRecherche(Usager,IDUsager,clUser.m_IDUsager) alors
         				MémoireVersFichier(clUser,Usager)
         				hmodifie(Usager,hNumEnrEnCours)
         			fin
         		sinon
         			MémoireVersFichier(clUser,Usager)
         			Hajoute(Usager)
         			
         		FIN
         	fin
         FIN
         ferme()
         
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_AJOUT
    identifier : 0x3f6f7cc26794242f
    internal_properties : 
    properties :
     x : 89
     y : 9
     width : 31
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         clUser est un cuser = allouer un cuser()
         clUser.m_bIsActive = vrai
         clUser.m_bIsNew = vrai
         clUser = ouvre(FEN_UserDetails,clUser)
         gtabuser.ajoute(clUser)
         tableaffiche(Table_Usager)
        type : 18
      -
        type : 161
        enabled : false
