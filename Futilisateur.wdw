  procedures :
   -
     name : valider_groupe
     procedure_id : 4571009320577868847
     type_code : 14
     code : |1-
      Procédure valider_groupe(numero,groupeaverifier,etataenvoyer)
      
      i est un entier
      
      
      pour i = numero a 44
      	SI Position({"optiondemenu"+i}..Groupe, groupeaverifier)>0 ALORS
      	
      		{"optiondemenu"+i} = etataenvoyer
      		SI etataenvoyer = 0 ALORS
      			{"optiondemenu"+i}..ETAT = GRISÉ
      		SINON
      			{"optiondemenu"+i}..ETAT = ACTIF
      
      		FIN
      		executetraitement("optiondemenu"+i,trtModification)
      	FIN
      FIN
     type : 458752
