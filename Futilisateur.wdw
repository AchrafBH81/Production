 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1+
      gtabuser est un tableau de cUser
      gsdReqsql est une source de donnees
      HExécuteRequêteSQL(gsdReqsql,hRequêteDéfaut,"select * from usager where isdeleted = 0")
      
      
      
      FichierVersTableau(gtabuser,gsdReqsql)
   -
     code : |1+
      si table_usager..vide alors
      	futilisateur.BTN_MODIFIE..etat = grise
      FIN
     type : 34
   -
     type : 180
     enabled : false
