  type_code : 1
  p_codes :
   -
     code : |1+
      procedure AjoutModifGarantie(_mode = "A",_idgarantie=0,_date = "",_datefin = "")
      moimeme..ValeurRenvoyée = ""
      
      
   -
     code : |1+
      si _mode = "A" alors
      	ListeSelectPlus(Combo_Garantie,1)
          gdate = DateDuJour()
          gDateFin = DateDuJour()
      sinon
      	Combo_Garantie = _idgarantie
      	gdate = _date
      	gdatefin = _datefin
      FIN
      
