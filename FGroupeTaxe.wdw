    type : 16
    controls : []
    code_elements :
     type_code : 24
     p_codes :
      -
        code : |1-
         
         selon moimeme
         	cas 1
         		libelle1..visible = faux
         		Onglettaxe[3]..etat = grise
         	cas 2
         		libelle1 = TaxeGroupe.TaxeGroupeDescription
         		libelle1..visible =  vrai
         		Onglettaxe[3]..etat = actif
         	cas 3
         		libelle1 = TaxeGroupe.TaxeGroupeDescription+ " ("+dateverschaine(taxegroupedate.datedebut,"JJ/MM/AAAA") +" au " + dateverschaine(taxegroupedate.datefin,"JJ/MM/AAAA")+")"
         		libelle1..visible = vrai
         
         		
         FIN
        type : 17
      -
        type : 292
        enabled : false
      -
        type : 293
        enabled : false
  -
    name : BTN_AJOUT
    identifier : 0x513ccc9a4b5718de
    internal_properties : 
    properties :
     x : 65
     y : 6
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         selon Onglettaxe
         
         	cas 1
         
         		ouvre(fCreationTaxe)
         		TableAffiche(Table_TaxeGroupe,taDébut)
         
         	cas 2
         
         		ouvre(fCreationTaxedate,TaxeGroupe.TaxeGroupeDescription,TaxeGroupe.IDTaxeGroupe)
         		tableaffiche(Table_TaxeGroupeDate,taDébut)
         	cas 3
         
         		ouvre(fCreationTaxedatetaux,libelle1)
         		tableaffiche(Table_TaxeGroupeDateTaux,taDébut)
         fin
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_MODIFIE
    identifier : 0x513ccc9a4a1b18de
    internal_properties : 
    properties :
     x : 105
     y : 6
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         selon Onglettaxe
         
         	cas 1
         
         		ouvre(fCreationTaxe,"M")
         		TableAffiche(Table_TaxeGroupe,taDébut)
         
         	cas 2
         
         		ouvre(fCreationTaxedate,TaxeGroupe.TaxeGroupeDescription,TaxeGroupe.IDTaxeGroupe,"M")
         		tableaffiche(Table_TaxeGroupeDate,taDébut)
         	cas 3
         
