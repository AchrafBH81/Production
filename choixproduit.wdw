 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1+
      procedure choixproduit(noproduit,comp1,comp2,comp3,noproduitrpl,comprpl1,comprpl2,comprpl3,Provenance = "commande")
      
      // Pour compatibilité 5.5
      MoiMême..Visible=Vrai
      
      global
      valeuraretourner est un entier
      
      si sansespace(comprpl1) = "" et sansespace(comprpl2) = "" et sansespace(comprpl3) = "" alors
      	BTN_CONTINUE..etat = grise
      	
      FIN
   -
     type : 180
     enabled : false
