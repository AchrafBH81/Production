      	FIN
      	
      	
      	
      constante
      	PROCESS_ALL_ACCESS = 0X1F0FFF 
      fin
      
      //	si pas fFichierExiste(repencours+"production.INI") alors
      //		fCopieFichier(repencours+"production.ini",repencours+"production.INI")
      //	FIn
      
      
      GLOBAL
      	
      	NbOfIncomingOrders est un entier
      	gsUser est une chaîne
      	gsPassword est une chaîne
      	gsUsername est une chaîne
      	
      	
      	acousager est une chaine        // Nom Usager Acomba
      	acomotdepasse est une chaine    // Mot de passe Acomba
      	acosouvenir est un booleen      // Pour savoir si l'usager veut que l'on se souvienne du mot de passe
      	acoacomba est une chaine        // Dossier du logiciel Acomba
      	acodonnees est une chaine       // Dossier des données de la compagnie dans acomba
      	ancientypedeproduit est une chaine  // pour savooir si on entre un type de produit identique pour
      	// savoir si on garde les champs identiques (dans commande et commandetrn)
      	lNombreenrImprime est un entier   // nombre d'enregistrement imprimé d'un etat pour savoirsi c,est 0 pour éviter page blanche
      	tauxconversionam est un reel 
      	tauxconversionma est un reel 
      	tauxconversionamlineaire est un reel 
      	gLongueurbarrecarrelageA est un reel
      	gLongueurbarrecarrelageM est un reel
      	gProvinceTaxe est un entier
      	gFormatFacture est un entier   // 1 = Novy  2=Thermos Rive-Nord
      	cheminforme est une chaine
      	//			tableaudoublespacer est un tableau dynamique de 1 chaine // pour inscrire spacer existant double 
      	//			tableautriplespacer est un tableau dynamique  de 1  chaine // pour inscrire spacer existant triple
      	toutelafacture est un booleen
      	//			grandlivre est un entier           // identifiant pour la création de la vue Grand livre
      	repencours est une chaine = frepencours()+"\"
      	repdonnees est une chaine 
      	cleparcours est une chaine = "inum"
      	modif est un booleen = Faux   // pour savoir si on est en modification
      	ajout est un booléen = Faux
      	modif_special EST UN BOOLEEN = FAUX
      	connection_serveur est un booleen = faux
      	ligne est une chaine
      	/////////////////////
      	
      	gConnexionHF est une connexion // connexion hyperFile
      	gcnxConnexionHFExternal est une connexion // connexion hyperFile
      	
      	
      	
      	
      	gLogCompt est une chaine // Pour logiciel comptable Acomba,Cameleon,Aucun
      	gImpressionFeuilleTravail est un entier = 1  // pour savoir si on imprime les feuilles de travail
      	
      	/////////////////////
      	
      	ligne1 est une chaine
      	//			donnee_recu est un booleen = faux
      	//		login est un booléen = faux
      	disconnecte_login est un booléen = faux    // pour savoir si on est en login
      	// lors de la déconnection de tcp
      	affichemessage est un booleen         // pour savoir si on affiche le message de non connection au serveur
      	ligneaajouter est une chaine
      	clienttrouve est un booleen = faux
      	
      	position_fichier est un entier             // position dans un fichier pour récupération ultérieure
      	//client est un booléen = faux
      	recupclient est un booleen = faux
      	lusager EST UNE CHAINE =  ""
      	//	gsPASSWORD EST UNE CHAINE = ""
      	numeroevenement est un tableau de 15 entier
      	//numeroevenement1 est un entier
      	bSaisieOk est un booleen
      	//WM_LBUTTONDBLCLK est un entier = 515
      	//WM_MOUSEMOVE est un entier = 512
      	fenetre est un chaine
      	valeurinitialec est une chaine           // valeur initiale du champ
      	valeurinitialen est un entier           // en saisie
      	unitedemesure est un tableau de 2 chaine
      unitedemesure[1] = "Anglais"
      unitedemesure[2] = "Métrique"
      numerodecommande est un entier     // numéro de commande du début de page pour valider si il faut
      prochainnumerodefacture est un entier  // prochain numéro de facture lors de l'impression
      clicbouton est un booleen                // pour savoir si l'entrée vient d'une saisie ou d,une recherche
      numerodefacture est un entier  
      gImprimeCondPMT est un booleen // Pour savoir si on imprime la condition de paiment sur la liste de prix
      ancien est une chaine 
      listedesecteur est un tableau de 25 chaine
      listedesecteurannule est un tableau de 25 chaine
      ensemblepersoactif EST UN BOOLEEN = FAUX   // si lusager est validé le fichier des ensembles personnels
      escompteqte est un booleen = faux         // flag pour determiner si on a un escompte de quantite
      pourcescompteqte est un reel              // % escompte de quantite 
      lechampencours est une chaine
      wrecherche est un booleen = faux  // pour savoir si on vient de la recherche
      // assignation des imprimantes
      gNoExtraDemi est une chaine
      
      tableautaxe est un tableau dynamique de 0 par 4 chaine
      
      imprimantefacture   est une chaine = litimprimantesini("facture")
      imprimanterapport   est une chaine = litimprimantesini("rapport")
      imprimanteetiquette est une chaine = litimprimantesini("etiquette")
      imprimanteconfirmation est une chaine = litimprimantesini("confirmation")
      imprimantecarrelage est une chaine = litimprimantesini("carrelage")
      imprimantepdf est une chaine = litimprimantesini("pdf")
      imprimanteftravail est une chaine = litimprimantesini("ftravail")
      imprimantebon est une chaine = litimprimantesini("bon")
      imprimantefax est une chaine = litimprimantesini("fax")
      imprimanteAchat est une chaine = litimprimantesini("achat")
      
      
      
      //gimprimantepdfstatus est un booleen
      
      // champ répétitif configurable par l'usager
      
      ChampRépétitif est un tableau dynamique
      champrépétitif  = allouer un tableau de 0 par 0 chaine
      
      DescriptionVarInter1 est une chaine
      DescriptionVarInter2 est une chaine
      DescriptionVarInter3 est une chaine
      DescriptionVarInter4 est une chaine
      DescriptionVarInter5 est une chaine
      
      
      fac_detail est un tableau dynamique
      HDécritTrigger("facture","hajoute,hmodifie,hsupprime,hecrit","majlog",hTriggerAprès)
      
      
      
      //pdfc est un objet automation dynamique
      //quand exception dans
      //	pdfc = allouer un objet automation "pdfcreator.clspdfcreator"
      //
      //faire 
      //	info("erreur")
      //fin
      //t
      ////	si pdfc>>cprogramisrunning() alors
      //
      //si pdfc>>cProgramIsRunning() alors
      //	KillProcess("PDFCreator.exe")
      //	//	    pdfc>>cclose()
      //	liberer pdfc
      //	pdfc = allouer un objet Automation "pdfcreator.clspdfcreator"
      //FIN
      
      //	FIN
      
      donneesini(faux)
      
      // Si le choix du logiciel comptable n'est pas fait , le faire ici
      si inilit("COMPTABILITE","LOGICIEL","",repencours+"production.ini") = "" alors
      	iniecrit("COMPTABILITE","LOGICIEL",ouvre(fChoixComptable),repencours+"production.ini")
      fin
      gLogCompt = inilit("COMPTABILITE","LOGICIEL","",repencours+"production.ini")
      // Format 1 = Novy 2=TRN 
      
      
      gFormatFacture = inilit("COMPTABILITE","FORMATFACTURE","1",repencours+"production.ini")
      
      ////////////////////////////////////////////////////////////////////////////
      
      si  enmodetest() alors
      //	selon ouvre(ChoixCie)
      //		cas 1
      //			//			repdonnees = "g:\wd16projet\novy\exe\data"
      			repdonnees = completerep(fRepEnCours())+"data"
      			
      			fCopieFichier("logotrn.bmp","logoprincipal.bmp")
      			glogcompt="Cameleon"
      			ghauteurlogo =19.5
      			gLargeurLogo =14.5
      			gTypeOptimisation="optima"
      			gFormatFacture = 2
      //		cas "2"
      //			repdonnees = "g:\wd16projet\novy\exe\datanovy"
      //			//			repdonnees = "u:\jhamelin\prive\datanovy"
      //			gFormatFacture = 1
      //			glogcompt="Acomba"
      //			fCopieFichier("logonovy.bmp","logoprincipal.bmp")
      //			ghauteurlogo =12.5
      //			gLargeurLogo =25
      //			gTypeOptimisation="xoptprod"
      //	FIN
      //	//			btnchgcie..visible = vrai
      fin
      
      //hsubstrep("?",repdonnees)
      connecter_usager()
      
      FichierVersMémoire(gcamions,camions)
      
      hcreationsiinexistant("*",hOuvertureDifférée)
      //hsecurite(1)
      gnCptessai est un entier
      
      BOUCLE
      	
      	hlitpremier("config","COCLEUNIK") 
      	si HErreurBlocage() alors
      		si Ouinon("Impossible de lire le fichier de configuration. Il est en utilisation exclusive sur un autre poste !!! "+RC+"Voulez-vous reessayer ?") = non alors
      			FinProgramme()
      		fin
      		
      		
      	sinon
      		sortir
      	FIN
      	
      	
      fin
      
      
      gclConfig est un Mconfig = allouer un Mconfig()
      GetConfig()
      si SansEspace(config.LienExtraArgon) = "" alors
      	config.LienExtraArgon = "EXTRA7"
      	hmodifie(config,hNumEnrEnCours)
      FIN
      
      
      
      
      gsExtraArgon est une chaine = sansespace(config.LienExtraArgon)
      gsExtraArgonDescription est une chaine
      gsExtraArgonGL est une chaine
      si hlitrecherche(invent,INUM,gsExtraArgon) ALORS
      	gsExtraArgonDescription = sansespace(invent.Idesc)
      	gsExtraArgonGL = sansespace(invent.ICODEGL)
      FIN
      gsExtraWarranty est une chaine = sansespace(config.LienExtraWarranty)
      gsExtraWarrantyDescription est une chaine
      gsExtraWarrantyGL est une chaine
      si hlitrecherche(invent,INUM,gsExtraWarranty) ALORS
      	gsExtraWarrantyDescription = sansespace(invent.Idesc)
      	gsExtraWarrantyGL = sansespace(invent.ICODEGL)
      FIN
      
      grExtraArgonPrice est un reel
      grExtraWarrantyPrice est un reel
      
      
      
      DescriptionVarInter1 = sansespace(gclconfig.m_sVariableIntercalaire1)
      DescriptionVarInter2 = sansespace(gclConfig.m_sVariableIntercalaire2)
      DescriptionVarInter3 = sansespace(gclConfig.m_sVariableIntercalaire3)
      DescriptionVarInter4 = sansespace(gclConfig.m_sVariableIntercalaire4)
      DescriptionVarInter5 = sansespace(gclConfig.m_sVariableIntercalaire5)
      gNoExtraDemi = sansespace(gclConfig.m_slienDemiThermos)
      gmessageajout = gclConfig.m_BCMessageAjout
      gmessagemodification = gclConfig.m_bCMessageModification
      WebServiceEDI = sansespace(gclConfig.m_sAdresseWebService)
      
      
      
      ThermosType est un tableau associatif (*, *, wlEntier) de chaînes
      ThermosType[0] = "Inconnu"
      ThermosType[1] = "Simple"
      ThermosType[2] = "Double"
      ThermosType[3] = "Triple"
      
      stPoidsThermos est une structure
      	eSimple est un numerique
      	eDouble est un numerique
      	eTriple est un numerique
      fin
      
      STNumberOfOrders est une structure
      	sCustomerNumber est une chaine
      	nNumberOfOrders est un entier
      FIN
      
      tabPoidsthermos est un tableau associatif de stPoidsThermos
      
      
      pour TOUT ThermosPoids 
      	lstpoidsthermos est un stpoidsthermos
      	lstpoidsthermos.eSimple = ThermosPoids.PoidsSimple
      	lstpoidsthermos.edouble = ThermosPoids.Poidsdouble
      	lstpoidsthermos.eTriple = ThermosPoids.PoidsTriple
      	
      	
      	tabPoidsthermos[thermospoids.Épaisseur] = lstpoidsthermos
      FIN
      
      
      
      ValeurJourLivraisonClient est un entier = 0
      
      valeurjourlivraison est un entier  = 0
      stJourLivraisonCamion est une structure
      	JourLIvraison est un entier
      	Camion est un entier
      fin
      
      //gJoursLivraisonClient est un tableau dynamique de tableau de  7 entier
      //gJoursLivraisonClient est un tableau associatif (*, *, wlEntier) de tableau de 7 entiers
      gJoursLivraisonClient est un tableau associatif de tableau de 7 stJourLivraisonCamion
      tafrequence est un tableau associatif (*, *, wlEntier) de stFrequence
      
      
      GtabSaison est un tableau dynamique de stLivraison
      
      GetJourLivraisonCompagnie()
      
      // periode de livraison par défaut
      gPeriodeLivraison est un entier = 0
      pour TOUT SaisonLivraison 
      	si SaisonLivraison.sActif alors 
      		gPeriodeLivraison = SaisonLivraison.IDSaisonLivraison
      		sortir
      	FIN
      FIN
      
      
      gIDCamionPickUP est un entier
      pour CHAQUE Camions 
      	si camions.PickUp alors
      		gIDCamionPickUP = camions.IDCamions
      		sortir
      	FIN
      FIN
      gFrequenceLivraison est un entier
      gDateReference est une Date
      
      
      gTaShippingType est un tableau associatif de chaines
      pour CHAQUE LoadingType 
      	gTaShippingType[LoadingType.IDLoadingType] = LoadingType.Abreviation
      FIN
      
      
      /// Connexion pour fichiers temporaires
      /// trdetail, trdetailliste,...........
      
      cnxConnexionTemp est une connexion
      sCheminTemporaire est une chaine = Sysrep(srAppData)+"\Production"
      SI PAS fRépertoireExiste(sCheminTemporaire) ALORS
      	fRepCrée(sCheminTemporaire)
      FIN
      
      SI pas HOuvreConnexion(cnxConnexionTemp, "", "", sCheminTemporaire, "", hAccèsHF7) ALORS
      
      
      FIN
      
      
      
      
      
      CAS EXCEPTION:
      	info(ExceptionInfo(errComplet))
      	hferme("*")
      	SuppressTemporaryFiles()
      	HFermeConnexion(gConnexionHF)
      	finprogramme()
      	
     type : 196608
   -
     code : |1-
      
     type : 196620
   -
     code : |1-
      
     type : 196626
   -
     code : |1+
      
      hferme("*")
      SuppressTemporaryFiles()
      HFermeConnexion(gConnexionHF)
      
      
     type : 196610
