      fin
      gtaFloatingButton est un tableau associatif de STButton
      
      
      gCamions est un tableau dynamique de gstcamion
      
      NbOfOrders est un tableau de STNumberOfOrders
      
      chemintempo est une chaine = ".\"+NetAdresseIP()
      
      
      
      si pas fFichierExiste(completerep(frepencours())+"production.ini") alors
      	fCopieFichier(completerep(frepencours())+"novy.ini",completerep(frepencours())+"production.ini")
      	fSupprime(completerep(frepencours())+"novy.ini")
      FIN
      
      GLOBAL
      	
      	fichieracompresser est une chaine      // nom du fichier a afficher dans la barre de message lors de la sauvegarde
      	gtotalthermosBL est un reel=0        // pour la liste de commande encours avecvaleur
      	gtotalcarrelagebl est un reel=0      // La liste commandes en bon de livraison
      	gtotalcarrelageptbl est un reel=0    // est un etat imbriqué
      	gtotalpeinturebl est un reel=0       // ces variables sont nécessaires pour avoir le total des BL
      	gtotalautresbl est un reel=0         //pour les inclures dans le grans total de laliste
      	gtotaltotalbl est un reel=0
      	
      	gHauteurLogo est un reel    // Hauteur et Largeur du logo a imprimer sur rapport commun
      	gLargeurLogo est un reel    //
      	
      	gTypeOptimisation est une chaine // Type d'optimisation Optima,Xopt ou Xopt Production
      	gmessageajout est un booleen     // affichage du message lors de l'ajout d'une commande
      	gmessagemodification est un booleen // affichage du message lors de la modification d'une commande
      	
      	CleUsb est un booleen = Faux
      	WebServiceEDI est une chaîne
      	gnManualOrderNumber est un entier  // pour savoir si la commande externe a un numéro de commande manuel.
      	
      	
      	
      	
      	
      	//	x_PRINTER_INFO_2 est une structure
      	//		pServerName est un entier
      	//		pPrinterName est un entier
      	//		pShareName est un entier
