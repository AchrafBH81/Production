  -
    name : BTN_MODIFIE
    identifier : 0x3e9d90dd07f6ea1a
    internal_properties : 
    properties :
     x : 212
     y : 4
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         
         restaure_bouton()
         modif = vrai
         //Code WinDev 5.5 remplacé par la migration :
         //saisie..etat = actif
         saisie..etat = actif; saisie..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         //numero..etat = grisé
         numero..etat = grisé; numero..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         //validation..etat = actif
         validation..etat = actif; validation..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         //fiche..etat = grisé
         fiche..etat = grisé; fiche..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         //table..etat = grisé
         table..etat = grisé; table..Visible=Vrai
         //htransactiondebut("tranport.trx")
         hinfogene("categclt")
         hlit("categclt",h.numenr)
         fichierversecran
         execute("catchargetransport..mod")
         reprisesaisie("categorieclient.description")
         
