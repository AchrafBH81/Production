  -
    name : BTN_OK
    identifier : 0x3e9d90dd4cd0ea60
    internal_properties : 
    properties :
     x : 50
     y : 4
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         ecranversfichier
         si ajout alors
         	hajoute("categclt")
         sinon
         	hmodifie("categclt")
             si pas categclt.catchargetransport alors
         		hlitrecherche("intkilo","ikclecatnum",categclt.categorie+caract(0))
         //Code WinDev 5.5 remplacé par la migration :
         //		tantque categclt.categorie = intkilo.ikcategorie  et pas h.endehors
         		tantque categclt.categorie = intkilo.ikcategorie  et pas HEnDehors()
         			hsupprime("intkilo")
         			hlitsuivant("intkilo","ikclecatnum")
         		FIN
         	FIN
         FIN
         //    htransactionfin()
         //Code WinDev 5.5 remplacé par la migration :
         //	saisie..etat = inactif
         	saisie..etat = AffichageSeulement; saisie..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         //	validation..etat = grisé
         	validation..etat = grisé; validation..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         //	fiche..etat = actif
         	fiche..etat = actif; fiche..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         //    kilo..etat = inactif
             kilo..etat = AffichageSeulement; kilo..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         //    table..etat =inactif
             table..etat =AffichageSeulement; table..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         //	tableaffiche("TABLE","*")
         	tableaffiche("TABLE",taCourantPremier)
         //Code WinDev 5.5 remplacé par la migration :
         //    execute("table..len")
             ExecuteTraitement("table",trtENTREELIGNE)
             ajout = faux
         	modif = faux
         
        type : 18
      -
        type : 161
        enabled : false
