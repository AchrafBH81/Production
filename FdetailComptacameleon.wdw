  procedures :
   -
     name : BalanceFacture
     procedure_id : 5139415303879817071
     type_code : 14
     code : |1+
      Procédure BalanceFacture()
      
      i est un entier
      total est un reel = 0
      pour i = 1 a tableoccurrence(Table_DetailCompta)
      	total+=(Table_DetailCompta.MontantGlivreCT[i]-Table_DetailCompta.MontantGlivreDT[i])
      
      FIN
      
      SI total = 0 ALORS
      	RENVOYER VRAI
      SINON
      	RENVOYER FAUX	
      FIN
     type : 458752
   -
     name : Trouvederniernoligne
     procedure_id : 5139415304387327855
     type_code : 14
     code : |1+
      Procédure Trouvederniernoligne()
       hlitdernier(RequeteDetailCompta,RequeteDetailCompta.noLigne)
       
      renvoyer RequeteDetailCompta.noLigne+1
     type : 458752
   -
     name : CalculTotalFacture
     procedure_id : 1482506037999427379
     type_code : 14
     code : |1+
      Procédure CalculTotalFacture()
      
      i est un entier
      csnTotalCredit=0
      csnTotalDebit=0
      pour i = 1 _a_ tableoccurrence(Table_DetailCompta)
      	csnTotalDebit+=Table_DetailCompta.MontantGlivredt[i]
      	csnTotalcredit+=Table_DetailCompta.MontantGlivrect[i]
      	
      
      FIN
      
      
      
