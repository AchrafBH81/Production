  -
    name : Libellé1
    identifier : 0x4752defd1c70776f
    internal_properties : 
    properties :
     x : 86
     y : 35
     width : 549
     height : 29
    type : 3
    code_elements :
     type_code : 2
     p_codes : []
  -
    name : Btn_Ok
    identifier : 0x4752defd66cf776f
    internal_properties : 
    properties :
     x : 77
     y : 9
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         
         i est un entier
         SI PAS BALANCEFACTURE() ALORS
         ACSO_message("Erreur","Cette transaction est hors balance","Erreur")
         	RENVOYER VRAI
         FIN
         pour i = 1 a tableoccurrence(Table_DetailCompta)
         
         	si hlitrecherche(RequeteDetailCompta,RequeteDetailCompta.noLigne,Table_DetailCompta.NoLigne[i]) alors
         		RequeteDetailCompta.NoGlivre = Table_DetailCompta.NoGlivre[i]
         		selon typededoc 
         			cas 1
         				si i = 1 alors
         					RequeteDetailCompta.MontantGlivre = Table_DetailCompta.MontantGlivredT[i] * -1
         				sinon	
         					RequeteDetailCompta.MontantGlivre = Table_DetailCompta.MontantGlivreCT[i]
         				fin
         
         			cas 2
         				si i = 1 alors
         					RequeteDetailCompta.MontantGlivre = Table_DetailCompta.MontantGlivrecT[i] 
         				sinon	
         					RequeteDetailCompta.MontantGlivre = Table_DetailCompta.MontantGlivredT[i] * -1
         				fin
         
         		FIN
         		hmodifie(RequeteDetailCompta,hNumEnrEnCours)
         	sinon
         		//    	DetailCompta.
         		DETAILCOMPTA.EstTaxe = FAUX
         		DetailCompta.numeroBL = NOBL
         		DETAILCOMPTA.NoGlivre = Table_DetailCompta.NoGlivre[i]
         		selon typededoc
         			cas 1
         				DetailCompta.MontantGlivre = Table_DetailCompta.MontantGlivreCT[i]
         			cas 2
         				DetailCompta.MontantGlivre = Table_DetailCompta.MontantGlivreCT[i] * -1
         		fin
                 DetailCompta.noLigne = trouveDernierNoLigne()
                 hajoute(detailcompta)
         //		info("ligne non trouvé")
         	fin
         fin
         si saisie1..Modifié alors
         	si hlitrecherche(BonLivraison,Bfacture,saisie1) alors
         		acso_message("Info","Ce numéro de facture existe déjà","Info")
         		saisie1 = anciennumero
         		reprisesaisie(saisie1)
         	sinon
         		si hlitrecherche(BonLivraison,Bfacture,anciennumero) alors
         			si acso_message("Question","Changement du numéro de facture "+anciennumero+ " vers " + saisie1,"OuiNon") = Idyes alors
         				BonLivraison.Bfacture = saisie1
         				hmodifie(BonLivraison,hnumenrencours)
                         anciennumero = saisie1
         		FIN
         	FIN
         fin
         
         	
         FIN
         
         si cstClient..Modifié alors
         	si pas hlitrecherche(client,numero,cstClient) alors
         		acso_message("Info","Numéro de client inexistant","Info")
         		cstClient = anciennumeroclient
         		RepriseSaisie(cstClient)
             sinon
         	
         	si hlitrecherche(BonLivraison,Bfacture,anciennumero) alors
         		si acso_message("Question","Changement du numéro de client "+anciennumeroclient+ " vers " + cstClient,"OuiNon") = Idyes alors
         			BonLivraison.Bclient = cstClient
         			hmodifie(BonLivraison,hnumenrencours)
         			si hlitrecherche(hfacture,fanumero,BonLivraison.BnoCommande) alors
         				hfacture.faclient = cstClient
         				anciennumeroclient = cstClient
         				HModifie(hfacture,hNumEnrEnCours)
         			FIN
         		FIN
         		reimpression.Table_Facture.#client[reimpression.Table_Facture] = cstclient
         		reimpression.Table_Facture.#client[reimpression.Table_Facture]..couleurfond = iCouleurDéfaut
         		reimpression.Table_Facture.#client[reimpression.Table_Facture]..couleur = iCouleurDéfaut
         
         	FIN
         
         fin
         
         FIN
         
         
         ExécuteTraitement(FdetailComptacameleon,trtInit)
        type : 18
      -
        type : 161
        enabled : false
