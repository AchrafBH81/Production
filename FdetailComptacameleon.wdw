 popup_menus : []
 message_bar :
  internal_properties : CQAAAAkAAAAkDGLBUXZk9Z7/s/mdYyeJlgLeF/JWFxOBWnAvAcX45Jcg44DHTxE7iAbsPqFy0eQ8N7m+LF051uk2IR5MFm21QtxXazs2rdXvnkVZfefSebhtx5WCeJgtNFd4Yw==
 actionbar : {}
 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1+
      	fonction fdetailcompta(NoBl,NoFact,typededoc = 2,noclient="")
      	anciennumero est un entier = nofact
      	anciennumeroclient est un entier = noClient
      
      
      
      
   -
     code : |1+
      
      descglivre est une chaine
      montantDT est un reel=0
      montantCT est un reel=0
      chaineaverifier est une chaine
      glnontrouve est un booleen
      IndiceCombo est un entier
      csntotaldebit=0
      csntotalcredit=0
      
      
      tablesupprimetout(Table_DetailCompta)
      //listeajoute(Table_DetailCompta.Point,gimage("aide3-5.bmp"))
      
      selon typededoc
      	cas 1	
      		libelle1 = "Affectation comptable pour la facture "+NoFact
      	cas 2
      		libelle1 = "Affectation comptable pour le crédit "+NoFact
      fin
      saisie1 = nofact	
      cstClient = noclient
      
      //hexecuterequete(RequeteDetailCompta,hRequêteDéfaut,nobl)
      hexecuterequete(RequeteDetailCompta,hModifieFichier,nobl)
      hlitpremier(requeteDétailcompta)
      
      tantque pas hendehors(requeteDétailcompta)
      	glnontrouve = faux
      	si RequeteDetailCompta.noLigne = 1 alors
              descglivre = "Comptes à recevoir"
      		IndiceCombo = 0
      	
      	sinon
      		si hlitrecherche(glivre,numerogl,sansespace(requetedetailcompta.NoGlivre)) alors
      			descglivre = glivre.Description
      			glnontrouve = vrai
      		sinon
      			descglivre = ""
      		FIN
           FIN
      selon typededoc
      	cas 1
      		si RequeteDetailCompta.noLigne = 1 alors
      			montantDT = arrondi(RequeteDetailCompta.MontantGlivre * -1,2)
      			montantCT = 0
      		sinon
      			montantDT = 0
      			montantCT = arrondi(RequeteDetailCompta.MontantGlivre,2)
      		fin
      		csntotaldebit+=montantDT
      		csntotalcredit+=montantCT
      
      
      		tableajouteligne(Table_DetailCompta,RequeteDetailCompta.NoGlivre,IndiceCombo,descglivre,montantDT,montantCT,...
      		RequeteDetailCompta.noLigne,faux)
      
      
      	cas 2		
      		si RequeteDetailCompta.noLigne = 1 alors
      			montantCT = RequeteDetailCompta.MontantGlivre 
      			montantDT = 0
      		sinon
      			montantCT = 0
      			montantDT = RequeteDetailCompta.MontantGlivre * -1
      		fin
      		csntotaldebit+=montantDT
      		csntotalcredit+=montantCT
      
      		tableajouteligne(Table_DetailCompta,RequeteDetailCompta.NoGlivre,IndiceCombo,descglivre,montantDT,montantCT,...
      		RequeteDetailCompta.noLigne,faux)
      
      FIN
      hlitsuivant(RequeteDetailCompta)
      fin
      
      tableaffiche(Table_DetailCompta)
      
     type : 34
