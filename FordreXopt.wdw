     x : 461
     y : 94
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         si Amode = "ajout" alors
         	OrdreTrtXopt.NoOrdre = OrdreTrt
         	OrdreTrtXopt.Composant1 = comp1
         	OrdreTrtXopt.Composant2= comp2	
         	OrdreTrtXopt.Composant3= comp3
         	OrdreTrtXopt.argon= gargon
             OrdreTrtXopt.QteUnPrep = g1rack
         	hajoute(OrdreTrtXopt)
         sinon
         	OrdreTrtXopt.NoOrdre = OrdreTrt
         	OrdreTrtXopt.Composant1 = comp1
         	OrdreTrtXopt.Composant2= comp2	
         	OrdreTrtXopt.Composant3= comp3
         	OrdreTrtXopt.argon= gargon
         	OrdreTrtXopt.QteUnPrep = g1rack
         	hmodifie(OrdreTrtXopt)
         
         FIN
         tableaffiche(Table_OrdreTrtXopt)
         FordreXopt..plan = 1
        type : 18
      -
        type : 161
        enabled : false
