  -
    name : BTN_ANNULE
    identifier : 0x26257603b58d35b8
    internal_properties : 
    properties :
     x : 76
     y : 4
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
             restaure_bouton()
         //    htransactionannule()
         //Code WinDev 5.5 remplacé par la migration :
         //    saisie..etat = inactif
             saisie..etat = AffichageSeulement; saisie..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         //	validation..etat = grisé
         	validation..etat = grisé; validation..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         //	fiche..etat = actif
         	fiche..etat = actif; fiche..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         //    kilo..etat = inactif
             kilo..etat = AffichageSeulement; kilo..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         //    table..etat =inactif
             table..etat =AffichageSeulement; table..Visible=Vrai
             modif = faux
         	ajout = faux
         //Code WinDev 5.5 remplacé par la migration :
         //	tableaffiche("TABLE","*")
         	tableaffiche("TABLE",taCourantPremier)
         //Code WinDev 5.5 remplacé par la migration :
         //    execute("table..len")
             ExecuteTraitement("table",trtENTREELIGNE)
         
         mafenetre..plan = 1
        type : 18
      -
        type : 161
        enabled : false
