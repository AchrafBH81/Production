  procedures :
   -
     name : calculateTotalQuotation
     procedure_id : 1803176993620908950
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] calculateTotalQuotation (<nQuotationNumber> est entier)
      //
      // Paramètres :
      //	nQuotationNumber (entier) : <indiquez ici le rôle de QuotationNumber>
      // Valeur de retour :
      // 	monétaire : <indiquez ici le rôle de la valeur de retour>
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure calculateTotalQuotation(nQuotationNumber est un entier)
      mototalligne est un monetaire
      moTotalcommande est un monetaire
      
      
      sTxtsqlTotal est une chaine = [
      SELECT 
      	Facture.fatypedocument AS fatypedocument,	
      	Facture.fatps AS fatps,	
      	Facture.fatvq AS fatvq,	
      	Fdetail.fdqte AS fdqte,	
      	Fdetail.fdqteafacturer AS fdqteafacturer,	
      	Fdetail.fdprixtotal AS fdprixtotal,	
      	Fdetail.surchargeenergie AS surchargeenergie,	
      	Fdetail.FDextra5x AS FDextra5x,	
      	Fdetail.FDextra10X AS FDextra10X,	
      	Fdetail.fpeinture AS fpeinture,	
      	Fdetail.fTotalPeinture AS fTotalPeinture,	
      	Facture.fanumero AS fanumero,	
      	Fdetail.fdnocomm AS fdnocomm,	
      	Facture.IDClient AS IDClient,	
      	Facture.FPREPARATION AS FPREPARATION,	
      	Fdetail.ftype AS ftype
      FROM 
      	Facture
      	RIGHT OUTER JOIN
      	Fdetail
      	ON Facture.fanumero = Fdetail.fdnocomm
      WHERE 
      	(
      	Facture.fanumero = {pNoComm}
      )
      ]
      
      sdReqsqltotal est une source de donnees
      sdReqsqltotal.pNoComm = nQuotationNumber
      si HExécuteRequêteSQL(sdReqsqltotal,hRequêteDéfaut,sTxtsqlTotal) alors
      	
      
      POUR TOUT sdReqsqltotal 
      	mototalligne		= 0
      	SELON sdReqsqltotal.ftype
      		CAS 1
      			mototalligne+=((Arrondi(sdReqsqltotal.fdprixtotal,2)+Arrondi(sdReqsqltotal.surchargeenergie,2)) ) + ((sdReqsqltotal.FDextra10X+sdReqsqltotal.FDextra5x))
      		CAS 2
      			mototalligne+=((Arrondi(sdReqsqltotal.fdprixtotal,2)+Arrondi(sdReqsqltotal.surchargeenergie,2)) ) + ((sdReqsqltotal.FDextra10X+sdReqsqltotal.FDextra5x))
      		CAS 3
      			mototalligne+=(Arrondi(sdReqsqltotal.fdprixtotal,2)) 
      		CAS 4
      			mototalligne+=(Arrondi(sdReqsqltotal.fdprixtotal,2)) 
      			SI sdReqsqltotal.fpeinture ALORS
      				mototalligne+=(Arrondi(sdReqsqltotal.fTotalPeinture,2)) * sdReqsqltotal.fdqteafacturer
      			FIN
      		CAS 5
      			mototalligne+=(Arrondi(sdReqsqltotal.fdprixtotal,2)) 
      			
      	FIN
      	
      	moTotalcommande+= mototalligne 
      FIN		 
      FIN
      
      
      RENVOYER moTotalcommande
      
     type : 458752
   -
     name : CheckIfManualPrice
     procedure_id : 1803243896489052849
     type_code : 14
     code : |1-
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] CheckIfManualPrice (<nIdcotation> est entier)
      //
      // Paramètres :
      //	nIdcotation (entier) : <indiquez ici le rôle de nIdcotation>
      // Valeur de retour :
      // 	entier : <indiquez ici le rôle de la valeur de retour>
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure CheckIfManualPrice(nIdcotation est un entier sur 8 octets)
      
      nNbThermos est un entier = 0
      
      
      sTxtsql est une chaine = [
      
         select cotationdetails.IDCotationDetails from cotationdetails where cotationdetails.idcotation = {pIdCotation} and (cotationdetails.GridBasePriceLock =1 or cotationdetails.SqFeetPriceLock = 1)
       ]
      
      sTxtsqlNB est une chaine = [
      select sum(cotationdetails.Quantity) as qty from cotationdetails where cotationdetails.idcotation = {pIdCotation}
      ]
      sdReqNbThermos est une source de donnees
      sdReqsqlmanual est une source de donnees
      sdReqsqlmanual.pIdCotation = nIdcotation
      si hexecuterequetesql(sdReqsqlmanual,hRequêteDéfaut,sTxtsql) alors
      	si hnbenr(sdReqsqlmanual) <> 0 alors
      		sdReqNbThermos.pidcotation = nIdcotation
      		si HExécuteRequêteSQL(sdReqNbThermos,hRequêteDéfaut,sTxtsqlNB) alors
      			hlit(sdReqNbThermos,1)
      			nNbThermos = sdReqNbThermos.qty
      		FIN
      	FIN
      FIN
      
      renvoyer nNbThermos
     type : 458752
