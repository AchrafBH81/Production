    name : BTN_Print
    identifier : 0x28fcda872c101cd1
    internal_properties : 
    properties :
     x : 658
     y : 30
     width : 42
     height : 42
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         
         si tabQuotation..Occurrence = 0 alors
         	erreur("Aucune donnée à afficher")
         	renvoyer Faux
         FIN
         tabQuotationForPrint est un tableau de STSoumissionVendeurForPrint
         stCurrentCotationforPrint est un STSoumissionVendeurForPrint
         
         Pour chaque stQuotation de tabQuotation 
         	pour chaque stCustomer de stQuotation.tabSoumissionCustomer
         		pour chaque stUniqueCotation de stCustomer.tabSoumissionSuivi
         			 stCurrentCotationforPrint = allouer un STSoumissionVendeurForPrint()
         			 stCurrentCotationforPrint.sSellername = stQuotation.sSellername
         			 stCurrentCotationforPrint.sCustomerNumber = stCustomer.sCustomerNumber
         			 stCurrentCotationforPrint.sCustomerName = stCustomer.sCustomerName
         			 stCurrentCotationforPrint.dQuotationDate = stUniqueCotation.dQuotationDate
         			 stCurrentCotationforPrint.sQuotationnumber = stUniqueCotation.sQuotationnumber
         			 stCurrentCotationforPrint.sOrderNumber = stUniqueCotation.sOrderNumber
         			 stCurrentCotationforPrint.nThermosQty = stUniqueCotation.nThermosQty
         			 stCurrentCotationforPrint.moTotal = stUniqueCotation.moTotal
         			 stCurrentCotationforPrint.bIsFromWeb = stUniqueCotation.bIsFromWeb
         			 tabQuotationForPrint.ajoute(stCurrentCotationforPrint)
         			 
         			 
         		FIN
         	FIN
         FIN
         
         
         
         
         
         iapercu()
         iImprimeEtat(ETAT_SuiviSoumission,tabQuotationForPrint,csddatedebut,csddatefin)
         
        type : 18
      -
        type : 161
        enabled : false
