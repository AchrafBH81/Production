    name : BtnRefresh
    identifier : 0x28fcda872c011cd1
    internal_properties : 
    properties :
     x : 572
     y : 11
     width : 80
     height : 80
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         
         tabQuotation.supprimetout()
         stCurrentQuotationSeller	est un STSoumissionVendeur
         stCurrentQuotationCustomer	est un STSoumissionCustomer
         stCurrentQuotation			est un STSoumissionSuivi
         moTotalQuotation est un monetaire
         nNbThermos est un entier 
         
         TABLEH_Quotation.supprimetout()
         stCurrentInvoices			est un STFactureEDIWEB 
         nRes						est un entier
         nResCustomer				est une entier
         
         sdReqsql					est une Source de Données
         sTxtsql						est une chaîne ANSI
         sdReqsqlTot					est une Source de Données
         sTxtsqlTot					est une chaîne ANSI
         
         nSellerTotalEDIWEB			est un entier	= 0
         nSellerTotal				est un entier	= 0
         nSellerTotalEDIQuotationWEB	est un entier	= 0
         nSellerTotalQuotation		est un entier	= 0
         
         nTotalEDIWEB				est un entier	= 0
         nTotal						est un entier	= 0
         nTotalQuotation				est un entier	= 0
         nGTotalQuotation			est un entier	= 0
         
         
         
         
         
         
         sTxtsql = [
         	select facture.fanumero,facture.fadate,facture.faclient,vendeur.nom as vendeurnom,client.nom,client.numero,facture.cvendeur ,facture.NumberOfThermosToProduce,
         	client.categorie,facture.fanocommande
         	from facture 
         	inner join client on client.numero = facture.faclient
         	inner join vendeur on vendeur.IDVendeur = facture.cvendeur
         	
         	where facture.fatypedocument = 3 and facture.fadate between {pBeginningdate} and {pEndingdate}
         	and facture.cvendeur = {psellerID}
         	
         	order by vendeur.IDVendeur,faclient
         	
         ]
         
         
         
         
         sdReqSqlQuotation		est une source de donnees
         sdReqSqlQuotationProd	est une source de donnees
         
         sdReqsql.pBeginningDate	= csddatedebut
         sdReqsql.pendingdate	= csddatefin
         si Combo_vendeur = 0 alors
         	sdReqsql.psellerID = null
         sinon
         	sdReqsql.pSellerID= Combo_vendeur		
         FIN
         sablier(faux)
         JAUGE_Attente..TexteJauge = "Récupération des soumissions de production"
         jauge_attente..visible = Vrai
         nCpt est un entier 
         nCpttotal est un entier
         
         
         
         SI HExécuteRequêteSQL(sdReqsql,hRequêteDéfaut,sTxtsql) ALORS
             nCpttotal  = hnbenr(sdReqsql)
             
         	pour tout sdReqsql
             nCpt++
                JAUGE_Attente = nCpt/nCpttotal * 100
                multitacherepeint(FEN_SuiviSoumission)   
         			moTotalQuotation = calculateTotalQuotation(sdReqsql.fanumero)
         		
         		selon sdReqsql.categorie 
         			CAS "1"
                        si moTotalQuotation < SAI_Manufacturier alors continuer
                        					
         			AUTRE CAS
         				SI moTotalQuotation < SAI_autres ALORS CONTINUER
         				
         		FIN
         
         		nRes = tabQuotation.Cherche(tcLinéaire,"nSellerID",sdReqsql.cvendeur)
         		si  nRes = -1 alors
         			stCurrentQuotationSeller					= allouer un STSoumissionvendeur()
         			stCurrentQuotationCustomer					= allouer un STSoumissionCustomer()
         			stCurrentQuotation							= allouer un STSoumissionSuivi()
         			stCurrentQuotation.dQuotationDate			= sdReqsql.fadate
         			stCurrentQuotation.sQuotationNumber			= sdReqsql.fanumero
         			stCurrentQuotation.sOrderNumber		= sdReqsql.fanocommande
         			
         			stCurrentQuotation.moTotal					= moTotalQuotation
         			stCurrentQuotation.nThermosQty				= sdReqsql.NumberOfThermosToProduce
         			
         			stCurrentQuotationCustomer.sCustomerNumber	= sdReqsql.Numéro
         			stCurrentQuotationCustomer.sCustomerName	= sdReqsql.nom
         			stCurrentQuotationCustomer.moTotal			= moTotalQuotation
         			stCurrentQuotationCustomer.nThermosQty		= sdReqsql.NumberOfThermosToProduce
         			stCurrentQuotationCustomer.tabSoumissionSuivi.ajoute(stCurrentQuotation)
         			
         			stCurrentQuotationSeller.nSellerID		= sdReqsql.cvendeur
         			stCurrentQuotationSeller.ssellername	= sdReqsql.vendeurnom
         			stCurrentQuotationSeller.moTotal		= moTotalQuotation
         			stCurrentQuotationSeller.nThermosQty	= sdReqsql.NumberOfThermosToProduce
         			stCurrentQuotationSeller.tabSoumissionCustomer.ajoute(stCurrentQuotationCustomer)
         			tabQuotation.ajoute(stCurrentQuotationSeller)
         		SINON
         			nResCustomer = tabQuotation[nRes].tabSoumissionCustomer.cherche(tcLinéaire,"sCustomerNumber",sdReqsql.Numéro)
         			si nResCustomer = -1 alors
         				stCurrentQuotationCustomer					= allouer un STSoumissionCustomer()
         				stCurrentQuotation							= allouer un STSoumissionSuivi()
         				stCurrentQuotation.dQuotationDate			= sdReqsql.fadate
         				stCurrentQuotation.sQuotationNumber			= sdReqsql.fanumero
         				stCurrentQuotation.sOrderNumber		= sdReqsql.fanocommande
         				stCurrentQuotation.moTotal					= moTotalQuotation
         				stCurrentQuotation.nThermosQty				= sdReqsql.NumberOfThermosToProduce
         				
         				stCurrentQuotationCustomer.sCustomerNumber	= sdReqsql.Numéro
         				stCurrentQuotationCustomer.sCustomername	= sdReqsql.nom
         				stCurrentQuotationCustomer.moTotal			= moTotalQuotation
         				stCurrentQuotationCustomer.nThermosQty		= sdReqsql.NumberOfThermosToProduce
         				stCurrentQuotationCustomer.tabSoumissionSuivi.Ajoute(stCurrentQuotation)
         				
         				tabquotation[nRes].moTotal		+= moTotalQuotation
         				tabquotation[nRes].nThermosQty	+= sdReqsql.NumberOfThermosToProduce
         				tabquotation[nRes].tabSoumissionCustomer.Ajoute(stCurrentQuotationCustomer)
         				
         			SINON
         				stCurrentQuotation							= allouer un STSoumissionSuivi()
         				stCurrentQuotation.dQuotationDate			= sdReqsql.fadate
         				stCurrentQuotation.sQuotationNumber			= sdReqsql.fanumero
         				stCurrentQuotation.sOrderNumber		= sdReqsql.fanocommande
         				
         				stCurrentQuotation.moTotal					= moTotalQuotation
         				stCurrentQuotation.nThermosQty				= sdReqsql.NumberOfThermosToProduce
         
         				tabQuotation[nRes].tabSoumissionCustomer[nResCustomer].moTotal			+= moTotalQuotation
         				tabQuotation[nRes].tabSoumissionCustomer[nResCustomer].nThermosQty		+= sdReqsql.NumberOfThermosToProduce
         				tabQuotation[nRes].tabSoumissionCustomer[nResCustomer].tabSoumissionSuivi.Ajoute(stCurrentQuotation)
         				
         				tabQuotation[nRes].moTotal		+= moTotalQuotation
         				tabQuotation[nRes].nThermosQty	+= sdReqsql.NumberOfThermosToProduce
         				
         				
         				
         			FIN
         			
         		FIN
         		
         		
         	FIN
         	
         FIN
         
         
         
         
         
         
         Sablier(Vrai)
         
         
         
         nCurrentLine		est un entier
         nSellerTotalEDIWEB				= 0
         nSellerTotal					= 0
         nSellerTotalEDIQuotationWEB		= 0
         nSellerTotalQuotation			= 0
         nCurrentSeller est un entier
         nCurrentCustomer est une entier
         nCurrentQuotation est un entier
         
         
         //pour chaque stQuotation de tabQuotation
         //	
         //	
         //	nCurrentSeller = TABLEH_Quotation.Ajouteligne(stQuotation.sSellername,"","","",stQuotation.moTotal,stQuotation.nThermosQty)
         //	TABLEH_Quotation[nCurrentSeller].CouleurFond = VertFoncé
         //	TABLEH_Quotation[nCurrentSeller].Couleur = blanc
         //	TABLEH_Quotation[nCurrentSeller].PoliceGras = vrai
         //		
         //	pour chaque stQuotationCustomer de stQuotation.tabSoumissionCustomer
         //		nCurrentCustomer = TABLEH_Quotation.Ajoutefils(nCurrentSeller,stQuotationCustomer.sCustomerNumber,stQuotationCustomer.sCustomername,"","",stQuotationCustomer.moTotal,stQuotationCustomer.nThermosQty)
         //		TABLEH_Quotation[nCurrentCustomer].CouleurFond	= GrisFoncé
         //		TABLEH_Quotation[nCurrentCustomer].Couleur		= Blanc
         //		TABLEH_Quotation[nCurrentCustomer].PoliceGras		= Vrai
         //        pour chaque stQuotationInvoice de stQuotationCustomer.tabSoumissionSuivi
         //			TABLEH_Quotation.AjouteFils(nCurrentCustomer,"","",stQuotationInvoice.dQuotationDate,stQuotationInvoice.sQuotationNumber,stQuotationInvoice.moTotal,stQuotationInvoice.nThermosQty)
         //        fin
         //        	
         //	FIN
         //FIN
         JAUGE_Attente = 200
         
         JAUGE_AttenteWeb..TexteJauge	= "Récupération des soumissions WEB"
         JAUGE_AttenteWeb..Visible		= Vrai
         nCpt = 0
         
         sTxtsqlWeb est une chaîne = [
         	select cotation.idcotation,cotation.CotationDate as fadate,cotation.IdCustomer,client.numero,client.nom,client.categorie,
         	client.cvendeur,cotation.CotationNumber as fanumero,cotation.CotationTotal from cotation
         	inner join client on client.IDClient = cotation.IdCustomer
         	where cotation.CotationDate between {pBeginningdate} and {pEndingdate} 
         	and client.cvendeur = {pSellerID} and cotation.isdeleted = 0
         ]
         
         sdReqSqlWeb est une source de donnees
         sdReqSqlWeb.pBeginningDate	= csddatedebut
         sdReqSqlWeb.pendingdate		= csddatefin
         SI Combo_vendeur = 0 ALORS
         	sdReqSqlWeb.psellerID = Null
         SINON
         	sdReqSqlWeb.pSellerID= Combo_vendeur		
         FIN
         
         
         si HExécuteRequêteSQL(sdReqSqlWeb,hRequêteDéfaut,sTxtsqlWeb) ALORS
         	nCpttotal = hnbenr(sdReqSqlWeb)
         	
         	pour TOUT sdReqSqlWeb 
         		nCpt++
         		JAUGE_AttenteWeb = nCpt/nCpttotal * 100
         		MultitâcheRepeint(FEN_SuiviSoumission)   
         		 nNbThermos = CheckIfManualPrice(sdReqSqlWeb.idcotation)
         		 si nNbThermos <> 0 alors 
         			SELON sdReqSqlWeb.categorie 
         				CAS "1"
         					SI sdReqSqlWeb.cotationtotal < SAI_Manufacturier ALORS CONTINUER
         					
         				AUTRE CAS
         					SI sdReqSqlWeb.cotationtotal < SAI_Autres ALORS CONTINUER
         					
         			FIN
         			
         			nRes = tabQuotation.Cherche(tcLinéaire,"nSellerID",sdReqSqlWeb.cvendeur)
         			SI  nRes = -1 ALORS
         				stCurrentQuotationSeller					= allouer un STSoumissionVendeur()
         				stCurrentQuotationCustomer					= allouer un STSoumissionCustomer()
         				stCurrentQuotation							= allouer un STSoumissionSuivi()
         				stCurrentQuotation.dQuotationDate			= sdReqSqlWeb.fadate
         				stCurrentQuotation.sQuotationNumber			= sdReqSqlWeb.fanumero
         				stCurrentQuotation.moTotal					= sdReqSqlWeb.cotationtotal
         				stCurrentQuotation.nThermosQty				= nNbThermos
         				stCurrentQuotation.bIsFromWeb  = vrai
         				stCurrentQuotationCustomer.sCustomerNumber	= sdReqSqlWeb.Numero
         				stCurrentQuotationCustomer.sCustomername	= sdReqSqlWeb.nom
         				stCurrentQuotationCustomer.moTotal			= sdReqSqlWeb.cotationtotal
         				stCurrentQuotationCustomer.nThermosQty		= nNbThermos
         				stCurrentQuotationCustomer.tabSoumissionSuivi.Ajoute(stCurrentQuotation)
         				
         				stCurrentQuotationSeller.nSellerID		= sdReqSqlWeb.cvendeur
         				stCurrentQuotationSeller.sSellername	= sdReqSqlWeb.vendeurnom
         				stCurrentQuotationSeller.moTotal		= sdReqSqlWeb.cotationtotal
         				stCurrentQuotationSeller.nThermosQty	= nNbThermos
         				stCurrentQuotationSeller.tabSoumissionCustomer.Ajoute(stCurrentQuotationCustomer)
         				tabQuotation.Ajoute(stCurrentQuotationSeller)
         			SINON
         				nResCustomer = tabQuotation[nRes].tabSoumissionCustomer.Cherche(tcLinéaire,"sCustomerNumber",sdReqSqlWeb.Numéro)
         				SI nResCustomer = -1 ALORS
         					stCurrentQuotationCustomer					= allouer un STSoumissionCustomer()
         					stCurrentQuotation							= allouer un STSoumissionSuivi()
         					stCurrentQuotation.dQuotationDate			= sdReqSqlWeb.fadate
         					stCurrentQuotation.sQuotationNumber			= sdReqSqlWeb.fanumero
         					stCurrentQuotation.moTotal					= sdReqSqlWeb.cotationtotal
         					stCurrentQuotation.nThermosQty				= nNbThermos
         					stCurrentQuotation.bIsFromWeb  = Vrai
         					
         					stCurrentQuotationCustomer.sCustomerNumber	= sdReqSqlWeb.Numero
         					stCurrentQuotationCustomer.sCustomername	= sdReqSqlWeb.nom
         					stCurrentQuotationCustomer.moTotal			= sdReqSqlWeb.cotationtotal
         					stCurrentQuotationCustomer.nThermosQty		= nNbThermos
         					stCurrentQuotationCustomer.tabSoumissionSuivi.Ajoute(stCurrentQuotation)
         					
         					tabQuotation[nRes].moTotal		+= sdReqSqlWeb.cotationtotal
         					tabQuotation[nRes].nThermosQty	+= nNbThermos
         					tabQuotation[nRes].tabSoumissionCustomer.Ajoute(stCurrentQuotationCustomer)
         					
         				SINON
         					stCurrentQuotation							= allouer un STSoumissionSuivi()
         					stCurrentQuotation.dQuotationDate			= sdReqSqlWeb.fadate
         					stCurrentQuotation.sQuotationNumber			= sdReqSqlWeb.fanumero
         					stCurrentQuotation.moTotal					= sdReqSqlWeb.cotationtotal
         					stCurrentQuotation.nThermosQty				= nNbThermos
         					stCurrentQuotation.bIsFromWeb  = Vrai
         					
         					tabQuotation[nRes].tabSoumissionCustomer[nResCustomer].moTotal			+= sdReqSqlWeb.cotationtotal
         					tabQuotation[nRes].tabSoumissionCustomer[nResCustomer].nThermosQty		+= nNbThermos
         					tabQuotation[nRes].tabSoumissionCustomer[nResCustomer].tabSoumissionSuivi.Ajoute(stCurrentQuotation)
         					
         					tabQuotation[nRes].moTotal		+= sdReqSqlWeb.cotationtotal
         					tabQuotation[nRes].nThermosQty	+= nNbThermos
         					
         					
         					
         				FIN
         				
         			FIN
         			
         		 	
         		 	
         		 	
         		 	
         		 	
         		 	
         		 	
         		 	
         		 	
         		 FIN
         	FIN
         FIN
         
         tabQuotation.Trie(ttMembre,"ssellername")
         POUR CHAQUE stQuotation de tabQuotation
         	stQuotation.tabSoumissionCustomer.Trie(ttMembre+tccRespecteNumérique,"sCustomerNumber")
         	POUR CHAQUE stCustomer de stQuotation.tabSoumissionCustomer
         		stCustomer.tabSoumissionSuivi.Trie(ttMembre,"sQuotationNumber")
         	FIN
         	
         FIN
         
         POUR CHAQUE stQuotation de tabQuotation
         	
         	
         	nCurrentSeller									= TABLEH_Quotation.AjouteLigne(stQuotation.sSellername,"","","","",stQuotation.moTotal,stQuotation.nThermosQty)
         	TABLEH_Quotation[nCurrentSeller].CouleurFond	= VertFoncé
         	TABLEH_Quotation[nCurrentSeller].Couleur		= Blanc
         	TABLEH_Quotation[nCurrentSeller].PoliceGras		= Vrai
         	
         	POUR CHAQUE stQuotationCustomer de stQuotation.tabSoumissionCustomer
         		nCurrentCustomer									= TABLEH_Quotation.AjouteFils(nCurrentSeller,stQuotationCustomer.sCustomerNumber,stQuotationCustomer.sCustomername,"","","",stQuotationCustomer.moTotal,stQuotationCustomer.nThermosQty)
         		TABLEH_Quotation[nCurrentCustomer].CouleurFond		= GrisFoncé
         		TABLEH_Quotation[nCurrentCustomer].Couleur			= Blanc
         		TABLEH_Quotation[nCurrentCustomer].PoliceGras		= Vrai
         		POUR CHAQUE stQuotationInvoice de stQuotationCustomer.tabSoumissionSuivi
         			nCurrentQuotation = TABLEH_Quotation.AjouteFils(nCurrentCustomer,"","",stQuotationInvoice.dQuotationDate,stQuotationInvoice.sQuotationNumber,stQuotationInvoice.sOrderNumber,stQuotationInvoice.moTotal,stQuotationInvoice.nThermosQty,stQuotationInvoice.bIsFromWeb)
         		FIN
         		
         	FIN
         FIN
         
         
         
         //nCurrentLine												= TABLEH_Quotation.Ajouteligne("Nombre de clients :" + gtaNbClient[nLastsellerid],Répète(" ",80)+"Total","",nSellerTotalEDIWEB,nSellerTotal,"",nSellerTotalEDIQuotationWEB,nSellerTotalQuotation)
         //TABLEH_Quotation[nCurrentLine]..PoliceGras					= Vrai
         //TABLEH_Quotation[nCurrentLine]..Couleur						= Blanc
         //TABLEH_Quotation[nCurrentLine]..CouleurFond					= GrisFoncé
         //nCurrentLine												= TABLEH_Quotation.AjouteLigne("Nouveaux clients :" + gtaNbClientPeriod[nLastsellerid],"","")
         ////TABLEH_OrderWEB.COL_CustomerName[nCurrentLine].fusion = fusionCelluleSuivante
         //TABLEH_Quotation[nCurrentLine]..PoliceGras					= Vrai
         //TABLEH_Quotation[nCurrentLine]..Couleur						= Blanc
         //TABLEH_Quotation[nCurrentLine]..CouleurFond					= GrisFoncé
         JAUGE_AttenteWeb = 200
         multitache(100)
         
         JAUGE_Attente..Visible = Faux
         JAUGE_Attenteweb..Visible = Faux
         
         TABLEH_Quotation.EnrouleTout()
         
         sablier(faux)
         
         
         
        type : 18
