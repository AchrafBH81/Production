 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1+
      procedure resultatRecherche(_nofacture = 0,_notrecommande = 0)
      req1 est une source de donnees
      hlitrecherche(hfacture,fanumero,_nofacture)
      hexecuterequetesql(req1,"select * from hfdetail where hfcleunik = "+hfacture.hfcleunik + "  order by fdligne" )
      pour tout req1
      	tableajouteligne(table1,faux,req1.fdligne,req1.fdnumprod,req1.fddesc,req1.fdlargeura,req1.fdhauteura,req1.ffini,req1.fdcarrelage)
      FIN
      
