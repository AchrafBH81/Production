  -
    name : BTN_IMPRIME_2
    identifier : 0x5206516c5942d7ff
    internal_properties : 
    properties :
     x : 748
     y : 54
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         i est un entier
         _noligne est une chaine = ""
         
         pour i = 1 a Table1..Occurrence
         	si table1.choix[i] alors
         		_noligne+= table1.NoLigne[i]+";"
         	FIN
         	
         FIN
         iapercu(100)
         SI _noligne  <> ""  ALORS
         //    ouvre(resultatRecherche,tableresultat.NOTRECOMMANDE[tableresultat])
         	iimprimeetat(ListeRecherche1,_nofacture,_nofacture,_noligne)
         FIN
         //iimprimeetat(ListeRecherche,"6968","6968")
         
         
         
         
         
         
         
         
         
        type : 18
      -
        type : 161
        enabled : false
