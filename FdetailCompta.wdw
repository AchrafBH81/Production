        type_code : 3
        p_codes :
         -
           code : |1+
            SI table_DetailCompta.NoGlivre[Table_DetailCompta] <> "" ALORS
            	chaineaverifier est une chaine = ACGL_FicheExiste(table_DetailCompta.NoGlivre[Table_DetailCompta])
            	descglivre est une chaine = extraitchaine(chaineaverifier,2,","	)
            	si Table_DetailCompta <> 1 alors
            		si extraitchaine(chaineaverifier,1,","	) = "0" alors
            			acso_message("Erreur","Compte de Grand Livre inexistant","Erreur")
            
            		sinon
            			Table_DetailCompta.Desc[Table_DetailCompta]..couleur = inoir 
            			Table_DetailCompta.Desc[Table_DetailCompta] = descglivre 
            		FIN
            	fin
            SINON
            	si hlitrecherche(RequeteDetailCompta,RequeteDetailCompta.noLigne,Table_DetailCompta.Noligne[Table_DetailCompta]) alors
            		hsupprime(RequeteDetailCompta,hNumEnrEnCours)
            	FIN
            	TableSupprime(Table_DetailCompta,Table_DetailCompta)
            FIN
            
