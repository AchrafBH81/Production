 message_bar :
  internal_properties : CQAAAAkAAAAgEGb1tUo4GfLrB30B56s9au7KA66e//OxqsBmqNzlHLc46ygvd4mr+GZcnjn6HajgS92SYBmdWpVa7XqQR0dq/jgjN1faWQHbirE1EXNO9TThs7luVHwRKFt8Zw==
 actionbar : {}
 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1+
      	fonction fdetailcompta(NoBl,NoFact,typededoc = 2,ldatefac="")
      	anciennumero est un entier = nofact
      	
      
      
      
      
   -
     code : |1+
      
      descglivre est une chaine
      montantDT est un reel
      montantCT est un reel
      chaineaverifier est une chaine
      glnontrouve est un booleen
      IndiceCombo est un entier
      tablesupprimetout(Table_DetailCompta)
      listeajoute(Table_DetailCompta.Point,gimage("aide3-5.bmp"))
      
      selon typededoc
      cas 1	
      libelle1 = "Affectation comptable pour la facture "+NoFact
      cas 2
      	libelle1 = "Affectation comptable pour le crédit "+NoFact
      fin
      saisie1 = nofact	
      csddate=ldatefac
      
      //hexecuterequete(RequeteDetailCompta,hRequêteDéfaut,nobl)
      hexecuterequete(RequeteDetailCompta,hModifieFichier,nobl)
      hlitpremier(requeteDétailcompta)
      
      tantque pas hendehors(requeteDétailcompta)
          glnontrouve = faux
      	si RequeteDetailCompta.noLigne = 1 alors
      		descglivre = "Comptes à recevoir"
      		IndiceCombo = 0
      	sinon
      		chaineaverifier = ACGL_FicheExiste(RequeteDetailCompta.NoGlivre)
      		descglivre = extraitchaine(chaineaverifier,2,","	)
      		IndiceCombo = 1
      		si extraitchaine(chaineaverifier,1,","	) = "0" alors
      			glnontrouve = vrai
      		FIN
      	FIN
      	selon typededoc
      		cas 1
      			si RequeteDetailCompta.noLigne = 1 alors
      				montantDT = RequeteDetailCompta.MontantGlivre * -1
      				montantCT = 0
      			sinon
      				montantDT = 0
      				montantCT = RequeteDetailCompta.MontantGlivre
      			fin
      
      
      			tableajouteligne(Table_DetailCompta,RequeteDetailCompta.NoGlivre,IndiceCombo,descglivre,montantDT,montantCT,...
      			RequeteDetailCompta.noLigne,glnontrouve)
      		
      		
      		cas 2		
      			si RequeteDetailCompta.noLigne = 1 alors
      				montantCT = RequeteDetailCompta.MontantGlivre 
      				montantDT = 0
      			sinon
      				montantCT = 0
      				montantDT = RequeteDetailCompta.MontantGlivre * -1
      			fin
      
      			tableajouteligne(Table_DetailCompta,RequeteDetailCompta.NoGlivre,IndiceCombo,descglivre,montantDT,montantCT,...
      			RequeteDetailCompta.noLigne,glnontrouve)
      
      	FIN
      	hlitsuivant(RequeteDetailCompta)
      fin
      
      tableaffiche(Table_DetailCompta)
      reprisesaisie(Table_DetailCompta)
      
     type : 34
   -
     type : 180
     enabled : false
   -
     type : 230
     enabled : false
   -
     type : 11
   -
     type : 12
   -
     type : 17
   -
     type : 13
  procedures :
   -
     name : BalanceFacture
     procedure_id : 4888890062849667904
     type_code : 14
     code : |1+
      Procédure BalanceFacture()
      
      i est un entier
      total est un reel = 0
      pour i = 1 a tableoccurrence(Table_DetailCompta)
      	total+=(Table_DetailCompta.MontantGlivreCT[i]-Table_DetailCompta.MontantGlivreDT[i])
      
      FIN
      
      SI total = 0 ALORS
      	RENVOYER VRAI
      SINON
      	RENVOYER FAUX	
      FIN
     type : 458752
   -
     name : Trouvederniernoligne
     procedure_id : 4888907930674524019
     type_code : 14
     code : |1+
      Procédure Trouvederniernoligne()
       hlitdernier(RequeteDetailCompta,RequeteDetailCompta.noLigne)
       
      renvoyer RequeteDetailCompta.noLigne+1
     type : 458752
