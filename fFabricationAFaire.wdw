     -
       internal_properties : CQAAAAkAAABhFcD6TlMS3U9iGm8MKN0uz79AHzukJf3U/AgisKWZICKKsk4A/Z3a06amzhbSEHhLrarLw6fi5aSiVXYWWSHUdFwt8fzopst2UviFMlD2dBVtM0dwgjQVGAX2qRNTJsFkvvryCgZ2CSTi7GD7gVu2z51iVPRAWU9pD/A88WdIZe+VqS/0Lygp
     -
       internal_properties : CQAAAAkAAABIbjkTurUPpXtsAea/TYhPzWiYkEYEch1cXkF2DovPZnVG8iNsW64Ajre5iYIP3HfI+m4zez2it6SqxqsRf1tx0LWSMZ8cfLmBg0mb6N8QxfMKSA3F0rq1nYh7G230ACzEFXWWNaSy4ZFBrpdmKZqMBNuoPbgM94vmJ5EhDgjJy0yrZxooZKBK+j7I
    type : 6
    controls : []
    code_elements :
     type_code : 6
     p_codes :
      -
        code : |1+
         selon moimeme
         	// Rapport de fabrication
         	CAS 1
         		IntSautPage..visible = faux
         	// Rapport de livraison
         	CAS 2
         		IntSautPage..Visible = vrai
         	// Rapport pour chargement
         	CAS 3
         		IntSautPage..Visible = Faux
         FIN
        type : 17
  -
    name : Btn_Ok
    identifier : 0x4c3ce6f70511cf71
    internal_properties : 
    properties :
     x : 600
     y : 27
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         
         
         selon rbReportType
         	cas 1:
         		
         		sablier(vrai)
         		RequeteProductionaFaire.pDate = csddatedebut
         		
         		HExécuteRequête(RequeteProductionaFaire)
         		
         		//hcreation(trdetailListe)
         		SI PAS HSupprimeTout(trdetailListe) ALORS
         			Erreur(HErreurInfo(hErrMessage))
         			RENVOYER Faux
         		FIN
         		pour tout RequeteProductionaFaire
         			HCopieEnreg(trdetailListe,RequeteProductionaFaire)
         			trdetailListe.TNoclient			= RequeteProductionaFaire.faclient
         			trdetailListe.fAdresseLivraison	= RequeteProductionaFaire.adresselivraison
         			
         			hajoute(trdetailListe)
         		FIN
         		
         		HExécuteRequête(RequeteDetailUnJourV1)
         		
         		modeLivraison est un booléen=rbReportType=2
         		iConfigure(imprimanterapport)
         		
         		si SélecteurDestination = 1 alors
         			iapercu()
         		fin
         		iEnchaînementAjoute(EFabricationaFaire,csddatedebut,modeLivraison)
         		//		iImprimeEtat(eFabricationaFaire,csddatedebut,modeLivraison)
         		//		si SélecteurDestination = 1 alors
         		//			iapercu()
         		//		fin
         		
         		iEnchaînementAjoute(EFabricationaFaireCarrelage,csddatedebut,modeLivraison)
         		//		iImprimeEtat(EFabricationaFaireCarrelage,csddatedebut,modeLivraison)
         		sablier(faux)
         		iEnchaînementImprime()
         	Cas 2:
         		
         		RequeteProductionaFaire.pDate = csddatedebut
         		
         		HExécuteRequête(RequeteProductionaFaire)
         		
         		//	HCréation(trdetailListe)
         		SI PAS HSupprimeTout(trdetailListe) ALORS
         			Erreur(HErreurInfo(hErrMessage))
         			RENVOYER Faux
         		FIN
         		POUR TOUT RequeteProductionaFaire
         			hraz(trdetailListe)
         			HCopieEnreg(trdetailListe,RequeteProductionaFaire)
         			trdetailListe.TNoclient			= RequeteProductionaFaire.faclient
         			trdetailListe.fAdresseLivraison	= RequeteProductionaFaire.adresselivraison
         			SELON RequeteProductionaFaire.facalcul
         				CAS 1
         					trdetailListe.fdlargeur	= Arrondi(Val(RequeteProductionaFaire.fdlargeur) * 25.4)
         					trdetailListe.fdhauteur	= Arrondi(Val(RequeteProductionaFaire.fdhauteur) * 25.4)
         					
         				CAS 2
         					trdetailListe.fdlargeur	= Val(RequeteProductionaFaire.fdlargeur) * 1000
         					trdetailListe.fdhauteur	= Val(RequeteProductionaFaire.fdhauteur) * 1000
         					
         					
         				AUTRE CAS
         					
         			FIN		
         			SI val(trdetailListe.fdlargeur) > 850 _ET_ val(trdetailListe.fdhauteur) > 850 ALORS
         				trdetailListe.fdmatch = Vrai
         			sinon
         				trdetailListe.fdmatch = faux
         				
         			FIN
         			
         			si hlitrecherche(client,numero,RequeteProductionaFaire.faclient) alors
         				si RequeteProductionaFaire.adresselivraison > 0 _et_ hlitrecherche(ClientLivraison,IDClientLivraison,RequeteProductionaFaire.adresselivraison) alors
         					si clientlivraison.IDLoadingType <> 0 alors
         						trdetailListe.LoadingType = gTaShippingType[Clientlivraison.IDLoadingType]
         						
         					sinon
         						SI  Client.IDLoadingType <> 0 ALORS
         							trdetailListe.LoadingType = gTaShippingType[Client.IDLoadingType]
         						FIN
         						
         					FIN
         					
         					
         				sinon
         					
         					si  client.IDLoadingType <> 0 alors
         						trdetailliste.LoadingType = gTaShippingType[client.IDLoadingType]
         					fin
         				FIN
         				
         			FIN
         			
         			si hlitrecherche(racking,OrderNumberOrderDetailLineAlreadyOnTag,[RequeteProductionaFaire.fanumero]) _et_ racking.TruckChange alors
         				trdetailListe.ShippingSequence = racking.ShippingSequence
         				
         			sinon
         				si checkifMasterConfig(RequeteProductionaFaire.adresselivraison) alors
         					SI HLitRecherche(JourLivraisonClient,IDClientIDSaisonLivraison,[Client.IDClient,GetIdSaison(RequeteProductionaFaire.FDATEREQUISE),0]) ALORS
         						trdetailListe.ShippingSequence = JourLivraisonClient.ShippingSequence[DateVersJour(RequeteProductionaFaire.FDATEREQUISE)]
         					FIN
         					
         				sinon
         					SI HLitRecherche(JourLivraisonClient,IDClientIDSaisonLivraison,[Client.IDClient,GetIdSaison(RequeteProductionaFaire.FDATEREQUISE),RequeteProductionaFaire.adresselivraison]) ALORS
         						trdetailListe.ShippingSequence = JourLivraisonClient.ShippingSequence[DateVersJour(RequeteProductionaFaire.FDATEREQUISE)]
         					FIN
         					
         					
         				FIN
         			FIN
         			
         			
         			HAjoute(trdetailListe)
         		FIN
         		
         		
         		
         		
         		
         		HExécuteRequête(RequeteDetailUnJourV1ParCamion)
         		
         		//		modeLivraison est un booléen=rbReportType=2
         		iConfigure(imprimanterapport)
         		
         		SI SélecteurDestination = 1 ALORS
         			iAperçu()
         		FIN
         		iEnchaînementAjoute(EFabricationaFaireParCamionNew,csddatedebut,Vrai,IntSautPage)
         		//		iImprimeEtat(EFabricationaFaireParCamion,csddatedebut,vrai,IntSautPage)
         		//		SI SélecteurDestination = 1 ALORS
         		//			iAperçu()
         		//		FIN
         		ienchainementajoute(EFabricationaFaireCarrelage,csddatedebut,vrai)
         		//		iImprimeEtat(EFabricationaFaireCarrelage,csddatedebut,vrai)
         		iEnchaînementImprime()
         		
         		
         		
         		
         		
         	cas 3:
         		
         		RequeteListeChargementcamion.pDate=csddatedebut
         		
         		
         		HExécuteRequête(RequeteListeChargementcamion)
         		iparametre("ORIENTATION=PAYSAGE")
         		iConfigure(imprimanterapport)
         		
         		si SélecteurDestination = 1 alors iapercu()
         		iparametre("ORIENTATION=PAYSAGE")
         		iImprimeEtat(ListeChargementcamion,csddatedebut,modeLivraison)
         FIN
        type : 18
      -
        type : 161
        enabled : false
