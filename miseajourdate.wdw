   -
     type : 13
  procedures :
   -
     name : ModifierCommande
     procedure_id : 5216218931475081426
     type_code : 14
     code : |1+
      Procédure ModifierCommande()
      lexception5 est un booleen = faux
      lexception10 est un booleen = faux
      saisie1..Libellé = "Facture en cours ..."
      HLitpremier(facture,fanumero)
      
      tantque pas HEnDehors(Facture)
      	saisie1 = facture.fanumero
      	MultitacheRepeint(miseajourdate)
      	multitache(1)
      	hlitrecherche(client,numero,facture.faclient)
      	//	si facture.fanumero >= 50124 alors
      	hlitrecherche(fdetail,fdnocomm,facture.fanumero)
      	tantque pas hendehors(fdetail) et fdetail.fdnocomm = facture.fanumero
      		si fdetail.ftype = 1 alors
      			lexception10 = faux
      			lexception5 = faux
      			si pas hlitrecherche(thermosClient,IdClientIdhermos,HConstruitValClé(thermosclient,IdClientidhermos,sansespace(client.numero),sansespace(fdetail.fdnumprod))) alors
      				si hlitrecherche(persoens,ennumero,fdetail.fdnumprod)
      					selon facture.facalcul 
      						cas 1
      							fdetail.fdprixupied= persoens.enprixa
      							//							fdetail.surchargeenergie = calculsurcharge(fdetail.fdprixtotal,fdetail.ftype)
      							//							fdetail.SUrchargeafacturer = fdetail.surchargeenergie * fdetail.fdqteafacturer / fdetail.fdqte
      							//							fdetail.SUrchargedejafacture = fdetail.surchargeenergie - fdetail.SUrchargeafacturer
      
      						cas 2
      							fdetail.fdprixupied= persoens.enprixm
      					FIN
      					selon client.CImpressionAngMet
      						cas 1
      							fdetail.fdprixu = fdetail.fdpiedcarrefacture * persoens.enprixa
      							fdetail.fdprixtotal = fdetail.fdqte * fdetail.fdprixu
      							fdetail.fdprixupiedfacture = persoens.enprixa
      						cas 2
      							fdetail.fdprixu = fdetail.fdpiedcarrefacture * persoens.enprixm
      							fdetail.fdprixtotal = fdetail.fdqte * fdetail.fdprixu
      							fdetail.fdprixupiedfacture = persoens.enprixm
      
      					FIN
      					si val(fdetail.fdhauteur) <> 0 et val(fdetail.fdlargeur) <> 0 alors
      						si val(fdetail.fDLARGEUR) > val(fdetail.fDHAUTEUR) alors
      							si partieentiere(val(fdetail.fDLARGEUR)/val(fdetail.fdhauteur)) >= 10 alors
      								lexception10 = vrai
      							sinon si partieentiere(val(fdetail.fDLARGEUR)/val(fdetail.fdhauteur)) >= 5 alors
      								lexception5= vrai
      							fin
      						sinon
      							si partieentiere(val(fdetail.fDhauteur)/val(fdetail.fdlargeur)) >= 10 alors
      								lexception10 = vrai
      							sinon si partieentiere(val(fdetail.fDhauteur)/val(fdetail.fdlargeur)) >= 5 alors
      								lexception5= vrai
      							fin
      
      					FIN
      				fin
      
      
      				si lexception5 alors
      					fdetail.FDextra5x = fdetail.fdprixu * config.Exception5 / 100
      				sinon
      					fdetail.FDextra5x = 0					
      				FIN
      				si lexception10 <> 0 alors
      					fdetail.FDextra10x = fdetail.fdprixu * config.Exception10 / 100
      				sinon
      					fdetail.FDextra10x = 0					
      				FIN
      //				fdetail.surchargeenergie = calculsurcharge(fdetail.fdprixtotal+(fdetail.fdqte * (fdetail.FDextra10X+fdetail.FDextra5x)),fdetail.ftype)
      				fdetail.surchargeenergie = calculsurcharge(fdetail.fdprixtotal+(fdetail.fdqte * (fdetail.FDextra10X+fdetail.FDextra5x)),...
      				fdetail.fdcarrprixtotal,fdetail.fdextraforme*fdetail.fdqte,fdetail.ftype)
      
      				fdetail.SUrchargeafacturer = fdetail.surchargeenergie * fdetail.fdqteafacturer / fdetail.fdqte
      				fdetail.SUrchargedejafacture = fdetail.surchargeenergie - fdetail.SUrchargeafacturer
      				fdetail.fdprixtotal += fdetail.fdqte * fdetail.fdextraforme
      				HModifie(fdetail,hNumEnrEnCours)
      
      				hlitrecherche(BonLivraison,BnoCommande,fdetail.fdnocomm)
      				tantque pas hendehors(BonLivraison) et BonLivraison.BnoCommande = fdetail.fdnocomm
      					//		si hlitrecherche(BonLivraison,BnoCommande,fdetail.fdnocomm) alors
      					si BonLivraison.bfacture = 0 alors
      						si hlitrecherche(hfacture,Bnumero,BonLivraison.bnumero) alors
      							hlitrecherche(hfdetail,HFCLEUNIK,hfacture.HFCLEUNIK)
      							tantque pas hendehors(hfdetail) et hfdetail.HFCLEUNIK = hfacture.HFCLEUNIK
      								si hfdetail.ftype = 1 et hfdetail.fdligne= fdetail.fdligne alors
      									hfdetail.fdprixupied= fdetail.fdprixupied
      									hfdetail.fdprixu = fdetail.fdpiedcarrefacture * fdetail.fdprixupied
      									hfdetail.fdprixtotal = hfdetail.fdqteafacturer * hfdetail.fdprixu
      									hfdetail.fdprixupiedfacture = fdetail.fdprixupied
      									hfdetail.FDextra10X = fdetail.FDextra10X
      									hfdetail.FDextra5X = fdetail.FDextra5X
      									hfdetail.SUrchargeafacturer = fdetail.surchargeenergie * hfdetail.fdqteafacturer / fdetail.fdqte
      									hfdetail.surchargeenergie = fdetail.surchargeenergie * hfdetail.fdqteafacturer / fdetail.fdqte
      									hfdetail.fdprixtotal += hfdetail.fdqteafacturer * hfdetail.fdextraforme
      									HModifie(hfdetail,hnumenrencours)
      								FIN
      								hlitsuivant(hfdetail,HFCLEUNIK)
      							FIN
      					FIN
      					HLitSuivant(BonLivraison,BnoCommande)
      				fin
      
      			fin
      		fin
      	fin
      fin
      
      hlitsuivant(fdetail,fdnocomm)
      FIN
      //fin
      HLitSuivant(Facture,fanumero)
      FIN
      
      multitache(100)
      
      
     type : 458752
   -
     name : ModifierCommandeSeulement
     procedure_id : 5218112758969274106
     type_code : 14
     code : |1+
      Procédure ModifierCommandeSeulement(Ladate = datesys())
      lexception5 est un booleen = faux
      lexception10 est un booleen = faux
      saisie1..Libellé = "Facture en cours ..."
      resultatcalcul est une chaine
      _prixa est un reel
      _prixm est un reel
      pdebase est une chaine
      
      HLitpremier(facture,fanumero)
      
      tantque pas HEnDehors(Facture)
      
      	saisie1 = facture.fanumero
      
      	si facture.fadate >= Ladate alors
      		HLitSuivant(facture,fanumero)
      		continuer
      	FIN
      	MultitacheRepeint(miseajourdate)
      	multitache(1)
      	hlitrecherche(client,numero,facture.faclient)
      	//si facture.fanumero = 48932 alors
      
      	hlitrecherche(fdetail,fdnocomm,facture.fanumero)
      	tantque pas hendehors(fdetail) et fdetail.fdnocomm = facture.fanumero
      		si pas hlitrecherche(persoens,ennumero,fdetail.fdnumprod) alors goto sortiepasdenothermos
      		si sansespace(fdetail.fdbase) = "" alors pdebase = sansespace(persoens.epbase) sinon pdebase = sansespace(fdetail.fdbase)
      
      		si fdetail.ftype = 1 et pas fdetail.FDprixmodifie alors
      			lexception10 = faux
      			lexception5 = faux
      			resultatcalcul = CalculPrixThermos(fdetail.fdnumprod,client.IDClient,fdetail.fdcomposant1,fdetail.fdcomposant2,fdetail.fdcomposant3,pdebase)
      			_prixa = val(extraitchaine(resultatcalcul,1,","))
      			_prixm = val(extraitchaine(resultatcalcul,2,","))
      			selon facture.facalcul 
      				cas 1
      					fdetail.fdprixupied= _prixa
      					//							fdetail.surchargeenergie = calculsurcharge(fdetail.fdprixtotal,fdetail.ftype)
      					//							fdetail.SUrchargeafacturer = fdetail.surchargeenergie * fdetail.fdqteafacturer / fdetail.fdqte
      					//							fdetail.SUrchargedejafacture = fdetail.surchargeenergie - fdetail.SUrchargeafacturer
      
      				cas 2
      					fdetail.fdprixupied= _prixm
      			FIN
      			selon client.CImpressionAngMet
      				cas 1
      					fdetail.fdprixu = fdetail.fdpiedcarrefacture * _prixa
      					fdetail.fdprixtotal = fdetail.fdqte * fdetail.fdprixu
      					fdetail.fdprixupiedfacture =_prixa
      				cas 2
      					fdetail.fdprixu = fdetail.fdpiedcarrefacture * _prixm
      					fdetail.fdprixtotal = fdetail.fdqte * fdetail.fdprixu
      					fdetail.fdprixupiedfacture = _prixm
      
      			FIN
      			si val(fdetail.fdhauteur) <> 0 et val(fdetail.fdlargeur) <> 0 alors
      				si val(fdetail.fDLARGEUR) > val(fdetail.fDHAUTEUR) alors
      					si partieentiere(val(fdetail.fDLARGEUR)/val(fdetail.fdhauteur)) >= 10 alors
      						lexception10 = vrai
      					sinon si partieentiere(val(fdetail.fDLARGEUR)/val(fdetail.fdhauteur)) >= 5 alors
      						lexception5= vrai
      					fin
      				sinon
      					si partieentiere(val(fdetail.fDhauteur)/val(fdetail.fdlargeur)) >= 10 alors
      						lexception10 = vrai
      					sinon si partieentiere(val(fdetail.fDhauteur)/val(fdetail.fdlargeur)) >= 5 alors
      						lexception5= vrai
      					fin
      
      			FIN
      		fin
      
      
      		si lexception5 alors
      			fdetail.FDextra5x = fdetail.fdprixu * config.Exception5 / 100
      		sinon
      			fdetail.FDextra5x = 0
      		FIN
      		si lexception10 <> 0 alors
      			fdetail.FDextra10x = fdetail.fdprixu * config.Exception10 / 100
      		sinon
      			fdetail.FDextra10x  = 0
      		FIN
      		si facture.FSURCHARGEENERGIE alors
      			fdetail.surchargeenergie = calculsurcharge(fdetail.fdprixtotal+(fdetail.fdqte * (fdetail.FDextra10X+fdetail.FDextra5x)),fdetail.ftype)
      			fdetail.SUrchargeafacturer = fdetail.surchargeenergie * fdetail.fdqteafacturer / fdetail.fdqte
      			fdetail.SUrchargedejafacture = fdetail.surchargeenergie - fdetail.SUrchargeafacturer
      		sinon
      			fdetail.surchargeenergie = 0
      			fdetail.SUrchargeafacturer = 0
      			fdetail.SUrchargedejafacture = 0
      		fin
      		fdetail.fdprixtotal += fdetail.fdqte * fdetail.fdextraforme
      		HModifie(fdetail,hNumEnrEnCours)
      
      		hlitrecherche(BonLivraison,BnoCommande,fdetail.fdnocomm)
      		tantque pas hendehors(BonLivraison) et BonLivraison.BnoCommande = fdetail.fdnocomm
      			//		si hlitrecherche(BonLivraison,BnoCommande,fdetail.fdnocomm) alors
      			si BonLivraison.bfacture = 0 alors
      				si hlitrecherche(hfacture,Bnumero,BonLivraison.bnumero) alors
      					hlitrecherche(hfdetail,HFCLEUNIK,hfacture.HFCLEUNIK)
      					tantque pas hendehors(hfdetail) et hfdetail.HFCLEUNIK = hfacture.HFCLEUNIK
      						si hfdetail.ftype = 1 et hfdetail.fdligne= fdetail.fdligne alors
      							hfdetail.fdprixupied= fdetail.fdprixupiedfacturé
      							hfdetail.fdprixu = fdetail.fdpiedcarrefacture * fdetail.fdprixupied
      							hfdetail.fdprixtotal = hfdetail.fdqteafacturer * hfdetail.fdprixu
      							hfdetail.fdprixupiedfacture = fdetail.fdprixupiedfacture
      							hfdetail.FDextra10X = fdetail.FDextra10X
      							hfdetail.FDextra5X = fdetail.FDextra5X
      							hfdetail.SUrchargeafacturer = fdetail.surchargeenergie * hfdetail.fdqteafacturer / fdetail.fdqte
      							hfdetail.surchargeenergie = fdetail.surchargeenergie * hfdetail.fdqteafacturer / fdetail.fdqte
      							hfdetail.fdprixtotal += hfdetail.fdqteafacturer * hfdetail.fdextraforme
      							HModifie(hfdetail,hnumenrencours)
      						FIN
      						hlitsuivant(hfdetail,HFCLEUNIK)
      					FIN
      			FIN
      		fin
      		HLitSuivant(BonLivraison,BnoCommande)
      	fin
      fin
      
      SortiePasDeNoThermos:
      hlitsuivant(fdetail,fdnocomm)
      FIN
      //fin
      HLitSuivant(Facture,fanumero)
      FIN
      
      multitache(100)
      ferme(miseajourdate)
      
     type : 458752
   -
     name : ModifierCommandePeinture
     procedure_id : 5272967454603169475
     type_code : 14
     code : |1+
      Procédure ModifierCommandePeinture()
      lexception5 est un booleen = faux
      lexception10 est un booleen = faux
      lPrixCarreau est un reel
      saisie1..Libellé = "Facture en cours ..."
      fsurchargepeinture est un reel
      fminpeinture est un reel
      
      HLitpremier(facture,fanumero)
      
      tantque pas HEnDehors(Facture)
      	saisie1 = facture.fanumero
      	MultitacheRepeint(miseajourdate)
      	multitache(1)
      	hlitrecherche(client,numero,facture.faclient)
      
      	si client.cminimumPeinture <> 0 alors
      		fminpeinture = client.cminimumPeinture
      	sinon
      		fminpeinture = config.prixMinimumPeinture	
      	FIN
      
      
      	//	si facture.fanumero >= 50124 alors
      	si facture.fpeinture <> 0 et facture.fatypedocument = 1 alors
      		hlitrecherche(fdetail,fdnocomm,facture.fanumero)
      		tantque pas hendehors(fdetail) et fdetail.fdnocomm = facture.fanumero 
      			si fdetail.ftype = 1 ou fdetail.ftype = 4 alors
      				si TrouvePrixPeinture() alors
      					hmodifie(Fdetail,hNumEnrEnCours)
      				fin
      			sinon si fdetail.ftype = 5
      
      				si CalculPrixPeinture() alors
      					fsurchargepeinture += arrondi(fdetail.fdprixtotal,2)				
      					hmodifie(fdetail,hnumenrencours)
      				fin
      			fin	
      
      			hlitrecherche(BonLivraison,BnoCommande,fdetail.fdnocomm)
      			tantque pas hendehors(BonLivraison) et BonLivraison.BnoCommande = fdetail.fdnocomm
      				//		si hlitrecherche(BonLivraison,BnoCommande,fdetail.fdnocomm) alors
      				si BonLivraison.bfacture = 0 alors
      					si hlitrecherche(hfacture,Bnumero,BonLivraison.bnumero) alors
      						hlitrecherche(hfdetail,HFCLEUNIK,hfacture.HFCLEUNIK)
      						tantque pas hendehors(hfdetail) et hfdetail.HFCLEUNIK = hfacture.HFCLEUNIK
      							si hfdetail.fdligne= fdetail.fdligne alors
      								si hfdetail.ftype = 1 ou hfdetail.ftype = 4  alors
      									hfdetail.fPrixCarreauPeinture = fdetail.fPrixCarreauPeinture
      									hfdetail.fTotalPeinture = fdetail.fTotalPeinture
      									hmodifie(hfdetail,hNumEnrEnCours)
      								sinon si hfdetail.ftype = 5
      									hfdetail.fdprixu = fdetail.fdprixu
      									hfdetail.fdprixupied = fdetail.fdprixupied
      									hfdetail.fdprixtotal = fdetail.fdprixtotal
      									hmodifie(hfdetail,hNumEnrEnCours)
      								fin
      							fin
      							hlitsuivant(hfdetail,HFCLEUNIK)
      						fin
      					fin
      				fin
      				HLitSuivant(BonLivraison,BnoCommande)
      			fin
      			hlitsuivant(fdetail,fdnocomm)
      		FIN
      
      	fin
      	si facture.fpeinture = 1 alors
      		si fsurchargepeinture < fminpeinture alors
      			facture.fSUrchargePeinture = fminpeinture-fsurchargepeinture
      			hmodifie(facture,hNumEnrEnCours)
      		FIN
      	FIN
      	HLitSuivant(Facture,fanumero)
      FIN
      
      
      multitache(100)
      
      
     type : 458752
   -
     name : CalculPrixPeinture
     procedure_id : 5273030383858082302
     type_code : 14
     code : |1+
      Procédure CalculPrixPeinture()
      resultat est un reel
      lasurfaceanglais est un reel
      lasurfacemetrique est un reel
      CdSurfaceFacture est un reel
      ladimension est un reel
      valeuraretourner est un booleen = vrai
      clederecherche est une chaine = HConstruitValClé(ProduitClient,IdClientIdproruit,sansespace(facture.faclient),sansespace(fdetail.fdnumprod))
      
      si hlitrecherche(ProduitClient,IdClientIdproruit,clederecherche) ALORS
      	renvoyer faux
      FIN
      
      
      
      si  hlitrecherche(invent,INUM,fdetail.fdnumprod)  alors
      
      	ladimension =  calcul_dimension(facture.facalcul,lasurfaceanglais,lasurfacemetrique,invent.iUniteMesure) 
      		si invent.iUniteMesure = 1 alors
      			resultat = arrondi(invent.iprixpeinture,2) * (100 - client.Cpourescompte) / 100
      		sinon
      			si facture.facalcul = 1 alors
      				resultat = arrondi(invent.iprixPeinture,2)* (100 - client.Cpourescompte) / 100
      			sinon
      				resultat = arrondi(invent.iprixpeintureM,2)* (100 - client.Cpourescompte) / 100
      			FIN
      		fin
      
      
      
      
      
      	//////////////////////////////////////
      	// vérifie couleur
      	//////////////////////////////////////
      	si sansespace(fdetail.fNoPeinture) <> "" et sansespace(fdetail.fNoPeinture1) <> "" alors
      		resultat = arrondi(resultat * 2,2)
      	FIN
      
      
      	// iunitemesure 1=unité 2 =Pied linéaire
      
      	si invent.iUniteMesure = 1 alors
      
      	
      
      		si hlitrecherche(FCouleur,noCouleur,fdetail.fnopeinture) ALORS
      			resultat+= arrondi(Fcouleur.cextraunite,2)
      		fin
      
      
      		// recherche extra sur couleur 2
      
      		si hlitrecherche(FCouleur,noCouleur,fdetail.fnopeinture1) ALORS
      			resultat+= arrondi(Fcouleur.cextraunite,2)
      		fin
      
      
      
      		// pied linéaire
      
      	sinon
      
      		// recherche si extra sur couleur 1
      
      		si pas invent.iCalculSimplePeinture
      			si hlitrecherche(fcouleur,noCouleur,fdetail.fnopeinture) ALORS
      				si facture.facalcul = 1 alors
      					si pas FCouleur.cExtralineaire = 0 alors
      						resultat+= arrondi(FCouleur.cExtralineaire,2)
      					fin
      				sinon
      					si pas FCouleur.cextralineaireM = 0 alors
      						resultat+=arrondi(FCouleur.cextralineaireM,2)
      					fin
      				FIN
      
      			fin
      
      
      			// recherche si extra sur couleur 2
      
      			si hlitrecherche(fcouleur,noCouleur,fdetail.fnopeinture1) ALORS
      				si facture.facalcul = 1 alors
      					si pas FCouleur.cExtralineaire = 0 alors
      						resultat+= arrondi(FCouleur.cExtralineaire,2)
      					fin
      				sinon
      					si pas FCouleur.cextralineaireM = 0 alors
      						resultat+=arrondi(FCouleur.cextralineaireM,2)
      					fin
      				FIN
      
      	
      			fin
      
      		fin
      
      
      
      
      	fin
      
      
      
      	si fdetail.fTypePeinture1 = 2  et pas invent.iCalculSimplePeinture alors
      		resultat = resultat * 2
      	FIN
      
      //	si lSurfaceSeulement alors
      //		resultat = commandetrn.cdprixupied 
      //	FIN
      
      	
      	SELON client.CImpressionAngMet
      		CAS 0
      			SI facture.FACALCUL = 1 ALORS
      				fdetail.fdprixu = arrondi(resultat,2) * arrondi(ladimension,2) 
      				fdetail.fdprixtotal = arrondi(fdetail.fdprixu,2)  * fdetail.fdqte
      			SINON
      
      				fdetail.fdprixu = ARRONDI(resultat  / CONFIG.CONVERSIONAM,2) * arrondi(ladimension,2)
      				fdetail.fdprixtotal = arrondi(fdetail.fdprixu,2)  * fdetail.fdqte
      			FIN
      		CAS 1
      			SI facture.FACALCUL = 1 ALORS
      				fdetail.fdprixu = arrondi(resultat,2) * arrondi(ladimension,2) 
      				fdetail.fdprixtotal = arrondi(fdetail.fdprixu,2)  * fdetail.fdqte
      			SINON
      
      				fdetail.fdprixu = ARRONDI(resultat  / CONFIG.CONVERSIONAM,2) * arrondi(ladimension,2)
      				fdetail.fdprixtotal = arrondi(fdetail.fdprixu,2)  * fdetail.fdqte
      			FIN
      
      		CAS 2
      			SI facture.FACALCUL = 2 ALORS
      				fdetail.fdprixu = arrondi(resultat,2) * arrondi(ladimension,2)  
      				fdetail.fdprixtotal = arrondi(fdetail.fdprixu,2)  * fdetail.fdqte
      			SINON
      				fdetail.fdprixu = arrondi(resultat  * CONFIG.CONVERSIONAM,2) * arrondi(ladimension,2)
      				fdetail.fdprixtotal = arrondi(fdetail.fdprixu,2)  * fdetail.fdqte
      			FIN
      	FIN
      
      
      
      	selon invent.iUniteMesure
      		cas 1
      			fdetail.fdprixu = resultat 
      			fdetail.fdprixupied = resultat
      			CdSurfaceFacture = ladimension
      			//		trdetail.fdpiedcarrefacture = ladimension
      
      		cas 2	
      			fdetail.fdprixupied = resultat //+ extraintercallaire 
      			fdetail.fdprixu = resultat * ladimension
      			CdSurfaceFacture = ladimension
      			//		trdetail.fdpiedcarrefacture = ladimension
      			//		si lPrixMinimumPeinture <> 0 alors
      			//			si commandetrn.CdPRIXU < lPrixMinimumPeinture alors
      			//				commandetrn.cdprixu = lPrixMinimumPeinture
      			//			FIN
      			//		FIN
      		cas 3	
      			fdetail.fdprixupied = resultat //+ extraintercallaire 
      			fdetail.fdprixu = resultat * ladimension
      			CdSurfaceFacture = ladimension
      			//		trdetail.fdpiedcarrefacture = ladimension
      		cas 4	
      			fdetail.fdprixupied = resultat //+ extraintercallaire 
      			fdetail.fdprixu = resultat * ladimension
      			CdSurfaceFacture = ladimension
      			//		trdetail.fdpiedcarrefacture = ladimension
      	FIN
      
      
      	fdetail.fdprixtotal = fdetail.fdprixu  * fdetail.fdqte
      
      fin
      
      renvoyer valeuraretourner
     type : 458752
   -
     name : TrouvePrixPeinture
     procedure_id : 5273371240903231890
     type_code : 14
     code : |1+
      Procédure TrouvePrixPeinture()
      valeuraretourner est un booleen = vrai
      ftotalpeinture1 est un reel
      ftotalpeinture2 est un reel
      fPrixCarreauPeintureoriginal est un reel = 0 
      fPrixCarreauPeintureoriginal1 est un reel = 0 
      fPrixCarreauPeinture est un reel
      fPrixCarreauPeinture1 est un reel
      
      si client.CPrixSpecialPeintureCarrelage <> 0 alors
          renvoyer faux
      	fPrixCarreauPeintureoriginal = client.CPrixSpecialPeintureCarrelage
      sinon
      	si hlitrecherche(invent,INUM,fdetail.fnopeinture) alors
      		fPrixCarreauPeintureoriginal = invent.iprixcarreauPeinture
      	fin
      	si hlitrecherche(invent,INUM,fdetail.fnopeinture1) alors
      		fPrixCarreauPeintureoriginal1 = invent.iprixcarreauPeinture
      	fin
      FIN
      
      fPrixCarreauPeinture = fPrixCarreauPeintureoriginal+trouveExtraPeinture(facture.faclient,fdetail.fnopeinture)
      fPrixCarreauPeinture1 = fPrixCarreauPeintureoriginal1+trouveExtraPeinture(facture.faclient,fdetail.fnopeinture1)
      
      
      
      selon fdetail.fTypePeinture
      	cas 1
      		ftotalpeinture1 = fdetail.Ftotalcarreaupeinture * fPrixCarreauPeinture
      		si pas sansespace(FDETAIL.FnopeintureInterieure) = "" alors
      			ftotalpeinture2 = fdetail.FDnbcarreauPeinture1 * fPrixCarreauPeinture1
      		fin
      
      
      	cas 2
      		ftotalpeinture1 = fdetail.Ftotalcarreaupeinture * fPrixCarreauPeinture
      		ftotalpeinture2 = 0
      		fPrixCarreauPeinture1 = 0
      FIN
      
      //sinon
      //	Ftotalcarreaupeinture=0
      //	//	si pas sansespace(fNoPeintureIntérieur) = "" alors
      //	//		Ftotalcarreaupeinture=NOMBRE_DE_CARREAU
      //	//	FIN
      //	fTotalPeinture1 = 0
      //	fdescpeintureExtTout = ""
      //	libelleNbCarreauExtTlt = ""
      //FIN
      FDETAIL.fPrixCarreauPeinture = fPrixCarreauPeinture
      FDETAIL.fdPrixCarreauPeinture1 = fPrixCarreauPeinture1
      FDETAIL.ftotalpeinture = ftotalpeinture1+ftotalpeinture2
      
      renvoyer valeuraretourner
      
      
     type : 458752
   -
     name : TrouveExtraPeinture
     procedure_id : 5273371305483339169
     type_code : 14
     code : |1+
      Procédure TrouveExtraPeinture(lNoClient,lNoPeinture)
      valeuraretourner est un reel = 0 
      si hlitrecherche(FCouleurClient,noClientNoCouleur,HConstruitValClé(FCouleurClient,noClientNoCouleur,lNoClient,lNoPeinture)) alors
        si FCouleurClient.fcextraCarreau <> 0 alors
           valeuraretourner = FCouleurClient.fcextraCarreau
        fin
      sinon 
      	si hlitrecherche(fcouleur,noCouleur,lNoPeinture) alors
      		valeuraretourner = FCouleur.cExtracarreau
      	FIN
        	
        		
      	
      FIN
      
      renvoyer valeuraretourner
     type : 458752
