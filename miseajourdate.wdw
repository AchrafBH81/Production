  p_codes :
   -
     code : |1+
      fonction miseajourdate(DateDemarcation=datesys(),Modification=faux)
      
      gModifCommande est un booleen = faux
      gModifPeinture est un booleen = faux
      
      
      
      si pas modification alors
      	si acso_message("Question","Voulez-vous transférer la case prix futur dans la case prix de vente"+rc+rc+"*********** Attention cette procédure est définitive *************","OuiNon") = idno alors
      		ferme()
      	FIN
      	MoiMême..Visible=Vrai
      	ExécuteTraitement(BTN_OK,trtClic)
      sinon
      	MoiMême..Visible=Vrai
      	ModifierCommandeSeulement(DateDemarcation)
      fin
