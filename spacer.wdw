  procedures :
   -
     name : RADBloque
     procedure_id : 4511921561336511924
     type_code : 14
     code : |1+
      
      Fonction RADBloque(bMessage)	// Rend Vrai si blocage effectué
      
      //Code WinDev 5.5 remplacé par la migration :
      //NumEnr	est un entier long
      NumEnr	est un entier  
      
      NumEnr=TableNumEnr("TABLE")
      Si NumEnr>0 Alors
      //Code WinDev 5.5 remplacé par la migration :
      //	HLitBloque("intercal",NumEnr)
      	HLit("intercal",NumEnr,HBlocageEcriture)
      //Code WinDev 5.5 remplacé par la migration :
      //	Si HDejaBloque() Alors
      	Si HErreurBlocage() Alors
      		si bMessage alors Info("L'enregistrement est actuellement modifié sur un autre poste.")
      		Hlit("intercal",NumEnr)
      		renvoyer Faux
      	sinon
      //Code WinDev 5.5 remplacé par la migration :
      //		TableAffiche("TABLE","P")
      		TableAffiche("TABLE",taCourantBandeau)
      		renvoyer Vrai
      	fin
      sinon
      	renvoyer Faux
      FIN
      
      
     type : 458752
   -
     name : RADDebloque
     procedure_id : 4511921562094894526
     type_code : 14
     code : |1+
      
      Procedure RADDebloque()
      
      //Code WinDev 5.5 remplacé par la migration :
      //NumEnr	est un entier long
      NumEnr	est un entier  
      
      NumEnr=TableNumEnr("TABLE")
      Si NumEnr>0 Alors
      	BOUCLE
      		HDebloqueNumEnr("intercal",NumEnr)
      //Code WinDev 5.5 remplacé par la migration :
      //		si pas hdejabloque() alors SORTIR
      		si pas HErreurBlocage() alors SORTIR
      	FIN
      FIN
      
      
     type : 458752
