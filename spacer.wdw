    type : 9
    controls : []
    code_elements :
     type_code : 9
     p_codes :
      -
        code : |1+
         
         HLITPREMIER("intercal","inumero")
         
        type : 14
      -
        code : |1+
         
         // Entrée dans une table
         si TABLE..vide alors TableAjoute("TABLE")
         
        type : 15
      -
        code : |1+
         si pas TABLE..Nouveau alors
         	// Bloque la ligne en cours
         	si pas RADBloque(Faux) alors
         		// Blocage non effectué
         //Code WinDev 5.5 remplacé par la migration :
         //		Table..Etat=Inactif	// La table est inactive
         		Table..Etat=AffichageSeulement; Table..Visible=Vrai	// La table est inactive
         	sinon
         //Code WinDev 5.5 remplacé par la migration :
         //		Table..Etat=Actif
         		Table..Etat=Actif; Table..Visible=Vrai
         	fin
         fin
         //fichierversecran("SPACER","intercal")
         si spacer.icommentaire = vrai alors
         	spacer.commentaire..etat = actif
         sinon
         //Code WinDev 5.5 remplacé par la migration :
         //	spacer.commentaire..etat = inactif
         	spacer.commentaire..etat = AffichageSeulement
         		
         FIN
         
        type : 19
      -
        code : |1+
         
         // Mémorise la modification
         si TABLE..Modifie alors
         	si TABLE..Nouveau alors
         		TableEnregistre("TABLE")
         		// Le test hDoublon est inutile si le fichier n'a pas de clé unique
         //Code WinDev 5.5 remplacé par la migration :
         //		si HDoublon() alors
         		si HErreurDoublon() alors
         			Erreur("L'enregistrement ne peut être ajouté au fichier.",...
         			       "Un enregistrement contient déjà le même identifiant")
         		fin
         //Code WinDev 5.5 remplacé par la migration :
         //		si HErrIntegrite() alors
         		si HErreurIntegrite() alors
         			Erreur("Erreur d'intégrité")
         			Retour
         		Fin
         		// Pour effectuer une saisie en chaine
         		// On utilise la fonction TableAjoute
         		TableAjoute("TABLE")
         	sinon
         		// Modification
         		TableEnregistre("TABLE")
         		// Le test hDoublon est inutile si le fichier n'a pas de clé unique
         //Code WinDev 5.5 remplacé par la migration :
         //		si HDoublon() alors
         		si HErreurDoublon() alors
         			Erreur("L'enregistrement ne peut être modifié.",...
         			       "Un enregistrement contient déjà le même identifiant.")
         		fin
         //Code WinDev 5.5 remplacé par la migration :
         //		si HErrIntegrite() alors
         		si HErreurIntegrite() alors
         			Erreur("Erreur d'intégrité")
         			Retour
         		Fin
         	fin
         fin
         si pas TABLE..Nouveau alors
         	RADDebloque()		// Débloque l'enregistrement
         fin
         
        type : 20
      -
        code : |1+
         
         HLITPREMIER("intercal","inumero")
         
        type : 22
      -
        code : |1+
         
         HLitPrecedent("intercal","inumero")
         
        type : 24
      -
        code : |1+
         
         HLitSuivant("intercal","inumero")
         
        type : 23
      -
        code : |1+
         
         HLITDERNIER("intercal","inumero")
         
        type : 25
