  -
    name : FERMER
    identifier : 0x3e9d90c17d147d50
    internal_properties : 
    properties :
     x : 703
     y : 37
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         
         RADDebloque()		// Débloque l'enregistrement
         Ferme
         
        type : 18
      -
        type : 161
        enabled : false
  -
    name : NOUVEAU
    identifier : 0x3e9d90c10f427d5a
    internal_properties : 
    properties :
     x : 703
     y : 97
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         
         // Ajoute
         //Code WinDev 5.5 remplacé par la migration :
         //Table..Etat=Actif
         Table..Etat=Actif; Table..Visible=Vrai
         TableAjoute("TABLE")
         RepriseSaisie("TABLE")
         
        type : 18
      -
        type : 161
        enabled : false
  -
    name : SUPPRIME
    identifier : 0x3e9d90c167c47d64
    internal_properties : 
    properties :
     x : 703
     y : 164
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         
         // Suppression
         si TABLE..Nouveau alors
         	si TABLE..occurrence<2 alors
         		REPRISESAISIE("TABLE")
         	sinon
         		TableSupprime("TABLE")
         	fin
         sinon
         //Code WinDev 5.5 remplacé par la migration :
         //	si Table..Etat=Inactif alors
         	si (Table..Etat=AffichageSeulement ET Table..Visible=Vrai) alors
         		Info("L'enregistrement est en cours de modification sur un autre poste.",...
         				"Impossible de le supprimer.")
         		retour
         	fin
         	si acso_message("Question","Voulez-vous supprimer l'enregistrement?","OuiNon") = idyes alors
         		TableSupprime("TABLE")
         //Code WinDev 5.5 remplacé par la migration :
         //		si HerrIntegrite() alors
         		si HErreurIntegrite() alors
         //Code WinDev 5.5 remplacé par la migration :
         //			Erreur(h.Commentaire)	// "Erreur d'intégrité"
         			Erreur(HErreurInfo())	// "Erreur d'intégrité"
         			Retour
         		Fin
         	fin
         fin
         
         si TableOccurrence("TABLE")=0 alors
         	REPRISESAISIE("TABLE")
         SINON
         	// Le bouton Supprimer est en interruption
         	// Il faut forcer l'entrée dans la nouvelle ligne
         //Code WinDev 5.5 remplacé par la migration :
         //	Execute("TABLE..LEN")
         	ExecuteTraitement("TABLE",trtENTREELIGNE)
         fin
         
         
        type : 18
      -
        type : 161
        enabled : false
