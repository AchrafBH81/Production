        type_code : 29
        p_codes :
         -
           code : |1+
            si hlitrecherche(invent,INUM,RequeteClientProduit.Idproruit) alors
            	si client.CLangue=1 alors moimeme = sansespace(invent.IDESC) sinon moimeme = sansespace(invent.idesca)
            sinon
            	si client.CLangue=1 alors moimeme = "Produit Inexistant" sinon moimeme = "Product not found"	
            FIN
           type : 327692
