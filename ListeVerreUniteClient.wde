        height : 5.
       code_elements :
        type_code : 29
        p_codes :
         -
           code : |1+
            si RequeteClientProduit.IPprixSpecial alors
              moimeme = RequeteClientProduit.iprixm
            sinon
            	si hlitrecherche(invent,INUM,RequeteClientProduit.Idproruit) alors
            		moimeme = invent.iprixunitem
            	sinon
            		moimeme = 0		
            	FIN
            
            	
            FIN
