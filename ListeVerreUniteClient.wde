     type_code : 30
     p_codes :
      -
        code : |1+
         compteur  = 1
         hlitrecherche("spinter","spcleclientproduitnumero",numeroclient+invent.inum+caract(0))
         //Code WinDev 5.5 remplacé par la migration :
         //tantque pas h.endehors et ...
         tantque pas HEnDehors() et ...
         	numeroclient+invent.inum = ...
         	spinter.spclient+spinter.spproduit
         compteur++
         hlitsuivant("spinter","spcleclientproduitnumero")
         
         fin
         //Code WinDev 5.5 remplacé par la migration :
         //si (compteur * 5) + _.debv > ihauteurpage() alors
         si (compteur * 5) + iHauteurRestantePage() > ihauteurpage() alors
            iterminepage()
         fin						  
         
        type : 327692
      -
        code : |1+
         //Code WinDev 5.5 remplacé par la migration :
         // IIMPRIMEETAT("LIGNEESCVERREUNITE",numeroclient+invent.INUM,numeroclient+invent.INUM)
         iImprimeEtat("LIGNEESCVERREUNITE",numeroclient+invent.INUM,numeroclient+invent.INUM)
         
        type : 327693
      -
        type : 327697
        enabled : false
 controls : []
 code_elements :
  type_code : 13
  p_codes :
   -
     code : |1-
      Procedure _LISTE_BASE_PIED_CLIENT(_pParam1="", _pParam2="", _pParam3="", _pParam4="")
      
      GLOBAL
      numeroclient est une chaine = _pparam1
      compteur est un entier
      si pas listeprix.NouvelleListe alors
      	GrpDateRempl..visible = faux
      	Lvigueur..visible = faux
      	ldate..visible=vrai
      sinon
      	GrpDateRempl..visible = vrai
      
      FIN
      si pas gImprimeCondPMT alors
      	GrpCondPmt..visible=faux
      FIN
      
      listeprix.ListeImprimee = Faux
     type : 327680
   -
     code : |1-
      
     type : 327695
   -
     code : |1+
      // Vérification de la condition
      SI HLitRecherche(invent,INUM,RequeteClientProduit.Idproruit) ET PAS invent.iactif ALORS RENVOYER Faux 
      SI pas (RequeteClientProduit.ITypeProduit = 2) ALORS RENVOYER FAUX
      SI pas RequeteClientProduit.IlisteDePrix ALORS RENVOYER FAUX
      //si (position(_pparam2,complete(invent.icategorie,3)) = 0) alors renvoyer faux
      
      RENVOYER VRAI		// Enregistrement accepté
      
     type : 327696
   -
     code : |1+
      lNombreenrImprime = moimeme..NbEnrImprimé
      
     type : 327682
  procedures :
   -
     name : assigneLibelle
     procedure_id : 5275263607160291817
     type_code : 14
     code : |1-
      Procédure assigneLibelle()
      i est un entier
      
      lTableauLibelle est un tableau de  11 chaines
      lTableauLibelle[1]  = "lentete,lentete"
      lTableauLibelle[2]  = "lvigueur,lvigueur"
      lTableauLibelle[3]  = "lremplace,lremplace"
      lTableauLibelle[4]  = "lverreunite,lverreunite"
      lTableauLibelle[5]  = "lverreunitesuite,lverreunitesuite"
      lTableauLibelle[6]  = "lnumero,lnumero"
      lTableauLibelle[7]  = "facdescription,facdescription"
      lTableauLibelle[8]  = "langlais,Langlais"
      lTableauLibelle[9]  = "lmetrique,lmetrique"
      lTableauLibelle[10]  = "lvigueur,LDate"
      lTableauLibelle[11]  = "lcondpaiement,LCondpaiement"
      
      selon client.CLangue
      	cas 1
      		pour i = 1 a 11
      			si hlitrecherche(Traduction,TRecherche,extraitchaine(lTableauLibelle[i],1,",")) alors
      				{"ListeVerreUniteClient."+ExtraitChaîne(lTableauLibelle[i],2,",")} = traduction.dFrancais
      			fin
      		FIN
      	cas 2
      		pour i = 1 a 11
      			si hlitrecherche(Traduction,TRecherche,extraitchaine(lTableauLibelle[i],1,",")) alors
      				{"ListeVerreUniteClient."+ExtraitChaîne(lTableauLibelle[i],2,",")} = traduction.danglais
      			fin
      		FIN
      fin
     type : 458752
  procedure_templates : []
  property_templates : []
 code_parameters :
  internal_properties : CQAAAAkAAACVGQgYbalU7DKC3oH4ItDrjtcTHXXV/EuH8q0IbhyQlw==
