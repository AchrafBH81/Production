      -
        code : |1+
         chainearetourner est une chaine = ""
         POUR i = 1 _A_ TableSelectOccurrence(TableSecteur)
         
         	
         	chainearetourner += tablesecteur[TableSelect(TableSecteur,i)].Numéro + ";"
         	
         FIN
         mafenetre..ValeurRenvoyée = chainearetourner
         ferme
         
