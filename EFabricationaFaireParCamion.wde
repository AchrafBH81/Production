        code : |1+
         si RequeteDetailUnJourV1ParCamion.ftype <> 4 alors
         
         
         
         
         	si pas sansespace(RequeteDetailUnJourV1ParCamion.fnotes) = ""  ou RequeteDetailUnJourV1ParCamion.fdextraforme <> 0 ALORS
         
         		iImprimeBloc(ITERATION3)	
         		//  totalpage +=  totalextraforme
         		//  totalfacture +=  totalextraforme
         	FIN
         	si pas sansespace(RequeteDetailUnJourV1ParCamion.fnotes1) = ""   ALORS
         
         		iImprimeBloc(ITERATION5)	
         		//  totalpage +=  totalextraforme
         		//  totalfacture +=  totalextraforme
         	FIN
         sinon
         	si RequeteDetailUnJourV1ParCamion.fpeinture alors
         
         		iImprimeBloc(ITERATION6)	
         
         	FIN
         fin
         TypeLivraison = RequeteDetailUnJourV1ParCamion.LoadingType
         ShippingSequence = RequeteDetailUnJourV1ParCamion.ShippingSequence
         
