    properties :
     y : 79.392
     width : 269.4
     height : 3.96900000000001
    code_elements :
     type_code : 30
     p_codes :
      -
        code : |1-
         
        type : 327694
      -
        code : |1+
         
         //// ****************** Nouveau code ****************************
         
         j est un entier
         indicecarr est un entier
         carrtrouve est un booleen = faux//A FAIRE :
         carrnogl est une chaine
         si RequeteDetailUnJourV1ParCamion.ftype = 1 alors
         	lTypeLigne = "Verre"
         sinon si RequeteDetailUnJourV1ParCamion.ftype = 2 
         	si pas RequeteDetailUnJourV1ParCamion.fdverreunite alors
         		lTypeLigne = "Unite"
         	sinon
         		lTypeLigne = "Verre"
         	fin
         sinon si RequeteDetailUnJourV1ParCamion.ftype = 3
         	ltypeligne = "Fourniture" 
         sinon si RequeteDetailUnJourV1ParCamion.ftype = 4
         	ltypeligne = "Carrelage" 
         sinon si RequeteDetailUnJourV1ParCamion.ftype = 5
         	ltypeligne = "Peinture" 
         fin
         
         //si RequeteDetailUnJourV1ParCamion.ftype = 4 alors
         //	corps..visible = faux
         //sinon
         
         
         selon lTypeLigne
         	cas "Unite"
         		//	CORPS..VISIBLE = VRAI
         		rubrique17 = RequeteDetailUnJourV1ParCamion.fdprixu
         		rubrique16 = 1
         	//		rubrique16..visible = faux
         	cas "Verre"	
         		//		corps..visible = vrai
         	//		rubrique16..visible = vrai
         	cas "Carrelage"
         		//		corps..visible = faux
         		iImprimeBloc(ITERATION1)
         	cas "Peinture"
         		//		corps..visible = faux
         		iImprimeBloc(ITERATION2)
         fin
         
         
         
         
         
         //	si pas facturereimpression alors
         //		remplir_tableau(rubrique21,arrondi(rubrique4 * (rubrique16 * rubrique17),2))
         //	FIN
         
         //	totalpage +=  arrondi(RequeteDetailUnJourV1ParCamion.fdqte * RequeteDetailUnJourV1ParCamion.fdpiedcarrefacture * RequeteDetailUnJourV1ParCamion.fdprixupiedfacture,2)
         //	totalfacture +=  arrondi(RequeteDetailUnJourV1ParCamion.fdqte * RequeteDetailUnJourV1ParCamion.fdpiedcarrefacture * RequeteDetailUnJourV1ParCamion.fdprixupiedfacture,2)
         
         
         selon lTypeLigne
         	cas "Unite"
         		//		FIN
         		//		si RequeteDetailUnJourV1ParCamion.ftype = 2 et pas RequeteDetailUnJourV1ParCamion.fdverreunite alors
         		totalpage +=  arrondi(RequeteDetailUnJourV1ParCamion.fdqteafacturer * RequeteDetailUnJourV1ParCamion.fdprixu,2)
         		totalfacture +=  arrondi(RequeteDetailUnJourV1ParCamion.fdqteafacturer * RequeteDetailUnJourV1ParCamion.fdprixu,2)
         	cas "Fourniture"
         		//		totalpage +=  arrondi(requetebletat.fdqte * requetebLETAT.fdprixupied,2)
         		totalfacture +=  arrondi(RequeteDetailUnJourV1ParCamion.fdqteafacturer * RequeteDetailUnJourV1ParCamion.fdprixupied,2)
         		
         		
         	cas "Verre"
         		//sinon
         		//		totalpage +=  arrondi(RequeteDetailUnJourV1ParCamion.fdqte * ((RequeteDetailUnJourV1ParCamion.fdpiedcarrefacture * RequeteDetailUnJourV1ParCamion.fdprixupiedfacture) + ...
         		//		RequeteDetailUnJourV1ParCamion.fdextraforme),2)
         		totalfacture +=  arrondi(RequeteDetailUnJourV1ParCamion.fdqteafacturer * (RequeteDetailUnJourV1ParCamion.fdpiedcarrefacture * RequeteDetailUnJourV1ParCamion.fdprixupiedfacture),2)+ ...
         		arrondi(RequeteDetailUnJourV1ParCamion.fdqteafacturer *RequeteDetailUnJourV1ParCamion.fdextraforme,2)+arrondi(RequeteDetailUnJourV1ParCamion.fdqteafacturer *RequeteDetailUnJourV1ParCamion.FDextra10X,2)+...
         		arrondi(RequeteDetailUnJourV1ParCamion.fdqteafacturer *RequeteDetailUnJourV1ParCamion.FDextra5x,2)
         		
         		//		totalfacture +=  arrondi(RequeteDetailUnJourV1ParCamion.fdqte * ((RequeteDetailUnJourV1ParCamion.fdpiedcarrefacture * RequeteDetailUnJourV1ParCamion.fdprixupiedfacture)+ ...
         		//		RequeteDetailUnJourV1ParCamion.fdextraforme),2)
         		
         		si llivraison alors
         			si SansEspace(RequeteDetailUnJourV1ParCamion.fdcomposant2) = "" ET SansEspace(RequeteDetailUnJourV1ParCamion.fdcomposant2) =""   ALORS
         				totalcarrelage+=RequeteDetailUnJourV1ParCamion.fdqteafacturer+RequeteDetailUnJourV1ParCamion.fdqtedejafacture 
         			sinon
         				totalthermos+=RequeteDetailUnJourV1ParCamion.fdqteafacturer+RequeteDetailUnJourV1ParCamion.fdqtedejafacture 
         			fin
         			totalpoids += (RequeteDetailUnJourV1ParCamion.fdqteafacturer+RequeteDetailUnJourV1ParCamion.fdqtedejafacture) * RequeteDetailUnJourV1ParCamion.PoidsUnitaire 
         			RequeteBonLivraisonFacture.pNoCommande = RequeteDetailUnJourV1ParCamion.fdnocomm
         			RequeteBonLivraisonFacture.pNoLigne = RequeteDetailUnJourV1ParCamion.fdligne
         			SI HExécuteRequête(RequeteBonLivraisonFacture) ALORS
         				POUR TOUT RequeteBonLivraisonFacture
         					si RequeteBonLivraisonFacture.Bfacture <>  0 alors
         						//					SELON RequeteBonLivraisonFacture.ftype
         						//						CAS 1
         						SI SansEspace(RequeteBonLivraisonFacture.fdcomposant2) = "" ET SansEspace(RequeteBonLivraisonFacture.fdcomposant2) =""   ALORS
         							totalcarrelage-= RequeteBonLivraisonFacture.la_somme_fdqteafacturer
         							
         						SINON
         							totalthermos-= RequeteBonLivraisonFacture.la_somme_fdqteafacturer
         						fin
         						totalpoids -= RequeteBonLivraisonFacture.la_somme_fdqteafacturer * RequeteDetailUnJourV1ParCamion.PoidsUnitaire 
         					fin
         					//						CAS 4
         					//							totalcarrelage -= RequeteBonLivraisonFacture.totalCarreau
         					//						AUTRE CAS
         					//							
         					//					FIN
         				FIN
         			FIN
         			
         			//			totalthermos+=+RequeteDetailUnJourV1ParCamion.fdqtedejafacture 
         		sinon
         			si pas llivraison _et_ sansespace(RequeteDetailUnJourV1ParCamion.fdcomposant2) = "" et sansespace(RequeteDetailUnJourV1ParCamion.fdcomposant2) =""   alors
         				totalcarrelage +=RequeteDetailUnJourV1ParCamion.fdqteafacturer 
         			sinon 
         				totalthermos+=RequeteDetailUnJourV1ParCamion.fdqteafacturer
         			fin 
         		fin
         		totalsurcharge += arrondi(RequeteDetailUnJourV1ParCamion.surchargeenergie,2) //* RequeteDetailUnJourV1ParCamion.fdqteafacturer / RequeteDetailUnJourV1ParCamion.fdqte
         		totalcap+= arrondi(RequeteDetailUnJourV1ParCamion.FDExtraCap * RequeteDetailUnJourV1ParCamion.fdqteafacturer,2)
         		
         		
         		
         	cas "Carrelage"
         		//		FIN
         		//		si RequeteDetailUnJourV1ParCamion.ftype = 2 et pas RequeteDetailUnJourV1ParCamion.fdverreunite alors
         		//		si lLivraison alors
         		//			totalpage +=  arrondi(RequeteDetailUnJourV1ParCamion.fdcarrprixtotal+RequeteDetailUnJourV1ParCamion.fTotalPeinture,2)
         		//			
