 code_elements :
  type_code : 13
  p_codes :
   -
     code : |1-
      procedure EFabricationaFaireParCamion(ldateJour = "",lLivraison = 0,SautDePage est un booleen = faux)
      lTypeLigne est une chaine = "" // Verre, verre a l'unité, Unité , carrelage , Peinture
      totalpage est un reel = 0
      totalpage1 est un reel = 0
      totalfacture est un reel = 0
      totalsurcharge est un reel = 0
      totalcap est un reel = 0
      totalthermos est un entier
      totalpoids est un reel = 0
      totalverresimple est un entier
      
      totalcarrelage est un entier
      TotaldePeinture est une reel
      
      Premierepage  est un  booleen = vrai 
      
      CDaterapport = ldatejour
      //si pas llivraison alors
      	LNoClient3 = "Verre simple"
      //FIN
      
      si sautdepage alors
      	FIN_DOCUMENT..visible = faux
      FIN
     type : 327680
   -
     code : |1-
      
     type : 327695
  procedures :
   -
     name : Rupturefdcomm
     procedure_id : 2140447297802568532
     type_code : 14
     code : |1+
      Procédure Rupturefdcomm()
      
      iimprime("salut")
      
     type : 458752
   -
     name : Remplir_tableau
     procedure_id : 2140447297802634068
     type_code : 14
     code : |1+
      Procédure Remplir_tableau(codegl,montantgl,taxegl=faux)
      codegltrouve est un booleen = faux
      j est un entier = (dimension(fac_detail)/4)
      k est un entier
      si pas j = 1 alors
      pour k = 2 a j
      	si fac_detail[k,1] = codegl alors
      		codegltrouve = vrai
      		fac_detail[k,2]=numeriqueverschaine(val(fac_detail[k,2])+montantgl)
      	    sortir
      	FIN
      FIN
      fin
      
      si pas codegltrouve alors
          
      	dimension(fac_detail,j+1,4)
      	fac_detail[j+1,1] = codegl
      	fac_detail[j+1,2] = numeriqueverschaine(montantgl)
          si taxegl alors
          	fac_detail[j+1,3] = "1"
          fin	
      FIN
      
      
      
     type : 458752
   -
     name : AlimenteHistorique
     procedure_id : 2140447297802699604
     type_code : 14
     code : |1+
      Procédure AlimenteHistorique(lclient,ldate,lmontant)
      
      si  facturereimpression alors
      	renvoyer vrai
      FIN
      lannee est un entier= ldate..Année
      lmois est un entier = ldate..mois
      
      
      si hlitrecherche(HistoAnneeMois,lanneeMois,HConstruitValClé(HistoAnneeMois,lanneemois,lclient,lannee,lmois)) alors
      	HistoAnneeMois.lvente+= lmontant
      	hmodifie(HistoAnneeMois,hNumEnrEnCours)
      sinon
      	HistoAnneeMois.hclient = lclient
      	HistoAnneeMois.lAnnee = lannee
      	HistoAnneeMois.lmois = lmois
      	HistoAnneeMois.lvente = lmontant
      	hajoute(HistoAnneeMois)
      FIN
      
      renvoyer vrai
      
      
      
     type : 458752
   -
     name : AlimenteHistoriqueProduit
     procedure_id : 2140447297802765140
     type_code : 14
     code : |1+
      Procédure AlimenteHistoriqueProduit(lclient,ldate,ltype,lnumprod,lcomp1,lcomp2,lcomp3,lmontant,lsurcharge,ldesc,lqte)
      
      si  facturereimpression alors
      	renvoyer vrai
      FIN
      
      i est un entier
      lannee est un entier = numeriqueverschaine(ldate..annee)
      lmois est une chaine = remplir_zero(sansespace(numeriqueverschaine(ldate..mois)),2)
      lperiode est une chaine= lannee+lmois
      
      
      
      
      
      selon ltype
      
      	cas 1
      		si hlitrecherche(HistoAnneeMoisProduit,hClientlComp1lcomp2lcomp3lAnneelmois,...
      			HConstruitValClé(HistoAnneeMoisProduit,hClientlComp1lcomp2lcomp3lAnneelmois,lclient,"",lcomp1,...
      			lcomp2,lcomp3,lannee,lmois)) alors
      			HistoAnneeMoisProduit.lqte += lqte
      			HistoAnneeMoisProduit.lvente +=  arrondi(lmontant,2)
      			HistoAnneeMoisProduit.lsurcharge +=  arrondi(lsurcharge,2)
      			hmodifie(HistoAnneeMoisProduit,hNumEnrEnCours)
      		sinon
      			HistoAnneeMoisProduit.lperiode = lperiode
      			HistoAnneeMoisProduit.hClient = lclient
      			HistoAnneeMoisProduit.lAnnee = lannee
      			HistoAnneeMoisProduit.lmois = lmois
      			HistoAnneeMoisProduit.ldescription = ldesc
      			HistoAnneeMoisProduit.lProduit = lnumprod
      			HistoAnneeMoisProduit.lComp1 = lcomp1
      			HistoAnneeMoisProduit.lComp2 = lcomp2
      			HistoAnneeMoisProduit.lComp3 = lcomp3
      			HistoAnneeMoisProduit.lsurcharge =  arrondi(lsurcharge,2)
      			HistoAnneeMoisProduit.lqte = lqte
      			HistoAnneeMoisProduit.lType = "T"
      			HistoAnneeMoisProduit.lvente =  arrondi(lmontant,2)
      			hajoute(HistoAnneeMoisProduit)
      		FIN
      		
      		
      		
      	cas 4
      		si hlitrecherche(HistoAnneeMoisProduit,hClientlComp1lcomp2lcomp3lAnneelmois,...
      			HConstruitValClé(HistoAnneeMoisProduit,hClientlComp1lcomp2lcomp3lAnneelmois,lclient,lnumprod,"","","",lannee,lmois)) alors
      			HistoAnneeMoisProduit.lqte += lqte
      			HistoAnneeMoisProduit.lvente +=  arrondi(lmontant,2)
      			HistoAnneeMoisProduit.lsurcharge +=  arrondi(lsurcharge,2)
      			hmodifie(HistoAnneeMoisProduit,hNumEnrEnCours)
      		sinon
      			HistoAnneeMoisProduit.lperiode = lperiode
      			HistoAnneeMoisProduit.hClient = lclient
      			HistoAnneeMoisProduit.lAnnee = lannee
      			HistoAnneeMoisProduit.lmois = lmois
      			HistoAnneeMoisProduit.ldescription = ldesc
      			HistoAnneeMoisProduit.lComp1 = ""
      			HistoAnneeMoisProduit.lComp2 = ""
      			HistoAnneeMoisProduit.lComp3 = ""
      			HistoAnneeMoisProduit.lProduit = lnumprod
      			HistoAnneeMoisProduit.lsurcharge =  arrondi(lsurcharge,2)
      			HistoAnneeMoisProduit.lqte = lqte
      			HistoAnneeMoisProduit.lType = "C"
      			HistoAnneeMoisProduit.lvente =  arrondi(lmontant,2)
      			hajoute(HistoAnneeMoisProduit)
      		FIN
      	autre cas
      		si hlitrecherche(HistoAnneeMoisProduit,hClientlComp1lcomp2lcomp3lAnneelmois,...
      			HConstruitValClé(HistoAnneeMoisProduit,hClientlComp1lcomp2lcomp3lAnneelmois,lclient,lnumprod,"","","",lannee,lmois)) alors
      			HistoAnneeMoisProduit.lqte += lqte
      			HistoAnneeMoisProduit.lvente +=  arrondi(lmontant,2)
      			HistoAnneeMoisProduit.lsurcharge +=  arrondi(lsurcharge,2)
      			hmodifie(HistoAnneeMoisProduit,hNumEnrEnCours)
      		sinon
      			HistoAnneeMoisProduit.lperiode = lperiode
      			HistoAnneeMoisProduit.hClient = lclient
      			HistoAnneeMoisProduit.lAnnee = lannee
      			HistoAnneeMoisProduit.lmois = lmois
      			HistoAnneeMoisProduit.ldescription = ldesc
      			HistoAnneeMoisProduit.lComp1 = ""
      			HistoAnneeMoisProduit.lComp2 = ""
      			HistoAnneeMoisProduit.lComp3 = ""
      			HistoAnneeMoisProduit.lProduit = lnumprod
      			HistoAnneeMoisProduit.lsurcharge =  arrondi(lsurcharge,2)
      			HistoAnneeMoisProduit.lqte = lqte
      			HistoAnneeMoisProduit.lvente =  arrondi(lmontant,2)
      			hajoute(HistoAnneeMoisProduit)
      		FIN
      FIN
      
      
      
      
     type : 458752
