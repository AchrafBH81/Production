 menu :
  name : _Menu
  identifier : 0x419ff98d3930e3de
  internal_properties : 
  options : []
 languages :
  - fr-FR
 popup_menus : []
 message_bar :
  internal_properties : CQAAAAkAAAAWXjDDX3AWx6iNvYM3TVmjuFwUYQAIKSVDyJo1eLAShBfg4wBnL9GbaCYsviHyIbRMZ0nO/E3JBtlGcS7cQPxTtB7x4dFYO2N56B+Ho8H4I8J32YOQapYrNilKUQ==
 actionbar : {}
 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1+
      i est un entier
      j est un entier
   -
     code : |1+
      moimeme..ValeurRenvoyée = ""
      hlit(Config,1)
      
      pour i = 31 a 50
      	j = i-30
      	si sansespace(Config.CFnomconstante[i-30]) <> "" alors
      		{"BoutonK"+j}..visible = vrai
      		{"BoutonK"+j}..libelle = "K"+j
      		{"libelle"+i}..libelle = sansespace(Config.CFnomconstante[i-30])
      		{"libelle"+i}..visible = vrai
      
      	sinon
      		{"BoutonK"+j}..visible = faux
      		{"libelle"+i}..visible = faux
      
      	fin
      
      FIN
     type : 34
   -
     type : 180
     enabled : false
   -
     type : 230
     enabled : false
   -
     type : 11
   -
     type : 12
   -
     type : 17
   -
     type : 13
 code_parameters :
