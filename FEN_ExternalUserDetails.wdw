  p_codes :
   -
     code : |1+
      PROCEDURE MaFenêtre(gclUser est un cUserExternal,gsMode est une chaine = "A")
      
      gtabCustomerList est un tableau de cCustomerLight = FillCustomerList()
      
      
      mafenetre..ValeurRenvoyée = gcluser
      SourceVersEcran()
      si gsmode = "M" alors
      	
      FIN
   -
     code : |1+
      pour i = 1 a 6
      	INT_Credentials[i] = gclUser.m_sCredentials[[i]] = "" ? 1 sinon  gclUser.m_sCredentials[[i]]
      FIN
      INT_Credentials[7] = gclUser.m_sCredentials[[7]] = "" ? 0 SINON  gclUser.m_sCredentials[[7]]
      
     type : 34
