  procedures :
   -
     name : FillCustomerList
     procedure_id : 1483277123548362879
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] FillCustomerList ()
      //
      // Paramètres :
      //	Aucun
      // Valeur de retour :
      // 	tableau (cCustomerLight) : <indiquez ici le rôle de la valeur de retour>
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure FillCustomerList()
      
      tabCustomerList est un tableau de cCustomerLight
      
      sdReqsql est une source de donnees
      sTxtsql est une chaine = [
      select client.numero customercode,client.nom as customername from client where cetat = 1 Order by client.numero
      ]
      
      si HExécuteRequêteSQL(sdReqsql,hRequêteDéfaut,stxtsql) alors
      	FichierVersMémoire(tabCustomerList,sdreqsql)
      FIN
      
      renvoyer tabCustomerList
