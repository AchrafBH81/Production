     type_code : 4
     p_codes :
      -
        code : |1+
         si SAI_UserCode =  "" ou SAI_passWord = "" ou COMBO_GtabCustomerList ="" ou SAI_Username = "" alors
         	Erreur("Information incomplète """)
         	reprisesaisie(SAI_UserCode)
         FIN
         EcranVersSource()
         gclUser.m_sCustomerName	= COMBO_GtabCustomerList.COL_Name
         gclUser.m_bIsModified	= vrai
         si INT_IsNew _ou_ gsMode = "A" alors
         	gclUser.m_bIsnew = vrai
         fin
         sCredential est une chaîne = ""
         
         
         POUR i = 1 a 7
         	scredential+= INT_Credentials[i]
         FIN
         gclUser.m_sCredentials		= sCredential
         
         
         mafenetre..ValeurRenvoyée	= gclUser
         ferme(FEN_externalUserDetails)
        type : 18
      -
        type : 161
        enabled : false
