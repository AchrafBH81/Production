  procedures :
   -
     name : MajHistoFac
     procedure_id : 5379170630790932829
     type_code : 14
     code : |1-
      Procédure MajHistoFac()
      rectotal est une chaine = sansespace(NumériqueVersChaine(hnbenr(facture)+hnbenr(hfacture)))
      i est un entier
      
      pour tout hfacture 
      i++
      MiseaJourFacture.csnCompteur = sansespace(NumériqueVersChaine(i))+"/"+rectotal
      MultitacheRepeint(MiseaJourFacture)
      	si hlitrecherche(client,numero,hfacture.faclient) alors
      		hfacture.nom = client.nom
      		hfacture.Adresse = client.crue
      		hfacture.ville = client.cville
      		hfacture.CodePostal = client.ccodepostal
      		hfacture.noTelephone = client.ctelephone
      		hmodifie(hfacture,hNumEnrEnCours)
      	FIN
      	
      FIN
      pour tout facture 
      	i++
      	MiseaJourFacture.csnCompteur = sansespace(NumériqueVersChaine(i))+"/"+rectotal
      	MultitacheRepeint(MiseaJourFacture)
      	si hlitrecherche(client,numero,facture.faclient) alors
      		facture.nom = client.nom
      		facture.Adresse = client.crue
      		facture.ville = client.cville
      		facture.CodePostal = client.ccodepostal
      		facture.noTelephone = client.ctelephone
      		hmodifie(facture,hNumEnrEnCours)
      	FIN
      
      FIN
      multitache(200)
      ferme(MiseaJourFacture)
     type : 458752
  procedure_templates : []
  property_templates : []
