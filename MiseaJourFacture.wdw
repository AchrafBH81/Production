  -
    name : BTN_OK
    identifier : 0x4aa6a38063b78057
    internal_properties : 
    properties :
     x : 500
     y : 60
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         
         hlitpremier("invent","INUM")
         tantque pas HEnDehors()
         	saisie1 = invent.inum
         
         	multitache(1)
         	selon invent.itype
         
         		// Verre produit de base et additionnel
         
         		cas 1 
         			si invent.ibase alors		
         				invent.iprixa = invent.iprixfutur 
         				invent.iprixm = invent.iprixfuturm 
         				invent.iprixdouble = invent.iprixfuturdouble 
         				invent.iprixdoublem = invent.iprixfuturdoublem 
         				invent.iprixtriple = invent.iprixfuturtriple 
         				invent.iprixtriplem = invent.iprixfuturtriplem 
         				// mise a zéro des prix  futur et date 
         				invent.iprixfutur = 0
         				invent.iprixfuturm = 0
         				invent.iprixfuturdouble = 0 
         				invent.iprixfuturdoublem = 0
         				invent.iprixfuturtriple  = 0
         				invent.iprixfuturtriplem = 0
         				invent.idateprixfutur = ""
         
         			sinon
         				invent.iprixa = invent.iprixfutur
         				invent.iprixm = invent.iprixfuturm
         
         				// mise a zéro des prix futur et date
         
         				invent.iprixfutur = 0
         				invent.iprixfuturm = 0
         				invent.idateprixfutur = ""
         
         
         			fin
         			// verre a l'unite et produit a l'inité
         		cas 2 
         			selon invent.iunitetype
         
         				cas 2   // verre a l'unite
         
         					invent.iprixunitaire = invent.iprixfuturunite 
         					invent.iprixunitem = invent.iprixfuturunitem 
         
         					// mise a zéro des prix futur et date
         
         					invent.iprixfuturunite = 0
         					invent.iprixfuturunitem = 0
         					invent.idateprixfutur = ""
         
         				cas 3
         
         					invent.iprixuniterouleau = invent.iprixfuturuniterouleau
         					invent.iprixunite = invent.iprixfuturu
         					// mise a zéro des prix futur et date
         
         					invent.iprixfuturuniterouleau = 0
         					invent.iprixfuturu = 0
         					invent.idateprixfutur = ""
         
         				autres cas
         
         					invent.iprixunite = invent.iprixfuturu
         					invent.iprixfuturu = 0
         					invent.idateprixfutur = ""
         
         			FIN
         		cas 4   // carrelage
         
         			si invent.iprixfuturbasecarrelage <> 0.00  alors
         				invent.iprixbasecarrelage =  invent.iprixfuturbasecarrelage
         				invent.iprixfuturbasecarrelage = 	 0
         			FIN
         			si invent.iprixfuturcarreau <> 0.00  alors
         				invent.iprixcarreau = invent.iprixfuturcarreau
         				invent.iprixfuturcarreau = 	 0
         				invent.idateprixfutur = ""
         			fin
         		cas 5   // carrelage
         
         			si invent.iprixFuturPeinture <> 0.00  alors
         				invent.iprixPeinture =  invent.iprixFuturPeinture
         				invent.iprixFuturPeinture = 0
         			FIN
         			si invent.iprixFuturPeinturem <> 0.00  alors
         				invent.iprixPeinturem =  invent.iprixFuturPeinturem
         				invent.iprixFuturPeinturem = 0
         			FIN
         	fin
         
         	hmodifie("invent")
         	hlitsuivant("invent","INUM")
         
         fin	
         hlitpremier(persoens,ennumero)
         tantque pas HEnDehors(persoens)
         	saisie1 = persoens.ennumero
         	multitache(1)
         	si persoens.enprixfutura <> 0 alors
         		persoens.enprixa = persoens.enprixfutura
         		persoens.enprixfutura = 0
         		gModifCommande = vrai
         	fin
         	si persoens.enprixfuturm <> 0 alors
         		persoens.enprixm = persoens.enprixfuturm
         		persoens.enprixfuturm = 0
         		gModifCommande = vrai
         	fin
         	HModifie(persoens,hNumEnrEnCours)
         	HLitSuivant(persoens,ennumero)
         fin
         si gModifCommande alors
         	si acso_message("Question","Voulez-vous appliquer les changements de prix de thermos aux commandes et bons de livraison ?","OuiNon") = idyes ALORS
         			ModifierCommande()
         	fin	
         fin
         ModifierCommandePeinture()
         ferme(miseajourdate)
        type : 18
      -
        type : 161
        enabled : false
