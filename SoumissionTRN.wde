         PrixUnitCarr1 = requetesoumission.fPrixCarreauPeinture
         TotalCarr1 = qtecarr65 * PrixUnitCarr1 * qtecarr9
         selon requetesoumission.fTypePeinture
         		cas 2
         			si client.CLangue=1 alors DescriptionPeinture="Peint.TLT" + requetesoumission.fNoPeintureExtTout + " " + sansespace(requetesoumission.fdescpeintureExtTout) sinon DescriptionPeinture="TLT Paint" + requetesoumission.fNoPeintureExtTout + " " + sansespace(requetesoumission.fdescpeintureExtTout)
         		cas 1
         			si client.CLangue=1 alors DescriptionPeinture="Peint. ext." + requetesoumission.fNoPeintureExtTout + " " + sansespace(requetesoumission.fdescpeintureExtTout) sinon DescriptionPeinture="Ext. Paint" + requetesoumission.fNoPeintureExtTout + " " + sansespace(requetesoumission.fdescpeintureExtTout)
         fin
         
         calculligne++
        type : 327692
      -
        code : |1+
         Remplir_tableau_gl(config.GlPeinturecarrelage,TotalCarr1)
         totaldepage+=totalcarr1
         
         si pas sansespace(requetesoumission.FnopeintureInterieure) = "" alors
         	iImprimeBloc(ITERATION8)
         FIN
         
         
        type : 327693
      -
        type : 327697
        enabled : false
