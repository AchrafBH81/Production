    properties :
     y : 162.27
     width : 269.4
     height : 3.70499999999998
    code_elements :
     type_code : 30
     p_codes :
      -
        code : |1+
         qtecarr = requetesoumission.fdqte
         qtecarr6 = requetesoumission.fdcarreauv
         qtecarr8 = requetesoumission.fdcarreauh
         DescCarr = requetesoumission.fddesc
         //qtecarr24 = requetesoumission.fdcarreauv * requetesoumission.fdcarreauh
         qtecarr24 = requetesoumission.fdnbcarreau
         
         si RequeteSoumission.TDemiCarrelage alors
         	PrixUnitCarr = RequeteSoumission.fdcarrpruxuc
         	TotalCarr = arrondi((((RequeteSoumission.fdcarrpruxuc)*RequeteSoumission.fdnbcarreau) + RequeteSoumission.fdcarrprixdebase)* RequeteSoumission.fdqteafacturer,2)
         sinon
         	PrixUnitCarr = RequeteSoumission.fdcarrpruxuc
         	TotalCarr = arrondi((RequeteSoumission.frcarrprixu + RequeteSoumission.fdcarrprixdebase)* RequeteSoumission.fdqteafacturer,2)
         FIN
        type : 327692
      -
        code : |1+
         totaldepage+=totalcarr
         remplir_tableau(requetesoumission.fdcodegl,totalcarr)
         
         si RequeteSoumission.TDemiCarrelage alors
         	iimprimebloc(ITERATION12)
         FIN
         
         
