  p_codes :
   -
     code : |1+
      procedure facturetrn(facturereimpression = faux,numerobonl=0)
      
      
      tableaucarrelage est un tableau dynamique
      tableaucarrelage = allouer un tableau de 0 par 5 chaine
      dimensiontableaucarrelage est un entier = 0
      calculligne est un entier = 0
      AncienNumCommande est un entier
      AncienNumcarrelage est une chaine = ""
      ldebut est un entier = vrai
      lTypeLigne est une chaine = "" // Verre, verre a l'unité, Unité , carrelage , Peinture
      totalpage est un reel = 0
      totalpage1 est un reel = 0
      totalfacture est un reel = 0
      totalsurcharge est un reel = 0
      totalcap est un reel = 0
      TotalSurchargeTaux est un reel = 0
      SurchargeTauxClient est un reel
      
      taxetaux1 est un reel 
      taxetaux2 est un reel 
      taxedesc1 est une chaine
      taxedesc2 est une chaine
      TaxeGL1 est une chaine
      TaxeGL2 est une chaine
      taxecombine est un booleen
      _tableautaxe est un tableau dynamique
      
      
      
      
      
      libérer fac_detail
      fac_detail = allouer un tableau de 1 par 4 chaine
      fac_detail[1,1] = ""
      fac_detail[1,2] = "0.00"
      hlit(config,1)
      
      SuchargeTauxBaseActive est un booleen = config.SUrchargeTauxActive
      SurchargeSurEnergie est un booleen = config.calculTauxSurSurcharge
      
     type : 327680
   -
     code : |1-
      
     type : 327695
  procedures :
   -
     name : Rupturefdcomm
     procedure_id : 5157988860661598334
     type_code : 14
     code : |1+
      Procédure Rupturefdcomm()
      
      iimprime("salut")
      
     type : 458752
   -
     name : Remplir_tableau
     procedure_id : 5157988860829894782
     type_code : 14
     code : |1+
      Procédure Remplir_tableau(codegl,montantgl,taxegl=faux)
      codegltrouve est un booleen = faux
      j est un entier = (dimension(fac_detail)/4)
      k est un entier
      si pas j = 1 alors
      pour k = 2 a j
      	si fac_detail[k,1] = codegl alors
      		codegltrouve = vrai
      		fac_detail[k,2]=numeriqueverschaine(val(fac_detail[k,2])+montantgl)
      	    sortir
      	FIN
      FIN
      fin
      
      si pas codegltrouve alors
          
      	dimension(fac_detail,j+1,4)
      	fac_detail[j+1,1] = codegl
      	fac_detail[j+1,2] = numeriqueverschaine(montantgl)
          si taxegl alors
          	fac_detail[j+1,3] = "1"
          fin	
      FIN
      
      
      
     type : 458752
   -
     name : assigneLibelle
     procedure_id : 5157988859331217534
     type_code : 14
     code : |1-
      Procédure assigneLibelle()
      i est un entier
      
      lTableauLibelle est un tableau de 43 chaines
      
      lTableauLibelle[1]  = "facpage,facpage"
      lTableauLibelle[2]  = "facpagede,facpagede"
      lTableauLibelle[3]  = "facdate,facdate"
      lTableauLibelle[4]  = "facjobdetail,facjobdetail"
      lTableauLibelle[5]  = "facquantite,facquantite"
      lTableauLibelle[6]  = "faclargeur,faclargeur"
      lTableauLibelle[7] = "fachauteur,fachauteur"
      lTableauLibelle[8] = "faclargeurpouce,faclargeurpouce"
      lTableauLibelle[9] = "fachauteurpouce,fachauteurpouce"
      lTableauLibelle[10] = "facdescription,facdescription"
      lTableauLibelle[11] = "facfini,facfini"
      lTableauLibelle[12] = "facspacer,facspacer"
      lTableauLibelle[13] = "faccarrelage,faccarrelage"
      lTableauLibelle[14] = "factotalcarr,factotalcarr"
      lTableauLibelle[15] = "facpiedcarre,facpiedcarre"
      lTableauLibelle[16] = "facpiedcarrefacture,facpiedcarrefacture"
      lTableauLibelle[17] = "facprixuni,facprixuni"
      lTableauLibelle[18] = "facsurcharge,facsurcharge"
      lTableauLibelle[19] = "facsoustotal,facsoustotal"
      lTableauLibelle[20] = "factotal,factotal"
      lTableauLibelle[21] = "factotalpage,factotalpage"
      //lTableauLibelle[22] = "facrecupar,facrecupar"
      lTableauLibelle[22] = "facmetrecarre,facmetrecarre"
      lTableauLibelle[23] = "facmetrecarrefacture,facmetrecarrefacture"
      lTableauLibelle[24] = "facprixunimetre,facprixunimetre"
      lTableauLibelle[25] = "factvq,factvq"
      lTableauLibelle[26] = "factps,factps"
      lTableauLibelle[27] = "lcondpaiement,condpaiement"
      lTableauLibelle[28] = "vendua,vendua"
      lTableauLibelle[29] = "livrea,livrea"
      lTableauLibelle[30] = "peinturetlt,peinturetlt"
      lTableauLibelle[31] = "peintureinterieure,peintureinterieure"
      lTableauLibelle[32] = "facmetre,facmetre"
      lTableauLibelle[33] = "facpied,facpied"
      lTableauLibelle[34] = "facmetrefacture,Facmetrefacture"
      lTableauLibelle[35] = "facpiedfacture,Facpiedfacture"
      lTableauLibelle[36] = "facprixupied,facprixupied"
      lTableauLibelle[37] = "facprixumetrelin,facprixumetrelin"
      lTableauLibelle[38] = "LibConfirmation,LibConfirmation"
      lTableauLibelle[39] = "LibLu,LibLu"
      lTableauLibelle[40] = "LibFaxCourriel,LibFaxCourriel"
      lTableauLibelle[41] = "LibConfirmation2,LibConfirmation2"
      lTableauLibelle[42] = "votrecommande,votrecommande"
      lTableauLibelle[43] = "facsurchargetaux,facsurchargetaux"
      selon client.CLangue
      	cas 1
      		pour i = 1 a 43
      			si hlitrecherche(Traduction,TRecherche,extraitchaine(lTableauLibelle[i],1,",")) alors
      				{"soumissiontrn."+ExtraitChaîne(lTableauLibelle[i],2,",")} = traduction.dFrancais
      			fin
      		FIN
      	cas 2
      		pour i = 1 a 43
      			si hlitrecherche(Traduction,TRecherche,extraitchaine(lTableauLibelle[i],1,",")) alors
      				{"soumissiontrn."+ExtraitChaîne(lTableauLibelle[i],2,",")} = traduction.danglais
      			fin
      		FIN
      fin
     type : 458752
   -
     name : AlimenteHistorique
     procedure_id : 5157988859975370878
     type_code : 14
     code : |1-
      Procédure AlimenteHistorique(lclient,ldate,lmontant)
      
      si  facturereimpression alors
      	renvoyer vrai
      FIN
      lannee est un entier= ldate..Année
      lmois est un entier = ldate..mois
      
      
      si hlitrecherche(HistoAnneeMois,lanneeMois,HConstruitValClé(HistoAnneeMois,lanneemois,lclient,lannee,lmois)) alors
      	HistoAnneeMois.lvente+= lmontant
      	hmodifie(HistoAnneeMois,hNumEnrEnCours)
      sinon
      	HistoAnneeMois.hclient = lclient
      	HistoAnneeMois.lAnnee = lannee
      	HistoAnneeMois.lmois = lmois
      	HistoAnneeMois.lvente = lmontant
      	hajoute(HistoAnneeMois)
      FIN
      
      renvoyer vrai
     type : 458752
   -
     name : AlimenteHistoriqueProduit
     procedure_id : 5157988861108160638
     type_code : 14
     code : |1+
      Procédure AlimenteHistoriqueProduit(lclient,ldate,ltype,lnumprod,lcomp1,lcomp2,lcomp3,lmontant,lsurcharge,ldesc,lqte)
      
      si  facturereimpression alors
      	renvoyer vrai
      FIN
      
      i est un entier
      lannee est un entier = numeriqueverschaine(ldate..annee)
      lmois est une chaine = remplir_zero(sansespace(numeriqueverschaine(ldate..mois)),2)
      lperiode est une chaine= lannee+lmois
      
      
      
      
      
      selon ltype
      
      	cas 1
      		si hlitrecherche(HistoAnneeMoisProduit,hClientlComp1lcomp2lcomp3lAnneelmois,...
      			HConstruitValClé(HistoAnneeMoisProduit,hClientlComp1lcomp2lcomp3lAnneelmois,lclient,"",lcomp1,...
      			lcomp2,lcomp3,lannee,lmois)) alors
      			HistoAnneeMoisProduit.lqte += lqte
      			HistoAnneeMoisProduit.lvente +=  arrondi(lmontant,2)
      			HistoAnneeMoisProduit.lsurcharge +=  arrondi(lsurcharge,2)
      			hmodifie(HistoAnneeMoisProduit,hNumEnrEnCours)
      		sinon
      			HistoAnneeMoisProduit.lperiode = lperiode
      			HistoAnneeMoisProduit.hClient = lclient
      			HistoAnneeMoisProduit.lAnnee = lannee
      			HistoAnneeMoisProduit.lmois = lmois
      			HistoAnneeMoisProduit.ldescription = ldesc
      			HistoAnneeMoisProduit.lProduit = lnumprod
      			HistoAnneeMoisProduit.lComp1 = lcomp1
      			HistoAnneeMoisProduit.lComp2 = lcomp2
      			HistoAnneeMoisProduit.lComp3 = lcomp3
      			HistoAnneeMoisProduit.lsurcharge =  arrondi(lsurcharge,2)
      			HistoAnneeMoisProduit.lqte = lqte
      			HistoAnneeMoisProduit.lType = "T"
      			HistoAnneeMoisProduit.lvente =  arrondi(lmontant,2)
      			hajoute(HistoAnneeMoisProduit)
      		FIN
      		
      		
      		
      	cas 4
      		si hlitrecherche(HistoAnneeMoisProduit,hClientlComp1lcomp2lcomp3lAnneelmois,...
      			HConstruitValClé(HistoAnneeMoisProduit,hClientlComp1lcomp2lcomp3lAnneelmois,lclient,lnumprod,"","","",lannee,lmois)) alors
      			HistoAnneeMoisProduit.lqte += lqte
      			HistoAnneeMoisProduit.lvente +=  arrondi(lmontant,2)
      			HistoAnneeMoisProduit.lsurcharge +=  arrondi(lsurcharge,2)
      			hmodifie(HistoAnneeMoisProduit,hNumEnrEnCours)
      		sinon
      			HistoAnneeMoisProduit.lperiode = lperiode
      			HistoAnneeMoisProduit.hClient = lclient
      			HistoAnneeMoisProduit.lAnnee = lannee
      			HistoAnneeMoisProduit.lmois = lmois
      			HistoAnneeMoisProduit.ldescription = ldesc
      			HistoAnneeMoisProduit.lComp1 = ""
      			HistoAnneeMoisProduit.lComp2 = ""
      			HistoAnneeMoisProduit.lComp3 = ""
      			HistoAnneeMoisProduit.lProduit = lnumprod
      			HistoAnneeMoisProduit.lsurcharge =  arrondi(lsurcharge,2)
      			HistoAnneeMoisProduit.lqte = lqte
      			HistoAnneeMoisProduit.lType = "C"
      			HistoAnneeMoisProduit.lvente =  arrondi(lmontant,2)
      			hajoute(HistoAnneeMoisProduit)
      		FIN
      	autre cas
      		si hlitrecherche(HistoAnneeMoisProduit,hClientlComp1lcomp2lcomp3lAnneelmois,...
      			HConstruitValClé(HistoAnneeMoisProduit,hClientlComp1lcomp2lcomp3lAnneelmois,lclient,lnumprod,"","","",lannee,lmois)) alors
      			HistoAnneeMoisProduit.lqte += lqte
      			HistoAnneeMoisProduit.lvente +=  arrondi(lmontant,2)
      			HistoAnneeMoisProduit.lsurcharge +=  arrondi(lsurcharge,2)
      			hmodifie(HistoAnneeMoisProduit,hNumEnrEnCours)
      		sinon
      			HistoAnneeMoisProduit.lperiode = lperiode
      			HistoAnneeMoisProduit.hClient = lclient
      			HistoAnneeMoisProduit.lAnnee = lannee
      			HistoAnneeMoisProduit.lmois = lmois
      			HistoAnneeMoisProduit.ldescription = ldesc
      			HistoAnneeMoisProduit.lComp1 = ""
      			HistoAnneeMoisProduit.lComp2 = ""
      			HistoAnneeMoisProduit.lComp3 = ""
      			HistoAnneeMoisProduit.lProduit = lnumprod
      			HistoAnneeMoisProduit.lsurcharge =  arrondi(lsurcharge,2)
      			HistoAnneeMoisProduit.lqte = lqte
      			HistoAnneeMoisProduit.lvente =  arrondi(lmontant,2)
      			hajoute(HistoAnneeMoisProduit)
      		FIN
      FIN
      
      
      
      
     type : 458752
