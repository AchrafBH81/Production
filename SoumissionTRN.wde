    properties :
     y : 75.886
     width : 269.4
     height : 86.384
    code_elements :
     type_code : 30
     p_codes :
      -
        code : |1+
         si requetesoumission.fsurchargepeinture <> 0 alors
         	iImprimeBloc(iteration7)
         	totalfacture+=requetesoumission.fsurchargepeinture
         	remplir_tableau(config.NoGlPeinture,arrondi(requetesoumission.fsurchargepeinture))
         FIN
         
         TotalSurchargeTaux = Arrondi(totalfacture+( SurchargeSurEnergie ? totalsurcharge SINON 0 ),2) * SurchargeTauxClient / 100
         TotaldeSurchargeTaux = TotalSurchargeTaux
         TotaldeSurcharge = totalsurcharge
         Totaldefacture = totalfacture + totalsurcharge +TotalSurchargeTaux
         //TotalTVH = Arrondi((totalfacture + totalsurcharge) * RequetefeuilleLivraison.fatps / 100,2)
         //TotalTVQ = Arrondi((totalfacture + totalsurcharge+(TaxeCalcul2sur1 ? TotalTVH SINON 0)) * RequetefeuilleLivraison.fatvq / 100,2)
         TotalTVH = Arrondi((totalfacture + totalsurcharge + TotalSurchargeTaux) * taxetaux1 / 100,2)
         TotalTVQ = Arrondi((totalfacture + totalsurcharge+TotalSurchargeTaux+(taxecombine ? TotalTVH SINON 0)) * taxetaux2 / 100,2)
         GrandTotal = Totaldefacture + TotalTVH + TotalTVQ
         SI PAS facturereimpression ALORS
         	fac_detail[1,2] = NumériqueVersChaîne(Arrondi(GrandTotal,2) * -1)
         	Remplir_tableau(config.SUrchargeTauxGl,Arrondi(TotalSurchargeTaux,2))
         	Remplir_tableau(config.surchargegl,Arrondi(totalsurcharge,2))
         	//	Remplir_tableau(config.gltps,Arrondi(TotalTVH,2),Vrai)
         	//	Remplir_tableau(config.gltvq,Arrondi(TotalTVQ,2),Vrai)
         	Remplir_tableau(TaxeGL1,Arrondi(TotalTVH,2),Vrai)
         	Remplir_tableau(TaxeGL2,Arrondi(TotalTVQ,2),Vrai)
         FIN
         
         
        type : 327692
      -
        type : 327697
        enabled : false
