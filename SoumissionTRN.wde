    properties :
     y : 61.882
     width : 269.4
     height : 4.234
    code_elements :
     type_code : 30
     p_codes :
      -
        code : |1-
         
        type : 327694
      -
        code : |1+
         
         
         //// ****************** Nouveau code ****************************
         
         j est un entier
         indicecarr est un entier
         carrtrouve est un booleen = faux//A FAIRE :
         carrnogl est une chaine
         si requetesoumission.ftype = 1 alors
         	lTypeLigne = "Verre"
         sinon si requetesoumission.ftype = 2 
         	si pas requetesoumission.fdverreunite alors
         		lTypeLigne = "Unite"
         	sinon
         		lTypeLigne = "Verre"
         	fin
         sinon si requetesoumission.ftype = 3
         	ltypeligne = "Fourniture" 
         sinon si requetesoumission.ftype = 4
         	ltypeligne = "Carrelage" 
         sinon si requetesoumission.ftype = 5
         	ltypeligne = "Peinture" 
         fin
         
         //si requetesoumission.ftype = 4 alors
         //	corps..visible = faux
         //sinon
         calculligne++
         
         selon lTypeLigne
         	cas "Unite"
         		CORPS..VISIBLE = VRAI
         		rubrique17 = requetesoumission.fdprixu
         		rubrique16 = 1
         		//		rubrique16..visible = faux
         	cas "Verre"	
         		corps..visible = vrai
         		si Val(SansEspace(RequeteSoumission.ftypespacer)) <> 0 _and_ hlitrecherche(IntercalaireCouleurs,IDIntercalaireCouleurs,val(SansEspace(RequeteSoumission.ftypespacer))) alors
         			SI Client.CLangue=1 ALORS CSpacer=IntercalaireCouleurs.DescriptionCourte SINON CSpacer=IntercalaireCouleurs.DesctiptionCourteAnglais
         		SINON
         			CSpacer = ""	
         			
         		FIN
         //		si hlitrecherche(typespac,tnumero,sansespace(RequeteSoumission.ftypespacer)) alors
         //			si client.CLangue=1 alors cspacer=typespac.tdesccourte sinon cspacer=typespac.tdesccourtea
         //		sinon
         //			cspacer = ""	
         //		FIN
         	cas "Carrelage"
         		corps..visible = faux
         		iImprimeBloc(ITERATION1)
         	cas "Fourniture"	
         		corps..visible = faux
         		iImprimeBloc(ITERATION10)
         		//		rubrique16..visible = vrai
         	cas "Peinture"
         		corps..visible = faux
         		iImprimeBloc(ITERATION2)
         fin
         
         selon lTypeLigne
         	cas "Unite"
         		totalpage +=  arrondi(requetesoumission.fdqteafacturer * requetesoumission.fdprixu,2)
         		totalfacture +=  arrondi(requetesoumission.fdqteafacturer * requetesoumission.fdprixu,2)
         	cas "Verre"
         		totalpage +=  arrondi(requetesoumission.fdqteafacturer * ((requetesoumission.fdpiedcarrefacture * requetesoumission.fdprixupiedfacture) + ...
         		requetesoumission.fdextraforme),2)
         		totalfacture +=  arrondi(requetesoumission.fdqteafacturer * ((requetesoumission.fdpiedcarrefacture * requetesoumission.fdprixupiedfacture)+ ...
         		requetesoumission.fdextraforme),2)+arrondi(RequeteSoumission.fdqteafacturer *RequeteSoumission.FDextra10X,2)+...
         		arrondi(RequeteSoumission.fdqteafacturer *RequeteSoumission.FDextra5x,2)
         
         		totalsurcharge += arrondi(requetesoumission.surchargeenergie,2)
         		totalcap+= arrondi(requetesoumission.FDExtraCap * requetesoumission.fdqteafacturer,2)
         
         	cas "Carrelage"
         		totalpage +=  arrondi(requetesoumission.fdcarrprixtotal+requetesoumission.fTotalPeinture,2)
         		totalfacture +=arrondi((requetesoumission.frcarrprixu + requetesoumission.fdcarrprixdebase)* requetesoumission.fdqteafacturer,2)...
         		+arrondi(((requetesoumission.Ftotalcarreaupeinture*requetesoumission.fPrixCarreauPeinture)...
         		+(requetesoumission.FDnbcarreauPeinture1*requetesoumission.fdprixcarreaupeinture1))...
         		* requetesoumission.fdqteafacturer ,2)
         
         
         	cas "Peinture"
         		totalpage +=  arrondi(requetesoumission.fdprixtotal,2)
         		totalfacture +=  arrondi(requetesoumission.fdprixtotal,2)
         fin
         
         
         
         
         
         
         
         
         
        type : 327692
      -
        code : |1+
         si requetesoumission.ftype <> 4 alors
         
         	si pas facturereimpression alors
         		si requetesoumission.ftype <> 4 alors
         			SI requetesoumission.FDExtraCap <> 0 ALORS
         				remplir_tableau(rubrique21,arrondi(rubrique18,2) - (arrondi(requetesoumission.FDExtraCap) * requetesoumission.fdqteafacturer))
         				remplir_tableau(CONFIG.CapGL,arrondi(requetesoumission.FDExtraCap) * requetesoumission.fdqteafacturer)
         			SINON
         				remplir_tableau(rubrique21,arrondi(rubrique18,2))
         			FIN
         		fin
         	FIN
         
         	si RequeteSoumission.FDextra5x <> 0 ou RequeteSoumission.FDextra10X <> 0 alors
         		calculligne++
         		iimprimebloc(ITERATION11)
         	fin
         
         	si pas sansespace(requetesoumission.fdforme) = ""  
         		calculligne++
         		iImprimeBloc(ITERATION9)	
         		//  totalpage +=  totalextraforme
         		//  totalfacture +=  totalextraforme
         	FIN
         	si pas sansespace(requetesoumission.fnotes) = ""  //ou requetesoumission.fdextraforme <> 0 ALORS
         		calculligne++
         		iImprimeBloc(ITERATION3)	
         		//  totalpage +=  totalextraforme
         		//  totalfacture +=  totalextraforme
         	FIN
         	
         	si pas sansespace(requetesoumission.fnotes1) = ""   ALORS
         		calculligne++
         		iImprimeBloc(ITERATION5)	
         		//  totalpage +=  totalextraforme
         		//  totalfacture +=  totalextraforme
         	FIN
         sinon
         	si requetesoumission.fpeinture alors
         		calculligne++
         		iImprimeBloc(ITERATION6)	
         
         	FIN
         fin
         
         si CORPS..visible ALORS
         	TotaldePage+=rubrique18
         FIN
        type : 327693
      -
        type : 327697
        enabled : false
