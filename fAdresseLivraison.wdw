 popup_menus : []
 message_bar :
  internal_properties : CQAAAAkAAADCMsSX0/Saexx5MQcb4a0HXPjwHYxAERXjCBqvfp/5bFeYe5jvl/nrqCbcfqkKVWCIg2Ua6JGFUp0iFWIom2jVIOptfT08t9/lhLsjB21U/z7rRRcM9hqviv2eBQ==
 actionbar : {}
 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1-
      procedure fadresselivraison(lnoclient = "")
      si hlitrecherche(Client,numero,lnoclient) ALORS
       Libellé1 = client.nom	
      FIN
      si pas client.LivraisonPourVideojet alors
      	tNoVideojet..visible = faux
      	TableLivraison..largeur = TableLivraison..LargeurInitiale-50
      	TableLivraison..x = (fAdresseLivraison..largeur-TableLivraison..largeur)/2
      	BtnDefaut..x  += 25
      FIN
   -
     code : |1+
      remplirtablelivraison()
     type : 34
   -
     type : 180
     enabled : false
   -
     type : 230
     enabled : false
   -
     type : 11
   -
     type : 12
   -
     type : 17
   -
     type : 13
  procedures :
   -
     name : remplirtablelivraison
     procedure_id : 5140493190827332770
     type_code : 14
     code : |1+
      Procédure remplirtablelivraison()
      TableSupprimeTout(TableLivraison)
      hlitrecherche(ClientLivraison,idclient,sansespace(lnoclient))
      tantque pas hendehors(ClientLivraison) et ClientLivraison.idclient = sansespace(lnoclient)
      	tableajouteligne(TableLivraison,ClientLivraison.lNom,ClientLivraison.lRue,ClientLivraison.lVille,ClientLivraison.lDefaut,ClientLivraison.EstPickUp,ClientLivraison.IDClientLivraison,...)
      	ClientLivraison.lNumeroVideojet,ClientLivraison.Identifiant)
      	hlitsuivant(ClientLivraison,idclient)
      FIN
      si TableLivraison..vide alors
      	BTN_MODIFIE..etat = grise
      	BTN_DETRUIRE..etat = grise
      sinon
      	BTN_MODIFIE..etat = actif
      	BTN_DETRUIRE..etat = actif
      fin
     type : 458752
  procedure_templates : []
  property_templates : []
