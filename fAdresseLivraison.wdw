  -
    name : Libellé1
    identifier : 0x4756dd933b11e25b
    internal_properties : 
    properties :
     x : 49
     y : 70
     width : 339
     height : 20
    type : 3
    code_elements :
     type_code : 2
     p_codes : []
  -
    name : BTN_DETRUIRE
    identifier : 0x4756df995a2acb03
    internal_properties : 
    properties :
     x : 188
     y : 6
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         restaure_bouton()
         si acso_message("Question","Voulez-vous annuler cette adresse de livraison","OuiNon") = idyes alors
          TableSauvePositionEtSélection(TableLivraison)
           pour TOUT JourLivraisonClient avec IdAdresseLivraison = TableLivraison.lIdLivraison[TableLivraison]
           	hsupprime(JourLivraisonClient,hNumEnrEnCours)
           FIN
           si hlitrecherche(ClientLivraison,IDClientLivraison,TableLivraison.lIdLivraison[TableLivraison]) alors
             hsupprime(ClientLivraison,hNumEnrEnCours)
           fin	
         FIN
         
         remplirtablelivraison()
         TablerestaurePositionEtSélection(TableLivraison)
         si TableLivraison..vide alors
         	 client.cRapportLivraisonDetaille = faux
              hmodifie(Client,hNumEnrEnCours)
              info("Si l'impression du rapport de livraison détaillé pour ce client était actif, il vient d'être désactivé ")
         FIN
        type : 18
      -
        type : 161
        enabled : false
  -
    name : Bouton1
    identifier : 0x47ebdd5e612cc03f
    internal_properties : 
    properties :
     x : 898
     y : 144
     width : 80
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        type : 161
        enabled : false
  -
    name : BtnDefaut
    identifier : 0x47ebde056e2148ed
    internal_properties : 
    properties :
     x : 627
     y : 88
     width : 20
     height : 20
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         si hlitrecherche(ClientLivraison,IDClientLivraison,tablelivraison.lIDLivraison[tablelivraison]) alors
         	ClientLivraison.lDefaut = vrai
         	hmodifie(ClientLivraison,hNumEnrEnCours)
         FIN
         hlitrecherche(ClientLivraison,idclient,sansespace(client.numero))
         tantque pas hendehors(ClientLivraison) et sansespace(ClientLivraison.idclient) = sansespace(client.numero)
         	si ClientLivraison.IDClientLivraison <> tablelivraison.lIDLivraison[tablelivraison] alors
         		ClientLivraison.lDefaut = faux
         		hmodifie(ClientLivraison,hNumEnrEnCours)
         
         	FIN
         	HLitSuivant(ClientLivraison,idclient)
         FIN
         
         remplirtablelivraison()
        type : 18
      -
        type : 161
        enabled : false
 menu :
  name : _Menu
  identifier : 0x4756aad1306c9eec
  internal_properties : 
