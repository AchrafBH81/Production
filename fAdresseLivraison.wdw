  -
    name : BTN_MODIFIE
    identifier : 0x4756b190556cf58a
    internal_properties : 
    properties :
     x : 147
     y : 6
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         TableSauvePositionEtSélection(TableLivraison)
         hlitrecherche(ClientLivraison,IDClientLivraison,TableLivraison.lIdLivraison[TableLivraison])
         ouvre(fAjoutAdresseLivraison,lnoclient,"M",client.LivraisonPourVideojet)
         
         remplirtablelivraison()
         
         TableRestaurePositionEtSélection(TableLivraison)
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_AJOUT
    identifier : 0x4756b19033a1f58a
    internal_properties : 
    properties :
     x : 111
     y : 6
     width : 32
     height : 32
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         TableSauvePositionEtSélection(TableLivraison)
         _IdClientLivraison est un entier = ouvre(fAjoutAdresseLivraison,lnoclient,"A",client.LivraisonPourVideojet)
         remplirtablelivraison()
         _ligne est un entier= Tablecherche(lIdLivraison,_idclientlivraison,rechercheIdentique)
         si _ligne <> -1 alors
         	tableselectplus(TableLivraison,_ligne)
         FIN
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_SORTIE
    identifier : 0x4756b190073df599
    internal_properties : 
    properties :
