     p_codes :
      -
        code : |1-
         HSurErreur(RelationEDI,hErrDoublon,"")
         
         pour i = 1 _a_ TableOccurrence(Table__tabrelationspacer)
         	hraz(RelationEDI)
         	relationedi.TYpeObjet = 3
         	RelationEDI.IdClient = idclientcourant
         	
         	relationedi.descriptionEDIClient = Table__tabrelationspacer.Description[i]
         	relationedi.IDSpacer = Table__tabrelationspacer.Colonne1[i]
         	hajoute(relationedi)
         	si HErreurDoublon() alors
         
         	FIN
         FIN
         
         ferme(mafenetre)
        type : 18
      -
        type : 161
        enabled : false
