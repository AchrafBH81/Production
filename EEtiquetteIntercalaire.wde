         -
           code : |1-
            si hlitrecherche(facture,fanumero,fdetail.fdnocomm) alors
            	moimeme = sansespace(facture.fanojob)
            FIN
            
            si pas sansespace(fdetail.FDJOBLIGNE) = "" alors
            	moimeme += "/"+sansespace(fdetail.FDJOBLIGNE)
            FIN
