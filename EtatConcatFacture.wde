        code : |1+
         
         pour i = 1 _a_ ChaîneOccurrence(lConcatFacture,";")
         	iHautBasPageImbriqué(vrai)
              iPageNum(1)
         	HExécuteRequête(ReqGroupShippingBill,hRequêteDéfaut,ExtraitChaîne(lconcatfacture,i,";"))
         	iimprimeetat(EGroupInvoice,Faux,extraitchaine(lconcatfacture,i,";"))
         	si i < chaineoccurrence(lconcatfacture,";") alors iterminepage()
         FIN
         
         
