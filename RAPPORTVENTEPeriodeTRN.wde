 controls : []
 code_elements :
  type_code : 13
  p_codes :
   -
     code : |1+
      Procedure _RAPPORT_VENTE(lchoixrapport="", lchoixsommaire="", lperiode="",lsecteur="",lmois="",lannee="",lsaut = 2)
      
      global
      	sautdepage est un booleen
      hlitpremier("config","COCLEUNIK")
      moisdebut est un entier = val(dateverschaine(config.canneeencoursdebut,"MM"))
      
      //szmodeetat = "PAYSAGE"
      anciensecteur est une chaine = ""
      si sansespace(lchoixrapport) = "Tous" et lchoixsommaire alors
      	sautdepage = faux
      sinon
      
      //	si lsaut = 1 alors
      		sautdepage = vrai
      //	fin
      
      	//Code WinDev 5.5 remplacé par la migration :
      	//	bloc_fin..VISIBLE = FAUX	
      	bloc_fin..Visible=Faux	
      FIN
      
      lmoisabrev est un tableau de 12 chaines
      lmoisabrev[1] = "Janv."
      lmoisabrev[2] = "Févr."
      lmoisabrev[3] = "Mars"
      lmoisabrev[4] = "Avril"
      lmoisabrev[5] = "Mai"
      lmoisabrev[6] = "Juin"
      lmoisabrev[7] = "Juil."
      lmoisabrev[8] = "Août"
      lmoisabrev[9] = "Sept."
      lmoisabrev[10] = "Oct."
      lmoisabrev[11] = "Nov."
      lmoisabrev[12] = "Déc."
      
     type : 327680
   -
     code : |1+
      si lchoixrapport <> "Tous" alors
      	si client.secteur = lsecteur alors
      		renvoyer vrai
      	sinon
      		renvoyer faux	
      	FIN
      sinon
      	renvoyer vrai
      FIN
      
     type : 327696
  procedures :
   -
     name : TRISECTEUR
     procedure_id : 5161038449057384200
     type_code : 14
     code : |1+
      Procédure TRISECTEUR()
      
      HLITRECHERCHE("client","numero",bonlivraison.bclient)
      
      //Code WinDev 5.5 remplacé par la migration :
      //SI PAS H.ENDEHORS ET H.TROUVE ALORS
      SI PAS HEnDehors() ET HTrouve() ALORS
      	RENVOYER client.secteur
      SINON
      	RENVOYER 0 
      FIN
      
     type : 458752
   -
     name : ajoutezero
     procedure_id : 5161038450755421960
     type_code : 14
     code : |1+
      Procédure ajoutezero(chaineamodifier)
      valeuraretourner est une chaine
      si val(chaineamodifier) > 12 alors
         chaineamodifier = sansespace(numeriqueverschaine(val(chaineamodifier) - 12))
      fin
      si taille(sansespace(chaineamodifier)) = 2 alors
      	valeuraretourner = chaineamodifier
      sinon
      	valeuraretourner = "0"+chaineamodifier	
      FIN
      renvoyer(valeuraretourner)
      
     type : 458752
  procedure_templates : []
  property_templates : []
