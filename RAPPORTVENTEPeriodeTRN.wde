        p_codes :
         -
           code : |1+
            hlitrecherche("secteur","secteur",client.secteur)
            
            si pas sautdepage alors
            	lesecteur = "Tous"
            sinon
            	
            //Code WinDev 5.5 remplacé par la migration :
            //si h.trouve alors
            //si HTrouve() alors
            	lesecteur = sansespace(secteur.sdescription)
            //FIN
            
            si anciensecteur = secteur.secteur alors
            	lesecteur += " (Suite...)"
            FIN
            fin
            
