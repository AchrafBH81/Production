           code : |1+
            
            
            hlitrecherche("secteur","secteur",sansespace(numeriqueverschaine(client.secteur)))
            
            //Code WinDev 5.5 remplacé par la migration :
            //si h.trouve alors
            si HTrouve() alors
            	secteurdescription = "Total secteur " + sansespace(secteur.sdescription)
            FIN
            
