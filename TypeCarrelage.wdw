 controls :
  -
    name : BTN_SORTIE
    identifier : 0x400dc9d7732085f0
    internal_properties : 
    properties :
     x : 15
     y : 6
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         
         //RADDebloque()		// Débloque l'enregistrement
         Ferme
         
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_AJOUT
    identifier : 0x400dc9d77ee285fa
    internal_properties : 
    properties :
     x : 98
     y : 6
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         // Ajoute
         //Code WinDev 5.5 remplacé par la migration :
         //Table..Etat=Actif
         Table_Typecarrelage..Etat=Actif; Table_Typecarrelage..Visible=Vrai
         TableAjoute(Table_Typecarrelage)
         RepriseSaisie(Table_Typecarrelage.TypeCarrDesc)
         
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_DETRUIRE
    identifier : 0x400dc9d73be58604
    internal_properties : 
    properties :
     x : 135
     y : 6
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         
         // Suppression
         si Table_Typecarrelage..Nouveau alors
         	si Table_Typecarrelage..occurrence<2 alors
         		REPRISESAISIE(Table_Typecarrelage)
         	sinon
         		TableSupprime(Table_Typecarrelage)
         	fin
         sinon
         	si (Table_Typecarrelage..Etat=AffichageSeulement ET Table_Typecarrelage..Visible=Vrai) alors
         		acso_message("Erreur","Information déjà en utilisation ","Erreur")
         		retour
         	fin
         	si acso_message("Question","Voulez-vous supprimer l'enregistrement?","OuiNon") = idyes alors
         		TableSupprime(Table_Typecarrelage)
         		si HErreurIntegrite() alors
         			Erreur(HErreurInfo())	// "Erreur d'intégrité"
         			Retour
         		Fin
         	fin
         fin
         
         si TableOccurrence(Table_Typecarrelage)=0 alors
         	REPRISESAISIE(Table_Typecarrelage)
         SINON
         	// Le bouton Supprimer est en interruption
         	// Il faut forcer l'entrée dans la nouvelle ligne
         
         	ExecuteTraitement(Table_Typecarrelage,trtENTREELIGNE)
         fin
         tableaffiche(Table_Typecarrelage)
        type : 18
      -
        type : 161
        enabled : false
