 controls : []
 code_elements :
  type_code : 13
  p_codes :
   -
     code : |1+
      Procedure FichierTransfertCommandeClient(Noprep = "")
      
      cpt est un entier = 1
      LastClient est une chaine = ""
      SourceData est une chaine = FichierTransfertCommandeClient..NomSource
      
      
      
      
      
      
      
      
      
     type : 327680
   -
     code : |1+
      //si tempo.Tfabrication alors renvoyer faux
      si lastclient <> masource.tclient alors
      	lastclient = masource.tclient
      	cpt++
      FIN
      
     type : 327695
