           type : 17
     -
       name : COL_QteBO
       identifier : 0x29cc288eff532d05
       internal_properties : CQAAAAkAAAAacPhGXOhhC5ERtFadsAc7Nk+ZT/erZW0TGC8+Zr4Cgeb9CxjH0/lQDJ4afV+XN6orMSWVse+6LW+pvVoa2EVDUhAKgtFmJSP6FK94MsCzdmreOYFZZXwzNCNeRpAHhepor5YYzNoPqExSIMHLYbYlGq1/R2iDo0p6zYvP6xclymSjNZMahF38djMEtkV/upsZwGfOtj+Y35YWs1pCru4Z3dSBvCBS9wY=
       type : 2
       content :
        internal_properties : 
        properties : {}
        type : 2
       code_elements :
        internal_properties : CQAAAAkAAACVbIAZKIyLUtOx/TRl3LdawH8KiRIbZVPHIi3CQG0ZQWORAsfR1LV9KK1m6uVL3Trxd5kjIU0MB2uWkg==
        type_code : 3
        p_codes :
         -
           code : |1-
            // Vérifier qu'on est sur une ligne enfant
            nQteProduced	est un entier	= TABLE_ProductionJour.COL_QteProduced
            nQteAFacturer	est un entier	= TABLE_ProductionJour.COL_QteAFacturer
            nLigneDetail	est un entier	= TABLE_ProductionJour.COL_FdLigne
            nQteBO est un entier   = TABLE_ProductionJour.COL_QteBO                                                                                                                                                                                             
            
            // Trouver le numéro de commande (remonter au parent)
            nLigneCourante	est un entier	= TableSelect(TABLE_ProductionJour)
            nLigneParent	est un entier	= nLigneCourante - 1
            TANTQUE nLigneParent >= 1 ET TABLE_ProductionJour.COL_TypeLigne[nLigneParent] <> "P"
            	nLigneParent--
            FIN
            nNumeroCommande est un entier = TABLE_ProductionJour.COL_Numero[nLigneParent]
            
            // Validation
            SI nQteBO < 0 ALORS
            	Erreur("La quantité BO ne peut pas être négative.")
            	TABLE_ProductionJour.COL_QteBO	= 0
            	nQteBO							= 0
            FIN
            
            SI nQteBO + nQteProduced > nQteAFacturer alors
            	Erreur("La somme de la quantité produite et de la quantité BO ne peut pas dépasser la quantité à produire (" + nQteAFacturer + ").")
            	TABLE_ProductionJour.COL_QteBO	= 0
            	nQteBO							= 0
            FIN
            
            // Mise à jour du détail en base de données
            HLitRecherche(Fdetail, fdcle, [nNumeroCommande, nLigneDetail])
            SI HTrouve(Fdetail) ALORS
            	Fdetail.Fdqte_BackOrder = nQteBO
            	HModifie(Fdetail)
            	
            	AppliquerCouleurLigne(nLigneCourante, nQteProduced + nQteBO, nQteAFacturer)
            	
            	// Recalculer le total BO pour la commande
            	nTotalBO est un entier = 0
            	HFiltre(Fdetail, fdnocomm, nNumeroCommande, nNumeroCommande)
            	HLitPremier(Fdetail, fdnocomm)
            	TANTQUE HEnDehors(Fdetail) = Faux
            		SI Fdetail.ftype = 1 ALORS
            			nTotalBO += Fdetail.Fdqte_BackOrder
            		FIN
            		HLitSuivant(Fdetail, fdnocomm)
            	FIN
            	HDésactiveFiltre(Fdetail)
            	
            	// Mettre à jour la Facture en DB
            	HLitRecherche(Facture, fanumero, nNumeroCommande)
            	SI HTrouve(Facture) ALORS
            		Facture.NumberOfThermosBackOrdered	= nTotalBO
            		Facture.Started					    = (nTotalBO + Facture.NumberOfThermosProduced > 0)
            		Facture.Completed				    = (nTotalBO + Facture.NumberOfThermosProduced >= Facture.NumberOfThermosToProduce ET Facture.NumberOfThermosToProduce > 0)
            		
            		IF Facture.Completed ALORS
            			Facture.FPREPARATION = "F"
            		FIN
            		
            		HModifie(Facture)
            		
            		// Mettre à jour l'affichage du parent
            		TABLE_ProductionJour.COL_QteBO[nLigneParent]	= nTotalBO
            		TABLE_ProductionJour.COL_Completed[nLigneParent]	= (nTotalBO + Facture.NumberOfThermosProduced >= Facture.NumberOfThermosToProduce ET Facture.NumberOfThermosToProduce > 0)
            		
            		nAProduire	est un entier	= Facture.NumberOfThermosToProduce
            		AppliquerCouleurLigne(nLigneParent, nTotalBO + Facture.NumberOfThermosProduced, nAProduire)
            	FIN
            FIN
           type : 16
