    name : BTN_ImprimerBL
    identifier : 0x29a1ba0d339cf072
    internal_properties : 
    properties :
     x : 471
     y : 9
     width : 172
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         // Arrêter le timer pendant l'impression
         ArrêterTimer()
         
         
         // Tableau pour regrouper par adresse de livraison
         tabParLivraison	est un tableau associatif de cCustomerOrderToPrint
         
         sDateFiltre		est une chaîne	= DateVersChaîne(SAI_DateFiltre, "AAAAMMJJ")
         HFiltre(Facture, FDATEREQUISE, sDateFiltre, sDateFiltre)
         nNbCommandes est un entier = 0
         
         HLitPremier(Facture, FDATEREQUISE)
         TANTQUE HEnDehors(Facture) = Faux
         	
         	// Sélectionner uniquement les commandes complétées et non encore imprimées
         	SI Facture.Completed = Vrai ET Facture.FPREPARATION = "F"  ALORS
         		
         		nNbCommandes++
         		sCléLivraison est une chaîne = Facture.idLivraison
         		
         		// Créer le groupe de livraison si nécessaire
         		SI tabParLivraison[sCléLivraison] = Null ALORS
         			clCustomer est un cCustomerOrderToPrint
         			clCustomer.m_nCustomerID			= Facture.IDClient
         			clCustomer.m_nShippingCustomerID	= Facture.idLivraison
         			
         			// Charger les infos client
         			HLitRecherche(client, IDClient, Facture.IDClient)
         			SI HTrouve(client) ALORS
         				clCustomer.m_clCustomerInfo.m_nom			= client.nom
         				clCustomer.m_clCustomerInfo.m_numero		= client.numero
         				clCustomer.m_clCustomerInfo.m_crue			= client.crue
         				clCustomer.m_clCustomerInfo.m_cville		= client.cville
         				clCustomer.m_clCustomerInfo.m_ccodepostal	= client.ccodepostal
         				clCustomer.m_clCustomerInfo.m_ctelephone	= client.ctelephone
         			FIN
         			clCustomer.GetSequence(clCustomer.m_nCustomerID,gnCurrentSeason,clCustomer.m_nShippingCustomerID,gnCurrentDay)
         			
         			// Charger l'adresse de livraison
         			HLitRecherche(ClientLivraison, IDClientLivraison, Facture.idLivraison)
         			SI HTrouve(ClientLivraison) ALORS
         				clCustomer.m_clShippingdetail.m_sLNom		= ClientLivraison.lNom
         				clCustomer.m_clShippingdetail.m_sLRue		= ClientLivraison.lRue
         				clCustomer.m_clShippingdetail.m_sLVille		= ClientLivraison.lVille
         				clCustomer.m_clShippingdetail.m_sLProvince	= ClientLivraison.lprovince
         				clCustomer.m_clShippingdetail.m_sLCodePostal	= ClientLivraison.lCodePostal
         				clCustomer.m_clShippingdetail.m_sLContact	= ClientLivraison.lContact
         				clCustomer.m_clShippingdetail.m_sLtelephone	= ClientLivraison.ltelephone
         			FIN
         			
         			tabParLivraison[sCléLivraison] = clCustomer
         		FIN
         		
         		// Créer l'objet commande
         		clOrder est un cOrderToPrint
         		clOrder.m_nOrderNumber			= Facture.fanumero
         		clOrder.m_sCustomerOrderNumber	= Facture.fanocommande
         		clOrder.m_sCustomerNumberJob	= Facture.fanojob
         		clOrder.m_nTruckID = facture.IDCamions
         		SI tabParLivraison[sCléLivraison].m_sTruckNumber = "" ALORS
         			SI HLitRecherche(Camions,IDCamions,clOrder.m_nTruckID) ALORS
         				tabParLivraison[sCléLivraison].m_sTruckNumber = Camions.NoCamion
         			FIN      	
         		FIN  
         		// Charger les lignes de détail (thermos)
         		HFiltre(Fdetail, fdnocomm, Facture.fanumero, Facture.fanumero)
         		HLitPremier(Fdetail, fdnocomm)
         		TANTQUE HEnDehors(Fdetail) = Faux
         			SI Fdetail.ftype = 1 ALORS
         				clDetail est un cOrderDetail
         				clDetail.m_nDetailLineID		= Fdetail.fdligne
         				clDetail.m_sProductNumber		= Fdetail.fdnumprod
         				clDetail.m_sProductdescription	= Fdetail.fddesc
         				clDetail.m_nLineNumber			= Fdetail.fdligne
         				clDetail.m_nQtyProduced			= Fdetail.Fdqte_Produced
         				clDetail.m_nQtyBackOrder        = fdetail.Fdqte_BackOrder
         				clDetail.m_sBackOrderReason     = fdetail.Fdqte_BackOrderreason
         				
         				TableauAjoute(clOrder.m_tabOrderDetail, clDetail)
         			FIN
         			HLitSuivant(Fdetail, fdnocomm)
         		FIN
         		HDésactiveFiltre(Fdetail)
         		
         		// Ajouter la commande au groupe de livraison
         		TableauAjoute(tabParLivraison[sCléLivraison].m_tabOrder, clOrder)
         		
         	FIN
         	
         	HLitSuivant(Facture, FDATEREQUISE)
         FIN
         
         HDésactiveFiltre(Facture)
         
         // Vérifier qu'il y a des commandes à imprimer
         SI nNbCommandes = 0 ALORS
         	Info("Aucune commande complétée à imprimer pour cette date.")
         	DémarrerTimer()
         	RETOUR
         FIN
         
         // Confirmation
         SI OuiNon("Imprimer les bons de livraison pour " + nNbCommandes + " commande(s) ?") = Non ALORS
         	DémarrerTimer()
         	RETOUR
         FIN
         
         // Construire le tableau final pour l'impression
         tabCustomerOrders est un tableau de cCustomerOrderToPrint
         POUR TOUT clCust DE tabParLivraison
         	TableauAjoute(tabCustomerOrders, clCust)
         FIN
         
         sDebug est une chaîne = "=== OBJETS CONSTRUITS ===" + RC + RC
         
         // Debug : afficher le contenu des objets construits    
         //Création d'un tableau de raison de Backorder
         
         tabBackOrder est un tableau de stBackOrder
         
         POUR TOUT clCust DE tabCustomerOrders
         	sDebug += "--- GROUPE LIVRAISON ---" + RC
         	sDebug += "  CustomerID : " + clCust.m_nCustomerID + RC
         	sDebug += "  ShippingID : " + clCust.m_nShippingCustomerID + RC
         	sDebug += "  Client : " + clCust.m_clCustomerInfo.m_nom + RC
         	sDebug += "  Numero : " + clCust.m_clCustomerInfo.m_numero + RC
         	sDebug += "  Rue : " + clCust.m_clCustomerInfo.m_crue + RC
         	sDebug += "  Ville : " + clCust.m_clCustomerInfo.m_cville + RC
         	sDebug += "  Livraison Nom : " + clCust.m_clShippingdetail.m_sLNom + RC
         	sDebug += "  Livraison Rue : " + clCust.m_clShippingdetail.m_sLRue + RC
         	sDebug += "  Livraison Ville : " + clCust.m_clShippingdetail.m_sLVille + RC
         	sDebug += "  Nb commandes : " + clCust.m_tabOrder..Occurrence + RC + RC
         	
         	POUR TOUT clOrder DE clCust.m_tabOrder
         		sDebug += "    COMMANDE #" + clOrder.m_nOrderNumber + RC
         		sDebug += "    No cmd client : " + clOrder.m_sCustomerOrderNumber + RC
         		sDebug += "    No job : " + clOrder.m_sCustomerNumberJob + RC
         		sDebug += "    Nb détails : " + clOrder.m_tabOrderDetail..Occurrence + RC
         		
         		POUR TOUT clDetail DE clOrder.m_tabOrderDetail
         			si clDetail.m_nQtyBackOrder <> 0 alors
         				stCurrentBackOrder est un stBackOrder = allouer un stBackOrder
         				stCurrentBackOrder.OrderNumber = clOrder.m_nOrderNumber
         				stCurrentBackOrder.ProductNumber = clDetail.m_sProductNumber
         				stCurrentBackOrder.ProductDescription = clDetail.m_sProductdescription
         				stCurrentBackOrder.QtybackOrder = clDetail.m_nQtyBackOrder
         				stCurrentBackOrder.BackOrderreason = clDetail.m_sBackOrderReason
         				tabBackOrder.ajoute(stCurrentBackOrder)
         				
         			FIN
         			sDebug += "      Ligne " + clDetail.m_nLineNumber + " | " + clDetail.m_sProductNumber + " | " + clDetail.m_sProductdescription + " | Qté: " + clDetail.m_nQtyProduced + RC
         		FIN
         		sDebug += RC
         	FIN
         FIN
         
         // Appeler la procédure d'impression
         tabCustomerOrders.Trie(ttMembre,"m_sTrucknumber;m_nShippingSequence")
         PrintBatchShippingBills(tabCustomerOrders,0,gnCurrentSeason)
         
         
         iApercu()
         si tabBackOrder..Occurrence > 0 alors iimprimeetat(eBackOrder,tabBackOrder)
         
         // remplir un tableau de raison pour les backorder
         
         
         
         //// Marquer les commandes comme imprimées (FPREPARATION = "B")
         //HFiltre(Facture, FDATEREQUISE, sDateFiltre, sDateFiltre)
         //HLitPremier(Facture, FDATEREQUISE)
         //TANTQUE HEnDehors(Facture) = Faux
         //	SI Facture.Completed = Vrai ET (Facture.FPREPARATION = "" OU Facture.FPREPARATION = " ") ALORS
         //		Facture.FPREPARATION = "B"
         //		HModifie(Facture)
         //	FIN
         //	HLitSuivant(Facture, FDATEREQUISE)
         //FIN
         //HDésactiveFiltre(Facture)
         
         Info("Impression terminée. " + nNbCommandes + " commande(s) marquée(s) comme imprimée(s).")
         
         // Rafraîchir et redémarrer le timer
         ChargerCommandesJour()
         DémarrerTimer()
        type : 18
      -
        type : 161
        enabled : false
  -
