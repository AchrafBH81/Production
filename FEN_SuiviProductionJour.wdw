 actionbar : {}
 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1-
      // PROCEDURE MaFenêtre()
      gsIniChemin est une chaîne = ""
      gnTimerID			est un entier	= 0
      gnIntervalleRefresh	est un entier	= 3000
      gtaTabExpansionParDate est un tableau associatif de tableaux associatifs de booléens                                                                                                                                                           
      gsDatePrécédente est une chaîne = ""
      
      gbFlagTrieCodeClient est un booléen=Faux
      gbFlagTrieNomClient est un booléen=Faux
      gnCurrentSeason est un entier
      gnCurrentDay est un entier
      
      //STMissingThermos est une structure
      //	nOrderNumber est un entier
      //	nOrderLine est un entier
      //	sCustomername est une chaîne
      //	sDimension est une chaîne
      //	sBatchNumber est une chaîne
      //	sRackNumber  est une chaîne
      //	sSlotNumber est une chaine
      //	nQuantityMissing est un entier
      //fin
   -
     code : |1-
      pour CHAQUE SaisonLivraison 
      	si SaisonLivraison.sActif alors 
      		gnCurrentSeason = SaisonLivraison.IDSaisonLivraison
      		sortir
      	FIN
      FIN
      si gnCurrentSeason = 0 alors
      	Erreur("Pas de saison active")
      	ferme(mafenetre)
      	
      FIN
      SAI_DateFiltre	= DateDuJour()
      gnCurrentDay = dateversjour(SAI_DateFiltre)
      gsIniChemin		= ComplèteRep(fRepEnCours()) + "production.ini"
      
      ListeAjoute(COMBO_Intervalle, "30 secondes" + gValeurMémorisée("3000"))
      ListeAjoute(COMBO_Intervalle, "1 minute" + gValeurMémorisée("6000"))
      ListeAjoute(COMBO_Intervalle, "2 minutes" + gValeurMémorisée("12000"))
      ListeAjoute(COMBO_Intervalle, "5 minutes" + gValeurMémorisée("30000"))
      
      // Charger les préférences sauvegardées
      sIntervalle est une chaîne = INILit("SuiviProduction", "Intervalle", "3000", gsIniChemin)
      SELON sIntervalle
      	CAS "3000" : ListSelectPlus(COMBO_Intervalle, 1)
      	CAS "6000" : ListSelectPlus(COMBO_Intervalle, 2)
      	CAS "12000" : ListSelectPlus(COMBO_Intervalle, 3)
      	CAS "30000" : ListSelectPlus(COMBO_Intervalle, 4)
      	AUTRE CAS
      		ListSelectPlus(COMBO_Intervalle, 1)
      FIN
      gnIntervalleRefresh = Val(sIntervalle)
      SI gnIntervalleRefresh = 0 ALORS gnIntervalleRefresh = 3000
      
      INT_Déroulé = (INILit("SuiviProduction", "DeroulerParDefaut", "1", gsIniChemin) = "1")
      
      ChargerCommandesJour()
      DémarrerTimer()
     type : 34
   -
     type : 180
     enabled : false
   -
     type : 230
     enabled : false
   -
     code : |1-
      ArrêterTimer()
      
      INIEcrit("SuiviProduction", "Intervalle", COMBO_Intervalle..ValeurMémorisée, gsIniChemin)
      SI INT_Déroulé = Vrai ALORS
      	INIEcrit("SuiviProduction", "DeroulerParDefaut", "1", gsIniChemin)
      SINON
      	INIEcrit("SuiviProduction", "DeroulerParDefaut", "0", gsIniChemin)
      FIN
     type : 2
  procedures :
   -
     name : ChargerCommandesJour
     procedure_id : 1846967490881312462
     type_code : 14
     code : |1-
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      // ChargerCommandesJour ()
      //
      // Paramètres :
      //	Aucun
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      PROCÉDURE ChargerCommandesJour()
      
      dDateFiltre			est une Date	= SAI_DateFiltre
      sDateFiltre			est une chaîne	= dDateFiltre
      bIsPartial			est un booleen	= faux
      sDimension est une chaine = ""
      
      bDateDéjàVisitée	est un booléen	= (gtaTabExpansionParDate[sDateFiltre]..Occurrence > 0)
      
      SI PAS bDateDéjàVisitée ALORS
      	gtaTabExpansionParDate[sDateFiltre] = []
      FIN
      
      taExpDate est un tableau associatif de booléens
      SI bDateDéjàVisitée ALORS
      	taExpDate = gtaTabExpansionParDate[sDateFiltre]
      FIN
      
      Sablier(Vrai)
      
      // Pré-charger tous les détails en une seule requête SQL
      tDetail est une Structure
      	fdnocomm				est une chaîne
      	fdnumprod				est une chaîne
      	fddesc					est une chaîne
      	fdqte					est un entier
      	fdqteaFacturer			est un entier
      	Fdqte_Produced			est un entier
      	Fdqte_BackOrder			est un entier
      	Fdqte_BackOrderreason	est une chaîne
      	fdligne					est un entier
      	fdlargeura est une chaîne
      	fdhauteura est une chaine
      	fdcarrelage est un booleen
      	fdforme est un booleen
      	fdNolot est une chaine
      FIN
      
      taDetails	est un tableau de tDetail
      
      sSQL		est une chaîne	= [
      	SELECT fd.fdnocomm, fd.fdnumprod, fd.fddesc, fd.fdqte, fd.fdqteafacturer, fd.Fdqte_Produced, fd.Fdqte_BackOrder, fd.Fdqte_BackOrderreason, fd.fdligne ,
      	 fd.fdcarrelage ,fd.fdforme , fd.fnolot ,fd.fdlargeura, fd.fdhauteura
      	FROM Fdetail fd
      	INNER JOIN Facture f ON fd.fdnocomm = f.fanumero
      	WHERE f.FDATEREQUISE = '%1' AND fd.ftype = 1  and f.fatypedocument <> 3
      	ORDER BY fd.fdligne
      ]
      sSQL = ChaîneConstruit(sSQL, sDateFiltre)
      
      src_Details est une Source de Données
      SI HExécuteRequêteSQL(src_Details, hRequêteDéfaut, sSQL) ALORS
      	HLitPremier(src_Details)
      	TANTQUE PAS HEnDehors(src_Details)
      		oDetail est un tDetail
      		oDetail.fdnocomm				= src_Details.fdnocomm
      		oDetail.fdnumprod				= src_Details.fdnumprod
      		oDetail.fddesc					= src_Details.fddesc
      		oDetail.fdqte					= src_Details.fdqte
      		oDetail.fdqteafacturer			= src_Details.fdqteAfacturer
      		oDetail.Fdqte_Produced			= src_Details.Fdqte_Produced
      		oDetail.Fdqte_BackOrder			= src_Details.Fdqte_BackOrder
      		oDetail.Fdqte_BackOrderreason	= src_Details.Fdqte_BackOrderreason
      		oDetail.fdligne					= src_Details.fdligne
      		oDetail.fdCarrelage				= src_Details.fdcarrelage
      		oDetail.fdforme					= src_Details.fdforme
      		oDetail.fdNolot                 = src_Details.fnolot
      		oDetail.fdlargeura              = src_Details.fdlargeura
      		oDetail.fdHauteura              = src_Details.fdhauteura
      		TableauAjoute(taDetails, oDetail)
      		HLitSuivant(src_Details)
      	FIN
      	HLibèreRequête(src_Details)
      FIN
      
      TableSupprimeTout(TABLE_ProductionJour)
      
      HFiltre(Facture, FDATEREQUISE, sDateFiltre, sDateFiltre)
      HLitPremier(Facture, FDATEREQUISE)
      TANTQUE HEnDehors(Facture) = Faux
      	SI SansEspace(Facture.FPREPARATION) = "B" ou facture.OnHold ou facture.fatypedocument = 3 ALORS
      		HLitSuivant(Facture, FDATEREQUISE)
      		CONTINUER
      	FIN
      	bIsPartial = SansEspace(Facture.livrepartiel) = "P"
      	nLigneParent est un entier
      	nLigneParent = TableAjouteLigne(TABLE_ProductionJour, ...
      	Facture.fanumero, ...
      	Facture.faclient, ...
      	Facture.lnom, ...
      	"", ...
      	"", ...
      	Facture.NumberOfThermosToProduce, ...
      	Facture.NumberOfThermosProduced, ...
      	Facture.NumberOfThermosBackOrdered, ...
      	"", ...
      	Facture.Completed, ...
      	"P", ...
      	0)
      	
      	TABLE_ProductionJour.COL_QteProduced[nLigneParent].Grisé	= Vrai
      	TABLE_ProductionJour.COL_QteBO[nLigneParent].Grisé			= Vrai
      	TABLE_ProductionJour.COL_BO_Reason[nLigneParent].Grisé		= Vrai
      	
      	
      	nProduit		est un entier	= Facture.NumberOfThermosProduced
      	nAProduire		est un entier	= Facture.NumberOfThermosToProduce
      	nBackOrdered	est un entier	= Facture.NumberOfThermosBackOrdered
      	AppliquerCouleurLigne(nLigneParent, nProduit + nBackOrdered, nAProduire)
      	
      
      	
      	
      	// Filtrer les détails depuis le cache mémoire — aucune requête DB
      	sClé est une chaîne = Facture.fanumero
      	POUR TOUT oDetail DE taDetails
      		sDimension = ""
      		SI oDetail.fdnocomm = sClé ALORS
      			SELON facture.facalcul
      				CAS 1
      					sDimension 		= " ("+Arrondi(InchFractionToMillimeter(oDetail.fdlargeura)) + "X" + Arrondi(InchFractionToMillimeter(oDetail.fdhauteura))+")"
      				CAS 2
      					sDimension		= " ("+MillimiterToInchFraction(oDetail.fdlargeura) + "X" +  MillimiterToInchFraction(oDetail.fdhauteura)+")"
      				AUTRE CAS
      					
      			FIN
      			
      			
      			
      			nLigneEnfant est un entier
      			si oDetail.fdqteaFacturer <> 0 alors
      				nLigneEnfant = TableAjouteFils(TABLE_ProductionJour, nLigneParent, ...
      				Facture.fanumero, ...
      				Facture.faclient, ...
      				Facture.lnom, ...
      				oDetail.fdnumprod, ...
      				sansespace(oDetail.fddesc) + sDimension, ...
      //				oDetail.fdqte, ...
      				bIsPartial ? oDetail.fdqteaFacturer sinon oDetail.fdqte, ...
      				oDetail.Fdqte_Produced, ...
      				oDetail.Fdqte_BackOrder, ...
      				oDetail.Fdqte_BackOrderreason, ...
      				Faux, ...
      				"E", ...
      				oDetail.fdligne,
      				oDetail.fdcarrelage,
      				oDetail.fdforme,
      				oDetail.fdNolot)
      				
      				TABLE_ProductionJour.COL_Completed[nLigneEnfant].Grisé = Vrai
      				
      				nProduitDetail		est un entier	= oDetail.Fdqte_Produced
      				nAFacturerDetail	est un entier	= oDetail.fdqte
      				nBackOrderedDetail	est un entier	= oDetail.Fdqte_BackOrder
      				AppliquerCouleurLigne(nLigneEnfant, nProduitDetail + nBackOrderedDetail, nAFacturerDetail)
      			fin
      		FIN
      	FIN
      	
      	SI PAS bDateDéjàVisitée ALORS
      		SI INT_Déroulé = Vrai ALORS
      			TableDéroule(TABLE_ProductionJour, nLigneParent)
      			taExpDate[sClé] = Vrai
      		SINON
      			TableEnroule(TABLE_ProductionJour, nLigneParent)
      			taExpDate[sClé] = Faux
      		FIN
      	SINON
      		SI taExpDate[sClé] = Vrai ALORS
      			TableDéroule(TABLE_ProductionJour, nLigneParent)
      		SINON
      			TableEnroule(TABLE_ProductionJour, nLigneParent)
      		FIN
      	FIN
      	
      	HLitSuivant(Facture, FDATEREQUISE)
      FIN
      
      HDésactiveFiltre(Facture)
      
      gtaTabExpansionParDate[sDateFiltre] = taExpDate
      
      Sablier(Faux)
      
      sHeure est une chaîne = HeureSys()
      LIB_DernierRefresh = "Dernier refresh : " + sHeure[[1 À 2]] + ":" + sHeure[[3 À 4]] + ":" + sHeure[[5 À 6]]
     type : 458752
   -
     name : AppliquerCouleurLigne
     procedure_id : 1846967757169477871
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      // AppliquerCouleurLigne ()
      //
      // Paramètres :
      //	Aucun
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      PROCÉDURE AppliquerCouleurLigne(nLigne est un entier, nQteProduite est un entier, nQteAProduire est un entier)
      
      SI nQteAProduire > 0 ET nQteProduite >= nQteAProduire ALORS
      	POUR nCol = 1 _À_ 10
      		TABLE_ProductionJour[nLigne, nCol].CouleurFond = RVB(200, 255, 200)
      	FIN
      SINON SI nQteProduite > 0 ALORS
      	POUR nCol = 1 _À_ 10
      		TABLE_ProductionJour[nLigne, nCol].CouleurFond = RVB(255, 255, 200)
      	FIN
      SINON
      	POUR nCol = 1 _À_ 10
      		TABLE_ProductionJour[nLigne, nCol].CouleurFond = RVB(255, 255, 255)
      	FIN
      FIN
     type : 458752
   -
     name : DémarrerTimer
     procedure_id : 1846967971917957863
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      // DémarrerTimer ()
      //
      // Paramètres :
      //	Aucun
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure DémarrerTimer()
      
      SI gnTimerID > 0 ALORS
      	FinTimer(gnTimerID)
      FIN
      gnTimerID = Timer("ChargerCommandesJour", gnIntervalleRefresh)
     type : 458752
   -
     name : ArrêterTimer
     procedure_id : 1846968087882232990
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      // ArrêterTimer ()
      //
      // Paramètres :
      //	Aucun
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure ArrêterTimer()
      
      SI gnTimerID > 0 ALORS
      	FinTimer(gnTimerID)
      	gnTimerID = 0
      FIN
     type : 458752
   -
     name : SeeMissingThermos
     procedure_id : 1871557979706209279
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      // SeeMissingThermos ()
      //
      // Paramètres :
      //	Aucun
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure SeeMissingThermos()
      tabMissingThermos	est un tableau de STMissingThermos
      nCurrentMissingQty	est un entier
      sdReqSql			est une requête SQL	= 
      [
      	select racking.RackNumber,racking.linenumber,racking.Width,racking.Height<§cs:3§>
      	from racking <§cs:3§>
      	where racking.Rackingdate = {pdate} and racking.OrderNumber = {pOrderNumber} and racking.OrderDetailLine = {pLineNumber}<§cs:3§>
      	order by racking.LineNumber<§cs:3§>
      	<§cs:3§>
      ]
      
      
      
      tabMissingThermos.supprimetout()
      
      pour chaque ligne de TABLE_ProductionJour
      	si TABLE_ProductionJour.RécupèreParent() <>  0 alors
      		nCurrentMissingQty  = TABLE_ProductionJour.COL_QteAFActurer - (TABLE_ProductionJour.COL_QteProduced + TABLE_ProductionJour.COL_QteBO)
      		si  nCurrentMissingQty > 0 alors
      			stCurrentMissingThermos est une STMissingThermos
      			stCurrentMissingThermos.nOrderNumber				= TABLE_ProductionJour.COL_Numero
      			stCurrentMissingThermos.nOrderLine					= TABLE_ProductionJour.COL_FdLigne
      			stCurrentMissingThermos.sCustomername				= TABLE_ProductionJour.col_nom
      			stCurrentMissingThermos.sProductNumber				= TABLE_ProductionJour.COL_NoProduit
      			stCurrentMissingThermos.sProductdescription			= TABLE_ProductionJour.COL_Description
      			stCurrentMissingThermos.bIsGrid						= TABLE_ProductionJour.COL_grid
      			stCurrentMissingThermos.bIsform						= TABLE_ProductionJour.COL_form
      			stCurrentMissingThermos.sBatchNumber				= TABLE_ProductionJour.COL_BatchNumber
      			stCurrentMissingThermos.nQuantityMissing			= nCurrentMissingQty
      			tabMissingThermos.ajoute(stCurrentMissingThermos)
      		FIN
      	FIN
      FIN
      bIsPickUp est un booleen
      
      pour chaque stMissingThermos1 de tabMissingThermos
      	bIsPickUp = faux
      	si hlitrecherche(Facture,fanumero,stMissingThermos1.nOrderNumber) alors
      		//stMissingThermos1.sBatchNumber = facture.nolot
      		si hlitrecherche(camions,IDCamions,facture.IDCamions) alors
      			si camions.PickUp alors
      				bIsPickUp = Vrai
      			sinon
      				stMissingThermos1.ntrucknumber = camions.NoCamion
      			FIN
      		fin
      	FIN
      	si bIsPickUp alors
      		sdReqSql.pdate			= SAI_DateFiltre
      		sdReqSql.pOrderNumber	= stMissingThermos1.nOrderNumber
      		sdReqSql.pLineNumber	= stMissingThermos1.nOrderLine
      		SI HExécuteRequêteSQL(sdReqSql) ALORS
      			stMissingThermos1.sRackNumber	= "PickUp"
      			stMissingThermos1.sSlotNumber	= ""
      			stMissingThermos1.sDimension	= sdReqSql.Width + " X " +sdReqSql.Height
      		fin
      	SINON
      		sdReqSql.pdate			= SAI_DateFiltre
      		sdReqSql.pOrderNumber	= stMissingThermos1.nOrderNumber
      		sdReqSql.pLineNumber	= stMissingThermos1.nOrderLine
      		si HExécuteRequêteSQL(sdReqSql) alors
      			
      			stMissingThermos1.sDimension = sdReqSql.width + " X " +sdReqSql.Height
      			si HNbEnr(sdReqSql) = 1 alors
      				hlitpremier(sdReqSql)
      				stMissingThermos1.sSlotNumber	= sdReqSql.linenumber
      				stMissingThermos1.sRackNumber	= sdReqSql.RackNumber + " / " + sdReqSql.linenumber
      			SINON
      				HLitPremier(sdReqSql)
      				stMissingThermos1.sSlotNumber	= sdReqSql.linenumber
      				HLitdERNIER(sdReqSql)
      				stMissingThermos1.sSlotNumber	+= "-" + sdReqSql.linenumber
      				
      				stMissingThermos1.sRackNumber	= sdReqSql.RackNumber  + " / " + stMissingThermos1.sSlotNumber
      				
      			FIN
      			
      		FIN
      	FIN
      	
      FIN
      
      idestination(iVisualisateur)
      iImprimeEtat(EMissingThermos,tabMissingThermos,SAI_DateFiltre)
      
      
     type : 458752
