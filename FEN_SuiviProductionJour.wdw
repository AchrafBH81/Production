        type : 5
       code_elements :
        internal_properties : CQAAAAkAAADaQRjRgh1PoQvbwqLYHNiC8rnYrViLr0h86pavGNjo1pifOnEHNDHSpzeI7EMvtR3IZ0tp9Pej6NR+oaTjq1cY6tJY
        type_code : 5
        p_codes :
         -
           code : |1-
            // Empêcher la saisie sur les lignes enfant
            SI TABLE_ProductionJour.COL_TypeLigne = "E" ALORS
            	RETOUR
            FIN
           type : 15
         -
           code : |1-
            
           type : 16
         -
           code : |1-
            // Vérifier qu'on est sur une ligne parent                                                                                                                                                                                                   SI TABLEH_ProductionJour.COL_TypeLigne <> "P" ALORS                                                                                                                                                                                                                                 FIN
            bCompleted		est un booléen	= TABLE_ProductionJour.COL_Completed
            nNumero			est un entier	= TABLE_ProductionJour.COL_Numero
            nLigneCourante	est un entier	= TableSelect(TABLE_ProductionJour)
            
            // Empêcher la réouverture
            SI bCompleted = Faux ALORS
            	TABLE_ProductionJour.COL_Completed = Vrai
            	RETOUR
            FIN
            
            // Confirmation
            SI OuiNon("Marquer la commande " + nNumero + " comme terminée ?") = Non ALORS
            	TABLE_ProductionJour.COL_Completed = Faux
            	RETOUR
            FIN
            
            // Mise à jour Facture
            HLitRecherche(Facture, fanumero, nNumero)
            SI HTrouve(Facture) ALORS
            	Facture.Completed	= Vrai
            	Facture.Started		= Vrai
            	facture.fpreparation = "F"
            	HModifie(Facture)
            FIN
            
            // Initialiser les qté produites vides
            HFiltre(Fdetail, fdnocomm, nNumero, nNumero)
            HLitPremier(Fdetail, fdnocomm)
            TANTQUE HEnDehors(Fdetail) = Faux
            	SI Fdetail.ftype = 1 ET Fdetail.Fdqte_Produced < Fdetail.fdqte - Fdetail.Fdqte_BackOrder ALORS
            		Fdetail.Fdqte_Produced = Fdetail.fdqte - Fdetail.Fdqte_BackOrder
            	FIN
            	
            	HModifie(Fdetail)
            	
            	HLitSuivant(Fdetail, fdnocomm)
            FIN
            HDésactiveFiltre(Fdetail)
            
            // Recalculer le total produit
            nTotalProduit est un entier = 0
            HFiltre(Fdetail, fdnocomm, nNumero, nNumero)
            HLitPremier(Fdetail, fdnocomm)
            TANTQUE HEnDehors(Fdetail) = Faux
            	SI Fdetail.ftype = 1 ALORS
            		nTotalProduit += Fdetail.Fdqte_Produced
            	FIN
            	HLitSuivant(Fdetail, fdnocomm)
            FIN
            HDésactiveFiltre(Fdetail)
            
            // Mettre à jour le total sur la Facture
            HLitRecherche(Facture, fanumero, nNumero)
            SI HTrouve(Facture) ALORS
            	Facture.NumberOfThermosProduced = nTotalProduit
            	HModifie(Facture)
            FIN
            
            // Mettre à jour l'affichage du parent
            HLitRecherche(Facture, fanumero, nNumero)
            SI HTrouve(Facture) ALORS
            	nAProduire	est un entier	= Facture.NumberOfThermosToProduce
            	TABLE_ProductionJour.COL_QteProduced[nLigneCourante] = nTotalProduit
            	AppliquerCouleurLigne(nLigneCourante, nTotalProduit + Facture.NumberOfThermosBackOrdered, nAProduire)
            	
            	// Colorier et mettre à jour les lignes enfant
            	nLigneEnfant est un entier = nLigneCourante + 1
            	TANTQUE nLigneEnfant <= TABLE_ProductionJour..Occurrence ET TABLE_ProductionJour.COL_TypeLigne[nLigneEnfant] = "E"
            		nQteAFacturer	est un entier	= TABLE_ProductionJour.COL_QteAFacturer[nLigneEnfant]
            		nQteBOEnfant    est un entier   = TABLE_ProductionJour.COL_QteBO[nLigneEnfant]
            		TABLE_ProductionJour.COL_QteProduced[nLigneEnfant] = nQteAFacturer - nQteBOEnfant
            		AppliquerCouleurLigne(nLigneEnfant, nQteAFacturer, nQteAFacturer)
            		nLigneEnfant++
            	FIN
            FIN
           type : 17
     -
