       name : COL_QteProduced
       identifier : 0x29a1bc123476d4f4
       internal_properties : CQAAAAkAAADVDxQmnTHtZVhbkqEzy9y0d6P4DcXH6bKQKmPFsn8j8lxDsTpj8FI/P7Uex4K9JU5GHfN0gbaQYvNbm+ltObnVU1JgRma0cTcvdvEtOwqHa6xRd3hmFOAryTv5wgALWwZ1Cbd3FMHhMKV6SUcNG15NlUsShJrK/xQTuWSPb6OnZJtrgmcFqc8hY8T1IzeTd18Dph9s/y5A5DPMawdBR9rfguF7k0MGhO9sytK6qtkh
       type : 2
       content :
        internal_properties : 
        properties : {}
        type : 2
       code_elements :
        internal_properties : CQAAAAkAAACN3lh1f0p2cJUp8r1m2XV/KpHo9RhuPL42v9pJio0xhWHIBAtjWtQX52buZZ2jSkkrTDqjzAVgTACiS5NACjHwWgQJyWph
        type_code : 3
        p_codes :
         -
           code : |1-
            // Empêcher la saisie sur les lignes parent
            SI TABLE_ProductionJour.COL_TypeLigne = "P" ALORS
            	RETOUR
            FIN
           type : 15
         -
           code : |1-
            // Vérifier qu'on est sur une ligne enfant                                                                                                                                                                                                   SI TABLEH_ProductionJour.COL_TypeLigne = "E" ALORS
            nQteProduced	est un entier	= TABLE_ProductionJour.COL_QteProduced
            nQteAFacturer	est un entier	= TABLE_ProductionJour.COL_QteAFacturer
            nLigneDetail	est un entier	= TABLE_ProductionJour.COL_FdLigne
            nQteBO          est un entier   = TABLE_ProductionJour.COL_QteBO
            
            // Trouver le numéro de commande (remonter au parent)
            nLigneCourante	est un entier	= TableSelect(TABLE_ProductionJour)
            nLigneParent	est un entier	= nLigneCourante - 1
            TANTQUE nLigneParent >= 1 ET TABLE_ProductionJour.COL_TypeLigne[nLigneParent] <> "P"
            	nLigneParent--
            FIN
            nNumeroCommande est un entier = TABLE_ProductionJour.COL_Numero[nLigneParent]
            
            // Validation
            SI nQteProduced < 0 ALORS
            	Erreur("La quantité produite ne peut pas être négative.")
            	TABLE_ProductionJour.COL_QteProduced = 0
            	nQteProduced = 0
            FIN
            
            SI nQteBO + nQteProduced > nQteAFacturer ALORS
            	Erreur("La somme de la quantité produite et de la quantité BO ne peut pas dépasser la quantité à produire (" + nQteAFacturer + ").")
            	TABLE_ProductionJour.COL_QteProduced	= 0
            	nQteProduced							= 0
            FIN
            
            // Mise à jour du détail en base de données
            HLitRecherche(Fdetail, fdcle, [nNumeroCommande, nLigneDetail])
            SI HTrouve(Fdetail) ALORS
            	Fdetail.Fdqte_Produced = nQteProduced
            	HModifie(Fdetail)
            	
            	AppliquerCouleurLigne(nLigneCourante, nQteProduced + nQteBO, nQteAFacturer)
            	
            	// Recalculer le total produit pour la commande
            	nTotalProduit est un entier = 0
            	HFiltre(Fdetail, fdnocomm, nNumeroCommande, nNumeroCommande)
            	HLitPremier(Fdetail, fdnocomm)
            	TANTQUE HEnDehors(Fdetail) = Faux
            		SI Fdetail.ftype = 1 ALORS
            			nTotalProduit += Fdetail.Fdqte_Produced
            		FIN
            		HLitSuivant(Fdetail, fdnocomm)
            	FIN
            	HDésactiveFiltre(Fdetail)
            	
            	// Mettre à jour la Facture en DB
            	HLitRecherche(Facture, fanumero, nNumeroCommande)
            	SI HTrouve(Facture) ALORS
            		Facture.NumberOfThermosProduced	= nTotalProduit
            		Facture.Started					= (nTotalProduit + Facture.NumberOfThermosBackOrdered > 0)
            		Facture.Completed				= (nTotalProduit + Facture.NumberOfThermosBackOrdered >= Facture.NumberOfThermosToProduce ET Facture.NumberOfThermosToProduce > 0)
            		
            		IF Facture.Completed alors
            			Facture.FPREPARATION = "F"
            		FIN
            		
            		HModifie(Facture)
            		
            		// Mettre à jour l'affichage du parent
            		TABLE_ProductionJour.COL_QteProduced[nLigneParent]	= nTotalProduit
            		TABLE_ProductionJour.COL_Completed[nLigneParent]	= Facture.Completed
            		
            		nAProduire	est un entier	= Facture.NumberOfThermosToProduce
            		AppliquerCouleurLigne(nLigneParent, nTotalProduit + Facture.NumberOfThermosBackOrdered, nAProduire)
            		
            	FIN
            FIN
           type : 16
         -
           type : 276
           enabled : false
         -
           type : 277
           enabled : false
         -
