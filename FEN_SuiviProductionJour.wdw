   -
     name : CBM_SansNom
     identifier : 0x2a496a214bed3704
     internal_properties : CQAAAAkAAADiY7oBWNYng3CKYpzgSvk9C92TB19KGRtY9BzmvN7QqyQsFNFL3fEtA1HsWuFQRe0cyTtFY56r27iZ99WA+l0T/4sGZoJ/Ayya3XuW3/caetIpk9IXT9Ni
     type : 62
