     -
       name : CALCUL1
       identifier : 0x3e9d90f371984142
       internal_properties : 
       properties :
        x : 114.
        width : 19.
        height : 5.
       code_elements :
        type_code : 29
        p_codes :
         -
           code : |1+
            hpos est un entier 
            wprixa est un reel
            si sansespace(invent.ipextra) <> "" alors
            hpos  = hsauveposition("invent")
            si invent.ipextra <> invent.inum alors
            	hlitrecherche("invent","INUM",invent.ipextra)
            //Code WinDev 5.5 remplacé par la migration :
            //	si pas h.endehors et h.trouve alors
            	si pas HEnDehors() et HTrouve() alors
            	   calcul1 = invent.iprixa	
            	FIN
            sinon
            	calcul1 = invent.iprixa
            FIN
            hretourposition(hpos)
            sinon
            	calcul1 = 0
            fin	
            
           type : 327692
         -
           type : 327699
           enabled : false
