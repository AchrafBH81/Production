 controls : []
 code_elements :
  type_code : 13
  p_codes :
   -
     code : |1+
      Procedure _LISTE_ADDITIONNEL(_pParam1="", _pParam2="", _pParam3="", _pParam4="")
      
      
     type : 327680
   -
     code : |1+
      // Vérification de la condition
      //SI pas (I0.ibase<>1) ALORS RENVOYER FAUX
      SI pas (invent.itype =1) ALORS RENVOYER FAUX
      si invent.iactif = faux alors renvoyer faux
      si (position(_pparam1,complete(invent.icategorie,3)) = 0) alors renvoyer faux
      
      RENVOYER VRAI		// Enregistrement accepté
      
     type : 327696
  procedures :
   -
     name : filtrercategorie
     procedure_id : 4511921775736668572
     type_code : 14
     code : |1+
      Procédure filtrercategorie()
      
      
      renvoyer position(_pparam1,sansespace(invent.icategorie)) <> 0
      
     type : 458752
  procedure_templates : []
  property_templates : []
