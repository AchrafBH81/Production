 popup_menus : []
 message_bar :
  internal_properties : CQAAAAkAAAB+tqgL9wh+XzClRStvlfGLkATcOahiR8fVlowyaDH6xDPEy7THaxkHjLJYguV2x5Z+1bdUxvvvPIOorzT+5l1grHr1wd1c0/vBoEdfexkgy2qf8fsokr7T7pEiuQ==
 actionbar : {}
 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1-
      procedure fenemail(lCourriel="",lsujet="",lmessage="",lfichier="",lNumClient="",lModification=faux,ltypedocument=1,lModifie=vrai,ltypeclientFournisseur = "C")
      
      
      CourrielExpediteur est une chaîne
      
      
      lfichieraenvoyer est une chaine
      lerreuremail est un tableau de 26 chaine
      
      lerreuremail[1]="Abandon demandé par l'utilisateur"
      lerreuremail[2]="Erreur inconnue"
      lerreuremail[3]="Impossible de se connecter"
      lerreuremail[4]="Disque plein"
      lerreuremail[5]="Plus de mémoire disponible"
      lerreuremail[6]="Accès interdit"
      lerreuremail[7]="Erreur inconnue"
      lerreuremail[8]="Trop de sessions ouvertes"
      lerreuremail[9]="Trop de fichiers attachés (10 fichiers maximum)"
      lerreuremail[10]="Trop de destinataires (20 destinataires maximum)"
      lerreuremail[11]="Fichier attaché non trouvé"
      lerreuremail[12]="Impossible d'ouvrir le fichier attaché"
      lerreuremail[13]="Impossible d'écrire le fichier attaché"
      lerreuremail[14]="Destinataire inconnu"
      lerreuremail[15]="Erreur inconnue"
      lerreuremail[16]="Erreur inconnue"
      lerreuremail[17]="Message invalide"
      lerreuremail[18]="Texte du message trop long"
      lerreuremail[19]="Session invalide"
      lerreuremail[20]="Erreur inconnue"
      lerreuremail[21]="Adresse du destinateire ambigüe"
      lerreuremail[22]="Erreur inconnue"
      lerreuremail[23]="Erreur réseau"
      lerreuremail[24]="Erreur inconnue"
      lerreuremail[25]="Erreur inconnue"
      lerreuremail[26]="Envoi annulé par l'utilisateur"
      
      //hlit(config,1)
      si gclconfig.m_nTimeOutEmail  <> 0 alors
      	EmailChangeTimeOut(gclconfig.m_nTimeOutEmail)
      FIN
      selon ltypedocument
      	cas 1
      		CourrielExpediteur = gclconfig.m_sEmailConfirmation
      	CAS 2
      		CourrielExpediteur = gclConfig.m_sEmailfacture
      	CAS 3
      		CourrielExpediteur = gclConfig.m_sEmailBonLivraison
      	CAS 4
      		CourrielExpediteur = gclConfig.m_sEmaillisteprix
      	CAS 5
      		CourrielExpediteur = gclConfig.m_sEmailSoumission
      	CAS 6
      		CourrielExpediteur = gclConfig.m_sEmailCommandeAchat
      	cas 9
      		CourrielExpediteur = gclConfig.m_sEmailPreparation	
      	AUTRE CAS
      		
      FIN
      
      mafenetre..ValeurRenvoyée = faux
   -
     code : |1+
      si enmodetest() alors sais_dest = "planisoft@videotron.ca" sinon SAIS_DEST = lcourriel
      //SAIS_DEST = lcourriel
      SAIS_SUJET = lsujet
      SAIS_MESSAGE = lmessage
      SAIS_FICAT = lfichier
      lfichieraenvoyer = bVerifierFichierAttache(lfichier)
      si ltypeclientFournisseur = "C" alors
      si lnumclient <> "" alors
      	si hlitrecherche(client,numero,lNumClient) alors
      		lnomclient = sansespace(client.nom)
      	sinon
      		lnomclient = "******* Client inexistant *******"	
      
      	FIN
      fin
      sinon
      	SI lNumClient <> "" ALORS
      		SI HLitRecherche(fournisseur,fnumero,sansespace(lNumClient)) ALORS
      			lNomClient = SansEspace(fournisseur.fnom)
      		SINON
      			lNomClient = "******* Fournisseur inexistant *******"	
      			
      		FIN
      	FIN
      fin
      
