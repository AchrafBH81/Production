   -
     name : bVérifieEmail
     procedure_id : 5048982585370619184
     type_code : 14
     code : |1-
      Procédure bVérifieEmail(psListe)
      // vérification rapide des adresses email
      
      i est un entier
      sCh est une chaine
      
      i=1
      sCh = extraitchaine(psListe,i,";")
      tantque (sCh<>"" et sCh<>eot)
      	// si l'adresse ne contient pas @, elle est incorrecte
      	si position(sCh,"@")=0 alors
      		renvoyer faux
      	FIN
      	
      	// si l'adresse ne contient pas ., elle est incorrecte
      	si position(sCh,".")=0 alors
      		renvoyer faux
      	FIN	
      
      	i++
      	sCh = extraitchaine(psListe,i,";")
      FIN
      
      renvoyer vrai
     type : 458752
   -
     name : bExpédier
     procedure_id : 5048982586309750064
     type_code : 14
     code : |1+
      Procédure bExpédier()
      // renvoie vrai si le mail a été envoyé
      
      i est un entier
      sCh     est une chaine = ""
      bMsgEnv est un booleen		// compte rendu d'envoie
      
      email.Sujet = SAIS_SUJET
      email.Message = SAIS_MESSAGE
      email.Expéditeur = COMPTE.AdrMail
      email.AdresseExpéditeur = COMPTE.AdrMail
      
      
      // on récupère les destinataires, les adresses ont déjà été vérifiées
      i=1
      sCh = extraitchaine(SAIS_DEST,i,";")
      tantque (sCh<>"" et sCh<>eot)
      	email.bcc[i]   = sCh
      	i++
      	sCh = extraitchaine(SAIS_DEST,i,";")
      	// le nombre de destinataires est limité à 200
      	si i=201 sortir
      FIN
      // nombre de destinataires
      email.nbbcc    = i-1
      
      // on récupère les fichiers attachés
      i=1
      sCh = extraitchaine(SAIS_FICAT,i,";")
      TantQue (sCh<>EOT et sCh<>"")
      	email.attache[i] = frepencours()+"\"+CHEMIN+"\"+sCh
      	// fichier suivant
      	i++
      	sCh = extraitchaine(SAIS_FICAT,i,";")
      	// les fichiers attachés par email sont limités à 10
      	si i=11 sortir
      Fin
      // nombre de fichiers attachés
      email.nbattache = i-1
      
      //envoie du mail sans aucun chevron
      bMsgEnv = EMailEnvoieMessage(COMPTE.Login)
      
      si pas bMsgEnv alors
      	// on essaye avec des chevrons seulement sur l'expéditeur
      	email.Adresseexpediteur = "<"+email.Adresseexpediteur+">"
      	email.expediteur = "<"+email.expediteur+">"
      	//envoie du mail sans les chevrons
      	bMsgEnv = EMailEnvoieMessage(COMPTE.Login)
      FIN
      
      si pas bMsgEnv alors
      	// on essaye avec des chevrons sur le destinataire et sur l'expéditeur
      	pour i=1 a email.nbbcc
      		email.bcc[i]="<"+email.bcc[i]+">"
      	FIN
      	//envoie du mail sans les chevrons
      	bMsgEnv = EMailEnvoieMessage(COMPTE.Login)
      fin
      
      si pas bMsgEnv alors
      	// on essaye avec sans chevrons seulement sur le destinataire
      	email.Adresseexpediteur = COMPTE.AdrMail
      	email.expediteur = COMPTE.AdrMail
      	//envoie du mail sans les chevrons
      	bMsgEnv = EMailEnvoieMessage(COMPTE.Login)
      FIN
      
      renvoyer bMsgEnv
     type : 458752
   -
     name : bVérifieAdresseEmail
     procedure_id : 5236602136949212197
     type_code : 14
     code : |1+
      Procédure bVérifieAdresseEmail(psListe)
      // vérification rapide des adresses email
      lchainearetourner est une chaine
      lpastrouve est un booleen 
      i est un entier
      j est un entier
      
      sCh est une chaine
      si SansEspace(psListe) = "" alors
      	renvoyer "Vide"
      FIN
      i=1
      sCh = extraitchaine(psListe,i,";")
      si hlitrecherche(client,numero,lnumclient) alors
      
      	tantque (sCh<>"" et sCh<>eot)
      		lpastrouve = vrai
      		pour j = 1 a 4
      			si  sCh = sansespace(client.ccourrielBonLivraison[j]) alors
      				lpastrouve = faux
      				sortir
      			FIN
      			si  sCh = sansespace(client.ccourrielConfirmation[j]) alors
      				lpastrouve = faux
      				sortir
      			FIN
      			si  sCh = sansespace(client.ccourrielfacture[j]) alors
      				lpastrouve = faux
      				sortir
      			FIN
      			si  sCh = sansespace(client.CourrielListePrix[j]) alors
      				lpastrouve = faux
      				sortir
      			FIN
      		fin
      
              si lpastrouve alors
                 lchainearetourner=AjouteAdresse(lchainearetourner,sCh)
              fin
              	
      		//		si sch = sansespace(client.ccourrielBonLivraison[1]) ou  sch = sansespace(client.ccourrielConfirmation[1])...
      		//			ou  sch = sansespace(client.ccourrielFacture[1])  	ou  sch = sansespace(client.CourrielListePrix[1]) alors
      		//
      		//		sinon
      		//			renvoyer faux				
      		//		FIN
      		i++
      		sCh = extraitchaine(psListe,i,";")
      	FIN
      
      
      sinon
      	lchainearetourner = "Erreur"
      fin
      renvoyer lchainearetourner
      
      
     type : 458752
   -
     name : SauveEmail
     procedure_id : 5325370865818878479
     type_code : 14
     code : |1+
      Procédure SauveEmail(lmodif)
      
      ArchiveEmail.dateEmail = DateHeureSys()
      ArchiveEmail.noClient = complete(lNumClient,10)
      ArchiveEmail.lDestinataire = sansespace(sais_dest)
      si pas lmodif
      	ArchiveEmail.lFichierAttaché = lfichier//SansEspace(SAIS_FICAT)
      fin
      ArchiveEmail.ltexte = SansEspace(SAIS_MESSAGE)
      ArchiveEmail.lSujet = SansEspace(SAIS_SUJET)
      ArchiveEmail.lTypeDocument = ltypedocument
      si ltypedocument = 6 alors// Commande achat
      	CommandeAchat.caSended = Vrai
      	hmodifie(CommandeAchat,hNumEnrEnCours)
      FIN
      si lmodif alors
      	hmodifie(ArchiveEmail,hNumEnrEnCours)
      sinon
      	hajoute(ArchiveEmail)		
      FIN
      
     type : 458752
   -
     name : bVerifierFichierAttache
     procedure_id : 5325689092405368217
     type_code : 14
     code : |1-
      Procédure bVerifierFichierAttache(lFichierAttache)
      i est un entier
      lfichieraretourner est une chaine
      lposition est un entier = 1
      lpositionfin est un entier
      nbfichier est un entier = ChaîneOccurrence(lFichierAttache,";")
      
      pour i = 1 a nbfichier
      
      	si pas fFichierExiste(ExtraitChaîne(lFichierAttache,i,";")) alors
      		lpositionfin = Position(lFichierAttache,";",lposition)-1
      		SAIS_FICAT..Curseur = lposition
      		SAIS_FICAT..FinCurseur = Position(lFichierAttache,";",lposition)
      		RTFSélection(SAIS_FICAT,rtfItalique,vrai)
      		RTFSélection(SAIS_FICAT,rtfCouleur,irougeclair)
      		//		RTFSélection(SAIS_FICAT,rtfgras,vrai)
      
      		lposition=lpositionfin+2
      
      	sinon
      		lfichieraretourner+= ExtraitChaîne(lFichierAttache,i,";")+";"
      		lposition = Position(lFichierAttache,";",lposition)+1
      
      	FIN
      FIN
      SAIS_FICAT..Curseur = 0
      SAIS_FICAT..FinCurseur=0
      renvoyer lfichieraretourner
     type : 458752
   -
     name : AjouteAdresse
     procedure_id : 5348647856948619718
     type_code : 14
     code : |1+
      Procédure AjouteAdresse(lchaine,ladresse)
      lchainearetourner est une chaine
      si pas ChaîneOccurrence(lchaine,ladresse) <> 0 alors
      	lchainearetourner=lchaine+ladresse+rc
      sinon
               lchainearetourner=lchaine
      
      FIN
      
      renvoyer lchainearetourner
     type : 458752
