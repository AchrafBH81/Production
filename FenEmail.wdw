  -
    name : BTN_ENVOIE
    identifier : 0x461196e921f42d30
    internal_properties : 
    properties :
     x : 438
     y : 504
     width : 80
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         
        type : 14
      -
        code : |1+
         sablier()
         lchaineverification	est une chaine
         
         i					est un entier	= 1
         nbAttache			est un entier
         nIdSession			est un entier	= 0
         // vérification rapide des adresses email
         //si pas SAIS_DEST..modifie alors
         //	si pas bVérifieAdresseEmail(SAIS_DEST) alors
         //		si acso_message("Question","L'adresse du destinataire ne semble pas correspondre au client en cours"+rc+"Voulez-vous continuer ?","OuiNon") = idno alors
         //			RepriseSaisie(SAIS_DEST)
         //		fin
         //	FIN
         //fin
         si ltypeclientFournisseur = "C" alors
         	lchaineverification = bVérifieAdresseEmail(sais_dest)
         	si pas lchaineverification = "" alors
         		si lchaineverification = "Erreur" alors
         			si acso_message("Question","Impossible de localiser la fiche client  afin de vérifier les adresses de courriel."+rc+"Voulez-vous continuer ?","OuiNon") = idno alors
         				RepriseSaisie(SAIS_DEST)
         			fin
         		sinon si lchaineverification = "Vide" alors
         			ACSO_message("Erreur","Vous devez inscrire au moins une adresse courriel ."+RC+RC+lchaineverification,"Erreur")
         			renvoyer faux
         			
         		sinon
         			
         			si acso_message("Question","Les adresses de courriel suivantes ne semblent pas correspondre au client  en cours."+rc+rc+lchaineverification+rc+rc+"Voulez-vous continuer ?","OuiNon") = idno alors
         				RepriseSaisie(SAIS_DEST)
         			fin
         		FIN
         	FIN
         sinon si ltypeclientFournisseur = "F" alors
         	
         	
         fin
         si sansespace(SAIS_DEST) = "" alors
         	acso_message("Erreur","Aucune adresse courriel d'inscrite","Erreur")
         	renvoyer vrai
         FIN
         SI DROITE(SansEspace(SAIS_DEST),1) <> ";" ALORS
         	SAIS_DEST=SansEspace(SAIS_DEST)+";"
         FIN
         //SauveEmail(lModification)
         //			SauveEmail(lmodif)
         EmailAenvoyer		est un Email
         EmailFichierAttache	est un emailAttache
         
         
         si  EnModeTest() alors
         	
         	//si pas EmailOuvreSessionSMTP("InfoErreur",sansespace(config.ServeurSMTP)) alors
         	//	acso_message("Erreur","Impossible de se connecter au serveur de courrier sortant","Erreur")
         	
         	// code pour ExchangeServer
         	//	idsession =  EmailOuvreSession("OutLook") 
         	MailSession est un EmailSessionSMTP
         	MailSession..AdresseServeur	= "smtp.gmail.com"
         	MailSession..Nom			= "jeanhamelin2007@gmail.com"
         	//	MailSession..MotDePasse = "1511Caro"
         	MailSession..MotDePasse		= "xioxrnrcizldmyuc"
         	
         	MailSession..Port			= 587
         	//	MailSession..AdresseServeur = "smtp.videotron.ca"
         	//	MailSession..Nom = "vlkhbnel"
         	//	MailSession..MotDePasse = "pl4nisof"
         	//	MailSession..Port = 465
         	
         	MailSession..Option			= emailOptionSécuriséTLS
         	EmailChangeTimeOut(5)
         	
         	
         	SI pas EmailOuvreSession(MailSession) = Vrai ALORS
         		//si pas EmailOuvreSession("OutLook") alors
         		//	acso_message("Erreur","Impossible de se connecter au serveur de courrier sortant","Erreur")
         		
         		renvoyer faux
         		
         	sinon
         		////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
         		// Code original
         		// /////////////////////////////////////////////////////////////////////////////////////////////////////////////////
         		// 		
         		//		POUR i = 1 _A_ ChaîneOccurrence(SAIS_DEST,";")  
         		//			email.destinataire[i] = extraitchaine(SAIS_DEST,i,";")
         		//		fin
         		//		email.NbDestinataire = i-1
         		//		//		email.NbDestinataire = 1
         		//		//		email.destinataire[1] = SAIS_DEST
         		//		
         		//		Email.sujet = SAIS_SUJET
         		//		email.message = SAIS_MESSAGE
         		//		email.expediteur = CourrielExpediteur
         		//		nbAttache = ChaîneOccurrence(lfichieraenvoyer,";")
         		//
         		//		email.NbAttache = nbAttache
         		//		pour i =1 a nbAttache
         		//			email.Attache[i] = ExtraitChaîne(lfichieraenvoyer,i,";")
         		//		fin
         		//		
         		//		
         		//		
         		//		ExécuteTraitement(jauge1,trtInit)
         		//		emailjauge(jauge1,1000)
         		//		si  pas EmailEnvoieMessage(MailSession,faux) alors
         		//			
         		//			si email.erreur > 26 alors
         		//				acso_message("Erreur","Impossible d'envoyer le message pour les raisons suivantes:"+rc+"Erreur inconnue","Erreur")
         		//			sinon
         		//				acso_message("Erreur","Impossible d'envoyer le message pour les raisons suivantes:"+rc+lerreuremail[email.erreur],"Erreur")
         		//			fin
         		//			//fo(erreurinfo(errMessage))
         		//			renvoyer faux
         		//		sinon
         		//			SauveEmail(lmodification)
         		//			//			SauveEmail(lmodif)
         		//			acso_message("Information","Envoi effectué avec succès","Info")
         		//			EmailFermeSession("InfoErreur")
         		//			ferme(fenemail)
         		//		FIN
         		///////////////////////////////////////////////////////////////////////////////////////////////////////////////		
         		//	fin
         		
         		
         		///////////////////////////////////////////////////////////////////////////////////////////////////////////////
         		// Nouveau Code
         		// ////////////////////////////////////////////////////////////////////////////////////////////////////////////	
         		
         		POUR i = 1 _À_ ChaîneOccurrence(SAIS_DEST,";")  
         			Ajoute(EmailAenvoyer..Destinataire, ExtraitChaîne(SAIS_DEST,i,";"))
         			//			EmailAenvoyer.Destinataire[i] = ExtraitChaîne(SAIS_DEST,i,";")
         		FIN
         		
         		
         		//	EmailAenvoyer.NbDestinataire = i-1
         		//		email.NbDestinataire = 1
         		//		email.destinataire[1] = SAIS_DEST
         		
         		EmailAenvoyer.Sujet			= SAIS_SUJET
         		EmailAenvoyer.Message		= SAIS_MESSAGE
         		EmailAenvoyer.Expéditeur	= CourrielExpediteur
         		nbAttache					= ChaîneOccurrence(lfichieraenvoyer,";")
         		
         		//	EmailAenvoyer.NbAttache = nbAttache
         		POUR i =1 À nbAttache
         			//		EmailAenvoyer.Attache[i] = ExtraitChaîne(lfichieraenvoyer,i,";")
         			EmailFichierAttache..Nom			= fExtraitChemin(ExtraitChaîne(lfichieraenvoyer,i,";"), fFichier + fExtension)
         			EmailFichierAttache..Contenu		= fChargeBuffer(ExtraitChaîne(lfichieraenvoyer,i,";"))
         			EmailFichierAttache..ContentType	= "application/pdf"
         			ajoute(EmailAenvoyer..Attache,EmailFichierAttache)
         		FIN
         		
         		
         		
         		//		ExécuteTraitement(Jauge1,trtInit)
         		EmailJauge(Jauge1,1000)
         		SI  PAS EmailEnvoieMessage(MailSession,EmailAenvoyer)  ALORS
         			si Email.Erreur <> 0
         				SI Email.Erreur > 26 ALORS
         					ACSO_message("Erreur","Impossible d'envoyer le message pour les raisons suivantes:"+RC+"Erreur inconnue","Erreur")
         				SINON
         					ACSO_message("Erreur","Impossible d'envoyer le message pour les raisons suivantes:"+RC+lerreuremail[Email.Erreur],"Erreur")
         				FIN
         				//fo(erreurinfo(errMessage))
         				RENVOYER Faux
         			sinon
         				SauveEmail(lModification)
         				mafenetre..ValeurRenvoyée = vrai
         				//			SauveEmail(lmodif)
         				ACSO_message("Information","Envoi effectué avec succès","Info")
         				EmailFermeSession("InfoErreur")
         				Ferme(FenEmail)
         				
         			fin
         			
         			
         		SINON
         			SauveEmail(lModification)
         			//			SauveEmail(lmodif)
         			MaFenêtre..ValeurRenvoyée = Vrai
         			ACSO_message("Information","Envoi effectué avec succès","Info")
         			EmailFermeSession("InfoErreur")
         			Ferme(FenEmail)
         		FIN
         		
         	FIN	
         	//////////////////////////////////////////////////////////////////////////////////////////////////////////////	
         	
         sinon
         	//	SI PAS EmailOuvreSessionSMTP("InfoErreur",SansEspace(config.ServeurSMTP)) ALORS
         	SessionSmtp est un EmailSessionSMTP
         	//	SessionSmtp.AdresseServeur = "mail.smtp2go.com"
         	//	SessionSmtp.Nom = "support@cybersquadit.com"
         	//	SessionSmtp.MotDePasse = "Cyb3r$MTP*"
         	//	SessionSmtp.Port = 2525
         	SessionSmtp.AdresseServeur	= sansespace(extraitchaine(gclconfig.m_sServeurSMTP,1,":"))
         	SessionSmtp.Nom				= sansespace(gclConfig.m_sUserSMTP)
         	SessionSmtp.MotDePasse		= sansespace(gclConfig.m_sMdpSMTP)
         	SessionSmtp.Port			= val(ExtraitChaîne(gclConfig.m_sServeurSMTP,2,":"))
         	//   SessionSmtp..Option = emailOptionSécuriséTLS
         	
         	si pas EmailOuvreSession(SessionSmtp) alors
         		//si pas EmailOuvreSessionSMTP("support@cybersquadit.com","Cyb3r$MTP*","mail.smtp2go.com",2525) alors
         		acso_message("Erreur","Impossible de se connecter au serveur de courrier sortant","Erreur")
         		
         		// code pour ExchangeServer
         		//	idsession =  EmailOuvreSession("OutLook") 
         		//	si  idsession = 0 alors
         		//si pas EmailOuvreSession("OutLook") alors
         		//	acso_message("Erreur","Impossible de se connecter au serveur de courrier sortant","Erreur")
         		
         		renvoyer faux
         		
         	sinon
         		
         		///////////////////////////////////////////////////////////////////////////////////////////////
         		//
         		// Ancien code
         		//
         		//		email.NbDestinataire = 1
         		//		email.destinataire[1] = SAIS_DEST
         		//		Email.sujet = SAIS_SUJET
         		//		email.message = SAIS_MESSAGE
         		//		email.expediteur = CourrielExpediteur
         		//		//		nbattache = ChaîneOccurrence(SAIS_FICAT,";")
         		//		nbAttache = ChaîneOccurrence(lfichieraenvoyer,";")
         		//		//		email.AttacheContentType
         		//		email.NbAttache = nbAttache
         		//		pour i =1 a nbAttache
         		//			
         		//			email.Attache[i] = ExtraitChaîne(lfichieraenvoyer,i,";")
         		//			//			email.Attache[i] = ExtraitChaîne(SAIS_FICAT,i,";")
         		//		fin
         		//		ExécuteTraitement(jauge1,trtInit)
         		//		emailjauge(jauge1,1000)
         		//		
         		//		//		SI  PAS EmailEnvoieMessage("InfoErreur") ALORS
         		//		SI  PAS EmailEnvoieMessage(SessionSmtp) ALORS
         		//			
         		//			//   code pour Exchange
         		//			//		si  pas EmailEnvoieMessage(idsession,faux) alors
         		//			acso_message("Erreur","Impossible d'envoyer le message pour les raisons suivantes"+rc+erreurinfo(errmessage),"Erreur")
         		//			//fo(erreurinfo(errMessage))
         		//			EmailFermeSession(SessionSmtp)
         		//			renvoyer faux
         		//		sinon
         		//			SauveEmail(lmodification)
         		//			acso_message("Information","Envoi effectué avec succès","Info")
         		//			EmailFermeSession(SessionSmtp)
         		//			ferme(fenemail)
         		//		FIN
         		///////////////////////////////////////////////////////////////////////////
         		// 			
         		
         		
         		///////////////////////////////////////////////////////////////////////////
         		//
         		// Nouveau code
         		//
         		///////////////////////////////////////////////////////////////////////////
         		
         		
         		POUR i = 1 _À_ ChaîneOccurrence(SAIS_DEST,";")  
         			Ajoute(EmailAenvoyer..Destinataire, ExtraitChaîne(SAIS_DEST,i,";"))
         			
         			//			EmailAenvoyer.Destinataire[i] = ExtraitChaîne(SAIS_DEST,i,";")
         		FIN
         		//	EmailAenvoyer.NbDestinataire = i-1
         		//	email.NbDestinataire = cptdestinataire
         		//		email.destinataire[1] = SAIS_DEST
         		
         		
         		EmailAenvoyer.Sujet			= SAIS_SUJET
         		EmailAenvoyer.Message		= SAIS_MESSAGE
         		EmailAenvoyer.Expediteur	= CourrielExpediteur
         		nbAttache					= ChaîneOccurrence(lfichieraenvoyer,";")
         		
         		//	EmailAenvoyer.NbAttache = nbAttache
         		POUR i =1 À nbAttache
         			//		EmailAenvoyer.Attache[i] = ExtraitChaîne(lfichieraenvoyer,i,";")
         			EmailFichierAttache..Nom			= fExtraitChemin(ExtraitChaîne(lfichieraenvoyer,i,";"), fFichier + fExtension)
         			EmailFichierAttache..Contenu		= fChargeBuffer(ExtraitChaîne(lfichieraenvoyer,i,";"))
         			EmailFichierAttache..ContentType	= "application/pdf"
         			//			EmailFichierAttache..ContentDescription = "Un document PDF"
         			Ajoute(EmailAenvoyer..Attache,EmailFichierAttache)
         		FIN
         		
         		
         		
         		
         		//		ExécuteTraitement(Jauge1,trtInit)
         		EmailJauge(Jauge1,1000)
         		SI  PAS EmailEnvoieMessage(SessionSmtp,EmailAenvoyer)  ALORS
         			
         			//			SI Email.Erreur <> 0
         			SI Email.Erreur > 26 ALORS
         				ACSO_message("Erreur","Impossible d'envoyer le message pour les raisons suivantes:"+RC+"Erreur inconnue","Erreur")
         			sinon si Email.Erreur <= 0 alors
         				ACSO_message("Erreur","Impossible d'envoyer le message pour les raisons suivantes:"+"Raison inconnue","Erreur")
         			SINON
         				ACSO_message("Erreur","Impossible d'envoyer le message pour les raisons suivantes:"+RC+lerreuremail[Email.Erreur],"Erreur")
         			FIN
         			//fo(erreurinfo(errMessage))
         			RENVOYER Faux
         			//			SINON
         			//				SauveEmail(lModification)
         			//				//			SauveEmail(lmodif)
         			//				ACSO_message("Information","Envoi effectué avec succès","Info")
         			//				EmailFermeSession("InfoErreur")
         			//				Ferme(FenEmail)
         			//				
         			//			FIN
         			
         			
         		SINON
         			SauveEmail(lModification)
         			MaFenêtre..ValeurRenvoyée = Vrai
         			//			SauveEmail(lmodif)
         			ACSO_message("Information","Envoi effectué avec succès","Info")
         			EmailFermeSession("InfoErreur")
         			Ferme(FenEmail)
         		FIN
         		
         		
         		
         		
         		
         		///////////////////////////////////////////////////////////////////////////
         		
         		
         		
         		
         		
         	fin
         	
         	
         	
         	
         	
         fin
         
         
         
         
         
         
