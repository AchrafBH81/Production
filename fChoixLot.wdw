     p_codes :
      -
        code : |1+
         lNoLotDebut est une chaine = csnLotdebut
         lNoLotfin est une chaine = csnLotFin
         iconfigure(imprimanterapport,vrai)
         iParamètre("DEFAUT=NON")
         iParamètre("FORMATPAPIER=LETTRE")
         iParamètre("QUALITE=HAUTE")
         si DESTINATION = 2 alors
         	iapercu()
         FIN
         
         selon SELECTType
         cas 1
         	RequeteSommairelot.pLotDebut = lNoLotDebut
         	RequeteSommairelot.pLotfin = lNoLotfin
         	HExécuteRequête(RequeteSommairelot)
         	iImprimeEtat(ESommaireLot,lNoLotDebut,lNoLotfin)
         
         cas 2
         		iImprimeEtat(EDetailLot,lNoLotDebut,lNoLotfin)
         FIN
         
         
         
