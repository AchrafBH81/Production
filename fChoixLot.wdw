  procedures :
   -
     name : recalculelot
     procedure_id : 5078227128725831584
     type_code : 14
     code : |1+
      Procédure recalculelot(lNoLot)
      
      hcreation(tqteprep)
      si hlitrecherche(ArchivePrep,TNoLot,lNoLot) alors
      	si acso_message("Question","Ce lot existe déjà"+rc+"Voulez-vous l'écraser ?","OuiNon") = idno alors
      		renvoyer vrai
      	fin
      FIN
      pour tout ArchivePrep  avec "TNoLot = "+lNoLot
      	hsupprime(ArchivePrep,hnumenrencours)
      	
      FIN
      pour tout hfacture avec "NoLot = "+lNoLot
      	pour tout hfdetail avec "HFCLEUNIK = "+hfacture.HFCLEUNIK
      		si hfdetail.ftype = 1 alors
      			AjouterTableau(1,hfdetail.fdnumprod,hfdetail.fdlargeura,hfdetail.fdhauteura,"",hfdetail.fddesc,hfacture.facalcul,hfdetail.fdqteafacturer,lNoLot)
      
      		sinon si hfdetail.ftype = 4 alors
      			AjouterTableau(2,hfdetail.fdnumprod,hfdetail.fdcarreauv,hfdetail.fdcarreauh,hfdetail.fdtypecalcul,hfdetail.fddesc,hfacture.facalcul,hfdetail.fdqteafacturer,lNoLot)
      
      		FIN
      
      	FIN
      
      FIN
      
      
      si hnbenr(tqteprep) = 0 alors
      	acso_message("Erreur","Aucune facture pour ce lot","Erreur")
      sinon
      	RemplirArchivePrep()	
      
      FIN
      
      ACSO_message("Info","Récupération du lot "+lNoLot+" effectué avec succès")
      csnLotdebut = 0
     type : 458752
   -
     name : AjouterTableau
     procedure_id : 5078235960680308338
     type_code : 14
     code : |1+
      Procédure AjouterTableau(ltype,lproduit,largeur,lhauteur,ltypecalcul="",ldesc="",lAnglaismetrique=1,lqte=1,lnolot=0)
      ldimension est un reel
      ltrouve est un entier
      i est un entier
      
      
      
      
      selon ltype
      	cas 1	
      		selon lAnglaismetrique
      			cas 1
      				ldimension = arrondi(val(largeur) * val(lhauteur) / 144,2)
      			cas 2
      				ldimension = arrondi(val(largeur) * val(lhauteur) / 1000000 * config.conversionam,2)
      		fin
      
      
      		si hlitrecherche(TQtePrep,TNoProdTtypeCalcul,HConstruitValClé(TQtePrep,TNoProdTtypeCalcul,lproduit,"")) alors
                 TQtePrep.TDimension+=(ldimension * lqte)
                 TQtePrep.tqte+=lqte
                 hmodifie(TQtePrep,hNumEnrEnCours)
      		sinon
      			TQtePrep.tdesc = ldesc
      			TQtePrep.TNoProd = lproduit
      			TQtePrep.TDimension = (ldimension * lqte)
      			TQtePrep.tType = ltype
      			TQtePrep.TtypeCalcul = ""
      			TQtePrep.tqte=lqte
      			tqteprep.TNoLot = lnolot
      			hajoute(TQtePrep)
      		fin
      
      	cas 2	
      		si hlitrecherche(TQtePrep,TNoProdTtypeCalcul,HConstruitValClé(TQtePrep,TNoProdTtypeCalcul,lproduit,ltypecalcul)) alors
      			TQtePrep.TDimension+= calcul_nb_carreau(lproduit,largeur,lhauteur,ltypecalcul) * lqte
      			TQtePrep.tqte+=lqte
      			hmodifie(TQtePrep,hNumEnrEnCours)
      		sinon
      			TQtePrep.tdesc = ldesc
      			TQtePrep.TNoProd = lproduit
      			TQtePrep.TDimension = calcul_nb_carreau(lproduit,largeur,lhauteur,ltypecalcul) * lqte
      			TQtePrep.tType = ltype
      			TQtePrep.TtypeCalcul = ltypecalcul
      			TQtePrep.tqte=lqte
      			tqteprep.TNoLot = lnolot
      			hajoute(TQtePrep)
      		fin
      
      FIN
      
      
      
      
      
      
      
      
     type : 458752
   -
     name : RemplirArchivePrep
     procedure_id : 5078236376007006289
     type_code : 14
     code : |1+
      Procédure RemplirArchivePrep()
      
      pour tout TQtePrep
      	HCopieEnreg(ArchivePrep,TQtePrep)
      	hajoute(ArchivePrep)
      FIN
      
     type : 458752
   -
     name : calcul_nb_carreau
     procedure_id : 5078254711254580624
     type_code : 14
     code : |1+
      // méthode  1 = normal
      //          2 = contour
      //          3 = semi-contour 
      
      Procédure calcul_nb_carreau(lproduit,nbcarreauv,nbcarreauh,ltypecalcul,methode=1)
      
      //global
      //LA est un entier = commande.cdcarreauv
      //HA est un entier = commande.cdcarreauh
      local
      	res est une chaine
      	nbcarreau est un entier
      	met1 est une chaine = config.formulecontour
      	met2 est une chaine = config.formulesemicontour
      	formule1 est une chaine 
      	formule2 est une chaine = "y est un reel"+RC+"y="+met2+RC+"renvoyer(y)"
      	//res est une chaine
      
      	si hlitrecherche(typecarr,tcdescription,ltypecalcul) alors
      		si typecarr.Typedessin = 2 alors
      			si client.cQteSpecialeContour alors
      				si sansespace(typecarr.TcalculQteContour) <> "" alors
      					nbl = nbcarreauv
      					nbh = nbcarreauh
      					formule1 = "y est un reel"+RC+"y="+typecarr.TcalculQteContour+RC+"renvoyer(y)"
      					methode = 2
      				fin	
      			fin
      		FIN
      
      	FIN
      
      
      
      selon methode
      
      	cas 1
      		nbcarreau = nbcarreauv * nbcarreauh
      	cas 2
      		res = compile("formulec1",formule1)
      		si res = "" alors
      			//		nbcarreau = formulec1() 
      			nbcarreau = executetraitement("formulec1",trtProcédure) 
      		FIN
      	cas 3
      		res = compile("formulec2",formule2)
      		si res = "" alors
      			nbcarreau = executetraitement("formulec2",trtProcédure) 
      		FIN
      fin
      renvoyer nbcarreau
      
     type : 458752
