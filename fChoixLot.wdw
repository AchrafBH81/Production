         si csnlotdebut <> 0 alors
         	si acso_message("Question","Vous êtes sur le point de supprimer le lot # "+csnLotdebut+rc+"Voulez-vous continuer ?","OuiNon") = idyes alors
         
         		pour tout fcoutant avec "nolot = "+csnlotdebut
         			HSupprime(Fcoutant,hnumenrencours)
         
         		fin
         		pour tout FcoutantLigne avec "nolot = "+csnlotdebut
         			HSupprime(Fcoutantligne,hnumenrencours)
         		fin
         		pour tout ArchivePrep  avec "Tnolot = "+csnlotdebut
         			HSupprime(ArchivePrep,hnumenrencours)
         		fin
         	FIN
         ACSO_message("Information","Le lot "+ csnlotdebut +" à été supprimé")
         csnLotdebut = 0
         FIN
        type : 18
      -
        type : 161
        enabled : false
