       internal_properties : 
       properties :
        x : 221.378
        width : 13.3
        height : 4.5
       code_elements :
        type_code : 29
        p_codes :
         -
           code : |1-
            selon client.cUnitemesureImpression
            	cas 0,3
            		selon RequetefeuilleLivraison.facalcul
            			CAS 1
            				rubrique16..MasqueSaisie = "99,99"
            				si client.CImpressionAngMet = 2 alors
            					rubrique16..MasqueSaisie	= "99,999"
            					moimeme						= moimeme * gclConfig.m_rConversionam
            				FIN
            			cas 2	
            				rubrique16..MasqueSaisie = "9,9999"
            				SI Client.CImpressionAngMet = 1 ALORS
            					MoiMême = MoiMême / gclConfig.m_rConversionam
            				FIN
            		FIN
            	cas 1 
            		rubrique16..MasqueSaisie = "99,99"
            		SI Client.CImpressionAngMet = 2 ALORS
            			rubrique16..MasqueSaisie	= "99,999"
            			MoiMême						= MoiMême * gclConfig.m_rConversionam
            		FIN
            	cas 2 
            		rubrique16..MasqueSaisie = "9,9999"
            		SI Client.CImpressionAngMet = 1 ALORS
            			MoiMême = MoiMême / gclConfig.m_rConversionam
            		FIN
            FIN
            
            si corps..visible alors 
            	moimeme = rubrique16
            	calcul4 += (rubrique16  * RUBRIQUE4)
            FIN
