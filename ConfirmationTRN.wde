  p_codes :
   -
     internal_properties : CQAAAAkAAAAMKk0bUnppf9n/DdIx+pD12FdjGBpDdPouTXmKpwRX8VSK7s3EyvfwpbA1UoOIDFhQRWUvEtPmaHQL3DqP9EYkvNp92ZaY8pL88p/fEQhlXNEtBTP55g==
     code : |1-
      // Traitement automatique des exceptions :   exécuter le bloc de code CAS EXCEPTION:
      //
      
      procedure confirmationtrn(facturereimpression = faux,numerobonl=0,Avecprix=vrai)
      
      tableaucarrelage est un tableau dynamique
      tableaucarrelage = allouer un tableau de 0 par 5 chaine
      dimensiontableaucarrelage est un entier = 0
      calculligne est un entier = 0
      AncienNumCommande est un entier
      AncienNumcarrelage est une chaine = ""
      ldebut est un entier = vrai
      lTypeLigne est une chaine = "" // Verre, verre a l'unité, Unité , carrelage , Peinture
      totalpage est un reel = 0
      totalpage1 est un reel = 0
      totalfacture est un reel = 0
      totalsurcharge est un reel = 0
      TotalSurchargeTaux est un reel = 0
      SurchargeTauxClient est un reel
      
      
      
      
      
      totalcap est un reel = 0
      taxetaux1 est un reel 
      taxetaux2 est un reel 
      taxedesc1 est une chaine
      taxedesc2 est une chaine
      TaxeGL1 est une chaine
      TaxeGL2 est une chaine
      taxecombine est un booleen
      _tableautaxe est un tableau dynamique
      
      
      
      libérer fac_detail
      fac_detail = allouer un tableau de 1 par 4 chaine
      fac_detail[1,1] = ""
      fac_detail[1,2] = "0.00"
      hlit(config,1)
      SuchargeTauxBaseActive est un booleen = config.SUrchargeTauxActive
      SurchargeSurEnergie est un booleen = config.calculTauxSurSurcharge
      
      si pas avecprix alors
      	grpprix..visible = faux
          FIN_DOCUMENT..VISIBLE = FAUX
          iteration7..visible=faux
      FIN
      
      CAS EXCEPTION:
      	info(ExceptionInfo(errComplet))
     type : 327680
   -
     code : |1-
      
     type : 327695
  procedures :
   -
     name : Rupturefdcomm
     procedure_id : 5142013119757084279
     type_code : 14
     code : |1+
      Procédure Rupturefdcomm()
      
      iimprime("salut")
      
     type : 458752
   -
     name : Remplir_tableau
     procedure_id : 5142013118402127479
     type_code : 14
     code : |1+
      Procédure Remplir_tableau(codegl,montantgl,taxegl=faux)
      codegltrouve est un booleen = faux
      j est un entier = (dimension(fac_detail)/4)
      k est un entier
      si pas j = 1 alors
      pour k = 2 a j
      	si fac_detail[k,1] = codegl alors
      		codegltrouve = vrai
      		fac_detail[k,2]=numeriqueverschaine(val(fac_detail[k,2])+montantgl)
      	    sortir
      	FIN
      FIN
      fin
      
      si pas codegltrouve alors
          
      	dimension(fac_detail,j+1,4)
      	fac_detail[j+1,1] = codegl
      	fac_detail[j+1,2] = numeriqueverschaine(montantgl)
          si taxegl alors
          	fac_detail[j+1,3] = "1"
          fin	
      FIN
      
      
      
     type : 458752
   -
     name : assigneLibelle
     procedure_id : 5142013119422129783
     type_code : 14
     code : |1-
      Procédure assigneLibelle()
      i est un entier
      
      lTableauLibelle est un tableau de 45 chaines
      lTableauLibelle[1]  = "facentete,facentete"
      lTableauLibelle[2]  = "facpage,facpage"
      lTableauLibelle[3]  = "facpagede,facpagede"
      lTableauLibelle[4]  = "facnumero,facnumero"
      lTableauLibelle[5]  = "facdate,facdate"
      lTableauLibelle[6]  = "facnumcommande,facnumcommande"
      lTableauLibelle[7]  = "facjobdetail,facjobdetail"
      lTableauLibelle[8]  = "facquantite,facquantite"
      lTableauLibelle[9]  = "faclargeur,faclargeur"
      lTableauLibelle[10] = "fachauteur,fachauteur"
      lTableauLibelle[11] = "faclargeurpouce,faclargeurpouce"
      lTableauLibelle[12] = "fachauteurpouce,fachauteurpouce"
      lTableauLibelle[13] = "facdescription,facdescription"
      lTableauLibelle[14] = "facfini,facfini"
      //lTableauLibelle[15] = "facspacer,facspacer"
      lTableauLibelle[15] = ","
      lTableauLibelle[16] = "faccarrelage,faccarrelage"
      lTableauLibelle[17] = "factotalcarr,factotalcarr"
      //lTableauLibelle[18] = "facpiedcarre,facpiedcarre"
      lTableauLibelle[18] = ","
      lTableauLibelle[19] = "facpiedcarrefacture,facpiedcarrefacture"
      lTableauLibelle[20] = "facprixuni,facprixuni"
      lTableauLibelle[21] = "facsurcharge,facsurcharge"
      lTableauLibelle[22] = "facsoustotal,facsoustotal"
      lTableauLibelle[23] = "factotal,factotal"
      lTableauLibelle[24] = "factotalpage,factotalpage"
      lTableauLibelle[25] = "facrecupar,facrecupar"
      //lTableauLibelle[26] = "facmetrecarre,facmetrecarre"
      lTableauLibelle[26] = ","
      lTableauLibelle[27] = "facmetrecarrefacture,facmetrecarrefacture"
      lTableauLibelle[28] = "facprixunimetre,facprixunimetre"
      lTableauLibelle[29] = "facnotvq,facnotvq"
      lTableauLibelle[30] = "facnotps,facnotps"
      lTableauLibelle[31] = "factvq,factvq"
      lTableauLibelle[32] = "factps,factps"
      lTableauLibelle[33] = "vendua,vendua"
      lTableauLibelle[34] = "livrea,livrea"
      lTableauLibelle[35] = "confirmationcommande,confirmationcommande"
      lTableauLibelle[36] = "nocommande,nocommande"
      lTableauLibelle[37] = "nojob,nojob"
      lTableauLibelle[38] = "daterequise,daterequise"
      lTableauLibelle[39] = "notrereference,notrereference"
      lTableauLibelle[40] = "peinturetlt,peinturetlt"
      lTableauLibelle[41] = "peintureinterieure,peintureinterieure"
      lTableauLibelle[42] = "facsurchargetaux,facsurchargetaux"
      lTableauLibelle[43] = "totalpiedcarrefac,totalpiedcarrefac"
      lTableauLibelle[44] = "totalmetrecarrefac,totalmetrecarrefac"
      lTableauLibelle[45] = "user,Lib_user"
      
      selon client.CLangue
      	cas 1
      		pour i = 1 a 45
      
      			si hlitrecherche(Traduction,TRecherche,extraitchaine(lTableauLibelle[i],1,",")) alors
      				{"confirmationtrn."+ExtraitChaîne(lTableauLibelle[i],2,",")} = traduction.dFrancais
      			fin
      		FIN
      	cas 2
      		pour i = 1 a 45
      			si hlitrecherche(Traduction,TRecherche,extraitchaine(lTableauLibelle[i],1,",")) alors
      				{"confirmationtrn."+ExtraitChaîne(lTableauLibelle[i],2,",")} = traduction.danglais
      			fin
      		FIN
      fin
     type : 458752
   -
     name : AlimenteHistorique
     procedure_id : 5142013119715993207
     type_code : 14
     code : |1+
      Procédure AlimenteHistorique(lclient,ldate,lmontant)
      
      si  facturereimpression alors
      	renvoyer vrai
      FIN
      lannee est un entier= ldate..Année
      lmois est un entier = ldate..mois
      
      
      si hlitrecherche(HistoAnneeMois,lanneeMois,HConstruitValClé(HistoAnneeMois,lanneemois,lclient,lannee,lmois)) alors
      	HistoAnneeMois.lvente+= lmontant
      	hmodifie(HistoAnneeMois,hNumEnrEnCours)
      sinon
      	HistoAnneeMois.hclient = lclient
      	HistoAnneeMois.lAnnee = lannee
      	HistoAnneeMois.lmois = lmois
      	HistoAnneeMois.lvente = lmontant
      	hajoute(HistoAnneeMois)
      FIN
      
      renvoyer vrai
      
      
      
