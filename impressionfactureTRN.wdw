 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1+
      fac_entete					est un tableau de 5 chaine
      AuMoinsUneFactureChoisie	est un booleen	= faux
      pasmemeclient				est un booleen	= faux
      NbFactureChoisie			est un entier	= 0
      
      STShippingBill				est une structure
      	nShippingBillNumber			est un entier
      	dShippingBillDate			est une Date
      	sShippingBillCustomerNumber	est une chaîne
      	sShippingBillCustomername	est une chaine
      	nShippingBillIsPaint		est un entier
      	nCfacture est un entier
      	nNumberOfOrder est un entier
      	tabOrderDetail				est un tableau de storderdetail    
      fin
      
      
      STOrderdetail est une structure
      	nOrderNumber			est un entier
      	dhOrderdate				est une DateTime
      	sCustomerOrderNumber	est une chaine
      	norderIsPaint		est un entier
      fin
      
      gtaShippingBill est un tableau associatif (*, *, wlEntier) de STShippingBill
      
      
      MoiMême..Visible=Vrai
      
      chargeimage(1,maitre.FichierImage..valeur,1,13)
      
      //ListeAjoute("choix",img_ok)
      //ListeAjoute("choix",img_ok)
      ListeAjoute("choix",gImage(1,7))
      ListeAjoute("choix",gImage(1,10))
      
      ListeAjoute("cimprime",gImage(1,9))
      ListeAjoute("cimprime",gImage(1,11))
      
      ListeAjoute("ctransfert",gImage(1,12))
      ListeAjoute("ctransfert",gImage(1,10))
      ListeAjoute("ctransfert",gImage(1,8))
      
      listeajoute(ctype,gImage(1,5))
      listeajoute(ctype,gImage(1,6))
      
      
      memcree("afacturer")
      remplir_tablefacture()
      global 
      impression_ok est un booléen = faux
      
      
      //Code WinDev 5.5 remplacé par la migration :
      //_onglet1..etat = actif
      csdDateFacture	= datesys()
      MaFenetre..Plan	= 1
   -
     code : |1+
      
      //ExécuteTraitement(TABLE_FACTURE,trtSélection)
      
      
      
     type : 34
   -
     type : 180
     enabled : false
   -
     type : 230
     enabled : false
   -
     code : |1-
      //ouvrefille(FEN_AttenteGif,"Vérification de l'intégrité des factures")
      ajustefacture()
      hdesactivefiltre("fdetail")
      hdesactivefiltre("Facture")
      //ferme(FEN_AttenteGif)
      //si gImprimantePdfStatus alors
      //	OuvreSoeur(FenAttentePetite,"Fermeture de l'imprimante PDF virtuelle en cours ......")
      //	pdfc>>cOption("AutosaveFilename") = "Fichier"
      //	killprocess("PDFCreator.exe")
