  -
    name : MenuContextuelSel
    identifier : 0x48c189f50a2a6abb
    internal_properties : 
    options :
     -
       name : OptionSel
       identifier : 0x48c189f5103b6abb
       internal_properties : 
       code_elements :
        type_code : 26
        p_codes :
         -
           code : |1+
            i est un entier
            AuMoinsUneFactureChoisie=faux
            pasmemeclient = faux
            lnumeroclient est un chaine
            
            pour i = 1 a TableSelectOccurrence(ShippingBillTable)
            	ShippingBillTable.CHOIX[TableSelect(ShippingBillTable,i)] = vrai
            	
            	ShippingBillTable.datef[TableSelect(ShippingBillTable,i)] = csdDateFacture
            FIN
            
            TableSelectMoins(ShippingBillTable)
            
            pour i =1 a TableOccurrence(ShippingBillTable)
            	si ShippingBillTable.CHOIX[i] alors
            		AuMoinsUneFactureChoisie=vrai
            		si ShippingBillTable.tclient[i] <> lnumeroclient et pas lnumeroclient = "" alors
            			pasmemeclient = vrai
            		sinon
            			lnumeroclient = ShippingBillTable.tclient[i]	
            		FIN
            	FIN
            FIN
            
            allumeboutonimpression(AuMoinsUneFactureChoisie)
            si AuMoinsUneFactureChoisie alors
            	si pasmemeclient alors
            		csDestination[2]..etat= grise
            	sinon
            //		si gImprimantePdfStatus alors
            			csDestination[2]..etat= actif
            //		sinon
            //			csDestination[2]..etat= grise
            //		fin
            		VerifieAdresse(lnumeroclient)
            
            	fin
            
            fin
            
            
            
           type : 32
     -
       name : Déselectionner
       identifier : 0x48c18a2b1cf33faf
       internal_properties : 
       code_elements :
        type_code : 26
        p_codes :
         -
           code : |1+
            i est un entier
            AuMoinsUneFactureChoisie=faux
            pasmemeclient = faux
            lnumeroclient est un chaine
            
            pour i = 1 a TableSelectOccurrence(ShippingBillTable)
            	ShippingBillTable.CHOIX[TableSelect(ShippingBillTable,i)] = faux
            	ShippingBillTable.datef[TableSelect(ShippingBillTable,i)] = ""
            
            FIN
            
            TableSelectMoins(ShippingBillTable)
            
            pour i =1 a TableOccurrence(ShippingBillTable)
            	si ShippingBillTable.CHOIX[i] alors
            		AuMoinsUneFactureChoisie=vrai
            		si ShippingBillTable.tclient[i] <> lnumeroclient et pas lnumeroclient = "" alors
            			pasmemeclient = vrai
            		sinon
            			lnumeroclient = ShippingBillTable.tclient[i]	
            		FIN
            	FIN
            FIN
            
            allumeboutonimpression(AuMoinsUneFactureChoisie)
            si AuMoinsUneFactureChoisie alors
            	si pasmemeclient alors
            		csDestination[2]..etat= grise
            	sinon
            //		si gImprimantePdfStatus alors
            			csDestination[2]..etat= actif
            //		sinon
            //			csDestination[2]..etat= grise
            //		fin
            		VerifieAdresse(lnumeroclient)
            	fin
            
            fin
            
           type : 32
