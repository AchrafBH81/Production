  -
    name : SELECT_TOUT
    identifier : 0x4796136263e22e51
    internal_properties : 
    properties :
     x : 618
     y : 52
     width : 100
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         j est un entier
         pasmemeclient=faux
         lnumeroclient est une chaine
         pour j = 1 to tableoccurrence(ShippingBillTable)
         	si ShippingBillTable.RécupèreParent(j) = 0 alors
         		choix[j]	= Vrai
         		datef[j]	= csdDateFacture
         	fin
         	si ShippingBillTable.tclient[j] <> lnumeroclient et pas lnumeroclient = "" alors
         		pasmemeclient = vrai
         	sinon
         		lnumeroclient = ShippingBillTable.tclient[j]	
         	FIN
         	
         FIN
         AuMoinsUneFactureChoisie=vrai
         allumeboutonimpression(AuMoinsUneFactureChoisie)
         si AuMoinsUneFactureChoisie alors
         	si pasmemeclient alors
         		csDestination[2]..etat= grise
         	sinon
         		//		si gImprimantePdfStatus alors
         		csDestination[2]..etat= actif
         		//		sinon
         		//			csDestination[2]..etat= grise
         		//		fin
         		VerifieAdresse(lnumeroclient)
         		
         	fin
         	
         FIN
        type : 18
      -
        type : 161
        enabled : false
