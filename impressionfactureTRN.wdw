      -
        type : 339
        enabled : false
  -
    name : BTN_IMPRIME
    identifier : 0x47961362549c2e42
    internal_properties : 
    properties :
     x : 73
     y : 6
     width : 32
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         //iimprimeetat("LISTE PRIX SPéCIAUX",client.numero,client.numero)
         i					est un entier
         j					est un entier
         premierefacture		EST UN ENTIER 
         dernierefacture		est un entier
         lnumeroclient		est une chaine
         pasmemeclient		est un booleen	= faux
         lAdresseCourriel	est une chaine
         ListeFichier		est une chaine
         ListeNoFacture		est une chaine	= ""
         lSujet				est une chaine
         lMessage			est une chaine 
         lnorecordbon		est un entier
         lNbCopieFacture		est un entier
         lnomfichier			est une chaine
         nLcptfacture		est un entier
         lConcatFacture		est une chaine	= ""
         si HLitDernier(BonLivraison,Bfacture) alors
         	prochainnumerodefacture = bonlivraison.Bfacture+1
         	
         FIN
         //Info(prochainnumerodefacture)
         
         hlitpremier("config","COCLEUNIK")
         restaure_bouton()
         impression_ok = vrai
         nFid est un entier = fouvre(completerep(RepEnCours)+"Logfacture.txt",foEcriture+foCréationSiInexistant)
         
         //prochainnumerodefacture = config.numfact
         si hlitrecherche(BonLivraison,Bfacture,prochainnumerodefacture) alors
         	acso_message("Erreur","Le numéro de facture "+prochainnumerodefacture+" existe"+rc+"Modifier le prochain numéro de facture dans la configuration")
         	ferme(impressionfactureTRN)
         FIN
         
         si acso_message("Question","Imprimer toutes les factures choisies","OuiNon") = idyes alors
         	si csdestination = 2
         		pour j = 1 _a_ TableOccurrence(ShippingBillTable)
         			si ShippingBillTable.CHOIX[j] alors
         				si ShippingBillTable.tclient[j] <> lnumeroclient et pas lnumeroclient = "" alors
         					pasmemeclient = vrai
         				sinon
         					lnumeroclient = ShippingBillTable.tclient[j]	
         				FIN
         			fin
         		FIN
         	fin
         	
         	si pasmemeclient alors
         		si csdestination = 2 alors
         			acso_message("Erreur","Toutes les factures doivent appartenir au même client,l'envoi par courriel est donc annulé","Erreur")
         			csDestination = 1
         		fin
         	fin
         	
         	premierefacture	= 1
         	dernierefacture	= tableoccurrence(ShippingBillTable)
         sinon
         	premierefacture	= ShippingBillTable
         	dernierefacture	= ShippingBillTable
         	lnumeroclient	= ShippingBillTable.tclient[ShippingBillTable]	
         FIN
         sablier(vrai)
         si csDestination = 1 alors
         	lNbCopieFacture = config.nbcopiefacture
         sinon
         	lNbCopieFacture = config.nbcopiefacturecourriel
         FIN
         
         tableselectplus(ShippingBillTable,1)
         pour j = premierefacture a dernierefacture
         	
         	si j > tableoccurrence(ShippingBillTable,1) alors
         		tableselectplus(ShippingBillTable,j)
         	fin
         	
         	si choix[j] = vrai alors
         	
         		hlitrecherche(BonLivraison,Bnumero,ShippingBillTable.tBonLivraison[j])
         		si htrouve(BonLivraison) alors
         			factures.CalculTotal(ShippingBillTable.TBonLivraison[j])
         			bonlivraison.BDateFacture	= ShippingBillTable.DATEF[j]
         
         			bonlivraison.Bfacture		= prochainnumerodefacture
         			si hlitrecherche(client,numero,BonLivraison.Bclient) et Client.dateDerniereCommande < BonLivraison.BDateFacture alors
         				client.dateDerniereCommande = BonLivraison.BDateFacture
         				hmodifie(client,hNumEnrEnCours)
         			FIN
         			
         			hmodifie(BonLivraison,hNumEnrEnCours)
         			fac_entete[1]	= bonlivraison.Bclient
         			fac_entete[2]	= dateverschaine(bonlivraison.Bdatefacture,"JJ/MM/AAAA")
         			fac_entete[3]	= numeriqueverschaine(bonlivraison.Bfacture) 
         			
         			fac_entete[4]	= numeriqueverschaine(bonlivraison.Bnumero)
         			fac_entete[5]	= "Transfert / Logiciel de production"
         			prochainnumerodefacture++
         			lnorecordbon = HSauvePosition(BonLivraison)
         			si hlitrecherche(BonLivraison,Bfacture,prochainnumerodefacture) alors
         				HLitDernier(BonLivraison,Bfacture)
         				prochainnumerodefacture=BonLivraison.Bfacture+1
         			FIN
         			HRetourPosition(lnorecordbon)
         			
         //			hexecuterequete(RequeteBlEtat,hRequêteDéfaut,ShippingBillTable.tbonlivraison[j])
         			hexecuterequete(ReqGroupShippingBill,hRequêteDéfaut,ShippingBillTable.tbonlivraison[j])
         			//iAperçu(i100, "Aperçu écran", Vrai)
         			// Ne sauvegarde pas les paramètres spécifiés
         			
         			iConfigure(SansEspace(imprimantefacture),Vrai)
         			iParamètre("DEFAUT=NON")
         			iParamètre("COPIES="+ (csdestination = 1 ? lNbCopieFacture sinon "1"))
         			iParamètre("QUALITE=HAUTE")
         			iFenêtreAbandon(Faux)
         			
         			si lNbCopieFacture <> 0 ou csdestination = 1 alors 	iimprimeetat(EGroupInvoice,vrai,ShippingBillTable.TBonLivraison[j])
         			
         			cimprime[j]				= vrai
         			bonlivraison.BStotal	= (val(fac_detail[1,2] ) * -1) -val(fac_detail[dimension(fac_detail)/4,2] ) 
         			bonlivraison.BStotal -= val(fac_detail[(dimension(fac_detail)/4)-1,2] ) 
         			bonlivraison.BTPS		= val(fac_detail[(dimension(fac_detail)/4)-1,2] ) 
         			bonlivraison.BTvq		= val(fac_detail[dimension(fac_detail)/4,2] ) 
         			bonlivraison.Bsurcharge	= val(fac_detail[(dimension(fac_detail)/4)-2,2] ) //+ Val(fac_detail[(Dimension(fac_detail)/4)-3,2] ) 
         			si hlitrecherche(Client,numero,BonLivraison.Bclient) _et_ client.limiteCredit > 0 alors
         				client.TotalCommande-= (Val(fac_detail[1,2] ) * -1)
         				client.Soldefacture += (Val(fac_detail[1,2] ) * -1)
         				hmodifie(Client,hNumEnrEnCours)
         			FIN
         			multitache(50)
         			hmodifie(BonLivraison,hnumenrencours)
         			AlimenteLanneemois()
         			maj_detail_comptable(bonlivraison.Bnumero)
         			si csdestination = 3 alors
         				iConfigure(SansEspace(imprimantefax),Vrai)
         				iParamètre("DEFAUT=NON")
         				iParamètre("QUALITE=HAUTE")
         				iFenêtreAbandon(Faux)
         				
         				
         				////////////////////////////////////////////////////////////////////////////////							
         				lConcatFacture+=ShippingBillTable.TBonLivraison[j]+";"
         				///////////////////////////////////////////////////////////////////////////////
         			FIN
         			si csDestination = 2 alors
         				
         				//				pdfc>>cPrinterStop = 1
         				si frep(completerep(repdonnees)+"PDF\"+sansespace(lnumeroclient)+"\Facture",frRépertoire) = "" alors
         					fRepCrée(completerep(repdonnees)+"PDF\"+sansespace(lnumeroclient)+"\Facture")
         				fin
         				//				pdfc>>cOption("AutosaveDirectory") = repdonnees+"PDF\"+sansespace(lnumeroclient)+"\Facture"
         				//				pdfc>>cOption("AutosaveFilename")  ="Facture"+BonLivraison.bfacture
         				//				//						pdfc>>cOption("AutosaveFilename")  ="Facture"+BonLivraison.bfacture+".pdf"
         				//				lnomfichier = pdfc>>cOption("AutosaveDirectory")+"\Facture"+BonLivraison.bfacture+".pdf"
         				lnomfichier = completerep(repdonnees)+"PDF\"+SansEspace(lnumeroclient)+"\Facture\Facture"+BonLivraison.bfacture+".pdf"
         				
         				si fFichierExiste(lnomfichier) alors
         					fSupprime(lnomfichier)
         				fin
         				
         				iConfigure(SansEspace(imprimantefacture),Vrai)
         				iParamètre("DEFAUT=NON")
         				iParamètre("FORMATPAPIER=LETTRE")
         				iDestination(iPDFGénérique,lnomfichier)
         				iFenêtreAbandon(faux)
         				iimprimeetat(EGroupInvoice,vrai,ShippingBillTable.TBonLivraison[j])
         				selon client.editype 
         					cas 1
         					cas 2
         						//								SendEdiBascoFacture(BonLivraison.bfacture)	
         						SendEdiBascoFacture(BonLivraison.bnumero)	
         						
         					AUTRE CAS
         						
         				FIN
         				
         				CTRANSFERT[j]=3
         				
         				
         				sablier(vrai)
         				
         				
         				ListeFichier+=lnomfichier+";"
         				ListeNoFacture+=sansespace(BonLivraison.bfacture)+","
         				
         
         			fin
         
         			SupprimeFactureTRN()
         			//				hlitsuivant(RequeteBlEtat)
         			//			FIN
         		sinon
         			choix[j] = 2
         		fin 
         	sinon
         		//	ferme(impressionfactureTRN)
         	fin
         fin
         hlitpremier(config,"COCLEUNIK")
         config.NumFact = prochainnumerodefacture
         hmodifie(config,hNumEnrEnCours)
         
         si csDestination = 2 alors 
         	
         	si hlitrecherche(client,numero,lnumeroclient) alors
         		si client.cconfirmation = 5 alors
         		sinon	
         			pour i = 1 a 4
         				si sansespace(client.ccourrielFacture[i]) <> "" alors
         					lAdresseCourriel += sansespace(client.ccourrielFacture[i])+";"
         				fin
         			fin
         			si client.CLangue = 1 alors
         				lSujet		= SANSESPACE(config.SujetFrancais[1])+" "+ListeNoFacture
         				lMessage	= config.TexteFrancais[1]
         			sinon
         				lSujet		= SANSESPACE(config.Sujetanglais[1])+" "+ListeNoFacture
         				lMessage	= config.Texteanglais[1]
         			fin	
         			
         			sablier(faux)
         			lSujet=lSujet[[1 a taille(lSujet)-1]]
         			ouvre(FenEmail,lAdresseCourriel,lSujet,lMessage,ListeFichier,lnumeroclient,faux,2)
         		fin
         	fin
         	
         fin
         
         //////////////////////////////////////////////////////////////////////////
         
         si gformatfacture = 2 et csDestination = 3 alors
         	iConfigure(SansEspace(imprimantefax),Vrai)
         	iParamètre("DEFAUT=NON")
         	iParamètre("QUALITE=HAUTE")
         	iFenêtreAbandon(Faux)
         	iimprimeetat(EtatConcatFacture,lConcatFacture)
         	POUR i = 1 _À_ ChaîneOccurrence(lConcatFacture,";")
         		HExécuteRequête(ReqGroupShippingBill,hRequêteDéfaut,ExtraitChaîne(lConcatFacture,i,";"))
         		lnomfichier = ComplèteRep(repdonnees)+"PDF\"+SansEspace(ReqGroupShippingBill.faclient)+"\Facture\Facture"+sansespace(ReqGroupShippingBill.Bfacture)+".pdf"
         		iDestination(iPDFGénérique,lnomfichier)
         		
         		iimprimeetat(EGroupInvoice,Faux,ExtraitChaîne(lConcatFacture,i,";"))
         	fin
         	
         	
         fin
         
         
         /////////////////////////////////////////////////////////////////////////////
         
         
         si impression_ok alors
         	btn_imprime..etat		= grisé; btn_imprime..Visible=Vrai
         	BTN_IMPRIME1PDF..etat	= grisé; BTN_IMPRIME1PDF..Visible=Vrai
         	
         	btn_ecran..etat			= grisé; btn_ecran..Visible=Vrai
         	si pas gLogCompt = "Cameleon" alors
         		si acso_message("Question","Transfert des factures à la comptabilité ?","OuiNon") = idyes alors
         			ExecuteTraitement(BTN_ACOMBA,TRTclic)
         		fin
         	FIN
         FIN
         iraz
         multitache(200)
         sablier(faux)
         //ferme(impressionfactureTRN)
         //iimprimeetat("fichier de transfert")
         
         nombreEnlevé	est un entier	= 0
         nombreLignes	est un entier	= tableoccurrence(ShippingBillTable,1)
         
         pour i = 1 a nombreLignes
         	si ShippingBillTable.CHOIX[i - nombreEnlevé] alors
         		tablesupprime(ShippingBillTable,i- nombreEnlevé)
         		nombreEnlevé = nombreEnlevé + 1
         	FIN
         FIN
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_IMPRIME1PDF
    identifier : 0x48beec2364ff6c79
    internal_properties : 
    properties :
     x : 74
     y : 37
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         //iimprimeetat("LISTE PRIX SPéCIAUX",client.numero,client.numero)
         j est un entier
         i est un entier=1
         premierefacture EST UN ENTIER 
         dernierefacture est un entier
         lnumeroclient est une chaine
         pasmemeclient est un booleen = faux
         lAdresseCourriel est une chaine
         ListeFichier est une chaine
         ListeNoFacture est une chaine=""
         lSujet est une chaine
         lMessage est une chaine 
         lnorecordbon est un entier
         lNbCopieFacture est un entier
         lCptFacture est un entier =0
         lNomFichier est une chaine
         nLcpt est un entier
         n_temporisation est un entier = 0
         lRepencours est une chaine = completerep(frepencours())+"Temp\"
         lnomfichierUnique est un tableau associatif (*, *, wlEntier) de chaînes
         TableauFichierPDF est un tableau dynamique de chaine
         
         _fichier est une chaine = ""
         si frep(lRepencours) = "" alors fRepCrée(lRepencours)
         
         
         
         hlitpremier("config","COCLEUNIK")
         restaure_bouton()
         impression_ok = vrai
         SI HLitDernier(BonLivraison,Bfacture) ALORS
         	prochainnumerodefacture = BonLivraison.Bfacture+1
         	
         FIN
         //prochainnumerodefacture = config.numfact
         si hlitrecherche(BonLivraison,Bfacture,prochainnumerodefacture) alors
         	acso_message("Erreur","Le numéro de facture "+prochainnumerodefacture+" existe"+rc+"Modifier le prochain numéro de facture dans la configuration")
         	ferme(impressionfactureTRN)
         FIN
         
         si acso_message("Question","Imprimer toutes les factures choisies","OuiNon") = idyes alors
         	si csdestination = 2
         		pour j = 1 a TableOccurrence(ShippingBillTable)
         			si ShippingBillTable.CHOIX[j] alors
         				si ShippingBillTable.tclient[j] <> lnumeroclient et pas lnumeroclient = "" alors
         					pasmemeclient = vrai
         				sinon
         					lnumeroclient = ShippingBillTable.tclient[j]	
         				FIN
         			fin
         		FIN
         	fin
         	
         	si pasmemeclient alors
         		si csdestination = 2 alors
         			acso_message("Erreur","Toutes les factures doivent appartenir au même client,l'envoi par courriel est donc annulé","Erreur")
         			csDestination = 1
         		fin
         	fin
         	
         	premierefacture = 1
         	dernierefacture = tableoccurrence(ShippingBillTable)
         sinon
         	premierefacture = ShippingBillTable
         	dernierefacture = ShippingBillTable
         	lnumeroclient = ShippingBillTable.tclient[ShippingBillTable]	
         FIN
         
         si csDestination = 1 alors
         	lNbCopieFacture = config.nbcopiefacture
         sinon
         	lNbCopieFacture = config.nbcopiefacturecourriel
         FIN
         sablier(vrai)
         TablePosition(ShippingBillTable,1)
         tableselectplus(ShippingBillTable,1)
         pour j = premierefacture a dernierefacture
         	
         	
         	si choix[j] = vrai alors
         		si j >= tableposition(ShippingBillTable)+TableOccurrence(ShippingBillTable,toVisible) alors
         			TablePosition(ShippingBillTable,j)
         		fin
         //		libérer fac_detail
         //		fac_detail = allouer un tableau de 1 par 4 chaine
         //		fac_detail[1,1] = ""
         //		fac_detail[1,2] = "0.00"
         //		fac_detail[1,3] = "0"
         		hlitrecherche(BonLivraison,Bnumero,ShippingBillTable.tBonLivraison[j])
         		si htrouve(BonLivraison) alors
         			factures.CalculTotal(ShippingBillTable.TBonLivraison[j])
         			bonlivraison.BDateFacture = ShippingBillTable.DATEF[j]
         			BonLivraison.bTauxTvh = config.tauxtps
         			BonLivraison.bTauxTvq = config.tauxtvq
         			bonlivraison.Bfacture = prochainnumerodefacture
         			SI HLitRecherche(Client,numero,BonLivraison.Bclient) ET Client.dateDerniereCommande < BonLivraison.BDateFacture ALORS
         				Client.dateDerniereCommande = BonLivraison.BDateFacture
         				HModifie(Client,hNumEnrEnCours)
         			FIN
         			
         			hmodifie(BonLivraison,hNumEnrEnCours)
         			fac_entete[1] = bonlivraison.Bclient
         			fac_entete[2] = dateverschaine(bonlivraison.Bdatefacture,"JJ/MM/AAAA")
         			fac_entete[3] = numeriqueverschaine(bonlivraison.Bfacture) 
         			
         			fac_entete[4] = numeriqueverschaine(bonlivraison.Bnumero)
         			fac_entete[5] = "Transfert / Logiciel de production"
         			prochainnumerodefacture++
         			lnorecordbon = HSauvePosition(BonLivraison)
         			si hlitrecherche(BonLivraison,Bfacture,prochainnumerodefacture) alors
         				HLitDernier(BonLivraison,Bfacture)
         				prochainnumerodefacture=BonLivraison.Bfacture+1
         			FIN
         			HRetourPosition(lnorecordbon)
         			
         //			hexecuterequete(RequeteBlEtat,hRequêteDéfaut,ShippingBillTable.tbonlivraison[j])
         			HExécuteRequête(ReqGroupShippingBill,hRequêteDéfaut,ShippingBillTable.TBonLivraison[j])
         			//iAperçu(i100, "Aperçu écran", Vrai)
         			// Ne sauvegarde pas les paramètres spécifiés
         			iconfigure(sansespace(imprimantefacture),vrai)
         			iParamètre("DEFAUT=NON")
         			iParamètre("COPIES="+lNbCopieFacture)
         			iParamètre("QUALITE=HAUTE")
         			selon gFormatFacture
         				cas 1
         					iimprimeetat(laFactureNovy,faux,ShippingBillTable.TBonLivraison[j])
         				cas 2
         					iFenêtreAbandon(faux)
         					iapercu(0,"Facture"+BonLivraison.Bfacture)
         					si lNbCopieFacture<> 0 ou csDestination = 1 alors
         						 iimprimeetat(EGroupInvoice,vrai,ShippingBillTable.TBonLivraison[j])
         					FIN
         					
         			FIN
         			cimprime[j] = vrai
         			bonlivraison.BStotal = (val(fac_detail[1,2] ) * -1) -val(fac_detail[dimension(fac_detail)/4,2] ) 
         			bonlivraison.BStotal -= val(fac_detail[(dimension(fac_detail)/4)-1,2] ) 
         			bonlivraison.BTPS = val(fac_detail[(dimension(fac_detail)/4)-1,2] ) 
         			bonlivraison.BTvq = val(fac_detail[dimension(fac_detail)/4,2] ) 
         			bonlivraison.Bsurcharge = val(fac_detail[(dimension(fac_detail)/4)-2,2] ) 
         			SI HLitRecherche(Client,numero,BonLivraison.Bclient) _ET_ Client.limiteCredit > 0 ALORS
         				Client.TotalCommande-= (Val(fac_detail[1,2] ) * -1)
         				Client.Soldefacture += (Val(fac_detail[1,2] ) * -1)
         				HModifie(Client,hNumEnrEnCours)
         			FIN
         			multitache(50)
         			hmodifie(BonLivraison,hnumenrencours)
         			
         			
         			
         			AlimenteLanneemois()
         			maj_detail_comptable(bonlivraison.Bnumero)
         			si csDestination = 2 alors
         				lCptFacture++
         				lnomfichierUnique[lCptFacture] = lRepencours + "facture"+ numeriqueverschaine(lCptFacture) +".pdf"
         				
         				//				iConfigure(SansEspace(imprimantefacture),Vrai)
         				iParamètre("DEFAUT=NON")
         				iParamètre("FORMATPAPIER=LETTRE")
         				iDestination(iPDFGénérique,lnomfichierUnique[lCptFacture])
         				iFenêtreAbandon(Faux)
         				
         				//				
         				//				iconfigure(sansespace(imprimantepdf),vrai)
         				//				iFenêtreAbandon(faux)
         				selon gFormatFacture
         					cas 1
         						iimprimeetat(laFactureNovy,vrai,ShippingBillTable.TBonLivraison[j])
         					cas 2
         						//											iapercu(0,table_facture.TBonLivraison[j])
         						iimprimeetat(EGroupInvoice,vrai,ShippingBillTable.TBonLivraison[j])
         						SELON Client.ediType 
         							CAS 1
         							CAS 2
         								//								SendEdiBascoFacture(BonLivraison.bfacture)	
         								SendEdiBascoFacture(BonLivraison.bnumero)	
         								
         							AUTRE CAS
         								
         						FIN
         						
         						ListeNoFacture+=sansespace(BonLivraison.bfacture)+","
         						
         						//						tantque pas pdfc>>ccountofprintjobs() = lCptFacture
         						//						fin
         						CTRANSFERT[j] = 3
         						//message(lCptFacture)
         				fin
         				//				message(pdfc>>ccountofprintjobs()+","+lCptFacture+",boucle"+","+lcpt)
         				sablier(vrai)
         				//				multitache(500)
         				//				frenomme(sansespace(config.DossierFichierPDF),...
         				//				fExtraitChemin(config.DossierFichierPDF, fDisque+fRépertoire)+"Facture"+BonLivraison.bfacture+".pdf")
         				//				listefichier+=fExtraitChemin(config.DossierFichierPDF, fDisque+fRépertoire)+"Facture"+BonLivraison.bfacture+".pdf"+";"
         				//				ListeNoFacture+=sansespace(BonLivraison.bfacture)+","
         				
         			fin
         			
         			si hlitrecherche(hfacture,Bnumero,BonLivraison.Bnumero) alors
         				pour tout Fcoutant avec "cNoCommande = "+ hfacture.fanumero
         					fcoutant.cDAteFacture = BonLivraison.bdatefacture
         					hmodifie(Fcoutant,hnumenrencours)
         				FIN
         				pour tout Fcoutantligne avec "cNoCommande = "+ hfacture.fanumero
         					fcoutantligne.cDAteFacture = BonLivraison.bdatefacture
         					hmodifie(Fcoutantligne,hnumenrencours)
         				FIN
         			fin	
         			//			hdebloquenumenr("Facture",h.numenr)
         			
         //			hlitpremier(RequeteBlEtat)
         //			tantque pas hendehors(RequeteBlEtat)
         				SupprimeFactureTRN()
         //				hlitsuivant(RequeteBlEtat)
         //			FIN
         		sinon
         			choix[j] = 2
         		fin 
         	sinon
         	fin
         fin
         OuvreSoeur(FenAttentePetite)
         hlitpremier(config,"COCLEUNIK")
         config.NumFact = prochainnumerodefacture
         hmodifie(config,hNumEnrEnCours)
         
         
         si csDestination = 2 alors 
         	
         	si frep(completerep(repdonnees)+"PDF\"+sansespace(lnumeroclient)+"\Facture",frRépertoire) = "" alors
         		fRepCrée(completerep(repdonnees)+"PDF\"+sansespace(lnumeroclient)+"\Facture")
         	fin
         	//	pdfc>>cOption("AutosaveDirectory") = repdonnees+"PDF\"+sansespace(lnumeroclient)+"\Facture"
         	i = 1
         	tantque fFichierExiste(completerep(repdonnees)+"PDF\"+SansEspace(lnumeroclient)+"\Facture\Facture"+datesys()+"_"+i+".pdf")
         		i++
         	fin
         	//	pdfc>>cOption("AutosaveFilename")  ="Facture"+datesys()+"_"+i
         	//	lnomfichier = pdfc>>cOption("AutosaveDirectory")+"\Facture"+datesys()+"_"+i+".pdf"
         	lNomFichier = ComplèteRep(repdonnees)+"PDF\"+SansEspace(lnumeroclient)+"\Facture\Facture"+DateSys()+"_"+i+".pdf"
         	FenAttentePetite.Libellé1 = "Préparation du fichier PDF en cours ("+lNomFichier+")"
         	MultitacheRepeint(FenAttentePetite)
         	i = 0
         	//	tantque pas pdfc>>ccountofprintjobs() = lCptFacture
         	//	fin
         	//
         	//	pdfc>>cCombineAll()
         	//	pdfc>>cPrinterStop = 0
         	//	tantque pdfc>>ccountofprintjobs() >= 1
         	//		//	tantque sansespace(pdfc>>cOutputFilename) = ""
         	//		//		si modulo(i,1000) = 0 alors
         	//		//			message(pdfc>>cOutputFilename)
         	//		//		fin
         	//		i++
         	//	FIN
         	multitache(100)
         	pour tout sfichier de lnomfichierUnique
         		_fichier+= sfichier+" "
         		TableauFichierPDF.Ajoute(sfichier)
         	fin
         	
         	pdffusionne(lNomFichier,TableauFichierPDF)
         	
         	
         	
         //	LanceAppli("cmd.exe  /C pdftk "+_fichier + "cat output " + lNomFichier,exeIconise,exeBloquant)
         //	TANTQUE PAS fFichierExiste(lNomFichier)
         //
         //	FIN
         	
         	POUR TOUT sfichier de lnomfichierUnique
         		fsupprime(sfichier)
         	FIN
         	
         	ListeFichier+=lNomFichier+";"
         	
         	si hlitrecherche(client,numero,lnumeroclient) alors
         		pour i = 1 a 4
         			si sansespace(client.ccourrielFacture[i]) <> "" alors
         				lAdresseCourriel += sansespace(client.ccourrielFacture[i])+";"
         			fin
         		fin
         		si client.CLangue = 1 alors
         			lSujet = SANSESPACE(config.SujetFrancais[1])+" "+ListeNoFacture
         			lMessage = config.TexteFrancais[1]
         		sinon
         			lSujet = SANSESPACE(config.Sujetanglais[1])+" "+ListeNoFacture
         			lMessage = config.Texteanglais[1]
         		fin	
         	fin
         	
         	ferme(FenAttentePetite)
         //	pdfc>>cPrinterStop = 1
         	sablier(faux)
         	lSujet=lSujet[[1 a taille(lSujet)-1]]
         	ouvre(FenEmail,lAdresseCourriel,lSujet,lMessage,ListeFichier,lnumeroclient,faux,2)
         sinon
         	ferme(FenAttentePetite)	
         fin
         
         
         si impression_ok alors
         	btn_imprime..etat = grisé; btn_imprime..Visible=Vrai
         	BTN_IMPRIME1PDF..etat = grisé; BTN_IMPRIME1PDF..Visible=Vrai
         	btn_ecran..etat = grisé; btn_ecran..Visible=Vrai
         	si pas gLogCompt = "Cameleon" alors
         		si acso_message("Question","Transfert des factures à la comptabilité ?","OuiNon") = idyes alors
         			ExecuteTraitement(BTN_ACOMBA,TRTclic)
         		fin
         	FIN
         FIN
         iraz
         sablier(faux)
         multitache(100)
         //ferme(impressionfactureTRN)
         //iimprimeetat("fichier de transfert")
         
         nombreEnlevé est un entier = 0
         nombreLignes est un entier = tableoccurrence(ShippingBillTable,1)
         
         pour i = 1 a nombreLignes
         	si ShippingBillTable.CHOIX[i - nombreEnlevé] alors
         		tablesupprime(ShippingBillTable,i- nombreEnlevé)
         		nombreEnlevé = nombreEnlevé + 1
         	FIN
         FIN
         
