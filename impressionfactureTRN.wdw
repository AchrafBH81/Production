    name : csdDateFacture
    identifier : 0x48da8760423b32db
    internal_properties : 
    properties :
     x : 732
     y : 82
     width : 91
     height : 24
    calendar :
     internal_properties : 
     properties :
      width : 200
      height : 200
     type : 47
    type : 2
    code_elements :
     type_code : 3
     p_codes :
      -
        code : |1+
         si moimeme = "" ou moimeme > datedujour() alors
         	acso_message("Erreur","La date est obligatoire et ne doit pas être supérieure à aujourd'hui","Erreur")
         	moimeme = datedujour()
         	reprisesaisie()
         FIN
         i est un entier
         pour i = 1 a TableOccurrence(ShippingBillTable)
         	si ShippingBillTable.CHOIX[i] = 1 alors 
         		ShippingBillTable.datef[i] = moimeme
         	fin
         FIN
        type : 16
      -
