     p_codes :
      -
        type : 35
        enabled : false
      -
        code : |1+
         
         // Trace le contenu des lignes sélectionnées
         // (Le champ Table est un champ Table multisélection)
         i				est un entier 
         NbSelectionne	est un entier 
         NbSelectionne = TableSelectOccurrence(ShippingBillTable) 
         tabLineToDeselect est un tableau d'entier
         
         POUR i = 1 À NbSelectionne
         		
         	si ShippingBillTable.RécupèreParent(TableSelect(ShippingBillTable, i)) <> 0 alors
         		tabLineToDeselect.ajoute(TableSelect(ShippingBillTable, i)) 
         	FIN
         	
         FIN
         
         pour chaque nLinenumber de tabLineToDeselect
         	ShippingBillTable.SelectMoins(nLinenumber)
         FIN
         
        type : 16
      -
        code : |1+
         
         //si hlitrecherche(client,numero,table_facture.Tclient[table_facture]) alors
         //	table_facture.NOM = client.nom
         //FIN
