  -
    name : IMG_ok
    identifier : 0x29976663baf9197a
    internal_properties : 
    properties :
     x : 924
     y : 30
     width : 16
     height : 16
    type : 8
    code_elements :
     type_code : 8
     p_codes : []
  -
    name : BTN_MARQUE
    identifier : 0x29eb761b2638859c
    internal_properties : 
    properties :
     x : 887
     y : 103
     width : 80
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         i est un entier
         AuMoinsUneFactureChoisie	= faux
         pasmemeclient			= faux
         nNbSelectTable	est un entier
         
         lnumeroclient	est un chaine
         ltypeImpression	est un entier
         si TableRécupèreParent(ShippingBillTable,ShippingBillTable) <> 0 alors
         	Erreur("Dans le cas ou il y a plusieurs commandes sur un bon de livraison "," il faut cliquer sur la ligne du bon de livraison pour le sélectionner")
         	renvoyer faux
         FIN
         
         si ShippingBillTable.choix = vrai alors
         	ShippingBillTable.choix	= faux
         	ShippingBillTable.datef	= ""
         	
         sinon
         	ShippingBillTable.choix	= vrai	
         	ShippingBillTable.datef	= csdDateFacture
         FIN
         
         NbFactureChoisie	= 0
         
         
         pour i =1 _a_ ShippingBillTable..Occurrence
         	si  ShippingBillTable.choix[i] alors
         		AuMoinsUneFactureChoisie=vrai
         		si ShippingBillTable.tclient[i] <> lnumeroclient et pas lnumeroclient = "" alors
         			pasmemeclient = vrai
         			Erreur("Toutes les factures choisies doivent appartenir au même client")
         			choiX = Faux
         			renvoyer vrai
         		sinon
         			lnumeroclient	= ShippingBillTable.tclient[i]
         			ltypeImpression	= ShippingBillTable.ftypeImpression[i]	
         		FIN
         		NbFactureChoisie++
         	FIN
         FIN
         
         allumeboutonimpression(AuMoinsUneFactureChoisie,ltypeImpression)
         si AuMoinsUneFactureChoisie et ltypeImpression = 2 alors
         	si pasmemeclient alors
         		csDestination[2]..etat		= grise
         		BTN_IMPRIME1PDF..visible	= faux
         	sinon
         		
         		csDestination[2]..etat= actif
         		si NbFactureChoisie > 1 alors 
         			BTN_IMPRIME1PDF..Visible = vrai
         		sinon
         			BTN_IMPRIME1PDF..Visible = faux
         			
         		FIN
         		
         		
         		VerifieAdresse(lnumeroclient)
         	fin
         	
         fin
         
         
         
         
         
        type : 18
      -
        type : 161
        enabled : false
