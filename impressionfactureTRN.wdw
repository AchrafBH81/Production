     type : 13
  procedures :
   -
     name : majhistorique
     procedure_id : 5158331735520128562
     type_code : 14
     code : |1+
      Procédure majhistorique(numeroenregistrement,nocommande)
      multiplicateur est un entier
      hlit("Facture",numeroenregistrement)
      si facture.fatypedocument  = 2 alors
      	multiplicateur = -1
      sinon
      	multiplicateur = 1	
      FIN
      hfacture.ftransfere      = faux
      hfacture.fanumero        = nocommande
      hfacture.fadate          = facture.FDATEREQUISE
      hfacture.fadatecommande  = facture.fadate
      hfacture.fatype          = facture.fatype
      hfacture.faclient        = facture.faclient
      hfacture.fanofacture     = facture.fanofacture
      hfacture.fanojob         = facture.fanojob
      hfacture.fanocommande    = facture.fanocommande
      hfacture.fasecteur       = facture.fasecteur
      hfacture.facalcul        = facture.facalcul
      hfacture.fasurcharge     = facture.fasurcharge 
      hfacture.fatotal         = facture.fatotal     
      hfacture.fatps           = facture.fatps       
      hfacture.fatvq           = facture.fatvq       
      hfacture.fatypedocument  = Facture.fatypedocument
      hfacture.fareference     = Facture.fareference
      hfacture.fabonlivraison  = facture.fabonlivraison
      hfacture.nolot           = facture.nolot
      hfacture.fafraistransport= Facture.fafraistransport * multiplicateur
      hfacture.SUrchargePeinture =facture.SUrchargePeinture
      hfacture.nom 			 = facture.nom
      hfacture.adresse 		 = facture.adresse
      hfacture.Ville 			 = facture.ville
      hfacture.CodePostal		 = facture.CodePostal
      hfacture.noTelephone	 = facture.noTelephone
      hfacture.ftypecredit     = facture.Ftypecredit
      hfacture.cvendeur        = facture.cvendeur
      hfacture.IDCamions    = Facture.IDCamions
      
      hajoute("hfacture")
      
      pour tout Fcoutant avec "cNoCommande = "+ facture.fanumero
      	fcoutant.cDAteFacture = BonLivraison.bdatefacture
      	hmodifie(Fcoutant,hnumenrencours)
      FIN
      pour tout Fcoutanligne avec "cNoCommande = "+ facture.fanumero
      	fcoutantligne.cDAteFacture = BonLivraison.bdatefacture
      	hmodifie(Fcoutantligne,hnumenrencours)
      FIN
      //Code WinDev 5.5 remplacé par la migration :
      //si hdoublon() alors
      si HErreurDoublon() alors
      	erreur("Impossible d'ajouter la facture "+numeriqueverschaine(facture.fanofacture,"10d"))
      	renvoyer vrai
      FIN
      fhistorique[lignedetable] = h.numenr
      
      hlitrecherche("fdetail","fdnocomm",facture.fanumero)
      
      //Code WinDev 5.5 remplacé par la migration :
      //tantque fdetail.fdnocomm = facture.fanumero et pas h.endehors
      tantque fdetail.fdnocomm = facture.fanumero et pas HEnDehors()
      
      	si fdetail.fdqteafacturer <> 0 alors  
      		hfdetail.fdligne        = fdetail.fdligne
      		hfdetail.fdlien         = fdetail.fdlien
      		hfdetail.fdnumprod      = fdetail.fdnumprod
      		hfdetail.fddesc         = fdetail.fddesc
      		hfdetail.fdqteafacturer = fdetail.fdqteafacturer  * multiplicateur
      		hfdetail.fdespace       = fdetail.fdespace
      		hfdetail.fdlargeur      = fdetail.fdlargeur
      		hfdetail.fdhauteur      = fdetail.fdhauteur
      		hfdetail.fdhauteur1     = fdetail.fdhauteur1
      		hfdetail.fdlargeura     = fdetail.fdlargeura
      		hfdetail.fdhauteura     = fdetail.fdhauteura
      		hfdetail.fdhauteur1a    = fdetail.fdhauteur1a
      		hfdetail.fdprixu        = fdetail.fdprixu
      		hfdetail.fdcarrelage    = fdetail.fdcarrelage
      		hfdetail.fdcarreauh     = fdetail.fdcarreauh
      		hfdetail.fdcarreauv     = fdetail.fdcarreauv
      		hfdetail.fdnumcarr      = fdetail.fdnumcarr
      		hfdetail.ftype          = fdetail.ftype
      		hfdetail.fdprixtotal    = fdetail.fdprixtotal
      		hfdetail.fdcarrpruxuc   = fdetail.fdcarrpruxuc
      		hfdetail.frcarrprixu    = fdetail.frcarrprixu * multiplicateur
      		hfdetail.fdcarrprixtotal= fdetail.fdcarrprixtotal * multiplicateur
      		hfdetail.fdprixupied    = fdetail.fdprixupied
      		hfdetail.fdcodegl       = fdetail.fdcodegl
      		hfdetail.fcapgaztube    = fdetail.fcapgaztube 
      		hfdetail.fdverreunite   = fdetail.fdverreunite
      		hfdetail.fdnofact       = Facture.fanofacture
      		hfdetail.FDJOBLIGNE      = fdetail.FDJOBLIGNE
      		hfdetail.fdcomposant1    =fdetail.fdcomposant1
      		hfdetail.fdcomposant2    =fdetail.fdcomposant2
      		hfdetail.fdcomposant3    =fdetail.fdcomposant3
      		hfdetail.fdcarrprixdebase=fdetail.fdcarrprixdebase * multiplicateur
      		hfdetail.surchargeenergie=fdetail.surchargeenergie  
      		hfdetail.fdcommentaire   = fdetail.fdcommentaire
      		hfdetail.fdlargeuru      = fdetail.fdlargeuru
      		hfdetail.fdhauteuru      = fdetail.fdhauteuru
      		hfdetail.fdforme         = fdetail.fdforme
      		hfdetail.fdextraforme    = fdetail.fdextraforme
      		hfdetail.fdhauteuranglais  = fdetail.fdhauteuranglais
      		hfdetail.fdlargeuranglais  = fdetail.fdlargeuranglais
      		hfdetail.fdpiedcarre       = fdetail.fdpiedcarre
      		hfdetail.fdpiedcarrefacture=fdetail.fdpiedcarrefacture
      		hfdetail.fdprixupiedfacture=fdetail.fdprixupiedfacture
      		hfdetail.fnotes            = fdetail.fnotes
      		hfdetail.fdvariablex       = fdetail.fdvariablex
      		hfdetail.fdextracap       = fdetail.fdextracap
      		hfdetail.fdtypecalcul     = fdetail.fdtypecalcul
      		hfdetail.fdvariablex1     = fdetail.FDvariablex1
      		hfdetail.fdDDH            = fdetail.fdDDH
      		hfdetail.fdDDv            = fdetail.fdDDv
              hfdetail.fdt              = fdetail.fdt
      		hfdetail.fTypePeinture     = fdetail.fTypePeinture
      		hfdetail.fNoPeintureExtTout = fdetail.fNoPeintureExtTout
      		hfdetail.FnopeintureInterieure = fdetail.FnopeintureInterieure
      		hfdetail.fdescpeintureExtTout = fdetail.fdescpeintureExtTout
      		hfdetail.fDescPeintureInterieure  = fdetail.fDescPeintureInterieure
      		hfdetail.fPrixCarreauPeinture = fdetail.fPrixCarreauPeinture
      		hfdetail.Ftotalcarreaupeinture = fdetail.Ftotalcarreaupeinture
      		hfdetail.fTotalPeinture = fdetail.fTotalPeinture
      		hfdetail.fPeinture = fdetail.fPeinture
      		hfdetail.libelleNbcarreauinterieur = fdetail.libelleNbcarreauinterieur
      		hfdetail.libelleNbCarreauExtTlt = fdetail.libelleNbCarreauExtTlt
      		hfdetail.FtotalbarrePeinture = fdetail.FtotalbarrePeinture
      		hfdetail.fnopeinture = fdetail.fnopeinture
      		hfdetail.fdescpeinture = fdetail.fdescpeinture
      		hfdetail.fextrapeinture = fdetail.fextrapeinture
      		hfdetail.fdescpeinture1 = fdetail.fdescpeinture1
      		hfdetail.fTypePeinture1     = fdetail.fTypePeinture1
      		hfdetail.fnopeinture1 = fdetail.fnopeinture1
      		hfdetail.FDnbcarreauPeinture1 = fdetail.FDnbcarreauPeinture1
      		hfdetail.fdprixcarreaupeinture1 = fdetail.fdprixcarreaupeinture1
      		hfdetail.fdfabrication = fdetail.FDfabrication
      		hfdetail.SUrchargeafacturer =fdetail.SUrchargeafacturer
      		hfdetail.surchargeenergie =fdetail.SUrchargeafacturer
      		hfdetail.SUrchargedejafacture =fdetail.SUrchargedejafacture
      		hfdetail.ExtraArgonPrice = Fdetail.ExtraArgonPrice
      		hfdetail.CalculArgon = Fdetail.CalculArgon
      		hfdetail.PietageArgon = Fdetail.PietageArgon
      		hfdetail.fdbase = Fdetail.fdbase
      		hfdetail.fnolot = fdetail.fnolot
      
      
      		hajoute("hfdetail")
      
      
      
      	fin
      	hlitsuivant("fdetail","fdnocomm")
      
      FIN
      
     type : 458752
   -
     name : remplir_memoire
     procedure_id : 5158331736865254962
     type_code : 14
     code : |1+
      Procédure remplir_memoire()
      j est un entier
      memcrée("afacturer")
      pour j = 1 a tableoccurrence("TABLE_FACTURE")
         si choix[j] alors
      	   memajoute("afacturer",fenregistrement[j],fenregistrement[j])
      	   cimprime[j] = vrai
      	   tableaffiche("TABLE_FACTURE")
         fin
      		  
      FIN
      
     type : 458752
   -
     name : remplir_tablefacture
     procedure_id : 5158331735108955698
     type_code : 14
     code : |1+
      Procédure remplir_tablefacture()
      lnocommande					est une chaine	= ""
      lnocommandeclient			est une chaine	= ""
      lchaine						est une chaine
      lpeinture					est un entier
      nCurrentLine				est un entier
      nCurrentOrderLine est un entier
      
      
      TxtReq						est une chaîne	= [
      	SELECT 
      	BonLivraison.Bnumero AS Bnumero,	
      	BonLivraison.Bdate AS Bdate,	
      	BonLivraison.Bclient AS Bclient,	
      	hfacture.fadate AS fadate,	
      	hfacture.nom AS nom,
      	hfacture.fanumero,
      	hfacture.fanocommande,		
      	Client.cfacture AS cfacture,	
      	BonLivraison.Bfacture AS Bfacture
      	FROM 
      	BonLivraison
      	
      	inner join client on client.numero = bonlivraison.Bclient
      	inner join hfacture on hfacture.bnumero = bonlivraison.bnumero
      	WHERE 
      	
      	(
      	BonLivraison.Bfacture = 0
      	)
      	ORDER BY 
      	Bnumero ASC
      ]
      reqsql est une source de Données
      
      TableSupprimeTout(ShippingBillTable)
      HExécuteRequêteSQL(reqsql,hRequêteDéfaut,TxtReq)
      
      
      OuvreSoeur(FEN_AttenteGif,"Récupération des informations en cours.....",mafenetre..x+(mafenetre..largeur/2),mafenetre..y+(mafenetre..hauteur/2))
      gtaShippingBill.SupprimeTout()
      pour tout reqsql
      	lchaine				= TrouveCommande(reqsql.Bnumero)
      	lnocommande			= ExtraitChaîne(lchaine,1,",")
      	lnocommandeclient	= ExtraitChaîne(lchaine,2,",")
      	lnocommande			= reqsql.fanumero
      	lnocommandeclient	= reqsql.fanocommande
      	SI HLitRecherche(Facture,fanumero,reqsql.fanumero) ALORS
      		lpeinture = Facture.fpeinture
      	SINON
      		lpeinture = 0	
      	FIN
      	si pas gtaShippingBill[reqsql.bnumero]..Existe ALORS
      		gtaShippingBill[reqsql.bnumero].nShippingBillNumber			= reqsql.bnumero
      		gtaShippingBill[reqsql.bnumero].dShippingBillDate			= reqsql.bdate
      		gtaShippingBill[reqsql.bnumero].sShippingBillCustomerNumber	= reqsql.bclient
      		gtaShippingBill[reqsql.bnumero].sShippingBillCustomername	= reqsql.nom
      		gtaShippingBill[reqsql.bnumero].nCfacture					= reqsql.cfacture
      		si gtaShippingBill[reqsql.bnumero].nShippingBillIsPaint = 0 alors gtaShippingBill[reqsql.bnumero].nShippingBillIsPaint = lpeinture 
      	FIN
      	stCurrentOrderDetail est un STOrderdetail = allouer un storderdetail()
      	stCurrentOrderDetail.dhOrderdate			= reqsql.fadate
      	stCurrentOrderDetail.nOrderNumber			= reqsql.fanumero
      	stCurrentOrderDetail.sCustomerOrderNumber	= reqsql.fanocommande
      	stCurrentOrderDetail.norderIsPaint			= lpeinture
      	gtaShippingBill[reqsql.bnumero].nNumberOfOrder++
      	gtaShippingBill[reqsql.bnumero].tabOrderDetail.ajoute(stCurrentOrderDetail)
      	
      	
      	
      	//	tableajouteligne("TABLE_FACTURE",faux,faux,faux,lpeinture,RequeteBLaFacturer.Bnumero,...
      	//lnocommande,lnocommandeclient,RequeteBLaFacturer.Bdate,RequeteBLaFacturer.fadate,RequeteBLaFacturer.Bclient,"",DATESYS())
      	//	TableAjouteLigne("TABLE_FACTURE",Faux,Faux,Faux,lpeinture,reqsql.Bnumero,...
      	//	lnocommande,lnocommandeclient,reqsql.Bdate,reqsql.fadate,reqsql.Bclient,reqsql.nom,"",reqsql.cfacture)
      	
      FIN
      
      pour CHAQUE stCurrentShippingBill de gtaShippingBill 
      	nCurrentLine = TableAjouteLigne(ShippingBillTable,"",faux,faux,faux,stCurrentShippingBill.nShippingBillIsPaint,stCurrentShippingBill.nShippingBillNumber,...
      	"","",stCurrentShippingBill.dShippingBillDate,stCurrentShippingBill.tabOrderDetail[1].dhOrderdate,stCurrentShippingBill.sShippingBillCustomerNumber,stCurrentShippingBill.sShippingBillCustomername,...
      	"",stCurrentShippingBill.ncfacture)
      	si stCurrentShippingBill.nNumberOfOrder = 1 alors
      		ShippingBillTable.tNotreCommande[nCurrentLine]	= stCurrentShippingBill.tabOrderDetail[1].nOrderNumber
      		ShippingBillTable.tVotreCommande[nCurrentLine]	= stCurrentShippingBill.tabOrderDetail[1].sCustomerOrderNumber
      		ShippingBillTable.Datereq[nCurrentLine]			= stCurrentShippingBill.tabOrderDetail[1].dhOrderdate
      		
      	SINON
      		ShippingBillTable[nCurrentLine]..CouleurFond = iGrisClair
      		pour chaque stCurrentOrder de stCurrentShippingBill.tabOrderDetail
      			nCurrentOrderLine = ShippingBillTable.Ajoutefils(nCurrentLine,"",Faux,Faux,Faux,stCurrentOrder.norderIsPaint,0,...
      			stCurrentOrder.nOrderNumber,stCurrentOrder.sCustomerOrderNumber,"",stCurrentOrder.dhOrderdate,"","",...
      			"",stCurrentShippingBill.nCfacture)
      			ShippingBillTable[nCurrentOrderLine]..couleurfond = iGrisClair
      			
      		FIN
      		
      		
      		
      	FIN
      FIN
      ferme(FEN_AttenteGif)
      tableaffiche(ShippingBillTable,taDebut)
      ShippingBillTable.trie("TBonLivraison")
      ShippingBilltable.EnrouleTout()
      
      
     type : 458752
   -
     name : maj_detail_comptable
     procedure_id : 5158331736509132338
     type_code : 14
     code : |1+
      Procédure maj_detail_comptable(numeroBL)
      i est un entier
      pour i = 1 a dimension(fac_detail)/4
      	detailcompta.numeroBL = numeroBL
      	si pas sansespace(fac_detail[i,1]) = "" ou i = 1 alors
      		detailcompta.NoGlivre = fac_detail[i,1]
      	sinon
      		detailcompta.noglivre = gclconfig.m_sglventedefaut
      	fin
      
      //	detailcompta.NoGlivre = fac_detail[i,1]
      	detailcompta.MontantGlivre = fac_detail[i,2]
      	detailcompta.EstTaxe = fac_detail[i,3]
      	detailcompta.noLigne = i
      	hajoute(DetailCompta)
      FIN
      
      
      
     type : 458752
   -
     name : TrouveCommande
     procedure_id : 5158337528751047297
     type_code : 14
     code : |1+
      Procédure TrouveCommande(lNoBon)
      valeuraretourner est une chaine = ""
      
      si hlitrecherche(BonLivraison,Bnumero,lNoBon) alors
      	si hlitrecherche(hfacture,Bnumero,BonLivraison.Bnumero) alors
      		valeuraretourner = NumériqueVersChaine(hfacture.fanumero+","+hfacture.fanocommande)
      
      	FIN
      
      FIN
      
      renvoyer valeuraretourner
     type : 458752
   -
     name : allumeboutonimpression
     procedure_id : 5244422483720848816
     type_code : 14
     code : |1+
      Procédure allumeboutonimpression(laction=Vrai,lTypeImpression=0)
      
      
      si laction alors
      	
      	csDestination..etat = actif
      	BTN_IMPRIME..Etat = Actif
      	
      	selon lTypeImpression
      		cas 1
      			csDestination = lTypeImpression
      			BTN_IMPRIME1PDF..Etat = Invisible
      			csDestination[2]..Etat = Grisé
      			csDestination[3]..Etat = Grisé
      			
      		cas 2
      			si TableSelectOccurrence(ShippingBillTable) > 1 alors
      				BTN_IMPRIME1PDF..Etat = Actif
      			sinon
      				BTN_IMPRIME1PDF..Etat = grise
      			fin			
      			csDestination[2]..Etat = actif
      			csDestination = lTypeImpression
      			
      			csDestination[3]..Etat = Grisé
      			
      		cas 3
      			csDestination[3]..Etat = actif
      			csDestination = lTypeImpression
      			BTN_IMPRIME1PDF..Etat = Invisible
      			csDestination[2]..Etat = Grisé
      			
      	fin
      	//	
      	//	si lTypeImpression = 2 alors
      	//		BTN_IMPRIME1PDF..Etat = actif
      	//		csDestination[3]..Etat = Grisé
      	//	sinon
      	//		BTN_IMPRIME1PDF..Etat = invisible
      	//		
      	//	fin
      	
      sinon
      	BTN_IMPRIME..etat = grise
      	BTN_IMPRIME1PDF..etat = invisible
      	csDestination..etat = grise
      FIN
      
      
      
      
     type : 458752
   -
     name : ValideClientUnique
     procedure_id : 5249685577721916660
     type_code : 14
     code : |1+
      Procédure ValideClientUnique()
      i est un entier
      j est un entier
      lnumeroclient est une chaine
      pasmemeclient=faux
      si TableSelectOccurrence(ShippingBillTable) >= 1 alors
      	pour i = 1 a TableSelectOccurrence(ShippingBillTable)
      		//Table_Facture.datef[TableSelect(TABLE_FACTURE,i)] = csdDateFacture
      		AuMoinsUneFactureChoisie=vrai
      		si ShippingBillTable.tclient[TableSelect(ShippingBillTable,i)] <> lnumeroclient et pas lnumeroclient = "" alors
      			pasmemeclient = vrai
      		sinon
      			lnumeroclient = ShippingBillTable.tclient[TableSelect(ShippingBillTable,i)]	
      		FIN
      	FIN
      fin
      
      
      allumeboutonimpression(AuMoinsUneFactureChoisie,pasmemeclient)
      
      
      
      
     type : 458752
   -
     name : VerifieAdresse
     procedure_id : 5348667407935151831
     type_code : 14
     code : |1+
      Procédure VerifieAdresse(lnoclient=0)
      
      si HLitRecherche(client,numero,lnoclient) alors
      	si Client.cfacture = 2 _et_ (sansespace(client.ccourrielFacture[1]) <> "" ou  sansespace(client.ccourrielFacture[2]) <> "" ou sansespace(client.ccourrielFacture[3]) <> "" ...
      		ou sansespace(client.ccourrielFacture[4]) <> "") alors
      		csdestination[2]..etat = actif
      		BTN_IMPRIME1PDF..Etat = actif
      	sinon
      		SI  (SansEspace(Client.ccourrielFacture[1]) <> "" OU  SansEspace(Client.ccourrielFacture[2]) <> "" OU SansEspace(Client.ccourrielFacture[3]) <> "" ...
      			OU SansEspace(Client.ccourrielFacture[4]) <> "") ALORS
      			csDestination[2]..Etat = actif
      			BTN_IMPRIME1PDF..Etat = actif
      		sinon	
      			csdestination[2]..etat = grise
      			csDestination = 1
      			BTN_IMPRIME1PDF..etat = invisible
      		fin
      	FIN
      fin
      
     type : 458752
