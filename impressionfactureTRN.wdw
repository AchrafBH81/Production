           code : |1-
            dDateDébut 	est une Date
            dDateFin	est une Date
            sSuperChamp est une chaine = ""
            
            // Initialiser les deux dates à la date du jour
            dDateDébut = datesys()
            dDateFin = datesys()
            
            // Récupérer le nom du super champ
            sSuperChamp = ExtraitChaîne(ChampContextuel(), 1, ".")
            
            // Modifier le jour pour qu'il corresponde au premier jour du mois
            dDateDébut..jour = 1
            
            // Initialiser les deux champs date avec la date du jour
            executetraitement(sSuperChamp + ".InitialiserChampDate", trtprocédure, dDateDébut, dDateFin, sSuperChamp)
           type : 32
     -
       name : MenuMoisPrécédent
       identifier : 0x47fcf5443ca2b613
       internal_properties : 
       code_elements :
        type_code : 26
        p_codes :
         -
           code : |1-
            dDateDébut 	est une Date
            dDateFin	est une Date
            sSuperChamp est une chaine = ""
            
            // Initialiser les deux dates à la date du jour
            dDateDébut = datesys()
            dDateFin = datesys()
            
            // Récupérer le nom du super champ
            sSuperChamp = ExtraitChaîne(ChampContextuel(), 1, ".")
            
            // Modifier le jour et le mois pour qu'ils correspondent au jour courant et au mois précédent
            dDateDébut..jour = 1
            dDateDébut..mois--
            
            // Se placer à la fin du mois précédent
            dDateFin = dDateDébut
            dDateFin..mois++
            dDateFin..jour--
            
            // Initialiser les deux champs date avec la date du jour
            executetraitement(sSuperChamp + ".InitialiserChampDate", trtprocédure, dDateDébut, dDateFin, sSuperChamp)
           type : 32
