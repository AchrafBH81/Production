    name : LIB_SansNom1
    identifier : 0x2a5569ae388748ac
    internal_properties : 
    properties :
     x : 271
     y : 174
     width : 250
     height : 130
    type : 3
    code_elements :
     type_code : 2
     p_codes : []
  -
    name : BTN_SansNom1
    identifier : 0x2a556a163c6ddd26
    internal_properties : 
    properties :
     x : 469
     y : 198
     width : 30
     height : 30
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         batchPrint est une requête SQL = 
         [
         	select * from BonLivraison where BonLivraison.bdate = {pDatebatch} and bnumero >= {pNumero} and bfacture = 0 order by bnumero<§cs:3§>
         ]
         batchPrint.pDatebatch	= SAI_Batchdate
         batchPrint.pnumero		= SAI_FirstNumber = 0  ? null sinon sai_firstnumber
         si HExécuteRequêteSQL(batchPrint) alors
         	pour tout batchPrint
         		message("Impression du bon de livraison # "+ batchPrint.bnumero)
         		HExécuteRequête(ReqGroupShippingBill,hRequêteDéfaut,batchPrint.Bnumero)
         		iConfigure(SansEspace(imprimantebon),Vrai)
         		iParamètre("DEFAUT=NON")
         		//			iParamètre("COPIES="+lnbcopieBlivraison)
         		iParamètre("QUALITE=HAUTE")
         		
         		POUR i = 1 _a_ gclConfig.m_nNbcopieBlivraison
         			iEnchaînementAjoute(EGroupShippingBill)
         		FIN
         		iEnchaînementImprime()		
         		
         	FIN
         fIN 
         mafenetre..plan = 1
         
        type : 18
      -
        type : 161
        enabled : false
