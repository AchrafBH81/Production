      -
        code : |1+
         j est un entier
         
         restaure_bouton()
         
         
         
         
         	hlitrecherche(BonLivraison,Bnumero,ShippingBillTable.TBonLivraison[ShippingBillTable])
         
         	si htrouve(BonLivraison) alors
         
         		hexecuterequete(ReqGroupShippingBill,hRequêteDéfaut,BONLIVRAISON.BNUMERO)
         			iAperçu(i100, "Aperçu écran", Faux)
         			iParamètre("DEFAUT=NON")
         			//Nombre de copies à imprimer
         			//iParamètre("COPIES="+CONFIG.nbcopiefacture)
         			//		iimprimeetat(laFactureNovy,vrai,BONLIVRAISON.BNUMERO)
         			iimprimeetat(EGroupInvoice,vrai,BONLIVRAISON.BNUMERO)
         		multitache(50)
         	fin 
         
        type : 18
      -
        type : 161
        enabled : false
