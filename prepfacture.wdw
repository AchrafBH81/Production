  procedures :
   -
     name : activefiltre
     procedure_id : 4511921519466010612
     type_code : 14
     code : |1+
      Procédure activefiltre()
         hconvertl(cledebut,commande)
         hconvertl(clefin,commande)
         cledebut = cledebut+caract(0)
         clefin = clefin+caract(255)
         
         HFiltre(NomFicTab,"fdcle",cledebut,clefin)
         //EXECUTE("CLIENT..SOR")
      
     type : 458752
   -
     name : Activefiltreclient
     procedure_id : 4511921518682331144
     type_code : 14
     code : |1+
      Procédure Activefiltreclient(Nclient="")
         //hconvertl(cledebut,fa.faclient)
         //hconvertl(clefin,fa.faclient)
         tablesupprimetout("TABLELIEN")
         cledebut = HConstruitValClé(Facture,cleclientfacture,Nclient,caract(0))
         
         //cledebut = nclient+caract(0)
         si sansespace(Nclient) = "" alors
           clefin = cledebut
         
         sinon
      	clefin = HConstruitValClé(Facture,cleclientfacture,Nclient,caract(255))
      
          // clefin = nclient+caract(255)
         fin
         
         HFiltre("facture","cleclientfacture",cledebut,clefin)
        
         //execute("table..Len")
      
     type : 458752
   -
     name : maj_tablelien
     procedure_id : 4511921518284003346
     type_code : 14
     code : |1+
      Procédure maj_tablelien()
      j est un entier
      lNoRec est un entier
      lnocomm est un entier
      lnoligne est un entier
      
      pour j = 1 a tableoccurrence("TABLELIEN")
      	//    fdetail.fdqteafacturer = facturer
      	hlit(fdetail,enregistrement[j])
      	lnocomm=fdetail.fdnocomm
      	lnoligne = fdetail.fdligne
      	lNoRec= HSauvePosition(fdetail)
      	fdetail.fdqteafacturer=tablelien.FACTUREr[j]
      	si fdetail.fdqteafacturer <> fdetail.fdqte-fdetail.fdqtedejafacture alors
      		fdetail.SUrchargeafacturer = arrondi(fdetail.surchargeenergie * (fdetail.fdqteafacturer/fdetail.fdqte),2)
      	sinon
      		fdetail.SUrchargeafacturer = fdetail.surchargeenergie - fdetail.SUrchargedejafacture
      	fin
      	hmodifie(fdetail,hNumEnrEnCours)
      	pour tout fdetail avec "fdnocomm = "+lnocomm+ "et fdlien= "+lnoligne
      		fdetail.fdqteafacturer=tablelien.FACTUREr[j]
      		si fdetail.fdqteafacturer <> fdetail.fdqte-fdetail.fdqtedejafacture alors
      			fdetail.SUrchargeafacturer = arrondi(fdetail.surchargeenergie * (fdetail.fdqteafacturer/fdetail.fdqte),2)
      		sinon
      			fdetail.SUrchargeafacturer = fdetail.surchargeenergie - fdetail.SUrchargedejafacture
      		fin
      
      		hmodifie(fdetail,hNumEnrEnCours)
      	fin
      	HRetourPosition(lNoRec)	
      FIN
      
      
      
     type : 458752
   -
     name : maj_tablemaitre
     procedure_id : 4511921518393514012
     type_code : 14
     code : |1+
      Procédure maj_tablemaitre()
      j est un entier
      i est un entier
      numerofacture est un entier 
      lAdresseCourriel est une chaine
      sLNumeroClient est une chaine
      ListeFichier est une chaine
      lNomFichier est une chaine
      sListeNoFacture est une chaine
      lSujet est une chaine
      lMessage est une chaine 
      lIdLivraison est un entier = 0 
      lPremier est un booleen = vrai
      lNbCopieBlivraison est un entier
      
      si csDestination = 1 alors
      	lNbCopieBlivraison = gclconfig.m_nnbcopieBlivraison
      sinon
      	lNbCopieBlivraison = gclconfig.m_nNbCopieBlivraisonCourriel
      FIN
      si lNbCopieBlivraison = 0  alors
      	lNbCopieBlivraison = 1
      FIN
      pour j = 1 a TableOccurrence(TABLEMAITRE) 
      	si tablemaitre.CHOIX[j] alors
      		si lPremier alors
      			lIdLivraison = TABLEMAITRE.IdLivreA[j]
      			lPremier = faux
      		FIN
      		si tablemaitre.IdLivreA[j] <> lIdLivraison alors
      			acso_message("Erreur","Au moins une des commandes sélectionnées à une adresse de livraison différente"+rc+"Veuillez modifier votre sélection","Erreur")
      			reprisesaisie(tablemaitre)
      		fin
      	fin
      
      FIN
      si tableoccurrence(TABLEMAITRE) = 0 alors
      	renvoyer vrai
      FIN
      
      OuvreSoeur(FenAttentePetite,"Impression en cours .....................")
      hlit(config,1)
      numerofacture = config.numbl
      config.numbl++
      hmodifie(config,1)
      hraz(BonLivraison)
      pour j = 1 a tableoccurrence("TABLEMAITRE")
      	//    fdetail.fdqteafacturer = facturer
      
      	si tablemaitre.CHOIX[j] alors
      		epurefacture(menregistrement[j],numerofacture)
      		//    Facture.fabonlivraison = numbon[j]
      		//Code WinDev 5.5 remplacé par la migration :
      		//	hecrit("facture",menregistrement[j])
      		//	hecrit("facture",menregistrement[j],hForceIdAuto)
      	fin
      FIN
      bonlivraison.Bclient = hfacture.faclient
      bonlivraison.bdate = prepfacture.DATEFACTURE
      bonlivraison.Bnumero = numerofacture
      bonlivraison.bstotal = hfacture.fatotal
      bonlivraison.btvh = hfacture.fatps
      //bonlivraison.bTauxTvh = config.tauxtps
      //bonlivraison.bTauxTvq = config.tauxtvq
      BonLivraison.bTauxTvh = hfacture.fatps
      BonLivraison.bTauxTvq = hfacture.fatvq
      si hfacture.fatps = 0 ou hfacture.fatvq=0 alors
      	tableautaxe = trouvetauxtaxe(hfacture.faclient, prepfacture.DATEFACTURE)
      	SI Dimension(tableautaxe) >= 4 ALORS
      		BonLivraison.bTauxTvh = tableautaxe[1,2]
      	FIN
      	SI Dimension(tableautaxe) = 8 ALORS
      		BonLivraison.bTauxTvq = tableautaxe[2,2]
      		BonLivraison.bCalculTaux2sur1 = tableautaxe[2,4]
      	FIN
      sinon
      	BonLivraison.bTauxTvh = hfacture.fatps
      	BonLivraison.bTauxTvq = hfacture.fatvq
      
      FIN
      //BonLivraison.bTauxTaxe1 = hfacture.fatps
      //BonLivraison.bTauxTaxe2 = hfacture.fatvq
      BonLivraison.BidLivreA = hfacture.idlivraison
      bonlivraison.brien = numeriqueverschaine(hfacture.fatypedocument)
              BonLivraison.cvendeur = hfacture.cvendeur
      hajoute(BonLivraison)
      
      
      pour tout hfacture avec "bnumero = " + BonLivraison.Bnumero
      	pour tout Fcoutant avec "cNoCommande = "+ hfacture.fanumero
      		fcoutant.CdateLivraison = BonLivraison.bdate
      		fcoutant.CNoBlivraison = bonlivraison.bnumero
      		hmodifie(Fcoutant,hnumenrencours)
      	FIN
      	pour tout Fcoutantligne avec "cNoCommande = "+ hfacture.fanumero
      		fcoutantligne.CdateLivraison = BonLivraison.bdate
      		fcoutantligne.CNoBlivraison = bonlivraison.bnumero
      		hmodifie(Fcoutantligne,hnumenrencours)
      	FIN
      fin	
      
      
      si herreurdoublon() alors
      FIN
      hexecuterequete(RequeteBlEtat,hrequetedefaut,bonlivraison.bnumero)
      
      si csDestination =1 ou csDestination = 2 alors
      	iconfigure(sansespace(imprimantefacture),vrai)
      	iFenêtreAbandon(faux)
      	iParamètre("DEFAUT=NON")
      	//	iParamètre("COPIES="+config.nbcopieBlivraison)
      	iParamètre("COPIES="+lNbCopieBlivraison)
      	iParamètre("QUALITE=HAUTE")
      	iimprimeetat(BonLivraison)
      fin
      
      si csDestination =2  alors
      	FenAttentePetite.libelle1 = "Préparation du fichier PDF en cours ....."
      	iFenêtreAbandon(faux)
      	sablier(vrai)
      	multitache(100)
      	si HLitRecherche(client,numero,bonlivraison.Bclient) alors
      		pour i = 1 a 4
      			si sansespace(client.ccourrielBonLivraison[i]) <> "" alors
      				lAdresseCourriel += sansespace(client.ccourrielBonLivraison[i])+";"
      			fin
      		fin
      
      		si client.CLangue = 1 alors
      			lSujet = SANSESPACE(gclConfig.m_tabSujetFrancais[2]) //+" "+bonlivraison.Bnumero
      			lMessage = gclconfig.m_tabTexteFrancais[2]
      		sinon
      			lSujet = SANSESPACE(gclconfig.m_tabSujetanglais[2])//+" "+bonlivraison.Bnumero
      			lMessage = gclconfig.m_tabTexteanglais[2]
      		fin	
      	fin
      	pdfc>>cPrinterStop = 1
      
      	si frep(completerep(repdonnees)+"PDF\"+sansespace(bonlivraison.Bclient)+"\BonLivraison",frRépertoire) = "" alors
      		fRepCrée(completerep(repdonnees)+"PDF\"+sansespace(bonlivraison.Bclient)+"\BonLivraison")
      	fin
      	pdfc>>cOption("AutosaveDirectory") = completerep(repdonnees)+"PDF\"+sansespace(bonlivraison.Bclient)+"\BonLivraison"
      	i = 1
      	tantque fFichierExiste(pdfc>>cOption("AutosaveDirectory")+"\BdeL"+BonLivraison.bnumero+".pdf")
      		i++
      	fin
      	pdfc>>cOption("AutosaveFilename")  ="BdeL"+BonLivraison.bnumero
      
      	lNomFichier = pdfc>>cOption("AutosaveDirectory")+"\BdeL"+BonLivraison.bnumero+".pdf"+";"
      
      	iconfigure(sansespace(imprimantepdf),vrai)
      	iParamètre("DEFAUT=NON")
      	iParamètre("QUALITE=HAUTE")
      	iimprimeetat(BonLivraison)
      
      
      
      	tantque pas pdfc>>ccountofprintjobs() = 1
      	fin
      	pdfc>>cPrinterStop = 0
      	tantque pas pdfc>>ccountofprintjobs() = 0
      	fin
      	multitache(100)
      	sablier(faux)
      	pdfc>>cPrinterStop = 1
      	ListeFichier+=lNomFichier
      
      	ouvre(FenEmail,lAdresseCourriel,lSujet,lMessage,ListeFichier,client.numero)
      
      fin
      
      
      ferme(FenAttentePetite)
      
      
      //AttenteFinImpression("c:\document\novy\confirmation\bonlivraison.pdf")
      //multitache(10)
      //// Initialisation de la fonction Hasard() 
      //InitHasard()
      //
      //// Construction de la chaîne
      //sChaîneGénérée est une chaîne
      //nNombre est un entier
      //i est un entier
      //pour i=1 à 3
      //	// Génération aléatoire du caractère ASCII d'une lettre
      //	BOUCLE
      //		nNombre = Hasard(65,122)
      //		SELON nNombre
      //			CAS 91,92,93,94,95,96
      //				// Caractères situés entre les majuscules et les minuscules
      //			AUTRE CAS
      //				sortir
      //		FIN
      //	FIN
      //	// On construit la chaîne
      //	sChaîneGénérée+=Caract(nNombre)
      //FIN
      //
      
      //frenomme("c:\document\novy\confirmation\bonlivraison.pdf","c:\document\novy\confirmation\confirmation"+...
      //numeriqueverschaine(BonLivraison.Bnumero)+".pdf")
     type : 458752
   -
     name : remplirtablelien
     procedure_id : 4511921517460543546
     type_code : 14
     code : |1+
      Procédure remplirtablelien()
      
      hlitpremier("fdetail","fdcle")
      tablesupprimetout("TABLELIEN")
      //Code WinDev 5.5 remplacé par la migration :
      //tantque pas h.endehors 
      tantque pas HEnDehors() 
      
      si fdetail.ftype <> 4 alors
      //	tableajoute("TABLELIEN",...
      //	fdetail.fdnumprod+tab+fdetail.fddesc+tab+...
      //	numeriqueverschaine(fdetail.fdqte-fdetail.fdqtedejafacture)+tab+...
      //	numeriqueverschaine(fdetail.fdqteafacturer)+tab+h.numenr+tab+fdetail.fdligne)
      	tableajouteligne(TABLELIEN,...
      	fdetail.fdnumprod,fdetail.fddesc,fdetail.fdlargeura,fdetail.fdhauteura,fdetail.fdnumcarr,...
      	numeriqueverschaine(fdetail.fdqte-fdetail.fdqtedejafacture),...
      	numeriqueverschaine(fdetail.fdqte-fdetail.fdqtedejafacture),h.numenr,fdetail.fdligne,fdetail.surchargeenergie-fdetail.SUrchargedejafacture)
      fin
         hlitsuivant("fdetail","fdcle")
      FIN
      //Code WinDev 5.5 remplacé par la migration :
      //tabletri("ligne")
      TableTrie("ligne")
      hdesactivefiltre("fdetail")
      
     type : 458752
   -
     name : remplirtablemaitre
     procedure_id : 4511921519476561988
     type_code : 14
     code : |1+
      Procédure remplirtablemaitre()
      
      hlitpremier("Facture","cleclientfacture")
      
      tablesupprimetout("TABLEmaitre")
      //Code WinDev 5.5 remplacé par la migration :
      //tantque pas h.endehors 
      lFlag est un entier = 0 // pour faire apparaitre un flag si adresse différente
      
      tantque pas HEnDehors() 
      	si facture.fpreparation = "F" alors
      		si facture.idLivraison <> 0 alors
      			lFlag =1
      		sinon
      			lFlag = 0	
      		FIN
      		tableajouteligne(TABLEmaitre,faux,numeriqueverschaine(facture.fanumero),datefacture,...
      		facture.fanocommande,facture.fanojob,facture.fabonlivraison,h.numenr,facture.idLivraison,lFlag,facture.FDATEREQUISE)
      	fin 
      
      	hlitsuivant("Facture","cleclientfacture")
      FIN
      
      
      hdesactivefiltre("facture")
      tableaffiche("TABLEMAITRE",taDebut)
      
     type : 458752
   -
     name : majhistorique
     procedure_id : 4575427247635664481
     type_code : 14
     code : |1-
      Procédure majhistorique(numeroenregistrement,nocommande)
      hgereintegrite(faux)
      
      multiplicateur est un entier
      hlit(config,1)
      hlit("Facture",numeroenregistrement)
      si facture.fatypedocument  = 2 alors
      	multiplicateur = -1
      sinon
      	multiplicateur = 1	
      FIN
      hfacture.ftransfere      = faux
      hfacture.fanumero        = facture.fanumero
      hfacture.fadate          = facture.fdaterequise
      hfacture.fadatecommande  = facture.fadate
      hfacture.fatype          = facture.fatype
      hfacture.faclient        = facture.faclient
      hfacture.bnumero         = nocommande
      hfacture.fanofacture     = nocommande
      hfacture.fanojob         = facture.fanojob
      hfacture.fanocommande    = facture.fanocommande
      hfacture.fasecteur       = facture.fasecteur
      hfacture.facalcul        = facture.facalcul
      hfacture.fasurcharge     = facture.fasurcharge 
      hfacture.fatotal         = facture.fatotal     
      hfacture.fatps           = facture.fatps       
      hfacture.fatvq           = facture.fatvq   
      hfacture.fatypedocument  = Facture.fatypedocument
      hfacture.fareference     = Facture.fareference
      hfacture.fabonlivraison  = facture.fabonlivraison
      hfacture.NoLot           = facture.nolot
      hfacture.fafraistransport= Facture.fafraistransport * multiplicateur
      hfacture.fsurchargepeinture = facture.fsurchargepeinture
      hfacture.NoGlSurchargePeinture = facture.NoGlSurchargePeinture
      hfacture.idlivraison        = facture.idLivraison
      hfacture.SUrchargePeinture = facture.SUrchargePeinture
      hfacture.fpeinture = facture.fpeinture
      hfacture.idlivraison = facture.idLivraison
      hfacture.nom 			 = facture.nom
      hfacture.adresse		 = facture.adresse
      hfacture.Ville 			 = facture.ville
      hfacture.CodePostal		 = facture.CodePostal
      hfacture.noTelephone	 = facture.noTelephone
      hfacture.ftypecredit     = facture.Ftypecredit
      hfacture.cvendeur        = facture.cvendeur
      hfacture.lnom 			 = facture.lNom
      hfacture.lRue 			 = facture.lRue
      hfacture.lVille 		 = facture.lVille
      hfacture.lcodepostal 	 = facture.lCodePostal
      hfacture.lAdresseManuelle=facture.lAdresseManuelle
      hfacture.lnote            = facture.lnote
      hfacture.IdPurchaseOrderEdi = facture.IdPurchaseOrderEdi
      hfacture.IdEdiKey           = facture.IdEdiKey
      hfacture.IDCamions    = facture.IDCamions
      //hfacture.surchargeTauxPourc = facture.surchargeTauxPourc
      SI gclconfig.m_bSUrchargeTauxActive alors
      	si hlitrecherche(client,numero,hfacture.faclient) _et_ Client.SUrchargeTaux ALORS
      		SI Client.CSurchargeTauxBase <> 0 ALORS
      			hfacture.surchargeTauxPourc = Client.CSurchargeTauxBase
      		SINON
      			hfacture.surchargeTauxPourc = gclconfig.m_rSurChargeTauxBase
      		FIN	
      	SINON
      			hfacture.surchargeTauxPourc = 0
      	FIN
      fin
      hajoute("hfacture")
      //Code WinDev 5.5 remplacé par la migration :
      //si hdoublon() alors
      si HErreurDoublon() alors
      	erreur("Impossible d'ajouter la facture "+numeriqueverschaine(facture.fanofacture,"10d"))
      	renvoyer vrai
      FIN
      
      
      hlitrecherche("fdetail","fdnocomm",facture.fanumero)
      
      //Code WinDev 5.5 remplacé par la migration :
      //tantque fdetail.fdnocomm = facture.fanumero et pas h.endehors
      tantque fdetail.fdnocomm = facture.fanumero et pas HEnDehors()
      	si fdetail.fdqteafacturer <> 0 alors  
      		hfdetail.fdnocomm       = facture.fanumero
      		hfdetail.fdligne        = fdetail.fdligne
      		hfdetail.fdnumprod      = fdetail.fdnumprod
      		hfdetail.fddesc         = fdetail.fddesc
      		hfdetail.fdqte          = fdetail.fdqte
      		hfdetail.fdqteafacturer = fdetail.fdqteafacturer  * multiplicateur
      		hfdetail.fdqtedejafacture = fdetail.fdqtedejafacture  * multiplicateur
      		
      		hfdetail.fdespace       = fdetail.fdespace
      		hfdetail.fdlargeur      = fdetail.fdlargeur
      		hfdetail.fdhauteur      = fdetail.fdhauteur
      		hfdetail.fdhauteur1     = fdetail.fdhauteur1
      		hfdetail.fdlargeura     = fdetail.fdlargeura
      		hfdetail.fdhauteura     = fdetail.fdhauteura
      		hfdetail.fdhauteur1a    = fdetail.fdhauteur1a
      		hfdetail.fdprixu        = fdetail.fdprixu
      		hfdetail.fdcarrelage    = fdetail.fdcarrelage
      		hfdetail.fdcarreauh     = fdetail.fdcarreauh
      		hfdetail.fdcarreauv     = fdetail.fdcarreauv
      		hfdetail.fdnumcarr      = fdetail.fdnumcarr
      		hfdetail.ftype          = fdetail.ftype
      		hfdetail.fdprixtotal    = fdetail.fdprixtotal
      		hfdetail.fdcarrpruxuc   = fdetail.fdcarrpruxuc
      		hfdetail.frcarrprixu    = fdetail.frcarrprixu * multiplicateur
      		hfdetail.fdcarrprixtotal= fdetail.fdcarrprixtotal * multiplicateur
      		hfdetail.fdprixupied    = fdetail.fdprixupied
      		hfdetail.fdcodegl       = fdetail.fdcodegl
      		hfdetail.fcapgaztube    = fdetail.fcapgaztube 
      		hfdetail.fdverreunite   = fdetail.fdverreunite
      		hfdetail.fdnofact       = nocommande
      		hfdetail.FDJOBLIGNE      = fdetail.FDJOBLIGNE
      		hfdetail.fdcomposant1    =fdetail.fdcomposant1
      		hfdetail.fdcomposant2    =fdetail.fdcomposant2
      		hfdetail.fdcomposant3    =fdetail.fdcomposant3
      		hfdetail.fdcarrprixdebase=fdetail.fdcarrprixdebase * multiplicateur
      		hfdetail.surchargeenergie=fdetail.surchargeenergie  * multiplicateur
      		hfdetail.fdcommentaire   = fdetail.fdcommentaire
      		hfdetail.fdlargeuru      = fdetail.fdlargeuru
      		hfdetail.fdhauteuru      = fdetail.fdhauteuru
      		hfdetail.fdforme         = fdetail.fdforme
      		hfdetail.fdextraforme    = fdetail.fdextraforme //* MULTIPLICATEUR
      		hfdetail.HFCLEUNIK       = hfacture.HFCLEUNIK
      		hfdetail.ffini           = fdetail.ffini 
      		hfdetail.fdhauteuranglais=Fdetail.fdhauteuranglais
      		hfdetail.fdhauteuranglais1=Fdetail.fdhauteuranglais1
      		
      		hfdetail.fdlargeuranglais=fdetail.fdlargeuranglais
      		hfdetail.fdpiedcarre     = fdetail.fdpiedcarre
      		hfdetail.fdpiedcarrefacture=fdetail.fdpiedcarrefacture
      		hfdetail.ftypespacer       = fdetail.ftypespacer
      		hfdetail.FDespace2         = fdetail.FDespace2
      		hfdetail.fdprixupiedfacture=fdetail.fdprixupiedfacture
      		hfdetail.fdextracap       = fdetail.fdextracap //* MULTIPLICATEUR 
      		hfdetail.fnotes           = fdetail.fnotes
      		hfdetail.fnotes1           = fdetail.fnotes1
      		hfdetail.fdvariablex       = fdetail.fdvariablex
      		hfdetail.fdvariablex1       = fdetail.fdvariablex1
      		hfdetail.fdtypecalcul     = fdetail.fdtypecalcul
      		hfdetail.fdnbcarreau       = fdetail.fdnbcarreau
      		hfdetail.fTypePeinture         = fdetail.fTypePeinture
      		hfdetail.fNoPeintureExtTout     = fdetail.fNoPeintureExtTout
      		hfdetail.FnopeintureInterieure     = fdetail.FnopeintureInterieure
      		hfdetail.fdescpeintureExtTout    = fdetail.fdescpeintureExtTout
      		hfdetail.fDescPeintureInterieure    = fdetail.fDescPeintureInterieure
      		hfdetail.fTotalPeinture             = fdetail.fTotalPeinture
      		hfdetail.fPrixCarreauPeinture      = fdetail.fPrixCarreauPeinture
      		hfdetail.Ftotalcarreaupeinture     = fdetail.Ftotalcarreaupeinture
      		hfdetail.fpeinture                  = fdetail.fpeinture
      		hfdetail.libelleNbCarreauExtTlt     = fdetail.libelleNbCarreauExtTlt
      		hfdetail.libelleNbcarreauinterieur     = fdetail.libelleNbcarreauinterieur
      		hfdetail.FtotalbarrePeinture     = fdetail.FtotalbarrePeinture
      		hfdetail.fnopeinture = fdetail.fnopeinture
      		hfdetail.fdescpeinture = fdetail.fdescpeinture
      		hfdetail.fextrapeinture = fdetail.fextrapeinture
      		hfdetail.fdescpeinture1 = fdetail.fdescpeinture1
      		hfdetail.fTypePeinture1     = fdetail.fTypePeinture1
      		hfdetail.fnopeinture1 = fdetail.fnopeinture1
      		hfdetail.FDnbcarreauPeinture1 = fdetail.FDnbcarreauPeinture1
      		hfdetail.fdprixcarreaupeinture1 = fdetail.fdprixcarreaupeinture1
      		hfdetail.fdfabrication = fdetail.FDfabrication
      		hfdetail.SUrchargeafacturer = fdetail.SUrchargeafacturer
      		hfdetail.surchargeenergie = fdetail.SUrchargeafacturer
      		hfdetail.SUrchargedejafacture = fdetail.SUrchargedejafacture
      		hfdetail.FDextra10X=fdetail.FDextra10x
      		hfdetail.FDextra5X=fdetail.FDextra5x
      		hfdetail.TDemiCarrelage = fdetail.TDemiCarrelage
      		hfdetail.FDextraCarrelagedemi = fdetail.FDextraCarrelagedemi
      		hfdetail.fdpiedcarrefacture = Fdetail.fdpiedcarrefacture
      		hfdetail.fdsurfacemodifie = fdetail.fdsurfacemodifie
