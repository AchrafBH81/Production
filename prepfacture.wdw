     x : 518
     y : 247
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         //si htransactiondebut("bonlivraisontrx.trx") alors
         i est un entier
         trouve est un booleen = faux
         lNoRecClient est un entier = HSauvePosition(client)
         
         pour i = 1 a TableOccurrence(TABLEMAITRE)
         	si TABLEMAITRE.CHOIX[i] alors trouve=vrai
         FIN
         si pas trouve alors retour
         
         
         maj_tablemaitre_une_facture()
         
         
         
         si iimpressionabandonnee alors
         	acso_message("Information","Impression abandonnée par l'utilisateur"+rc+"L'impression des bons de livraison est annulée","info")
         	//		htransactionannule()
         sinon
         	//		htransactionfin()	
         fin
         
         tablesupprimetout("TABLELIEN")
         tablesupprimetout("TABLEMAITRE")
         
         //nombreEnlevé est un entier = 0
         //nombreLignes est un entier = TableOccurrence(TABLEMAITRE)
         
         //pour i = 1 a nombreLignes
         //	si TABLEMAITRE.CHOIX[i - nombreEnlevé] alors
         //		tablesupprime("TABLEMAITRE",i- nombreEnlevé)
         //		nombreEnlevé = nombreEnlevé + 1
         //	FIN
         //FIN
         
         HRetourPosition(lNoRecClient)
         client.cBolqueLivraison = faux
         hmodifie(client,hNumEnrEnCours)
         hraz("client")
         raz()
         datefacture..etat = actif; datefacture..Visible=Vrai; DATEFACTURE=datedujour()
         reprisesaisie("datefacture")
         remplirtablelien()
        type : 18
      -
        type : 161
        enabled : false
