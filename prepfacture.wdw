    name : cstNoClient
    identifier : 0x3e9d90b76f0a5740
    internal_properties : 
    properties :
     x : 68
     y : 71
     width : 84
     height : 23
    type : 2
    code_elements :
     type_code : 3
     p_codes :
      -
        code : |1+
         valeurinitialec = moimeme
         //Code WinDev 5.5 remplacé par la migration :
         //btn_ok..etat = grisé
         btn_ok..etat = grisé; btn_ok..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         //btn_annule..etat = grisé
         btn_annule..etat = grisé; btn_annule..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         //btn_modifie..etat = grise
         btn_modifie..etat = grise; btn_modifie..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         //btn_sortie..etat = actif
         btn_sortie..etat = actif; btn_sortie..Visible=Vrai
         bouton1..etat = actif; bouton1..Visible=Vrai
         csDestination..etat = actif
         //Code WinDev 5.5 remplacé par la migration :
         //btn_client..etat = actif
         btn_client..etat = actif; btn_client..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         //btndatefacture..etat = actif
         btndatefacture..etat = actif; btndatefacture..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         //select_tout..etat = actif
         select_tout..etat = actif; select_tout..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         //deselect_tout..etat = actif
         deselect_tout..etat = actif; deselect_tout..Visible=Vrai
         
        type : 15
      -
        code : |1+
         si prepfacture.cstNoClient..modifie  ET PAS MOIMEME = "" alors
         
         	si	hlitrecherche(client,numero,moimeme) alors
         		si client.cBolqueLivraison alors
         			ACSO_message("Erreur","Ce client est  présentement en traitement de bon de livraison par un autre utilisateur" +rc+"réessayer plus tard","Erreur")
         			MOIMEME =""
         			NOM_CLIENT =""
         
         
         			reprisesaisie(datefacture)
         		sinon
         			client.cBolqueLivraison = vrai
         			HModifie(client,hNumEnrEnCours)
         		fin
         
         		si sansespace(client.ccourrielBonLivraison[1]) = "" et sansespace(client.ccourrielBonLivraison[2]) = "" et sansespace(client.ccourrielBonLivraison[3]) = "" ... 
         			et sansespace(client.ccourrielBonLivraison[4]) = "" alors
         			csDestination[2]..etat = grise
         		sinon
         //			si gimprimantepdfstatus alors
         				csDestination[2]..etat = actif
         				csDestination = 2
         //			sinon
         //				csDestination[2]..etat = grise
         //			fin
         
         		fin
         
         
         		fichierversecran(prepfacture,CLIENT)
         		activefiltreclient(MOIMEME)  
         		remplirtablemaitre()
         
         		//Code WinDev 5.5 remplacé par la migration :
         		//		tablemaitre..etat = actif
         		tablemaitre..etat = actif; tablemaitre..Visible=Vrai
         		//Code WinDev 5.5 remplacé par la migration :
         		//	    TABLEAFFICHE("TABLEmaitre","Init")
         
         		TABLEAFFICHE("TABLEmaitre",taDebut)
         
         		si pas tablemaitre..vide alors
         
         			//Code WinDev 5.5 remplacé par la migration :
         			//		 btn_ok..etat = actif
         			btn_ok..etat = actif; btn_ok..Visible=Vrai
         
         			//Code WinDev 5.5 remplacé par la migration :
         			//		 btn_annule..etat = actif
         			btn_annule..etat = actif; btn_annule..Visible=Vrai
         
         			//Code WinDev 5.5 remplacé par la migration :
         			//		 btn_modifie..etat = actif
         			btn_modifie..etat = actif; btn_modifie..Visible=Vrai
         
         			//Code WinDev 5.5 remplacé par la migration :
         			//		 btn_sortie..etat = grisé
         			btn_sortie..etat = GRISE; btn_sortie..Visible=Vrai
         
         			//Code WinDev 5.5 remplacé par la migration :
         			//         btn_client..etat = grisé
         			btn_client..etat = grisé; btn_client..Visible=Vrai
         			bouton1..etat = actif; bouton1..Visible=Vrai
         			//Code WinDev 5.5 remplacé par la migration :
         			//         btndatefacture..etat = grisé
         			btndatefacture..etat = grisé; btndatefacture..Visible=Vrai
         			bouton1..etat = actif; bouton1..Visible=Vrai
         			prepfacture.cstNoClient..etat = grisé
         			prepfacture.datefacture..etat = grise
         
         			reprisesaisie(TABLEMAITRE)
         		sinon
         			client.cBolqueLivraison = faux
         			HModifie(client,hNumEnrEnCours)
         			MOIMEME =""
         			NOM_CLIENT =""
         			acso_message("Erreur","Aucune facture pour ce client","Erreur")
         			reprisesaisie(datefacture)
         		fin
         		//reprisesaisie("client")
         	FIN
         sinon
         	si pas moimeme = ""
         		moimeme=""
         		ACSO_message("Erreur","Client inexistant","Erreur")
         		reprisesaisie(cstNoClient)
         	fin
         fin
         
        type : 16
      -
        type : 276
        enabled : false
      -
        type : 277
        enabled : false
      -
        type : 278
        enabled : false
      -
        type : 338
        enabled : false
      -
        type : 339
        enabled : false
