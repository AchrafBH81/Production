      		hfdetail.fnolot = fdetail.fnolot
      		hajoute("hfdetail")
      		
      		
      		
      	fin
      	hlitsuivant("fdetail","fdnocomm")
      	
      FIN
      
      hgereintegrité(vrai)
     type : 458752
   -
     name : maj_tablemaitre_une_facture
     procedure_id : 5148796663956548964
     type_code : 14
     code : |1-
      Procédure maj_tablemaitre_une_facture()
      j est un entier
      i est un entier
      numerofacture est un entier 
      lAdresseCourriel est une chaine
      sLNumeroClient est une chaine
      ListeFichier est une chaine
      sListeNoFacture est une chaine
      lSujet est une chaine
      lMessage est une chaine 
      lCommandeTransferee est une chaine
      lNbCopieBlivraison est un entier
      lnomfichier est une chaine
      lcombinetaxe est un booleen
      bOrderException est un booleen
      bOrderNoException est un booleen
      
      
      
      
      si tableoccurrence(TABLEMAITRE) = 0 alors
      	renvoyer vrai
      FIN
      //hlit(config,1)
      si csDestination = 1 alors
      	lNbCopieBlivraison = gclconfig.m_nnbcopieBlivraison
      sinon
      	lNbCopieBlivraison = gclconfig.m_nNbCopieBlivraisonCourriel
      FIN
      OuvreSoeur(FenAttentePetite)
      TablePosition(TABLEmaitre,1)
      tableselectplus(TABLEMAITRE,1)
      
      
      pour j = 1 a tableoccurrence(TABLEMAITRE)
      	si tablemaitre.CHOIX[j] alors
      		si j >= tableposition(TABLEmaitre)+TableOccurrence(TABLEmaitre,toVisible) alors
      			TablePosition(TABLEmaitre,j)
      		fin
      		CheckDimensionException(TABLEMAITRE.COMMANDE[j])
      		
      		
      		
      		BOUCLE
      			numerofacture	= GetNextShippingBillNumber()
      			SI numerofacture = 0 ALORS 
      				SI ACSO_message("Question","Impossible d'assigner un numéro de Bon de livraison"+RC+"Essayer de nouveau","OuiNon")=IDNO ALORS 
      					goto SortieSurErreur
      				FIN
      			SINON
      				SORTIR
      			FIN
      		FIN
      		
      		
      		//		numerofacture = TrouveProchainNumero()
      		//		si numerofacture = 0 alors goto SortieSurErreur
      		tablemaitre.NUMBON[j] = numerofacture
      		hraz(BonLivraison)
      		lcombinetaxe = epurefacturetrn(menregistrement[j],numerofacture)
      		
      		bonlivraison.Bclient = hfacture.faclient
      		bonlivraison.bdate = prepfacture.DATEFACTURE
      		bonlivraison.Bnumero = numerofacture
      		bonlivraison.Bcommandeclient = hfacture.fanocommande
      		bonlivraison.Bnocommande = hfacture.fanumero
      		bonlivraison.bstotal = hfacture.fatotal
      		bonlivraison.btvh = hfacture.fatps
      		BonLivraison.bTauxTvh = hfacture.fatps
      		BonLivraison.bTauxTvq = hfacture.fatvq
      		//		BonLivraison.bTauxTvh = config.tauxtps
      		//		BonLivraison.bTauxTvq = config.tauxtvq
      		
      		
      		SI hfacture.fatps = 0 OU hfacture.fatvq=0 ALORS
      			tableautaxe = trouvetauxtaxe(hfacture.faclient, prepfacture.DATEFACTURE)
      			SI Dimension(tableautaxe) >= 4 ALORS
      				BonLivraison.bTauxTaxe1 = tableautaxe[1,2]
      			FIN
      			SI Dimension(tableautaxe) = 8 ALORS
      				BonLivraison.bTauxTaxe2 = tableautaxe[2,2]
      				BonLivraison.bCalculTaux2sur1 = tableautaxe[2,4]
      			FIN
      		SINON
      			BonLivraison.bTauxTaxe1 = hfacture.fatps
      			BonLivraison.bTauxTaxe2 = hfacture.fatvq
      			BonLivraison.bCalculTaux2sur1 = lcombinetaxe
      		FIN
      		
      		
      		
      		
      		bonlivraison.brien = numeriqueverschaine(hfacture.fatypedocument)
      		
      		BonLivraison.cvendeur = hfacture.cvendeur
      		hajoute(BonLivraison)
      		
      		pour tout hfacture avec "bnumero = " + BonLivraison.Bnumero
      			pour tout Fcoutant avec "cNoCommande = "+ hfacture.fanumero
      				fcoutant.CdateLivraison = BonLivraison.bdate
      				fcoutant.CNoBlivraison = bonlivraison.bnumero
      				hmodifie(Fcoutant,hnumenrencours)
      			FIN
      			pour tout Fcoutantligne avec "cNoCommande = "+ hfacture.fanumero
      				fcoutantligne.CdateLivraison = BonLivraison.bdate
      				fcoutantligne.CNoBlivraison = bonlivraison.bnumero
      				hmodifie(Fcoutantligne,hnumenrencours)
      			FIN
      		fin	
      		
      		
      		si herreurdoublon() alors
      		FIN
      		hexecuterequete(RequeteBlEtat,hrequetedefaut,bonlivraison.bnumero)
      		
      		si csDestination =1 ou csDestination = 2 alors
      			iFenêtreAbandon(faux)
      			FenAttentePetite.libelle1 = "Impression du Bon de livraison "+BonLivraison.bnumero
      			multitache(50)
      			
      			iconfigure(sansespace(imprimantebon),vrai)
      			
      			iParamètre("DEFAUT=NON")
      			//			iParamètre("COPIES="+lnbcopieBlivraison)
      			iParamètre("QUALITE=HAUTE")
      			//			iimprimeetat(BonLivraisontrn)
      			iImprimeEtat(BonLivraisonMultiple,lNbCopieBlivraison,requetebletat.Abreviation)
      			tablemaitre.CHOIX[j] =3
      		fin
      		
      		si csDestination =2  alors
      			FenAttentePetite.libelle1 = "Préparation du fichier PDF en cours ....."
      			iFenêtreAbandon(faux)
      			sablier(vrai)
      			multitache(100)
      			si HLitRecherche(client,numero,bonlivraison.Bclient) alors
      				pour i = 1 a 4
      					si sansespace(client.ccourrielBonLivraison[i]) <> "" alors
      						lAdresseCourriel += sansespace(client.ccourrielBonLivraison[i])+";"
      					fin
      				fin
      				si client.CLangue = 1 alors
      					lSujet = SANSESPACE(gclconfig.m_tabSujetFrancais[2]) //+" "+bonlivraison.Bnumero
      					lMessage = gclconfig.m_tabTexteFrancais[2]
      				sinon
      					lSujet = SANSESPACE(gclconfig.m_tabSujetanglais[2])//+" "+bonlivraison.Bnumero
      					lMessage = gclconfig.m_tabTexteanglais[2]
      				fin	
      			fin
      			
      			lnomfichier = ComplèteRep(repdonnees)+"PDF\"+SansEspace(BonLivraison.Bclient)+"\BonLivraison\BdeL"+BonLivraison.bnumero+".pdf"
      			iConfigure(SansEspace(imprimantebon),Vrai)
      			iParamètre("DEFAUT=NON")
      			iParamètre("FORMATPAPIER=LETTRE")
      			iDestination(iPDFGénérique,lnomfichier)
      			iImprimeEtat(BonLivraisonTRN)
      			FenAttentePetite.libelle1="Préparation du fichier PDF BdeL"+BonLivraison.bnumero+" en cours..."
      			
      			tablemaitre.CHOIX[j] =2
      			
      			sablier(faux)
      			
      			ListeFichier+=lnomfichier+[";"]
      			
      		fin
      	fin
      	
      	
      	
      	
      	
      	
      	
      	
      FIN
      ferme(FenAttentePetite)
      si csDestination =2  alors
      	si ListeFichier <> ""
      		ouvre(FenEmail,lAdresseCourriel,lSujet+" #"+BonLivraison.Bnumero,lMessage,ListeFichier,client.numero,faux,3)
      	fin	
      fin
      
      goto SortieSansErreur
      
      // Se rend ici si on a pas été capable d,assigner un numéro de bon de livraison
      // Incapable de Bloquer le fichier config
      
      SortieSurErreur:
      si fenetat(FenAttentePetite) <> Inexistant alors Ferme(FenAttentePetite)
      
      SortieSansErreur:
      pour j = 1 a TableOccurrence(TABLEMAITRE)
      	si tablemaitre.CHOIX[j] alors
      		lCommandeTransferee+=TABLEMAITRE.COMMANDE[j]+tab+TABLEMAITRE.NUMBON[j]+rc
      	FIN
      FIN
     type : 458752
   -
     name : TrouveProchainNumero
     procedure_id : 5187262781630648629
     type_code : 14
     code : |1+
      Procédure TrouveProchainNumero()
      valeurarerourner est un entier = 0
      _continuer est un booleen
      
      
      boucle
      
      	hlitpremier(config,COCLEUNIK,HBlocageEcriture)
      
      	si HErreurBlocage() alors
      		si acso_message("Question","Impossible d'assigner un numéro de Bon de Livraison"+rc+"Le fichier de configuration est possiblement utilisé par un autre utilisateur"+rc+...
      			"Il devrait être disponible dans quelques secondes."+rc+"Essayer de nouveau","OuiNon")=idno alors 
      			_continuer = faux
      			sortir
      		fin
      	sinon
      		_continuer = vrai
      		sortir
      	fin
      fin
      //sinon
      
      si _continuer alors
      	boucle
      		valeurarerourner = config.numbl
      		config.numbl++
      		hmodifie(config,hNumEnrEnCours)
              HForceEcriture(config)
      		si pas hlitrecherche(BonLivraison,Bnumero,valeurarerourner) alors
      			sortir
      		fin
      
      	fin
      
      	hdebloquefichier(config)
      
      fin
      
      renvoyer valeurarerourner
      
     type : 458752
   -
     name : remplirtablemaitre1
     procedure_id : 5314973371751115237
     type_code : 14
     code : |1+
      Procédure remplirtablemaitre1()
      
      
      tablesupprimetout("TABLEmaitre")
      lFlag est un entier = 0 // pour faire apparaitre un flag si adresse différente
      
      pour tout facture avec "iDClient = "+client.IDClient 
      	si facture.fpreparation = "F" alors
      		si facture.idLivraison <> 0 alors
      			lFlag =1
      		sinon
      			lFlag = 0	
      		FIN
      		tableajouteligne(TABLEmaitre,faux,numeriqueverschaine(facture.fanumero),datefacture,...
      		facture.fanocommande,facture.fanojob,facture.fabonlivraison,h.numenr,facture.idLivraison,lFlag)
      	fin 
      
      
      FIN
      
      tabletrie("TABLEMAITRE.COMMANDE")
      tableaffiche("TABLEMAITRE",taDebut)
      tableselectplus(TABLEMAITRE,1)
      
     type : 458752
