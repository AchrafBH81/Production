  p_codes :
   -
     code : |1+
      
      // L'appel à cette fenêtre est du type:
      //       OUVRE(nom_fen)
      //si gimprimantepdfstatus alors
      //	BtnPdfStatusVert..visible = vrai
      //	BtnPdfStatusrouge..visible = faux
      //sinon
      //	BtnPdfStatusVert..visible = faux
      //	BtnPdfStatusrouge..visible = vrai
      //FIN
      
      MoiMême..Visible=Vrai
      
      Global
      	CleParcours		est une chaine		// Nom de la clé de parcours
      	NomFic			est une chaine		// Nom du fichier associé à la fenêtre
      	NomFicTab		est une chaine		// Nom du fichier associé à la table
      	CleLiaison		est une chaine		// Nom de la clé de liaison fiche/table
      	//Clefiltre est une chaine
      	cledebut est une chaine                 // clé pour filtre d'affichage des lignes
      	clefin est une chaine                   // de commande
      	modifie_date est un booleen = faux
      NomFic="Facture"
      NomFicTab="fdetail"
      CleLiaison="fdcle"
      //clefiltre = "fdnocomm"
      
      CleParcours="cleclientfacture"					// Clé de parcours par défaut
      //numeroevenement[1] = evenement("DOUBLECLIC","btn_client",WM_LBUTTONDBLCLK)
      
      // Indique que le fichier est en cours de modification
      //ConfigureImprimantePDF()
      //AjouteFichierUtilise("FA")
      chargeimage(1,maitre.FichierImage,1,13)
      
      //ListeAjoute("choix",gImage("MarquTab.ICO"))
      //ListeAjoute("choix",gImage("iconepdf16.bmp"))
      //ListeAjoute("choix",gImage("print.ICO"))
      ListeAjoute("choix",gImage(1,7))
      ListeAjoute("choix",gImage(1,8))
      ListeAjoute("choix",gImage(1,9))
      EcranPremier("datefacture")	// Se place sur la table
      activefiltreclient("")
      remplirtablemaitre()
      activefiltre()
      datefacture = datesys()
      si gFormatFacture = 1 alors
      	tablemaitre.NUMBON..visible=faux
      	tablemaitre.FlagIdLivDifferent..visible = vrai
      	listeajoute(FlagIdLivDifferent,gImage(1,4))
      	TABLEMAITRE..largeur = tablemaitre..LargeurInitiale-39
      FIN
   -
     type : 180
     enabled : false
   -
     type : 230
     enabled : false
   -
     code : |1-
      
      // Indique que le fichier courant n'est plus en cours de modification
      
      BOUCLE
      	HDesactiveFiltre(NomFicTab)	// Désactive le filtre associé à la table
      	//Code WinDev 5.5 remplacé par la migration :
      	//	si pas hDejaBloque() alors sortir
      	si pas HErreurBlocage() alors sortir
      FIN
      FINEVENEMENT(NUMEROEVENEMENT[1])
      
      si sansespace(prepfacture.cstNoClient) <> "" alors
      	si hlitrecherche(client,numero,cstNoClient) alors
      		client.cBolqueLivraison = faux
      		hmodifie(client,hNumEnrEnCours)
      	fin
      FIN
      //si gImprimantePdfStatus alors
      //	OuvreSoeur(FenAttentePetite,"Fermeture de l'imprimante PDF virtuelle en cours ......")
      //	pdfc>>cOption("AutosaveFilename") = "Fichier"
      //	killprocess("PDFCreator.exe")
      //	multitache(50)
      //	liberer pdfc
      //	ferme(FenAttentePetite)
      //fin
     type : 2
