  -
    name : BTN_ANNULE
    identifier : 0x3e9d90b716e4570e
    internal_properties : 
    properties :
     x : 518
     y : 169
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         lNoRec est un entier
         j est un entier
         lnocomm est un entier
         lnoligne est un entier
         
         pour j = 1 a tableoccurrence("TABLELIEN")
         	//    fdetail.fdqteafacturer = facturer
         	hlit(fdetail,enregistrement[j])
         	lnocomm=fdetail.fdnocomm
         	lnoligne = fdetail.fdligne
         	lNoRec= HSauvePosition(fdetail)
         	fdetail.fdqteafacturer=tablelien.QUANTITE[j]
         	hmodifie(fdetail,hNumEnrEnCours)
         
         	pour tout fdetail avec "fdnocomm = "+lnocomm+ "et fdlien= "+lnoligne
         		fdetail.fdqteafacturer=tablelien.QUANTITE[j]
         		hmodifie(fdetail,hNumEnrEnCours)
         	fin
             HRetourPosition(lNoRec)
         fin
         
         
         
         client.cBolqueLivraison = faux
         hmodifie(client,hNumEnrEnCours)
         restaure_bouton()
         tablesupprimetout("TABLELIEN")
         tablesupprimetout("TABLEMAITRE")
         hraz("client")
         raz()
         datefacture..etat = actif; datefacture..Visible=Vrai; DATEFACTURE=datedujour()
         reprisesaisie("datefacture")
         
        type : 18
      -
        type : 161
        enabled : false
