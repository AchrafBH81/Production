  procedures :
   -
     name : ajouterligne
     procedure_id : 4511921684906307786
     type_code : 14
     code : |1+
      Procédure ajouterligne(source = "requetebletat")
      nomclient est une chaine
      hlitrecherche("client","numero",{source+".faclient"})
      //Code WinDev 5.5 remplacé par la migration :
      //si h.trouve alors
      si HTrouve() alors
      	nomclient = client.nom
      sinon
      	nomclient = "Client inexistant"	
      FIN
      tableajoute("TABLERESULTAT",""+tab+{source+".fanumero"}+tab+{source+".bfacture"}+tab+...)
                  {source+".bdate"}+tab+{source+".faclient"}+tab+nomclient+tab+...
      {source+".fanocommande"}+tab+{source+".fanojob"}+tab+{source+".bnumero"})
      
     type : 458752
   -
     name : ajouterlignedetail
     procedure_id : 4511921686232428766
     type_code : 14
     code : |1+
      Procédure ajouterlignedetail(source1 = "hfdetail",source = "hfacture")
      nomclient est une chaine
      hlitrecherche(source,"fanofacture",{source1+".fdnofact"})
      //Code WinDev 5.5 remplacé par la migration :
      //si pas h.trouve alors
      si pas HTrouve() alors
      	renvoyer vrai
      FIN
      
      hlitrecherche("client","numero",{source+".faclient"})
      //Code WinDev 5.5 remplacé par la migration :
      //si h.trouve alors
      si HTrouve() alors
      	nomclient = client.nom
      sinon
      	nomclient = "Client inexistant"	
      FIN
      tableajoute("TABLERESULTAT",{source+".fanumero"}+tab+{source+".fanofacture"}+tab+...
                  {source+".fadate"}+tab+{source+".faclient"}+tab+nomclient+tab+...
      			{source+".fanocommande"}+tab+{source+".fanojob"})
      
     type : 458752
