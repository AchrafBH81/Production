  -
    name : BTN_RECHERCHE_1
    identifier : 0x3e9d90de1d16efb2
    internal_properties : 
    properties :
     x : 472
     y : 90
     width : 18
     height : 15
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         larequete est une source de donnees
         //valeurarechercher est une chaine
         //hconvertd(valeurarechercher,moimeme)
         sablier(vrai)
         tablesupprimetout("TABLERESULTAT")
         hlitrecherche("hfacture","fanumero",recherche.numcommande)
         hexecuterequete(RequeteRechercheNoCommande,hRequêteDéfaut,recherche.NUMCOMMANDE)
         //HExécuteRequête(RequeteRechercheNoCommandeFacture,hRequêteDéfaut)
         
         //hlitpremier(RequeteRechercheNoCommandeFacture)
         //tantque pas HEnDehors()
         //	ajouterligne("requeterechercheNoCommandefacture")
         //	hlitsuivant(RequeteRechercheNoCommandeFacture)
         //FIN
         
         
         
         HExécuteRequêteSQL(larequete,"SELECT DISTINCT  IDBonLivraison,"+...
         "Bnumero,"+...
         "Bdate,"+...
         "Bclient,"+...
         "Bfacture,"+...
         "BDateFacture,"+...
         "BStotal,"+...
         "BTVH,"+...
         "Btransfere,"+...
         "fanumero,"+...
         "faclient,"+...
         "fanocommande,"+...
         "fasecteur,"+...
         "fanojob "+...
         "FROM RequeteRecherchenocommande")
         
         
         hlitpremier(larequete)
         tantque pas HEnDehors()
         	ajouterligne("larequete")
         	hlitsuivant(larequete)
         FIN
         
         
         //hlitpremier(RequeteRecherche)
         ////Code WinDev 5.5 remplacé par la migration :
         ////tantque recherche.numcommande = hfacture.fanumero et pas h.endehors
         //tantque  pas HEnDehors()
         //	ajouterligne("requeterecherche")
         //	hlitsuivant(RequeteRecherche)
         //FIN
         //Code WinDev 5.5 remplacé par la migration :
         //tableaffiche("TABLERESULTAT","I")
         tableaffiche("TABLERESULTAT",taDebut)
         sablier(faux)
         
         reprisesaisie(TABLERESULTAT)
        type : 18
      -
        type : 161
        enabled : false
