    properties :
     y : 1.25
     width : 335.6
     height : 37.2
    code_elements :
     type_code : 30
     p_codes :
      -
        code : |1+
         j est un entier
         jj est une chaine
         pour j = 1 a 12
         	jj = sansespace(numeriqueverschaine(j))
             {"mois"+jj} = entierversmoisenlettre(dateversentier(dateverschaine(config.canneeencoursdebut,"AAAA")+...
                 ajoutezero(numeriqueverschaine(moisdebut+j-1))+"01"))
         
         FIN
         //bloc_corps..VISIBLE = FAUX
         si pas sautdepage alors
         //Code WinDev 5.5 remplacé par la migration :
         //	bloc_frpt2..VISIBLE = FAUX
         	bloc_frpt2..Visible=Faux
         FIN
         anciensecteur = hfacture.fasecteur
         
        type : 327692
      -
        type : 327697
        enabled : false
