     -
       name : LESECTEUR
       identifier : 0x3e9d90fa74355bf0
       internal_properties : 
       properties :
        x : 23.6
        y : 17.3
        width : 66.
        height : 5.
       code_elements :
        type_code : 29
        p_codes :
         -
           code : |1+
            hlitrecherche("secteur","secteur",sansespace(numeriqueverschaine(hfacture.fasecteur)))
            
            si pas sautdepage alors
            	lesecteur = "Tous"
            sinon
            	
            //Code WinDev 5.5 remplacé par la migration :
            //si h.trouve alors
            si HTrouve() alors
            	lesecteur = sansespace(secteur.sdescription)
            FIN
            
            si anciensecteur = hfacture.fasecteur alors
            	lesecteur += " (Suite...)"
            FIN
            fin
            
