  -
    name : BLOC_CORPS
    identifier : 0x3e9d90fa32425bb4
    internal_properties : CQAAAAkAAACkoLxBZnTmkWWVJlX/eg51imPeQTJR05la+G8u2pWwhCt661oICncnGbq+SLKT9pMZRXKAG8HsOSwxVTrmJN2tumGVKSJASqmRLCry2gFt0d9nZ8YSEC7UsjZnPUBFnCIV/dp82AMj2tL3zI62Vv5kO3XeVYj3G3ZUAde8f3dNLPSc92w8vEIYGqyR3aE7SCKeQbTlC31M73b6Ld0WioOSpV/Qkxdyy58HjuQcieVlrcopoyj7B6UI4pWJMabG6F1wPbNcY9Ff7e6Bze8HgA==
    properties :
     y : 40.95
     width : 335.6
     height : 1.25
    code_elements :
     type_code : 30
     p_codes :
      -
        code : |1+
         j est un entier
         jj est une chaine
         jjj est un entier
         //pour j = 1 a 12
         SI PAS SANSESPACE(HFACTURE.FADATE) = "" ALORS
         j = val(dateverschaine(hfacture.fadate,"MM")) - moisdebut  
         si j < 0 alors
         	j = j+13
         FIN
         si j=0 alors
         	j = 1
         FIN
         pour jjj = 1 a 12
             si j = jjj alors
         		jj = sansespace(numeriqueverschaine(j))
         		
         	    {"totalclient"+jj} += hfacture.fatotal
         	    {"totalsecteur"+jj} += hfacture.fatotal
         	    {"toussecteur"+jj} += hfacture.fatotal
         	//	{"total"+jj} = hfacture.fatotal
         	sinon
         		jj = sansespace(numeriqueverschaine(jjj))
         	    {"totalclient"+jj} += 0.00
         	    {"totalsecteur"+jj} += 0.00
         	    {"toussecteur"+jj} += 0.00
         	//	{"total"+jj} = 0.00
         		
         	fin
         	//{"totalclient"+jj} += {"total"+jj}
         	//{"totalsecteur"+jj} += {"total"+jj}
         	
         FIN
         FIN
         
        type : 327692
      -
        type : 327697
        enabled : false
