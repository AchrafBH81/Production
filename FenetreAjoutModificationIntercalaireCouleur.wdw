 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1+
      procedure FenetreAjoutModificationIntercalaireCouleur(_Titre = "",_type = "A")
      
      policetexte est un police
      mafenetre..titre += " ( "+sansespace(_titre) + " )"
      
      //varinter1..libelle = DescriptionVarInter1
      //varinter2..libelle = DescriptionVarInter2
      //varinter3..libelle = DescriptionVarInter3
      //varinter4..libelle = DescriptionVarInter4
      //varinter5..libelle = DescriptionVarInter5
      
   -
     code : |1+
      si _type = "M" alors
      	fichierversecran(FenetreAjoutModificationIntercalaireCouleur,IntercalaireCouleurs)
      	couleurfond..couleur		= couleurfond
      	couleurfond..CouleurFond	= couleurfond
      	couleurtexte..couleur		= couleurtexte
      	couleurtexte..CouleurFond	= couleurtexte
      	creepolice(InterrupteurGras,InterrupteurItalique)
      	libelletexte..police		= policetexte
      	libelletexte..couleur		= couleurtexte
      	libelletexte..couleurfond	= couleurfond
      sinon
         INT_IsActive = vrai
      FIN
      
      
     type : 34
   -
     type : 180
     enabled : false
   -
     type : 230
     enabled : false
   -
     code : |1+
      EcranVersFichier(FenetreAjoutModificationIntercalaireCouleur,IntercalaireCouleurs)
      si _type = "M" alors
      	hmodifie(IntercalaireCouleurs,hNumEnrEnCours)
      sinon
      	IntercalaireCouleurs.idIntercalaires = Intercalaires.IDIntercalaires
      	hajoute(IntercalaireCouleurs)
      fin 
      
      
     type : 2
   -
     type : 11
   -
     type : 12
   -
     type : 17
   -
     type : 13
  procedures :
   -
     name : CreePolice
     procedure_id : 5858556415165642139
     type_code : 14
     code : |1+
      
      Procédure CreePolice(lintgras=faux,lintitalique=faux,ltype = "MS Sans Serif",lpitch=10)
      
      lattribut est un entier
      si lintgras alors
      	lattribut +=igras
      FIN
      si lintitalique alors
      	lattribut +=iItalique
      FIN
      
      policetexte = policecree(ltype,lpitch,lattribut)
      
     type : 458752
  procedure_templates : []
  property_templates : []
