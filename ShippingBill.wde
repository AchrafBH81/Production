 controls : []
 code_elements :
  type_code : 13
  p_codes :
   -
     code : |1-
      function ShippingBill(_nbCopies = 1,gsCamion est une chaine = "")
      
      
      
      SELON Client.CLangue
      	CAS 0,1
      		SI HLitRecherche(Traduction,trecherche,"facrecupar") ALORS
      			ShippingBill.Facrecupar = Traduction.dfrancais
      		FIN
      	cas 2
      		SI HLitRecherche(Traduction,trecherche,"facrecupar") ALORS
      			ShippingBill.Facrecupar = Traduction.danglais
      		FIN
      fin
      
      SI Client.IDHeuresOuverture <> 0 ALORS
      	SI HLitRecherche(HeuresOuverture,IDHeuresOuverture,Client.IDHeuresOuverture) ALORS
      		SELON Client.CLangue
      			CAS 0,1
      				SI HLitRecherche(Traduction,trecherche,"libheureouverture") ALORS
      					LibHeureOuverture = Traduction.dfrancais + " " + HeuresOuverture.HODescription
      				FIN
      			CAS 2
      				SI HLitRecherche(Traduction,trecherche,"libheureouverture") ALORS
      					LibHeureOuverture = Traduction.danglais + " " + HeuresOuverture.HODescription
      				FIN
      		FIN		
      		//		LibHeureOuverture = "Heures d'ouverture :"+ HeuresOuverture.HODescription
      	FIN
      FIN
      
      //SI Client.IDHeuresOuverture <> 0 ALORS
      //	SI HLitRecherche(HeuresOuverture,IDHeuresOuverture,Client.IDHeuresOuverture) ALORS
      //		LibHeureOuverture = "Heures d'ouverture :"+ HeuresOuverture.HODescription
      //	FIN
      //FIN
     type : 327680
   -
     code : |1-
      
     type : 327695
