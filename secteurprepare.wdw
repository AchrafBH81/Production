      -
        code : |1+
         j est un entier
         
         pour j = 1 a 25
         //	info( sansespace(infoprep.ipsecteur[j]  ))
         	si pas sansespace(infoprep.ipsecteur[j]  ) = "" alors
         			listeajoute("LISTEPREP",infoprep.ipsecteur[j])
         	sinon
         		sortir	
         	FIN
         	
         FIN
         
