  type_code : 1
  p_codes :
   -
     code : |1+
      
      
      TabEpaisseur est un tableau d'entiers
      MoiMême..Visible=Vrai
      hlitpremier("infoprep","I1CLEUNIK")
      fichierversecran()
      
   -
     code : |1+
      saiCamions = infoprep.IpCamion
      IntOptions[1] = infoprep.ipCarrelage
      IntOptions[2] = infoprep.ipForme
      IntOptions[3] = infoprep.ipproduitSpeciaux
      chaineverstableau(infoprep.ipEpaisseur,TabEpaisseur,",")
      pour chaque epaisseur de TabEpaisseur
      	si epaisseur >= 3 alors
      		IntEpaisseur[epaisseur-2]= vrai
      	fin
      FIN
      
      
