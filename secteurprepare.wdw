  -
    name : ECRASER
    identifier : 0x3e9d90c0332179d5
    internal_properties : 
    properties :
     x : 343
     y : 255
     width : 80
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         //Code WinDev 5.5 remplacé par la migration :
         //hlitpremierbloque("infoprep","I1CLEUNIK")
         hlitpremier("infoprep","I1CLEUNIK",HBlocageEcriture)
         //Code WinDev 5.5 remplacé par la migration :
         //si hdejabloque() alors
         si HErreurBlocage() alors
         	erreur("Information en utilisation")
         sinon		
            hexecuterequete(RequeteSecteurPrepare,hModifieFichier)
         //    hfiltre("facture","fpreparation = 'T'")
         //Code WinDev 5.5 remplacé par la migration :
         //	hlitpremierbloque("Facture","FACLEUNIK")
         //	hlitpremier("Facture","FACLEUNIK",HBlocageEcriture)
         hlitpremier(RequeteSecteurPrepare)
         //Code WinDev 5.5 remplacé par la migration :
         //	tantque pas h.endehors 
         	tantque pas HEnDehors(RequeteSecteurPrepare) 
         	    RequeteSecteurPrepare.fpreparation = " "
         	    RequeteSecteurPrepare.FImprimeFeuille = faux
         		hmodifie(RequeteSecteurPrepare)
         	    majlogmanuel(RequeteSecteurPrepare.fanumero,RequeteSecteurPrepare.FPREPARATION)
         //Code WinDev 5.5 remplacé par la migration :
         //	    hlitsuivantbloque("Facture","FACLEUNIK")
         	    hlitsuivant(RequeteSecteurPrepare)
             fin
         //	hdesactivefiltre("Facture")
             preparation.btn_preparation..etat = actif
             preparation.btn_choix..etat = grisé
             preparation.information..etat = grisé
         	preparation.btn_prepare..etat = actif
         //    houvre("tempo")
             
         supprimetempo()
         hlitpremier("infoprep","I1CLEUNIK")
         infoprep.ipdate = ""
         hmodifie("infoprep")	
         fin
         	ferme
         
        type : 18
      -
        type : 161
        enabled : false
