  type_code : 1
  p_codes :
   -
     code : |1-
      procedure modificationprixClientTous(TypeModif = "Thermos",NoClient = "",IdClient=0)
      // Pour compatibilité 5.5
      si noclient = "" alors
      	moimeme..titre += "(Tous les clients)"
      sinon
      	moimeme..titre += "("+sansespace(client.nom)+")"
      FIN
      MoiMême..Visible=Vrai
      
      
      global
      	
      totalcategorie est une chaine
      totalcatadditionnel est une chaine
      totalcatunite est une chaine
      totalcatcarrelage est une chaine
      totalcatverreunite est une chaine
      
      filtreactif est une chaine
      //ListeAjoute("crochet",gImage("MarquTab.ICO"))
      
      //Code WinDev 5.5 remplacé par la migration :
      //_onglet1..etat = actif
      MaFenetre..Plan=1
      
      
      GrpPourc..etat = grise
   -
     code : |1+
      InterrupteurChoix[1] = faux
      InterrupteurChoix[2] = vrai
      //InterrupteurChoix..visible = vrai
     type : 34
