#Internal properties refer to the properties of controls in windows, reports, etc.
info :
 name : modificationprixClientTous
 major_version : 29
 minor_version : 0
 type : 2
 description : Modification de prix
 subtype : 0
window :
 name : modificationprixClientTous
 identifier : 0x4ce443557015ea6b
 internal_properties : 
 properties :
  x : 120
  y : 50
  width : 498
  height : 598
  widthClient : 496
  heightClient : 566
 controls :
  -
    name : BTN_OK
    identifier : 0x4ce4435627e9eb55
    internal_properties : 
    properties :
     x : 340
     y : 187
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         i est un entier
         bFlagModifspecial est un booleen    // savoir si on fait la modif de la case a cocher special de la ligne 
         bFlagmodif est un booleen           // savoir si on fait la modif de la ligne
         bFlagModifCommande est un booleen = faux
         modificationprixClientTous..etat = grise
         rLPourcentage est un reel
         
         //si InterrupteurChoix[2] alors
         //	RequeteThermosPrix.pPrixSpecial = InterrupteurChoix[2]
         //sinon
         //	RequeteThermosPrix.pPrixSpecial = Null
         //fin
         //
         //si InterrupteurChoix[1] alors
         //	RequeteThermosPrix.pListeDePrix = InterrupteurChoix[1]
         //sinon
         //	RequeteThermosPrix.pListeDePrix = Null
         //fin
         //
         //HExécuteRequête(RequeteThermosPrix,hModifieFichier)
         //
         //pour tout RequeteThermosPrix
         //	si estverreunite() alors
         //		lPourcentage = modificationprixClienttous.POURVUNITE
         //	sinon
         //		lPourcentage = modificationprixClienttous.POURthermos
         //	fin
         //	RequeteThermosPrix.Tprixa =  arrondi(RequeteThermosPrix.Tprixa  * (1 + ( lpourcentage /100)),2)
         //	RequeteThermosPrix.Tprixm =  arrondi(RequeteThermosPrix.Tprixm  * (1 + ( lpourcentage /100)),2)
         //	RequeteThermosPrix.prixSpecial = vrai
         //	HModifie(RequeteThermosPrix,hNumEnrEnCours)
         //FIN
         si NoClient = "" alors
         	RequeteProduitClientTous.pIdClient = null
         sinon
         	RequeteProduitClientTous.pIdClient = Noclient	
         FIN
         
         
         if InterrupteurChoix[2] alors 
         	RequeteProduitClientTous.pPrixSpecial = InterrupteurChoix[2]
         sinon
         	RequeteProduitClientTous.pPrixSpecial = Null
         fin
         
         if InterrupteurChoix[1] alors 
         	RequeteProduitClientTous.pListeDePrix = InterrupteurChoix[1]
         sinon
         	RequeteProduitClientTous.pListeDePrix = Null
         fin
         
         HExécuteRequête(RequeteProduitClientTous,hModifieFichier)
         
         pour tout RequeteProduitClientTous
         	selon RequeteProduitClientTous.ITypeProduit
         		cas 1
         			si modificationprixClientTous.CASEPUNITE alors
         				RequeteProduitClientTous.IPrixa = arrondi(RequeteProduitClientTous.IPrixa  * (1 + ( modificationprixclientTous.POURPUNITE /100)),2)
         				RequeteProduitClientTous.IPrixm = arrondi(RequeteProduitClientTous.IPrixm  * (1 + ( modificationprixclientTous.POURPUNITE /100)),2)
         				RequeteProduitClientTous.IPprixSpecial = vrai
         				HModifie(RequeteProduitClientTous,hNumEnrEnCours)
         			fin
         			
         		cas 2
         			si modificationprixClientTous.CASEVUNITE alors
         				RequeteProduitClientTous.IPrixa = arrondi(RequeteProduitClientTous.IPrixa  * (1 + ( modificationprixclientTous.POURVUNITE /100)),2)
         				RequeteProduitClientTous.IPrixm = arrondi(RequeteProduitClientTous.IPrixm  * (1 + ( modificationprixclientTous.POURVUNITE /100)),2)
         				RequeteProduitClientTous.IPprixSpecial = vrai
         				HModifie(RequeteProduitClientTous,hNumEnrEnCours)
         			fin
         			
         		cas 4
         			//						si modificationprixClient.CASECARR alors
         			//							fenclient.table_1.pprixm[i] = arrondi(fenclient.table_1.pprixm[i]  * (1 + ( modificationprixclient.POURcarr /100)),2)
         			//							fenclient.table_1.cspecial[i] = vrai
         			//						fin
         			si modificationprixClientTous.CASECArr alors
         				RequeteProduitClientTous.IPrixm = arrondi(RequeteProduitClientTous.IPrixm  * (1 + ( modificationprixclientTous.POURCARR /100)),2)
         				RequeteProduitClientTous.IPprixSpecial = vrai
         			fin
         			si modificationprixClientTous.CASECARRCARREAU alors
         				RequeteProduitClientTous.IPrixa = arrondi(RequeteProduitClientTous.IPrixa * (1 + ( modificationprixclientTous.POURCARRCARREAU /100)),2)
         				RequeteProduitClientTous.IPprixSpecial = vrai
         			fin
         			si modificationprixClientTous.CASECARRPIED alors
         				RequeteProduitClientTous.IPrixCarrPiedCarre = arrondi(RequeteProduitClientTous.IPrixCarrPiedCarre * (1 + ( modificationprixclientTous.POURCARRPIED /100)),2)
         				RequeteProduitClientTous.IPrixCarrMetCarre = arrondi(RequeteProduitClientTous.IPrixCarrMetCarre * (1 + ( modificationprixclientTous.POURCARRPIED /100)),2)
         				RequeteProduitClientTous.IPprixSpecial = vrai
         			fin
         			
         			HModifie(RequeteProduitClientTous,hNumEnrEnCours)
         		cas 5
         			si modificationprixClientTous.CASEPeinture alors
         				RequeteProduitClientTous.IPrixa = arrondi(RequeteProduitClientTous.IPrixa  * (1 + ( modificationprixclientTous.POURPeinture /100)),2)
         				RequeteProduitClientTous.IPrixm = arrondi(RequeteProduitClientTous.IPrixa  * config.conversionamlineaire,2)
         				RequeteProduitClientTous.IPprixSpecial = vrai
         				HModifie(RequeteProduitClientTous,hNumEnrEnCours)
         			fin
         			
         			
         	FIN
         FIN
         
         si modificationprixClientTous.CASEbase alors
         	si idclient =0 alors
         		RequeteClientExtra.pIdClient = null
         	sinon
         		RequeteClientExtra.pIdClient = idclient
         	fin
         	
         	si InterrupteurChoix[2] alors 
         		RequeteClientExtra.pSpecial = InterrupteurChoix[2]
         	sinon
         		RequeteClientExtra.pSpecial = Null
         	fin
         	si InterrupteurChoix[1] alors 
         		RequeteClientExtra.pListeDePrix = InterrupteurChoix[1]
         	sinon
         		RequeteClientExtra.pListeDePrix = Null
         	fin
         	HExécuteRequête(RequeteClientExtra,hModifieFichier)
         	
         	pour tout RequeteClientExtra
         		message(RequeteClientExtra.IdClient)
         		MultitâcheRepeint()
         		si RequeteClientExtra.Pbase et pas CASEPBASE alors 
         			
         		sinon
         			
         			requeteclientextra.PrixAnglais =arrondi(arrondi(RequeteClientExtra.PrixAnglais,2) * (1 +(modificationprixClientTous.pourextra / 100)),2)
         			requeteclientextra.PrixAnglaisd =arrondi(arrondi(RequeteClientExtra.PrixAnglaisd,2) * (1 +(modificationprixClientTous.pourextra / 100)),2)
         			requeteclientextra.PrixAnglaist =arrondi(arrondi(RequeteClientExtra.PrixAnglaist,2) * (1 +(modificationprixClientTous.pourextra / 100)),2)
         			requeteclientextra.Prixmetrique =arrondi(RequeteClientExtra.PrixAnglais * config.conversionam,2)
         			requeteclientextra.PrixMetriqueD =arrondi(RequeteClientExtra.PrixAnglaisD * config.conversionam,2)
         			requeteclientextra.PrixMetriqueT =arrondi(RequeteClientExtra.PrixAnglaisT * config.conversionam,2)
         			
         			
         			//	requeteclientextra.Prixmetrique =arrondi(arrondi(RequeteClientExtra.PrixMetrique,2) * (1 +(modificationprixClientTous.pourextra / 100)),2)
         			//	requeteclientextra.PrixMetriqueD =arrondi(arrondi(RequeteClientExtra.PrixMetriqueD,2) * (1 +(modificationprixClientTous.pourextra / 100)),2)
         			//	requeteclientextra.PrixMetriqueT =arrondi(arrondi(RequeteClientExtra.PrixMetriqueT,2) * (1 +(modificationprixClientTous.pourextra / 100)),2)
         			RequeteClientExtra.prixSpecial = vrai
         			hmodifie(RequeteClientExtra,hNumEnrEnCours)
         		fin
         	fin
         fin
         
         si CASEFABREP alors
         	si Noclient = "" alors
         		RequeteThermosFabricationClient.pIdClient = null
         	sinon
         		RequeteThermosFabricationClient.pIdClient = Noclient
         	fin
         	si InterrupteurChoix[2] alors 
         		RequeteThermosFabricationClient.pSpecial = InterrupteurChoix[2]
         	sinon
         		RequeteThermosFabricationClient.pSpecial = Null
         	fin
         	si InterrupteurChoix[1] alors 
         		RequeteThermosFabricationClient.pListeDePrix = InterrupteurChoix[1]
         	sinon
         		RequeteThermosFabricationClient.pListeDePrix = Null
         	fin
         	RequeteThermosFabricationClient.Paramenfabrication = 1
         	RequeteThermosFabricationClient.ParamenVerreUnite = 0
         	
         	HExécuteRequête(RequeteThermosFabricationClient)
         	
         	
         	pour tout RequeteThermosFabricationclient
         		Message(RequeteThermosFabricationclient.IdClient)
         		MultitâcheRepeint()
         		RequeteThermosFabricationclient.Tprixa = arrondi(RequeteThermosFabricationclient.Tprixa * (1 + ( modificationprixClientTous.pourextra /100)),2)
         		RequeteThermosFabricationclient.Tprixm = arrondi(RequeteThermosFabricationclient.Tprixa * tauxconversionam,2)
         		//RequeteThermosFabricationClient.pspecial = vrai	
         		si hlitrecherche(thermosclient,IdClientIdhermos,hconstruitvalcle(ThermosClient,IdClientIdhermos,complete(RequeteThermosFabricationClient.IdClient,10),complete(RequeteThermosFabricationClient.IdThermos,20))) alors
         			ThermosClient.Tprixa = RequeteThermosFabricationClient.Tprixa
         			ThermosClient.Tprixm = RequeteThermosFabricationClient.Tprixm
         			ThermosClient.prixSpecial = vrai
         			hmodifie(ThermosClient,hNumEnrEnCours)
         			
         		FIN
         	FIN
         fin
         si CASEVERREUNITE alors
         	si Noclient = "" alors
         		RequeteThermosFabricationClient.pIdClient = null
         	sinon
         		RequeteThermosFabricationClient.pIdClient = Noclient
         	fin
         	si InterrupteurChoix[2] alors 
         		RequeteThermosFabricationClient.pSpecial = InterrupteurChoix[2]
         	sinon
         		RequeteThermosFabricationClient.pSpecial = Null
         	fin
         	si InterrupteurChoix[1] alors 
         		RequeteThermosFabricationClient.pListeDePrix = InterrupteurChoix[1]
         	sinon
         		RequeteThermosFabricationClient.pListeDePrix = Null
         	fin
         	RequeteThermosFabricationClient.Paramenfabrication = 0
         	RequeteThermosFabricationClient.ParamenVerreUnite = 1
         	
         	HExécuteRequête(RequeteThermosFabricationClient)
         	
         	
         	pour tout RequeteThermosFabricationclient
         		Message(RequeteThermosFabricationclient.IdClient)
         		MultitâcheRepeint()
         		RequeteThermosFabricationclient.Tprixa = arrondi(RequeteThermosFabricationclient.Tprixa * (1 + ( modificationprixClientTous.POURVERREUNITE /100)),2)
         		RequeteThermosFabricationclient.Tprixm = arrondi(RequeteThermosFabricationclient.Tprixa * tauxconversionam,2)
         		//RequeteThermosFabricationClient.pspecial = vrai	
         		si hlitrecherche(thermosclient,IdClientIdhermos,hconstruitvalcle(ThermosClient,IdClientIdhermos,complete(RequeteThermosFabricationClient.IdClient,10),complete(RequeteThermosFabricationClient.IdThermos,20))) alors
         			ThermosClient.Tprixa = RequeteThermosFabricationClient.Tprixa
         			ThermosClient.Tprixm = RequeteThermosFabricationClient.Tprixm
         			ThermosClient.prixSpecial = vrai
         			hmodifie(ThermosClient,hNumEnrEnCours)
         			
         		FIN
         	FIN
         fin
         
         
         si modificationprixClientTous.CASEPeinture alors
         	
         	si Noclient = "" alors
         		RequeteCouleurClient.pNoClient = null
         	sinon
         		RequeteCouleurClient.pNoClient = Noclient
         	fin
         	HExécuteRequête(RequeteCouleurClient,hModifieFichier)		
         	pour tout requeteCouleurClient
         		Message(RequeteCouleurClient.noClient)
         		MultitâcheRepeint()
         		requeteCouleurClient.fcExtra = arrondi(requeteCouleurClient.fcExtra  * (1 + ( modificationprixclienttous.POURPeinture /100)),2)
         		RequeteCouleurClient.fcExtralineairem = arrondi(requeteCouleurClient.fcExtra * config.conversionamlineaire,2)
         		
         		//		RequeteCouleurClient.fcExtralineairem = arrondi(requeteCouleurClient.fcExtralineairem  * (1 + ( modificationprixclienttous.POURPeinture /100)),2)
         		requeteCouleurClient.fcextraCarreau = arrondi(requeteCouleurClient.fcextraCarreau  * (1 + ( modificationprixclienttous.POURPeinture /100)),2)
         		hmodifie(RequeteCouleurClient,hnumenrencours)
         	FIN
         FIN
         
         
         si modificationprixClienttous.CASEPeintureCarreau alors
         	si Noclient = "" alors
         		pour tout client
         			client.CPrixSpecialPeintureCarrelage = arrondi(client.CPrixSpecialPeintureCarrelage  * (1 + ( modificationprixclienttous.POURPeintureCarreau /100)),2)
         			HModifie(client,hnumenrencours)
         		fin
         	sinon
         		si hlitrecherche(client,numero,Noclient) alors
         			client.CPrixSpecialPeintureCarrelage = arrondi(client.CPrixSpecialPeintureCarrelage  * (1 + ( modificationprixclienttous.POURPeintureCarreau /100)),2)
         			HModifie(client,hnumenrencours)
         		fin
         		
         	fin
         fin
         si Noclient = "" alors
         	RequeteFormeClientTous.pIdClient = null
         sinon
         	RequeteFormeClientTous.pIdClient = Noclient
         FIN
         si InterrupteurChoix[2] alors
         	RequeteformeClientTous.pPrixSpecial = InterrupteurChoix[2]
         sinon
         	RequeteformeClientTous.pPrixSpecial = null
         fin
         si InterrupteurChoix[1] alors
         	RequeteFormeClientTous.pListeDePrix = InterrupteurChoix[1]
         sinon
         	RequeteFormeClientTous.pListeDePrix = null	
         fin
         
         HExécuteRequête(RequeteFormeClientTous,hModifieFichier)
         
         pour tout RequeteFormeClientTous
         	Message(RequeteFormeClientTous.NoClient)
         	MultitâcheRepeint()
         	RequeteFormeClientTous.fPrixdouble = arrondi(RequeteFormeClientTous.fPrixdouble  * (1 + ( modificationprixclientTous.pourFormes /100)),2)
         	RequeteFormeClientTous.FpRixtriple = arrondi(RequeteFormeClientTous.FpRixtriple  * (1 + ( modificationprixclientTous.pourFormes /100)),2)
         	RequeteFormeClientTous.fPrixSpecial = vrai
         	HModifie(RequeteFormeClientTous,hNumEnrEnCours)
         FIN
         
         
         
         multitache(100)
         ferme(modificationprixClienttous)
         
         
        type : 18
      -
        type : 161
        enabled : false
