    type : 5
    controls : []
    code_elements :
     type_code : 5
     p_codes :
      -
        code : |1+
         si moimeme alors
         //Code WinDev 5.5 remplacé par la migration :
         //	casecarr..etat = actif
         	casecarr..etat = actif; casecarr..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         //	casecarrcarreau..etat = actif
         	casecarrcarreau..etat = actif; casecarrcarreau..Visible=Vrai
         	casecarrpied..etat = actif; casecarrpied..Visible=Vrai
         	CASECARRPIED..etat = actif;CASECARRPIED..visible = vrai
         	//Code WinDev 5.5 remplacé par la migration :
         ////	filtrecarrelage..etat = actif
         //	filtrecarrelage..etat = actif; filtrecarrelage..Visible=Vrai
         ////Code WinDev 5.5 remplacé par la migration :
         ////	datecarr..etat = actif
         //	datecarr..etat = actif; datecarr..Visible=Vrai
         sinon
             casecarr = faux
         	casecarrcarreau = faux
             CASECARRPIED = faux
         	datecarr = ""
         	casecarr..etat = AffichageSeulement; casecarr..Visible=Vrai
         	casecarrcarreau..etat = AffichageSeulement; casecarrcarreau..Visible=Vrai
         	casecarrpied..etat = AffichageSeulement; casecarrpied..Visible=Vrai
         	pourcarr..etat = grise; pourcarr..Visible=Vrai
         	pourcarrpied..etat = grise; pourcarrpied..Visible=Vrai
         	pourcarrcarreau..etat = grise; pourcarrcarreau..Visible=Vrai
             pourcarr = ""
         	pourcarrcarreau = ""
         	POURCARRPIED = ""
         FIN
         
         
        type : 16
      -
        code : |1+
         si moimeme alors
         	//Code WinDev 5.5 remplacé par la migration :
         	//	casecarr..etat = actif
         	casecarr..etat = actif; casecarr..Visible=Vrai
         	//Code WinDev 5.5 remplacé par la migration :
         	//	casecarrcarreau..etat = actif
         	casecarrcarreau..etat = actif; casecarrcarreau..Visible=Vrai
         	casecarrpied..etat = actif; casecarrpied..Visible=Vrai
         	//Code WinDev 5.5 remplacé par la migration :
         	////	filtrecarrelage..etat = actif
         	//	filtrecarrelage..etat = actif; filtrecarrelage..Visible=Vrai
         	////Code WinDev 5.5 remplacé par la migration :
         	////	datecarr..etat = actif
         	//	datecarr..etat = actif; datecarr..Visible=Vrai
         sinon
         	casecarr = faux
         	casecarrcarreau = faux
         	CASECARRPIED = faux
         	datecarr = ""
         	//Code WinDev 5.5 remplacé par la migration :
         	//	casecarr..etat = inactif
         	casecarr..etat = AffichageSeulement; casecarr..Visible=Vrai
         	//Code WinDev 5.5 remplacé par la migration :
         	//	casecarrcarreau..etat = inactif
         	casecarrcarreau..etat = AffichageSeulement; casecarrcarreau..Visible=Vrai
         	casecarrpied..etat = AffichageSeulement; casecarrpied..Visible=Vrai
         	//Code WinDev 5.5 remplacé par la migration :
