  procedures :
   -
     name : EstVerreUnite
     procedure_id : 5540627478985829158
     type_code : 14
     code : |1+
      Procédure EstVerreUnite()
      cpt est un entier=0
      
      si hlitrecherche(persoens,ennumero,RequeteThermosPrix.IdThermos) alors
      	si pas sansespace(persoens.encomposant1) = "" alors
      		cpt++
      	FIN
      
      	si pas sansespace(persoens.encomposant2) = "" alors
      		cpt++
      	FIN
      
      	si pas sansespace(persoens.encomposant3) = "" alors
      		cpt++
      	FIN
      
      	si cpt = 1 alors renvoyer vrai
      fin
      renvoyer faux
      
     type : 458752
  procedure_templates : []
  property_templates : []
