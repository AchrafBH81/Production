  -
    name : Btn_Ok
    identifier : 0x4e6fbd0159eed1ba
    internal_properties : 
    properties :
     x : 368
     y : 44
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         sablier(vrai)
         reqsql est une source de donnees
         
         
         
         lclientsourceid est un entier = 0
         lidclientSource est une chaine = sansespace(Combo_client)
         lidclientCible est une chaine = sansespace(lnumero)
         si hlitrecherche(client,numero,sansespace(combo_client)) alors
         	lclientsourceid = client.IDClient
         FIN
         lclientCibleid est un entier  = lid
         
         lTabForme est un tableau de FormeClient
         lTabProduitClient est un tableau de produitclient
         ltabcarrelage est un tableau de ProduitClient
         ltabcouleur est un tableau de fCouleurClient
         lTabThermos est un tableau de ThermosClient
         lTabExtra est un tableau de fClientExtra
         ltabvariablex est un tableau de VariableXclient
         ltabcouleurclient est un tableau de cClientProduitCouleur
         
         
         
         
         
         
         
         
         si IntChoix[1] alors
         	// Forme
         	
         	HLitRecherche(FormeClient,NoClient,lidclientCible)
         	tantque pas hendehors(FormeClient) et formeclient.NoClient = lidclientCible
         		hsupprime(FormeClient,hNumEnrEnCours)
         		HLitSuivant(FormeClient,NoClient)
         	FIN
         	
         	HLitRecherche(FormeClient,NoClient,lidclientSource)
         	tantque pas hendehors(FormeClient) et formeclient.NoClient = lidclientSource
         		_formeclient est un formeclient = allouer un formeclient()
         		FichierVersMémoire(_formeclient,formeclient)
         		_formeclient.NoClient = lidclientCible
         		tableauajoute(lTabForme,_formeclient)
         		//		HCopieEnreg(formeclientalias,FormeClient)
         		//		formeclientalias.noclient = lidclientCible
         		//		HAjoute(formeclientalias)
         		HLitSuivant(FormeClient,NoClient)
         	FIN
         	
         	//	pour tout formeclientalias
         	//		HCopieEnreg(formeclient,FormeClientalias)
         	//		HAjoute(formeclient)
         	//		
         	//	FIN
         	POUR TOUT _formeclient de lTabForme
         		memoireversfichier(_formeclient,formeclient)
         		HAjoute(FormeClient)
         		
         	FIN
         fin
         TableauSupprimetout(lTabForme)
         
         //hferme(formeclientalias)
         //HAnnuleAlias(formeclientalias)
         
         si IntChoix[2] alors
         	// Couleur
         	
         	HLitRecherche(fcouleurClient,NoClient,lidclientCible)
         	tantque pas hendehors(fcouleurClient) et fcouleurclient.NoClient = lidclientCible
         		hsupprime(fcouleurClient,hNumEnrEnCours)
         		HLitSuivant(FcouleurClient,NoClient)
         	FIN
         	
         	HLitRecherche(FCouleurClient,NoClient,lidclientSource)
         	tantque pas hendehors(FCouleurClient) et FCouleurClient.NoClient = lidclientSource
         		_fcouleurclient est un fCouleurClient = allouer un fcouleurclient()
         		fichierversmemoire(_fcouleurclient,fcouleurclient)
         		_fcouleurclient.noClient =lidclientCible
         		tableauajoute(ltabcouleur,_fcouleurclient)  
         		HLitSuivant(fcouleurclient,NoClient)
         	FIN
         	
         	POUR TOUT _fcouleurclient de ltabcouleur
         		memoireversfichier(_fcouleurclient,fcouleurclient)
         		HAjoute(fCouleurClient)
         		
         	FIN
         fin
         TableauSupprimeTout(ltabcouleur)
         
         
         
         si IntChoix[3] alors
         	
         	
         	SI HExécuteRequêteSQL(reqsql,hRequêteDéfaut,ChaîneConstruit("delete from produitclient where idclient ='%1' and produitclient.itypeproduit <> 4 ",lidclientCible)) ALORS
         		SI HExécuteRequêteSQL(reqsql,hRequêteDéfaut,ChaîneConstruit("select * from produitclient where idclient ='%1' and produitclient.itypeproduit <> 4 ",lidclientSource)) ALORS
         			POUR TOUT reqsql 
         				_fproduit est un produitclient = allouer un produitclient()
         				FichierVersMémoire(_fproduit,reqsql)
         				_fproduit.IdClient = lidclientCible
         				tableauajoute(lTabProduitClient,_fproduit)
         			FIN
         			
         			POUR TOUT _fproduit de lTabProduitClient 
         				memoireversfichier(_fproduit,ProduitClient)
         				hajoute(ProduitClient)
         				
         			FIN
         			
         		FIN
         		
         		
         	FIN
         	
         	TableauSupprimeTout(lTabProduitClient)
         	
         	
         	SI HExécuteRequêteSQL(reqsql,hRequêteDéfaut,ChaîneConstruit("delete from FClientProduitCouleur where noclient ='%1' ",lidclientCible)) ALORS	
         		SI HExécuteRequêteSQL(reqsql,hRequêteDéfaut,ChaîneConstruit("select *  from FClientProduitCouleur where noclient ='%1' ",lidclientSource)) ALORS	
         			POUR TOUT reqsql 
         				_fclientcouleur est un cClientProduitCouleur = allouer un cClientProduitCouleur()
         				FichierVersMémoire(_fclientcouleur,reqsql)
         				_fclientcouleur.noclient = lidclientCible
         				TableauAjoute(ltabcouleurclient,_fclientcouleur)
         			FIN
         			
         			POUR TOUT _fclientcouleur DE ltabcouleurclient
         				MémoireVersFichier(_fclientcouleur,FClientProduitCouleur)
         				HAjoute(FClientProduitCouleur)
         				
         			FIN
         			
         		fin	
         		
         	fin
         	
         	TableauSupprimeTout(ltabcouleurclient)
         	
         	
         	
         	
         	
         	
         	
         fin
         
         
         
         
         
         si IntChoix[4] alors
         	//Thermos
         
         	SI HExécuteRequêteSQL(reqsql,hRequêteDéfaut,ChaîneConstruit("delete from Thermosclient where idclient ='%1' ",lidclientCible)) ALORS	
         		SI HExécuteRequêteSQL(reqsql,hRequêteDéfaut,ChaîneConstruit("select *  from Thermosclient where idclient ='%1' ",lidclientSource)) ALORS	
         			POUR TOUT reqsql 
         				_thermosclient est un thermosclient = allouer un thermosclient()
         				FichierVersMémoire(_thermosclient,reqsql)
         				_thermosclient.idClient = lidclientCible
         				TableauAjoute(lTabThermos,_thermosclient)
         			FIN
         			
         			POUR TOUT _thermosclient DE lTabThermos
         				MémoireVersFichier(_thermosclient,thermosclient)
         				HAjoute(ThermosClient)
         				
         			FIN
         			
         		FIN	
         		
         	FIN
         	
         	TableauSupprimeTout(lTabThermos)
         	
         
         	
         	SI HExécuteRequêteSQL(reqsql,hRequêteDéfaut,ChaîneConstruit("delete from fclientextra where idclient ='%1' ",lclientCibleid)) ALORS	
         		SI HExécuteRequêteSQL(reqsql,hRequêteDéfaut,ChaîneConstruit("select *  from fclientextra where idclient ='%1' ",lclientsourceid)) ALORS	
         			POUR TOUT reqsql 
         				_fclientextra est un fclientextra = allouer un fclientextra()
         				FichierVersMémoire(_fclientextra,reqsql)
         				_fclientextra.IdClient = lclientCibleid
         				TableauAjoute(lTabExtra,_fclientextra)
         			FIN
         			
         			POUR TOUT _fclientextra DE lTabExtra
         				MémoireVersFichier(_fclientextra,fclientextra)
         				HAjoute(fclientextra)
         				si HErreurIntégrité() alors info(herreurinfo(hErrComplet))
         				
         			FIN
         			
         		FIN	
         		
         	FIN
         	
         	TableauSupprimeTout(lTabExtra)
         	
         
         	
         	
         	
         	
         	
         fin
         
         
         
         
         
         
         
         si IntChoix[5] alors
         	//VariableX
         	
         	
         	SI HExécuteRequêteSQL(reqsql,hRequêteDéfaut,ChaîneConstruit("delete from VariableXclient where noclient ='%1' ",lidclientCible)) ALORS	
         		SI HExécuteRequêteSQL(reqsql,hRequêteDéfaut,ChaîneConstruit("select *  from VariableXclient where noclient ='%1' ",lidclientSource)) ALORS	
         			POUR TOUT reqsql 
         				_VariableXclient est un VariableXclient = allouer un VariableXclient()
         				FichierVersMémoire(_VariableXclient,reqsql)
         				_VariableXclient.noclient = lidclientCible
         				TableauAjoute(ltabvariablex,_VariableXclient)
         			FIN
         			
         			POUR TOUT _VariableXclient DE ltabvariablex
         				MémoireVersFichier(_VariableXclient,VariableXclient)
         				HAjoute(VariableXclient)
         				
         			FIN
         			
         		FIN	
         		
         	FIN
         	
         	TableauSupprimeTout(ltabvariablex)
         fin
         
         
         si intchoix[6] ALORS
         	
         	SI HExécuteRequêteSQL(reqsql,hRequêteDéfaut,ChaîneConstruit("delete from produitclient where idclient ='%1' and produitclient.itypeproduit = 4 ",lidclientCible)) ALORS
         		SI HExécuteRequêteSQL(reqsql,hRequêteDéfaut,ChaîneConstruit("select * from produitclient where idclient ='%1' and produitclient.itypeproduit = 4 ",lidclientSource)) ALORS
         			POUR TOUT reqsql 
         				_Carrelage est un ProduitClient = allouer un ProduitClient()
         				FichierVersMémoire(_Carrelage,reqsql)
         				_Carrelage.idClient = lidclientCible
         				TableauAjoute(ltabcarrelage,_Carrelage)
         			FIN
         			
         			POUR TOUT _Carrelage DE ltabcarrelage
         				MémoireVersFichier(_Carrelage,ProduitClient)
         				HAjoute(ProduitClient)
         				
         			FIN
         			
         		
         		
         		fin
         		
         		
         	fin
         	
         FIN
         
         sablier(faux)
         
         ferme()
         
         
        type : 18
      -
        type : 161
        enabled : false
