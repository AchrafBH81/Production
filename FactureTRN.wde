     y : 168.323
     width : 269.4
     height : 4.
    code_elements :
     type_code : 30
     p_codes :
      -
        code : |1+
         qtecarr11 = requetebletat.fdqteafacturer
         qtecarr94 = requetebletat.fdcarreauv
         qtecarr95 = requetebletat.fdcarreauh
         qtecarr96 = requetebletat.fdnbcarreau
         
         PrixUnitCarr5 = requetebletat.FDextraCarrelagedemi
         TotalCarrExtraDemi = arrondi(requetebletat.fdnbcarreau * requetebletat.FDextraCarrelagedemi * RequeteBlEtat.fdqteafacturer,2)
         totalfacture += totalCarrExtraDemi
         //trace(TotalCarrExtraDemi)
         //wl.trace(totalfacture)
         hlitrecherche(Traduction,TRecherche,"surchargedemithermos") 
         si client.CLangue=1 alors DescriptionDemiThermos=Traduction.dfrancais sinon DescriptionDemiThermos=Traduction.danglais
        type : 327692
      -
        code : |1+
