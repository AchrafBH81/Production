      	cas 2
      		pour i = 1 a 46
      			si hlitrecherche(Traduction,TRecherche,extraitchaine(lTableauLibelle[i],1,",")) alors
      				{"facturetrn."+ExtraitChaîne(lTableauLibelle[i],2,",")} = traduction.danglais
      			fin
