    properties :
     y : 80.822
     width : 269.4
     height : 39.025
    code_elements :
     type_code : 30
     p_codes :
      -
        code : |1+
         si requetebletat.fsurchargepeinture <> 0 alors
         	iImprimeBloc(iteration7)
         	totalfacture+=requetebletat.fsurchargepeinture
         	remplir_tableau(gclconfig.m_sNoGlPeinture,arrondi(requetebletat.fsurchargepeinture,2))
         //	AlimenteHistoriqueProduit(sansespace(client.numero),requetebletat.BDateFacture,5,requetebletat.fdnumprod...
         //	,"","","",arrondi(requetebletat.fsurchargepeinture,2),0,DescPeinture,0)
         FIN
         
         TotalSurchargeTaux = Arrondi(totalfacture+( SurchargeSurEnergie ? totalsurcharge SINON 0 ),2) * requetebletat.surchargeTauxPourc / 100
         TotaldeSurchargeTaux = totalsurchargetaux
         totaldesurcharge = totalsurcharge
         totaldefacture = totalfacture + totalsurcharge + TotalSurchargeTaux
         totaltvh = arrondi((totalfacture + totalsurcharge+ TotalSurchargeTaux) * RequeteBlEtat.bTauxTaxe1 / 100,2)
         totaltvq = arrondi((totalfacture + totalsurcharge+ TotalSurchargeTaux+(requetebletat.bCalculTaux2sur1 ? totaltvh sinon 0)) * RequeteBlEtat.bTauxTaxe2 / 100,2)
         grandtotal = totaldefacture + totaltvh + TotalTVQ
         si pas facturereimpression alors
         	fac_detail[1,2] = numeriqueverschaine(arrondi(grandtotal,2) * -1)
         	Remplir_tableau(gclConfig.m_ssurchargegl,Arrondi(totalsurcharge,2),Faux,vrai)
         	Remplir_tableau(gclConfig.m_sSUrchargeTauxGl,Arrondi(TotalSurchargeTaux,2),faux,vrai)
         	
         	si sansespace(taxegl1) <> "" alors Remplir_tableau(taxegl1,Arrondi(TotalTVH,2),Vrai,vrai)
         	SI SansEspace(taxeGL2) <> "" ALORS 
         		Remplir_tableau(taxegl2,Arrondi(TotalTVQ,2),Vrai,vrai)
         	sinon
         		Remplir_tableau(gclConfig.m_sgltvq,Arrondi(TotalTVQ,2),Vrai,Vrai)
         		
         	FIN
         //	Remplir_tableau(config.gltps,Arrondi(TotalTVH,2),Vrai)
         //	Remplir_tableau(config.gltvq,Arrondi(TotalTVQ,2),Vrai)
         //	AlimenteHistorique(sansespace(client.numero),requetebletat.BDateFacture,totalfacture+totalsurcharge,RequeteBlEtat.cvendeur)
         fin
         
         
         
         
        type : 327692
      -
        type : 327697
        enabled : false
