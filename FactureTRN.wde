    properties :
     y : 119.847
     width : 269.4
     height : 4.
    code_elements :
     type_code : 30
     p_codes :
      -
        code : |1+
         // a faire: inscrire le coutant pas carreau dans une colonne, le prix de base dans une autre et inscrire le tootal unitaire dans prix.uni.
         qtecarr = requetebletat.fdqteafacturer
         qtecarr6 = requetebletat.fdcarreauv
         qtecarr8 = requetebletat.fdcarreauh
         DescCarr = requetebletat.fddesc
         si requetebletat.fdcarrprixdebase <> 0 alors
         	qtecarr29 = "$ Base"
         	qtecarr30 = requetebletat.fdcarrprixdebase
         sinon
         	qtecarr29 = ""
         	qtecarr30 = 0
         FIN
         
         qtecarr24 = requetebletat.fdnbcarreau
         si requetebletat.TDemiCarrelage alors
         	PrixUnitCarr = requetebletat.fdcarrpruxuc
         	TotalCarr = arrondi((((requetebletat.fdcarrpruxuc)*requetebletat.fdnbcarreau) + requetebletat.fdcarrprixdebase)* requetebletat.fdqteafacturer,2)
         sinon
         	PrixUnitCarr = requetebletat.fdcarrpruxuc
         	TotalCarr = arrondi((requetebletat.frcarrprixu + requetebletat.fdcarrprixdebase)* requetebletat.fdqteafacturer,2)
         FIN
         
         
         
         
         
         
        type : 327692
      -
        code : |1+
         totaldepage+=arrondi(totalcarr,2)
         remplir_tableau(requetebletat.fdcodegl,arrondi(totalcarr,2))
         
         si RequeteBlEtat.TDemiCarrelage alors
         	iimprimebloc(ITERATION12)
         FIN
         
        type : 327693
      -
        type : 327697
        enabled : false
