    properties :
     y : 61.529
     width : 269.4
     height : 3.99999999999999
    code_elements :
     type_code : 30
     p_codes :
      -
        code : |1-
         
        type : 327694
      -
        code : |1+
         
         
         //// ****************** Nouveau code ****************************
         
         j est un entier
         indicecarr est un entier
         carrtrouve est un booleen = faux//A FAIRE :
         carrnogl est une chaine
         totcar est un reel
         totpeinture est un reel
         
         si RequeteBlEtat.ftype = 1 alors
         	lTypeLigne = "Verre"
         sinon si requetebletat.ftype = 2 
         	si pas requetebletat.fdverreunite alors
         		lTypeLigne = "Unite"
         	sinon
         		lTypeLigne = "Verre"
         	fin
         sinon si requetebletat.ftype = 4
         	ltypeligne = "Carrelage" 
         sinon si requetebletat.ftype = 3
         	ltypeligne = "Fourniture" 
         sinon si requetebletat.ftype = 5
         	ltypeligne = "Peinture" 
         fin
         
         //si RequeteBlEtat.ftype = 4 alors
         //	corps..visible = faux
         //sinon
         calculligne++
         
         selon lTypeLigne
         	cas "Unite"
         		CORPS..VISIBLE = VRAI
         		rubrique17 = requetebletat.fdprixu
         		rubrique16 = 1
         		//		rubrique16..visible = faux
         	cas "Verre"	
         		corps..visible = vrai
         //		si hlitrecherche(typespac,tnumero,sansespace(RequeteBlEtat.ftypespacer)) alors
         //			si client.CLangue=1 alors cspacer = typespac.tdesccourte sinon cspacer = typespac.tdesccourtea
         //		sinon
         //			cspacer = ""	
         //		FIN
         		
         		SI Val(SansEspace(RequeteBlEtat.ftypespacer)) <> 0 _AND_ HLitRecherche(IntercalaireCouleurs,IDIntercalaireCouleurs,Val(SansEspace(Requetebletat.ftypespacer))) ALORS
         			SI Client.CLangue=1 ALORS CSpacer=IntercalaireCouleurs.DescriptionCourte SINON CSpacer=IntercalaireCouleurs.DesctiptionCourteAnglais
         		SINON
         			CSpacer = ""	
         			
         		FIN
         	cas "Fourniture"	
         		corps..visible = faux
         		iImprimeBloc(ITERATION10)
         		//		rubrique16..visible = vrai
         	cas "Carrelage"
         		corps..visible = faux
         		iImprimeBloc(ITERATION1)
         	cas "Peinture"
         		corps..visible = faux
         		iImprimeBloc(ITERATION2)
         fin
         
         
         
         
         
         //	si pas facturereimpression alors
         //		remplir_tableau(rubrique21,arrondi(rubrique4 * (rubrique16 * rubrique17),2))
         //	FIN
         
         //	totalpage +=  arrondi(requetebletat.fdqteafacturer * requetebletat.fdpiedcarrefacture * requetebletat.fdprixupiedfacture,2)
         //	totalfacture +=  arrondi(requetebletat.fdqteafacturer * requetebletat.fdpiedcarrefacture * requetebletat.fdprixupiedfacture,2)
         
         selon lTypeLigne
         	cas "Unite"
         		//		FIN
         		//		si requetebletat.ftype = 2 et pas requetebletat.fdverreunite alors
         		totalpage +=  arrondi(requetebletat.fdqteafacturer * requetebLETAT.fdprixu,2)
         		totalfacture +=  arrondi(requetebletat.fdqteafacturer * requetebLETAT.fdprixu,2)
         //		AlimenteHistoriqueProduit(sansespace(client.numero),requetebletat.BDateFacture,2,requetebletat.fdnumprod,"","","", arrondi(requetebletat.fdqteafacturer * requetebLETAT.fdprixu,2),...
         //		RequeteBlEtat.surchargeenergie,requetebletat.fddesc,RequeteBlEtat.fdqteafacturer)
         	cas "Fourniture"
         		//		FIN
         		//		si requetebletat.ftype = 2 et pas requetebletat.fdverreunite alors
         		totalpage +=  arrondi(requetebletat.fdqteafacturer * requetebLETAT.fdprixupied,2)
         		totalfacture +=  arrondi(requetebletat.fdqteafacturer * requetebLETAT.fdprixupied,2)
         //		AlimenteHistoriqueProduit(sansespace(client.numero),requetebletat.BDateFacture,2,requetebletat.fdnumprod,"","","", arrondi(requetebletat.fdqteafacturer * requetebLETAT.fdprixu,2),...
         //		0,requetebletat.fddesc,RequeteBlEtat.fdqteafacturer)
         
         	cas "Verre"
         		//sinon
         		totalpage +=  arrondi(requetebletat.fdqteafacturer * ((requetebletat.fdpiedcarrefacture * requetebletat.fdprixupiedfacture) + ...
         		REQUETEBLETAT.fdextraforme),2)+arrondi(requetebletat.fdqteafacturer *RequeteBlEtat.FDextra10X,2)+...
         		arrondi(requetebletat.fdqteafacturer *RequeteBlEtat.FDextra5x,2)
         		
         //		totalfacture +=  arrondi(requetebletat.fdqteafacturer * ((requetebletat.fdpiedcarrefacture * requetebletat.fdprixupiedfacture)+ ...
         //		RequeteBlEtat.fdextraforme),2)
         		totalfacture +=  arrondi(requetebletat.fdqteafacturer * (requetebletat.fdpiedcarrefacture * requetebletat.fdprixupiedfacture),2)+ ...
         		arrondi(requetebletat.fdqteafacturer *RequeteBlEtat.fdextraforme,2)+arrondi(requetebletat.fdqteafacturer *RequeteBlEtat.FDextra10X,2)+...
         		arrondi(requetebletat.fdqteafacturer *RequeteBlEtat.FDextra5x,2)
         //		wl.trace( Arrondi(RequeteBlEtat.fdqteafacturer * (RequeteBlEtat.fdpiedcarrefacture * RequeteBlEtat.fdprixupiedfacture),2)+ ...
         //		Arrondi(RequeteBlEtat.fdqteafacturer *RequeteBlEtat.fdextraforme,2)+Arrondi(RequeteBlEtat.fdqteafacturer *RequeteBlEtat.FDextra10X,2)+...
         //		Arrondi(RequeteBlEtat.fdqteafacturer *RequeteBlEtat.FDextra5x,2))
         //		
         //		wl.trace(totalfacture)
         
         
         		//		totalpage +=  arrondi(requetebletat.fdqteafacturer * requetebletat.fdpiedcarrefacture * requetebletat.fdprixupiedfacture,2) + ...
         		//		arrondi(requetebletat.fdqteafacturer * REQUETEBLETAT.fdextraforme,2)
         		//		totalfacture +=  arrondi(requetebletat.fdqteafacturer * requetebletat.fdpiedcarrefacture * requetebletat.fdprixupiedfacture,2) + ...
         		//		arrondi(requetebletat.fdqteafacturer * REQUETEBLETAT.fdextraforme,2)
         
         
         ///		totalsurcharge += arrondi(requetebletat.SUrchargeafacturer,2)
         		totalsurcharge += arrondi(requetebletat.surchargeenergie,2)
         		totalcap+= arrondi(requetebletat.FDExtraCap * REQUETEBLETAT.fdqteafacturer,2)
         
         
         //		AlimenteHistoriqueProduit(sansespace(client.numero),requetebletat.BDateFacture, requetebletat.ftype,requetebletat.fdnumprod,RequeteBlEtat.fdcomposant1,...
         //		RequeteBlEtat.fdcomposant2,RequeteBlEtat.fdcomposant3,arrondi(requetebletat.fdqteafacturer * ((requetebletat.fdpiedcarrefacture * requetebletat.fdprixupiedfacture)+ ...
         //		RequeteBlEtat.fdextraforme),2)+arrondi(requetebletat.fdqteafacturer *RequeteBlEtat.FDextra10X,2)+...
         //		arrondi(requetebletat.fdqteafacturer *RequeteBlEtat.FDextra5x,2),...
         //		RequeteBlEtat.surchargeenergie,requetebletat.fddesc,RequeteBlEtat.fdqteafacturer,0,(requetebletat.fdpiedcarrefacture*lmultiplicateur*RequeteBlEtat.fdqteafacturer))
         
         
         	cas "Carrelage"
         		//		FIN
         		//		si requetebletat.ftype = 2 et pas requetebletat.fdverreunite alors
         		totalpage +=  arrondi((requetebletat.frcarrprixu + requetebletat.fdcarrprixdebase)* requetebletat.fdqteafacturer,2)...
         		+arrondi(requetebletat.fTotalPeinture * requetebletat.fdqteafacturer ,2)
         
         //		totalfacture +=  arrondi((requetebletat.frcarrprixu + requetebletat.fdcarrprixdebase)* requetebletat.fdqteafacturer,2)...
         //		+arrondi(((requetebletat.Ftotalcarreaupeinture*requetebletat.fPrixCarreauPeinture)...
         //		+(RequeteBlEtat.FDnbcarreauPeinture1*RequeteBlEtat.fdprixcarreaupeinture1))...
         //		* requetebletat.fdqteafacturer ,2)
         		totalfacture +=  arrondi(((requetebletat.fdcarrpruxuc * requetebletat.fdnbcarreau) + requetebletat.fdcarrprixdebase)* requetebletat.fdqteafacturer,2)...
         		+arrondi(((requetebletat.Ftotalcarreaupeinture*requetebletat.fPrixCarreauPeinture)...
         		+(RequeteBlEtat.FDnbcarreauPeinture1*RequeteBlEtat.fdprixcarreaupeinture1))...
         		* requetebletat.fdqteafacturer ,2)
         		// pour calculer le montant a transférer a l'historique
         //		wl.trace( Arrondi(((RequeteBlEtat.fdcarrpruxuc * RequeteBlEtat.fdnbcarreau) + RequeteBlEtat.fdcarrprixdebase)* RequeteBlEtat.fdqteafacturer,2)...
         //		+Arrondi(((RequeteBlEtat.Ftotalcarreaupeinture*RequeteBlEtat.fPrixCarreauPeinture)...
         //		+(RequeteBlEtat.FDnbcarreauPeinture1*RequeteBlEtat.fdprixcarreaupeinture1))...
         //		* RequeteBlEtat.fdqteafacturer ,2))
         //		wl.trace(totalfacture)
         		totcar = arrondi((requetebletat.frcarrprixu + requetebletat.fdcarrprixdebase)* requetebletat.fdqteafacturer,2)
         		totpeinture = arrondi(((requetebletat.Ftotalcarreaupeinture*requetebletat.fPrixCarreauPeinture)...
         		+(RequeteBlEtat.FDnbcarreauPeinture1*RequeteBlEtat.fdprixcarreaupeinture1))...
         		* requetebletat.fdqteafacturer ,2)
         		
         		//		AlimenteHistoriqueProduit(sansespace(client.numero),requetebletat.BDateFacture,2,requetebletat.fdnumprod,"","","", arrondi(requetebletat.fdqteafacturer * requetebLETAT.fdprixu,2),...
         		//		RequeteBlEtat.surchargeenergie,requetebletat.fddesc,RequeteBlEtat.fdqteafacturer)
         //		AlimenteHistoriqueProduit(sansespace(client.numero),requetebletat.BDateFacture,4,requetebletat.fdnumcarr,"","","",...
         //		totcar,0,desccarr,qtecarr24,totpeinture)
         
         	cas "Peinture"
         		//		FIN
         		//		si requetebletat.ftype = 2 et pas requetebletat.fdverreunite alors
         		totalpage +=  arrondi(requetebletat.fdqteafacturer * (requetebletat.fdpiedcarrefacture * requetebletat.fdprixupied),2)
         		totalfacture +=  arrondi(requetebletat.fdqteafacturer * (requetebletat.fdpiedcarrefacture * requetebletat.fdprixupied),2)
         		totpeinture = arrondi(requetebletat.fdqteafacturer * (requetebletat.fdpiedcarrefacture * requetebletat.fdprixupied),2)
         		//		AlimenteHistoriqueProduit(sansespace(client.numero),requetebletat.BDateFacture,2,requetebletat.fdnumprod,"","","", arrondi(requetebletat.fdqteafacturer * requetebLETAT.fdprixu,2),...
         		//		RequeteBlEtat.surchargeenergie,requetebletat.fddesc,RequeteBlEtat.fdqteafacturer)
         //		AlimenteHistoriqueProduit(sansespace(client.numero),requetebletat.BDateFacture,5,requetebletat.fdnumprod...
         //		,"","","",Totpeinture,0,DescPeinture,QtePeinture)
         fin
         
         
         
         
         
         
         
         
         
         
         
        type : 327692
      -
        code : |1+
         si RequeteBlEtat.ftype <> 4 alors
         
         	si pas facturereimpression alors
         		si RequeteBlEtat.ftype <> 4 alors
         			SI REQUETEBLETAT.FDExtraCap <> 0 ALORS
         				remplir_tableau(rubrique21,arrondi(rubrique18,2) - (arrondi(requetebletat.FDExtraCap * REQUETEBLETAT.fdqteafacturer,2)),Faux,vrai)
         				remplir_tableau(gclConfig.m_sCapGL,arrondi(requetebletat.FDExtraCap) * REQUETEBLETAT.fdqteafacturer,Faux,Vrai)
         			SINON
         				remplir_tableau(rubrique21,arrondi(rubrique18,2),Faux,Vrai)
         			FIN
         		fin
         	FIN
         
             si requetebletat.FDextra5x <> 0 ou requetebletat.FDextra10X <> 0 alors
               calculligne++
               iimprimebloc(ITERATION11)
             fin
             	
         	si pas sansespace(RequeteBlEtat.fdforme) = ""  ou requetebletat.fdextraforme <> 0  alors
         		calculligne++
         		iImprimeBloc(ITERATION9)	
         		//  totalpage +=  totalextraforme
         		//  totalfacture +=  totalextraforme
         	FIN
         	si pas sansespace(RequeteBlEtat.fnotes) = "" alors //ou requetebletat.fdextraforme <> 0 ALORS
         		calculligne++
         		iImprimeBloc(ITERATION3)	
         		//  totalpage +=  totalextraforme
         		//  totalfacture +=  totalextraforme
         	FIN
         	si pas sansespace(RequeteBlEtat.fnotes1) = ""   ALORS
         		calculligne++
         		iImprimeBloc(ITERATION5)	
         		//  totalpage +=  totalextraforme
         		//  totalfacture +=  totalextraforme
         	FIN
         sinon
         	si requetebletat.fpeinture alors
         		calculligne++
         		iImprimeBloc(ITERATION6)	
         
         	FIN
         fin
         
         si CORPS..visible ALORS
         	TotaldePage+=rubrique18
         FIN
        type : 327693
      -
        type : 327697
        enabled : false
