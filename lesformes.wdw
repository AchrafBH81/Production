    name : BTN_AJOUT
    identifier : 0x3e9d90e00139f889
    internal_properties : 
    properties :
     x : 204
     y : 2
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         
         j est un entier
         i est une chaine
         restaure_bouton()
         lesformes.fnumero..etat = actif
         lesformes.saisieModifiable..etat = actif
         transactionactive = vrai
         ecranpremier("fnumero")
         onglet_forme = 2
         //Code WinDev 5.5 remplacé par la migration :
         //action..etat = grisé
         action..etat = grisé; action..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         //validation..etat = actif
         validation..etat = actif; validation..Visible=Vrai
         lAjout = vrai
         recordcourant = hsauveposition("forme")
         //htransactiondebut("forme.trx")
         
         hraz("forme")
         raz(faux)
         afficheimage()
         //hlAjoute("forme")
         //hinfogene("forme")
         //numeroderecord = h.numenr
         //hlit("forme",numeroderecord)
         //fichierversecran
         image1 = ""
         pour j = 1 a 16
         	i = sansespace(numeriqueverschaine(j,"2d"))
         //Code WinDev 5.5 remplacé par la migration :
         //		{"lesformes.in"+i}..etat = actif
         		{"lesformes.in"+i}..etat = actif; {"lesformes.in"+i}..Visible=Vrai
         //		{"lesformes.ordre"+i}..etat = actif
         //        si pas {"lesformes.cap"+i}..note = "Ne pas afficher" alors
         //		  {"lesformes.cap"+i}..etat = actif
         //	    fin	
         
         FIN
         
         //Code WinDev 5.5 remplacé par la migration :
         //onglet_forme[1]..etat = grisé
         onglet_forme[1]..etat = grisé; onglet_forme[1]..Visible=Vrai
         
        type : 18
      -
        type : 161
        enabled : false
