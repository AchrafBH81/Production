  -
    name : BTN_MODIFIE
    identifier : 0x3e9d90e11fedf91f
    internal_properties : 
    properties :
     x : 253
     y : 3
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         j est un entier
         i est une chaine
         formeposition = hsauveposition("forme")
         restaure_bouton()
         lesformes.saisieModifiable..etat = actif
         lesformes.fnumero..etat = GRISÉ
         transactionactive = vrai
         lModif = vrai
         //htransactiondebut("forme.trx","forme")
         //Code WinDev 5.5 remplacé par la migration :
         //interup..etat = actif
         interup..etat = actif; interup..Visible=Vrai
         //fichierversecran("LESFORMES","forme")
         ecranpremier("TDESCRIPTION")
         onglet_forme = 2
         //Code WinDev 5.5 remplacé par la migration :
         //action..etat = grisé
         action..etat = grisé; action..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         //validation..etat = actif
         validation..etat = actif; validation..Visible=Vrai
         afficheimage()
         hlit("forme",hnumenrencours)
         pour j = 1 a 16
         	i = sansespace(numeriqueverschaine(j,"2d"))
         	si {"lesformes.in"+i} alors
         //Code WinDev 5.5 remplacé par la migration :
         //		{"lesformes.saisie"+i}..etat = actif
         		{"lesformes.saisie"+i}..etat = actif; {"lesformes.saisie"+i}..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         //		{"lesformes.ordre"+i}..etat = actif
         		{"lesformes.ordre"+i}..etat = actif; {"lesformes.ordre"+i}..Visible=Vrai
                si pas {"lesformes.cap"+i}..note = "Ne pas afficher" alors
         //Code WinDev 5.5 remplacé par la migration :
         //		{"lesformes.cap"+i}..etat = actif
         		{"lesformes.cap"+i}..etat = actif; {"lesformes.cap"+i}..Visible=Vrai
         	   fin	
         	sinon
         //Code WinDev 5.5 remplacé par la migration :
         //		{"lesformes.saisie"+i}..etat = grise
         		{"lesformes.saisie"+i}..etat = grise; {"lesformes.saisie"+i}..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         //		{"lesformes.ordre"+i}..etat = grise
         		{"lesformes.ordre"+i}..etat = grise; {"lesformes.ordre"+i}..Visible=Vrai
                si pas {"lesformes.cap"+i}..note = "Ne pas afficher" alors
         //Code WinDev 5.5 remplacé par la migration :
         //		{"lesformes.cap"+i}..etat = grise
         //		{"lesformes.cap"+i}..etat = grise; {"lesformes.cap"+i}..Visible=Vrai
                fin			
         	FIN
         FIN
         
         //Code WinDev 5.5 remplacé par la migration :
         //onglet_forme[1]..etat = grisé
         onglet_forme[1]..etat = grisé; onglet_forme[1]..Visible=Vrai
         reprisesaisie(lesformes.ONGLET_FORME.tdescription)
        type : 18
      -
        type : 161
        enabled : false
