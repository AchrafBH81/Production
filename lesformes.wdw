   -
     name : validechamp
     procedure_id : 4511921702212075192
     type_code : 14
     code : |1+
      Procédure validechamp()
      valeuraretourner est un booleen = vrai
      j est un entier 
      i est une chaine
      
      pour j = 1 a 16
          i = sansespace(numeriqueverschaine(j,"2d"))
      	si {"lesformes.in"+i} alors
      //Code WinDev 5.5 remplacé par la migration :
      //		si {"lesformes.saisie"+i}..ligne < lesformes.image1..ligne ...
      		si {"lesformes.saisie"+i}..y < lesformes.image1..y ...
      //Code WinDev 5.5 remplacé par la migration :
      //			ou {"lesformes.saisie"+i}..ligne +{"lesformes.saisie"+i}..hauteur > ...
      			ou {"lesformes.saisie"+i}..y +{"lesformes.saisie"+i}..hauteur > ...
      //Code WinDev 5.5 remplacé par la migration :
      //			 lesformes.image1..ligne +lesformes.image1..hauteur  alors
      			 lesformes.image1..y +lesformes.image1..hauteur  alors
      
      			valeuraretourner = faux
      		FIN
      //Code WinDev 5.5 remplacé par la migration :
      //		si {"lesformes.saisie"+i}..colonne < lesformes.image1..colonne ...
      		si {"lesformes.saisie"+i}..x < lesformes.image1..x ...
      //Code WinDev 5.5 remplacé par la migration :
      //			ou {"lesformes.saisie"+i}..colonne +{"lesformes.saisie"+i}..largeur > ...
      			ou {"lesformes.saisie"+i}..x +{"lesformes.saisie"+i}..largeur > ...
      //Code WinDev 5.5 remplacé par la migration :
      //			 lesformes.image1..colonne +lesformes.image1..largeur  alors
      			 lesformes.image1..x +lesformes.image1..largeur  alors
      
      			valeuraretourner = faux
      		FIN
      		
      		
      	FIN
      FIN
      
      renvoyer valeuraretourner
      
     type : 458752
   -
     name : valideordrevide
     procedure_id : 4511921703755185868
     type_code : 14
     code : |1+
      Procédure valideordrevide()
      valeuraretourner est un booleen = vrai
      j est un entier 
      i est une chaine
      
      pour j = 1 a 16
          i = sansespace(numeriqueverschaine(j,"2d"))
      	si {"lesformes.in"+i} alors
              
      		si {"lesformes.ordre"+i} = 0
      			valeuraretourner = faux
      		FIN
      	
      	FIN
      FIN
      
      renvoyer valeuraretourner
      
     type : 458752
   -
     name : valide_ordre
     procedure_id : 4511921702157156054
     type_code : 14
     code : |1+
      Procédure valide_ordre(nomchamp,champ,numero)
      valeuraretourner est un booleen = vrai
      j est un entier
      i est une chaine
      pour j = 1 a 16
      	i = sansespace(numeriqueverschaine(j,"2d"))
          si pas {"lesformes.ordre"+i}..nom = nomchamp alors
      	si {"lesformes.ordre"+i} = champ alors
      		acso_message("Erreur","Cet ordre existe déja","Erreur")
              reprisesaisie
          FIN
      	fin
      FIN
      
      renvoyer valeuraretourner
      
     type : 458752
