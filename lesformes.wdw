      //	   lesformes.saisie15..y =forme.spositiony+ lesformes.image1..y
      //sinon
      ////Code WinDev 5.5 remplacé par la migration :
      ////      lesformes.saisie15..ligne =lesformes.in15..ligne 
      //      lesformes.saisie15..y =lesformes.in15..y 
      ////Code WinDev 5.5 remplacé par la migration :
      ////      lesformes.saisie15..colonne =lesformes.in15..colonne - 100
      //      lesformes.saisie15..x =lesformes.in15..x - 100
      //	
      //FIN
      //si  lesformes.in16 alors
      ////Code WinDev 5.5 remplacé par la migration :
      ////	   lesformes.saisie16..colonne = forme.fpositionx+ lesformes.image1..colonne
      //	   lesformes.saisie16..x = forme.fpositionx+ lesformes.image1..x
