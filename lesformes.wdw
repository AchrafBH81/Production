   -
     name : LACHEGAUCHE
     procedure_id : 4511921702920519241
     type_code : 14
     code : |1+
      Procédure LACHEGAUCHE()
      lechamp = sansespace(_eve.nom)
      //Code WinDev 5.5 remplacé par la migration :
      //CUBE..VISIBLE = FAUX
      CUBE..Visible=Faux
      //Code WinDev 5.5 remplacé par la migration :
      //CARRE..VISIBLE = FAUX
      CARRE..Visible=Faux
      RECTANGLE(glisser.posx,glisser.posy,...
                glisser.posx+glisser.largeur,...
      		  glisser.posy+glisser.hauteur)
      {"lesformes."+lechamp}..curseursouris = curfleche
      //Code WinDev 5.5 remplacé par la migration :
      //{"lesformes."+lechamp}..etat = actif
      {"lesformes."+lechamp}..etat = actif; {"lesformes."+lechamp}..Visible=Vrai
      finevenement(numeroevenement3)
      CURSEURCAPTURE(FAUX)
      //Code WinDev 5.5 remplacé par la migration :
      //{"lesformes."+lechamp}..ligne = glisser.posy
      {"lesformes."+lechamp}..y = glisser.posy + image1..y + 2
      //Code WinDev 5.5 remplacé par la migration :
      //{"lesformes."+lechamp}..colonne = glisser.posx
      {"lesformes."+lechamp}..x = glisser.posx + image1..x + 2
      
      //CHAMPSAISIE..ETAT = 
      finevenement(numeroevenement2)
      
     type : 458752
   -
     name : RECTANGLE
     procedure_id : 4511921703289749085
     type_code : 14
     code : |1+
      procedure Rectangle(X1,Y1, X2, Y2)
      // Trace un cadre en XOR
      // Pour effacer ce cadre, il suffit d'appeler à nouveau cette routine avec
      // les mêmes paramètres
      
      Rect	est compose de
      //Code WinDev 5.5 remplacé par la migration :
      //	RX1	est un entier
      	RX1	est un entier sur 2 octets
      //Code WinDev 5.5 remplacé par la migration :
      //	RY1	est un entier
      	RY1	est un entier sur 2 octets
      //Code WinDev 5.5 remplacé par la migration :
      //	RX2	est un entier
      	RX2	est un entier sur 2 octets
      //Code WinDev 5.5 remplacé par la migration :
      //	RY2	est un entier
      	RY2	est un entier sur 2 octets
      fin
      hDC	est un entier systeme
      
      	
      Rect32	est compose de
      //Code WinDev 5.5 remplacé par la migration :
      //	RX132	est un entier long
      	RX132	est un entier  
      //Code WinDev 5.5 remplacé par la migration :
      //	RY132	est un entier long
      	RY132	est un entier  
      //Code WinDev 5.5 remplacé par la migration :
      //	RX232	est un entier long
      	RX232	est un entier  
      //Code WinDev 5.5 remplacé par la migration :
      //	RY232	est un entier long
      	RY232	est un entier  
      fin
      //Code WinDev 5.5 remplacé par la migration :
      //hDC32	est un entier long
      hDC32	est un entier  systeme
      
      
      si VersionWindows()="32" alors	
      	Rect32.RX132=X1; Rect32.RY132=Y1; Rect32.RX232=X2; Rect32.RY232=Y2
      	hDC32=sysrecuperedc(handle(image1))
      	appelDLL32("User32","DrawFocusRect",hDC32,&Rect32)
      	appeldll32("User32","ReleaseDC",0,hDC32)
      sinon
      	Rect.RX1=X1; Rect.RY1=Y1; Rect.RX2=X2; Rect.RY2=Y2
      	hDC=sysrecuperedc(handle(""))
      //Code WinDev 5.5 remplacé par la migration :
      //	appelDLL("USER","DrawFocusRect",hDC,&Rect)
      // Votre programme utilise ici une commande 16 bits. 
      // Cette version ne permet que des exécutables 32 bits.
      // 	appelDLL("USER","DrawFocusRect",hDC,&Rect)
      // Code lAjouté par la migration
      Erreur("Votre programme utilise ici une commande 16 bits. Cette version ne permet que des exécutables 32 bits.")
      
      //Code WinDev 5.5 remplacé par la migration :
      //	appeldll("User","ReleaseDC",0,hDC)
      // Votre programme utilise ici une commande 16 bits. 
      // Cette version ne permet que des exécutables 32 bits.
      // 	appeldll("User","ReleaseDC",0,hDC)
      // Code lAjouté par la migration
      Erreur("Votre programme utilise ici une commande 16 bits. Cette version ne permet que des exécutables 32 bits.")
      
      fin
      
     type : 458752
   -
     name : SHIFTCLICGAUCHE
     procedure_id : 4511921703502413445
     type_code : 14
     code : |1+
      Procédure SHIFTCLICGAUCHE()
      //lechamp est une chaine
      SI _eve.wparam = 5  ALORS
      
      	lechamp = sansespace(_eve.nom)
          
      	
      	SI gauche(lechamp,6) = "SAISIE" et {lechamp}..ETAT = actif alors
      		
      		//glisser.posy = poidsfaible(curseurpos(CPFENETRE))
      		//glisser.posx = poidsfort(curseurpos(CPFENETRE))
      		numeroevenement2 = evenement("LACHEGAUCHE",".*",WM_LBUTTONUP)
      		numeroevenement3 = evenement("sourisbouge",".*",WM_mousemove)
      		
      		//CURSEURCAPTURE(HANDLE({"lesformes."+LECHAMP}))
      //		CHAMPSAISIE..ETAT = GRISÉ
      //		{lechamp}..etat = actif
      		//{"lesformes."+lechamp}..etat = ACTIF
      //		lesformes.carre..ligne = {"lesformes."+lechamp}..ligne
      //		lesformes.carre..colonne = {"lesformes."+lechamp}..colonne
      //		lesformes.carre..largeur = {"lesformes."+lechamp}..largeur
      //		lesformes.carre..hauteur = {"lesformes."+lechamp}..hauteur
      //Code WinDev 5.5 remplacé par la migration :
      //		 glisser.initx = poidsfaible(curseurpos(CPFENETRE)) - {"lesformes."+lechamp}..colonne 
      		 glisser.initx = poidsfaible(curseurpos(CPFENETRE)) - {"lesformes."+lechamp}..x 
      //Code WinDev 5.5 remplacé par la migration :
      //         glisser.inity = poidsfORT(curseurpos(CPFENETRE)) - {"lesformes."+lechamp}..ligne
               glisser.inity = poidsfORT(curseurpos(CPFENETRE)) - {"lesformes."+lechamp}..y
      		 
      //Code WinDev 5.5 remplacé par la migration :
      //		glisser.posy = {"lesformes."+lechamp}..ligne 
      		glisser.posy = {"lesformes."+lechamp}..y - image1..y - 2
      //Code WinDev 5.5 remplacé par la migration :
      //		glisser.posx = {"lesformes."+lechamp}..colonne 
      		glisser.posx = {"lesformes."+lechamp}..x  - image1..x - 2
      		glisser.largeur = {"lesformes."+lechamp}..largeur 
      		glisser.hauteur = {"lesformes."+lechamp}..hauteur 
      RECTANGLE(glisser.posx,glisser.posy,...
                glisser.posx+glisser.largeur,...
      		  glisser.posy+glisser.hauteur)
      		  
      					
      //		lesformes.blocg..ligne = {"lesformes."+lechamp}..ligne - 4 +({"lesformes."+lechamp}..hauteur / 2)
      //		lesformes.blocg..colonne = {"lesformes."+lechamp}..colonne - 8 
      //		lesformes.bloch..ligne = {"lesformes."+lechamp}..ligne - 8
      //		lesformes.bloch..colonne = {"lesformes."+lechamp}..colonne + (({"lesformes."+lechamp}..largeur - 8) / 2)
      //		lesformes.blocd..ligne = {"lesformes."+lechamp}..ligne - 4 +({"lesformes."+lechamp}..hauteur / 2)
      //		lesformes.blocd..colonne = {"lesformes."+lechamp}..colonne + {"lesformes."+lechamp}..largeur 
      //		lesformes.blocb..ligne = {"lesformes."+lechamp}..ligne + {"lesformes."+lechamp}..hauteur
      //		lesformes.blocb..colonne = {"lesformes."+lechamp}..colonne + (({"lesformes."+lechamp}..largeur - 8) / 2)
      		curseurcapture(vrai,handle(lechamp))
      		{"lesformes."+lechamp}..curseursouris = curtaille
      //		carre..etat = actif
      //		cube..etat = actif
      	fin
      FIN
      
     type : 458752
   -
     name : SOURISBOUGE
     procedure_id : 4511921703444610724
     type_code : 14
     code : |1+
      Procédure SOURISBOUGE()
      //Code WinDev 5.5 remplacé par la migration :
      //etatsouris est un entier long
      etatsouris est un entier  
      //lechamp est une chaine = _eve.nom
      //lesformes.carre..VISIBLE = FAUX
      RECTANGLE(glisser.posx,glisser.posy,...
                glisser.posx+glisser.largeur,...
      		  glisser.posy+glisser.hauteur)
       glisser.posx = poidsfaible(curseurpos(CPFENETRE)) - glisser.initx - image1..x - 2
       glisser.posy = poidsfORT(curseurpos(CPFENETRE))- glisser.inity - image1..y - 2
      //{"lesformes."+lechamp}..ligne = {"lesformes."+lechamp}..ligne + (glisser.posx - oldx)
      //{"lesformes."+lechamp}..colonne = {"lesformes."+lechamp}..colonne + (glisser.posy - oldy)
      // lesformes.carre..ligne = lesformes.carre..ligne + (glisser.posx - oldx)
      // lesformes.carre..colonne = lesformes.carre..colonne + (glisser.posy - oldy)
      RECTANGLE(glisser.posx,glisser.posy,...
                glisser.posx+glisser.largeur,...
      		  glisser.posy+glisser.hauteur)
      // lesformes.blocg..ligne = lesformes.blocg..ligne + (glisser.posx - oldx)
      // lesformes.blocg..colonne = lesformes.blocg..colonne + (glisser.posy - oldy)
      // lesformes.bloch..ligne = lesformes.bloch..ligne + (glisser.posx - oldx)
      // lesformes.bloch..colonne = lesformes.bloch..colonne + (glisser.posy - oldy)
      // lesformes.blocd..ligne = lesformes.blocd..ligne + (glisser.posx - oldx)
      // lesformes.blocd..colonne = lesformes.blocd..colonne + (glisser.posy - oldy)
      // lesformes.blocb..ligne = lesformes.blocb..ligne + (glisser.posx - oldx)
      // lesformes.blocb..colonne = lesformes.blocb..colonne + (glisser.posy - oldy)
      // lesformes.carre..etat = actif
      
