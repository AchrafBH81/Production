           p_codes :
            -
              code : |1+
               //repdonnees =inilit("donnees","donnees","vide",repencours+"THERMA.INI")+"formes"
               resultat est une chaine
               //repdonnees = completerep(repencours)+sansespace(config.Dossierforme)
               repdonnees =sansespace(config.Dossierforme)
               
               resultat = OUVRE("listfich",repdonnees,"*.jpg")
               si sansespace(resultat) <> "" alors
               	lesformes.fchemin = resultat
               fin
               lesformes.image1  = completerep(repdonnees)+lesformes.fchemin
              type : 18
