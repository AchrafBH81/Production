      //WM_RBUTTONUP EST UN ENTIER = 517
      //WM_NCRBUTTONDOWN EST UN ENTIER = 161
       formeposition est un entier
       lechamp est une chaine
       hlit(config,1)
       DossierForme est une chaine = completerep(config.Dossierforme)
       
       numeroevenement est un entier
       numeroevenement2 est un entier
       numeroevenement3 est un entier
       numeroevenement = evenement("SHIFTCLICGAUCHE",".*",WM_LBUTTONDOWN)
