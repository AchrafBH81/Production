  procedures :
   -
     name : AlimenteLanneemois
     procedure_id : 5161039700914617055
     type_code : 14
     code : |1+
      Procédure AlimenteLanneemois()
      lannee est une chaine
      lmois est une chaine
      lclient est une chaine
      lvendeur est un entier
      
      
      
      quand exception dans
      	hcreation(HistoAnneeMois)
      faire
      	ACSO_message("Erreur","Vous devez être le seul poste actif pour effectuer cette opération","Erreur")
      	renvoyer faux
      fin
      quand exception dans
      	hcreation(HistoAnneeMoisProduit)
      faire
      	ACSO_message("Erreur","Vous devez être le seul poste actif pour effectuer cette opération","Erreur")
      	renvoyer faux
      fin
      
      
      HLitPremier(BonLivraison,Bfacture)
      sablier(vrai)
      tantque pas hendehors(BonLivraison)
      	si BonLivraison.Bfacture <> 0  alors
      		ltotalbon = 0
      		ltotalsurcharge = 0
      		
      		lannee = BonLivraison.Bdatefacture..Année
      		lmois = BonLivraison.Bdatefacture..mois
      		lclient = sansespace(bonLivraison.Bclient)
      		lvendeur = BonLivraison.cvendeur
      		AlimenteAnneMoisProduit(BonLivraison.bnumero,lclient,lannee,remplir_zero(lmois,2),lannee+remplir_zero(lmois,2))
      		hraz(HistoAnneeMoisProduit)
      		
      		
      		//		SI HLitRecherche(HistoAnneeMois,lanneeMois,HConstruitValClé(HistoAnneeMois,lanneeMois,lclient,lannee,lmois)) ALORS
      		SI HLitRecherche(HistoAnneeMois,LvendeurClientAnneeMois,HConstruitValClé(HistoAnneeMois,LvendeurClientAnneeMois,lvendeur,lclient,lannee,lmois)) ALORS
      			//			si sansespace(BonLivraison.Bclient) = "003" et bonlivraison.BDateFacture > "20080229" alors
      			//				info(bonlivraison.Bfacture)
      			//				info(BonLivraison.bstotal)
      			//           info(ltotalbon+ltotalsurcharge)
      			//			FIN
      			//			si sansespace(BonLivraison.Bclient) = "003" et bonlivraison.BDateFacture > "20080331" alors
      			//				fEcritLigne(lid,ltotalbon+ltotalsurcharge)
      			//			FIN
      			HistoAnneeMois.lvente+= BonLivraison.BStotal
      			hmodifie(HistoAnneeMois,hNumEnrEnCours)
      		sinon
      			si BonLivraison.bstotal <> 0
      				HistoAnneeMois.hclient = lclient
      				HistoAnneeMois.lAnnee = lannee
      				HistoAnneeMois.lmois = lmois
      				HistoAnneeMois.cvendeur = lvendeur
      				HistoAnneeMois.lvente = BonLivraison.BStotal
      				//				si sansespace(BonLivraison.Bclient) = "003" et bonlivraison.BDateFacture > "20080331" alors
      				//					fEcritLigne(lid,ltotalbon+ltotalsurcharge)
      				//				FIN
      				hajoute(HistoAnneeMois)
      			FIN
      		fin
      	FIN
      	
      	
      	HLitSuivant(BonLivraison,Bfacture)
      	csnNoFacture = BonLivraison.Bfacture
      	MultitacheRepeint(whistoriquetrn)
      FIN
      
      sablier(faux)                      
      
     type : 458752
   -
     name : AlimenteAnneMoisProduit
     procedure_id : 5161039699610712799
     type_code : 14
     code : |1+
      Procédure AlimenteAnneMoisProduit(lNumeroBon,lclient,lannee,lmois,lperiode,lid=0)
      i est un entier
      ltotal est un reel
      ltotalsurchargepeinture est un reel = 0
      lMultiplicateur est un reel = 0
      
      HExécuteRequête(RequeteDetailfacture,hRequêteDéfaut,lNumeroBon)
      HLitPremier(RequeteDetailfacture)
      
      
      tantque pas HEnDehors(RequeteDetailfacture)
      	si requetedetailfacture.fsurchargepeinture <> 0 alors
      		ltotalsurchargepeinture=requetedetailfacture.fsurchargepeinture
      	FIN
      
      	si hlitrecherche(client,numero,RequeteDetailfacture.faclient) alors
      		selon client.CImpressionAngMet
      			cas 1
      				lMultiplicateur = 1
      			cas 2
      				lMultiplicateur = config.conversionam	
      		FIN
      		hlitrecherche(hfdetail,HFCLEUNIK,RequeteDetailfacture.HFCLEUNIK)
      		tantque  hfdetail.fdnocomm = RequeteDetailfacture.fanumero et pas hendehors(hfdetail)
      			selon hfdetail.ftype
      				cas 1
      					si hlitrecherche(HistoAnneeMoisProduit,hClientlComp1lcomp2lcomp3lAnneelmois,...
      						HConstruitValClé(HistoAnneeMoisProduit,hClientlComp1lcomp2lcomp3lAnneelmois,lclient,hfdetail.fdnumprod,hfdetail.fdcomposant1,...
      						hfdetail.fdcomposant2,hfdetail.fdcomposant3,lannee,lmois)) alors
      						HistoAnneeMoisProduit.lqte += hfdetail.fdqteafacturer
      						HistoAnneeMoisProduit.lpied += (hfdetail.fdpiedcarrefacture*lMultiplicateur*hfdetail.fdqteafacturer)
      						HistoAnneeMoisProduit.lvente +=  arrondi(hfdetail.fdqteafacturer * (hfdetail.fdpiedcarrefacture * hfdetail.fdprixupiedfacture),2)...
      						+ arrondi(hfdetail.fdqteafacturer * hfdetail.fdextraforme,2) + ...
      						arrondi(hfdetail.fdqteafacturer *(hfdetail.FDextra10X + hfdetail.FDextra5x),2)
      						HistoAnneeMoisProduit.lsurcharge +=  arrondi(hfdetail.surchargeenergie,2)
      						hmodifie(HistoAnneeMoisProduit,hNumEnrEnCours)
      					sinon
      						HistoAnneeMoisProduit.lperiode = lperiode
      						HistoAnneeMoisProduit.hClient = lclient
      						HistoAnneeMoisProduit.lAnnee = lannee
      						HistoAnneeMoisProduit.lmois = lmois
      						HistoAnneeMoisProduit.ldescription = hfdetail.fddesc
      						HistoAnneeMoisProduit.lProduit = hfdetail.fdnumprod
      						HistoAnneeMoisProduit.lComp1 = hfdetail.fdcomposant1
      						HistoAnneeMoisProduit.lComp2 = hfdetail.fdcomposant2
      						HistoAnneeMoisProduit.lComp3 = hfdetail.fdcomposant3
      						HistoAnneeMoisProduit.lsurcharge =  arrondi(hfdetail.surchargeenergie,2)
      						HistoAnneeMoisProduit.lqte = hfdetail.fdqteafacturer
      						HistoAnneeMoisProduit.ltype = "T"
      						HistoAnneeMoisProduit.lpied = (hfdetail.fdpiedcarrefacture*lMultiplicateur*hfdetail.fdqteafacturer)
      						HistoAnneeMoisProduit.lvente =  arrondi(hfdetail.fdqteafacturer * (hfdetail.fdpiedcarrefacture * hfdetail.fdprixupiedfacture),2)...
      						+ arrondi(hfdetail.fdqteafacturer * hfdetail.fdextraforme,2) + ...
      						arrondi(hfdetail.fdqteafacturer *(hfdetail.FDextra10X + hfdetail.FDextra5x),2)
      
      						si HistoAnneeMoisProduit.lvente <> 0 alors
      							hajoute(HistoAnneeMoisProduit)
      						fin
      					FIN
      //					si hfdetail.fdnocomm = 45896 alors
      //						info(arrondi(hfdetail.fdqteafacturer * ((hfdetail.fdpiedcarrefacture * hfdetail.fdprixupiedfacture)  + hfdetail.fdextraforme),2))
      //					FIN
      //					fecritligne(lid,NumériqueVersChaine(arrondi(hfdetail.fdqteafacturer * ((hfdetail.fdpiedcarrefacture * hfdetail.fdprixupiedfacture)  ...
      //					+ hfdetail.fdextraforme+hfdetail.FDextra10X + hfdetail.fdextra5x),2))+","+NumériqueVersChaine(arrondi(hfdetail.surchargeenergie,2)))
      					ltotalbon+=arrondi(hfdetail.fdqteafacturer * ((hfdetail.fdpiedcarrefacture * hfdetail.fdprixupiedfacture)  ...
      					+ hfdetail.fdextraforme+hfdetail.FDextra10X + hfdetail.fdextra5x),2)
      					ltotalsurcharge += arrondi(hfdetail.surchargeenergie,2)
      
      				cas 4
      					si hlitrecherche(HistoAnneeMoisProduit,hClientlComp1lcomp2lcomp3lAnneelmois,...
      						HConstruitValClé(HistoAnneeMoisProduit,hClientlComp1lcomp2lcomp3lAnneelmois,lclient,hfdetail.fdnumprod,"","","",lannee,lmois)) alors
      						HistoAnneeMoisProduit.lqte += hfdetail.fdqteafacturer * hfdetail.fdnbcarreau
      						HistoAnneeMoisProduit.lvente +=  arrondi(hfdetail.fdqteafacturer* ( hfdetail.frcarrprixu+hfdetail.fdcarrprixdebase),2)
      //						HistoAnneeMoisProduit.lsurcharge +=  0
      						HistoAnneeMoisProduit.lpied = 0
      						HistoAnneeMoisProduit.peinturecarrelage += arrondi(hfdetail.fdqteafacturer*((hfdetail.Ftotalcarreaupeinture*hfdetail.fPrixCarreauPeinture)+...
      						(hfdetail.FDnbcarreauPeinture1*hfdetail.fdprixcarreaupeinture1)),2)
      						hmodifie(HistoAnneeMoisProduit,hNumEnrEnCours)
      															
      					sinon
      						HistoAnneeMoisProduit.lperiode = lperiode
      						HistoAnneeMoisProduit.hClient = lclient
      						HistoAnneeMoisProduit.lAnnee = lannee
      						HistoAnneeMoisProduit.lmois = lmois
      						HistoAnneeMoisProduit.ldescription = hfdetail.fddesc
      						HistoAnneeMoisProduit.lComp1 = ""
      						HistoAnneeMoisProduit.lComp2 = ""
      						HistoAnneeMoisProduit.lComp3 = ""
      						HistoAnneeMoisProduit.lProduit = hfdetail.fdnumprod
      						HistoAnneeMoisProduit.lsurcharge =  0
      						HistoAnneeMoisProduit.lpied = 0
      						HistoAnneeMoisProduit.lqte = hfdetail.fdqteafacturer  * hfdetail.fdnbcarreau
      						HistoAnneeMoisProduit.lType = "C"
      						HistoAnneeMoisProduit.lvente =  arrondi(hfdetail.fdqteafacturer* ( hfdetail.frcarrprixu+hfdetail.fdcarrprixdebase),2)
      						HistoAnneeMoisProduit.peinturecarrelage = arrondi(hfdetail.fdqteafacturer*((hfdetail.Ftotalcarreaupeinture*hfdetail.fPrixCarreauPeinture)+...
      						(hfdetail.FDnbcarreauPeinture1*hfdetail.fdprixcarreaupeinture1)),2)
      						si HistoAnneeMoisProduit.lvente <> 0 alors
      							hajoute(HistoAnneeMoisProduit)
      						fin
      
      					FIN
                           
      //					si hfdetail.fdnocomm = 45896 alors
      //						info(arrondi(hfdetail.fdcarrprixtotal,2))
      //						info(arrondi(hfdetail.fTotalPeinture * hfdetail.fdqteafacturer,2))
      //					FIN
      					ltotalbon+=  arrondi(hfdetail.fdqteafacturer* ( hfdetail.frcarrprixu+hfdetail.fdcarrprixdebase),2)
      					ltotalbon+=  arrondi(hfdetail.fdqteafacturer*((hfdetail.Ftotalcarreaupeinture*hfdetail.fPrixCarreauPeinture)+...
      					(hfdetail.FDnbcarreauPeinture1*hfdetail.fdprixcarreaupeinture1)),2)
      //					fecritligne(lid,NumériqueVersChaine(arrondi(hfdetail.fdqteafacturer* ( hfdetail.frcarrprixu+hfdetail.fdcarrprixdebase),2))+","+...
      //					NumériqueVersChaine(arrondi(hfdetail.fdqteafacturer*((hfdetail.Ftotalcarreaupeinture*hfdetail.fPrixCarreauPeinture)+...
      //					(hfdetail.FDnbcarreauPeinture1*hfdetail.fdprixcarreaupeinture1)),2)))
      					
      					//					ltotalsurcharge += arrondi(hfdetail.surchargeenergie,2)
      				autre cas
      					si hfdetail.fdverreunite alors
      						si hlitrecherche(HistoAnneeMoisProduit,hClientlComp1lcomp2lcomp3lAnneelmois,...
      							HConstruitValClé(HistoAnneeMoisProduit,hClientlComp1lcomp2lcomp3lAnneelmois,lclient,hfdetail.fdnumprod,"","","",lannee,lmois)) alors
      							HistoAnneeMoisProduit.lqte += hfdetail.fdqteafacturer
      							HistoAnneeMoisProduit.lpied = 0
      							HistoAnneeMoisProduit.lvente +=  arrondi(hfdetail.fdqteafacturer * ((hfdetail.fdpiedcarrefacture * hfdetail.fdprixupiedfacture)  + hfdetail.fdextraforme),2)
      							HistoAnneeMoisProduit.lsurcharge +=  arrondi(hfdetail.surchargeenergie,2)
      							hmodifie(HistoAnneeMoisProduit,hNumEnrEnCours)
      						sinon
      							HistoAnneeMoisProduit.lperiode = lperiode
      							HistoAnneeMoisProduit.hClient = lclient
      							HistoAnneeMoisProduit.lAnnee = lannee
      							HistoAnneeMoisProduit.lmois = lmois
      							HistoAnneeMoisProduit.ldescription = hfdetail.fddesc
      							HistoAnneeMoisProduit.lComp1 = ""
      							HistoAnneeMoisProduit.lComp2 = ""
      							HistoAnneeMoisProduit.lComp3 = ""
      							HistoAnneeMoisProduit.lProduit = hfdetail.fdnumprod
      							HistoAnneeMoisProduit.lsurcharge =  arrondi(hfdetail.surchargeenergie,2)
      							HistoAnneeMoisProduit.lqte = hfdetail.fdqteafacturer
      							HistoAnneeMoisProduit.lType = ""
      							HistoAnneeMoisProduit.lpied = 0
      							HistoAnneeMoisProduit.lvente =  arrondi(hfdetail.fdqteafacturer * ((hfdetail.fdpiedcarrefacture * hfdetail.fdprixupiedfacture)  + hfdetail.fdextraforme),2)
      							HistoAnneeMoisProduit.peinturecarrelage = 0
      							si HistoAnneeMoisProduit.lvente <> 0 alors
      								hajoute(HistoAnneeMoisProduit)
      							fin		
      						FIN
      						ltotalbon+= arrondi(hfdetail.fdqteafacturer * ((hfdetail.fdpiedcarrefacture * hfdetail.fdprixupiedfacture)  + hfdetail.fdextraforme),2)
      						ltotalsurcharge += arrondi(hfdetail.surchargeenergie,2)
      		//				fecritligne(lid,NumériqueVersChaine(arrondi(hfdetail.fdqteafacturer * ((hfdetail.fdpiedcarrefacture * hfdetail.fdprixupiedfacture)  + hfdetail.fdextraforme),2))+","+...
      		//				NumériqueVersChaine(arrondi(hfdetail.surchargeenergie,2)))
      					
      						
      					sinon
      						si hlitrecherche(HistoAnneeMoisProduit,hClientlComp1lcomp2lcomp3lAnneelmois,...
      							HConstruitValClé(HistoAnneeMoisProduit,hClientlComp1lcomp2lcomp3lAnneelmois,lclient,hfdetail.fdnumprod,"","","",lannee,lmois)) alors
      							HistoAnneeMoisProduit.lqte += hfdetail.fdqteafacturer
      							si hfdetail.ftype = 5 alors
      								HistoAnneeMoisProduit.lvente +=  arrondi(hfdetail.fdqteafacturer * hfdetail.fdpiedcarrefacture*hfdetail.fdprixupied,2)//+RequeteDetailfacture.fsurchargepeinture
      //								fecritligne(lid,NumériqueVersChaine( arrondi(hfdetail.fdqteafacturer *  hfdetail.fdpiedcarrefacture*hfdetail.fdprixupied,2)))//+","+NumériqueVersChaine(HistoAnneeMoisProduit.lsurcharge)+","+...
      								ltotalbon+=  arrondi(hfdetail.fdqteafacturer * hfdetail.fdpiedcarrefacture*hfdetail.fdprixupied,2)
      							sinon
      							
      								HistoAnneeMoisProduit.lvente +=  arrondi(hfdetail.fdqteafacturer * hfdetail.fdprixu,2)//+RequeteDetailfacture.fsurchargepeinture
      								ltotalbon+=arrondi(hfdetail.fdqteafacturer * hfdetail.fdprixu,2)//+RequeteDetailfacture.fsurchargepeinture
      //								fecritligne(lid,NumériqueVersChaine( arrondi(hfdetail.fdqteafacturer * hfdetail.fdprixu,2)))//+","+NumériqueVersChaine(HistoAnneeMoisProduit.lsurcharge)+","+...
      							FIN
      //							HistoAnneeMoisProduit.lsurcharge +=  arrondi(hfdetail.surchargeenergie,2)
      							si ltotalsurchargepeinture <> 0 alors
      								HistoAnneeMoisProduit.lvente += ltotalsurchargepeinture
      								ltotalsurcharge+=ltotalsurchargepeinture
      								ltotalsurchargepeinture = 0
      							FIN
      							HistoAnneeMoisProduit.lpied = 0
      							hmodifie(HistoAnneeMoisProduit,hNumEnrEnCours)
      						sinon
      							HistoAnneeMoisProduit.lperiode = lperiode
      							HistoAnneeMoisProduit.hClient = lclient
      							HistoAnneeMoisProduit.lAnnee = lannee
      							HistoAnneeMoisProduit.lmois = lmois
      							HistoAnneeMoisProduit.ldescription = hfdetail.fddesc
      							HistoAnneeMoisProduit.lComp1 = ""
      							HistoAnneeMoisProduit.lComp2 = ""
      							HistoAnneeMoisProduit.lComp3 = ""
      							HistoAnneeMoisProduit.lProduit = hfdetail.fdnumprod
      							HistoAnneeMoisProduit.lsurcharge =  0
      							HistoAnneeMoisProduit.lpied = 0
      							//							HistoAnneeMoisProduit.lsurcharge =  arrondi(hfdetail.surchargeenergie,2)
      							HistoAnneeMoisProduit.lqte = hfdetail.fdqteafacturer
      							si hfdetail.ftype = 5 alors
      								HistoAnneeMoisProduit.lvente =  arrondi(hfdetail.fdqteafacturer *  hfdetail.fdpiedcarrefacture*hfdetail.fdprixupied,2)//+RequeteDetailfacture.fsurchargepeinture
      //								fecritligne(lid,NumériqueVersChaine( arrondi(hfdetail.fdqteafacturer *  hfdetail.fdpiedcarrefacture*hfdetail.fdprixupied,2)))//+","+NumériqueVersChaine(HistoAnneeMoisProduit.lsurcharge)+","+...
      								//NumériqueVersChaine(HistoAnneeMoisProduit.peinturecarrelage))							
      								ltotalbon+=  arrondi(hfdetail.fdqteafacturer * hfdetail.fdpiedcarrefacture*hfdetail.fdprixupied,2)
      							sinon
      
      //								fecritligne(lid,NumériqueVersChaine( arrondi(hfdetail.fdqteafacturer * hfdetail.fdprixu,2)))//+","+NumériqueVersChaine(HistoAnneeMoisProduit.lsurcharge)+","+...
      								ltotalbon+=arrondi(hfdetail.fdqteafacturer * hfdetail.fdprixu,2)//+RequeteDetailfacture.fsurchargepeinture
      								HistoAnneeMoisProduit.lvente =  arrondi(hfdetail.fdqteafacturer * hfdetail.fdprixu,2)//+RequeteDetailfacture.fsurchargepeinture
      							FIN
      							
      							HistoAnneeMoisProduit.peinturecarrelage = 0
      							si HistoAnneeMoisProduit.lvente <> 0 alors
      								si ltotalsurchargepeinture <> 0 alors
      									HistoAnneeMoisProduit.lvente += ltotalsurchargepeinture
      									ltotalsurcharge+=ltotalsurchargepeinture
      									ltotalsurchargepeinture = 0
      								FIN
      								hajoute(HistoAnneeMoisProduit)
      							fin		
      						FIN
      						
      //						si hfdetail.fdnocomm = 45896 alors
      //							info(arrondi(hfdetail.fdqteafacturer * hfdetail.fdprixu,2))		
      //						FIN
      //						ltotalbon+=arrondi(hfdetail.fdqteafacturer * hfdetail.fdprixu,2)//+RequeteDetailfacture.fsurchargepeinture
      					fin
      
      			FIN
      //            fecritligne(lid,NumériqueVersChaine(HistoAnneeMoisProduit.lvente)+","+NumériqueVersChaine(HistoAnneeMoisProduit.lsurcharge)+","+...
      //            NumériqueVersChaine(HistoAnneeMoisProduit.peinturecarrelage))
      			hlitsuivant(hfdetail,HFCLEUNIK)
      
      		fin	
      	fin
      
      	hlitsuivant(RequeteDetailfacture)
      FIN
      
      
      
