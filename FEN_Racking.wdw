     p_codes :
      -
        code : |1+
         tabOneRack.Déplace(22,5)
         tabOneRack.Déplace(23,6)
         tabOneRack.Déplace(24,7)
         
         
         GRF_Rack.CouleurSérie(1,VertFoncé)
         grDessine(GRF_Rack)
        type : 18
