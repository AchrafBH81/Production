         SAI_SansNom1 = ARBRE_Rack.select()
         
         si ChaîneOccurrence(sai_sansnom1,tab) > 0 alors
         	ExécuteTraitement(BTN_Recupere,trtclic)
         //	ExécuteTraitement(BTN_Centrer_un_rack,trtclic) //GRF_Rack..dessine())
         sinon
         	pour i = 1 a nMaximumRack
         		tabOneRack[i] = 0
         	FIN
         	GRF_Rack.dessine()
         	TABLE_TabOneRack.SupprimeTout()
         	nNoCamion	= Milieu(ExtraitChaîne(SAI_SansNom1,1,TAB),7)
         FIN
         FillrackAuMur(gsSelectedTreeDate,nNoCamion)
         
         
        type : 33
      -
        code : |1-
         
         SAI_SansNom1 = ARBRE_Rack.Select()
         nTruckNumber est un entier	= Milieu(ExtraitChaîne(SAI_SansNom1,1,TAB),7)
         SI ChaîneOccurrence(SAI_SansNom1,TAB) > 0 ALORS
         	MENU_InsertRack.OPT_InsertBefore..Etat = actif
         	checkIfEmptyRack()
         	OuvreMenuContextuel(MENU_InsertRack)
         sinon
         	si gtaAllTruckrack[nTruckNumber].taAllTruckRack..occurrence = 0 alors
         		MENU_InsertRack.OPT_InsertBefore..etat = grise
         		MENU_InsertRack.OPT_Supprimer_un_rack..etat = grise
         		OuvreMenuContextuel(MENU_InsertRackForEmptyTruck)
         	FIN
         FIN
