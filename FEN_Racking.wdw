    name : BTN_Optimise
    identifier : 0x271d5f463dcb6c34
    internal_properties : 
    properties :
     x : 1524
     y : 154
     width : 80
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         SI SAI_SansNom1 = 0 ALORS RENVOYER Vrai
         lastWidth est un entier = tabOneRack[1]
         pour i = 2 a 25
         	si tabonerack[i] <> 0 alors
         		si tabonerack[i] < lastWidth alors
         			info(tabOneRack[i])
         		sinon
         			lastWidth  = tabOneRack[i]
         			
         		FIN
         	FIN
         FIN
         
        type : 18
