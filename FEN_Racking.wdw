        enabled : false
      -
        type : 25
        enabled : false
      -
        code : |1+
         si ToucheEnfoncée(teAlt) alors
         	sSelectedcustomer est une chaine = TABLE_TabOneRack[TABLE_TabOneRack].COL_Customer
         	TableSelectMoins(TABLE_TabOneRack)
         	pour chaque ligne de TABLE_TabOneRack
         		si TABLE_TabOneRack.COL_Customer = sSelectedcustomer alors
         			TABLE_TabOneRack.SelectPlus(TABLE_TabOneRack)
         		FIN
         	FIN
         FIN
         
        type : 33
