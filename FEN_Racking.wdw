 message_bar :
  internal_properties : CQAAAAkAAAAjFWXItEk/EPvcbGR+hALkgRfdOpVtIn+yZNxHnmSRFJegE/AnD2HbGAaMfhGCqfzkryHG9FVhjtF+iQYkZ59QBQ88Okhh0vjCoVhOagox2hvIqrJnU30QK15/ZA==
 actionbar : {}
 code_elements :
  type_code : 1
  p_codes :
   -
     internal_properties : CQAAAAkAAAAMKk0bUnppf9n/DdIx+pD12FdjGBpDdPouTXmKpwRX8VSK7s3EyvfwpbA1UoOIDFhQRWUvEtPmaHQL3DqP9EYkvNp92ZaY8pL88p/fEQhlXNEtBTP55g==
     code : |1-
      // Traitement automatique des exceptions :   exécuter le bloc de code CAS EXCEPTION:
      //
      PROCEDURE MaFenêtre()
      
      CONSTANTE
      DLL_NOM						= "lpsolve55.dll"
      	// MODES VERBEUX ======================================================================================================
      	CST_VERBOSE_NEUTRAL			= 0  	//Only some specific debug messages in de debug print routines are reported.
      	CST_VERBOSE_CRITICAL		= 1 	//Only critical messages are reported. Hard errors like instability, out of memory, ...
      	CST_VERBOSE_SEVERE			= 2 	//Only severe messages are reported. Errors.
      	CST_VERBOSE_IMPORTANT		= 3 	//Only important messages are reported. Warnings and Errors.
      	CST_VERBOSE_NORMAL			= 4		//Normal messages are reported. This is the default.
      	CST_VERBOSE_DETAILED		= 5 	//Detailed messages are reported. Like model size, continuing B&B improvements, ...
      	CST_VERBOSE_FULL			= 6 	//All messages are reported. Useful for debugging purposes and small models.
      	//====================================================================================================================
      	// VALEURS RENVOYEES PAR LA FONCTION solve :
      	CST_RES_NOMEMORY			= -2		//Out of memory
      	CST_RES_OPTIMAL				= 0			//An optimal solution was obtained
      	CST_RES_SUBOPTIMAL			= 1			//The model is sub-optimal. Only happens if there are integer variables and there is already an integer solution found. The solution is not guaranteed the most optimal one.
      	CST_RES_INFEASIBLE			= 2			//The model is infeasible
      	CST_RES_UNBOUNDED			= 3			//The model is unbounded
      	CST_RES_DEGENERATE			= 4			//The model is degenerative
      	CST_RES_NUMFAILURE			= 5			//Numerical failure encountered
      	CST_RES_USERABORT			= 6			//The abort routine returned TRUE. See put_abortfunc
      	CST_RES_TIMEOUT				= 7			//A timeout occurred. A timeout was set via set_timeout
      	CST_RES_PRESOLVED			= 9			//The model could be solved by presolve. This can only happen if presolve is active via set_presolve
      	CST_RES_PROCFAIL			= 10		//The B&B routine failed
      	CST_RES_PROCBREAK			= 11		//The B&B was stopped because of a break-at-first (see set_break_at_first) or a break-at-value (see set_break_at_value)
      	CST_RES_FEASFOUND			= 12		//A feasible B&B solution was found
      	CST_RES_NOFEASFOUND			= 13		//No feasible B&B solution found
      FIN
      nNoCamion					est un entier	
      nNoRack						est un entier	
      gsSelectedTreeDate est une chaîne
      
      tabOneRack					est un tableau de nMaximumRack réel
      gtabTemporaryOneRack est un tableau de nMaximumRack reel
      gtabCurrentRackAdjustment	est un tableau de stOrder
      
      gtaAllRack					est un tableau associatif (*, *, wlEntier) de STAllrack
      gtaAllTruckrack				est un tableau associatif (*, *, wlEntier) de STAllTruck
      gtaAllDate est un tableau associatif de STAllDate
      
      gstCurrenttruckTriplerack est un STAllrack
      
      gtaRealNumberOfSlot est un tableau associatif d'entiers
      
      pour i = 1 a 41 
      	gtaRealNumberOfSlot[i] = i
      FIN
      gtaRealNumberOfSlot[42] = 42
      gtaRealNumberOfSlot[43] = 42
      gtaRealNumberOfSlot[44] = 43
      gtaRealNumberOfSlot[45] = 43
      gtaRealNumberOfSlot[46] = 44
      gtaRealNumberOfSlot[47] = 44
      
      gnCurrentmasterRack est un entier
      
      CAS EXCEPTION:
      	erreur(ExceptionInfo(errMessage))
      	
   -
     code : |1+
      ExécuteTraitement(CAL_Rack,trtselection)
     type : 34
   -
     type : 180
     enabled : false
   -
     type : 230
     enabled : false
  procedures :
   -
     name : CenterRack
     procedure_id : 1665593458970324905
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] CenterRack (<stCurrentrack> est STAllrack)
      //
      // Paramètres :
      //	stCurrentrack (STAllrack) : <indiquez ici le rôle de tabCurrentrack>
      // Valeur de retour :
      // 	STAllrack : <indiquez ici le rôle de la valeur de retour>
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure CenterRack(stCurrentrack est un stallrack)
      si stCurrentrack.tabCurrentOrder..occurrence + stCurrentrack.nNumberOfTriple = nMaximumRack alors renvoyer stCurrentrack
      TABLE_CenterRack.supprimetout()
      pour i = 1 a nMaximumRack
      	TABLE_CenterRack.AjouteLigne()
      FIN
      pour chaque stCurrentOrder,nKeyOrder de  stCurrentrack.tabCurrentOrder
      	si stCurrentOrder.nRackLineNumber <> 0 alors
      		TABLE_CenterRack[stCurrentOrder.nRackLineNumber].COL_Width	= stCurrentOrder.nLargeur
      		TABLE_CenterRack[stCurrentOrder.nRackLineNumber].COL_RackID	= nKeyOrder
      	FIN
      FIN
      
      
      
      nLowEmptyCell	est un entier	= 0
      nHighEmptyCell	est un entier	= nMaximumRack+1 
      nStartingCell	est un entier
      cpt				est un entier
      nCptEmptyCell	est un entier 
      nMaxCell		est un entier	= nHighEmptyCell-(stCurrentrack.nNumberOfTriple*2)
      
      
      
      
      pour i = 1 a 23
      	si TABLE_CenterRack[i].COL_Width = 0 alors
      		nLowEmptyCell = i
      	sinon
      		sortir
      	FIN
      FIN
      POUR i = nMaximumRack-(stCurrentrack.nNumberOfTriple*2) a 24 pas -1
      	nCptEmptyCell++
      	SI TABLE_CenterRack[i].COL_Width = 0 ALORS
      		nHighEmptyCell = i
      		
      	SINON
      		SORTIR
      	FIN
      FIN
      
      si ((nMaxCell-nHighEmptyCell)-nLowEmptyCell )/2 < 0 alors
      	nStartingCell = Arrondisupérieur(((nMaxCell-nHighEmptyCell)-nLowEmptyCell )/2)
      sinon
      	nStartingCell =  Arrondiinférieur(((nMaxCell-nHighEmptyCell)-nLowEmptyCell )/2)
      FIN
      
      si nStartingCell > 0 alors
      	
      	si nStartingCell > 0 alors
      		pour i = nHighEmptyCell-1 _a_ nLowEmptyCell+1 pas -1
      			TABLE_CenterRack.DéplaceLigne(i, i+nStartingCell,tdDéplace) 
      		FIN
      	sinon
      
      		
      		POUR i = nLowEmptyCell+1 _a_ nHighEmptyCell-1 
      			TABLE_CenterRack.DéplaceLigne(i, i+nStartingCell,tdDéplace) 
      		FIN
      		
      	fin
      	
      	tabOneRack.SupprimeTout()
      	POUR TOUTE LIGNE DE TABLE_CenterRack 
      		cpt++
      		tabOneRack.Ajoute(TABLE_CenterRack.COL_Width)
      		SI TABLE_CenterRack.COL_RackID <> 0 ALORS
      			
      			stCurrentrack.tabCurrentOrder[TABLE_CenterRack.COL_RackID].nRackLineNumber = cpt
      			
      		FIN
      	FIN
      	
      fin
      
      renvoyer stCurrentrack
      
      
      
     type : 458752
   -
     name : checkIfEmptySlot
     procedure_id : 1665593463265358159
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] checkIfEmptySlot (<NoRack> est entier)
      //
      // Paramètres :
      //	NoRack (entier) : <indiquez ici le rôle de Param1>
      // Valeur de retour :
      // 	multi-valeur : <indiquez ici le rôle de la valeur de retour>
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure checkIfEmptySlot(NoRack est un entier)
      nCPT est une entier
      nLowestEmpty est un entier
      nHighestEmpty est un entier
      nNbOfTriple est un entier = gtaAllRack[norack].nNumberOfTriple
      nMaxrack est un entier = nMaximumRack - (nNbOfTriple*2)
      
      
      
      pour i = 1 a nmaxrack
         si gtaAllRack[norack].OneRack[i]	= 0 alors
           si i < 23 alors
           	
           		nlowestempty = i
           	
           sinon
      			
      				si nHighestEmpty = 0 alors nHighestEmpty = i
      			
           FIN
           ncpt++
         sinon
      
         fin
         	
       FIN
       SI nHighestEmpty = 0 ALORS nHighestEmpty = 51
      renvoyer (ncpt,nLowestEmpty,nHighestEmpty)
     type : 458752
   -
     name : checkIfEmptySlotForTransfer
     procedure_id : 1665593463265423929
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] checkIfEmptySlotForTransfer (<nTruckNumber> est entier, <NoRack> est entier)
      //
      // Paramètres :
      //	nTruckNumber (entier) : <indiquez ici le rôle de nTruckNumber>
      //	NoRack (entier) : <indiquez ici le rôle de Param1>
      
      // Valeur de retour :
      // 	multi-valeur : <indiquez ici le rôle de la valeur de retour>
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure checkIfEmptySlotForTransfer(nTruckNumber est un entier,NoRack est un entier)
      
      nCPT est une entier
      nLowestEmpty est un entier
      nHighestEmpty est un entier
      
      pour i = 1 a nMaximumRack
         si gtaAllDate[gsSelectedTreeDate].taAllTruckrack[ntruckNumber].taAllTruckRack[norack].OneRack[i]	= 0 alors
           si i < 23 alors
           	
           		nlowestempty = i
           	
           sinon
      			
      				si nHighestEmpty = 0 alors nHighestEmpty = i
      			
           FIN
           ncpt++
         fin
         	
       FIN
      
      renvoyer (ncpt,nLowestEmpty,nHighestEmpty)
     type : 458752
   -
     name : FillrackAuMur
     procedure_id : 1665593463265489653
     type_code : 14
     code : |1-
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //FillrackAuMur (<sSelecteddate> est chaîne [, <nCurrentTruck> est entier])
      //
      // Paramètres :
      //	sSelecteddate (chaîne ANSI) : <indiquez ici le rôle de sSelecteddate>
      //	nCurrentTruck (entier - valeur par défaut=0) : <indiquez ici le rôle de nNoCamion>
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure FillrackAuMur(sSelecteddate est une chaîne, nCurrentTruck est un entier = 0)
      
      
      
      TABLE_Wallrack.SupprimeTout()
      nCurrentLine	est un entier 
      nCpt			est un entier
      
      gtaAllDate[sSelecteddate].taAllTruckrack[nCurrentTruck].tabRackAuMur.trie(ttmembre+tccRespecteNumérique,"CustomerNumber")
      pour chaque stOrder de gtaAllDate[sSelecteddate].taAllTruckrack[nCurrenttruck].tabRackAuMur
      	ncpt++
      	si pas storder.bTodelete alors
      //		pour i = 1 _a_ stOrder.nQuantity
      		ncurrentline										= TABLE_Wallrack.ajouteligne()
      		table_Wallrack[nCurrentLine].COL_CustomerNumber1	= storder.CustomerNumber
      		TABLE_Wallrack[nCurrentLine].COL_ShipTo             = stOrder.sShippingname
      		table_Wallrack[nCurrentLine].COL_OrderNumber1		= storder.OrderNumber
      		table_Wallrack[nCurrentLine].COL_Width1				= storder.nLargeur
      		table_Wallrack[nCurrentLine].COL_height1			= storder.nHauteur
      		table_Wallrack[nCurrentLine].COL_shape1				= storder.sShapeNumber
      		table_Wallrack[nCurrentLine].COL_IsTriple			= storder.bIstriple
      			TABLE_WallRack[nCurrentLine].COL_IsFinishOverMax	= stOrder.bFinishOverMax
      			table_Wallrack[nCurrentLine].COL_id					= ncpt
      	fin
      		
      //	FIN
      FIN
      
      TABLE_Wallrack.selectmoins()
     type : 458752
   -
     name : Recentrer
     procedure_id : 1665593463265555360
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //Recentrer (<tabCurrentrack> est tableau (stOrder))
      //
      // Paramètres :
      //	tabCurrentrack (tableau (stOrder)) : <indiquez ici le rôle de tabCurrentrack>
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure Recentrer(tabCurrentrack est un tableau de storder)
      si tabcurrentrack..Occurrence +  gtaAllDate[gsSelectedTreeDate].taAllTruckrack[nNoCamion].taAllTruckRack[nNoRack].nNumberOfTriple = nMaximumRack alors renvoyer vrai
      gsSelectedTreeDate = ExtraitChaîne(SAI_SansNom1,1)
      nNoCamion	= Milieu(extraitchaine(SAI_SansNom1,2,tab),7)
      nNoRack		= milieu(ExtraitChaîne(SAI_SansNom1,3,tab),5)
      
      SI nNoRack = 0 OU nNoCamion = 0 ou gsSelectedTreeDate = "" ALORS RENVOYER Vrai
      
      nLowEmptyCell	est un entier	= 0
      nHighEmptyCell	est un entier	= nMaximumRack+1
      nStartingCell	est un entier
      cpt				est un entier
      nCptEmptyCell	est un entier 
      nMaxCell		est un entier 
      nNumberOfTriple est un entier 
      si gtaAllDate[gsSelectedTreeDate].taAllTruckrack[nNoCamion].taAllTruckRack[nNoRack].bTripleOnly alors
      	nmaxcell = nHighEmptyCell
      	nNumberOfTriple = 0
      sinon
      	nNumberOfTriple =  gtaAllDate[gsSelectedTreeDate].taAllTruckrack[nNoCamion].taAllTruckRack[nNoRack].nNumberOfTriple
      	nMaxCell = nHighEmptyCell-( gtaAllDate[gsSelectedTreeDate].taAllTruckrack[nNoCamion].taAllTruckRack[nNoRack].nNumberOfTriple * 2)
      FIN
      
      pour i = 1 a 23
      	si TABLE_TabOneRack[i].COL_RackID = 0 alors
      		nLowEmptyCell = i
      	sinon
      		sortir
      	FIN
      FIN
      POUR i = (nMaximumRack- (nNumberOfTriple*2))  a 24 pas -1
      	nCptEmptyCell++
      	SI TABLE_TabOneRack[i].COL_RackID = 0 ALORS
      		nhighEmptyCell = i
      		
      	SINON
      		SORTIR
      	FIN
      FIN
      
      si ((nMaxCell-nHighEmptyCell)-nLowEmptyCell )/2 < 0 alors
      	nStartingCell = Arrondisupérieur(((nMaxCell-nHighEmptyCell)-nLowEmptyCell )/2)
      sinon
      	nStartingCell =  Arrondiinférieur(((nMaxCell-nHighEmptyCell)-nLowEmptyCell )/2)
      FIN
      
      si nStartingCell <> 0 alors
      	
      	si nStartingCell > 0 alors
      		pour i = nHighEmptyCell-1 _a_ nLowEmptyCell+1 pas -1
      			TABLE_TabOneRack.DéplaceLigne(i, i+nStartingCell,tdDéplace) 
      		FIN
      	sinon
      		POUR i = nLowEmptyCell+1 _a_ nHighEmptyCell-1 
      			TABLE_TabOneRack.DéplaceLigne(i, i+nStartingCell,tdDéplace) 
      		FIN
      		
      	fin
      	
      	tabOneRack.SupprimeTout()
      	POUR TOUTE LIGNE DE TABLE_TabOneRack 
      		cpt++
      		tabOneRack.Ajoute(TABLE_TabOneRack.COL_Width)
      		SI TABLE_TabOneRack.COL_RackID <> 0 ALORS
      			//		nRes est un entier = gtaAllRack[SAI_SansNom1].tabCurrentOrder.cherche(tcLinéaire,"nRackLineNumber",COL_RackID)
      			//		si nres <> -1 alors
      			 gtaAllDate[gsSelectedTreeDate].taAllTruckrack[nNoCamion].taAllTruckRack[nNoRack].tabCurrentOrder[TABLE_TabOneRack.COL_RackID].nRackLineNumber = cpt
      //			gtaAllRack[SAI_SansNom1].tabCurrentOrder[COL_RackID].nRackLineNumber = cpt
      			//		Fin
      			
      		FIN
      	FIN
      	POUR i = 1 a nMaximumRack
      //		TableAjouteLigne(TABLE_TabOneRack)
      		TABLE_TabOneRack[i].COL_Pos = gtaRealNumberOfSlot[i]
      	FIN
      	ExécuteTraitement(BTN_Dessine,trtClic)
      fin
      
      
      
      
     type : 458752
   -
     name : RegenerateOrderOnRack
     internal_properties : CQAAAAkAAAD3VeNQ54qxa/l1CRHx2/4mDGoCOQwOQBBFWuJVoLbFOViOyZOqZlWQ9O0OW+3wXLXWHuFKD+9UPchgxctbGtYduCmXnkkibreQ+Zr6XZrrtyVq/zfBl+A=
     procedure_id : 1665593467560588411
     type_code : 14
     code : |1-
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] RegenerateOrderOnRack (<tabCurrentOrder> est tableau (stOrder) [, <nNbTriple> est entier [, <bIstripleOnly> est booléen]])
      //
      // Paramètres :
      //	tabCurrentOrder (tableau (stOrder)) : <indiquez ici le rôle de tabCurrentOrder>
      //	nNbTriple (entier - valeur par défaut=0) : <indiquez ici le rôle de nNbTriple>
      // 	bIstripleOnly (booléen - valeur par défaut=0) : <indiquez ici le rôle de bIstripleOnly>
      
      // Valeur de retour :
      // 	STAllrack : <indiquez ici le rôle de la valeur de retour>
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //// Traitement automatique des exceptions :   exécuter le bloc de code CAS EXCEPTION:
      //
      
      procédure RegenerateOrderOnRack(tabCurrentOrder est un tableau de storder,nNbTriple est un entier = 0,bIstripleOnly est un booleen = faux)
      
      
      
      stCurrentmaster	est un STMasterOrder
      bLowHigh		est un booleen
      nCptlow			est un entier
      nCpthigh		est un entier
      stAllRAck		est un STAllrack
      nOldWidth		est un entier
      nNbSlots		est un entier
      nNextTripleSlot	est un entier 
      stAllRAck.nNumberOfTriple	= nnbtriple
      stAllRAck.bTripleOnly		= bIstripleOnly
      
      si bIstripleOnly alors
      	nNbSlots			= nMaximumRack
      	nNextTripleSlot		= 0
      sinon
      	nNbSlots			= nMaximumRack - (nnbtriple * 2)
      	nNextTripleSlot		= nNbSlots+1
      FIN
      
      
      
      pour chaque stCurrentOrder de tabCurrentOrder
      	si pas stCurrentOrder.bTodelete alors
      		nRes est un entier =  stCurrentmaster.tabLine.cherche(tcLinéaire,"OrderNumber;nOrderDetailLine",stcurrentorder.OrderNumber,stCurrentOrder.nOrderDetailLine) 
      		si nres <> -1 alors
      			stCurrentmaster.tabLine[nres].nQuantity += 1
      			
      		sinon
      			
      			stCurrentOrder.nQuantity = 1
      			stCurrentmaster.tabLine.Ajoute(stCurrentOrder)
      		FIN
      	Fin
      	
      FIN
      
      
      //nCptLow				= 23
      //nCpthigh			= 24 
      nCptLow				= ArrondiSupérieur(nnbslots/2)
      nCpthigh			= nCptlow+1
      
      
      
      stCurrentmaster.tabLine.Trie(ttMembre,"-nLargeur")
      POUR z = 1 _A_ stCurrentmaster.tabline..occurrence
      	
      	
      	si pas bIstripleOnly _et_ stCurrentmaster.tabline[z].bIstriple _ET_ stCurrentmaster.tabline[z].bFinishOverMax ALORS
      		POUR qt = 1 _a_ stCurrentmaster.tabline[z].nQuantity
      			stAllRAck.OneRack[nNextTripleSlot]												= stCurrentmaster.tabLine[z].nLargeur
      			stAllRAck.OneRackHauteur[nNextTripleSlot]										= stCurrentmaster.tabLine[z].nHauteur
      			stCurrentmaster.tabLine[z].nRackLineNumber										= nNextTripleSlot
      			stCurrentmaster.tabLine[z].nStickerNumber										= QT
      			stAllRAck.tabCurrentOrder.Ajoute(stCurrentmaster.tabLine[z])
      //			trace(nNextTripleSlot+":"+stCurrentmaster.tabLine[z].nLargeur+"/"+stCurrentmaster.tabLine[z].nhauteur)
      			nNextTripleSlot+=2
      		Fin
      		continuer
      		
      	FIN
      	si nOldWidth <> stCurrentmaster.tabLine[z].nLargeur alors
      		bLowHigh = PAS bLowHigh
      		
      	FIN
      	nOldWidth = stCurrentmaster.tabLine[z].nLargeur
      	
      	//			SI EstImpair(z) ALORS
      	SI bLowHigh ET stCurrentmaster.tabLine[z].nQuantity >  nCptLow ALORS
      		bLowHigh = Faux
      	SINON SI PAS bLowHigh ET stCurrentmaster.tabLine[z].nQuantity >  nNbSlots  - nCpthigh
      		bLowHigh = Vrai
      	FIN
      	SI bLowHigh ALORS
      		POUR q = 1 _a_ stCurrentmaster.tabline[z].nQuantity  
      			stCurrentmaster.tabLine[z].nStickerNumber								= q
      			SI nCptLow > 0 ALORS
      				
      				stallrack.OneRack[nCptLow]												= stCurrentmaster.tabLine[z].nLargeur
      				stAllRack.OneRackHauteur[nCptLow]										= stCurrentmaster.tabLine[z].nHauteur
      				stCurrentmaster.tabLine[z].nRackLineNumber								= nCptLow
      				stAllRack.tabCurrentOrder.Ajoute(stCurrentmaster.tabLine[z])
      				nCptLow--
      			SINON
      				stAllRack.OneRack[nCpthigh]												= stCurrentmaster.tabLine[z].nLargeur
      				stAllRack.OneRackHauteur[nCpthigh]										= stCurrentmaster.tabLine[z].nHauteur
      				stCurrentmaster.tabLine[z].nRackLineNumber								= nCpthigh
      				stAllRack.tabCurrentOrder.Ajoute(stCurrentmaster.tabLine[z])
      				nCpthigh++
      			FIN
      			stAllRack.bIsRackLiftShipping = stCurrentmaster.bIsRackLiftShipping
      			
      		FIN
      		stCurrentmaster.tabLine[z].bProcess	= Vrai
      		//					blowhigh					= faux
      	SINON
      		POUR q = 1 _a_ stCurrentmaster.tabline[z].nQuantity
      			stCurrentmaster.tabLine[z].nStickerNumber								= q
      			SI nCpthigh <= nNbSlots ALORS
      				stAllRack.OneRack[nCpthigh]												= stCurrentmaster.tabLine[z].nLargeur
      				stAllRack.OneRackHauteur[nCpthigh]										= stCurrentmaster.tabLine[z].nHauteur
      				stCurrentmaster.tabLine[z].nRackLineNumber								= nCpthigh
      				stAllRack.tabCurrentOrder.Ajoute(stCurrentmaster.tabLine[z])
      				nCpthigh++
      			SINON
      				
      				stAllRack.OneRack[nCptLow]												= stCurrentmaster.tabLine[z].nLargeur
      				stAllRack.OneRackHauteur[nCptLow]										= stCurrentmaster.tabLine[z].nHauteur
      				stCurrentmaster.tabLine[z].nRackLineNumber								= nCptLow
      				stAllRack.tabCurrentOrder.Ajoute(stCurrentmaster.tabLine[z])
      				nCptLow--
      			FIN
      			stAllRack.bIsRackLiftShipping = stCurrentmaster.bIsRackLiftShipping
      			
      		FIN
      		stCurrentmaster.tabLine[z].bProcess	= Vrai
      		//					blowhigh					= vrai
      	FIN
      FIN
      
      
      
      
      renvoyer stallrack
      
      
      CAS EXCEPTION:
      
      erreur(exceptioninfo(errComplet))
     type : 458752
   -
     name : Showrack
     procedure_id : 1665593467560654275
     type_code : 14
     code : |1-
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //Showrack ( [<bDraw> est booléen])
      //
      // Paramètres :
      // 	bDraw (booléen - valeur par défaut=1) : <indiquez ici le rôle de bDraw>
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      // 	imgChart : <indiquez ici le rôle de imgChart>
      procédure Showrack(bDraw est un booleen = vrai)
      
      nFirstTruck	est un entier	= 0
      sFirstDate	est une chaîne
      
      
      ARBRE_Rack.SupprimeTout()
      pour chaque stDaterack,sKeydate de gtaAllDate
      	SI sFirstDate = "" ALORS sFirstDate = sKeydate
      	POUR CHAQUE stTruckRack,sCle de stDaterack.taAllTruckrack
      		si stTruckRack.taAllTruckRack..occurrence = 0 alors
      			si stTruckRack.tabRackAuMur..occurrence <> 0 alors
      				ArbreAjoute(ARBRE_Rack,sKeydate+TAB+"Camion"+sansespace(sCle),gImage(IMG_Camion),gImage(IMG_Camion))
      				si nFirstTruck = 0 alors nFirstTruck = sCle
      				
      			FIN
      			
      		sinon
      			SI nFirstTruck = 0 ALORS nFirstTruck = sCle
      			POUR CHAQUE stRack,sClerack de stTruckRack.taAllTruckRack
      				//			si strack.bTripleOnly alors
      				//				ArbreAjoute(ARBRE_Rack,"Camion"+sansespace(sCle)+TAB+gpolicegras(vrai)+gstylo(RougeClair)+"Rack"+sClerack,aDéfaut,aDéfaut,sClerack,aDernier,"Rack" + sClerack)
      				//			sinon
      				si stRack.bTripleOnly alors
      					ArbreAjoute(ARBRE_Rack,sKeydate+tab+"Camion"+sansespace(sCle)+tab+"Rack"+sClerack,gImage(IMG_rackrouge),gImage(IMG_rackrouge),sClerack,aDernier,"Rack" + sClerack)
      				sinon	
      					ArbreAjoute(ARBRE_Rack,sKeydate+tab+"Camion"+sansespace(sCle)+TAB+"Rack"+sClerack,gImage(IMG_rackVert),gImage(IMG_rackVert),sClerack,aDernier,"Rack" + sClerack)
      				FIN
      				ArbreModifie(ARBRE_Rack,sKeydate+TAB+"Camion"+sansespace(sCle),Null,gimage(IMG_Camion),gimage(img_camion))
      				ArbreModifie(ARBRE_Rack,sKeydate,Null,gimage(IMG_date),gimage(img_date))
      				//			FIN
      				MaFenêtre..Plan	= 5
      				si bdraw alors
      					tabOneRack		<= strack.OneRack
      					pour chaque stOrder de strack.tabCurrentOrder
      						si storder.bIstriple _and_ storder.bFinishOverMax ALORS
      							GRF_Rack.CouleurCatégorie(storder.nRackLineNumber,Rougeclair)
      							
      						sinon
      							GRF_Rack.CouleurCatégorie(stOrder.nRackLineNumber,vertFoncé)
      							
      						FIN
      					FIN
      					//				GRF_Rack.CouleurSérie(1,VertFoncé)
      					grDessine(GRF_Rack)
      				fin		
      			FIN
      		fin
      	FIN
      FIN
      
      soit bRes = ARBRE_Rack.SelectPlus(sFirstDate+tab+"Camion"+nFirstTruck+TAB+"Rack1")
      ExécuteTraitement(ARBRE_Rack,trtSélection)
      MaFenêtre..Plan = 5
     type : 458752
   -
     name : SetBestCombine
     procedure_id : 1665597242721198275
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] SetBestCombine (<tabCurrentmasterUniqueRack> est tableau (STMasterOrder), <nMaxToReach> est entier)
      //
      // Paramètres :
      //	tabCurrentmasterUniqueRack (tableau (STMasterOrder)) : <indiquez ici le rôle de tabCurrentmasterUniqueRack>
      //	nMaxToReach (entier) : <indiquez ici le rôle de nMaxToReach>
      
      // Valeur de retour :
      // 	tableau (chaîne ANSI) : <indiquez ici le rôle de la valeur de retour>
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure SetBestCombine(tabCurrentmasterUniqueRack est un tableau de STMasterOrder,nMaxToReach est un entier)
      
      
      
      
      formula		est une chaîne
      sObjectif	est une chaîne
      sOlution	est une chaîne
      s_message	est une chaîne
      _groupe		est un entier	= 0
      _max		est une chaîne	= "max : "
      _formula	est une chaîne
      _Init1		est une chaîne 
      _Int		est une chaîne	= "int "
      _ldebut		est un booléen	= Vrai
      
      boucle
      	_max		= "max : "
      	_formula	= ""
      	_Init1		= ""
      	_Int		= "int "
      	_ldebut		= Vrai
      	_groupe+=1
      	
      	
      	
      	POUR t = 1 _À_ tabCurrentmasterUniqueRack..Occurrence
      		
      		SI PAS _ldebut ALORS  
      			_max += " + x"+NumériqueVersChaîne(t) 
      			_formula  +="+ " + NumériqueVersChaîne(tabCurrentmasterUniqueRack[t].nTotalQuantity)+ " x"+NumériqueVersChaîne(t)
      			_Int+= ","+ "x"+NumériqueVersChaîne(t)
      		SINON  
      			_ldebut = Faux
      			_max += " x"+NumériqueVersChaîne(t)
      			_formula  += NumériqueVersChaîne(tabCurrentmasterUniqueRack[t].nTotalQuantity)+ " x"+NumériqueVersChaîne(t)
      			_Int+= "x"+NumériqueVersChaîne(t)
      		FIN
      		_Init1 += "x"+NumériqueVersChaîne(t)+ "<=1;"+RC
      		
      	FIN
      	_max += ";"
      	_formula+= " <="+nmaxtoreach+";"
      	_Int+=";"
      	
      	
      	formula = _max+RC+RC+_formula+RC+_Init1+RC+_Int+RC
      	
      	tabCombineResult est un tableau de chaine = LPSolveResolve(formula,"","","")
      
      	
      	
      	nMaxToReach-=1
      a faire tantque nmaxtoreach = 0
      
      
      renvoyer tabCombineResult
      
     type : 458752
   -
     name : LPSolveResolve
     internal_properties : CQAAAAkAAAAETzEdwRNMKZCPH5biRPuGIhjJRSEy3U5JTZLOlnghFVmFZRAIgAj/DndRQNodyJtsm+0/ZceFTWe1eMnQaGiLmgPfLUoNfKg7ZDSdjQfgE4hHDRZHlxXQX2O7phicXMgmI90vZoTwQshKoz41fdqz8xIKS6ylpZC1pX+bK8EWsw4U
     procedure_id : 1665597440290722087
     type_code : 14
     code : |1-
      // Traitement automatique des exceptions :   exécuter le bloc de code CAS EXCEPTION:
      //
      
      PROCEDURE LPSolveResolve(sFormulationLP, pnObjectif, psSolution, psMessage)
      
      // Variables
      nInstanceDLL est un entier systeme
      
      nLP		     est un entier sur 8 octet
      sNomPL	     est une chaine 
      nRésolution  est un entier sur 8 octets
      sLig		 est une chaine
      sSol		 est une chaine
      bDébutSolOk  est un booléen
      
      gsFichierLP		est une chaîne
      gsFichierLOG	est une chaîne
      gsFichierSOL	est une chaîne
      
      tabResult est un tableau de chaine ANSI
      // Initialisation
      sNomPL = <§$0000§>
      nInstanceDLL = ChargeDLL(DLL_NOM)
      bDébutSolOk = Faux
      
      // Chargement de la DLL LpSolve
      SI nInstanceDLL = 0 ALORS
      	psMessage = <§$0001§>+"lpsolve55.dll"
      	RENVOYER tabresult
      FIN
      
      // Récupération de noms de fichiers temporaires pour la résolution du problème
      gsFichierLP  = fFichierTemp("FLP", fRepExe()) // Fichier contenant la Formulation du Problème Linéaire
      gsFichierLOG = fFichierTemp("LOG", fRepExe()) // Fichier contenant la log d'exécution des fonctions de la DLL lpsolve55.dll
      gsFichierSOL = fFichierTemp("SOL", fRepExe()) // Fichier contenant la solution trouvée par la fonction lpsolve de la DLL lpsolve55.dll
      
      // On sauvegarde la formulation dans le fichier qui sera lu par la fonction read_LP
      fSauveTexte(gsFichierLP, sFormulationLP)
      
      // Chargement du problème linaire
      nLP = API(DLL_NOM, "read_LP", gsFichierLP, CST_VERBOSE_NORMAL, sNomPL)
      SI nLP = 0 ALORS
      	psMessage = <§$0003§>+RC+<§$0002§>
      	RENVOYER tabresult
      FIN
      
      // On définit le fichier de log pour les fonctions de la DLL LP Solve
      API(DLL_NOM, "set_outputfile", nLP, gsFichierLOG)
      
      // Résolution du problème
      nRésolution = API(DLL_NOM, "solve", nLP)
      
      SELON nRésolution
      	CAS CST_RES_NOMEMORY
      		psMessage = <§$0004§>
      		RENVOYER tabresult
      		
      	CAS CST_RES_OPTIMAL			
      		psMessage = <§$0005§>
      		
      	CAS CST_RES_SUBOPTIMAL
      		psMessage = <§$0006§>
      		
      	CAS CST_RES_INFEASIBLE		
      		psMessage = <§$0007§>
      		RENVOYER tabresult
      		
      	CAS CST_RES_UNBOUNDED	
      		psMessage = <§$0008§>
      		RENVOYER tabresult
      		
      	CAS CST_RES_DEGENERATE	
      		psMessage = <§$0009§>
      		RENVOYER tabresult
      		
      	CAS CST_RES_NUMFAILURE	
      		psMessage = <§$000a§>
      		RENVOYER tabresult
      		
      	CAS CST_RES_USERABORT	
      		psMessage = <§$000b§>
      		RENVOYER tabResult
      		
      	CAS CST_RES_TIMEOUT		
      		psMessage = <§$000c§>
      		
      	CAS CST_RES_FEASFOUND	
      		psMessage = <§$000d§>
      		
      	CAS CST_RES_NOFEASFOUND		
      		psMessage = <§$000e§>
      		RENVOYER tabresult
      FIN
      
      // On définit le fichier qui contient la solution
      API(DLL_NOM, "set_outputfile", nLP, gsFichierSOL)
      API(DLL_NOM, "print_objective", nLP)
      API(DLL_NOM, "print_solution", nLP, 1)
      
      // On parcours le fichier de solution pour afficher les valeurs dans l'application
      sSol = fChargeTexte(gsFichierSOL)
      psSolution = ""
      i est un entier = 1
      tantque sLig <> eot
      	sLig = ExtraitChaîne(sSol,i,rc)
      	si sLig = eot alors sortir
      	SI sLig [= "Value of objective function:" ALORS
      		pnObjectif = Val(sLig[[Taille("Value of objective function:")+1 A ]])
      	SINON SI sLig [= "Actual values of the variables:" ALORS
      		bDébutSolOk = Vrai
      	SINON SI bDébutSolOk
      		sVar est une chaine	= ExtraitChaîne(sLig, 1, " ")
      		SI sVar<>"" ALORS
      			nVal est un entier	= val(SansEspace(sLig[[taille(sVar)+1 a ]]))
      			psSolution += [RC]+ sVar + TAB + nVal 
      		FIN
      	FIN
      	i++
      FIN
      
      
      SI nLP <> 0 ALORS
      	API(DLL_NOM, "set_outputfile", nLP, "") //Ferme le fichier de sortie pour pouvoir le supprimer
      	fSupprime(gsFichierLP,frLectureSeule)
      	fSupprime(gsFichierLOG,frLectureSeule)
      	fSupprime(gsFichierSOL,frLectureSeule)
      FIN
      DéchargeDLL(nInstanceDLL)
      
      
      ChaîneVersTableau(psSolution,tabResult,rc)
      RENVOYER tabResult
      
      
      
      //FIN:
      //
      ////Suppression des fichiers temporaires
      //SI nLP <> 0 ALORS
      //	API(DLL_NOM, "set_outputfile", nLP, "") //Ferme le fichier de sortie pour pouvoir le supprimer
      //	fSupprime(gsFichierLP,frLectureSeule)
      //	fSupprime(gsFichierLOG,frLectureSeule)
      //	fSupprime(gsFichierSOL,frLectureSeule)
      //FIN
      //DéchargeDLL(nInstanceDLL)
      
      
      CAS EXCEPTION:
      	
      	info(exceptioninfo(errMessage))
     type : 458752
   -
     name : IsMandatoryOnWall
     procedure_id : 1670022342962152518
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] IsMandatoryOnWall (<sShapeNumber> est chaîne)
      //
      // Paramètres :
      //	sShapeNumber (chaîne ANSI) : <indiquez ici le rôle de sShapeNumber>
      // Valeur de retour :
      // 	booléen : <indiquez ici le rôle de la valeur de retour>
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure IsMandatoryOnWall(sShapeNumber est une chaine)
      
      si hlitrecherche(forme,fnumero,sShapeNumber) _et_ forme.MandatoryOnWall alors
      	renvoyer Vrai
      sinon
      	renvoyer(faux)	
      FIN
      
     type : 458752
   -
     name : MoveToWall
     procedure_id : 1670057316890167900
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      // MoveToWall ()
      //
      // Paramètres :
      //	Aucun
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure MoveToWall()
      //sai_rack est un entier
      //saisie("transférer sur quel rack",sai_rack)
      //
      //soit (nNbSlot,nLowerSlot,nHigherslot) = checkIfEmptySlot(sai_rack)
      //
      //si nNbSlot <> 0 alors
      //	si nLowerSlot > 0 alors
      //		info("Slot : "+ nLowerSlot)
      //	sinon
      //		Info("Slot : "+ nHigherSlot)
      //	FIN
      //FIN
      
      stCurrentOrder	est un storder
      
      bCancel			est un booleen
      
      //(nTruckTo,nRackTo,bCancel) = Ouvre(FEN_SwapRack,nNoCamion,nNoRack,gtaAllTruckrack)
      
      SI bCancel ALORS RENVOYER Faux
      
      tabOrder	est un tableau d'entier
      tabOrder.SupprimeTout()
      POUR i = 1 _a_ TABLE_TabOneRack.SelectOccurrence()
      	SI TABLE_TabOneRack[TABLE_TabOneRack.Select(i)].COL_RackID <> 0 ALORS tabOrder.Ajoute(TABLE_TabOneRack[TABLE_TabOneRack.Select(i)].COL_RackID)
      FIN
      
      POUR CHAQUE nRackID de tabOrder 
      	stCurrentOrder	= allouer un stOrder
      	stCurrentOrder	=  gtaAllDate[gsSelectedTreeDate].taAllTruckrack[nNoCamion].taAllTruckRack[nNoRack].tabCurrentOrder[nRackID]
      	 gtaAllDate[gsSelectedTreeDate].taAllTruckrack[nNoCamion].tabRackAuMur.Ajoute(stCurrentOrder)
      	
      	 gtaAllDate[gsSelectedTreeDate].taAllTruckrack[nNoCamion].taAllTruckRack[nNoRack].tabCurrentOrder[nRackID].bTodelete																	= Vrai
      	 gtaAllDate[gsSelectedTreeDate].taAllTruckrack[nNoCamion].taAllTruckRack[nNoRack].OneRack[ gtaAllDate[gsSelectedTreeDate].taAllTruckrack[nNoCamion].taAllTruckRack[nNoRack].tabCurrentOrder[nRackID].nRackLineNumber]	= 0
      FIN
      
      TABLE_TabOneRack.SupprimeTout()
      POUR i = 1 À nMaximumRack
      	TableAjouteLigne(TABLE_TabOneRack)
      	TABLE_TabOneRack[i].COL_Pos = gtaRealNumberOfSlot[i]
      FIN
      //tabOneRack.SupprimeTout()
      //nCptline est un entier
      //
      //POUR TOUTE LIGNE DE TABLE_TabOneRack 
      //	ncptline++
      //	tabOneRack.Ajoute(COL_TabOneRack)
      //	SI COL_RackID <> 0 ALORS
      //		gtaAllTruckrack[nNoCamion].taAllTruckRack[nNoRack].tabCurrentOrder[COL_RackID].nRackLineNumber = ncptline
      //		
      //	FIN
      //FIN
      
      nCpt est un entier
      
      POUR CHAQUE st_Order DE  gtaAllDate[gsSelectedTreeDate].taAllTruckrack[nnocamion].taAllTruckRack[nNoRack].tabCurrentOrder
      	nCpt++
      	SI PAS st_Order.bTodelete ALORS
      		TABLE_TabOneRack[st_Order.nRackLineNumber].COL_Width		= st_Order.nLargeur
      		TABLE_TabOneRack[st_Order.nRackLineNumber].COL_Height		= st_Order.nHauteur
      		TABLE_TabOneRack[st_Order.nRackLineNumber].COL_RackID		= nCpt
      		TABLE_TabOneRack[st_Order.nRackLineNumber].COL_Order		= st_Order.OrderNumber
      		TABLE_TabOneRack[st_Order.nRackLineNumber].COL_Sequence		= st_Order.nShippingSequence
      		TABLE_TabOneRack[st_Order.nRackLineNumber].COL_Customer		= st_Order.CustomerNumber
      		TABLE_TabOneRack[st_Order.nRackLineNumber].COL_Lift			= st_Order.bIsRackLiftShipping
      		TABLE_TabOneRack[st_Order.nRackLineNumber].COL_IsTriple = st_Order.bIstriple
      		TABLE_TabOneRack[st_Order.nRackLineNumber].COL_IsFinishOverMax = st_Order.bFinishOverMax
      			TABLE_TabOneRack[st_Order.nRackLineNumber].COL_ShipTo = st_Order.sShippingname
      		
      		
      		
      	FIN
      	
      FIN
      TABLE_TabOneRack.Affiche(taDébut)
      TABLE_TabOneRack.SelectMoins()
      
      FillrackAuMur(gsSelectedTreeDate,nnocamion)
      ExécuteTraitement(BTN_Dessine,trtClic)
      
      
      
      
      
      
      
      
      
     type : 458752
   -
     name : WallToRack
     procedure_id : 1670079994324671183
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      // WallToRack ()
      //
      // Paramètres :
      //	Aucun
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure WallToRack()
      
      stCurrentOrder	est un storder
      nRackTo			est une entier
      nTruckTo		est une entier
      bCancel			est un booleen
      
      (nTruckTo,nRackTo,bCancel) = Ouvre(FEN_SwapRack,nNoCamion,99, gtaAllDate[gsSelectedTreeDate].taAllTruckrack,faux)
      
      SI bCancel ALORS RENVOYER Faux
      sRackTo est une chaine = "Rack"+nrackto
      SI sRackTo = "Rack0" ALORS RENVOYER Faux
      
      soit (NbEmptySlot,nLowest,nHighest) = checkIfEmptySlotForTransfer(ntruckto,nrackTo)
      
      SI NbEmptySlot < TABLE_Wallrack.SelectOccurrence() ALORS
      	Erreur("Il n'y a pas assez d'espaces diponibles sur le rack demandé")
      	RENVOYER Faux
      FIN
      
      
      nRes		est un entier
      tabOrder	est un tableau d'entier
      tabOrder.SupprimeTout()
      POUR i = 1 _a_ TABLE_Wallrack.SelectOccurrence()
      	tabOrder.Ajoute(TABLE_Wallrack[TABLE_Wallrack.Select(i)].COL_id)
      FIN
      
      POUR CHAQUE nRackID de tabOrder 
      	stCurrentOrder	= allouer un stOrder
      	stCurrentOrder	=  gtaAllDate[gsSelectedTreeDate].taAllTruckrack[nNoCamion].tabRackAuMur[nRackID]
      	SI nLowest > 0 ALORS
      		stCurrentOrder.nRackLineNumber = nLowest
      		nLowest--
      	SINON
      		stCurrentOrder.nRackLineNumber = nHighest
      		nHighest++
      		
      	FIN
      	
      	 gtaAllDate[gsSelectedTreeDate].taAllTruckrack[nNoCamion].tabRackAuMur[nRackID].bTodelete = vrai
      	
      	 gtaAllDate[gsSelectedTreeDate].taAllTruckrack[nTruckTo].taAllTruckRack[nRackTo].tabCurrentOrder.Ajoute(stCurrentOrder)
      	 gtaAllDate[gsSelectedTreeDate].taAllTruckrack[nTruckTo].taAllTruckRack[nRackTo].OneRack[stCurrentOrder.nRackLineNumber] = stCurrentOrder.nLargeur
      	
      FIN
      
      si nrackto = nNoRack alors
      	TABLE_TabOneRack.SupprimeTout()
      	POUR i = 1 À nMaximumRack
      		TableAjouteLigne(TABLE_TabOneRack)
      		TABLE_TabOneRack[i].COL_Pos =gtaRealNumberOfSlot[i]
      	FIN
      	
      	nCpt est un entier
      	
      	POUR CHAQUE st_Order DE  gtaAllDate[gsSelectedTreeDate].taAllTruckrack[nnocamion].taAllTruckRack[nNoRack].tabCurrentOrder
      		nCpt++
      		SI PAS st_Order.bTodelete ALORS
      			TABLE_TabOneRack[st_Order.nRackLineNumber].COL_Width		= st_Order.nLargeur
      			TABLE_TabOneRack[st_Order.nRackLineNumber].COL_Height		= st_Order.nHauteur
      			TABLE_TabOneRack[st_Order.nRackLineNumber].COL_RackID		= nCpt
      			TABLE_TabOneRack[st_Order.nRackLineNumber].COL_Order		= st_Order.OrderNumber
      			TABLE_TabOneRack[st_Order.nRackLineNumber].COL_Sequence		= st_Order.nShippingSequence
      			TABLE_TabOneRack[st_Order.nRackLineNumber].COL_Customer		= st_Order.CustomerNumber
      			TABLE_TabOneRack[st_Order.nRackLineNumber].COL_Lift			= st_Order.bIsRackLiftShipping
      			TABLE_TabOneRack[st_Order.nRackLineNumber].COL_IsTriple = st_Order.bIstriple
      			TABLE_TabOneRack[st_Order.nRackLineNumber].COL_IsFinishOverMax = st_Order.bFinishOverMax
      				TABLE_TabOneRack[st_Order.nRackLineNumber].COL_ShipTo = st_Order.sShippingname
      		FIN
      		
      	FIN
      	TABLE_TabOneRack.Affiche(taDébut)
      	TABLE_TabOneRack.SelectMoins()
      	
      //	ExécuteTraitement(BTN_Dessine,trtClic)
      sinon
      	RecalculateRack(nTruckTo,nRackTo)
      	
      FIN
      
      FillrackAuMur(gsSelectedTreeDate,nNoCamion)
      
      
     type : 458752
   -
     name : InsertRack
     procedure_id : 1670293020295900282
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //InsertRack ( [<InsertType> est chaîne])
      //
      // Paramètres :
      //	InsertType (chaîne ANSI - valeur par défaut="B") : <indiquez ici le rôle de Param1>
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure InsertRack(sInsertType est une chaine  ="B")
      
      // B = insérer avant
      // A = insérer après
      
      bTripleOnly					est un booleen	= ouinon("Rack pour thermos triple ?")
      
      sSelecteddate				est une chaine	= ExtraitChaîne(SAI_SansNom1,1,TAB)
      nTruckNumber				est un entier	=  Milieu(ExtraitChaîne(SAI_SansNom1,2,TAB),7)
      nRackNUmber					est un entier	=  Milieu(ExtraitChaîne(SAI_SansNom1,3,TAB),5)
      nNumberOfTruck				est un entier	//= gtaAllTruckrack..occurrence
      taCurrentTruckRack			est un tableau associatif (*, *, wlEntier) de STAllTruck
      
      tabInvertRackSort			est un tableau d'Entier
      nFirstTruckRackNumber		est un entier
      tabTruckNumber				est un tableau d'entier
      tabDateTruck				est un tableau de chaine
      nCurrenttruck				est un entier
      stAllDAteTruck				est une structure
      	tabTruckNumber est un tableau d'entier
      fin
      taDate			est un tableau associatif de stalldateTruck 
      stCurrentdate	est un STAllDateTruck
      nCurrentdate	est un entier
      tabDate			est un tableau de chaine ANSI
      
      
      
      
      
      
      
      
      gtaAllDate.trie(ttClé)
      
      pour CHAQUE stTruckdate,sKey de gtaAllDate 
      	stCurrentdate = allouer un stalldate
      	tabdate.ajoute(skey)
      	
      	POUR CHAQUE truck,nKeyTruck de sttruckdate.taAllTruckrack
      		
      		SI truck.taAllTruckRack..occurrence <> 0 ALORS
      			stCurrentdate.tabTruckNumber.ajoute(nkeytruck)
      			tabDateTruck.Ajoute(skey+";"+nKeyTruck)
      		FIN
      	Fin	
      	taDate[skey] = stcurrentdate
      Fin
      
      nCurrentdate = tabdate.cherche(tcLinéaire,gsSelectedTreeDate)
      
      //pour chaque truck,nKeyTruck de taCurrentTruckRack
      //	si truck.taAllTruckRack..occurrence <> 0 alors
      //		tabTruckNumber.ajoute(nKeyTruck)
      //	Fin
      //FIN
      //nNumberOfTruck	= tabTruckNumber..occurrence
      //ncurrenttruck	= tabTruckNumber.Cherche(tcLinéaire,nTruckNumber)
      
      i est un entier
      selon sInsertType
      	CAS "B"
      		
      		pour ii = ncurrentdate a tabDate..occurrence
      			taCurrentTruckRack <= gtaAllDate[tabdate[ii]].taAllTruckrack
      			tabtrucknumber.SupprimeTout()
      pour chaque truck,nKeyTruck de taCurrentTruckRack
      	si truck.taAllTruckRack..occurrence <> 0 alors
      		tabTruckNumber.ajoute(nKeyTruck)
      	Fin
      FIN
      nNumberOfTruck	= tabTruckNumber..occurrence
      			si gsSelectedTreeDate = tabdate[ii] alors
      ncurrenttruck	= tabTruckNumber.Cherche(tcLinéaire,nTruckNumber)
      			sinon
      				nCurrenttruck = 0
      			fin
      
      
      			
      //		pour i = nNumberOfTruck _a_  nTruckNumber+1 pas -1
      //			tabInvertRackSort.SupprimeTout()
      		pour x = nNumberOfTruck _a_  nCurrenttruck+1 pas -1
      			i = tabtrucknumber[x]
      			tabInvertRackSort.SupprimeTout()
      			pour chaque stRack,sKeyRack de taCurrentTruckRack[i].taAllTruckRack
      				tabInvertRackSort.ajoute(sKeyRack)
      			FIN
      			tabInvertRackSort.trie(ttDécroissant)
      			nFirstTruckRackNumber = tabInvertRackSort[tabInvertRackSort..Occurrence]
      			pour Chaque nKey de tabInvertRackSort
      				taCurrentTruckRack[i].taAllTruckRack[nKey+1] <= taCurrentTruckRack[i].taAllTruckRack[nKey]
      				si nkey = nFirstTruckRackNumber alors
      					taCurrentTruckRack[i].taAllTruckRack.Supprime(nkey)
      				FIN
      				
      			FIN
      			
      		FIN
      			SI gsSelectedTreeDate = tabDate[ii] ALORS
      		tabInvertRackSort.SupprimeTout()
      		POUR CHAQUE stRack,sKeyRack de taCurrentTruckRack[nTruckNumber].taAllTruckRack
      			tabInvertRackSort.Ajoute(sKeyRack)
      		FIN
      		tabInvertRackSort.Trie(ttDécroissant)
      		POUR nKey = tabInvertRackSort[1] _a_ nRackNUmber pas -1
      			taCurrentTruckRack[nTruckNumber].taAllTruckRack[nKey+1] <= taCurrentTruckRack[nTruckNumber].taAllTruckRack[nKey]
      		FIN
      		taCurrentTruckRack[nTruckNumber].taAllTruckRack[nRackNUmber].tabCurrentOrder.SupprimeTout()
      		//		taCurrentTruckRack[nTruckNumber].taAllTruckRack[nRackNUmber].tabCurrentOrder.ajoute(stordervide)
      		
      		taCurrentTruckRack[nTruckNumber].taAllTruckRack[nRackNUmber].OneRack.SupprimeTout()
      		POUR i = 1 À nMaximumRack
      			taCurrentTruckRack[nTruckNumber].taAllTruckRack[nRackNUmber].OneRack.Ajoute(0)
      		FIN
      		taCurrentTruckRack[nTruckNumber].taAllTruckRack[nRackNUmber].OneRackhauteur.SupprimeTout()
      		taCurrentTruckRack[nTruckNumber].taAllTruckRack[nRackNUmber].bIsRackLiftShipping	= faux
      		taCurrentTruckRack[nTruckNumber].taAllTruckRack[nRackNUmber].nShippingSequence		= 0
      		taCurrentTruckRack[nTruckNumber].taAllTruckRack[nRackNUmber].bTripleOnly			=  bTripleOnly
      		taCurrentTruckRack[nTruckNumber].taAllTruckRack[nRackNUmber].nNumberOfTriple		=  0
      			fin
      			gtaAllDate[tabDate[ii]].taAllTruckrack <= taCurrentTruckRack  
      		
      		Fin
      		
      		
      		
      		
      	cas "A"	
      		
      		POUR ii = ncurrentdate a tabDate..occurrence
      			taCurrentTruckRack <= gtaAllDate[tabDate[ii]].taAllTruckrack
      			tabTruckNumber.SupprimeTout()
      			POUR CHAQUE truck,nKeyTruck de taCurrentTruckRack
      				SI truck.taAllTruckRack..occurrence <> 0 ALORS
      					tabTruckNumber.Ajoute(nKeyTruck)
      				FIN
      			FIN
      			nNumberOfTruck	= tabTruckNumber..Occurrence
      			SI gsSelectedTreeDate = tabDate[ii] ALORS
      				nCurrenttruck	= tabTruckNumber.Cherche(tcLinéaire,nTruckNumber)
      			SINON
      				nCurrenttruck = 0
      			FIN
      			
      			
      			
      			
      			
      			
      			
      		POUR x = nNumberOfTruck _a_  nCurrenttruck+1 pas -1
      			i = tabTruckNumber[x]
      			tabInvertRackSort.SupprimeTout()
      			POUR CHAQUE stRack,sKeyRack de taCurrentTruckRack[i].taAllTruckRack
      				tabInvertRackSort.Ajoute(sKeyRack)
      			FIN
      			tabInvertRackSort.Trie(ttDécroissant)
      			nFirstTruckRackNumber = tabInvertRackSort[tabInvertRackSort..Occurrence]
      			POUR CHAQUE nKey de tabInvertRackSort
      				taCurrentTruckRack[i].taAllTruckRack[nKey+1] <= taCurrentTruckRack[i].taAllTruckRack[nKey]
      				SI nKey = nFirstTruckRackNumber ALORS
      					taCurrentTruckRack[i].taAllTruckRack.Supprime(nKey)
      				FIN
      				
      			FIN
      			
      		FIN
      		
      			SI gsSelectedTreeDate = tabDate[ii] ALORS
      		tabInvertRackSort.SupprimeTout()
      		POUR CHAQUE stRack,sKeyRack de taCurrentTruckRack[nTruckNumber].taAllTruckRack
      			tabInvertRackSort.Ajoute(sKeyRack)
      		FIN
      		tabInvertRackSort.Trie(ttDécroissant)
      		POUR nKey = tabInvertRackSort[1] _a_ nRackNUmber+1 pas -1
      			taCurrentTruckRack[nTruckNumber].taAllTruckRack[nKey+1] <= taCurrentTruckRack[nTruckNumber].taAllTruckRack[nKey]
      		FIN
      		taCurrentTruckRack[nTruckNumber].taAllTruckRack[nRackNUmber+1].tabCurrentOrder.SupprimeTout()
      		//		taCurrentTruckRack[nTruckNumber].taAllTruckRack[nRackNUmber+1].tabCurrentOrder.Ajoute(stOrderVide)
      		taCurrentTruckRack[nTruckNumber].taAllTruckRack[nRackNUmber+1].OneRack.SupprimeTout()
      		pour i = 1 a nMaximumRack
      			taCurrentTruckRack[nTruckNumber].taAllTruckRack[nRackNUmber+1].OneRack.ajoute(0)
      		FIN
      		taCurrentTruckRack[nTruckNumber].taAllTruckRack[nRackNUmber+1].OneRackHauteur.SupprimeTout()
      		taCurrentTruckRack[nTruckNumber].taAllTruckRack[nRackNUmber+1].bIsRackLiftShipping		= Faux
      		taCurrentTruckRack[nTruckNumber].taAllTruckRack[nRackNUmber+1].nShippingSequence		= 0
      		taCurrentTruckRack[nTruckNumber].taAllTruckRack[nRackNUmber+1].bTripleOnly				=  bTripleOnly
      		taCurrentTruckRack[nTruckNumber].taAllTruckRack[nRackNUmber+1].nNumberOfTriple			=  0
      			FIN
      			gtaAllDate[tabDate[ii]].taAllTruckrack <= taCurrentTruckRack  
      		fin
      		
      	AUTRE CAS
      		
      FIN
      
      showrack(faux)
      si sInsertType = "B" alors ARBRE_Rack.SelectPlus(sSelecteddate+tab+"Camion"+nTruckNumber+TAB+"Rack"+nRackNUmber) sinon ARBRE_Rack.SelectPlus(sSelecteddate+TAB+"Camion"+nTruckNumber+TAB+"Rack"+(nRackNUmber+1))
      ExécuteTraitement(ARBRE_Rack,trtSélection)
      
     type : 458752
   -
     name : checkIfEmptyRack
     procedure_id : 1670325997098194262
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      // checkIfEmptyRack ()
      //
      // Paramètres :
      //	Aucun
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure checkIfEmptyRack()
      
      nTruckNumber		est un entier	=  Milieu(ExtraitChaîne(SAI_SansNom1,1,TAB),7)
      nRackNUmber			est un entier	=  Milieu(ExtraitChaîne(SAI_SansNom1,2,TAB),5)
      Activeorder est un tableau de storder = gtaAllTruckrack[nTruckNumber].taAllTruckRack[nRackNUmber].tabCurrentOrder.Filtre(Valeur=>valeur.bToDelete = faux)
      
      
      
      
      
      
      si  Activeorder..occurrence = 0 alors
      	MENU_InsertRack.OPT_Supprimer_un_rack..Etat = actif
      sinon si Activeorder..Occurrence = 1	alors
      	si Activeorder[1].nLargeur = 0 alors MENU_InsertRack.OPT_Supprimer_un_rack..Etat = Actif
      	
      sinon
      	MENU_InsertRack.OPT_Supprimer_un_rack..Etat = grise
      FIN
     type : 458752
   -
     name : CkeckIfEmptyRack
     procedure_id : 1670330506819099334
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //CkeckIfEmptyRack ()
      //
      // Paramètres :
      //	Aucun
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      
      
      
      procédure CkeckIfEmptyRack()
      // vérification si un rack est vide avant la sauvegarde
      // ajouter un storder vide sinon le rack ne se sauvegarde pas.
      stEmptyOrder est un storder
      
      pour chaque stTruckdate de gtaAllDate
      	pour chaque stTruck de stTruckdate.taAllTruckrack
        pour CHAQUE stRack de stTruck.taAllTruckRack
           si strack.tabCurrentOrder..occurrence = 0 alors
              strack.tabCurrentOrder.ajoute(stemptyorder)
           FIN
        FIN
        	
        	
      FIN
      Fin
     type : 458752
   -
     name : DeleteEmptyrack
     procedure_id : 1670337572042535844
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //DeleteEmptyrack (<nTruckNumber> est entier, <nRackNumber> est entier [, <bShowrack> est booléen [, <sDateToProcess> est chaîne]])
      //
      // Paramètres :
      //	nTruckNumber (entier) : <indiquez ici le rôle de nTruckNumber>
      //	nRackNumber (entier) : <indiquez ici le rôle de nRackNumber>
      //	bShowrack (booléen - valeur par défaut=1) : <indiquez ici le rôle de bShowrack>
      // 	sDateToProcess (chaîne ANSI - valeur par défaut="") : <indiquez ici le rôle de sDateToProcess>
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      
      // 	sDateToProcess (chaîne ANSI - valeur par défaut="") : <indiquez ici le rôle de sDateToProcess>
      procédure DeleteEmptyrack(nTruckNumber est un entier,nRackNumber est un entier,bShowrack est un booleen = vrai,sDateToProcess est une chaine = "")
      
      
      
      
      //gtaAllTruckrack[nTruckNumber].taAllTruckRack.Supprime(nrackNumber)
      SetNewRackNumber(nTruckNumber,nRackNumber,sdatetoprocess)
      
      si bshowrack alors showrack(faux)
      
      
      
      
      
     type : 458752
   -
     name : SetNewRackNumber
     procedure_id : 1670341725279303424
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //SetNewRackNumber (<nTruckNumber> est entier, <nRackNumber> est entier [, <sDateToProcess> est chaîne])
      //
      // Paramètres :
      //	nTruckNumber (entier) : <indiquez ici le rôle de nTruckNumber>
      //	nRackNumber (entier) : <indiquez ici le rôle de nRackNumber>
      // 	sDateToProcess (chaîne ANSI - valeur par défaut="") : <indiquez ici le rôle de sDateToProcess>
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      //	nTruckNumber (entier) : <indiquez ici le rôle de nTruckNumber>
      //	nRackNumber (entier) : <indiquez ici le rôle de nRackNumber>
      // 	sDateToProcess (chaîne ANSI - valeur par défaut="") : <indiquez ici le rôle de sDateToProcess>
      procédure SetNewRackNumber(nTruckNumber est un entier,nRackNumber est un entier,sDateToProcess est une chaine = "")
      si sDateToProcess <> "" alors gsSelectedTreeDate = dateverschaine(sdatetoprocess,"JJ/MM/AAAA")
      
      
      nNumberOfTruck				est un entier	= gtaAllTruckrack..occurrence
      taCurrentTruckRack			est un tableau associatif (*, *, wlEntier) de STAllTruck
      //taCurrentTruckRack <= gtaAllTruckrack
      tabRackSort					est un tableau d'Entier
      nLastTruckRackNumber		est un entier
      tabTruckNumber				est un tableau d'entier
      
      stAllDAteTruck				est une Structure
      	tabTruckNumber est un tableau d'entier
      FIN
      taDate			est un tableau associatif de stalldateTruck 
      stCurrentdate	est un STAllDateTruck
      nCurrentdate	est un entier
      tabDate			est un tableau de chaine ANSI
      nCurrenttruck	est un entier
      
      gtaAllDate.Trie(ttClé)
      
      POUR CHAQUE stTruckdate,sKey de gtaAllDate 
      	stCurrentdate = allouer un STAllDate
      	tabDate.Ajoute(sKey)
      	
      	POUR CHAQUE truck,nKeyTruck de sttruckdate.taAllTruckrack
      		
      		SI truck.taAllTruckRack..Occurrence <> 0 ALORS
      			stCurrentdate.tabTruckNumber.Ajoute(nKeyTruck)
      			//tabDateTruck.Ajoute(sKey+";"+nKeyTruck)
      		FIN
      	FIN	
      	taDate[sKey] = stCurrentdate
      FIN
      
      nCurrentdate = tabDate.Cherche(tcLinéaire,gsSelectedTreeDate)
      
      
      pour ii = ncurrentdate _a_ tabdate..occurrence
      	taCurrentTruckRack	= gtaAllDate[tabDate[ii]].taAllTruckrack
      	nnumberoftruck		= 0
      	tabTruckNumber.SupprimeTout()
      	POUR CHAQUE truck,nKeyTruck de taCurrentTruckRack
      		SI truck.taAllTruckRack..Occurrence <> 0 ALORS
      			tabTruckNumber.Ajoute(nKeyTruck)
      		FIN
      	FIN
      	nNumberOfTruck	= tabTruckNumber..Occurrence
      	//	nCurrenttruck	= tabTruckNumber.Cherche(tcLinéaire,nTruckNumber)
      	SI gsSelectedTreeDate = tabDate[ii] ALORS
      		nCurrenttruck	= tabTruckNumber.Cherche(tcLinéaire,nTruckNumber)
      	SINON
      		nCurrenttruck = 0
      	FIN
      	si gsSelectedTreeDate = tabDate[ii] alors
      		POUR CHAQUE stRack,sKeyRack de taCurrentTruckRack[nTruckNumber].taAllTruckRack
      			tabRackSort.Ajoute(sKeyRack)
      		FIN
      		nLastTruckRackNumber = tabRackSort[tabRackSort..Occurrence]
      		
      		POUR nKey = nracknumber  _a_ tabRackSort[tabRackSort..occurrence]
      			SI nKey = nLastTruckRackNumber ALORS
      				taCurrentTruckRack[nTruckNumber].taAllTruckRack.Supprime(nKey)
      			sinon
      				taCurrentTruckRack[nTruckNumber].taAllTruckRack[nKey] <= taCurrentTruckRack[nTruckNumber].taAllTruckRack[nKey+1]
      			FIN
      		FIN
      	fin
      	
      	
      	
      	i est un entier
      	POUR x = nCurrenttruck+1 _a_   nNumberOfTruck
      		
      		i = tabTruckNumber[x]
      		tabRackSort.SupprimeTout()
      		POUR CHAQUE stRack,sKeyRack de taCurrentTruckRack[i].taAllTruckRack
      			tabRackSort.Ajoute(sKeyRack)
      		FIN
      		nLastTruckRackNumber = tabRackSort[tabRackSort..Occurrence]
      		POUR CHAQUE nKey de tabRackSort
      			taCurrentTruckRack[i].taAllTruckRack[nKey-1] <= taCurrentTruckRack[i].taAllTruckRack[nKey]
      			SI nKey = nlastTruckRackNumber ALORS
      				taCurrentTruckRack[i].taAllTruckRack.Supprime(nKey)
      			FIN
      			
      		FIN
      		taCurrentTruckRack[i].taAllTruckRack.trie(ttClé)
      	FIN
      	gtaAllDate[tabDate[ii]].taAllTruckrack <= taCurrentTruckRack  
      	
      FIN
      
      
      
      
      
      
     type : 458752
   -
     name : RecalculateRack
     procedure_id : 1670676736975988430
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //RecalculateRack (<nTruckNumber> est entier, <nRackNumber> est entier)
      //
      // Paramètres :
      //	nTruckNumber (entier) : <indiquez ici le rôle de nTruckNumber>
      //	nRackNumber (entier) : <indiquez ici le rôle de nRackNumber>
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure RecalculateRack(nTruckNumber est un entier,nRackNumber est un entier)
      
      
      gtabCurrentRackAdjustment <-  gtaAllDate[gsSelectedTreeDate].taAllTruckrack[nTruckNumber].taAllTruckRack[nRackNumber].tabCurrentOrder
       gtaAllDate[gsSelectedTreeDate].taAllTruckrack[nTruckNumber].taAllTruckRack[nRackNumber] <=RegenerateOrderOnRack(gtabCurrentRackAdjustment, gtaAllDate[gsSelectedTreeDate].taAllTruckrack[nTruckNumber].taAllTruckRack[nRackNumber].nNumberOfTriple, gtaAllDate[gsSelectedTreeDate].taAllTruckrack[nTruckNumber].taAllTruckRack[nRackNumber].bTripleOnly)
      gtabCurrentRackAdjustment <-  gtaAllDate[gsSelectedTreeDate].taAllTruckrack[nTruckNumber].taAllTruckRack[nRackNumber].tabCurrentOrder
      
      
     type : 458752
   -
     name : InsertRackForEmptyTruck
     procedure_id : 1670829282645268789
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //InsertRackForEmptyTruck ()
      //
      // Paramètres :
      //	Aucun
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      //	sInsertType (chaîne ANSI - valeur par défaut="B") : <indiquez ici le rôle de Param1>
      procédure InsertRackForEmptyTruck()
      
      // B = insérer avant
      // A = insérer après
      
      nTruckNumber		est un entier	=  Milieu(ExtraitChaîne(SAI_SansNom1,1,TAB),7)
      nRackNUmber			est un entier	
      nNumberOfTruck		est un entier	//= gtaAllTruckrack..occurrence
      taCurrentTruckRack	est un tableau associatif (*, *, wlEntier) de STAllTruck
      taCurrentTruckRack <= gtaAllTruckrack
      tabInvertRackSort		est un tableau d'Entier
      nFirstTruckRackNumber	est un entier
      stRackVide				est un STAllTruck
      stOrderVide				est un storder
      tabTruckNumber			est un tableau d'entier
      nCurrenttruck est un entier
      
      pour chaque truck,nKeyTruck de taCurrentTruckRack
      	si truck.taAllTruckRack..occurrence <> 0 _ou_ truck.tabRackAuMur..occurrence <> 0 alors
      		tabTruckNumber.ajoute(nKeyTruck)
      	Fin
      FIN
      nNumberOfTruck = tabTruckNumber..occurrence
      ncurrenttruck = tabTruckNumber.Cherche(tcLinéaire,nTruckNumber)
      
      si nCurrenttruck = 1 alors
      	nRackNUmber = 0
      sinon
      	pour chaque stRack,nKey de taCurrentTruckRack[tabTruckNumber[ncurrenttruck-1]].taAllTruckRack 
      		nracknumber = nkey
      	FIN
      FIN
      
      
      i est un entier
      		POUR x = nNumberOfTruck _a_  nCurrenttruck+1 pas -1
      			i = tabTruckNumber[x]
      			tabInvertRackSort.SupprimeTout()
      			POUR CHAQUE stRack,sKeyRack de taCurrentTruckRack[i].taAllTruckRack
      				tabInvertRackSort.Ajoute(sKeyRack)
      			FIN
      			tabInvertRackSort.Trie(ttDécroissant)
      			nFirstTruckRackNumber = tabInvertRackSort[tabInvertRackSort..Occurrence]
      			POUR CHAQUE nKey de tabInvertRackSort
      				taCurrentTruckRack[i].taAllTruckRack[nKey+1] <= taCurrentTruckRack[i].taAllTruckRack[nKey]
      				SI nKey = nFirstTruckRackNumber ALORS
      					taCurrentTruckRack[i].taAllTruckRack.Supprime(nKey)
      				FIN
      				
      			FIN
      			
      		FIN
      		
      //		tabInvertRackSort.SupprimeTout()
      //		POUR CHAQUE stRack,sKeyRack de taCurrentTruckRack[nTruckNumber].taAllTruckRack
      //			tabInvertRackSort.Ajoute(sKeyRack)
      //		FIN
      //		tabInvertRackSort.Trie(ttDécroissant)
      //		POUR nKey = tabInvertRackSort[1] _a_ nRackNUmber+1 pas -1
      //			taCurrentTruckRack[nTruckNumber].taAllTruckRack[nKey+1] <= taCurrentTruckRack[nTruckNumber].taAllTruckRack[nKey]
      //		FIN
      		taCurrentTruckRack[nTruckNumber].taAllTruckRack[nRackNUmber+1].tabCurrentOrder.SupprimeTout()
      		//		taCurrentTruckRack[nTruckNumber].taAllTruckRack[nRackNUmber+1].tabCurrentOrder.Ajoute(stOrderVide)
      		taCurrentTruckRack[nTruckNumber].taAllTruckRack[nRackNUmber+1].OneRack.SupprimeTout()
      		pour i = 1 a nMaximumRack
      			taCurrentTruckRack[nTruckNumber].taAllTruckRack[nRackNUmber+1].OneRack.ajoute(0)
      		FIN
      		taCurrentTruckRack[nTruckNumber].taAllTruckRack[nRackNUmber+1].OneRackHauteur.SupprimeTout()
      		taCurrentTruckRack[nTruckNumber].taAllTruckRack[nRackNUmber+1].bIsRackLiftShipping		= Faux
      		taCurrentTruckRack[nTruckNumber].taAllTruckRack[nRackNUmber+1].nShippingSequence		= 0
      		
      
      gtaAllTruckrack <= taCurrentTruckRack  
      showrack(faux)
      ARBRE_Rack.SelectPlus("Camion"+nTruckNumber+TAB+"Rack"+(nRackNUmber+1))
      ExécuteTraitement(ARBRE_Rack,trtSélection)
      
     type : 458752
   -
     name : CheckIfAllSameCustomer
     procedure_id : 1672307746501160718
     type_code : 14
     code : |1-
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] CheckIfAllSameCustomer ()
      //
      // Paramètres :
      //	Aucun
      // Valeur de retour :
      // 	booléen : <indiquez ici le rôle de la valeur de retour>
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure CheckIfAllSameCustomer()
      
      sCustomerNumber est une chaîne = TABLE_TabOneRack[TABLE_TabOneRack.Select(1)].COL_customer
      POUR i = 2 _À_ TABLE_TabOneRack.SelectOccurrence()
      	SI TABLE_TabOneRack[TABLE_TabOneRack.Select(i)].COL_customer <> sCustomerNumber alors renvoyer faux
      FIN
      
      renvoyer vrai
     type : 458752
   -
     name : ChangeTruckNumberOnOrder
     procedure_id : 1672917790803771502
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //ChangeTruckNumberOnOrder (<sOrderNumber> est chaîne, <nKeytruck> est entier)
      //
      // Paramètres :
      //	sOrderNumber (chaîne ANSI) : <indiquez ici le rôle de nOrderNumber>
      //	nKeytruck (entier) : <indiquez ici le rôle de nKeytruck>
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure ChangeTruckNumberOnOrder(sOrderNumber est une chaine ansi,nKeytruck est un entier)
      
      si hlitrecherche(Facture,fanumero,sordernumber) alors
      	si hlitrecherche(camions,NoCamion,nKeytruck) alors
      	facture.IDCamions = camions.IDCamions
      	hmodifie(facture,hNumEnrEnCours)
      	FIN
      	
      FIN
      
      
      
      
     type : 458752
   -
     name : PrintTruckReport
     procedure_id : 1673006460443771463
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //PrintTruckReport (<sReportDate> est chaîne)
      //
      // Paramètres :
      //	sReportDate (chaîne ANSI) : <indiquez ici le rôle de CAL_Rack>
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure PrintTruckReport(sReportDate est une chaine)
      
      sFrepdata			est une chaine	= completerep(fRepDonnéesUtilisateur())
      tabListreportName	est un tableau de chaine
      
      ouvresoeur(Fen_AttenteGIF,"Préparation du rapport en cours ....")
      multitache(200)
      tabAlreadyBatchorder	est un tableau de stOrder
      
      //sTxtsql					est une chaine	= [
      //Select racking.CustomerNumber,racking.LineNumber,racking.RackNumber,racking.TruckNumber,Racking.Width,racking.Height , racking.ordernumber ,
      //client.nom as Customername from racking
      //left join client on client.numero = racking.CustomerNumber
      // where racking.Rackingdate = {pdate} and racking.alreadybatched = 1 order by OrderNumber,racknumber
      //]
      
      sTxtsql					est une chaine	= [
      Select racking.CustomerNumber,racking.LineNumber,racking.RackNumber,racking.TruckNumber,Racking.Width,racking.Height , racking.ordernumber ,
      client.nom as Customername from racking
      left join client on client.numero = racking.CustomerNumber
       where racking.MasterNumber = {pMasterNumber} and RackingDate = {pdate} AND racking.alreadybatched = 1 order by OrderNumber,racknumber
      ]
      
      sdReqsql est un source de donnees
      
      //sdreqsql.pmasternumber = gnCurrentmasterRack
      //si HExécuteRequêteSQL(sdreqsql,hRequêteDéfaut,stxtsql) alors
      //	FichierVersMémoire(tabAlreadyBatchorder,sdreqsql)
      //FIN
      dReportDate	est une date	= CAL_Rack
      //iDestination(iPDFGénérique,sFrepdata+"Alreadybatch.pdf")
      //iFenêtreAbandon(Faux)
      //iimprimeetat(ETAT_ThermosAlreadybatched,tabAlreadyBatchorder,dreportdate)
      //tabListreportName.ajoute(sFrepdata+"Alreadybatch.pdf")
      
      //iEnchaînementAjoute(ETAT_ThermosAlreadybatched,tabAlreadyBatchorder,dreportdate)
      
      
      
      //taAllTruckRackTrie est un tableau associatif (*, *, wlEntier) de STAllTruck
      //taAllTruckRackTrie.supprimetout()
      
      nRes					est un entier
      tabOrderForReport		est un tableau de STOrderForReport
      
      
      stCurrentOrderForReport	est un STOrderForReport
      
      
      pour CHAQUE stAlldate,sKey de  gtaAllDate 
      	
      	sKeydate	est une chaine	= chaineversdate(skey)
      	sKeyString	est une chaine	= remplace(sKey,"/","")
      	sdReqsql.pmasternumber	= gnCurrentmasterRack
      	sdReqsql.pdate			= skeydate
      	tabAlreadyBatchorder.SupprimeTout()
      	SI HExécuteRequêteSQL(sdReqsql,hRequêteDéfaut,sTxtsql) ALORS
      		FichierVersMémoire(tabAlreadyBatchorder,sdReqsql)
      		si tabAlreadyBatchorder..Occurrence <> 0 alors
      			iDestination(iPDFGénérique,sFrepdata+skeystring+"Batched.pdf")
      			iFenêtreAbandon(Faux)
      			iImprimeEtat(ETAT_ThermosAlreadybatched,tabAlreadyBatchorder,sKeydate)
      			tabListreportName.Ajoute(sFrepdata+sKeyString+"batched.pdf")
      		Fin
      	FIN
      	
      	
      	
      	
      	tabOrderForReport.SupprimeTout()
      	POUR CHAQUE stTruck,nKeyTruck de stAlldate.taAllTruckrack
      	POUR CHAQUE stRack,nKeyRack de stTruck.taAllTruckRack
      		POUR CHAQUE stOrder de strack.tabCurrentOrder
      			nRes = tabOrderForReport.Cherche(tcLinéaire,"nTruckNumber;nrackNumber;sCustomerNumber;sShippingname",nkeytruck,nkeyrack,stOrder.CustomerNumber,storder.sShippingname)
      			SI nRes = -1 ALORS
      					stCurrentOrderForReport						= allouer un STOrderForReport()
      					stCurrentOrderForReport.nTruckNumber		= nKeyTruck
      					stCurrentOrderForReport.nRackNumber			= nKeyRack
      					stCurrentOrderForReport.sCustomerNumber		= storder.CustomerNumber
      					stCurrentOrderForReport.sCustomerName		= storder.Customername
      					stCurrentOrderForReport.sShippingname		= storder.sShippingname
      				
      					stCurrentOrderForReport.nShippingSequence	= storder.nShippingSequence
      				si storder.bIstriple alors stCurrentOrderForReport.nNumberOftripleThermos = 1 sinon stCurrentOrderForReport.nNumberOfThermos = 1
      				SI PAS stOrder.bTodelete ALORS tabOrderForReport.ajoute(stCurrentOrderForReport)
      			SINON
      				SI stOrder.bIstriple ALORS tabOrderForReport[nRes].nNumberOfTripleThermos += 1 SINON tabOrderForReport[nRes].nNumberOfThermos += 1
      				
      			FIN
      			
      		FIN
      	FIN
      	POUR CHAQUE stOrder de stTruck.tabRackAuMur
      		nRes = tabOrderForReport.Cherche(tcLinéaire,"nTruckNumber;nRackNumber;sCustomerNumber;sShippingName",nKeyTruck,99,stOrder.CustomerNumber,stOrder.sShippingname)
      		SI nRes = -1 ALORS
      			stCurrentOrderForReport						= allouer un STOrderForReport()
      			stCurrentOrderForReport.nTruckNumber		= nKeyTruck
      			stCurrentOrderForReport.nRackNumber			= 99
      			stCurrentOrderForReport.sCustomerNumber		= stOrder.CustomerNumber
      				stCurrentOrderForReport.sShippingname		= storder.sShippingname 
      			stCurrentOrderForReport.sCustomerName		= stOrder.Customername
      			stCurrentOrderForReport.nShippingSequence	= stOrder.nShippingSequence
      			SI stOrder.bIstriple ALORS stCurrentOrderForReport.nNumberOfTripleThermos = 1 SINON stCurrentOrderForReport.nNumberOfThermos = 1
      			si pas stOrder.bTodelete alors tabOrderForReport.Ajoute(stCurrentOrderForReport)
      		SINON
      			SI stOrder.bIstriple ALORS tabOrderForReport[nRes].nNumberOfTripleThermos += 1 SINON tabOrderForReport[nRes].nNumberOfThermos += 1
      		FIN
      		
      	FIN
      	
      FIN
      tabOrderForReport.trie(ttmembre,"nTruckNumber;nRackNumber;sCustomerNumber")
      
      
      	iDestination(iPDFGénérique,sFrepdata+skeyString+".pdf")
      	iFenêtreAbandon(Faux)
      	iimprimeetat(ETAT_TruckRackCustomer,tabOrderForReport,skey)
      	tabListreportName.ajoute(sFrepdata+sKeyString+".pdf")
      	//	iEnchaînementAjoutepdf(sFrepdata+sKey+".pdf")
      	//	iEnchaînementAjoute(ETAT_TruckRackCustomer,tabOrderForReport,dReportDate)
      	
      fin
      
      iapercu()
      pour chaque sListName de tabListreportName
      	iEnchaînementAjoutepdf(slistname)
      FIN
      
      Ferme(FEN_AttenteGif)
      
      
      iEnchaînementImprime()
      
      
      POUR CHAQUE sListName de tabListreportName
      	fsupprime(sListName)
      FIN
     type : 458752
   -
     name : reorderCustomer
     procedure_id : 1674451605241754133
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] reorderCustomer (<CurrentMasterCustomer>)
      //
      // Paramètres :
      //	CurrentMasterCustomer : <indiquez ici le rôle de tamasterCustomer>
      // Valeur de retour :
      // 	tableau associatif (STMasterCustomer) : <indiquez ici le rôle de la valeur de retour>
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure reorderCustomer(CurrentMasterCustomer )
      
      CurrenttaMasterCustomer	est un tableau associatif de STMasterCustomer	= CurrentMasterCustomer
      
      stTri					est une structure
      	CustomerNumber	est une chaîne
      	Quantity		est un entier
      	NumberOfSlotUsed est un entier
      	ToDelete		est un booleen
      fin
      stCurrentTri	est un sttri
      
      nCpt			est un entier	
      nSlotsAvailable	est un entier	= nMaximumRack
      tabCurrentTri	est un tableau de sttri
      
      
      POUR CHAQUE stCMaster,sKeyCustomer de CurrenttaMasterCustomer
      	stCurrentTri				= allouer un sttri()
      	stCurrentTri.CustomerNumber	= sKeyCustomer
      	stCurrentTri.Quantity		= stCMaster.nTotalNumberOfSlotused
      	
      	stCurrentTri.ToDelete		= faux
      	tabCurrentTri.ajoute(Stcurrenttri)
      FIN
      
      
      sFirstCustomer est une chaine
      //CurrenttaMasterCustomer[sFirstCustomer].nRackingOrder = 1
      
      
      
      boucle 
      	ncpt++
      	si tabCurrentTri[1].Quantity > nMaximumRack alors
      		
      		nSlotsAvailable											= nMaximumRack - modulo(tabCurrentTri[1].Quantity,nMaximumRack)
      		
      	sinon
      		nSlotsAvailable											= nMaximumRack - tabCurrentTri[1].Quantity
      	FIN
      	
      	
      	sFirstCustomer											= tabCurrentTri[1].CustomerNumber
      	CurrenttaMasterCustomer[sFirstCustomer].nRackingOrder	= ncpt
      	tabCurrentTri.Supprime(PremierElément)
      	
      	pour i =1  _a_ tabcurrenttri..occurrence
      		si tabcurrenttri[i].Quantity <= nSlotsAvailable alors
      			nCpt++
      			nSlotsAvailable -= tabCurrentTri[i].Quantity
      			CurrenttaMasterCustomer[tabCurrentTri[i].CustomerNumber].nRackingOrder	= ncpt
      			tabCurrentTri[i].ToDelete												= vrai
      		FIN
      	FIN
      	
      	tabcurrenttri = tabCurrentTri.filtre(tri => tri.ToDelete=faux)
      	
      	
      	
      	
      	
      a faire tantque tabcurrenttri..occurrence > 0
      
      
      
      //boucle
      //	
      //a faire tantque currenttamasterCustomer..occurrence > 0
      
      
      CurrenttaMasterCustomer.trie(ttmembre,"nRackingOrder")
      renvoyer CurrenttaMasterCustomer
      
      
     type : 458752
   -
     name : CheckFinish
     procedure_id : 1676236155515727368
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] CheckFinish (<sFinish> est chaîne)
      //
      // Paramètres :
      //	sFinish (chaîne ANSI) : <indiquez ici le rôle de sFinish>
      // Valeur de retour :
      // 	booléen : <indiquez ici le rôle de la valeur de retour>
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure CheckFinish(sFinish est une chaine)
      sFinishToSave est une chaîne
      
      SI  Position(sFinish,".") = 0  _et_ Position(sFinish,"/") = 0 ALORS
      	SI Val(sFinish) > 6 ALORS 
      		sfinish = Arrondi(Val(sFinish)/1000,3 )
      	FIN
      	
      FIN
      
      
      //	sFinishToSave = Arrondi(Val(sFinish) * 25.4,3)
      //SINON
      //	SI PAS Position(sFinish,"/") = 0 ALORS
      //		sFinishToSave =NumériqueVersChaîne( convertiranglais(sFinish,"fini") * 25.4,"6.3f")
      //		
      //	SINON
      //		SI Val(sFinish) < 6 ALORS
      //			sFinishToSave =NumériqueVersChaîne( convertiranglais(sFinish,"fini") * 25.4,"6.3f")
      //		SINON
      //			sFinishToSave = Arrondi(Val(sFinish)/1000 * 25.4,3)
      //		FIN
      //	FIN
      //FIN
      
      
      sFinishToSave = InchFractionToMillimeter(sFinish)
      si sFinishToSave > rMaxFinish ALORS
      	renvoyer vrai
      FIN
      
       renvoyer faux
      
     type : 458752
   -
     name : convertiranglais
     procedure_id : 1676238324497261248
     type_code : 14
     code : |1+
      Procédure convertiranglais(variable,provenance = "")
      //variable est une chaine = moimeme
      //hlitpremier("config","COCLEUNIK")
      longueur est un entier = taille(variable)
      position_espace est un entier = position(variable," ")
      position_point est un entier = Position(variable,".")
      //position_espace1 est un entier = position(variable," ",position_espace+1)
      resultat_gauche est une chaine  
      resultat_droit est une chaine        
      valeuraretourner est un reel
      variableAnglais est une chaine
      o_calculator est un Calculator
      
      si position_point <> 0 alors
      	//info("salut")
      FIN
      si position_espace = 0 alors
      	si position(variable,"/") = 0 alors
      		resultat_gauche = ""
      	sinon
      		resultat_gauche = "0"
      	fin	
      sinon	
      
      	resultat_gauche = gauche(variable,position_espace-1)
          variableAnglais+= resultat_gauche+" "
      FIN
      
      si position_espace = 0 alors
      
      	resultat_droit = variable
      
      sinon	
          tantque variable[[position_espace+1]] = " "
             position_espace++
          fin
          	
      	resultat_droit = milieu(variable,position_espace +1, longueur - position_espace)
      
      FIN
      
      resultat_droit = remplace(resultat_droit," ","")
      variableAnglais+= resultat_droit
      
      si pas position(resultat_droit,"/") = 0 alors
       
      	partie_droit est une chaine = memrecherche("tableau_metrique",resultat_droit)
      	SI partie_droit <> "" ALORS resultat_droit = partie_droit
      FIN
      
      
      
      
      
      si provenance = "fini" alors
      	valeuraretourner = val(resultat_gauche)+val(arrondi(o_calculator.compute(resultat_droit),3))
       
      sinon
      	moimeme = resultat_gauche+resultat_droit
      	selon majuscule(moimeme..Nom)
      		CAS "CDLARGEUR"
      			commandeTRN.fdlargeura = variableAnglais
      		CAS "CDHAUTEUR"
      			commandeTRN.fdhauteura = variableAnglais
      			
      		AUTRE CAS
      			
      	FIN
      	valeuraretourner = vrai
      
      FIN
      
      
      si val(moimeme) > gclConfig.m_rDimensionmaxanglais et pas moimeme = "" alors
      	erreur("Donnée incorrecte")
      	valeuraretourner = faux
      FIN
      SI ChaîneOccurrence(MoiMême,".") > 1 ALORS
      	Erreur("Donnée incorrecte")
      	valeuraretourner = Faux
      FIN
      si ChaîneOccurrence(moimeme,"/") > 1 alors
      	erreur("Donnée incorrecte")
      	valeuraretourner = faux
      FIN
      si ChaîneOccurrence(moimeme,",") > 0 alors
      	erreur("Donnée incorrecte")
      	valeuraretourner = faux
      FIN
       
      
      renvoyer valeuraretourner
      
     type : 458752
   -
     name : WallToWall
     procedure_id : 1677394982339438080
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      // WallToWall ()
      //
      // Paramètres :
      //	Aucun
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure WallToWall()
      
      
      stCurrentOrder	est un stOrder
      nTruckTo		est une entier
      bCancel			est un booléen
      
      (nTruckTo,bCancel) = Ouvre(FEN_Swapwall,nNoCamion,gtaAllDate[gsSelectedTreeDate].taAllTruckrack)
      
      SI bCancel ALORS RENVOYER Faux
      
      
      
      nRes		est un entier
      tabOrder	est un tableau d'entier
      tabOrder.SupprimeTout()
      POUR i = 1 _À_ TABLE_Wallrack.SelectOccurrence()
      	tabOrder.Ajoute(TABLE_Wallrack[TABLE_Wallrack.Select(i)].COL_ID)
      FIN
      
      POUR CHAQUE nRackID DE tabOrder 
      	stCurrentOrder	= allouer un stOrder
      	stCurrentOrder	= gtaAllDate[gsSelectedTreeDate].taAllTruckrack[nNoCamion].tabRackAuMur[nRackID]
      	stCurrentOrder.bTruckChange			= vrai 
      	
      	gtaAllDate[gsSelectedTreeDate].taAllTruckrack[nNoCamion].tabRackAuMur[nRackID].bTodelete = Vrai
      	
      	gtaAllDate[gsSelectedTreeDate].taAllTruckrack[nTruckTo].tabRackAuMur.Ajoute(stCurrentOrder)
      	
      FIN
      
      
      
      FillrackAuMur(gsSelectedTreeDate,nNoCamion)
      
      
     type : 458752
