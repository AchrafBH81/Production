  -
    name : BTN_Calculer_Lpsolve1
    identifier : 0x273cd27022f05a9f
    internal_properties : 
    properties :
     x : 211
     y : 21
     width : 170
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        internal_properties : CQAAAAkAAAC/jXOIr1MXO89p34zI9+SHDhI60UgOQNAFGuJVIDbFeVhOSVNqppWQ9O3Oew1Q/BV2vgEq7w80XaiApWt7+vb9WMnzov3ueCYLbg5LcOHY1iZa/7eJzxg=
        code : |1-
         si BTN_getTruck..visible alors
         	si pas ouinon(0,"Le racking a déjà été calculé et sauvegardé pour cette date","Voulez-vous quand même le recalculer ?") alors
         		renvoyer faux
         	FIN
         FIN
         ouvresoeur(FEN_AttenteGif,"Calcul des racks en cours.....")
         tabCurrentOneRack est un tableau de nMaximumRack reel
         tabOneRack = tabCurrentOneRack
         GRF_Rack.Dessine()
         TABLE_Wallrack.supprimetout()
         
         nCpt									est un entier
         tabRackAll								est un tableau de storder
         tabRack									est un tableau de storder
         tabRackMur								est un tableau de storder
         
         tabCurrentRack							est un tableau de storder
         tabMasterRack							est un tableau de STMasterOrder
         tabMasterUniqueRack						est un tableau de STMasterOrder
         
         stCurrentmasterRack						est un STMasterOrder
         tabCurrentmasterRack					est un tableau de STMasterOrder
         tabCurrentmasterUniqueRack				est un tableau de STMasterorder
         tamasterCustomer						est un tableau associatif  de STMasterCustomer
         bNewCamion								est un booleen 
         Maxrack									est un entier 
         NewrackMandatory						est un booleen
         nNbOfTripleOnRAck						est un entier
         DayNumber								est un entier	= Dateversjour(CAL_Rack)
         Cpt										est un entier										// compteur pour savoir si on est sur un compteur pair/impair pour sasvoir si on met le thermos au début ou à la fin du rack
         bMArkToSuppressCurrentOrder				est un booleen										// si la commande est insérée au complet dans le rack, la marque a supprimer
         nCurrentAddedOrder						est un entier										// Commande qu'on vient d'ajouter sur le rack
         nCurrentQty								est un entier										// quantité a ajouter dans le rack (triple vaut 2)
         bIstruckOverTriple						est un booleen										// Si un camion a plus de thermos triple que de rack (4 thermos triple par rack)
         
         
         
         
         
         
         nNbThermos								est un entier
         
         
         
         sOldOrderNumber							est une chaine
         nRackNumber								est un entier										// numéro de rack en traitement.
         
         
         nCptNbRackPerOrder						est une entier
         nOverQtyOnOneLine						est un entier
         nOverQtyTripleOnRack					est un entier
         
         nQtyToAdd								est un entier
         nQtyToAddForSlotUsed					est un entier										// quantité de slot utilisée par les thermos
         
         bIsnewCustomer							est un booleen										// pour savoir si dans la boucle de remplissage de rack on est sur un nouveau client
         // si oui il faut vérifier si on a de la place pour mettre tous ses thermos sinon change de rack
         tabDateToProcess						est un tableau de chaînes
         
         
         
         
         
         sDateToProcess							est une chaîne	= "("
         pour i = 1 _a_ CAL_Rack.SelectOccurrence()
         	tabDateToProcess.ajoute(CAL_Rack.Select(i))
         	sDateToProcess+= "'"+CAL_Rack.select(i)+"'"+","
         FIN
         sDateToProcess = gauche(sDateToProcess,taille(sDateToProcess)-1) 
         sDateToProcess+= ")"
         
         
         
         
         sTxtsql								est une chaine	= [
         	select camions.NoCamion,facture.fanumero,facture.faclient,facture.FDATEREQUISE,fdetail.fdnumprod,fdetail.fddesc, fdetail.fdqteafacturer
         	as qty,facture.faclient,fdetail.fdlargeuranglais,fdetail.fdhauteuranglais,fdlargeur,fdhauteur,fdlargeura,fdhauteura,fdforme,idlivraison,client.idclient,fdetail.fdligne
         	as OrderDetailLine , facture.facalcul , facture.fpreparation as fpreparation  , thermosType='T' as Istriple ,fdetail.ffini,client.nom as CustomerName,lnom as ShippingName from facture 
         	inner join camions on camions.IDCamions	= facture.IDCamions
         	inner join FDETAIL on FDETAIL.fdnocomm	= facture.fanumero
         	inner join client on client.numero		= facture.faclient
         	where  facture.FDATEREQUISE = %1 and camions.PickUp = 0 and fdetail.ftype = 1 and camions.NoCamion = {pNoCamion} and facture.fatypedocument = 1 and
         	fdetail.thermostype <> 'S' and facture.OnHold = 0
         	order by camions.NoCamion,fdetail.fdlargeuranglais asc
         ]
         sTxtsqlCamion est une chaine = [
         	select distinct camions.NoCamion from facture 
         	inner join camions on camions.IDCamions	= facture.IDCamions
         	inner join FDETAIL on FDETAIL.fdnocomm	= facture.fanumero
         	inner join client on client.numero		= facture.faclient
         	where  facture.FDATEREQUISE = %1 and camions.PickUp = 0 and fdetail.ftype = 1  and facture.fatypedocument = 1 and facture.OnHold = 0 and fdetail.thermostype <> 'S'
         	order by camions.nocamion
         ]
         
         sTxtsqlTriple								est une chaine	= [
         	select  sum(fdetail.fdqteafacturer)
         	as qty from facture 
         	inner join camions on camions.IDCamions	= facture.IDCamions
         	inner join FDETAIL on FDETAIL.fdnocomm	= facture.fanumero
         	inner join client on client.numero		= facture.faclient
         	where  facture.FDATEREQUISE = %1 and camions.PickUp = 0 and fdetail.ftype = 1 and camions.NoCamion = {pNoCamion} and facture.fatypedocument = 1 and
         	facture.OnHold = 0 AND thermostype = 'T'
         ]
         sdReqsqlTriple	est une source de donnees
         sdReqsqlCamion	est une source de donnees
         //sdReqsqlCamion.pdate = sDateToProcess
         gtaAllTruckrack.SupprimeTout()
         gtaAllRack.SupprimeTout()
         gtaAllDate.SupprimeTout()
         ARBRE_Rack.SupprimeTout()
         
         // Trouver tous les camions de la journée
         
         pour ii = 1 _a_ tabDateToProcess..Occurrence
         	sDateToProcess = tabDateToProcess[ii]
         	si HExécuteRequêteSQL(sdReqsqlCamion,hRequêteDéfaut,ChaîneConstruit(sTxtsqlCamion,sDateToProcess)) alors
         		si hnbenr(sdReqsqlCamion) = 0 alors 
         			
         			ferme(fen_attentegif)
         			
         			renvoyer faux
         		FIN
         		// Boucler pour chaque camion
         		pour TOUT sdReqsqlCamion 
         
         			bNewCamion = vrai
         			tabRackAll.supprimetout()
         			tamasterCustomer.supprimetout()
         			tabMasterUniqueRack.supprimetout()
         			sOldOrderNumber = ""
         			sdReqsql est une source de donnees
         			//sdReqsql.pdate		= cal_rack
         			sdReqsql.pnocamion											= sdReqsqlCamion.NoCamion
         			gtaAllTruckrack[val(sdReqsqlCamion.NoCamion)].sTruckdate	= dateverschaine(sDateToProcess,"JJ/MM/AAAA")
         
         
         			//		trouver toutes les commande du camion pour la journée demandée
         
         			si HExécuteRequêteSQL(sdReqsql,hRequêteDéfaut,chaineconstruit(sTxtsql,sDateToProcess)) alors
         				
         				
         				pour TOUT sdReqsql 
         					//		pour i = 1 a sdreqsql.qty
         					//			ncpt++
         					message(nCpt)
         					multitacherepeint()
         					stCurrentOrder est un storder
         					
         					si sdReqsql.facalcul = 1 alors
         						stCurrentOrder.nLargeur						= InchFractionToMillimeter(sdReqsql.fdlargeuranglais)
         						stCurrentOrder.nHauteur						= InchFractionToMillimeter(sdReqsql.fdhauteuranglais)
         						si stCurrentOrder.nLargeur > stCurrentOrder.nhauteur alors
         							stCurrentOrder.nLargeur						= InchFractionToMillimeter(sdReqsql.fdhauteuranglais)
         							stCurrentOrder.nHauteur						= InchFractionToMillimeter(sdReqsql.fdlargeuranglais)
         						FIN
         					sinon
         						stCurrentOrder.nLargeur						= sdReqsql.fdlargeura
         						stCurrentOrder.nHauteur						= sdReqsql.fdhauteura
         						SI stCurrentOrder.nLargeur > stCurrentOrder.nHauteur ALORS
         							stCurrentOrder.nLargeur						= sdReqsql.fdhauteura
         							stCurrentOrder.nHauteur						= sdReqsql.fdlargeura
         						FIN
         					FIN
         					
         					
         					stCurrentOrder.nLargeurhauteur				= stCurrentOrder.nlargeur+stCurrentOrder.nhauteur
         					stCurrentOrder.OrderNumber					= sdReqsql.fanumero
         					stCurrentOrder.CustomerNumber				= sdReqsql.faclient
         					stCurrentOrder.Customername					= sdReqsql.customername 
         					stCurrentOrder.sShippingname				= sdReqsql.shippingName
         					stCurrentOrder.sShapeNumber					= sansespace(sdReqsql.FdForme)
         					stCurrentOrder.nIdClientLivraison			= sdReqsql.idlivraison
         					stCurrentOrder.nIdClient					= sdReqsql.idclient
         					stCurrentOrder.bAlreadyBatched				= sansespace(sdReqsql.fpreparation) <> ""
         					stCurrentOrder.bIstriple					= sdReqsql.istriple
         					stCurrentOrder.sFinish						= sdReqsql.ffini
         					si stCurrentOrder.bIstriple alors
         						// si c,est un triple on vérifie  si l'épaisseur du thermos du thermos dépasse l'épaisseur maximum pour le mettre dans une case normale (pas triple)
         						// si ça dépasse l'paisseur maximum on le flag a vrai pour bFinishOverMax
         						
         						stCurrentOrder.bFinishOverMax               = CheckFinish(sdReqsql.ffini)   
         					sinon
         						stCurrentOrder.bFinishOverMax = faux
         					FIN
         					
         					si stCurrentOrder.bIstriple _ET_  stCurrentOrder.bFinishOverMax ALORS
         						
         						nOverQtyTripleOnRack							= sdReqsql.qty - 3
         						SI nOverQtyTripleOnRack > 0 ALORS
         							nQtyToAdd				= 3
         							nQtyToAddForSlotUsed	= 6
         						SINON
         							nQtyToAdd				= sdReqsql.qty
         							nQtyToAddForSlotUsed	= sdReqsql.qty*2
         							
         						FIN
         					sinon
         						nOverQtyOnOneLine							= sdReqsql.qty - nMaximumRack
         						SI nOverQtyOnOneLine > 0 ALORS
         							nQtyToAdd				= nMaximumRack
         							nQtyToAddForSlotUsed	= nMaximumRack
         						SINON
         							nQtyToAdd				= sdReqsql.qty
         							nQtyToAddForSlotUsed	= sdReqsql.qty
         						FIN
         					FIN
         					stCurrentOrder.nQuantity					= nQtyToAdd
         					stCurrentOrder.nNumberOfSlotUsed			= nQtyToAddForSlotUsed
         					stCurrentOrder.nOrderDetailLine				= sdReqsql.OrderDetailLine
         					tabRackAll.ajoute(stCurrentOrder)
         					nNbThermos+= sdReqsql.qty
         					
         					
         					SI stCurrentOrder.bIstriple _ET_  stCurrentOrder.bFinishOverMax ALORS
         					   // Si c'est un triple et que ça dépasse l'épaisseur maximum pour un thermos triple dans une case ordinaire ( pas triple )
         						SI nOverQtyTripleOnRack > 0 ALORS
         							BOUCLE
         								
         								stCurrentOrder.nQuantity							= Min(nOverQtyTripleOnRack,3)
         								stCurrentOrder.nNumberOfSlotUsed					= Min((nOverQtyTripleOnRack*2),6)
         								tabRackAll.Ajoute(stCurrentOrder)
         								nOverQtyTripleOnRack -= 3
         								
         							À FAIRE TANTQUE nOverQtyTripleOnRack > 0 
         						FIN
         					sinon
         						SI nOverQtyOnOneLine > 0 ALORS
         							BOUCLE
         								
         								stCurrentOrder.nQuantity							= Min(nOverQtyOnOneLine,nMaximumRack)
         								stCurrentOrder.nNumberOfSlotUsed					= Min(nOverQtyOnOneLine,nMaximumRack)
         								tabRackAll.Ajoute(stCurrentOrder)
         								nOverQtyOnOneLine -= nMaximumRack
         								
         							À FAIRE TANTQUE nOverQtyOnOneLine > 0 
         						FIN
         					Fin	
         					//		FIN
         					
         				FIN
         				
         			FIN
         			
         			// Trouver les thermos qui vont au mur > 850 X 850 ou un coté plus grand que 2100
         			tabRackAll.Applique(rackAuMur)
         			
         			// Trouver le séquence de livraison dans la fiche client
         			tabRackAll.Applique(ShippingSequence)
         			
         			//		tabrackAll.Trie(ttMembre,"-nshippingsequence;CustomerNumber;OrderNumber")
         			tabRackAll.Trie(ttMembre,"-nshippingsequence;CustomerNumber;OrderNumber")
         			
         			//Enlever les rack au mur de la liste
         			tabRack				= tabRackAll.filtre(SuppressRackAuMur)
         			nToTTriple est un entier = 0
         			
         			pour tout stunecommande de tabRack
         				si stunecommande.bIstriple et  stunecommande.bFinishOverMax alors
         					nToTTriple += stunecommande.nQuantity
         				FIN
         				
         			FIN
         			bIstruckOverTriple			= faux
         			gstCurrenttruckTriplerack	= allouer un stallrack()
         			
         			si nToTTriple > (ArrondiSupérieur(tabRack.Somme("nQuantity") / nMaximumRack)-1) * 3 alors
         				bIstruckOverTriple			= vrai
         				tabRack.applique(Unrack=>{unrack.nNumberOfSlotUsed = unrack.nQuantity})
         				//			Trace("camion "+sdReqsqlCamion.NoCamion +" est over")
         			FIN
         			
         			
         			
         			
         			//  Grouper les listUneCommandegnes par commande
         			nCptNbRackPerOrder	= 0
         			pour chaque stOrderLine de tabRack
         				
         				si stOrderLine.OrderNumber <> sOldOrderNumber ou (nCptNbRackPerOrder + stOrderLine.nQuantity > nMaximumRack) ALORS
         					si sOldOrderNumber <> "" ou (nCptNbRackPerOrder + stOrderLine.nQuantity > nMaximumRack) alors
         						stCurrentmasterRack.OrderNumber			= tabCurrentRack[1].OrderNumber
         						stCurrentmasterRack.nShippingSequence	= tabCurrentRack[1].nShippingSequence
         						stCurrentmasterRack.sCustomerNumber		= tabCurrentRack[1].CustomerNumber
         						stCurrentmasterRack.nTotalQuantity		= tabCurrentRack.somme("nQuantity")
         						stCurrentmasterRack.nNumberOfSlotused	= tabCurrentRack.somme("nnumberofslotused")
         						stCurrentmasterRack.tabLine				= tabCurrentRack
         						tabMasterRack.ajoute(stCurrentmasterRack)
         					FIN
         					stCurrentmasterRack	= allouer un stmasterorder()
         					tabCurrentRack.supprimetout()
         					sOldOrderNumber		= stOrderLine.OrderNumber
         					nCptNbRackPerOrder	= 0
         				FIN
         				tabCurrentRack.Ajoute(stOrderLine)
         				nCptNbRackPerOrder	+= stOrderLine.nQuantity
         				
         				
         			FIN
         			// enregistrer la dernière commande
         			si tabCurrentRack..occurrence > 0 alors
         				stCurrentmasterRack						= allouer un STMasterOrder()
         				stCurrentmasterRack.OrderNumber			= tabCurrentRack[1].OrderNumber
         				stCurrentmasterRack.nShippingSequence	= tabCurrentRack[1].nShippingSequence
         				stCurrentmasterRack.sCustomerNumber		= tabCurrentRack[1].CustomerNumber
         				stCurrentmasterRack.nTotalQuantity		= tabCurrentRack.Somme("nQuantity")
         				stCurrentmasterRack.nNumberOfSlotused	= tabCurrentRack.Somme("nnumberofslotused")
         				stCurrentmasterRack.tabLine				= tabCurrentRack
         				tabMasterRack.Ajoute(stCurrentmasterRack)
         			Fin
         			
         			// trouver si le client est un client de type Lift/Deck
         			tabMasterRack.Applique(RackLiftShipping)
         			
         			// regrouper les commandes par client
         			
         			tabMasterUniqueRack		= tabMasterRack
         			pour chaque stMaster de tabMasterUniqueRack
         				tamasterCustomer[stMaster.sCustomerNumber].tabAllCustomerOrder.ajoute(stMaster)
         				tamasterCustomer[stMaster.scustomerNumber].nShippingSequence	= stMaster.nshippingSequence
         				tamasterCustomer[stMaster.scustomerNumber].bIsRackLiftShipping	= stMaster.bIsRackLiftShipping
         				tamasterCustomer[stMaster.scustomerNumber].nTotalQuantity	+= stMaster.nTotalQuantity
         				tamasterCustomer[stMaster.scustomerNumber].nTotalNumberOfSlotused	+= stMaster.nNumberOfSlotused
         				
         				
         			FIN
         			tamasterCustomer.trie(ttmembre,"-nTotalQuantity;nShippingSequence")
         			//		tamasterCustomer.trie(ttmembre,"nShippingSequence;bIsRackLiftShipping")
         			
         			tabMasterRack.trie(ttMembre,"bIsRackLiftShipping;-nshippingsequence;-nTotalQuantity")
         			
         			// Mettre les rack au mur dans un tableau différent
         			
         			tabRackMur	= tabRackAll.filtre(OnlyRackAuMur)
         			gtaAllTruckrack[sdReqsqlCamion.Nocamion].tabRackAuMur <= tabRackMur
         			
         			
         				procédure interne RackAuMur(t est un storder)
         					si t.sShapeNumber <> "" _et_ IsMandatoryOnWall(t.sShapeNumber) alors t.bRackAuMur = vrai
         					si t.nHauteur > 2100 _ou_ t.nLargeur > 2100 ALORS
         						t.bRackAuMur = vrai
         					FIN
         					si t.nHauteur > 850 _et_ t.nLargeur > 850 alors
         						t.bRackAuMur = vrai 
         					FIN
         					
         				FIN 
         				PROCÉDURE INTERNE ShippingSequence(t est un STorder)
         					si hlitrecherche(ClientLivraison,IDClientLivraison,t.nIdClientLivraison) alors
         						si clientlivraison.lJourCamionMaster alors
         							
         							si hlitrecherche(JourLivraisonClient,IDClientIDSaisonLivraison,[t.nIdClient,gPeriodeLivraison,0]) alors
         								t.nShippingSequence = JourLivraisonClient.ShippingSequence[DayNumber]
         							FIN
         						sinon
         							SI HLitRecherche(JourLivraisonClient,IDClientIDSaisonLivraison,[t.nIdClient,gPeriodeLivraison,t.nIdClientLivraison]) ALORS
         								t.nShippingSequence = JourLivraisonClient.ShippingSequence[DayNumber]
         							FIN
         							
         							
         						FIN
         					FIN
         					si t.nShippingSequence = 0 alors
         						//	trace(t.OrderNumber)
         					FIN
         					
         				FIN
         			
         				PROCÉDURE INTERNE RackLiftShipping(t est un stmasterorder)
         					SI HLitRecherche(Client,numero,t.sCustomerNumber) ALORS
         						SI Client.IDLoadingType <= 2 alors
         							
         							t.bIsRackLiftShipping = vrai
         							pour chaque stOrder de t.tabLine
         								stOrder.bIsRackLiftShipping = vrai
         								
         							FIN
         						SINON
         							t.bIsRackLiftShipping = faux
         							
         							
         						FIN
         					sinon
         						t.bIsRackLiftShipping = Faux
         						
         					FIN
         					
         				FIN
         			
         				PROCÉDURE INTERNE SuppressRackAuMur(t est un storder)
         					si t.bRackAuMur alors 
         						nNbThermos-=t.nQuantity
         						renvoyer Faux
         					FIN
         					renvoyer vrai	
         				FIN
         				PROCÉDURE INTERNE OnlyRackAuMur(t est un storder)
         					SI t.bRackAuMur ALORS RENVOYER vrai
         					RENVOYER faux
         				FIN
         			
         			
         			//		nnbrack			= PartieEntière(nNbThermos/50) 
         			
         			
         			nCptLow		est un entier	= 1
         			nCpthigh	est un entier	= nMaximumRack
         			//j			est un entier	= 1
         			nTotRack	est un entier
         			bLowHigh	est un booleen	// vrai = low
         			
         			//pour i = 1 _a_ tabRack..occurrence
         			
         			
         			
         			
         			
         			
         			// Trier les commande pour optimiser les racks
         			si tamasterCustomer..Occurrence > 0 alors tamasterCustomer = reorderCustomer(tamasterCustomer)
         			
         			
         			//Remplir les racks selon l'ordre établi 
         			pour chaque stMasterCustomer de tamasterCustomer
         				
         				//			stMasterCustomer.tabAllCustomerOrder.Applique(SeekGreatestWidth)
         				//			stMasterCustomer.tabAllCustomerOrder.trie(ttMembre,"-nGreatestWidth")
         				stMasterCustomer.tabAllCustomerOrder.trie(ttMembre,"-nTotalQuantity")
         				
         				tabCurrentmasterUniqueRack	= stMasterCustomer.tabAllCustomerOrder
         				bIsnewCustomer				= vrai
         				
         				
         				
         				
         				Cpt							= 0
         				Maxrack						= nMaximumRack
         				
         				BOUCLE 
         					nRackNumber++
         					
         					Cpt=0
         					tabCurrentRack.SupprimeTout()
         					tabCurrentmasterRack.supprimetout()
         					nTotRack					= 0
         					
         					si nRackNumber > 1 _et_ pas bNewCamion  et pas NewrackMandatory alors
         						// si ce n'est pas un nouveau camion et que ce n'est pas un nouveau rack obligatoire
         						// vérifier qu'il reste des cases de libre dans le rack en cours
         						soit (nNbEmptySlot,nLowest,nHighest) = checkIfEmptySlot(nRackNumber-1)
         						
         						si nNbEmptySlot > 0  alors
         							// si c'est un nouveau client et que la quantité est inférieure au nombre de case libre, on le met sur le rack
         							si bIsnewCustomer _et_ tabCurrentmasterUniqueRack.Somme("nTotalQuantity") <= nNbEmptySlot ALORS
         								// décrémenter pour mettre sur le rack en cours puisque au début de la boucle le No de rack a été incrémenté
         								nRackNumber--
         								Maxrack		= nNbEmptySlot
         
         							sinon
         								nNbOfTripleOnRAck	= 0
         								nCpthigh			= 24							
         							Fin
         						sinon
         							nNbOfTripleOnRAck	= 0
         							Maxrack				= nMaximumRack	
         
         						fin
         					sinon
         					    // C'est un nouveau rack
         					    
         						nNbOfTripleOnRAck	= 0
         						Maxrack				= nMaximumRack	
         						bNewCamion			= faux	
         						NewrackMandatory	= Faux
         					Fin
         					bIsnewCustomer = faux
         					
         					// si c,est un nouveau client et qu'on est sur un nouveau rack il se peut que la quantité soit supérieure à nMaximumRack (maxrack)
         					si tabCurrentmasterUniqueRack.somme("nNumberOfSlotused") > Maxrack alors
         						
         						tabCurrentmasterUniqueRack.trie(ttmembre,"-nNumberOfSlotused")
         						
         						nCurrentTotal est un entier = 0
         						Cpt = 0
         						// on boucle dans les commandes de ce clients pour remplir le rack au maximum sans dépasser le maximum autorisé
         						
         						pour i = 1 _a_ tabCurrentmasterUniqueRack..occurrence
         							
         							si nCurrentTotal + tabCurrentmasterUniqueRack[i].nNumberOfSlotused <= Maxrack
         								Cpt++
         								nCurrentAddedOrder = tabCurrentmasterRack.ajoute(tabCurrentmasterUniqueRack[i])
         								tabCurrentmasterRack[nCurrentAddedOrder].tabLine.SupprimeTout()
         								bMArkToSuppressCurrentOrder = vrai
         								POUR CHAQUE stLine de tabCurrentmasterUniqueRack[i].tabLine
         									SI stLine.bIstriple AND stLine.bFinishOverMax ALORS
         										si bIstruckOverTriple alors
         											stLine.bAlreadyOnRack = Vrai
         											gstCurrenttruckTriplerack.tabCurrentOrder.Ajoute(stLine)
         										sinon									
         											si nNbOfTripleOnRAck+ stLine.nQuantity <= 4 alors
         												nNbOfTripleOnRAck+= stLine.nQuantity
         												stLine.bAlreadyOnRack = Vrai
         												tabCurrentmasterRack[nCurrentAddedOrder].tabLine.Ajoute(stLine)
         											sinon
         												bMArkToSuppressCurrentOrder = faux
         											FIN
         										FIN
         									sinon
         										
         										stLine.bAlreadyOnRack = Vrai
         										tabCurrentmasterRack[nCurrentAddedOrder].tabLine.Ajoute(stLine)
         									FIN
         									//								tabCurrentRack.Ajoute(stline)
         								FIN
         								// total mis sur le rack
         								nCurrentTotal+=tabCurrentmasterRack[Cpt].nNumberOfSlotused
         								// marquer la commande comma deleted pour ne plus l'utiliser
         								tabCurrentmasterUniqueRack[i].bToSuppress = bMArkToSuppressCurrentOrder
         								
         							fin	
         						FIN
         						//					si tabCurrentmasterRack..Occurrence = 0 alors
         						// Si aucune commande n'a pu être mis sur le rack, on change de rack
         						si tabCurrentmasterRack..Occurrence = 0 alors
         							Maxrack				= nMaximumRack
         							//						nCptLow				= 23
         							//						nCpthigh			= 24  
         							NewrackMandatory	= vrai
         						Fin
         						
         					sinon
         					   // on ne dépasse pas le maximum autorisé pour le rack
         					   
         						pour chaque stRack de tabCurrentmasterUniqueRack
         							
         							Cpt++
         							nCurrentAddedOrder = tabCurrentmasterRack.Ajoute(tabCurrentmasterUniqueRack[Cpt])
         							tabCurrentmasterRack[nCurrentAddedOrder].tabLine.supprimetout()
         							bMArkToSuppressCurrentOrder = vrai
         							POUR CHAQUE stLine de tabCurrentmasterUniqueRack[Cpt].tabLine
         								SI stLine.bIstriple AND stLine.bFinishOverMax ALORS
         									SI bIstruckOverTriple ALORS
         										stLine.bAlreadyOnRack = Vrai
         										gstCurrenttruckTriplerack.tabCurrentOrder.Ajoute(stLine)
         									SINON
         										SI nNbOfTripleOnRAck+ stLine.nQuantity <= 4 ALORS
         											nNbOfTripleOnRAck+= stLine.nQuantity
         											stLine.bAlreadyOnRack = Vrai
         											tabCurrentmasterRack[nCurrentAddedOrder].tabLine.ajoute(stLine)
         										SINON
         											bMArkToSuppressCurrentOrder = Faux
         										FIN
         									fin
         									
         								SINON
         									
         									stLine.bAlreadyOnRack = Vrai
         									tabCurrentmasterRack[nCurrentAddedOrder].tabLine.Ajoute(stLine)
         								FIN
         							Fin
         							tabCurrentmasterUniqueRack[Cpt].bToSuppress = bMArkToSuppressCurrentOrder
         						FIN
         					Fin
         					stMasterCustomer.bToSuppress = vrai
         					//				tabCurrentMasterRack.Trie(ttMembre,"-ngreatestWidth;-nTotalQuantity")
         					//				blowhigh = faux
         					
         					// insérer les commandes trouvées dans le rack
         					POUR chaque stCurrentmaster de tabCurrentmasterRack
         						//					blowhigh = pas blowhigh
         						stCurrentmaster.tabLine.trie(ttmembre,"-nLargeur")
         						pour z = 1 _A_ stCurrentmaster.tabline..occurrence
         							
         							POUR q = 1 _a_ stCurrentmaster.tabline[z].nQuantity  
         								stCurrentmaster.tabline[z].nRackLineNumber								= nCptLow
         								stCurrentmaster.tabline[z].nStickerNumber								= q
         								gtaAllRack[nRackNumber].tabCurrentOrder.Ajoute(stCurrentmaster.tabline[z])
         								
         								gtaAllRack[nRackNumber].bIsRackLiftShipping = stCurrentmaster.bIsRackLiftShipping
         								
         							FIN
         							stCurrentmaster.tabline[z].bProcess	= Vrai
         							
         						fin
         					FIN
         					// Calculer le nombre de thermos triple du rack
         					gtaAllRack[nRackNumber].nNumberOfTriple										= nNbOfTripleOnRAck
         					//////////////////
         					// Recalculer pour avoir une demilune
         					
         					gtaAllRack[nRackNumber]														= RegenerateOrderOnRack(gtaAllRack[nRackNumber].tabCurrentOrder,nNbOfTripleOnRAck)
         					////////////////
         					//////////////
         					gtaAllTruckrack[val(sdReqsqlCamion.NoCamion)].taAllTruckRack[nRackNumber]	= gtaAllRack[nRackNumber]	
         					
         					
         					
         					
         					// Enlever les commandes déja traitées
         					
         					tabCurrentmasterUniqueRack													= tabCurrentmasterUniqueRack.filtre(Rack => Rack.bToSuppress = faux)
         					pour chaque stOrder de tabCurrentmasterUniqueRack
         						stOrder.tabLine = stOrder.tabline.filtre(Line => line.bAlreadyOnRack = faux)
         					FIN
         				//		
         				// 
         				// 		
         				
         				À FAIRE TANTQUE tabCurrentmasterUniqueRack.Occurrence() > 0
         				
         				
         				
         			Fin
         			
         			// si le camion a un rack de triple seulement
         			
         			si gstCurrenttruckTriplerack.tabCurrentOrder..occurrence > 0 alors
         				
         				boucle
         					nRackNumber++
         					nCurrentTotal = 0
         					// insérer les commandes trouvées dans le rack
         					POUR CHAQUE order de gstCurrenttruckTriplerack.tabCurrentOrder
         						//					blowhigh = pas blowhigh
         						
         						si nCurrentTotal+order.nQuantity < nMaximumRack 
         							POUR q = 1 _a_ order.nQuantity  
         								gtaAllRack[nRackNumber].tabCurrentOrder.Ajoute(order)
         							FIN
         							nCurrentTotal+=order.nquantity
         							order.bTodelete = vrai
         						sinon
         							sortir
         						FIN
         						
         					FIN
         					
         					
         					gtaAllRack[nRackNumber]														= RegenerateOrderOnRack(gtaAllRack[nRackNumber].tabCurrentOrder,nNbOfTripleOnRAck,vrai)
         					gtaAllRack[nRackNumber].bTripleOnly											= vrai
         					////////////////
         					//////////////
         					gtaAllTruckrack[Val(sdReqsqlCamion.NoCamion)].taAllTruckRack[nRackNumber]	= gtaAllRack[nRackNumber]	
         					gstCurrenttruckTriplerack.tabCurrentOrder									= gstCurrenttruckTriplerack.tabCurrentOrder.filtre(CurrentOrder => CurrentOrder.bTodelete = faux)
         				a faire tantque  gstCurrenttruckTriplerack.tabCurrentOrder..occurrence > 0
         				
         			Fin
         			
         		FIN
         		
         	FIN
         	
         	
         	
         	
         	nNbOfEmptyrack est un entier = 0
         	
         	
         	/// centrer les racks
         	pour chaque stTruck,nKeytruck de gtaAllTruckrack
         		
         		pour chaque stCurrentRAck,nSKeyrack de stTruck.taAllTruckRack
         			SI  gtaAllTruckrack[nKeytruck].taAllTruckRack[nSKeyrack].tabCurrentOrder..Occurrence = 0 ALORS
         				nNbOfEmptyrack++
         			FIN
         			
         			gtaAllTruckrack[nKeytruck].taAllTruckRack[nSKeyrack] =  centerrack(gtaAllTruckrack[nKeytruck].taAllTruckRack[nSKeyrack])
         		FIN
         	FIN
         	
         	
         	/// Supprimer les rack vide
         	
         	pour i = 1 a nNbOfEmptyrack
         		gtaAllDate[DateVersChaîne(sDateToProcess,"JJ/MM/AAAA")].taAllTruckrack = gtaAllTruckrack
         		POUR CHAQUE stTruck,nKeytruck de gtaAllTruckrack
         			POUR CHAQUE stCurrentRAck,nSKeyrack de stTruck.taAllTruckRack
         				SI  gtaAllTruckrack[nKeytruck].taAllTruckRack[nSKeyrack].tabCurrentOrder..Occurrence = 0 ALORS
         					DeleteEmptyrack(nKeytruck,nSKeyrack,faux,sDateToProcess)
         					sortir
         				FIN
         			FIN
         		FIN
         	Fin
         	
         	
         	
         	gtaAllDate[DateVersChaîne(sDateToProcess,"JJ/MM/AAAA")].taAllTruckrack = gtaAllTruckrack
         	gtaAllTruckrack.supprimetout()
         fin
         
         BTN_Save..Etat	= Actif
         BTN_Print..Etat	= Actif
         
         Showrack()
         ferme(FEN_AttenteGif)
         
         
         CAS EXCEPTION:
         
         erreur(Exceptioninfo(errComplet))
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_Delete
    identifier : 0x276ed086885cf422
    internal_properties : 
    properties :
     x : 211
     y : 93
     width : 37
     height : 37
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         sdReqSql	est une source de donnees
         sTxtsql		est une chaine	= [
         delete from racking where racking.masterNumber = {pMasterNumber}
         ]
         
         sTxtsqlMaster		est une chaine	= [
         delete from rackingMaster where rackingmaster.MasterNumber = {pMasterNumber}
         ]
         sdReqSqlmaster	est une source de donnees
         sdReqSqlmaster.pmasterNumber = gnCurrentmasterRack
         SI PAS HExécuteRequêteSQL(sdReqSqlmaster,hRequêteDéfaut,sTxtsqlMaster) ALORS
         	Erreur("erreur de requete",ErreurInfo(errComplet))
         FIN
         
         
         sdReqSql.pmasterNumber = gnCurrentmasterRack
         SI PAS HExécuteRequêteSQL(sdReqSql,hRequêteDéfaut,sTxtsql) ALORS
         	Erreur("erreur de requete",ErreurInfo(errComplet))
         FIN
         si ouinon("Voulez-vous supprimer le racking pour la (les) date(s) sélectionnée(s) ?") alors
         	si ouinon(0,"*** ATTENTION ***","La suppression est définitive. Voulez-vous continuer ?") alors
         		sdReqSqlmaster.pmasterNumber = gnCurrentmasterRack
         		SI PAS HExécuteRequêteSQL(sdReqSqlmaster,hRequêteDéfaut,sTxtsqlMaster) ALORS
         			Erreur("erreur de requete",ErreurInfo(errComplet))
         		FIN
         		
         		
         		sdReqSql.pmasterNumber = gnCurrentmasterRack
         		SI PAS HExécuteRequêteSQL(sdReqSql,hRequêteDéfaut,sTxtsql) ALORS
         			Erreur("erreur de requete",ErreurInfo(errComplet))
         		FIN
         		TABLE_TabOneRack.supprimetout()
         		TABLE_Wallrack.SupprimeTout()
         		POUR i = 1 À nMaximumRack
         			tabOneRack[i] = 0
         		FIN
         		GRF_Rack.Dessine()
         		ARBRE_Rack.SupprimeTout()
         		POUR i = 1 _a_ CAL_Rack.SelectOccurrence()
         			CAL_Rack.SelectMoins(CAL_Rack.Select(i))
         		FIN
         	FIN
         FIN
        type : 18
      -
        type : 161
        enabled : false
