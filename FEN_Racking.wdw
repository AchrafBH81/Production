        enabled : false
      -
        code : |1+
         si TABLE_TabOneRack[TABLE_TabOneRack].COL_IsTriple alors
         	si 	TABLE_TabOneRack[TABLE_TabOneRack].COL_IsFinishOverMax alors
         		TABLE_TabOneRack[TABLE_TabOneRack]..CouleurFond = iRougeClair
         	sinon
         		TABLE_TabOneRack[TABLE_TabOneRack]..CouleurFond = iMagentaClair
         	FIN
         	
         sinon
         	TABLE_TabOneRack[TABLE_TabOneRack]..CouleurFond = iTransparent
         FIN
        type : 21
