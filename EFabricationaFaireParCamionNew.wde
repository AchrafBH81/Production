         qtecarr9 = RequeteDetailUnJourV1ParCamion.fdqte
         qtecarr28 = RequeteDetailUnJourV1ParCamion.fdcarreauv
         qtecarr64 = RequeteDetailUnJourV1ParCamion.fdcarreauh
         qtecarr65 = RequeteDetailUnJourV1ParCamion.fdcarreauv * RequeteDetailUnJourV1ParCamion.fdcarreauh
         PrixUnitCarr1 = RequeteDetailUnJourV1ParCamion.fPrixCarreauPeinture
         TotalCarr1 =qtecarr65 * PrixUnitCarr1 * qtecarr9
         selon RequeteDetailUnJourV1ParCamion.fTypePeinture
         	cas 2
         		DescriptionPeinture = "Peint.TLT" + RequeteDetailUnJourV1ParCamion.fNoPeintureExtTout + " " + sansespace(RequeteDetailUnJourV1ParCamion.fdescpeintureExtTout)
         	cas 1
         		DescriptionPeinture = "Peint. ext." + RequeteDetailUnJourV1ParCamion.fNoPeintureExtTout + " " + sansespace(RequeteDetailUnJourV1ParCamion.fdescpeintureExtTout)
         FIN
        type : 327692
      -
        code : |1+
         
         si sansespace(RequeteDetailUnJourV1ParCamion.FnopeintureInterieure) <> "" alors
         	iImprimeBloc(ITERATION8)
         fin
         
        type : 327693
