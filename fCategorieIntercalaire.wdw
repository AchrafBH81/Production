         pour tout IntercalaireCouleurDimensions
         	si HLitRecherche(IntercalaireCouleurs,IDIntercalaireCouleurs,IntercalaireCouleurDimensions.IDIntercalaireCouleurs) alors
         		IntercalaireCouleurDimensions.Varinter1 = IntercalaireCouleurs.VarInter1
