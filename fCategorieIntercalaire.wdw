  -
    name : BTN_AJOUT
    identifier : 0x514dba3e2165970d
    internal_properties : 
    properties :
     x : 86
     y : 6
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         selon OngletIntercalaire
         	cas 1
         		ouvre(FenetreAjoutModificationIntercalaire,"")
         		tableaffiche(TableCatSpacer)
         	cas 2
         		ouvre(FenetreAjoutModificationIntercalaireCouleur,IntercalaireS.Description)
         		TableAffiche(Table_IntercalaireCouleurs,taCourantBandeau)
         	cas 3
         		ouvre(FenetreAjoutModificationIntercalaireCouleurDimension,Intercalaires.Description+" - "+ intercalairecouleurs.Description)
         		TableAffiche(Table_IntercalaireCouleurDimension,taCourantBandeau)
         FIN
         
         
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_MODIFIE
    identifier : 0x514dba3e26c99735
    internal_properties : 
    properties :
     x : 127
     y : 6
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         selon OngletIntercalaire
         	cas 1
         		ouvre(FenetreAjoutModificationIntercalaire,"","M")
         		TableAffiche(TableCatSpacer,taCourantBandeau)
         	cas 2
         		ouvre(FenetreAjoutModificationIntercalaireCouleur,IntercalaireS.Description,"M")
         		TableAffiche(Table_IntercalaireCouleurs,taCourantBandeau)
         	cas 3
         		ouvre(FenetreAjoutModificationIntercalaireCouleurDimension,Intercalaires.Description+" - "+ intercalairecouleurs.Description,"M")
         		TableAffiche(Table_IntercalaireCouleurDimension,taCourantBandeau)
         
         FIN
         
         
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_DETRUIRE
    identifier : 0x514dba3e133d9749
    internal_properties : 
    properties :
     x : 168
     y : 6
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         selon OngletIntercalaire
         	cas 1
         		si ACSO_message("Question","Voulez-vous supprimer l'intercalaire "+SansEspace(TableCatSpacer.Description[IndiceEnCours()]),"OuiNon") = idyes alors
         		//si ouinon("Voulez-vous supprimer l'intercalaire "+sansespace(TableCatSpacer.Description[indiceencours()]))= oui alors 
         			tablesupprime(TableCatSpacer,indiceencours())
         		FIN
         	cas 2
         		SI ACSO_message("Question","Voulez-vous supprimer l'intercalaire "+SansEspace(Table_IntercalaireCouleurs.Description[IndiceEnCours()])  ,"OuiNon") = IDYES ALORS
         			//si ouinon("Voulez-vous supprimer l'intercalaire "+sansespace(Table_IntercalaireCouleurs.Description[indiceencours()]))= oui alors 
         			tablesupprime(Table_IntercalaireCouleurs,indiceencours())
         		FIN
         
         	cas 3
         		si ACSO_message("Question","Voulez-vous supprimer la dimension "+SansEspace(Table_IntercalaireCouleurDimension.numero[IndiceEnCours()]) + " de " +IntercalaireCouleurs.Description ,"OuiNon") = idyes alors
         		//si ouinon("Voulez-vous supprimer la dimension "+sansespace(Table_IntercalaireCouleurDimension.numero[indiceencours()]) + " de " +IntercalaireCouleurs.Description ) = oui alors 
         			tablesupprime(Table_IntercalaireCouleurDimension,indiceencours())
         		FIN
         
         FIN
         
         
         
         
         
        type : 18
      -
        type : 161
        enabled : false
