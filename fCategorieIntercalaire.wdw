  p_codes :
   -
     code : |1+
      // Ouverture de la fenêtre de type Table
      PROCEDURE TableRAD(ValeurFiltre="")
      GLOBALE
      	gbRequeteLocal est un booléen = Faux				// Est-ce que la requête a du être exécutée ?
      
      
      // Gestion des erreurs d'accès à la base de données
      // Les messages d'erreurs renvoyés par la base sont  affichés
      // Vous pouvez traiter ici les compte-rendu d'erreurs de votre base
      QUAND Exception
      	Erreur("Une erreur est survenue dans la fenêtre",ExceptionInfo(errMessage))
      	// On réactive les exceptions
      	ExceptionActive()
      	// On reprend le traitement
      	RepriseSaisie()
      FIN
      
      
      // Spécification d'un filtre initial par défaut
      FiltreInitial(ValeurFiltre)
      Policetexte est une police
   -
     code : |1+
      Table_IntercalaireCouleurs.VarInter1..Libellé = DescriptionVarInter1
      Table_IntercalaireCouleurs.VarInter2..Libellé = DescriptionVarInter2
      Table_IntercalaireCouleurs.VarInter3..Libellé = DescriptionVarInter3
      Table_IntercalaireCouleurs.VarInter4..Libellé = DescriptionVarInter4
      Table_IntercalaireCouleurs.VarInter5..Libellé = DescriptionVarInter5
      
      Table_IntercalaireCouleurs.VarInter1A..Libellé = DescriptionVarInter1 + " ( Arg )"
      Table_IntercalaireCouleurs.VarInter2A..Libellé = DescriptionVarInter2 + " ( Arg )"
      Table_IntercalaireCouleurs.VarInter3A..Libellé = DescriptionVarInter3 + " ( Arg )"
      Table_IntercalaireCouleurs.VarInter4A..Libellé = DescriptionVarInter4 + " ( Arg )"
      Table_IntercalaireCouleurs.VarInter5A..Libellé = DescriptionVarInter5 + " ( Arg )"
      
      Table_IntercalaireCouleurDimension.VarInter1..Libellé = DescriptionVarInter1
      Table_IntercalaireCouleurDimension.VarInter2..Libellé = DescriptionVarInter2
      Table_IntercalaireCouleurDimension.VarInter3..Libellé = DescriptionVarInter3
      Table_IntercalaireCouleurDimension.VarInter4..Libellé = DescriptionVarInter4
      Table_IntercalaireCouleurDimension.VarInter5..Libellé = DescriptionVarInter5
      
      Table_IntercalaireCouleurDimension.VarInter1A..Libellé = DescriptionVarInter1 + " ( Arg )"
      Table_IntercalaireCouleurDimension.VarInter2A..Libellé = DescriptionVarInter2 + " ( Arg )"
