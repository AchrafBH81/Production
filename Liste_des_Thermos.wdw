 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1-
      PROCEDURE MaFenêtre()
      ReqSql est une source de Données
      TxtSql est une chaine = "select fdnumprod,fddesc,fdqte,fdpiedcarrefacture,fdligne,trcleunik from trdetail where trdetail.ftype = 1 order by trdetail.fdligne"
   -
     code : |1+
      HExécuteRequêteSQL(reqsql,hRequêteDéfaut,txtsql)
      pour TOUT ReqSql 
      	tableajouteligne(Table_trdetail,1,reqsql.fdnumprod,reqsql.fddesc,reqsql.fdqte,reqsql.fdpiedcarrefacture,reqsql.trcleunik)
      	TotPiedCarre+=ReqSql.fdqte*arrondi(ReqSql.fdpiedcarrefacture,2)
      FIN
     type : 34
   -
     type : 180
     enabled : false
   -
     type : 230
     enabled : false
