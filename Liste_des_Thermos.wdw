  -
    name : BTN_OK
    identifier : 0x2afaf15046bcb73f
    internal_properties : 
    properties :
     x : 794
     y : 28
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         sCurrentThermos est une chaine
         
         MaFenêtre..ValeurRenvoyée = TotPiedCarre
         sCurrentThermos += TotPiedCarre 
         pour chaque ligne de Table_trdetail
               sCurrentThermos +=   [","] + Table_trdetail.COL_CleUnik+";"+Table_trdetail.CaseACocher+";"+arrondi(Table_trdetail.PiedCarre,2) 
         FIN
         MaFenêtre..ValeurRenvoyée = sCurrentThermos
         
         
         ferme(Liste_des_Thermos)
        type : 18
      -
        type : 161
        enabled : false
