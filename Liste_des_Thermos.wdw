     width : 21
     height : 20
    options :
     -
       internal_properties : CQAAAAkAAAD3w6ohfznGxa2Mryh1oqoIZ5xHGhQPSDmIQtcRQz+M3brOBPQR2e7lUfB0l2aHiXeDAlvxz/+Rw99l/CE7N3H0efdsScR5uFnwdgjNB2XNnf4dCPjpwxRDTfwF9K8KUEXFjfcLwWJ+oPoUy5A=
    type : 5
    controls : []
    code_elements :
     type_code : 5
     p_codes :
      -
        code : |1+
         si moimeme alors
         	TotPiedCarre = 0
         	pour i = 1 _a_ TableOccurrence(table_trdetail)
         		Table_trdetail.CaseACocher[i] = vrai
         		TotPiedCarre+=table_trdetail.PiedCarre[i] * table_trdetail.fdqte[i]
         	FIN
         sinon
         		TotPiedCarre = 0
         	POUR i =  1 _A_ TableOccurrence(Table_trdetail) 
         		Table_trdetail.CaseACocher[i] = faux
         	FIN
         	
         FIN
        type : 17
