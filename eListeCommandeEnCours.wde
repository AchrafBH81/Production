 code_elements :
  type_code : 13
  p_codes :
   -
     code : |1+
      gtotalthermosBL =0
      gtotalcarrelagebl =0
      gtotalcarrelageptbl =0
      gtotalpeinturebl =0
      gtotalautresbl =0
      gtotaltotalbl =0
      ldebut est un booleen = vrai
     type : 327680
   -
     code : |1-
      si sansespace(FACTURE.fprEPARATION) = "B" alors 
      	renvoyer faux
      FIN
      
      SI FACTURE.FANUMERO = 0 ALORS 
      	RENVOYER FAUX
      FIN
      SI FACTURE.fatypedocument <> 1 ALORS 
      	RENVOYER FAUX
      FIN
       si facture.OnHold = 1 alors renvoyer faux
     type : 327696
  procedures :
   -
     name : calculTotalCommande
     procedure_id : 5163571290322632185
     type_code : 14
     code : |1+
      Procédure calculTotalCommande(lNoCommande=0)
      TotalCommande est un reel
      lQteAjuste est un reel
      //SI MODIF ALORS
      
      
      
      
      
      hlitrecherche(fdetail,fdnocomm,lNoCommande)
      //Code WinDev 5.5 remplacé par la migration :
      //tantque pas h.endehors
      tantque pas HEnDehors() et fdetail.fdnocomm= lNoCommande
      lQteAjuste = fdetail.fdqteafacturer / fdetail.fdqte
      	selon fdetail.ftype
      		cas 1
      			rthermos+=((arrondi(fdetail.fdprixtotal,2)+arrondi(fdetail.surchargeenergie,2)) * lQteAjuste) + (fdetail.fdqteafacturer * (fdetail.FDextra10X+fdetail.FDextra5x))
      			RTotalCommande+=((arrondi(fdetail.fdprixtotal,2)+arrondi(fdetail.surchargeenergie,2)) * lQteAjuste) + (fdetail.fdqteafacturer * (fdetail.FDextra10X+fdetail.FDextra5x))
      		cas 2
      			rthermos+=((arrondi(fdetail.fdprixtotal,2)+arrondi(fdetail.surchargeenergie,2)) * lQteAjuste) + (fdetail.fdqteafacturer * (fdetail.FDextra10X+fdetail.FDextra5x))
      			RTotalCommande+=((arrondi(fdetail.fdprixtotal,2)+arrondi(fdetail.surchargeenergie,2)) * lQteAjuste) + (fdetail.fdqteafacturer * (fdetail.FDextra10X+fdetail.FDextra5x))
      		cas 3
      			rautres+=(arrondi(fdetail.fdprixtotal,2)) * lQteAjuste
      			RTotalCommande+=(arrondi(fdetail.fdprixtotal,2)) * lQteAjuste
      		cas 4
      			rcarrelage+=(arrondi(fdetail.fdprixtotal,2)) * lQteAjuste
      			RTotalCommande+=(arrondi(fdetail.fdprixtotal,2)) * lQteAjuste
      			si fdetail.fpeinture alors
      				RTotalCommande+=(arrondi(fdetail.fTotalPeinture,2)) * fdetail.fdqteafacturer
      				rcarrelagept+=(arrondi(fdetail.fTotalPeinture,2)) * fdetail.fdqteafacturer
      			fin
      		cas 5
      			rpeinture+=(arrondi(fdetail.fdprixtotal,2)) * lQteAjuste
      			RTotalCommande+=(arrondi(fdetail.fdprixtotal,2)) * lQteAjuste
      
      	FIN
      
      	//hmodifie("trdetail")
      	HLITSUIVANT(fdetail,fdnocomm)
      
      fin		 
      
      
      
      
     type : 458752
  procedure_templates : []
  property_templates : []
