  -
    name : Bouton1
    identifier : 0x28a9bd3eb8b2dc75
    internal_properties : 
    properties :
     x : 31
     y : 6
     width : 139
     height : 38
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         HSurErreur(RelationEDI,hErrDoublon,"")
         
         	
         pour i = 1 _a_ TableOccurrence(Table_RelationForme)
         	hraz(RelationEDI)
         	relationedi.TYpeObjet = 6
         	RelationEDI.IdClient = idclientcourant
         	
         	relationedi.descriptionEDIClient = Table_RelationForme.Description[i]
         	relationedi.IDForme = Table_RelationForme.Idforme[i]
         	hajoute(relationedi)
         	si HErreurDoublon() alors
         
         	FIN
         FIN
         mafenetre..ValeurRenvoyée = vrai
         ferme(mafenetre)
        type : 18
      -
        type : 161
        enabled : false
  -
    name : Bouton2
    identifier : 0x28a9bd3eb8b3dc75
    internal_properties : 
    properties :
     x : 1021
     y : 119
     width : 71
     height : 65
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         chaineatraiter est une chaine = Ouvre(LISTFICHIMAGE)
         si   chaineatraiter <> "" ALORS
         	si hlitrecherche(forme,fnumero,chaineatraiter) alors
         			Table_RelationForme.Idforme = forme.FOCLEUNIK
         			Table_RelationForme.Colonne1 = forme.fdescription
         	fin
         FIN
         
        type : 18
      -
        type : 161
        enabled : false
  -
    name : Bouton3
    identifier : 0x28a9bd3eb8b4dc75
    internal_properties : 
    properties :
     x : 207
     y : 6
     width : 231
     height : 38
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         
         si ouinon("Voulez-vous quitter et annuler vos modifications ?") = oui alors
         	ferme(mafenetre)
         fin
        type : 18
      -
        type : 161
        enabled : false
