   -
     name : RemplircommandeDetail
     procedure_id : 5059973561548390613
     type_code : 14
     code : |1+
      Procédure RemplircommandeDetail()
      EstThermosFermeExterne est un booleen = faux
      
      pour tout TCommandeAchatDetail 
      
      	si TCommandeAchatDetail.IdCommandeoriginale <> 0 alors
      		si TCommandeAchatDetail.cadRaye alors
      			si hlitrecherche(CommandeAchatDetail,IDCommandeAchatDetail,TCommandeAchatDetail.IdCommandeoriginale) alors
      				hsupprime(CommandeAchatDetail,hnumenrencours)
      			fin
      		sinon
      			si pas estThermosFermeExterne alors estThermosFermeExterne = CheckIfExterne(TCommandeAchatDetail.cadNoProduit)
      			si hlitrecherche(CommandeAchatDetail,IDCommandeAchatDetail,TCommandeAchatDetail.IdCommandeoriginale) alors
      				HCopieEnreg(CommandeAchatDetail,tCommandeAchatDetail)
      				CommandeAchatDetail.IDCommandeAchat = CommandeAchat.IDCommandeAchat
      				hmodifie(CommandeAchatDetail,hnumenrencours)
      			sinon
      				HCopieEnreg(CommandeAchatDetail,TCommandeAchatDetail)
      				CommandeAchatDetail.IDCommandeAchat = CommandeAchat.IDCommandeAchat
      				HAjoute(CommandeAchatDetail)
      				
      			fin
      		fin
      	sinon
      		si pas TCommandeAchatDetail.cadRaye alors
      			SI PAS estThermosFermeExterne ALORS estThermosFermeExterne = CheckIfExterne(TCommandeAchatDetail.cadNoProduit)
      			HCopieEnreg(CommandeAchatDetail,tCommandeAchatDetail)
      			CommandeAchatDetail.IDCommandeAchat = CommandeAchat.IDCommandeAchat
      			hajoute(CommandeAchatDetail)
      		fin
      	fin
      FIN
      renvoyer estThermosFermeExterne
      
      
      
      
      
     type : 458752
