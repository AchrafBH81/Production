    name : BtnFTP
    identifier : 0x2088b105108b9266
    internal_properties : 
    properties :
     x : 457
     y : 12
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         FileToSend est un tableau de chaînes
         SendOK est un booleen
         bIsException est un booleen
         
         IdFileEdi est une chaine
         IDFilePDF est une chaîne = ComplèteRep(repdonnees)+"PDF\"+Fournisseur.Fnumero+"\Achat\"+CommandeAchat.CaNumero+".pdf"
         iDestination(iPDFGénérique,IDFilePDF)
         RequeteCommandeAchatEtat.pIdCommandeAchat = CommandeAchat.IDCommandeAchat
         
         
         HExécuteRequête(RequeteCommandeAchatEtat)
         iImprimeEtat(EcommandeAchat)
         si RequeteCommandeAchatEtat.CaThermosVerre <> "" alors
         	(IdFileEdi,bIsException) = prepareEdiRobover()
         fin
         
         tabfilename est un tableau de chaine = ouvre(fcommandeAchatresume,commandeachat.IDCommandeAchat,IdFileEdi,NumériqueVersChaîne(CommandeAchat.CaNumero),bIsException)
         
         si tabfilename..Occurrence <> 0 alors
         	SI Fournisseur.fEdiSendBy = 2 ALORS 
         		si SendEdiRobover(IdFileEdi,"EDI"+CommandeAchat.CaNumero+".edi",IDFilePDF,CommandeAchat.CaNumero+".pdf",tabfilename) alors
         			CommandeAchat.casended = Vrai
         			hmodifie(CommandeAchat,hnumenrencours)
         			tableaffiche(Table_CommandeAchat,taCourantEnreg)
         			Info("L'envoi sur le serveur FTP a réussi !!!")
         		sinon
         			Erreur("Échec de l'envoi FTP")
         		fin
         	FIN
         sinon
         //	Erreur("Aucun fichier sélectionné pour l'envoi FTP")
         fin
        type : 18
      -
        type : 161
        enabled : false
