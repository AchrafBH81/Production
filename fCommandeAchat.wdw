#To edit and compare internal_properties, use WINDEV integrated tools.
#Internal properties refer to the properties of controls in windows, reports, etc.
info :
 name : fCommandeAchat
 major_version : 29
 minor_version : 0
 type : 2
 description : ""
 subtype : 0
window :
 name : fCommandeAchat
 identifier : 0x4635504f2e4c2e9b
 internal_properties : 
 properties :
  width : 907
  height : 598
  widthClient : 905
  heightClient : 566
 controls :
  -
    name : Btn_Ok
    identifier : 0x463555ad1fde230c
    internal_properties : 
    properties :
     x : 123
     y : 12
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         bEstThermosFermeExterne est un booleen
         IDFilePDF est une chaîne 
         valideCommande()
         EcranVersFichier(fCommandeAchat,CommandeAchat)
         
         si lajout alors
             
         	HLit(config,1)
         	NextOrderNumber est un entier = config.NumCF
         //	NextOrderNumber = GetNextOrderNumber()
         	//hraz(CommandeAchat)
         	CommandeAchat.CaNumero = NextOrderNumber
         	CommandeAchat.CaNote=Ouvre(fCommentaire,"Tag#"+NoCommande+"/"+NoClient)+RC
         	commandeachat.CanoCommande = nocommande
         	CommandeAchat.caetat = 0
         	CommandeAchat.CaThermosVerre = ThermosOuVerre
         	HSurErreur(CommandeAchat,hErrDoublon,"") 
         	hajoute(commandeachat)
         	boucle
         		si HErreurDoublon() alors
         			NextOrderNumber+=1
         			commandeachat.CaNumero = NextOrderNumber
         			hajoute(CommandeAchat)
         		sinon
         			sortir
         		fin
         	fin
         	NextOrderNumber+=1
         	config.NumCF = NextOrderNumber
         	HModifie(config,hNumEnrEnCours)
         	
         	
         	RemplircommandeDetail()
         	CommandeAchat.CaFermeExterieur = ThermosFermeExterieur
         	
         	
         	hmodifie(CommandeAchat,hNumEnrEnCours)
         	Ouvre(wnumerodefacture,commandeachat.CaNumero)
         	ExécuteTraitement(BtnImprime,trtClic)
         
         	
         	IDFilePDF  = completerep(fRepertoiretemp)+CommandeAchat.CaNumero+".pdf"
         	iDestination(iPDFGénérique,IDFilePDF)
         	iImprimeEtat(EcommandeAchat)
         	hraz(CommandeAchatDessin)
         	CommandeAchatDessin.IDCommandeAchat = commandeachat.IDCommandeAchat
         	CommandeAchatDessin.FileDescription = "Commande principale"
         	CommandeAchatDessin.Master = vrai
         	HAttacheMémo(CommandeAchatDessin,Dessin,IDFilePDF,hMémoImg)
         	HAjoute(CommandeAchatDessin)
         
         	
         	fSupprime(IDFilePDF)
         	si Fournisseur.fEdiSendBy > 1 alors
         		SI ACSO_message("Question","Voulez-vous transmettre cette commande à un fournisseur","OuiNon") = IDYES ALORS
         			//			SendType est un entier = gettype(CommandeAchat.CaFournisseur)
         			SELON fournisseur.fEdiSendBy
         				CAS 1
         					
         				CAS 2
         					ExécuteTraitement(BtnFtp,trtClic)
         				CAS 3
         					ExécuteTraitement(BtnPdf,trtClic)
         				AUTRE CAS
         					
         			FIN
         			
         //			ExécuteTraitement(BtnPdf,trtClic)
         		FIN
         	fin
         	
         sinon
         	ecranversfichier(fCommandeAchat,commandeachat)
         	commandeachat.CaNote=ouvre(fcommentaire,CommandeAchat.CaNote)
         	//	hmodifie(CommandeAchat,hnumenrencours)
         
         	RemplircommandeDetail()
         
         	//	HModifie(CommandeAchat,hNumEnrEnCours)
         	commandeachat.CaEtat = VerifieSiToutRecu(commandeachat.IDCommandeAchat)
         	HModifie(CommandeAchat,hNumEnrEnCours)
         	
         	si acso_message("Question","Voulez-vous réimprimer la commande d'achat","OuiNon") = idyes alors
         		executetraitement(BtnImprime,trtclic)
         	fin
         	
         FIN
         
         IDFilePDF  = completerep(fRepertoiretemp)+CommandeAchat.CaNumero+".pdf"
         RequeteCommandeAchatEtat.pIdCommandeAchat = CommandeAchat.IDCommandeAchat
         HExécuteRequête(RequeteCommandeAchatEtat)
         iDestination(iPDFGénérique,IDFilePDF)
         iImprimeEtat(EcommandeAchat)
         SI HLitRecherche(CommandeAchatDessin,IDCommandeAchatMaster,[CommandeAchat.IDCommandeAchat,Vrai]) ALORS
         	CommandeAchatDessin.IDCommandeAchat = CommandeAchat.IDCommandeAchat
         	HAttacheMémo(CommandeAchatDessin,Dessin,IDFilePDF,hMémoImg)
         	Hmodifie(CommandeAchatDessin,hNumEnrEnCours)
         	
         SINON
         	HRAZ(CommandeAchatDessin)
         	CommandeAchatDessin.IDCommandeAchat = CommandeAchat.IDCommandeAchat
         		CommandeAchatDessin.FileDescription = "Commande principale"
         	HAttacheMémo(CommandeAchatDessin,Dessin,IDFilePDF,hMémoImg)
         	CommandeAchatDessin.Master = Vrai
         	HAjoute(CommandeAchatDessin)
         	
         FIN
         
         
         GrpSauve..etat = grise
         fiche_det..etat = grise
         fiche..etat = actif
         entete..etat = inactif
         tableaffiche(Table_CommandeAchat,taCourantPremier)
         executetraitement(Table_CommandeAchat,trtSélection)
         si NoCommande = 0 alors 
         	mafenetre..plan = 1
         sinon
         	ferme(mafenetre)	
         FIN
        type : 18
      -
        type : 161
        enabled : false
  -
    name : Btn_Annule
    identifier : 0x463555ad7b4a231b
    internal_properties : 
    properties :
     x : 164
     y : 12
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         	si acso_message("Question","Voulez annuler les modifications en cours ? ","OuiNon") = idyes alors
                trxencours = faux
                fiche..etat = actif
                grpsauve..etat = grise
                FICHE_DET..Etat = Grisé 
                entete..etat = grise
                Detail..etat = grise
                executetraitement(Table_CommandeAchat,trtSélection)
         	FIN
         
         
         
         
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_MODIFIE
    identifier : 0x463555ad51e7232b
    internal_properties : 
    properties :
     x : 268
     y : 12
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         si commandeachat.CaEtat = 2 alors renvoyer vrai
         fCommandeAchat..plan = 2
         //csnnocommande = config.numcf
         entete..etat = actif
         fiche..etat = grise
         grpsauve..etat = actif
         FICHE_DET..etat = actif
         trxencours = vrai
         lajout = faux
         lmodif = vrai
         lNoEnr est un entier = hsauveposition(TCommandeAchatDetail)
         si hlitdernier(TCommandeAchatDetail,IDCommandeAchatcNoLigne) alors
         	lnoligne = TCommandeAchatDetail.cNoLigne+1
         sinon
         	lnoligne = 1	
         FIN
         HRetourPosition(lNoEnr)
         reprisesaisie(csddate)
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_DETRUIRE
    identifier : 0x463555ad0a83232b
    internal_properties : 
    properties :
     x : 338
     y : 12
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         si acso_message("Question","Voulez-vous supprimer cette commande d'achat ?","OuiNon") = idyes alors
         	hsupprime(CommandeAchat,hNumEnrEnCours)
         	tableaffiche(Table_CommandeAchat,taCourantPremier)
         FIN
        type : 18
      -
        type : 161
        enabled : false
