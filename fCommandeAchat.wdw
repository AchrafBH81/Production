 menu :
  name : _Menu
  identifier : 0x4635504f6fe52eaa
  internal_properties : 
  options : []
 languages :
  - fr-FR
 popup_menus : []
 message_bar :
  internal_properties : CQAAAAkAAADkzCKBEbYktV4/czldI2dJ1kIeVzJam6/NrlwKzP00JDPEy7THaxkHjLJYguV2Rxb+VTfURntvvAMoL7ReOANuynxfa2MW7ZWv3gWZvaeSuXith1XCOFhtdBe4Iw==
 actionbar : {}
 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1+
      procedure fcommandeachat(NoCommande est un entier = 0,NoClient est une chaine = "")
      id est un entier = fouvre("logFile.txt",foCréation)
      fEcritLigne(id,"Ouverture de la fenetre fcommandeachat")
      moimeme..plan = 1
      modeaffichage est une chaine
      trxEnCours est un booleen = faux
      lNoLigne est un entier
      lajout est un booleen 
      lmodif est un booleen
      ldajout est un booleen
      ldmodif est un booleen
      lproduitmanuel est un booleen
      gnTempoversion est une entier
      
      //param est un tableau associatif de chaines
      //param["Numéro de commande"] = "<Nocommande>"
      //param["Numéro de TAG"] = "<NoTAG>"
      //param["Préparé par"] = "<Préparé par>"
      //param["Compagnie"] = "<Compagnie>"
      
      reqsql est une source de données
      txtsql est une chaine = [
      	select * from commandeachat where canocommande = %1
      ]
      fecritligne(id,"Avant la vérification de l'existence de commandes")
      si NoCommande <> 0 alors
      	si HExécuteRequêteSQL(Reqsql,hRequêteDéfaut,ChaîneConstruit(TxtSql,NoCommande)) alors
      		si hnbenr(Reqsql) <> 0 alors 
      			si ouinon("Une ou plusieurs commandes fousnisseurs existent pour la commande client #"+NoCommande,"Voulez-vous continuer ?") = non alors
      				ferme(fcommandeachat)
      			FIN
      		FIN
      	FIN
      fin
      fEcritLigne(id,"Avant l'ajout d'image dans les combo de table")
      ChargePlancheImage(1,FichierImage,16,16)
      ListeAjoute("tEtat",gImage(1,7))
      ListeAjoute("tEtat",gImage(1,6))
      fEcritLigne(id,"Avant la création du fichier tcommandeachatdetail")
      
      HCréationSiInexistant(TCommandeAchatDetail)
      fEcritLigne(id,"Après la création du fichier tcommandeachatdetail")
      SI PAS HSupprimeTout(TCommandeAchatDetail) ALORS
      	erreur(HErreurInfo(hErrComplet))
      FIN
      fEcritLigne(id,"Après la suppression du contenu de  tcommandeachatdetail")
      
      ThermosFermeExterieur est un booleen = faux
      ThermosOuVerre est une chaine = ""
      fferme(id)
      fsupprime("logFile.txt",frVersCorbeille)
   -
     code : |1+
      
      sDescription est une chaine
      sCarrelage est une chaine
      bWithShape est un booleen = Faux
      
      //ExécuteTraitement(csCommande,trtModification)
      si nocommande <> 0 alors
      //	SI PAS HSupprimeTout(TCommandeAchatDetail) ALORS
      //		erreur(HErreurInfo(hErrComplet))
      //	FIN	
      	response est une chaine =  Ouvre(SelectFournisseur)
      	si response = "" alors 
      		info("Le choix du fournisseur est incorrect")
      		ferme(fcommandeachat)
      	FIN
      	csnnoFournisseur = complete(ExtraitChaîne(response,1,";"),4)
      	cstNomFournisseur = ExtraitChaîne(response,2,";")
      	sainote = ""
      //	info(TableCommandeDetail..Occurrence)
      
      	productList est un variant = ouvre(SelectThermosVerre,nocommande)
      //	Info(TableCommandeDetail..Occurrence)
      
      	
      //	HCréation(TCommandeAchatDetail)
      
      
      	si productList..Occurrence > 0  ALORS
      		SI PAS HSupprimeTout(TCommandeAchatDetail) ALORS
      			Erreur(HErreurInfo(hErrComplet))
      		FIN
      		hraz(TCommandeAchatDetail)
      		POUR CHAQUE product de productList
      //			sDescription = SansEspace(ExtraitChaîne(ExtraitChaîne(product,1,";"),1,RC))
      			sDescription = SansEspace(ExtraitChaîne(product,1,";"))
      			
      			sCarrelage = sansespace(extraitchaine(product,7,";"))
      			lnoligne = lnoligne +1 
      			TCommandeAchatDetail.cNoLigne = lnoligne
      			TCommandeAchatDetail.cadQte = ExtraitChaîne(product,5,";")
      			TCommandeAchatDetail.cadNoProduit = ExtraitChaîne(product,4,";")
      			TCommandeAchatDetail.cadDescription = sDescription+RC+(sansespace(ExtraitChaîne(product,6,";")) <> "" ? ExtraitChaîne(product,6,";")+rc sinon "" )+ExtraitChaîne(product,3,";")+" X "+ExtraitChaîne(product,2,";") 
      //			TCommandeAchatDetail.CaFermeExterieur = ExtraitChaîne(product,8,";") = "T" ? 1 sinon 0
      			si sCarrelage <> "" alors TCommandeAchatDetail.cadDescription+= rc+sCarrelage
      			TCommandeAchatDetail.QtyEDIRV =  ExtraitChaîne(product,5,";")
      			TCommandeAchatDetail.ThermosWidthEDIRV =  ExtraitChaîne(product,3,";")
      			TCommandeAchatDetail.ThermosHeightEDIRV =  ExtraitChaîne(product,2,";")
      			TCommandeAchatDetail.ThermosCodeEDIRV =  ExtraitChaîne(product,4,";")
      			TCommandeAchatDetail.ThermosFinishEDIRV =  ExtraitChaîne(product,14,";")
      			TCommandeAchatDetail.ThermosSpacerEDIRV =  ExtraitChaîne(product,16,";")
      			TCommandeAchatDetail.GrillWidthEDIRV  =  ExtraitChaîne(product,10,";")
      			TCommandeAchatDetail.GrillheightEDIRV  =  ExtraitChaîne(product,9,";")
      			TCommandeAchatDetail.GrillPaintEDIRV  = sansespace(ExtraitChaîne(product,11,";"))+"/"+SansEspace(ExtraitChaîne(product,12,";"))
      			si TCommandeAchatDetail.GrillPaintEDIRV = "/" alors TCommandeAchatDetail.GrillPaintEDIRV = ""
      			TCommandeAchatDetail.GrillTypeEDIRV   = SansEspace(ExtraitChaîne(product,13,";"))
      			TCommandeAchatDetail.GridDescriptionEDIRV = SansEspace(ExtraitChaîne(product,15,";"))
      			TCommandeAchatDetail.GrillDTH = SansEspace(ExtraitChaîne(product,17,";"))
      			TCommandeAchatDetail.NoteEDIRV = Remplace(SansEspace(ExtraitChaîne(product,18,";")),RC," ")
      			TCommandeAchatDetail.BarrotinEDIRV = Remplace(SansEspace(ExtraitChaîne(product,19,";")),RC," ")
      			TCommandeAchatDetail.WithShape = ExtraitChaîne(product,20,";")
      			bWithShape = TCommandeAchatDetail.WithShape
      			hajoute(TCommandeAchatDetail)
      			//		tableajouteligne(TableCommandeDetail,extraitchaine(product,5,";"),ExtraitChaîne(product,4,";"),ExtraitChaîne(product,1,";")+rc+ExtraitChaîne(product,3,";")+" X "+ExtraitChaîne(product,2,";") )
      			
      		FIN
      		tableaffiche(TableCommandeDetail)
      	FIN
      	//si bWithShape alors sainote = "Voir dessin"
      	mafenetre..plan = 2
      	Entete..Etat = Actif
      	FICHE..Etat = Grisé
      	GrpSauve..Etat = Actif
      	FICHE_DET..etat = actif
      	trxEnCours = Vrai
      	lNoLigne = 1
      	lajout = Vrai
      	lmodif = Faux
      	csnNoCommande = ""
      	csddate1 = ""
      	csddate = DateSys()
      	
      	RepriseSaisie(csddate)
      	
      fin
     type : 34
