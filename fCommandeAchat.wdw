  -
    name : BtnPdf
    identifier : 0x22d1854b98a89f88
    internal_properties : 
    properties :
     x : 457
     y : 12
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         lsujet est une chaine
         lmessage est une chaine
         lDestinataire est une chaîne
         IdFileEDI est une chaîne
         
         si hlitrecherche(fournisseur,Fnumero,commandeachat.CaFournisseur) alors
         	
         FIN
         SI fournisseur.fLangue = 1 ALORS
         	//	lsujet = SansEspace(config.SujetFrancais[4])+" "+CommandeAchat.CaNumero
         	lsujet = remplaceparam(config.SujetFrancais[4],commandeachat.canumero,commandeachat.CaNote,commandeachat.CaPreparePar,"Thermos Rive-Nord")
         	//	lmessage = config.TexteFrancais[4]
         	lmessage = RemplaceParam(config.texteFrancais[4],CommandeAchat.CaNumero,CommandeAchat.CaNote,CommandeAchat.CaPreparePar,"Thermos Rive-Nord")
         SINON
         	//	lsujet = SansEspace(config.SujetAnglais[4])+" "+CommandeAchat.CaNumero
         	//	lmessage = config.TexteAnglais[4]
         	lsujet = RemplaceParam(config.SujetAnglais[4],CommandeAchat.CaNumero,CommandeAchat.CaNote,CommandeAchat.CaPreparePar,"Thermos Rive-Nord")
         	lmessage = RemplaceParam(config.TexteAnglais[4],CommandeAchat.CaNumero,CommandeAchat.CaNote,CommandeAchat.CaPreparePar,"Thermos Rive-Nord")
         FIN	
         
         SI SansEspace(Fournisseur.Femail) <> "" ALORS lDestinataire+= Fournisseur.Femail + ";"
         SI SansEspace(Fournisseur.Femail2) <> "" ALORS lDestinataire+= Fournisseur.Femail2 + ";"
         SI SansEspace(Fournisseur.Femail3) <> "" ALORS lDestinataire+= Fournisseur.Femail3 + ";"
         SI SansEspace(Fournisseur.Femail4) <> "" ALORS lDestinataire+= Fournisseur.Femail4 + ";"
         
         
         
         idestination(iPDFGénérique,completerep(repdonnees)+"PDF\"+Fournisseur.Fnumero+"\Achat\"+CommandeAchat.CaNumero+".pdf")
         RequeteCommandeAchatEtat.pIdCommandeAchat = CommandeAchat.IDCommandeAchat
         
         
         hexecuterequete(RequeteCommandeAchatEtat)
         //si Fournisseur.fIsEDI = 1 alors
         //	 IdFileEDI = prepareEdirobover()
         //	 si Fournisseur.fEdiSendBy = 2 alors SendEdiRobover(IdFileEDI,"EDI"+CommandeAchat.CaNumero+".edi")
         //FIN
         iImprimeEtat(EcommandeAchat)
         si sansespace(Fournisseur.Femail) <> "" alors
         	Ouvre(FenEmail,lDestinataire,lsujet,lmessage,ComplèteRep(repdonnees)+"PDF\"+Fournisseur.Fnumero+"\Achat\"+CommandeAchat.CaNumero+".pdf"+";",Fournisseur.Fnumero,Faux,6,Vrai,"F")
         	TableAffiche(Table_CommandeAchat,taCourantEnreg)
         fin
         
         
        type : 18
      -
        type : 161
        enabled : false
