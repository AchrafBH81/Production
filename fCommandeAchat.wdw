      -
        code : |1-
         fichierversecran(fCommandeAchat,CommandeAchat)
         SendType est un entier = gettype(CommandeAchat.CaFournisseur)
         SELON SendType
         	CAS 1
         		BtnPdf..Visible = Faux
         		BtnFTP..Visible = Faux
         	CAS 2
         		BtnPdf..Visible = Faux
         		Btnftp..visible = vrai
         	CAS 3
         		BtnPdf..Visible = Vrai
         		BtnFTP..Visible = faux
         	AUTRE CAS
         		
         FIN
         
         
         
         
         
         
         csnNoCommande = CommandeAchat.CaNumero
         RemplirTableDetail()
