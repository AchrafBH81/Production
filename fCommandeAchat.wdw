      SendType est un entier = 1
      si hlitrecherche(Fournisseur,Fnumero,NoFournisseur) alors
      	SendType = Fournisseur.fEdiSendBy
      fin
      
      renvoyer SendType
      
     type : 458752
   -
     name : SendEdiRobover
     internal_properties : CQAAAAkAAAAETzEdwRNMKZCPH5biRPuGIhjJRSEy3U5JTZLOlnghFVmFZRAIgAj/DndRQNodyJtsm+0/ZceFTWe1eMnQaGiLmgPfLUoNfKg7ZDSdjQfgE4hHDRZHlxXQX2O7phicXMgmI90vZoTwQshKoz41fdqz8xIKS6ylpZC1pX+bK8EWsw4U
     procedure_id : 1193097582210727060
     type_code : 14
     code : |1-
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] SendEdiRobover (<sIdFileEDI> est chaîne, <sFilenameEDI> est chaîne, <IdFilePDF> est chaîne, <sFilenamePDF> est chaîne, <TabFileName> est tableau (chaîne))
      //
      // Paramètres :
      //	sIdFileEDI (chaîne ANSI) : <indiquez ici le rôle de IdFileEDI>
      //	sFilenameEDI (chaîne ANSI) : <indiquez ici le rôle de Filename>
      //	IdFilePDF (chaîne ANSI) : <indiquez ici le rôle de IdFilePDF>
      //	sFilenamePDF (chaîne ANSI) : <indiquez ici le rôle de FilenamePDF>
      //	TabFileName (tableau (chaîne ANSI)) : <indiquez ici le rôle de TabFileName>
      
      // Valeur de retour :
      // 	booléen : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //// Traitement automatique des exceptions :   exécuter le bloc de code CAS EXCEPTION:
      //
      
      PROCEDURE SendEdiRobover(sIdFileEDI est une chaine,sFilenameEDI est une chaine,IdFilePDF est une chaine,sFilenamePDF est une chaine,TabFileName est un tableau de chaines)
      sablier()
      FTPAddress est une chaine = Fournisseur.fEdiFtpAddress
      FTPUsername est une chaine = fournisseur.fEdiFtpUser
      FTPPAssword est une chaine = Fournisseur.fEdiFtpPassword
      IdConnexion est un entier
      
      si EnModeTest() alors
      	FTPAddress		= 	 "ftp://192.168.1.47"
      	FTPUsername		= 	 "trn"
      	FTPPAssword		= 	 "trn"
      	
      FIN
      IdConnexion = ftpconnecte(FTPAddress,FTPUsername,FTPPAssword) 
      si IdConnexion <> -1 alors
      	POUR CHAQUE filenametmp de TabFileName
      		si FTPEnvoie(IdConnexion,filenametmp,fExtraitChemin(filenametmp,fFichier+fExtension)) alors
      			fsupprime(filenametmp)
      			
      		FIN
      
      	FIN
      
      
      	
      FIN
      
      FTPDéconnecte(IdConnexion)
      
      Sauveftp(fournisseur.Fnumero,Fournisseur.fEdiFtpAddress,IdFilePDF)
      sablier(faux)
      renvoyer Vrai
      
      CAS EXCEPTION:
      	sablier(faux)
      	renvoyer faux
      	
     type : 458752
   -
     name : SauveFTP
     procedure_id : 1194354212383658713
     type_code : 14
     code : |1+
      Procédure SauveFTP(sNoFournisseur est une chaîne,sFtpAddress est une chaîne,sFilename est une chaine)
      lsujet est une chaine
      hraz(ArchiveEmail)
      ArchiveEmail.dateEmail = DateHeureSys()
      ArchiveEmail.noClient = complete(sNoFournisseur,10)
      ArchiveEmail.lDestinataire = sansespace(sFtpAddress)
      si pas lmodif
      	ArchiveEmail.lFichierAttaché = sFilename//SansEspace(SAIS_FICAT)
      fin
      //ArchiveEmail.ltexte = SansEspace(SAIS_MESSAGE)
      SI Fournisseur.Flangue = 1 ALORS
      	lsujet = RemplaceParam(config.SujetFrancais[4],CommandeAchat.CaNumero,CommandeAchat.CaNote,CommandeAchat.CaPreparePar,"Thermos Rive-Nord")
      SINON
      	lsujet = RemplaceParam(config.SujetAnglais[4],CommandeAchat.CaNumero,CommandeAchat.CaNote,CommandeAchat.CaPreparePar,"Thermos Rive-Nord")
      FIN	
      ArchiveEmail.lSujet = lsujet
      ArchiveEmail.lTypeDocument = 6
      ArchiveEmail.ItypeEnvoi = 1
      //si lmodif alors
      //	hmodifie(ArchiveEmail,hNumEnrEnCours)
      //sinon
      	hajoute(ArchiveEmail)		
      //FIN
      
     type : 458752
   -
     name : GetNextOrderNumber
     procedure_id : 1211982390301662360
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] GetNextOrderNumber ()
      //
      // Paramètres :
      //	Aucun
      // Valeur de retour :
      // 	entier : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE GetNextOrderNumber()
      
      nextNumber est un entier
      recNumber est un entier = HSauvePosition(CommandeAchat)
      hlitdernier(CommandeAchat,CaNumero)
      nextNumber = CommandeAchat.CaNumero+1
      HRetourPosition(recNumber)
      renvoyer nextNumber
     type : 458752
