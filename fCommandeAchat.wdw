     name : CheckIfExterne
     procedure_id : 2155008263505617645
     type_code : 14
     code : |1-
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] CheckIfExterne (<NoProduit> est chaîne)
      //
      // Paramètres :
      //	NoProduit (chaîne ANSI) : <indiquez ici le rôle de NoProduit>
      // Valeur de retour :
      // 	booléen : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE CheckIfExterne(NoProduit est une chaine)
      
      //SI NoCommande <> 0 _ET_ HLitRecherche(persoens,ennumero,CommandeAchatDetail.cadNoProduit) ALORS
      	SI sansespace(NoProduit) <> "" _et_ NoCommande <> 0 _ET_ HLitRecherche(persoens,ennumero,NoProduit) ALORS
      		CommandeAchat.CaFermeExterieur = Vrai
      	HModifie(CommandeAchat,hNumEnrEnCours)
      	renvoyer vrai
      FIN
      renvoyer faux
