    name : dProduitFRN
    identifier : 0x46827ec365d32145
    internal_properties : 
    properties :
     x : 943
     y : 298
     width : 100
     height : 24
    type : 2
    code_elements :
     type_code : 3
     p_codes :
      -
        code : |1+
         si pas moimeme = "" alors
         	si hlitrecherche(invent,INUM,moimeme) alors
         		selon Fournisseur.Flangue
         			cas 1
         				dDescProduit = invent.idesc
         			cas 2
         				dDescProduit = invent.idesca
         		FIN
         
         		selon invent.itype
         			cas 1
         				dcout = invent.icoutanta
         			cas 2
         				dcout = invent.icoutUnite
         			cas 4
         				dcout = invent.ICoutantcarrelage
         			cas 3
         				dcout = invent.icoutUnite
         		FIN
         		ExécuteTraitement(DCOUT,trtSortie)
         	sinon
         		acso_message("Erreur","Ce produit est inexistant dans le fichier","Erreur")
         		moimeme = ""
         		reprisesaisie()	
         	FIN
         FIN
         
