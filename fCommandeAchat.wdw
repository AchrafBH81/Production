      -
        code : |1+
         _etat est un booleen = vrai
         _tableauEtat est un tableau de chaine = ["En attente","Réception partielle","Complétée","Annuler"]
         Response est un entier = 0 
         //si ouinon("Voulez vous changer l'état de cette commande ?" + commandeachat.CaNumero) alors
         Saisie.LibelléOptionnel = "Choisissez le nouvel état de la commande #" + Table_CommandeAchat.tCaNumero 
         Response = Saisie("", _etat , _tableauEtat )-1
         si Response < 3 alors
         	si hlitrecherche(CommandeAchat,CaNumero,Table_CommandeAchat.tCaNumero) alors
         	     commandeachat.CaEtat = Response
         	     hmodifie(CommandeAchat,hNumEnrEnCours)
         	fin
