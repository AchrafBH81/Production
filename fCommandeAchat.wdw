     x : 801
     y : 454
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         si minuscule(champencours()) <> "dqte" alors
         
         	si ldajout alors
         		dqte = 0
         		dproduit=""
         		dDescProduit = ""
         		dcout = 0
         		dtotal=0
         		dProduitFRN = ""
         		dDescProduitFRN = ""
         		lproduitmanuel = faux
         	fin
         	reprisesaisie(dqte)
         sinon
         	si ACSO_message("Question","Terminer l'édition de cette commande","OuiNon") = idyes alors
         		detail..etat = grise
         		FICHE_DET..etat = actif
         		GrpSauve..etat = actif
         		TableCommandeDetail..etat = AffichageSeulement
         		tableaffiche(TableCommandeDetail,taCourantPremier)
         		ExécuteTraitement(TableCommandeDetail,trtSélection)
         		grpsauve..etat = actif
         
         	FIN
         
         fin
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_AJOUT_DET
    identifier : 0x46373fc50f609187
    internal_properties : 
    properties :
     x : 839
     y : 180
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         Reqsqltmp est une source de donnees
         
         	si HExécuteRequêteSQL(Reqsqltmp,hRequêteDéfaut,"select * from TCommandeAchatDetail where cadraye = 0") alors
         		si hnbenr(Reqsqltmp) = 0 alors
         			ThermosFermeExterieur = ouvre(FenChoixThermosVerre)  = "T" ? vrai sinon faux
         			
         		FIN
         	sinon
         		ThermosFermeExterieur = Ouvre(FenChoixThermosVerre) = "T" ? Vrai SINON Faux
         	FIN
         
         fiche_det..etat = grise
         detail..etat = actif
         GrpSauve..etat = grise
         Btn_Annule..etat = grise
         TableCommandeDetail..etat = AffichageSansSélection
         ldajout = vrai
         ldmodif = faux
         dqte = 0
         dcout = 0
         dtotal = 0
         dproduit = ""
         dDescProduit = ""
         dProduitFRN = ""
