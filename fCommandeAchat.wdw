      //
      PROCEDURE GetNextLine()
      txtsql  = "select max(cnoligne) as lastline from TCommandeAchatDetail"
      si HExécuteRequêteSQL(reqsql,hRequêteDéfaut,txtsql) ALORS
      	renvoyer reqsql.lastline+1
      	
      sinon
      	info(HErreurInfo())
      FIN
      
      renvoyer 0
      
