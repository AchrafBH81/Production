     name : RemplirTcommandeDetail
     procedure_id : 5059970800630165508
     type_code : 14
     code : |1+
      Procédure RemplirTcommandeDetail()
      //HCréation(TCommandeAchatDetail)
      si pas hsupprimetout(TCommandeAchatDetail) alors
      	info(herreurinfo(hErrMessage))
      FIN
      RequeteCommandeAchat.pidCommande = commandeachat.IDCommandeAchat
      
      HExécuteRequête(RequeteCommandeAchat,hRequêteDéfaut)
      pour tout RequeteCommandeAchat
      	HCopieEnreg(tCommandeAchatDetail,RequeteCommandeAchat)
      	TCommandeAchatDetail.IdCommandeoriginale = RequeteCommandeAchat.IDCommandeAchatDetail
      	TCommandeAchatDetail.cadRaye = faux
      	hajoute(TCommandeAchatDetail)
      FIN
      
      Gntempoversion= hversion(TCommandeAchatDetail)
      
     type : 458752
   -
     name : prepareEdiRobover
     procedure_id : 1182703563772168206
     type_code : 14
     code : |1-
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] prepareEdiRobover ()
      //
      // Paramètres :
      //	Aucun
      // Valeur de retour :
      // 	multi-valeur : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE prepareEdiRobover()
      cpt				est un entier
      bExceptionorder	est un booleen	= False
      
      idFichier		est un entier	= fouvre(fRépertoireTemp()+"EDI"+RequeteCommandeAchatEtat.CaNumero+".edi",foCréation)
      ItemNumber		est une chaine
      ThermosNote		est une chaine
      NoteContour		est une chaîne
      
      BarrotinCouleur	est une chaine	= RequeteCommandeAchatEtat.BarrotinEDIRV <> "" ? RequeteCommandeAchatEtat.GrillPaintEDIRV sinon ""
      pour TOUT RequeteCommandeAchatEtat 
      	cpt++
      	si cpt = 1 alors
      		fEcritLigne(idFichier,"E|"+RequeteCommandeAchatEtat.CaNumero+"|"+RequeteCommandeAchatEtat.CaDate+"|"+RequeteCommandeAchatEtat.CaDateprevu+"|"...
      		+RequeteCommandeAchatEtat.CaPreparePar+"|"+RequeteCommandeAchatEtat.CaThermosVerre+"||")
      	FIN
      	NoteContour	= ""
      	//	SI RequeteCommandeAchatEtat.GrillTypeEDIRV = "Contour" ALORS NoteContour = SansEspace(RequeteCommandeAchatEtat.NoteEDIRV)
      
      	NoteContour	 = SansEspace(RequeteCommandeAchatEtat.NoteEDIRV)
      	si RequeteCommandeAchatEtat.WithShape alors
      		si NoteContour = "" alors 
      			NoteContour = "Voir dessin/Commande PDF"
      		FIN
      		bExceptionorder = vrai
      		
      	FIN
      	si RequeteCommandeAchatEtat.ThermosCodeEDIRV = "" alors
      		SI NoteContour = "" ALORS 
      			NoteContour = "Voir commande PDF"
      		FIN
      		bExceptionorder = vrai
      	FIN
      	//	si RequeteCommandeAchatEtat.caCommentaire <> "" ou Notecontour <> ""  alors
      	//		bExceptionorder = vrai
      	//	FIN
      	
      	ItemNumber			= remplace(sansespace(ExtraitChaîne(RequeteCommandeAchatEtat.CaNote,1,RC)),"Tag#","TRN ")
      	ThermosNote			= sansespace(RequeteCommandeAchatEtat.CaNote[[taille(ItemNumber) A ]])
      	BarrotinCouleur		= RequeteCommandeAchatEtat.BarrotinEDIRV <> "" ? RequeteCommandeAchatEtat.GrillPaintEDIRV sinon ""
      	fecritligne(idFichier,"D|||"+ItemNumber+"|"+RequeteCommandeAchatEtat.cadQteToOrder+"|"+RequeteCommandeAchatEtat.ThermosWidthEDIRV+"|"+RequeteCommandeAchatEtat.ThermosHeightEDIRV...))
      	+"|"+RequeteCommandeAchatEtat.ThermosFinishEDIRV+"|"+RequeteCommandeAchatEtat.ThermosCodeEDIRV+"|"+RequeteCommandeAchatEtat.ThermosSpacerEDIRV...
      	+"|"+RequeteCommandeAchatEtat.GridDescriptionEDIRV+"|"+RequeteCommandeAchatEtat.GrillWidthEDIRV+"|"+RequeteCommandeAchatEtat.GrillHeightEDIRV...
      	+"|"+RequeteCommandeAchatEtat.GrillPaintEDIRV+"||"+RequeteCommandeAchatEtat.GrillTypeEDIRV+"|"+RequeteCommandeAchatEtat.GrillDTH...
      	+"|"+sansespace(RequeteCommandeAchatEtat.BarrotinEDIRV)+"|"+BarrotinCouleur+"||"+NoteContour+"|"+remplace(RequeteCommandeAchatetat.cacommentaire,rc," ")+"|")
      FIN
      
      fferme(idFichier)
      renvoyer (fRépertoireTemp()+"EDI"+RequeteCommandeAchatEtat.CaNumero+".edi",bExceptionorder)
     type : 458752
   -
     name : gettype
     procedure_id : 1191399339294904664
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] gettype (<NoFournisseur> est chaîne)
      //
      // Paramètres :
