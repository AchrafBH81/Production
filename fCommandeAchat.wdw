   -
     name : RemplaceParam
     procedure_id : 2057701664543778517
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] RemplaceParam (<ChaineAremplacer>, <_NoCommande>, <_NoTag>, <_Preparepar>, <_Compagnie>)
      //
      // Paramètres :
      //	ChaineAremplacer : <indiquez ici le rôle de ChaineAremplacer>
      //	_NoCommande : <indiquez ici le rôle de NoCommande>
      //	_NoTag : <indiquez ici le rôle de NoTag>
      //	_Preparepar : <indiquez ici le rôle de Preparepar>
      //	_Compagnie : <indiquez ici le rôle de Compagnie>
      // Valeur de retour :
      // 	Type indéterminé : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE RemplaceParam(ChaineAremplacer,_NoCommande,_NoTag,_Preparepar,_Compagnie)
      
      ChaineAremplacer = Remplace(ChaineAremplacer,"<NoCommande>",_NoCommande)
      ChaineAremplacer = Remplace(ChaineAremplacer,"<NoTag>",extraitchaine(_NoTag,1,rc))
      ChaineAremplacer = Remplace(ChaineAremplacer,"<Préparé par>",_Preparepar)
      //ChaineAremplacer = Remplace(ChaineAremplacer,"<Compagnie>",_Compagnie)
      
      renvoyer ChaineAremplacer
      
      
      
     type : 458752
   -
     name : valideCommande
     procedure_id : 2061125900231122876
     type_code : 14
     code : |1-
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] valideCommande ()
      //
      // Paramètres :
      //	Aucun
      // Valeur de retour :
      // 	booléen : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE valideCommande()
      
      si fcommandeachat.csddate1 = "" alors
      	info("La date prévue ne doit pas être vide")
      	reprisesaisie(csddate1)
      FIN
      
      SI fCommandeAchat.csnnoFournisseur = "" ALORS
      	Info("La numéro de fournisseur ne doit pas être vide")
      	RepriseSaisie(csnnoFournisseur)
      FIN
      
      si TableCommandeDetail..vide alors
      	Info("Aucun item sur la commande")
      	RepriseSaisie(BTN_AJOUT_DET)
      FIN
      renvoyer vrai
     type : 458752
   -
     name : VerifieSiToutRecu
     procedure_id : 2061890176974624599
     type_code : 14
     code : |1-
      Procédure VerifieSiToutRecu(nIdCommandeAchat est un entier =0)
      lToutRecu est un entier = 0
      ltotalcommande est un entier = 0
      ltotalrecu est un entier = 0
      
      hlitrecherche(CommandeAchatDetail,IDCommandeAchat,nIdCommandeAchat)
      tantque pas hendehors(CommandeAchatDetail) et CommandeAchatDetail.IDCommandeAchat = commandeachat.IdCommandeAchat
      	
      	ltotalcommande += CommandeAchatDetail.cadQte
      	ltotalrecu += CommandeAchatDetail.cadQteRecue
      	
      
      
      	hlitsuivant(CommandeAchatDetail,IDCommandeAchat)
      FIN
      
      SI ltotalrecu = 0 ALORS
      	lToutRecu = 0
      SINON SI ltotalcommande > ltotalrecu ALORS
      	lToutRecu = 1
      SINON
      	lToutRecu = 2		
      FIN
      
      renvoyer lToutRecu
     type : 458752
