 controls : []
 code_elements :
  type_code : 13
  p_codes :
   -
     code : |1+
      procedure bonlivraisontrn(_NbCopies = 1,param2="",param3="",param4="")
      tableaucarrelage est un tableau dynamique
      tableaucarrelage = allouer un tableau de 0 par 5 chaine
      dimensiontableaucarrelage est un entier = 0
      calculligne est un entier = 0
      AncienNumCommande est un entier = 99999999
      AncienNumCarrelage est une chaine = ""
      ldebut est un booleen = vrai
      lnombrethermos est un entier
      ltypeligne est une chaine
      
      //hlit(config,1)
      
      iNumPage(1)
     type : 327680
  procedures :
   -
     name : Rupturefdcomm
     procedure_id : 5139408617443472711
     type_code : 14
     code : |1+
      Procédure Rupturefdcomm()
      
      iimprime("salut")
      
     type : 458752
   -
     name : assigneLibelle
     procedure_id : 5139408616696558919
     type_code : 14
     code : |1+
      Procédure assigneLibelle()
      i est un entier
      
      lTableauLibelle est un tableau de  30 chaines
      lTableauLibelle[1]  = "blentete"
      lTableauLibelle[2]  = "facpage"
      lTableauLibelle[3]  = "facpagede"
      lTableauLibelle[4]  = "blnobonlivraison"
      lTableauLibelle[5]  = "facdate"
      lTableauLibelle[6]  = "facnumcommande"
      lTableauLibelle[7]  = "facjobdetail"
      lTableauLibelle[8]  = "facquantite"
      lTableauLibelle[9]  = "faclargeur"
      lTableauLibelle[10] = "fachauteur"
      lTableauLibelle[11] = "facdescription"
      lTableauLibelle[12] = "facfini"
      lTableauLibelle[13] = "facspacer"
      lTableauLibelle[14] = "faccarrelage"
      lTableauLibelle[15] = "facrecupar"
      lTableauLibelle[16] = "facnumlot"
      lTableauLibelle[17] = "vendua"
      lTableauLibelle[18] = "livrea"
      lTableauLibelle[19] = "votrecommande"
      lTableauLibelle[20] = "notrereference"
      lTableauLibelle[21] = "NbThermos"
      lTableauLibelle[22] = "NbGrill"
      lTableauLibelle[23] = "votrereference" 
      
      
      
      selon client.CLangue
      	cas 0,1
      		pour i = 1 a 30
      			si hlitrecherche(Traduction,TRecherche,lTableauLibelle[i]) alors
      				{"bonlivraisontrn."+lTableauLibelle[i]} = traduction.dFrancais
      			fin
      		FIN
      
      	cas 2
      		pour i = 1 a 30
      			si hlitrecherche(Traduction,TRecherche,lTableauLibelle[i]) alors
      				{"bonlivraisontrn."+lTableauLibelle[i]} = traduction.danglais
      			fin
      		FIN
      fin
      
      bonlivraisontrn.Facnumlot1 = bonlivraisontrn.facnumlot
      bonlivraisontrn.Facnumcommande1 = bonlivraisontrn.facnumcommande
      bonlivraisontrn.Facjobdetail1 = bonlivraisontrn.Facjobdetail
      bonlivraisontrn.Facquantite1 = bonlivraisontrn.Facquantite
      bonlivraisontrn.Faclargeur1 = bonlivraisontrn.faclargeur
      bonlivraisontrn.Fachauteur1 = bonlivraisontrn.fachauteur
      bonlivraisontrn.Facdescription1 = bonlivraisontrn.Facdescription
      bonlivraisontrn.Facfini1 = bonlivraisontrn.facfini
      bonlivraisontrn.Facspacer1 = bonlivraisontrn.facspacer
      bonlivraisontrn.Faccarrelage1 = bonlivraisontrn.Faccarrelage
      //bonlivraisontrn.Facnorack1 = bonlivraisontrn.Facnorack
      bonlivraisontrn.blentete1 = bonlivraisontrn.blentete
      //bonlivraisontrn.Facpage1 = bonlivraisontrn.Facpage
      //bonlivraisontrn.Facpagede1 = bonlivraisontrn.Facpagede
      bonlivraisontrn.Blnobonlivraison1 = bonlivraisontrn.Blnobonlivraison
      bonlivraisontrn.Facdate1 = bonlivraisontrn.Facdate
      bonlivraisontrn.VotreCommande1 =BonLivraisonTRN.VotreCommande
      BonLivraisonTRN.NotreReference1 = BonLivraisonTRN.NotreReference
      BonLivraisonTRN.votreReference2 = BonLivraisonTRN.votreReference
     type : 458752
  procedure_templates : []
  property_templates : []
