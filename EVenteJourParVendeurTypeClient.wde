    properties :
     y : 84.24
     width : 269.4
     height : 4.444
    code_elements :
     type_code : 30
     p_codes :
      -
        code : |1+
         j est un entier
         indicecarr est un entier
         carrtrouve est un booleen = faux//A FAIRE :
         carrnogl est une chaine
         SI requetequotidienvendeurtypeclient.ftype = 1 ALORS
         	si  requetequotidienvendeurtypeclient.fdverreunite alors
         		lTypeLigne = "VerreUnite"
         	sinon	
         		lTypeLigne = "Verre"
         	FIN
         SINON SI requetequotidienvendeurtypeclient.ftype = 2 
         	SI PAS requetequotidienvendeurtypeclient.fdverreunite ALORS
         		lTypeLigne = "Unite"
         	SINON
         		lTypeLigne = "Verre"
         	FIN
         SINON SI requetequotidienvendeurtypeclient.ftype = 3
         	lTypeLigne = "Fourniture" 
         SINON SI requetequotidienvendeurtypeclient.ftype = 4
         	lTypeLigne = "Carrelage" 
         SINON SI requetequotidienvendeurtypeclient.ftype = 5
         	lTypeLigne = "Peinture" 
         FIN
         
         //si requetequotidienvendeurtypeclient.ftype = 4 alors
         //	corps..visible = faux
         //sinon
         
         
         SELON lTypeLigne
         	CAS "Unite"
         		//	CORPS..VISIBLE = VRAI
         		RUBRIQUE17 = requetequotidienvendeurtypeclient.fdprixu
         		RUBRIQUE16 = 1
         	//		rubrique16..visible = faux
         	CAS "Verre"	
         		//		corps..visible = vrai
         		//		rubrique16..visible = vrai
         		
         FIN
         
         
         
         
         
         //	si pas facturereimpression alors
         //		remplir_tableau(rubrique21,arrondi(rubrique4 * (rubrique16 * rubrique17),2))
         //	FIN
         
         //	totalpage +=  arrondi(requetequotidienvendeurtypeclient.fdqte * requetequotidienvendeurtypeclient.fdpiedcarrefacture * requetequotidienvendeurtypeclient.fdprixupiedfacture,2)
         //	totalfacture +=  arrondi(requetequotidienvendeurtypeclient.fdqte * requetequotidienvendeurtypeclient.fdpiedcarrefacture * requetequotidienvendeurtypeclient.fdprixupiedfacture,2)
         
         
         SELON lTypeLigne
         	CAS "VerreUnite"
         		//		FIN
         		//		si requetequotidienvendeurtypeclient.ftype = 2 et pas requetequotidienvendeurtypeclient.fdverreunite alors
         		totalpage +=  Arrondi(requetequotidienvendeurtypeclient.fdqteafacturer * requetequotidienvendeurtypeclient.fdprixu,2)
         		//		totalfacture +=  Arrondi(requetequotidienvendeurtypeclient.fdqteafacturer * requetequotidienvendeurtypeclient.fdprixu,2)
         		TotalUnite+=requetequotidienvendeurtypeclient.fdqteafacturer 
         		totalfacture +=  Arrondi(requetequotidienvendeurtypeclient.fdqteafacturer * (requetequotidienvendeurtypeclient.fdpiedcarrefacture * requetequotidienvendeurtypeclient.fdprixupiedfacture),2)+ ...
         		Arrondi(requetequotidienvendeurtypeclient.fdqteafacturer *requetequotidienvendeurtypeclient.fdextraforme,2)+Arrondi(requetequotidienvendeurtypeclient.fdqteafacturer *requetequotidienvendeurtypeclient.FDextra10X,2)+...
         		Arrondi(requetequotidienvendeurtypeclient.fdqteafacturer *requetequotidienvendeurtypeclient.FDextra5x,2)
         		
         		totalsurcharge += Arrondi(requetequotidienvendeurtypeclient.surchargeenergie,2) //* requetequotidienvendeurtypeclient.fdqteafacturer / requetequotidienvendeurtypeclient.fdqte
         		totalcap+= Arrondi(requetequotidienvendeurtypeclient.FDExtraCap * requetequotidienvendeurtypeclient.fdqteafacturer,2)
         		
         	CAS "Unite"
         		//		FIN
         		//		si requetequotidienvendeurtypeclient.ftype = 2 et pas requetequotidienvendeurtypeclient.fdverreunite alors
         		totalpage +=  Arrondi(requetequotidienvendeurtypeclient.fdqteafacturer * requetequotidienvendeurtypeclient.fdprixu,2)
         		totalfacture +=  Arrondi(requetequotidienvendeurtypeclient.fdqteafacturer * requetequotidienvendeurtypeclient.fdprixu,2)
         		
         		
         		
         	CAS "Fourniture"
         		//		totalpage +=  arrondi(requetebletat.fdqte * requetebLETAT.fdprixupied,2)
         		totalfacture +=  Arrondi(requetequotidienvendeurtypeclient.fdqteafacturer * requetequotidienvendeurtypeclient.fdprixupied,2)
         		
         		
         	CAS "Verre"
         		//sinon
         		//		totalpage +=  arrondi(requetequotidienvendeurtypeclient.fdqte * ((requetequotidienvendeurtypeclient.fdpiedcarrefacture * requetequotidienvendeurtypeclient.fdprixupiedfacture) + ...
         		//		requetequotidienvendeurtypeclient.fdextraforme),2)
         		totalfacture +=  Arrondi(requetequotidienvendeurtypeclient.fdqteafacturer * (requetequotidienvendeurtypeclient.fdpiedcarrefacture * requetequotidienvendeurtypeclient.fdprixupiedfacture),2)+ ...
         		Arrondi(requetequotidienvendeurtypeclient.fdqteafacturer *requetequotidienvendeurtypeclient.fdextraforme,2)+Arrondi(requetequotidienvendeurtypeclient.fdqteafacturer *requetequotidienvendeurtypeclient.FDextra10X,2)+...
         		Arrondi(requetequotidienvendeurtypeclient.fdqteafacturer *requetequotidienvendeurtypeclient.FDextra5x,2)
         		si pas RequeteQuotidienVendeurTypeClient.fdverreunite alors
         			totalthermosargent +=  Arrondi(requetequotidienvendeurtypeclient.fdqteafacturer * (requetequotidienvendeurtypeclient.fdpiedcarrefacture * requetequotidienvendeurtypeclient.fdprixupiedfacture),2)+ ...
         			Arrondi(requetequotidienvendeurtypeclient.fdqteafacturer *requetequotidienvendeurtypeclient.fdextraforme,2)+Arrondi(requetequotidienvendeurtypeclient.fdqteafacturer *requetequotidienvendeurtypeclient.FDextra10X,2)+...
         			Arrondi(requetequotidienvendeurtypeclient.fdqteafacturer *requetequotidienvendeurtypeclient.FDextra5x,2)
         		fin
         		
         		//		totalfacture +=  arrondi(requetequotidienvendeurtypeclient.fdqte * ((requetequotidienvendeurtypeclient.fdpiedcarrefacture * requetequotidienvendeurtypeclient.fdprixupiedfacture)+ ...
         		//		requetequotidienvendeurtypeclient.fdextraforme),2)
         		
         		totalthermos+=requetequotidienvendeurtypeclient.fdqteafacturer 
         		
         		totalsurcharge += Arrondi(requetequotidienvendeurtypeclient.surchargeenergie,2) //* requetequotidienvendeurtypeclient.fdqteafacturer / requetequotidienvendeurtypeclient.fdqte
         		SI PAS RequeteQuotidienVendeurTypeClient.fdverreunite ALORS
         			TotalThermosArgent += Arrondi(requetequotidienvendeurtypeclient.surchargeenergie,2) //* requetequotidienvendeurtypeclient.fdqteafacturer / requetequotidienvendeurtypeclient.fdqte
         		fin
         		
         		totalcap+= Arrondi(requetequotidienvendeurtypeclient.FDExtraCap * requetequotidienvendeurtypeclient.fdqteafacturer,2)
         		
         		
         		
         	CAS "Carrelage"
         		//		FIN
         		//		si requetequotidienvendeurtypeclient.ftype = 2 et pas requetequotidienvendeurtypeclient.fdverreunite alors
         		totalpage +=  Arrondi(requetequotidienvendeurtypeclient.fdcarrprixtotal+requetequotidienvendeurtypeclient.fTotalPeinture,2)
         		
         		totalfacture +=  Arrondi((requetequotidienvendeurtypeclient.frcarrprixu + requetequotidienvendeurtypeclient.fdcarrprixdebase)* requetequotidienvendeurtypeclient.fdqteafacturer,2)...
         		+Arrondi(((requetequotidienvendeurtypeclient.Ftotalcarreaupeinture*requetequotidienvendeurtypeclient.fPrixCarreauPeinture)...
         		+(requetequotidienvendeurtypeclient.FDnbcarreauPeinture1*requetequotidienvendeurtypeclient.fdprixcarreaupeinture1))...
         		* requetequotidienvendeurtypeclient.fdqteafacturer ,2)
         		
         		TotalcarrelageArgent +=  Arrondi((requetequotidienvendeurtypeclient.frcarrprixu + requetequotidienvendeurtypeclient.fdcarrprixdebase)* requetequotidienvendeurtypeclient.fdqteafacturer,2)...
         		+Arrondi(((requetequotidienvendeurtypeclient.Ftotalcarreaupeinture*requetequotidienvendeurtypeclient.fPrixCarreauPeinture)...
         		+(requetequotidienvendeurtypeclient.FDnbcarreauPeinture1*requetequotidienvendeurtypeclient.fdprixcarreaupeinture1))...
         		* requetequotidienvendeurtypeclient.fdqteafacturer ,2)	
         		
         		//		totalfacture +=  arrondi(requetequotidienvendeurtypeclient.fdcarrprixtotal+requetequotidienvendeurtypeclient.fTotalPeinture,2)
         		//		AlimenteHistoriqueProduit(sansespace(client.numero),requetequotidienvendeurtypeclient.BDateFacture,2,requetequotidienvendeurtypeclient.fdnumprod,"","","", arrondi(requetequotidienvendeurtypeclient.fdqte * requetequotidienvendeurtypeclient.fdprixu,2),...
         		//		requetequotidienvendeurtypeclient.surchargeenergie,requetequotidienvendeurtypeclient.fddesc,requetequotidienvendeurtypeclient.fdqte)
         		totalcarrelage+=requetequotidienvendeurtypeclient.fdqteafacturer * requetequotidienvendeurtypeclient.fdcarreauh * requetequotidienvendeurtypeclient.fdcarreauv
         		
         	CAS "Peinture"
         		//		FIN
         		//		si requetequotidienvendeurtypeclient.ftype = 2 et pas requetequotidienvendeurtypeclient.fdverreunite alors
         		totalpage +=  Arrondi(requetequotidienvendeurtypeclient.fdprixtotal,2)
         		totalfacture +=  Arrondi(requetequotidienvendeurtypeclient.fdqteafacturer * (requetequotidienvendeurtypeclient.fdpiedcarrefacture * requetequotidienvendeurtypeclient.fdprixupied),2)
         		//		totalfacture +=  arrondi(requetequotidienvendeurtypeclient.fdprixtotal,2)
         		TotaldePeinture+= Arrondi(requetequotidienvendeurtypeclient.fdprixtotal,2) * requetequotidienvendeurtypeclient.fdqteafacturer / requetequotidienvendeurtypeclient.fdqte
         		//		AlimenteHistoriqueProduit(sansespace(client.numero),requetequotidienvendeurtypeclient.BDateFacture,2,requetequotidienvendeurtypeclient.fdnumprod,"","","", arrondi(requetequotidienvendeurtypeclient.fdqte * requetequotidienvendeurtypeclient.fdprixu,2),...
         		//		requetequotidienvendeurtypeclient.surchargeenergie,requetequotidienvendeurtypeclient.fddesc,requetequotidienvendeurtypeclient.fdqte)
         		
         FIN
         
         
        type : 327692
      -
        type : 327697
        enabled : false
