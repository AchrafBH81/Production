 message_bar :
  internal_properties : CQAAAAkAAAAKahz/S0wCE4TxGW8TaSWPlADYFfSSV7/NXpQkcwrxpu2G7YzlQZmTqmRsPKX2vJHrRqprkzaeTZ6L9udbTj5yqBaBXWnAr9ftnENbf+XcBybTva9kXoIXIkVWTQ==
 actionbar : {}
 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1+
      fonction vision(SaisieOK=0)
      // L'appel à cette fenêtre est du type:
      //       OUVRE(nom_fen,SaisieOK)
      //		 si SaisieOK alors 		// Un enregistrement a été sélectionné
      // Vous pouvez aussi utiliser la syntaxe d'appel suivante:
      //       SI OUVRE(nom_fen) alors		// Un enregistrement a été sélectionné
      
      
      // Pour compatibilité 5.5
      MoiMême..Visible=Vrai
      
      Global
          resultat est une chaine
      	NomFic		est une chaine		// Nom du fichier associé à la fenêtre
      	CleParcours	est une chaine		// Nom de la clé de parcours
          pos est un entier 
       NomFic="persoens"						// Fichier principal de la fenêtre
       CleParcours="ennumero"	// Détermine l'ordre de tri initial de la table
      
      // Affiche dans la table, depuis le début du fichier, avec ascenseur variable.
      // Pas de filtre sur le fichier, le total des enregistrements peut-être visualisé.
      pos = hsauveposition("ensemble")
      
      hexecuterequete(RequetePerso)
      
      //TableMode("Table","NbEnreg")
      EcranPremier("Table")	// Se place sur la table
      
   -
     type : 180
     enabled : false
   -
     type : 230
     enabled : false
   -
     code : |1+
      renvoyer resultat
      
     type : 2
   -
     type : 11
   -
     type : 12
   -
     type : 17
   -
     type : 13
