 code_elements :
  type_code : 13
  p_codes :
   -
     code : |1+
      Procedure _LISTE_UNITE_UNITE(_pParam1="", _pParam2="", _pParam3="", _pParam4="")
      
      
     type : 327680
   -
     code : |1+
      // Vérification de la condition
      SI pas (I0.iunitetype=1 OU I0.iunitetype=4) ALORS RENVOYER FAUX
      SI pas (I0.itype=2) ALORS RENVOYER FAUX
      si (position(_pparam1,complete(invent.icategorie,3)) = 0) alors renvoyer faux
      RENVOYER VRAI		// Enregistrement accepté
      
     type : 327696
