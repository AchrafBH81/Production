     p_codes :
      -
        code : |1+
         	si table1..modifie _et_ acso_message("Question","Voulez annuler les modifications en cours ? ","OuiNon") = idyes alors
         		ferme(mafenetre)
         	sinon
         	    ferme(mafenetre)
         	FIN
         
         
         
         
        type : 18
      -
