  -
    name : Btn_Ok
    identifier : 0x2cf40295c37353c3
    internal_properties : 
    properties :
     x : 39
     y : 16
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         pour chaque ligne de table1
         	jliv est un entier = 0
         	SI Table1.Col_ID <> 0  ALORS
         		hlitrecherche(SaisonLivraison,IDSaisonLivraison,table1.col_id)
         	sinon
         		HRAZ(SaisonLivraison)
         	FIN
         	saisonlivraison.Description = table1.Col_Description
         	SaisonLivraison.sactif = table1.Col_Active
         	SaisonLivraison.datedebut = Table1.Col_debut
         	SaisonLivraison.datefin = Table1.Col_fin
         	
         	POUR i = 1 A 7
         		
         		jliv += ({"table1.col_jour"+i,indChamp} ? 1 SINON 0) * Puissance(2,i-1)
         	FIN
         	SaisonLivraison.JoursLivraison = jliv
         	
         henregistre(SaisonLivraison)
         	
         FIN
         POUR TOUT SaisonLivraison 
         	SI SaisonLivraison.sActif ALORS 
         		gPeriodeLivraison = SaisonLivraison.IDSaisonLivraison
         		SORTIR
         	FIN
         FIN
         ferme(mafenetre)
        type : 18
      -
        type : 161
        enabled : false
  -
    name : Btn_Annule
    identifier : 0x2cf40295c37553d2
    internal_properties : 
    properties :
     x : 80
     y : 16
     width : 35
     height : 35
    type : 4
    code_elements :
