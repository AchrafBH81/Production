  procedures :
   -
     name : LoadJourLivraison
     procedure_id : 2086376317913921065
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      // LoadJourLivraison ()
      //
      // Paramètres :
      //	Aucun
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE LoadJourLivraison()
      
      pour TOUT SaisonLivraison 
      	tableajoute(Table1)
      	TableSelectPlus(Table1,table1..Occurrence)
      	Table1.Col_Active[Table1] = SaisonLivraison.sActif
      	Table1.Col_Description[Table1] = SaisonLivraison.Description
      	Table1.Col_debut[Table1] = SaisonLivraison.DateDebut
      	Table1.Col_fin[Table1] = SaisonLivraison.Datefin
      	
      	
      	Table1.Col_id[Table1] = SaisonLivraison.IDSaisonLivraison
      		POUR i = 1 À 7
      			SI SaisonLivraison.JoursLivraison & Puissance(2,i-1) > 0 ALORS
      				{"table1.col_jour"+i,indChamp} = vrai
      			SINON
      				{"table1.col_jour"+i,indChamp} = Faux
      			FIN
      		FIN
      	
      	
      	
      FIN
      
     type : 458752
