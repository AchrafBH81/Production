    name : BTN_INTEGRITE
    identifier : 0x514f23a33ab5b541
    internal_properties : 
    properties :
     x : 658
     y : 3
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         selon CLI_ONGLET
         	cas 4
         		ouvresoeur(fenattente,"Vérification de l'intégrité des prix spéciaux du client en cours .....")
         		clederecherche est une chaine = hconstruitvalcle(ThermosClient,IdClientIdhermos,sansespace(fenclienttrn.numero),"")
         		hlitrecherche(ThermosClient,IdClientIdhermos,clederecherche)
         		tantque pas hendehors(thermosclient) et thermosclient.IdClient = fenclienttrn.numero
         
         			si pas hlitrecherche(persoens,ennumero,complete(thermosclient.IdThermos,20," ")) alors
         				hsupprime(ThermosClient,hNumEnrEnCours)
         			fin	
         			hlitsuivant(ThermosClient,IdClientIdhermos)
         		FIN
         		multitache(200)
         		ExécuteTraitement(table,trtSélection)
         		ferme(fenattente)
         	cas 3
         		ouvresoeur(fenattente,"Vérification de l'intégrité des produits avec prix spéciaux du client en cours .....")
         		pour tout produitclient
         			si hlitrecherche(invent,INUM,produitclient.idproruit) alors
         				produitclient.icategorie = invent.icategorie
         				hmodifie(ProduitClient,hNumEnrEnCours)
         			fin
         
         		fin
         		multitache(200)
         		ferme(fenattente)
         fin
         
        type : 18
      -
        type : 161
        enabled : false
