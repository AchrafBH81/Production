        -
          name : BTN_DETRUIRE_3
          identifier : 0x514f23a32a86b537
          internal_properties : 
          properties :
           x : 732
           y : 270
           width : 35
           height : 35
          type : 4
          code_elements :
           type_code : 4
           p_codes :
            -
              code : |1+
               _indice est un entier = TableSelect(Table_ClientGarantie)
               si Table_ClientGarantie.IsDeleted[_indice] = vrai alors
               	si acso_message("Question","Réactiver l'enregistrement ?","OuiNon") = idyes alors
               		Table_ClientGarantie.IsDeleted[_indice] = faux
               		BTN_DETRUIRE_3..imagefond = BTN_DETRUIRE_6..imagefond
               	fin
               sinon
               	si acso_message("Question","Supprime l'enregistrement ?","OuiNon") = idyes alors
               		Table_ClientGarantie.IsDeleted[_indice] = vrai
               		BTN_DETRUIRE_3..imagefond = BTN_DETRUIRE_4..imagefond
               	fin
               fin
               
              type : 18
            -
              type : 161
              enabled : false
        -
          name : BTN_PRIX_MODIFIE_2
          identifier : 0x514f23a371ddb52d
          internal_properties : 
          properties :
           x : 730
           y : 158
           width : 35
           height : 35
          type : 4
          code_elements :
           type_code : 4
           p_codes :
            -
              code : |1+
               resultat est une chaine
               _idgarantie est un entier
               _description est une chaine
               _date est une chaine
               _indice est un entier = tableselect(Table_ClientGarantie)
               
               
               resultat = ouvre(AjoutModifGarantie,"M",Table_ClientGarantie.idGarantie[_indice],Table_ClientGarantie.date[_indice],Table_ClientGarantie.datefin[_indice])
               _idgarantie = val(extraitchaine(resultat,1,"|"))
               si _idgarantie <> 0 alors
               	table_clientgarantie.idgarantie[_indice] = _idgarantie
               	table_clientgarantie.numero[_indice] = extraitchaine(resultat,5,"|")
               	table_clientgarantie.Description[_indice] = extraitchaine(resultat,2,"|")
               	table_clientgarantie.date[_indice] = extraitchaine(resultat,3,"|")
               	table_clientgarantie.datefin[_indice] = extraitchaine(resultat,4,"|")
               FIN
               
               tableaffiche(Table_ClientGarantie,taCourantPremier)
               
               
               
              type : 18
            -
              type : 161
              enabled : false
        -
          name : PRIX_AJOUT_2
          identifier : 0x514f23a33b1eb52d
          internal_properties : 
          properties :
           x : 729
           y : 113
           width : 35
           height : 35
          type : 4
          code_elements :
           type_code : 4
           p_codes :
            -
              code : |1+
               	
               	resultat est une chaine = ouvre(AjoutModifGarantie)
               	_idgarantie est un entier = val(extraitchaine(resultat,1,"|"))
               	si _idgarantie <> 0 alors
               		tableajouteligne(Table_ClientGarantie,extraitchaine(resultat,5,"|"),extraitchaine(resultat,2,"|"),extraitchaine(resultat,3,"|"),0,_idgarantie,0,extraitchaine(resultat,4,"|"))
               	FIN
               	tableaffiche(Table_ClientGarantie,taCourantPremier)
               
               
              type : 18
            -
              type : 161
              enabled : false
