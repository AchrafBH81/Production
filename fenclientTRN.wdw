              type : 20
            -
              code : |1+
               si Table_Extra <> -1 alors
               	si Table_Extra.PBASE[Table_Extra] <> 1 alors
               		Table_Extra.PPRIXT[Table_Extra]..CouleurFond = iGrisFoncé
               		Table_Extra.PPRIXTM[Table_Extra]..CouleurFond = iGrisFoncé
               		Table_Extra.PPRIXT[Table_Extra]..Couleur = iGrisFoncé
               		Table_Extra.PPRIXTM[Table_Extra]..Couleur = iGrisFoncé
               		si pas Table_Extra.cModifiable[Table_Extra] ALORS
               			Table_Extra.PPRIXd[Table_Extra]..CouleurFond = iGrisFoncé
               			Table_Extra.PPRIXdM[Table_Extra]..CouleurFond = iGrisFoncé
               			Table_Extra.PPRIXd[Table_Extra]..Couleur = iblanc
               			Table_Extra.PPRIXDM[Table_Extra]..Couleur = iblanc
               		fin
               	fin
               
               
               fin
