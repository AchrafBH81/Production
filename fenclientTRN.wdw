      tantque pas hendehors(RequeteProduitClient)
      	selon RequeteProduitClient.itype
      		cas 4            // carrelage
      		TABLEAJOUTELIGNE(Tablepeinture,RequeteProduitClient.INUM,requeteproduitclient.idesc,...
      			RequeteProduitClient.iprixcarreauPeinture,faux,faux)
