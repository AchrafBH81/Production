               //	BtnFlecheSuivant..Grisé = Vrai
               //FIN
               //ExécuteTraitement(CLI_ONGLET.BtnSave,trtClic)
               //AfficherJourLivraisonPourUnMois()
               //lIndice est un entier = indiceencours()
               //
               //
               //	si JoursLivraison[lIndice] alors
               //		{"Combo_Camion"+lIndice,indChamp}..visible = Vrai
               //		{"Combo_Camion"+lIndice,indChamp}..etat = actif
               //	sinon
               //		{"Combo_Camion"+lIndice,indChamp}..valeur = -1
               //		{"Combo_Camion"+lIndice,indChamp}..Visible = faux
               //		{"Combo_Camion"+lIndice,indChamp}..Etat = AffichageSeulement
               //	FIN
               
               
               TAjourlivraisonsaison[Combo_SaisonLivraison].JoursLivraisonClientCompile=0
               POUR i = 1 A 7
               	
               	TAjourlivraisonsaison[Combo_SaisonLivraison].JoursLivraisonClientCompile += (JoursLivraison[i] ? 1 SINON 0) * Puissance(2,i-1)
               FIN
               
               
               
               AfficherJourLivraisonPourUnMois()
               lIndice est un entier = indiceencours()
               TAjourlivraisonsaison[Combo_SaisonLivraison].tabJourLivraison[lIndice] = JoursLivraison[lIndice]
               SI PAS JoursLivraison[lIndice] ALORS TAjourlivraisonsaison[Combo_SaisonLivraison].tabJourLivraisonCamion[lIndice] = 0
               
               SI JoursLivraison[lIndice] ALORS
               	{"Combo_Camion"+lIndice,indChamp}..Visible = Vrai
               	{"Combo_Camion"+lIndice,indChamp}..Etat = Actif
               	{"saisequence"+lIndice,indChamp}..Visible = Vrai
               	{"saisequence"+lIndice,indChamp}..Etat = Actif
               	
               SINON
               	{"Combo_Camion"+lIndice,indChamp}..Valeur = -1
               	{"Combo_Camion"+lIndice,indChamp}..Visible = Faux
               	{"Combo_Camion"+lIndice,indChamp}..Etat = AffichageSeulement
               	{"saisequence"+lIndice,indChamp}..Visible = Faux
               	{"saisequence"+lIndice,indChamp}..Etat = AffichageSeulement
               FIN
              type : 17
        -
          name : Combo_SaisonLivraison
          identifier : 0x2cf4524d1265c502
          internal_properties : 
          properties :
           x : 63
           y : 78
           width : 228
           height : 24
          dropdown :
           internal_properties : 
           type : 7
          type : 14
          code_elements :
           type_code : 23
           p_codes :
            -
              code : |1+
               //HLitRecherche(SaisonLivraison,IDSaisonLivraison,moimeme)
               //i est entier
               //POUR i = 1 À 7
               //	JoursLivraison[i] = faux
               //fin
               //POUR i = 1 À 7
               //	SI SaisonLivraison.JoursLivraison & Puissance(2,i-1) = 0 ALORS
               //		JoursLivraison[i]..Etat  = Grisé
               //	SINON	
               //		JoursLivraison[i]..Etat  = actif
               //	FIN
               //FIN
               //
               //si hlitrecherche(JourLivraisonClient,IDClientIDSaisonLivraison,[client.IDClient,moimeme])  ALORS
               //	POUR i = 1 À 7
               //		
               //		SI JourLivraisonClient.JourLivraison & Puissance(2,i-1) <> 0 ALORS
               //			jourslivraison[i] = (JoursLivraison[i]..Etat  = actif)
               //		SINON	
               //			JoursLivraison[i]= faux
               //		FIN
               //
               //		{"Combo_camion"+i,indChamp}..visible = JoursLivraison[i]
               //		{"Combo_camion"+i,indChamp} = JourLivraisonClient.IDCamions[i]
               //		si modif alors
               //			si {"Combo_camion"+i,indChamp}..Visible alors {"Combo_camion"+i,indChamp}..etat = actif
               //		FIN
               //	FIN
               //	
               //	
               //FIN
               //
               //AfficherJourLivraisonPourUnMois()
               
               
               
               HLitRecherche(SaisonLivraison,IDSaisonLivraison,MoiMême)
               i est entier
               POUR i = 1 À 7
               	JoursLivraison[i] = Faux
               	JoursLivraison[i]..Etat  = Actif
               	{"Combo_camion"+i,indChamp}..Visible = Faux
               	{"saisequence"+i,indChamp}..Visible = Faux
               FIN
               POUR i = 1 À 7
               	SI SaisonLivraison.JoursLivraison & Puissance(2,i-1) = 0 ALORS
               		JoursLivraison[i]..Etat  = Grisé
               	SINON	
               		
               	FIN
               FIN
               
               
               
               
               
               lJoursLivraisonClient est un stJoursLivraison= TAjourlivraisonsaison[moimeme]
               
               
               POUR i = 1 À 7
               	
               	SI lJoursLivraisonClient.JoursLivraisonClientCompile & Puissance(2,i-1) <> 0 ALORS
               		JoursLivraison[i] = (JoursLivraison[i]..Etat  = Actif)
               	SINON	
               		JoursLivraison[i]= Faux
               	FIN
               	
               	{"Combo_camion"+i,indChamp}..Visible = JoursLivraison[i]
               	{"saisequence"+i,indChamp}..Visible = JoursLivraison[i]
               	{"Combo_camion"+i,indChamp} = lJoursLivraisonClient.tabJourLivraisonCamion[i]
               	{"saisequence"+i,indChamp} = lJoursLivraisonClient.tabShippingSequence[i]
               	SI {"Combo_camion"+i,indChamp}..Visible ALORS 
               		{"Combo_camion"+i,indChamp}..Etat = Actif
               	SINON
               		{"Combo_camion"+i,indChamp}..Valeur = -1
               	FIN
               FIN
               SI TAFrequence[MoiMême] <> Null ALORS
               	SaiFrequence = TAFrequence[MoiMême].frequence
               	SaiDatereference = TAFrequence[MoiMême].DateDeReference
               SINON
               	_frequence est un stFrequence = allouer un stFrequence
               	_frequence.Frequence = 1
               	_frequence.DateDeReference = ""
               	TAFrequence[MoiMême] = _frequence
               	SaiFrequence = TAFrequence[MoiMême].frequence
               	SaiDatereference = TAFrequence[MoiMême].DateDeReference
               FIN
               
               
               AfficherJourLivraisonPourUnMois()
