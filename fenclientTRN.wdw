      listeajoute(COL_Supprime,gimage(BTN_SupprimtComposante..image))
      gnOldLine est un entier = 0
      gsOldNumber est une chaine = ""
      //valideonglet(moimeme..nom)
      
      HLitRecherche(UserGroup,IDUserGroup,Usager.IDGroupe)
      si UserGroup.ModifPrix = faux  alors GR_MofiPrix..Etat = Grisé
      
      
