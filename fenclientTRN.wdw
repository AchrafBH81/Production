     name : affichetableqte
     procedure_id : 5858940824033277099
     type_code : 14
     code : |1+
      Procédure affichetableqte()
      
      si pas tableoccurrence("TABLE_6") = 0 alors
      si pas toutedimension alors
      
      	activefiltredimstd(complete(dcomposant1,10)+complete(dcomposant2,10)+complete(dcomposant3,10)+caract(0),...
      	complete(dcomposant1,10)+complete(dcomposant2,10)+complete(dcomposant3,10)+caract(255))
      	
      	//table_7..VISIBLE = FAUX
      //Code WinDev 5.5 remplacé par la migration :
      //	toutedim..VISIBLE = FAUX
      	toutedim..Visible=Faux
      //Code WinDev 5.5 remplacé par la migration :
      //	grpdimension..etat = actif
      	grpdimension..etat = actif; grpdimension..Visible=Vrai
      	//table_8..etat = actif	
      	//table_9..etat = actif	
      //Code WinDev 5.5 remplacé par la migration :
      //	tableaffiche("TABLE_8","I")
      	tableaffiche("TABLE_8",taDebut)
      //Code WinDev 5.5 remplacé par la migration :
      //	execute("table_8..lentree")
      	ExecuteTraitement("table_8",trtENTREELIGNE)
      sinon
      	activefiltredim(cl.numero+complete(dcomposant1,10)+complete(dcomposant2,10)+complete(dcomposant3,10)+caract(0),...
      	cl.numero+complete(dcomposant1,10)+complete(dcomposant2,10)+complete(dcomposant3,10)+caract(255))
      //Code WinDev 5.5 remplacé par la migration :
      //	toutedim..etat = actif
      	toutedim..etat = actif; toutedim..Visible=Vrai
      //Code WinDev 5.5 remplacé par la migration :
      //	grpdimension..VISIBLE = FAUX
      	grpdimension..Visible=Faux
      	// table_7..etat = actif
      	// table_8..VISIBLE = FAUX	
      	//table_9..VISIBLE = FAUX	
      //Code WinDev 5.5 remplacé par la migration :
      //	tableaffiche("TABLE_7","I")
      	tableaffiche("TABLE_7",taDebut)
      	si tableoccurrence("TABLE_6") = 0 alors
      //Code WinDev 5.5 remplacé par la migration :
      //		table_7..VISIBLE = FAUX
      		table_7..Visible=Faux
      	sinon
      //Code WinDev 5.5 remplacé par la migration :
      //		table_7..etat = inactif
      		table_7..etat = AffichageSeulement; table_7..Visible=Vrai
      		
      	fin  
      fin
      sinon
      //Code WinDev 5.5 remplacé par la migration :
      //	toutedim..VISIBLE = FAUX
      	toutedim..Visible=Faux
      //Code WinDev 5.5 remplacé par la migration :
      //	grpdimension..VISIBLE = FAUX
      	grpdimension..Visible=Faux
      fin	
      	
      //HFILTRE("spqteint","spqclientproduitintervalle",cl.numero+complete(spqproduit,10)+caract(0),...
      //        cl.numero+complete(spqproduit,10)+caract(255))
      
     type : 458752
   -
     name : remplirfichiertempo
     procedure_id : 5858940824673629355
     type_code : 14
     code : |1+
      // pour creer et remplir fichier temporaire pour dimension standard
      Procédure remplirfichiertempo()
      hdesactivefiltre("spdimint")
      hdesactivefiltre("spdimdim")
      hcreation("xdim")
      hlitpremier("spdim","spqclientproduit")
      
      //Code WinDev 5.5 remplacé par la migration :
      //tantque pas h.endehors
      tantque pas HEnDehors()
      	si spdim.sptoutedim alors
      		hlitrecherche("spdimint","spqclientproduitintervalle",...
      		spdim.spqclient+spdim.spcomposant1+spdim.spcomposant2+spdim.spcomposant3+caract(0))
      
      		tantque spdim.spqclient+spdim.spcomposant1+spdim.spcomposant2+spdim.spcomposant3 = ...
      			//Code WinDev 5.5 remplacé par la migration :
      			//			spdimint.spqclient+spdimint.spqcomposant1+spdimint.spqcomposant2+spdimint.spqcomposant3 et pas h.endehors
      			spdimint.spqclient+spdimint.spqcomposant1+spdimint.spqcomposant2+spdimint.spqcomposant3 et pas HEnDehors()
      
      			xdim.produit = spdimint.spqproduit
      			xdim.composant1   = spdimint.spqcomposant1
      			xdim.composant2   = spdimint.spqcomposant2
      			xdim.composant3   = spdimint.spqcomposant3
      			xdim.xdimension = "Toutes"
      			xdim.xinter = spdimint.spqintervallenumero
      			xdim.bornei     = spdimint.spqborneinferieure
      			xdim.bornes     = spdimint.spqbornesuperieure
      			xdim.pourcentage = spdimint.spqpourcentageescompte
      			hajoute("xdim")
      			//Code WinDev 5.5 remplacé par la migration :
      			//			si hdoublon() alors
      			si HErreurDoublon() alors
      				ACSO_message("Erreur","Doublon","Erreur")
      			FIN
      			hlitsuivant("spdimint","spqclientproduitintervalle")
      		fin
      	sinon
      		hlitrecherche("spdimdim","spqclientproduitintervalle",...
      		spdim.spqclient+spdim.spcomposant1+spdim.spcomposant2+spdim.spcomposant3+caract(0))
      		tantque spdim.spqclient+spdim.spcomposant1+spdim.spcomposant2+spdim.spcomposant3 = ...
      			spdimdim.spqclient+spdimdim.spqcomposant1+spdimdim.spqcomposant2+spdimdim.spqcomposant3  ...
      			//Code WinDev 5.5 remplacé par la migration :
      			//			 et pas h.endehors
      			et pas HEnDehors()
      			xdim.produit = spdimdim.spqproduit
      			xdim.composant1   = spdimdim.spqcomposant1
      			xdim.composant2   = spdimdim.spqcomposant2
      			xdim.composant3   = spdimdim.spqcomposant3
      			xdim.xdimension = spdimdim.spdimension
      			xdim.xinter = spdimdim.spqintervallenumero
      			xdim.bornei     = spdimdim.spqborneinferieure
      			xdim.bornes     = spdimdim.spqbornesuperieure
      			xdim.pourcentage = spdimdim.spqpourcentageescompte
      			hajoute("xdim")
      			hlitsuivant("spdimdim","spqclientproduitintervalle")
      		fin
      	fin	
      	hlitsuivant("spdim","spqclientproduit")
      FIN
      hactivefiltre("spdimint")
      hactivefiltre("spdimdim")
      
     type : 458752
   -
     name : maj_table_thermos
     procedure_id : 5858940825138214059
     type_code : 14
     code : |1+
      Procédure maj_table_thermos()
      clederecherche est une chaine
      i est un entier
      pour i = 1 a TableOccurrence(table1)
      	si hlitrecherche(persoens,ennumero,table1.Tennumero[i]) alors
      		clederecherche = HConstruitValClé(ThermosClient,IdClientIdhermos,complete(fenclienttrn.numero,10),complete(table1.Tennumero[i],20))
      		si table1.Timprime[i] ou table1.Tspecial[i] alors
      			si hlitrecherche(ThermosClient,IdClientIdhermos,clederecherche,hIdentique) alors
      				ThermosClient.ListeDePrix = table1.Timprime[i]
      				ThermosClient.prixSpecial = table1.Tspecial[i]
      				si table1.Tspecial[i] alors
      					thermosclient.Tprixa = table1.Tenprixa[i]
      					thermosclient.Tprixm = table1.Tenprixm[i]
      				FIN
      				hmodifie(ThermosClient,hNumEnrEnCours)
      			sinon
      				thermosclient.IdClient = fenclienttrn.numero
      				ThermosClient.IdThermos = table1.Tennumero[i]
      				ThermosClient.ListeDePrix = table1.Timprime[i]
      				ThermosClient.prixSpecial = table1.Tspecial[i]
      				si table1.Tspecial[i] alors
      					thermosclient.Tprixa = table1.Tenprixa[i]
      					thermosclient.Tprixm = table1.Tenprixm[i]
      				FIN
      				hajoute(ThermosClient)
      			FIN
      		sinon
      			si hlitrecherche(ThermosClient,IdClientIdhermos,clederecherche,hIdentique) alors
                    hsupprime(ThermosClient,hNumEnrEnCours)
      			fin
      
      		fin
      
      	fin
      FIN
      
      
      
      
     type : 458752
   -
     name : remplir_table_thermos
     procedure_id : 5858940823712543915
     type_code : 14
     code : |1+
      Procédure remplir_table_thermos()
      TableSupprimeTout(Table1)
      _prixanglais est un reel = 0
      _prixmetrique est un reel = 0
      _Special est un booleen = faux
      _imprime est un booleen = faux
      _resultatCalcul est une chaine
      _trouve est un booleen = faux
      r_PrixSurchargeAnglais est un réel
      r_PrixSUrchargeMetrique est un réel
      
      HExécuteRequête(RequetePerso)
      pour tout RequetePerso
      	_imprime = faux
      	_Special = faux
      	_trouve = faux
      	
      	r_PrixSurchargeAnglais = 0
      	r_PrixSUrchargeMetrique = 0
      	
      
      	si HLitRecherche(PrixSurchargeClient,IDClientennumero,HConstruitValClé(PrixSurchargeClient,IDClientennumero,client.IDClient,RequetePerso.ennumero)) ALORS
      		r_PrixSurchargeAnglais =  PrixSurchargeClient.PrixAnglais
      		r_PrixSUrchargeMetrique = PrixSurchargeClient.PrixMetrique
      	FIN
      	si hlitrecherche(ThermosClient,IdClientIdhermos,hconstruitvalcle(ThermosClient,IdClientIdhermos,complete(client.numero,10),complete(RequetePerso.ennumero,20))) alors
      		_imprime = ThermosClient.ListeDePrix
      		_trouve = vrai
      		_Special = ThermosClient.prixSpecial
      
      	FIN
      	si requeteperso.enfabrication ou RequetePerso.enVerreUnite alors
      		si _trouve et  _Special alors
      			_prixanglais = ThermosClient.Tprixa
      			_prixmetrique = ThermosClient.Tprixm
      		sinon
      			_prixanglais = RequetePerso.enprixa
      			_prixmetrique = RequetePerso.enprixm
      		fin
      
      	sinon
      		_resultatCalcul = CalculPrixThermos(requeteperso.ennumero,client.IDClient)
      		_prixanglais = val(ExtraitChaîne(_resultatCalcul,1,","))
      		_prixmetrique = val(ExtraitChaîne(_resultatCalcul,2,","))
      		_Special = val(ExtraitChaîne(_resultatCalcul,3,","))
      	fin
      
      
      	TableAjouteLigne(table1,RequetePerso.ennumero,RequetePerso.endescription,RequetePerso.encomposant1,RequetePerso.encomposant2,RequetePerso.encomposant3,...
      	_prixanglais,_prixmetrique,_imprime,_Special,(requeteperso.enfabrication ou requeteperso.enVerreUnite),r_PrixSurchargeAnglais,r_PrixSUrchargeMetrique)
      
      FIN
      
      
     type : 458752
   -
     name : remplir_table_produit
     procedure_id : 5858940824963691691
     type_code : 14
     code : |1-
      Procédure remplir_table_produit()
      
      hlitpremier(RequeteProduitClient)
      tantque pas hendehors(RequeteProduitClient)
      	selon RequeteProduitClient.itype
      		cas 5            // carrelage
      			TABLEAJOUTELIGNE(Table_1,RequeteProduitClient.INUM,requeteproduitclient.idesc,...
      			RequeteProduitClient.iprixPeinture,requeteproduitclient.iprixpeintureM,0,0,faux,vrai,5,...
      			faux,faux,RequeteProduitClient.iUniteMesure)
      		cas 4            // carrelage
      			TABLEAJOUTELIGNE(Table_1,RequeteProduitClient.INUM,requeteproduitclient.idesc,...
      			RequeteProduitClient.iprixcarreau,requeteproduitclient.iprixbasecarrelage,0,0,faux,vrai,4)
      		cas 2
      			selon RequeteProduitClient.iunitetype
      				cas 1       // produit a l'unite
      					TABLEAJOUTELIGNE(Table_1,RequeteProduitClient.INUM,requeteproduitclient.idesc...
      					,RequeteProduitClient.iprixunite,0,0,0,faux,faux,1)
      				cas 2        // verre a l'unite
      					TABLEAJOUTELIGNE(Table_1,RequeteProduitClient.INUM,requeteproduitclient.idesc...
      					,RequeteProduitClient.iprixunitAIRE,RequeteProduitClient.iprixuniTEM,0,0,faux,vrai,2)
      
      			fin
      	fin
      
      
      
      
      	hlitsuivant(RequeteProduitClient)
      FIN
      
      
      //TABLEAFFICHE(TABLE_1,taDébut)
     type : 458752
   -
     name : maj_table_produit
     procedure_id : 5858940823546344619
     type_code : 14
     code : |1+
      Procédure maj_table_produit()
      
      clederecherche est une chaine
      i est un entier
      pour i = 1 a TableOccurrence(table_1)
      	si hlitrecherche(invent,INUM,table_1.PPRODUIT[i]) alors 
      
      		selon table_1.Ptype[i]
      			cas 1                     // Produit à l'unité
      				//				si table_1.PPRIXA[i] <> invent.iprixunite  alors
      				si table_1.Cimprime[i] ou table_1.Cspecial[i] alors
      					clederecherche = HConstruitValClé(produitClient,IdClientIdproruit,fenclienttrn.numero,table_1.pproduit[i])
      					si hlitrecherche(produitclient,IdClientIdproruit,clederecherche,hIdentique) alors
      						si table_1.cspecial[i] alors
      							produitclient.iprixa = table_1.PPRIXA[i]
      							//							ProduitClient.IPrixm = table_1.pprixm[i]
      						sinon
      							produitclient.iprixa = 0
      							//							ProduitClient.IPrixm = 0
      						fin
      
      						//				ProduitClient.IPrixa = table_1.pprixa[i]
      						produitclient.IlisteDePrix = table_1.Cimprime[i]
      						produitclient.IPprixSpecial = table_1.Cspecial[i]
      						produitclient.ITypeProduit = table_1.Ptype[i]
      						produitclient.icategorie = invent.icategorie
      
      						hmodifie(produitClient,hNumEnrEnCours)
      					sinon
      
      						si table_1.cspecial[i] alors
      							produitclient.iprixa = table_1.PPRIXA[i]
      							//							ProduitClient.IPrixm = table_1.pprixm[i]
      						sinon
      							produitclient.iprixa = 0
      							//							ProduitClient.IPrixm = 0
      						fin
      						produitClient.IdClient = fenclienttrn.numero
      						produitClient.Idproruit = table_1.pproduit[i]
      						//						ProduitClient.IPrixa = table_1.pprixa[i]
      						//						ProduitClient.IPrixm = table_1.pprixm[i]
      						produitclient.IlisteDePrix = table_1.Cimprime[i]
      						produitclient.IPprixSpecial = table_1.Cspecial[i]
      						produitclient.ITypeProduit = table_1.Ptype[i]
      						produitclient.icategorie = invent.icategorie
      						hajoute(produitClient)
      
      
      					FIN
      				sinon
      					clederecherche = HConstruitValClé(produitClient,IdClientIdproruit,fenclienttrn.numero,table_1.pproduit[i])
      					si hlitrecherche(produitclient,IdClientIdproruit,clederecherche,hIdentique) alors
      						HSupprime(ProduitClient,hnumenrencours)
      					fin 
      				FIN
      
      			cas 2            // Verre
      
      				//				si table_1.PPRIXA[i] <> invent.iprixunitaire ou table_1.PPRIXm[i] <> invent.iprixunitem  alors
      				si table_1.Cimprime[i] ou table_1.Cspecial[i] alors
      
      					clederecherche = HConstruitValClé(produitClient,IdClientIdproruit,fenclienttrn.numero,table_1.pproduit[i])
      					si hlitrecherche(produitclient,IdClientIdproruit,clederecherche,hIdentique) alors
      						si table_1.cspecial[i] alors
      							produitclient.iprixa = table_1.PPRIXA[i]
      							ProduitClient.IPrixm = table_1.pprixm[i]
      						sinon
      							produitclient.iprixa = 0
      							ProduitClient.IPrixm = 0
      						fin
      
      						//						ProduitClient.IPrixa = table_1.pprixa[i]
      						//						ProduitClient.IPrixm = table_1.pprixm[i]
      						produitclient.IlisteDePrix = table_1.Cimprime[i]
      						produitclient.IPprixSpecial = table_1.Cspecial[i]
      						produitclient.ITypeProduit = table_1.Ptype[i]
      						produitclient.ipricxcarreauPeinture = 0
      						produitclient.icategorie = invent.icategorie
      						hmodifie(produitClient,hNumEnrEnCours)
      					sinon
      
      						si table_1.cspecial[i] alors
      							produitclient.iprixa = table_1.PPRIXA[i]
      							ProduitClient.IPrixm = table_1.pprixm[i]
      						sinon
      							produitclient.iprixa = 0
      							ProduitClient.IPrixm = 0
      						fin
      						produitClient.IdClient = fenclienttrn.numero
      						produitClient.Idproruit = table_1.pproduit[i]
      						//						ProduitClient.IPrixa = table_1.pprixa[i]
      						//						ProduitClient.IPrixm = table_1.pprixm[i]
      						produitclient.IlisteDePrix = table_1.Cimprime[i]
      						produitclient.IPprixSpecial = table_1.Cspecial[i]
      						produitclient.ITypeProduit = table_1.Ptype[i]
      						produitclient.ipricxcarreauPeinture = 0
      						produitclient.icategorie = invent.icategorie
      						hajoute(produitClient)
      
      					fin 
      				sinon
      					clederecherche = HConstruitValClé(produitClient,IdClientIdproruit,fenclienttrn.numero,table_1.pproduit[i])
      					si hlitrecherche(produitclient,IdClientIdproruit,clederecherche,hIdentique) alors
      						HSupprime(ProduitClient,hnumenrencours)
      					fin 
      
      				FIN
      
      			cas 4            // Carrelage
      				//				si table_1.PPRIXA[i] <> invent.iprixcarreau  alors
      				si table_1.Cimprime[i] ou table_1.Cspecial[i] alors
      
      					clederecherche = HConstruitValClé(produitClient,IdClientIdproruit,fenclienttrn.numero,table_1.pproduit[i])
      
      					si hlitrecherche(produitclient,IdClientIdproruit,clederecherche,hIdentique) alors
      						si table_1.cspecial[i] alors
      							produitclient.iprixa = table_1.PPRIXA[i]
      							ProduitClient.IPrixm = table_1.pprixm[i]
      							ProduitClient.IPrixCarrPiedCarre = table_1.PrixCarrPC[i]
      							ProduitClient.IPrixCarrMetCarre  = table_1.PrixCarrM[i]
      						sinon
      							produitclient.iprixa = 0
      							ProduitClient.IPrixm = 0
      							ProduitClient.IPrixCarrPiedCarre = 0
      							ProduitClient.IPrixCarrMetCarre  = 0
      						fin
      						//
      						//						ProduitClient.IPrixa             = table_1.pprixa[i]
      						//						ProduitClient.IPrixm             = table_1.pprixm[i]
      						//						ProduitClient.IPrixCarrPiedCarre = table_1.PrixCarrPC[i]
      						//						ProduitClient.IPrixCarrMetCarre  = table_1.PrixCarrM[i]
      						produitclient.IlisteDePrix = table_1.Cimprime[i]
      						produitclient.IPprixSpecial = table_1.Cspecial[i]
      						produitclient.ITypeProduit = table_1.Ptype[i]
      						produitclient.icategorie = invent.icategorie
      						hmodifie(produitClient,hNumEnrEnCours)
      					sinon
      						si table_1.cspecial[i] alors
      							produitclient.iprixa = table_1.PPRIXA[i]
      							ProduitClient.IPrixm = table_1.pprixm[i]
      							ProduitClient.IPrixCarrPiedCarre = table_1.PrixCarrPC[i]
      							ProduitClient.IPrixCarrMetCarre  = table_1.PrixCarrM[i]
      						sinon
      							produitclient.iprixa = 0
      							ProduitClient.IPrixm = 0
      							ProduitClient.IPrixCarrPiedCarre = 0
      							ProduitClient.IPrixCarrMetCarre  = 0
      						fin
      
      						produitClient.IdClient           = fenclienttrn.numero
      						produitClient.Idproruit          = table_1.pproduit[i]
      						//						ProduitClient.IPrixa             = table_1.pprixa[i]
      						//						ProduitClient.IPrixm             = table_1.pprixm[i]
      						//						ProduitClient.IPrixCarrPiedCarre = table_1.PrixCarrPC[i]
      						//						ProduitClient.IPrixCarrMetCarre  = table_1.PrixCarrM[i]
      						produitclient.IlisteDePrix = table_1.Cimprime[i]
      						produitclient.IPprixSpecial = table_1.Cspecial[i]
      						produitclient.ITypeProduit = table_1.Ptype[i]
      						produitclient.icategorie = invent.icategorie
      						hajoute(produitClient)
      
      
      					FIN
      				sinon
      					clederecherche = HConstruitValClé(produitClient,IdClientIdproruit,fenclienttrn.numero,table_1.pproduit[i])
      					si hlitrecherche(produitclient,IdClientIdproruit,clederecherche,hIdentique) alors
      						//						si pas produitclient.IListePrixpeinture et pas produitclient.IPrixSpecialPeinture alors
      						HSupprime(ProduitClient,hnumenrencours)
      						//						fin
      
      					fin 
      				FIN
      
      			cas 5            // Peinture
      
      				//				si table_1.PPRIXA[i] <> invent.iprixunitaire ou table_1.PPRIXm[i] <> invent.iprixunitem  alors
      				si table_1.Cimprime[i] ou table_1.Cspecial[i] alors
      
      					clederecherche = HConstruitValClé(produitClient,IdClientIdproruit,fenclienttrn.numero,table_1.pproduit[i])
      					si hlitrecherche(produitclient,IdClientIdproruit,clederecherche,hIdentique) alors
      						si table_1.cspecial[i] alors
      							produitclient.iprixa = table_1.PPRIXA[i]
      							ProduitClient.IPrixm = table_1.pprixm[i]
      						sinon
      							produitclient.iprixa = 0
      							ProduitClient.IPrixm = 0
      						fin
      
      						//						ProduitClient.IPrixa = table_1.pprixa[i]
      						//						ProduitClient.IPrixm = table_1.pprixm[i]
      						produitclient.IlisteDePrix = table_1.Cimprime[i]
      						produitclient.IPprixSpecial = table_1.Cspecial[i]
      						produitclient.ITypeProduit = table_1.Ptype[i]
      						produitclient.icategorie = invent.icategorie
      						hmodifie(produitClient,hNumEnrEnCours)
      					sinon
      
      						si table_1.cspecial[i] alors
      							produitclient.iprixa = table_1.PPRIXA[i]
      							ProduitClient.IPrixm = table_1.pprixm[i]
      						sinon
      							produitclient.iprixa = 0
      							ProduitClient.IPrixm = 0
      						fin
      						produitClient.IdClient = fenclienttrn.numero
      						produitClient.Idproruit = table_1.pproduit[i]
      						//						ProduitClient.IPrixa = table_1.pprixa[i]
      						//						ProduitClient.IPrixm = table_1.pprixm[i]
      						produitclient.IlisteDePrix = table_1.Cimprime[i]
      						produitclient.IPprixSpecial = table_1.Cspecial[i]
      						produitclient.ITypeProduit = table_1.Ptype[i]
      						produitclient.icategorie = invent.icategorie
      						hajoute(produitClient)
      
      					fin 
      				sinon
      //					clederecherche = HConstruitValClé(produitClient,IdClientIdproruit,fenclienttrn.numero,table_1.pproduit[i])
      					
      					si hlitrecherche(produitclient,IdClientIdproruit,[fenclientTRN.numero,TABLE_1.PPRODUIT[i]],hIdentique) alors
      						HSupprime(ProduitClient,hnumenrencours)
      					fin 
      
      				FIN
      		FIN
      
      
      
      
      	FIN
      fin
      
     type : 458752
   -
     name : maj_table_variableX
     procedure_id : 5858940824907723947
     type_code : 14
     code : |1+
      Procédure maj_table_variableX()
      clederecherche est une chaine
      i est un entier
      pour i = 1 a TableOccurrence(tablevariablex)
      	si hlitrecherche(typecarr,tcdescription,TableVariableX.Type_de_calcul[i]) alors 
      //		si TableVariableX.VariableX[i] <> typecarr.VariableUtil  ou TableVariableX.VariableX1[i] <> typecarr.VariableUtil1 alors
                  
      			clederecherche = HConstruitValClé(VariableXclient,noClientTypeCalcul,fenclienttrn.numero,TableVariableX.Type_de_calcul[i])
      			si hlitrecherche(VariableXclient,noClientTypeCalcul,clederecherche,hIdentique) alors
      	
      				VariableXclient.VariableX = TableVariableX.VariableX[i]
      				VariableXclient.VariableX1 = TableVariableX.VariableX1[i]
      				hmodifie(VariableXclient,hNumEnrEnCours)
      			sinon
      
      				VariableXclient.noClient = fenclienttrn.numero
      				VariableXclient.TypeCalcul= TableVariableX.Type_de_calcul[i]
      				VariableXclient.VariableX = TableVariableX.VariableX[i]
      				VariableXclient.VariableX1 = TableVariableX.VariableX1[i]
      				hajoute(VariableXclient)
      				
      
      			FIN
      //		FIN
      	FIN
      	
      	
      FIN
      
      
