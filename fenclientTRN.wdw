    type : 16
    controls : []
    code_elements :
     type_code : 24
     p_codes :
      -
        code : |1+
         //  test de gds
         
        type : 235
      -
        code : |1+
         LIGNETABLE EST UN ENTIER
         si cli_onglet = 1 alors
         	//Code WinDev 5.5 remplacé par la migration :
         	//	identifiant..VISIBLE = FAUX
         	BTN_Prix..visible = faux
         	BTN_INTEGRITE..visible = faux
         	identifiant..Visible=Faux
         	//Code WinDev 5.5 remplacé par la migration :
         	//	navigation..etat = GRISé
         	navigation..etat = GRISé; navigation..Visible=Vrai
         	BTN_AJOUT..etat = actif
         	BTN_IMPRIME..visible = vrai
         	//Code WinDev 5.5 remplacé par la migration :
         	//	tableaffiche("TABLE","P")
         	//	_client est une chaine = table.NUMERO_1[table]
         
         	selon SelClient
         		cas 1,2
         			hfiltre(client,"cetat="+SelClient)
         			hlitrecherche(client,numero,client.numero)
         			tantque client.cetat <> selclient
         				HLitSuivant(client,numero)
         			FIN
         		autre cas
         			HDésactiveFiltre(client)
         
         	FIN
         
         	TableAffiche(table,taCourantbandeau)
         	exécuteTraitement(table,trtSélection)
         
         sinon
         	BTN_Prix..visible = vrai
         
         	si pas modif alors
         		fichierversecran
         		//Code WinDev 5.5 remplacé par la migration :
         		//	 navigation..etat = actif	
         		navigation..etat = actif; navigation..Visible=Vrai	
         	fin
         	//Code WinDev 5.5 remplacé par la migration :
         	//	identifiant..etat = inactif
         	identifiant..etat = AffichageSeulement; identifiant..Visible=Vrai
         	BTN_AJOUT..etat = grise
         	BTN_IMPRIME..visible = faux
         	BTN_INTEGRITE..visible = vrai
         	selon cli_onglet 
         		cas 2
         			ecranpremier("SSECTEUR")
         
         		cas 3
         			ExecuteTraitement(table_1,trtSélection)
         
         		cas 4
         			ExecuteTraitement(Table_Extra,trtSélection)
         			
         		cas 5
         			ExecuteTraitement("table1",trtENTREELIGNE)
         
         		cas 6
         			//Code WinDev 5.5 remplacé par la migration :
         			//      execute("table_6..len")
         			hfiltre(InterClient,iDClient,client.idclient)
         			tableaffiche(table_2)
         			si pas table_2..vide alors
         				ExecuteTraitement("table_2",trtENTREELIGNE)
         			sinon
         			    hfiltre(InterClientDetail,IdInterClient,0)
         			    tableaffiche(Table_InterClientDetail,taDébut)
         			FIN
         
         		cas 7
         			//Code WinDev 5.5 remplacé par la migration :
         			//      execute("table_10..len")
         			ExecuteTraitement("table_10",trtENTREELIGNE)
         			// ecranpremier("PRIX_AJOUT_2")
         			//tableaffiche("TABLE_1")
         
         		cas 8
         			ExecuteTraitement(TableVariableX,trtEntréeLigne)
         			tableselectplus(TableVariableX,1)
         			//			reprisesaisie(TableVariableX)
         
         		cas 9
         			ExecuteTraitement(TableCouleurExtra,trtEntréeLigne)
         			tableselectplus(TableCouleurExtra,1)
         			//			reprisesaisie(TableVariableX)
         
         	fin  
         fin
         
         maj_ficheclient()
         
        type : 17
