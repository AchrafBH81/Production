                        	si hlitrecherche(invent,INUM,OngletPrixSpeciaux.table_1.PPRODUIT[table_1]) alors
                        		selon table_1.Ptype[table_1]
                        			cas 1
                        				table_1.PPRIXA[table_1] = invent.iprixunite
                        			cas 2
                        				table_1.PPRIXA[table_1] = invent.IPRIXunitaire
                        				table_1.PPRIXm[table_1] = invent.IPRIXunitem
                        
                        			cas 4
                        				table_1.PPRIXA[table_1] = invent.IPRIXcarreau
                        				table_1.PPRIXm[table_1] = invent.iprixbasecarrelage
                        			cas 5	
