      //TABLEAFFICHE(TABLE_1,taDébut)
     type : 458752
   -
     name : maj_table_peinture
     procedure_id : 5858940825191560363
     type_code : 14
     code : |1+
      Procédure maj_table_peinture()
      
      clederecherche est une chaine
      i est un entier
      pour i = 1 a TableOccurrence(tablepeinture)
      	si hlitrecherche(invent,INUM,tablepeinture.PPRODUIT[i]) alors 
      		si tablepeinture.Cimprime[i] ou tablepeinture.Cspecial[i] alors
      
      			clederecherche = HConstruitValClé(produitClient,IdClientIdproruit,fenclienttrn.numero,tablepeinture.pproduit[i])
      
      			si hlitrecherche(produitclient,IdClientIdproruit,clederecherche,hIdentique) alors
      				si tablepeinture.cspecial[i] alors
      					produitclient.ipricxcarreauPeinture= tablepeinture.PPRIXp[i]
      				sinon
      					produitclient.ipricxcarreauPeinture = 0
      				fin
      				produitclient.IListePrixpeinture = tablepeinture.Cimprime[i]
      				produitclient.IPrixSpecialPeinture = tablepeinture.Cspecial[i]
      				hmodifie(produitClient,hNumEnrEnCours)
      			sinon
      				si tablepeinture.cspecial[i] alors
      					produitclient.ipricxcarreauPeinture= tablepeinture.PPRIXp[i]
      				sinon
      				produitclient.ipricxcarreauPeinture= 0
      				fin
      
      				produitClient.IdClient           = fenclienttrn.numero
      				produitClient.Idproruit          = tablepeinture.pproduit[i]
      				produitclient.IListePrixpeinture = tablepeinture.Cimprime[i]
      				produitclient.IPrixSpecialPeinture = tablepeinture.Cspecial[i]
      				hajoute(produitClient)
      
      
      			FIN
      		sinon
      		
      			clederecherche = HConstruitValClé(produitClient,IdClientIdproruit,fenclienttrn.numero,tablepeinture.pproduit[i])
      			si hlitrecherche(produitclient,IdClientIdproruit,clederecherche,hIdentique) alors
      			  si pas produitclient.IlisteDePrix et pas produitclient.IPprixSpecial alors
      				HSupprime(ProduitClient,hnumenrencours)
      			fin
      			fin 
      		FIN
      	fin
      fin
      
     type : 458752
   -
     name : remplir_table_forme
     procedure_id : 5858940823652119723
     type_code : 14
     code : |1-
      Procédure remplir_table_forme()
      tablesupprimetout(tableforme)
      hlitpremier(forme,fnumero)
      tantque pas hendehors(forme)
      			TABLEAJOUTELIGNE(Tableforme,forme.fnumero,forme.fdescription,...
      			forme.extradouble,forme.extratriple)
      	        hlitsuivant(forme)
      FIN
      
      
      
      //TABLEAFFICHE(TABLE_1,taDébut)
     type : 458752
   -
     name : maj_table_forme
     procedure_id : 5858940824474596523
     type_code : 14
     code : |1+
      Procédure maj_table_forme()
      
      clederecherche est une chaine
      i est un entier
      pour i = 1 a TableOccurrence(tableforme)
      	si hlitrecherche(forme,fnumero,tableforme.fforme[i]) alors 
      
      		si tableforme.fimprime[i] ou tableforme.fspecial[i] alors
      
      			clederecherche = HConstruitValClé(formeclient,IdClientNoForme,fenclienttrn.numero,tableforme.fforme[i])
      			si hlitrecherche(formeclient,IdClientnoforme,clederecherche,hIdentique) alors
      				si tableforme.fspecial[i] alors
      					formeclient.fPrixdouble = tableforme.fPrixdouble[i]
      					formeclient.fPrixtriple = tableforme.fPrixtriple[i]
      				sinon
      					formeclient.fPrixdouble = 0
      					formeclient.fPrixtriple = 0
      				fin
      
      				formeclient.flistePrix = tableforme.fimprime[i]
      				formeclient.fPrixSpecial = tableforme.fspecial[i]
      				hmodifie(formeclient,hNumEnrEnCours)
      			sinon
      
      				si tableforme.fspecial[i] alors
      					formeclient.fPrixdouble = tableforme.fPrixdouble[i]
      					formeclient.FpRixtriple = tableforme.fprixtriple[i]
      				sinon
      					formeclient.fPrixdouble = 0
      					formeclient.FpRixtriple = 0
      				fin
      				formeclient.NoClient = fenclienttrn.numero
      				formeclient.NoForme = tableforme.fForme[i]
      				//						formeclient.IPrixa = tableforme.pprixa[i]
      				//						formeclient.IPrixm = tableforme.pprixm[i]
      				formeclient.fListePrix = tableforme.fimprime[i]
      				formeclient.fPrixSpecial = tableforme.fspecial[i]
      				hajoute(formeclient)
      			fin 
      	
      		sinon
      
      			clederecherche = HConstruitValClé(formeclient,IdClientNoForme,fenclienttrn.numero,tableforme.fForme[i])
      			si hlitrecherche(formeclient,IdClientNoForme,clederecherche,hIdentique) alors
      				HSupprime(formeclient,hnumenrencours)
      			fin 
      
      		FIN
      
      
      
      	fin
      fin
      
      
      
      
      
      
     type : 458752
   -
     name : remplir_table_Couleur
     procedure_id : 5858940823842960555
