               si tableselect(table_clientgarantie) <> -1 alors
               	if Table_ClientGarantie.IsDeleted[tableselect(table_clientgarantie)] alors
               		Table_ClientGarantie[tableselect(table_clientgarantie)]..police = PoliceCrée("Arial",8,ibarre)
               	sinon
               		Table_ClientGarantie[tableselect(table_clientgarantie)]..police = PoliceCrée("Arial",8)
               	END
               fin
