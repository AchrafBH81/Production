              type_code : 5
              p_codes :
               -
                 code : |1-
                  si moimeme alors
                  
                  sinon
                  	si  hlitrecherche(invent,INUM,table_extra.PPRODUIT[table_extra]) alors
                  		si invent.ibase alors
                  			Table_Extra.PPRIXD[table_extra] = invent.IPRIXDOUBLE
                  			Table_Extra.PPRIXT[table_extra] = invent.IPRIXtriple
                  			Table_Extra.PPRIXDM[table_extra] = invent.IPRIXDOUBLEM
                  			Table_Extra.PPRIXTM[table_extra] = invent.IPRIXtriplem
                  		sinon
                  			Table_Extra.PPRIXD[table_extra] = invent.IPRIXA
                  			Table_Extra.PPRIXDM[table_extra] = invent.IPRIXM
                  
                  		FIN
                  	FIN
                  FIN
                  si pas table_extra.cModifiable[table_extra] alors
                  	Table_Extra.Cspecial[Table_Extra] = pas moimeme
                  FIN
                 type : 17
