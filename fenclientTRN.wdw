   -
     name : recalculPrixThermos
     procedure_id : 5858940824083412139
     type_code : 14
     code : |1-
      Procédure recalculPrixThermos(_IDclient,NoThermos)
      
      resultat est un reel = 0
      NbThermos est un entier = 0
      Extra est une chaine
      ExtraT est une chaine
      PrixTotal est un reel = 0
      PrixTotalM est un reel = 0
      special est un booleen = faux
      
      
      
      RequeteClientThermos.pClient1 = client.numero
      RequeteClientThermos.pClient2 =client.numero
      RequeteClientThermos.pClient3 = client.numero
      requeteClientThermos.pClient4 = client.numero
      RequeteClientThermos.pExtra1 = NoThermos
      RequeteClientThermos.pExtra2 = NoThermos
      RequeteClientThermos.pExtra3 = NoThermos
      RequeteClientThermos.pbase = NoThermos
      HExécuteRequête(RequeteClientThermos,hModifieFichier)
      
      
      pour tout RequeteClientThermos
      	PrixTotal = 0
      	PrixTotalM = 0
      	special = faux
      	NbThermos=0
      	si hlitrecherche(persoens,ennumero,RequeteClientthermos.IdThermos) ALORS
      		si sansespace(persoens.encomposant1) <> "" alors
      			NbThermos++
      
      
      			si hlitrecherche(invent,INUM,persoens.encomposant1)  alors
      				si pas invent.ibase alors
      					Extra = invent.ipextra
      					ExtraT = invent.ipextrat
      					si hlitrecherche(FclientExtra,IdClientNoProduit,HConstruitValClé(FclientExtra,IdClientNoProduit,sansespace(_IDclient),sansespace(Extra))) et fclientextra.prixSpecial ALORS
      						PrixTotal+=FclientExtra.PrixAnglais
      						PrixTotalM+=FclientExtra.Prixmetrique
      						special=vrai
      					sinon
      						si hlitrecherche(invent,INUM,Extra) alors
      							PrixTotal+= arrondi(invent.IPRIXA,2)
      							PrixTotalM+= arrondi(invent.iprixm,2)
      						FIN
      					fin	
      					si hlitrecherche(FclientExtra,IdClientNoProduit,HConstruitValClé(FclientExtra,IdClientNoProduit,_IDclient,sansespace(ExtraT)))  et fclientextra.prixSpecial ALORS
      						PrixTotal+=FclientExtra.PrixAnglais
      						PrixTotalM+=FclientExtra.Prixmetrique
      						special=vrai
      					sinon
      						si hlitrecherche(invent,INUM,ExtraT) alors
      							PrixTotal+= arrondi(invent.IPRIXA,2)
      							PrixTotalM+= arrondi(invent.IPRIXm,2)
      						FIN
      					fin
      				fin
      
      
      			fin
      
      		Fin
      
      		si sansespace(persoens.encomposant2) <> "" alors
      			NbThermos++
      
      			si hlitrecherche(invent,INUM,persoens.encomposant2)  alors
      				si pas invent.ibase alors
      					Extra = invent.ipextra
      					ExtraT = invent.ipextrat
      					si hlitrecherche(FclientExtra,IdClientNoProduit,HConstruitValClé(FclientExtra,IdClientNoProduit,_IDclient,sansespace(Extra))) et fclientextra.prixSpecial ALORS
      						PrixTotal+=FclientExtra.PrixAnglais
      						PrixTotalM+=FclientExtra.Prixmetrique
      						special=vrai
      					sinon
      						si hlitrecherche(invent,INUM,Extra) alors
      							PrixTotal+= arrondi(invent.IPRIXA,2)
      							PrixTotalM+=arrondi(invent.IPRIXm,2)
      						FIN
      					fin
      					si hlitrecherche(FclientExtra,IdClientNoProduit,HConstruitValClé(FclientExtra,IdClientNoProduit,_IDclient,sansespace(ExtraT))) et fclientextra.prixSpecial ALORS
      						PrixTotal+=FclientExtra.PrixAnglais
      						PrixTotalM+=FclientExtra.Prixmetrique
      						special=vrai
      					sinon
      
      						si hlitrecherche(invent,INUM,ExtraT) alors
      							PrixTotal+= arrondi(invent.IPRIXA,2)
      							PrixTotalM+= arrondi(invent.IPRIXm,2)
      						FIN
      					fin
      				fin
      
      			fin
      
      		Fin
      
      
      		si sansespace(persoens.encomposant3) <> "" alors
      			NbThermos++
      
      			si hlitrecherche(invent,INUM,persoens.encomposant3)  alors
      				si pas invent.ibase alors
      					Extra = invent.ipextra
      					ExtraT = invent.ipextrat
      					si hlitrecherche(FclientExtra,IdClientNoProduit,HConstruitValClé(FclientExtra,IdClientNoProduit,_IDclient,sansespace(Extra))) et fclientextra.prixSpecial ALORS
      						PrixTotal+=FclientExtra.PrixAnglais
      						PrixTotalM+=FclientExtra.Prixmetrique
      						special=vrai
      					sinon
      						si hlitrecherche(invent,INUM,Extra) alors
      							PrixTotal+= arrondi(invent.IPRIXA,2)
      							PrixTotalM+= arrondi(invent.IPRIXm,2)
      						FIN
      					fin
      					si hlitrecherche(FclientExtra,IdClientNoProduit,HConstruitValClé(FclientExtra,IdClientNoProduit,_IDclient,sansespace(ExtraT))) et fclientextra.prixSpecial ALORS
      						PrixTotal+=FclientExtra.PrixAnglais
      						PrixTotalM+=FclientExtra.Prixmetrique
      					sinon
      
      						si hlitrecherche(invent,INUM,ExtraT) alors
      							PrixTotal+= arrondi(invent.IPRIXA,2)
      							PrixTotalM+= arrondi(invent.IPRIXm,2)
      							special=vrai
      						FIN
      					fin
      				fin
      
      
      			fin
      
      		Fin
      
      		si hlitrecherche(FclientExtra,IdClientNoProduit,HConstruitValClé(FclientExtra,IdClientNoProduit,_IDclient,sansespace(persoens.epbase))) et fclientextra.prixSpecial ALORS
      			special=vrai
      			si NbThermos = 2 alors
      				PrixTotal+= arrondi(FclientExtra.PrixAnglaisD,2)
      				PrixTotalM+= arrondi(FclientExtra.PrixmetriqueD,2)
      			sinon si NbThermos = 3
      				PrixTotal+= arrondi(fclientextra.PrixAnglaisT,2)
      				PrixTotalM+= arrondi(fclientextra.PrixMetriqueT,2)
      			FIN
      		sinon
      			si hlitrecherche(invent,INUM,persoens.epbase) alors
      				si  NbThermos = 2  alors
      					PrixTotal+= arrondi(invent.IPRIXDOUBLE,2)
      					PrixTotalM+= arrondi(invent.IPRIXDOUBLEM,2)
      				sinon si  NbThermos = 3 
      					PrixTotal+= arrondi(invent.iprixtriple,2)
      					PrixTotalM+= arrondi(invent.iprixtripleM,2)
      
      				FIN
      			fin
      		FIN
      		//fin
      	fin
      	si hlitrecherche(ThermosClient,IdClientIdhermos,HConstruitValClé(ThermosClient,IdClientIdhermos,RequeteClientThermos.IdClient,RequeteClientThermos.IdThermos)) alors
      		thermosclient.Tprixa = PrixTotal
      		thermosclient.TprixM = PrixTotalM
      		thermosclient.prixSpecial = special
      		hmodifie(thermosclient,hnumenrencours)
      
      	fin
      
      fin
      
      
      renvoyer NumériqueVersChaine(PrixTotal)+","+numeriqueverschaine(PrixTotalM) + "," + special
     type : 458752
   -
     name : CalculPrixExtra
     procedure_id : 5858940825112261803
     type_code : 14
     code : |1-
      Procédure CalculPrixExtra(_numero)
      _extra est une chaine
      _extrat est une chaine
      _prixa est un reel = 0
      _prixm est un reel = 0
      _special est un booleen = faux
      _modifiable est un booleen
      
      
      si hlitrecherche(invent,INUM,_numero) ALORS
      	_extra = invent.ipextra
      	_extrat = invent.ipextrat
      	si sansespace(_extra) <> "" 
      		si _extra <> _numero alors
      			_modifiable = faux
      			si hlitrecherche(FclientExtra,IdClientNoProduit,HConstruitValClé(FclientExtra,IdClientNoProduit,client.IDClient,sansespace(_extra))) et FclientExtra.prixSpecial alors
      				_special = vrai
      				_prixa+= FclientExtra.PrixAnglais
      				_prixm+= FclientExtra.PrixMetrique
      			sinon
      				si hlitrecherche(invent,INUM,_extra) alors
      					_prixa+= invent.IPRIXA
      					_prixm+= invent.IPRIXm
      				fin
      			fin
      		sinon
      			_prixa+= invent.IPRIXA
      			_prixm+= invent.IPRIXm
      		FIN
      	fin
      
      	si sansespace(_extrat) <> ""  alors
      		si _extrat <> _numero alors
      			_modifiable = faux
      			si hlitrecherche(FclientExtra,IdClientNoProduit,HConstruitValClé(FclientExtra,IdClientNoProduit,client.IDClient,sansespace(_extrat)))  et FclientExtra.prixSpecial  alors
      				_special = vrai
      				_prixa+= FclientExtra.PrixAnglais
      				_prixm+= FclientExtra.PrixMetrique
      			sinon
      				si  hlitrecherche(invent,INUM,_extrat) alors
      					_prixa+= invent.IPRIXA
      					_prixm+= invent.IPRIXm
      				fin
      			fin
      		sinon
      			_prixa+= invent.IPRIXA
      			_prixm+= invent.IPRIXm
      		fin
      	fin
      FIN
      
      
      renvoyer NumériqueVersChaine(_prixa, "10.2f")+","+NumériqueVersChaine(_prixm, "10.2f") + ","+_special+","+_modifiable
     type : 458752
   -
     name : remplirTableGarantie
     procedure_id : 5858940825076675755
     type_code : 14
     code : |1+
      Procédure remplirTableGarantie()
      tablesupprimetout(Table_ClientGarantie)
      RequeteClientGarantie.pIdClient = client.IDClient
      HExécuteRequête(RequeteClientGarantie)
      
      pour tout requeteclientgarantie
      	tableajouteligne(Table_ClientGarantie,RequeteClientGarantie.numero,RequeteClientGarantie.Description,RequeteClientGarantie.date,...
      	RequeteClientGarantie.IDClientGarantie,RequeteClientGarantie.Idgarantie,0,RequeteClientGarantie.DateFin)
      FIN
     type : 458752
   -
     name : maj_table_garantie
     procedure_id : 5858940823952733355
     type_code : 14
     code : |1+
      Procédure maj_table_garantie()
      i est un entier
      pour i = 1 a TableOccurrence(table_clientgarantie)
      	si pas Table_ClientGarantie.IsDeleted[i]
      		si Table_ClientGarantie.idclientgarantie[i] = 0 alors
      			ClientGarantie.IDclient = client.IDClient
      			ClientGarantie.Idgarantie = Table_ClientGarantie.idGarantie[i]
      			ClientGarantie.date = Table_ClientGarantie.date[i]
      			ClientGarantie.datefin = Table_ClientGarantie.datefin[i]
      			hajoute(ClientGarantie)
      		sinon
      			si hlitrecherche(ClientGarantie,IDClientGarantie,Table_ClientGarantie.idclientgarantie[i]) alors
      				ClientGarantie.Idgarantie = Table_ClientGarantie.idGarantie[i]
      				ClientGarantie.date = Table_ClientGarantie.date[i]
      				ClientGarantie.datefin = Table_ClientGarantie.datefin[i]
      				hmodifie(ClientGarantie,hNumEnrEnCours)
      			fin
      
      		FIN
      	sinon
      		si Table_ClientGarantie.idclientgarantie[i] <> 0 alors
      			si hlitrecherche(ClientGarantie,IDClientGarantie,Table_ClientGarantie.idclientgarantie[i])
                      hsupprime(ClientGarantie,hNumEnrEnCours)
      			fin
      
      		FIN
      	fin
      fin
      
      
     type : 458752
   -
     name : calculTotalCommande
     internal_properties : CQAAAAkAAAD9LujFHGYff7uwyuzBJhDnM3Up5yS44njO7f5BeuFBga2ErE0REGK1dTzUS7O/+vlrPmxg24tQcdhnfU37z2M3GVQZOfqR
     procedure_id : 1796954002833640941
     type_code : 14
     code : |1+
      Procédure calculTotalCommande(lidClient est un entier)
      totalquantite est un reel = 0
      _totalcommande est un reel = 0
      totaldejafacture est un reel = 0
      lbonlivraison est un booleen
      _mult est un entier 
      tottps est un reel
      tottvq est un reel
      totalLigne est un reel
      lQteAjuste est un reel
      //SI MODIF ALORS
      
      
      RequeteCommandePourLimite.PIdClient = lidClient
      RequeteCommandePourLimite.pNoComm = null
      si pas HExécuteRequête(RequeteCommandePourLimite)  ALORS
      	erreur("Erreur lors de l'exécution de la requete")
      	renvoyer 0
      FIN
      
      
      
      
      
      Pour TOUT RequeteCommandePourLimite 
      	totalLigne = 0
      	lbonlivraison = (RequeteCommandePourLimite.FPREPARATION = "B" )
      	lQteAjuste = lbonlivraison ? 1 sinon requetecommandepourlimite.fdqteafacturer / requetecommandepourlimite.fdqte
      	_mult = requetecommandepourlimite.fatypedocument = 2 ? -1 sinon 1
      	selon requetecommandepourlimite.ftype
      		cas 1
      			totalLigne+=((arrondi(requetecommandepourlimite.fdprixtotal,2)+arrondi(requetecommandepourlimite.surchargeenergie,2)) ) + ((requetecommandepourlimite.FDextra10X+requetecommandepourlimite.FDextra5x))
      		cas 2
      			totalLigne+=((arrondi(requetecommandepourlimite.fdprixtotal,2)+arrondi(requetecommandepourlimite.surchargeenergie,2)) ) + ((requetecommandepourlimite.FDextra10X+requetecommandepourlimite.FDextra5x))
      		cas 3
      			totalLigne+=(arrondi(requetecommandepourlimite.fdprixtotal,2)) 
      		cas 4
      			totalLigne+=(arrondi(requetecommandepourlimite.fdprixtotal,2)) 
      			si requetecommandepourlimite.fpeinture alors
      				totalLigne+=(arrondi(requetecommandepourlimite.fTotalPeinture,2)) * requetecommandepourlimite.fdqteafacturer
      			fin
      		cas 5
      			totalLigne+=(arrondi(requetecommandepourlimite.fdprixtotal,2)) 
      			
      	FIN
      	tottps = Arrondi(totalLigne * RequeteCommandePourLimite.fatps / 100 ,2)
      	tottvq = Arrondi(totalLigne * RequeteCommandePourLimite.fatvq / 100 ,2)
      	
      	_totalcommande+= (( totalLigne + tottps + tottvq ) * _mult) 
      	
      	
      fin		 
      
      TxtSql = "select distinct fdnocomm from RequeteCommandePourLimite"
      reqsql1 est une source de donnees
      si HExécuteRequêteSQL(reqsql,hRequêteDéfaut,txtsql) alors
      	TxtSql = [
      		select BStotal+btps+btvq as totalfacture from bonlivraison
      		inner join  hfacture on bonlivraison.bnumero = hfacture.fanofacture 
      		where hfacture.fanumero ='%1'
      	]
      	pour tout reqsql
      		
      		
      		si HExécuteRequêteSQL(reqsql1,hRequêteDéfaut,ChaîneConstruit(TxtSql,reqsql.fdnocomm)) alors
      			pour TOUT reqsql1 
      				totaldejafacture+=reqsql1.totalfacture
      			FIN
      		fin
      	fin
      	
      sinon
      	info(herreurinfo())
      FIN
      renvoyer _totalcommande-totaldejafacture
      
      
      
      
     type : 458752
   -
     name : AfficherJourLivraisonPourUnMois
     procedure_id : 2086299949489036219
     type_code : 14
     code : |1-
      PROCEDURE AfficherJourLivraisonPourUnMois()
      
      UneDate est une date = CalendrierPosition(CalendrierLivraison)
      
      UneDate..Jour = 31
      
      LeNombreDeJour est un entier = UneDate..jour
      
      
      
      jliv est un entier = 21
      
      
      i est entier
      
      //POUR i = 1 A 7
      //	SI jliv & Puissance(2,i-1) > 0 ALORS
      //		JoursLivraison[i] = Vrai
      //	SINON
      //		JoursLivraison[i] = Faux
      //	FIN
      //FIN
      
      UneDate..Jour = 1
      
      POUR i = 1 A LeNombreDeJour
      	UneDate..Jour = i
      	SI EstJourFerie(UneDate) ALORS
      		CalendrierLivraison[UneDate]..CouleurFond = iRougeClair
      		CalendrierLivraison[UneDate]..Couleur = iBlanc
      		CONTINUER
      	FIN	
      	SI PAS JoursLivraison[DateVersJour(UneDate)] _ET_ PAS JoursLivraison[DateVersJour(UneDate)]..Etat = Actif ALORS
      		CalendrierLivraison[UneDate]..CouleurFond = iGrisClair
      		CONTINUER
      	FIN
      	SI SaiFrequence > 1 ALORS
      		SI modulo(DateDifférence(PremierJourDeLaSemaine(saiDateReference),PremierJourDeLaSemaine(UneDate)),saiFrequence*7) <> 0
      			
      			//		si modulo(NoSemaine,Frequence) <> NoRefLocal alors
      			CalendrierLivraison[UneDate]..CouleurFond = iTransparent
      			CONTINUER
      			
      		FIN
      	FIN
      	
      	
      	SI JoursLivraison[DateVersJour(UneDate)] ALORS
      		CalendrierLivraison[UneDate]..CouleurFond = VertClair
      	SINON si JoursLivraison[DateVersJour(UneDate)]..etat = actif 
      		CalendrierLivraison[UneDate]..CouleurFond = iTransparent
      	sinon
      		CalendrierLivraison[UneDate]..CouleurFond = iGrisClair
      		
      	FIN
      	
      	
      	
      	
      FIN
     type : 458752
   -
     name : GetInfoLivraison
     procedure_id : 2134850869318061911
     type_code : 14
     code : |1-
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //GetInfoLivraison (<_IDClient>)
      //
      // Paramètres :
      // 	_IDClient : <indiquez ici le rôle de _IDClient>
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE GetInfoLivraison(_IDClient)
      
      TAjourlivraisonsaison.SupprimeTout()
      TAFrequence.SupprimeTout()
      _stjourlivraison est un stJoursLivraison
      
      //HLitRecherchePremier(JourLivraisonClient,IdAdresseLivraison,_IDClientLivraison)
      pour CHAQUE SaisonLivraison 
      	_stjourlivraison = allouer un stLivraison
      	TAjourlivraisonsaison[SaisonLivraison.IDSaisonLivraison] = _stjourlivraison
      	HLitRecherche(JourLivraisonClient,IDClientIDSaisonLivraison,[_IDClient,SaisonLivraison.IDSaisonLivraison]) 
      	TANTQUE JourLivraisonClient.IDClient = _IDClient _ET_ JourLivraisonClient.IdAdresseLivraison = 0 _et_ PAS HEnDehors(JourLivraisonClient)
      		
      		_stjourlivraison.JoursLivraisonClientCompile = JourLivraisonClient.JourLivraison
      		POUR i = 1 a 7
      			_stjourlivraison.tabJourLivraisonCamion[i] = JourLivraisonClient.IDCamions[i]
      			_stjourlivraison.tabShippingSequence[i] = JourLivraisonClient.ShippingSequence[i]
      		FIN
      		
      		TAjourlivraisonsaison[JourLivraisonClient.IDSaisonLivraison] = _stjourlivraison
      		HLitSuivant(JourLivraisonClient)
      	FIN
      	HLitRecherche(ClientLivraisonFrequence,IDClientLivraison,_IDClient)
      	TANTQUE ClientLivraisonFrequence.IDClientLivraison = _IDClient _ET_ PAS HEnDehors(ClientLivraisonFrequence)
      		_frequence est un stFrequence = allouer un stfrequence
      		_frequence.Frequence = ClientLivraisonFrequence.Frequence
      		_frequence.DateDeReference = ClientLivraisonFrequence.DateDeReference
      		TAFrequence[ClientLivraisonFrequence.IDSaisonLivraison] = _frequence
      		HLitSuivant(ClientLivraisonFrequence)
      	FIN
      FIN
      
      //TANTQUE JourLivraisonClient.IdAdresseLivraison = _IDClientLivraison _ET_ PAS HEnDehors(JourLivraisonClient)
      //	_stjourlivraison est un stJoursLivraison
      //	_stjourlivraison.JoursLivraisonClientCompile = JourLivraisonClient.JourLivraison
      //	POUR i = 1 a 7
      //		_stjourlivraison.tabJourLivraisonCamion[i] = JourLivraisonClient.IDCamions[i]
      //	FIN
      //	TAjourlivraisonsaison[JourLivraisonClient.IDSaisonLivraison] = _stjourlivraison
      //	HLitSuivant(JourLivraisonClient,IdAdresseLivraison)
      //FIN
      //
      //HLitRecherche(ClientLivraisonFrequence,IDClientLivraison,_IDClientLivraison)
      //TANTQUE ClientLivraisonFrequence.IDClientLivraison = _IDClientLivraison _ET_ PAS HEnDehors(ClientLivraisonFrequence)
      //	_frequence est un stFrequence = allouer un stfrequence
      //	_frequence.Frequence = ClientLivraisonFrequence.Frequence
      //	_frequence.DateDeReference = ClientLivraisonFrequence.DateDeReference
      //	TAFrequence[ClientLivraisonFrequence.IDSaisonLivraison] = _frequence
      //	HLitSuivant(ClientLivraisonFrequence)
      //FIN
     type : 458752
   -
     name : SaveFrequence
     procedure_id : 2135224428366551966
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //SaveFrequence (<_IDClientLivraison>)
      //
      // Paramètres :
      //	_IDClientLivraison : <indiquez ici le rôle de _IDClientLivraison>
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE SaveFrequence(_IDClientLivraison)
      
      pour chaque _frequence,id de TAFrequence
      	si hlitrecherche(ClientLivraisonFrequence,IDClientLivraisonIDSaisonLivraison,[_IDClientLivraison,id]) alors
      		ClientLivraisonFrequence.Frequence = _frequence.Frequence
      		ClientLivraisonFrequence.DateDeReference = _frequence.DateDeReference
      		hmodifie(ClientLivraisonFrequence,hNumEnrEnCours)
      	sinon
      		hraz(ClientLivraisonFrequence)
      		ClientLivraisonFrequence.IDClientLivraison = _IDClientLivraison
      		ClientLivraisonFrequence.IDSaisonLivraison = id
      		ClientLivraisonFrequence.Frequence = _frequence.Frequence
      		ClientLivraisonFrequence.DateDeReference = _frequence.DateDeReference
      		
      		hajoute(ClientLivraisonFrequence)	
      	FIN
      FIN
      
      
     type : 458752
   -
     name : SaveJourCamion
     procedure_id : 2135224432661585501
     type_code : 14
     code : |1-
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //SaveJourCamion (<_Type> est chaîne, <_IdClient> est entier, <_idclientlivraison> est entier)
      //
      // Paramètres :
      //	_Type (chaîne ANSI) : <indiquez ici le rôle de _Type>
      //	_IdClient (entier) : <indiquez ici le rôle de _IdClient>
      //	_idclientlivraison (entier) : <indiquez ici le rôle de _idclientlivraison>
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE SaveJourCamion(_Type est une chaine,_IdClient est un entier,_idclientlivraison est un entier)
      
      _message est un booleen = faux
      pour tout _jourLivraisonCamion,_idsaison de TAjourlivraisonsaison
      	selon _Type
      		cas "A"
      			hraz(JourLivraisonClient)
      			JourLivraisonClient.IDClient = _IdClient
      			JourLivraisonClient.IdAdresseLivraison = _idclientlivraison
      			JourLivraisonClient.JourLivraison = _jourLivraisonCamion.JoursLivraisonClientCompile
      			JourLivraisonClient.IDSaisonLivraison = _idsaison
      			pour i = 1 a 7
      				SI _jourLivraisonCamion.JoursLivraisonClientCompile & Puissance(2,i-1) <> 0 _ET_ _jourLivraisonCamion.tabJourLivraisonCamion[i] <= 0  ALORS
      //					_jourLivraisonCamion.tabJourLivraison[i] = Faux
      //					JourLivraisonClient.JourLivraison -= ReCompileJoursLivraison(i)
      					_message = Vrai
      				SINON
      					JourLivraisonClient.IDCamions[i] = _jourLivraisonCamion.tabJourLivraisonCamion[i]
      					JourLivraisonClient.ShippingSequence[i] =_jourLivraisonCamion.tabShippingSequence[i]
      					
      				FIN
      			fin
      //			JourLivraisonClient.JourLivraison -= CompileCamion(_jourLivraisonCamion)
      			hajoute(JourLivraisonClient)
      		Cas "M"
      			si hlitrecherche(JourLivraisonClient,IDClientIDSaisonLivraison,[_IdClient,_idsaison,0]) ALORS
      				
      				JourLivraisonClient.JourLivraison = _jourLivraisonCamion.JoursLivraisonClientCompile
      				POUR i = 1 a 7
      					SI _jourLivraisonCamion.JoursLivraisonClientCompile & Puissance(2,i-1) <> 0 _ET_ _jourLivraisonCamion.tabJourLivraisonCamion[i] <= 0  ALORS
      //						_jourLivraisonCamion.tabJourLivraison[i] = Faux
      //						JourLivraisonClient.JourLivraison -= ReCompileJoursLivraison(i)
      						_message = Vrai
      					SINON
      						JourLivraisonClient.IDCamions[i] = _jourLivraisonCamion.tabJourLivraisonCamion[i]
      						JourLivraisonClient.ShippingSequence[i] =_jourLivraisonCamion.tabShippingSequence[i]
      					FIN
      				FIN
      				hmodifie(JourLivraisonClient,hNumEnrEnCours)
      			sinon
      				HRAZ(JourLivraisonClient)
      				JourLivraisonClient.IDClient = _IdClient
      				JourLivraisonClient.IdAdresseLivraison = 0
      				JourLivraisonClient.JourLivraison = _jourLivraisonCamion.JoursLivraisonClientCompile
      				JourLivraisonClient.IDSaisonLivraison = _idsaison
      				POUR i = 1 a 7
      					SI _jourLivraisonCamion.JoursLivraisonClientCompile & Puissance(2,i-1) <> 0 _ET_ _jourLivraisonCamion.tabJourLivraisonCamion[i] <= 0  ALORS
      //						_jourLivraisonCamion.tabJourLivraison[i] = Faux
      //						JourLivraisonClient.JourLivraison -= ReCompileJoursLivraison(i)
      						_message = Vrai
      					SINON
      						JourLivraisonClient.IDCamions[i] = _jourLivraisonCamion.tabJourLivraisonCamion[i]
      					FIN
      				FIN
      	//						JourLivraisonClient.JourLivraison = CompileCamion(_jourLivraisonCamion)
      				HAjoute(JourLivraisonClient)
      				
      			FIN
      	fin
      FIN
      
      si _message alors
      	Erreur("Certains camions pour certaines journées n'ont pas été définis","Veuillez vérifier SVP")
      FIN
     type : 458752
   -
     name : ReCompileJoursLivraison
     procedure_id : 2135224570100636384
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] ReCompileJoursLivraison (<_JourARecompiler> est entier)
      //
      // Paramètres :
      //	_JourARecompiler (entier) : <indiquez ici le rôle de _jourLivraisonCamion>
      // Valeur de retour :
      // 	réel : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      //	JourARecompiler (entier) : <indiquez ici le rôle de JourARecompiler>
      PROCEDURE ReCompileJoursLivraison(_JourARecompiler est un entier)
      renvoyer Puissance(2,_JourARecompiler-1)
     type : 458752
   -
     name : SaveForbiddenComponent
     procedure_id : 1701878330500122416
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      // SaveForbiddenComponent ()
      //
      // Paramètres :
      //	Aucun
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure SaveForbiddenComponent()
      
      sTxtSuppressComponent est un chaine = [
         delete from clientComposanteInterdite where clientcomposanteinterdite.customerid = {pIdCustomer}
      ]
      sdReqsql est une source de donnees
      sdreqsql.pIdCustomer = client.IDClient
      HExécuteRequêteSQL(sdReqsql,hRequêteDéfaut,sTxtSuppressComponent)
      
      pour chaque ligne de TABLE_ForbiddenComponent
      	hraz(ClientComposanteInterdite)
      	ClientComposanteInterdite.CustomerID = client.IDClient
      	ClientComposanteInterdite.ProductNumber = TABLE_ForbiddenComponent.COL_ProductNumber
      	ClientComposanteInterdite.ProductDescription = TABLE_ForbiddenComponent.COL_ProductDescription
      	hajoute(ClientComposanteInterdite)
      FIN
      
     type : 458752
   -
     name : FillTableForbiddenComponent
     procedure_id : 1701880525296489538
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      // FillTableForbiddenComponent ()
      //
      // Paramètres :
      //	Aucun
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure FillTableForbiddenComponent()
      TABLE_ForbiddenComponent.supprimetout()
      sTxtsql est une chaine = [
      select * from clientComposanteInterdite where clientcomposanteinterdite.customerid = {pIdCustomer}
      ]
      sdReqsql est une source de donnees
      sdReqsql.pIdCustomer = client.IDClient
      si HExécuteRequêteSQL(sdReqsql,hRequêteDéfaut,sTxtsql) alors
      	pour TOUT sdReqsql 
      		TABLE_ForbiddenComponent.ajouteligne(sdReqsql.productnumber,sdReqsql.productDescription)
      	FIN
      FIN
      ExécuteTraitement(TABLE_ForbiddenComponent,trtSélection)
     type : 458752
