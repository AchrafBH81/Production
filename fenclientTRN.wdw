                 -
                   name : PPRIXA
                   identifier : 0x514f23a3219bb4dd
                   internal_properties : CQAAAAkAAABVM/txm8FhCFU7Px/t303T7HuO/bQ5OyZl54cQxM8bWuvPEpvMDbAIWC6jU4m63i9Kb056AHg3fZcG2eyTN4/vk7f92NSKhPF/n/+Cs6b+C1jFVheHyK4VgCBpSWECZcS0J3l0x/ed13YtdLQSGZyQr8rVlSxb/ZA/Ar0eeI9XFHXyjR5TZRL3ADbmg1fycILkb2SDqN0saRlvsWluyXb5HDH8sP9xlu/TMXfGr1cjg6GwyGytj1Z9NDd+vIYh
                   type : 2
                   content :
                    internal_properties : 
                    properties : {}
                    type : 2
                   code_elements :
                    internal_properties : CQAAAAkAAACVbIAZKIyLUtOx/TRl3LdawH8KiRIbZVPHIi3CQG0ZQWORAsfR1LV9KK1m6uVL3Trxd5kjIU0MB2uWkg==
                    type_code : 3
                    p_codes :
                     -
                       code : |1+
                        lValeurOriginale = moimeme
                        
                       type : 15
                     -
                       code : |1+
                        selon ptype[table_1]
                        	cas 1   // produit à l'unité
                        		si table_1.PPRIXA[table_1] <> 0 alors
                        			table_1.cspecial = vrai
                        		sinon
                        			si moimeme <> lvaleuroriginale alors
                        
                        				si acso_message("Question","Vous avez inscrit 0 comme valeur "+rc+"Voulez-vous continuer avec cette valeur","OuiNon") = idyes alors
                        					table_1.cspecial = vrai
                        				sinon
                        					moimeme = lvaleuroriginale
                        					reprisesaisie()
                        				FIN
                        			fin
                        		fin
                        
                        	cas 2   // verre a l'unite
                        		// pprixm[table_1] = pprixa[table_1] * CONFIG.conversionam
                        		si table_1.PPRIXA[table_1] <> 0 alors
                        			table_1.PPRIXM[table_1] =  pprixa[table_1] * CONFIG.conversionam
                        			si moimeme <> lvaleuroriginale alors
                        				table_1.cspecial = vrai
                        			fin
                        		sinon
                        			si moimeme <> lvaleuroriginale alors
                        
                        				si acso_message("Question","Vous avez inscrit 0 comme valeur "+rc+"Voulez-vous continuer avec cette valeur","OuiNon") = idyes alors
                        					table_1.PPRIXM[table_1] =  pprixa[table_1] * CONFIG.conversionam
                        					table_1.cspecial = vrai
                        				sinon
                        					moimeme = lvaleuroriginale
                        					reprisesaisie()
                        				FIN
                        			fin
                        		fin
                        	cas 4
                        		si table_1.PPRIXA[table_1] <> 0 alors
                        			//		table_1.PPRIXM[table_1] =  pprixa[table_1] * CONFIG.conversionam
                        			si moimeme <> lvaleuroriginale alors
                        				table_1.cspecial = vrai
                        			fin
                        		sinon
                        			si moimeme <> lvaleuroriginale alors
                        
                        				si acso_message("Question","Vous avez inscrit 0 comme valeur "+rc+"Voulez-vous continuer avec cette valeur","OuiNon") = idyes alors
                        					//				table_1.PPRIXM[table_1] =  pprixa[table_1] * CONFIG.conversionam
                        					table_1.cspecial = vrai
                        				sinon
                        					moimeme = lvaleuroriginale
                        					reprisesaisie()
                        				FIN
                        			fin
                        		fin
                        	cas 5   // Peinture
                        		// pprixm[table_1] = pprixa[table_1] * CONFIG.conversionam
                        		si table_1.PPRIXA[table_1] <> 0 alors
                        			selon table_1.ttypepeinture[table_1]
                        				cas 1
                        					table_1.PPRIXM[table_1] =  pprixa[table_1] //* CONFIG.conversionam
                        				cas 2,3
                        					table_1.PPRIXM[table_1] =  pprixa[table_1] * CONFIG.conversionamlineaire
                        				cas 4
                        					table_1.PPRIXM[table_1] =  pprixa[table_1] * CONFIG.conversionam
                        			fin
                        
                        			si moimeme <> lvaleuroriginale alors
                        				table_1.cspecial = vrai
                        			fin
                        		sinon
                        			si moimeme <> lvaleuroriginale alors
                        
                        				si acso_message("Question","Vous avez inscrit 0 comme valeur "+rc+"Voulez-vous continuer avec cette valeur","OuiNon") = idyes alors
                        					table_1.PPRIXM[table_1] =  pprixa[table_1] * CONFIG.conversionam
                        					table_1.cspecial = vrai
                        				sinon
                        					moimeme = lvaleuroriginale
                        					reprisesaisie()
                        			FIN
                        		fin
                        fin
                        
                        
                        fin
