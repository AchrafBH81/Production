  -
    name : BTN_OK
    identifier : 0x514f23a33677b537
    internal_properties : 
    properties :
     x : 52
     y : 1
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        internal_properties : CQAAAAkAAAAMKk0bUnppf9n/DdIx+pD12FdjGBpDdPouTXmKpwRX8VSK7s3EyvfwpbA1UoOIDFhQRWUvEtPmaHQL3DqP9EYkvNp92ZaY8pL88p/fEQhlXNEtBTP55g==
        code : |1-
         sablier(vrai)
         ecranversfichier(fenclientTRN,client)
         hmodifie(client,hNumEnrEnCours)
         //htransactionfin()
         
         maj_table_thermos()
         maj_table_produit()
         maj_table_variableX()
         //maj_table_peinture()
         
         maj_table_forme()
         maj_table_couleur()
         maj_table_extra()
         maj_table_garantie()
         SaveForbiddenComponent()
         
         restaure_bouton()
         SaveJourcamion("M",client.idclient,0)
         SaveFrequence(client.IDClient)
         gr_camions..etat = AffichageSeulement
         
         executeTraitement(Table,trtSélection)
         //Code WinDev 5.5 remplacé par la migration :
         //btn_sortie..etat = actif
         btn_sortie..etat = actif; btn_sortie..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         //validation..etat = GRISé
         validation..etat = GRISé; validation..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         //navigation..etat = actif
         navigation..etat = actif; navigation..Visible=Vrai
         //identifiant..VISIBLE = FAUX
         //Code WinDev 5.5 remplacé par la migration :
         //fiche..etat = actif
         fiche..etat = actif; fiche..Visible=Vrai
         //cli_onglet = 1
         //Code WinDev 5.5 remplacé par la migration :
         //cli_onglet[1]..etat = actif
         cli_onglet[1]..etat = actif; cli_onglet[1]..Visible=Vrai
         cli_onglet[11]..etat = actif; cli_onglet[11]..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         //prix..etat = grisé
         prix..etat = grisé; prix..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         //prix_option..etat = inactif
         prix_option..etat = AffichageSeulement; prix_option..Visible=Vrai
         identifiant..etat = AffichageSeulement; identifiant..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         //affichage..etat = actif
         affichage..etat = actif; affichage..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         //saisie_prix..etat = inactif
         saisie_prix..etat = AffichageSeulement; saisie_prix..Visible=Vrai
         si gFormatFacture = 1 alors
         	GrpPeinture..visible = faux
         FIN
         modif = faux
         si CLI_ONGLET = 1 alors
         	BTN_AJOUT..etat = actif
         sinon
         	BTN_AJOUT..etat = grise
         FIN
         //Code WinDev 5.5 remplacé par la migration :
         //TABLE_10..ETAT = INACTIF
         TABLE_10..ETAT = AffichageSeulement; TABLE_10..Visible=Vrai
         TABLE1..ETAT = AffichageSeulement; TABLE1..Visible=Vrai
         TableVariableX..ETAT = AffichageSeulement; TableVariableX..Visible=Vrai
         TABLE_1..ETAT = AffichageSeulement; TABLE_1..Visible=Vrai
         TablePeinture..ETAT = AffichageSeulement; TablePeinture..Visible=Vrai
         Tableforme..ETAT = AffichageSeulement; Tableforme..Visible=Vrai
         TableCouleurExtra..ETAT = AffichageSeulement; TableCouleurExtra..Visible=Vrai
         Table_Extra..ETAT = AffichageSeulement; Table_Extra..Visible=Vrai
         ExécuteTraitement(table_1,trtSélection)
         GrpCouleur..visible = faux
         GrpCouleur..etat = inactif
         
         
         si gFormatFacture = 2 alors
         	si gModificationPrixThermos alors
         		gModificationPrixThermos=faux
         		si acso_message("Question","Voulez-vous appliquer les changements de prix de thermos aux commandes et bons de livraison ?","OuiNon") = idyes ALORS
         			ModifierCommande()
         		fin	
         	FIN
         	si gModificationPrixPeinture alors
         		gModificationPrixPeinture=faux
         		si acso_message("Question","Voulez-vous appliquer les changements de prix de peinture aux commandes et bons de livraison ?","OuiNon") = idyes ALORS
         			ModifierCommandePeintureClient(datesys())
         		fin	
         	FIN
         fin
         CLI_ONGLET =1
         ExécuteTraitement(CLI_ONGLET,trtModification)
         calendrier1..etat = inactif
         sablier(faux)
         CAS EXCEPTION:
         	
         	info(Exceptioninfo(errComplet))
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_ANNULE
    identifier : 0x514f23a32bfcb537
    internal_properties : 
    properties :
     x : 85
     y : 1
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         restaure_bouton()
         si ACSO_message("Question","Annuler toutes le modifications apportées à ce client","OuiNon") = IDYES alors
         	btn_sortie..etat = actif; btn_sortie..Visible=Vrai
         	validation..etat = GRISé; validation..Visible=Vrai
         	navigation..etat = actif; navigation..Visible=Vrai
         	fiche..etat = actif; fiche..Visible=Vrai
         	cli_onglet[1]..etat = actif; cli_onglet[1]..Visible=Vrai
         	cli_onglet[11]..etat = actif; cli_onglet[11]..Visible=Vrai
         	
         	prix..etat = grisé; prix..Visible=Vrai
         	prix_option..etat = AffichageSeulement; prix_option..Visible=Vrai
         	identifiant..etat = AffichageSeulement; identifiant..Visible=Vrai
         	affichage..etat = actif; affichage..Visible=Vrai
         	saisie_prix..etat = AffichageSeulement; saisie_prix..Visible=Vrai
         	si gFormatFacture = 1 alors
         		GrpPeinture..visible = faux
         	FIN
         	
         	modif = faux
         	TABLE_10..ETAT = AffichageSeulement; TABLE_10..Visible=Vrai
         	TABLE_1..ETAT = AffichageSeulement; TABLE_1..Visible=Vrai
         	TableVariableX..ETAT = AffichageSeulement; TableVariableX..Visible=Vrai
         	Tablepeinture..ETAT = AffichageSeulement; Tablepeinture..Visible=Vrai
         	TableCouleurExtra..ETAT = AffichageSeulement; TableCouleurExtra..Visible=Vrai
         	Tableforme..ETAT = AffichageSeulement; Tableforme..Visible=Vrai
         	Table_Extra..ETAT = AffichageSeulement; Table_Extra..Visible=Vrai
         	
         	GrpCouleur..visible = faux
         	GrpCouleur..etat = inactif
         	GR_camions..Etat = AffichageSeulement
         	
         	si CLI_ONGLET = 1 alors
         		BTN_AJOUT..etat = actif
         	sinon
         		BTN_AJOUT..etat = grise
         	FIN
         	selon CLI_ONGLET
         		cas 1
         		cas 12
         	fin
         	
         	tableaffiche("TABLE",taCourantBandeau)
         	ExecuteTraitement("table",trtselection)
         	Calendrier1..Etat = Inactif
         fin
         
        type : 18
      -
        type : 161
        enabled : false
