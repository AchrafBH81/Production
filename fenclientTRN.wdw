      	fcouleur.cExtraLineaire,fcouleur.CExtraLineaireM,fcouleur.cextraUnite,fcouleur.cExtracarreau,faux)
      
          hlitsuivant(fcouleur,noCouleur)
      FIN
      
      
      
      //TABLEAFFICHE(TABLE_1,taDébut)
     type : 458752
   -
     name : maj_table_couleur
     procedure_id : 5858940824189252779
     type_code : 14
     code : |1-
      Procédure maj_table_couleur()
      
      clederecherche est une chaine
      i est un entier
      pour i = 1 a TableOccurrence(tablecouleurextra)
      	si hlitrecherche(fcouleur,noCouleur,tablecouleurextra.coulnum[i]) alors 
      		si tablecouleurextra.coulspecial[i] alors
      			clederecherche = HConstruitValClé(fcouleurclient,noClientNoCouleur,fenclienttrn.numero,tablecouleurextra.coulnum[i])
      			si hlitrecherche(fcouleurclient,noClientNoCouleur,clederecherche,hIdentique) alors
      				fcouleurclient.fcExtralineaire= tablecouleurextra.coulextralineaire[i]
      				fcouleurclient.fcExtralineairem= tablecouleurextra.coulextralineairem[i]
      				fcouleurclient.fcExtracarreau= tablecouleurextra.coulextracarreau[i]
      				fcouleurclient.fcExtraunite= tablecouleurextra.coulextraunite[i]
      				hmodifie(fcouleurclient,hNumEnrEnCours)
      			sinon
      				fcouleurclient.fcExtralineaire= tablecouleurextra.coulextralineaire[i]
      				fcouleurclient.fcExtralineairem= tablecouleurextra.coulextralineairem[i]
      				fcouleurclient.fcExtracarreau= tablecouleurextra.coulextracarreau[i]
      				fcouleurclient.fcExtraunite= tablecouleurextra.coulextraunite[i]
      				fcouleurclient.noClient           = fenclienttrn.numero
      					fcouleurclient.NoCouleur          = tablecouleurextra.coulnum[i]
      					hajoute(fcouleurclient)
      			FIN
      		sinon
      			clederecherche = HConstruitValClé(fcouleurclient,noClientNoCouleur,fenclienttrn.numero,tablecouleurextra.coulnum[i])
      			si hlitrecherche(fcouleurclient,noClientNoCouleur,clederecherche,hIdentique) alors
      				HSupprime(fcouleurclient,hnumenrencours)
      			fin 
      		FIN
      
      	fin
      fin
     type : 458752
   -
     name : remplirtableCouleurProduit
     procedure_id : 5858940823437423787
     type_code : 14
     code : |1+
      Procédure remplirtableCouleurProduit(lNoClient="",lNoProduit="")
      TableSupprimeTout(TableProduitCouleur)
      hlitrecherche(FClientProduitCouleur,noClientNoProduit,...
      HConstruitValClé(FClientProduitCouleur,noClientNoProduit,sansespace(lNoClient),sansespace(lNoProduit)))
      
      tantque sansespace(FClientProduitCouleur.noClient) = sansespace(lNoClient) ...
      	et sansespace(FClientProduitCouleur.NoProduit) = sansespace(lNoProduit) et pas HEnDehors(FClientProduitCouleur)
      	TableAjouteligne(TableProduitCouleur,FClientProduitCouleur.NoCouleur,FClientProduitCouleur.fcdesccouleur...
      	,FClientProduitCouleur.fcextraunite,FClientProduitCouleur.noClient,FClientProduitCouleur.Noproduit,...
      	FClientProduitCouleur.IDFCouleurClient)
      	HLitSuivant(FClientProduitCouleur,noClientNoProduit)
      
      FIN
      tableaffiche(TableProduitCouleur,taInit)
      
      
      
      
      
     type : 458752
   -
     name : RemplirTableContact
     procedure_id : 5858940823949849771
     type_code : 14
     code : |1+
      Procédure RemplirTableContact(lNumLigne=0,Libcolonne="",ltoucheenfoncee=0)
      i est un entier
      hpos est un entier = HSauvePosition(client) 
      TableSupprimeTout(TableContact)
      si hlitrecherche(client,numero,sansespace(table.NUMERO_1[lNumLigne])) alors
      	pour i = 1 a 3
      		si sansespace(client.ccontact[i]) <> "" ou sansespace(client.ccontacttitre[i]) <> "" alors
      			tableajouteligne(TableContact,client.ccontacttitre[i],client.ccontact[i],client.ccontactTel[i] )
      		fin
      	FIn
      FIN
      HRetourPosition(hpos)
      si pas TableContact..vide alors
      	pGestionSurvol.AfficherTable(tablecontact..nom,Const_Centré,0,vrai)
      fin
      
      
      
     type : 458752
   -
     name : AffichageInfo
     procedure_id : 5858940824918406315
     type_code : 14
     code : |1+
      Procédure AffichageInfo(lNumLigne=0,Libcolonne="",ltoucheenfoncee=0)
      
      
      selon ltoucheenfoncee
      	// aucune touche 
      	cas 0
      		RemplirTableContact(lNumLigne,Libcolonne,ltoucheenfoncee)
      	// Touche Shift
      	cas 1
      		Remplirtableinfo(lNumLigne,Libcolonne,ltoucheenfoncee)
      FIN
      
      
      
      
      
     type : 458752
   -
     name : RemplirTableInfo
     procedure_id : 5858940823738234027
     type_code : 14
     code : |1+
      Procédure RemplirTableInfo(lNumLigne=0,Libcolonne="",ltoucheenfoncee=0)
      i est un entier
      hpos est un entier = HSauvePosition(client)
      TableSupprimeTout(Tableinfo)
      si hlitrecherche(client,numero,sansespace(table.NUMERO_1[lNumLigne])) alors
      	tableajouteligne(Tableinfo,"Nom",client.nom )
      	tableajouteligne(Tableinfo,"Adresse",client.crue )
      	tableajouteligne(Tableinfo,"Ville/Province",client.cville )
      	tableajouteligne(Tableinfo,"Code Postal",client.ccodepostal )
      	tableajouteligne(Tableinfo,"Téléphone",client.ctelephone )
      	tableajouteligne(Tableinfo,"Télécopieur",client.cfax )
      	tableajouteligne(Tableinfo,"Cond. de paiement",client.ccondpaiement )
      FIN
      HRetourPosition(hpos)
      si pas Tableinfo..vide alors
      	pGestionSurvol.AfficherTable(tableinfo..nom,Const_Centré,0,vrai)
      fin
      
      
      
     type : 458752
   -
     name : MajLog
     procedure_id : 5858940823363630251
     type_code : 14
     code : |1+
      Procédure MajLog()
      
      logfile.lDate = DateDuJour()
      logfile.lheure = HeureSys()
      LogFile.lUtilisateur = gsuser
      LogFile.lposte = NetNomMachine()
      
      logfile.lNoCommande = 0
      logfile.lFonction = h.FonctionTrigger
      logfile.lFenetre = fenencours()
      logfile.lEtatPreparation = ""
      LogFile.lNoClient = client.numero
      logfile.lprixa = thermosclient.Tprixa
      si HLitRecherche(persoens,PECLEUNIK,ThermosClient.IdThermos) alors
      	logfile.lnoproduit = persoens.ennumero
      sinon
      	logfile.lnoproduit = ThermosClient.IdThermos
      FIN
      hajoute(logfile)
     type : 458752
   -
     name : ModifierCommande
     procedure_id : 5858940824932168875
     type_code : 14
     code : |1+
      Procédure ModifierCommande()
      lexception5 est un booleen = faux
      lexception10 est un booleen = faux
      resultatcalcul est un chaine = ""
      _prixa est un reel
      _prixm est un reel
      
      ouvresoeur(AfficheMiseajour)
      HLitRecherche(facture,faclient,client.numero)
      
      tantque pas HEnDehors(Facture) et facture.faclient=client.numero
      	AfficheMiseajour.csnFacture = facture.fanumero
      	MultitacheRepeint(AfficheMiseajour)
      	multitache(10)
      	//	si facture.fanumero >= 50124 alors
      	hlitrecherche(fdetail,fdnocomm,facture.fanumero)
      	tantque pas hendehors(fdetail) et fdetail.fdnocomm = facture.fanumero
      		lexception5  = faux
      		lexception10  = faux
      		si fdetail.ftype = 1 alors
      			resultatcalcul = CalculPrixThermos(fdetail.fdnumprod,client.IDClient)
      			_prixa = val(extraitchaine(resultatcalcul,1,","))
      			_prixm = val(extraitchaine(resultatcalcul,2,","))
      
      			//			si hlitrecherche(thermosClient,IdClientIdhermos,HConstruitValClé(thermosclient,IdClientidhermos,sansespace(client.numero),sansespace(fdetail.fdnumprod))) alors
      			selon facture.facalcul 
      				cas 1
      //					fdetail.fdprixupied= thermosclient.Tprixa
      					fdetail.fdprixupied= _prixa
      
      				cas 2
      //					fdetail.fdprixupied= thermosclient.Tprixm
      					fdetail.fdprixupied= _prixm
      			FIN
      
      			selon client.CImpressionAngMet
      				cas 1
      					fdetail.fdprixu = fdetail.fdpiedcarrefacture * _prixa
      //					fdetail.fdprixu = fdetail.fdpiedcarrefacture * ThermosClient.Tprixa
      					fdetail.fdprixtotal = fdetail.fdqte * fdetail.fdprixu
      //					fdetail.fdprixupiedfacture = ThermosClient.tprixa
      					fdetail.fdprixupiedfacture = _prixa
      				cas 2
      //					fdetail.fdprixu = fdetail.fdpiedcarrefacture * ThermosClient.Tprixm
      					fdetail.fdprixu = fdetail.fdpiedcarrefacture * _prixm
      					fdetail.fdprixtotal = fdetail.fdqte * fdetail.fdprixu
      //					fdetail.fdprixupiedfacture = ThermosClient.tprixm
      					fdetail.fdprixupiedfacture = _prixm
      
      			FIN
      
      			si val(fdetail.fdhauteur) <> 0 et val(fdetail.fdlargeur) <> 0 alors
      				si val(fdetail.fDLARGEUR) > val(fdetail.fDHAUTEUR) alors
      					si partieentiere(val(fdetail.fDLARGEUR)/val(fdetail.fdhauteur)) >= 10 alors
      						lexception10 = vrai
      					sinon si partieentiere(val(fdetail.fDLARGEUR)/val(fdetail.fdhauteur)) >= 5 alors
      						lexception5= vrai
      					fin
      				sinon
      					si partieentiere(val(fdetail.fDhauteur)/val(fdetail.fdlargeur)) >= 10 alors
      						lexception10 = vrai
      					sinon si partieentiere(val(fdetail.fDhauteur)/val(fdetail.fdlargeur)) >= 5 alors
      						lexception5= vrai
      					fin
      
      			FIN
      			//			fin
      
      
      
      			si lexception5 alors
      				fdetail.FDextra5x = fdetail.fdprixu * config.Exception5 / 100
      			sinon
      				fdetail.FDextra5x = 0
      			FIN
      			si lexception10 <> 0 alors
      				fdetail.FDextra10x = fdetail.fdprixu * config.Exception10 / 100
      			sinon
      				fdetail.FDextra10x = 0
      			FIN
      			fdetail.surchargeenergie = calculsurcharge(fdetail.fdprixtotal+(fdetail.fdqte * (fdetail.FDextra10X+fdetail.FDextra5x)),fdetail.ftype)
      			fdetail.SUrchargeafacturer = fdetail.surchargeenergie * fdetail.fdqteafacturer / fdetail.fdqte
      			fdetail.SUrchargedejafacture = fdetail.surchargeenergie - fdetail.SUrchargeafacturer
      			fdetail.fdprixtotal += fdetail.fdqte * fdetail.fdextraforme
      			HModifie(fdetail,hNumEnrEnCours)
      		fin
      
      	fin
      
      	hlitrecherche(BonLivraison,BnoCommande,fdetail.fdnocomm)
      	tantque pas hendehors(BonLivraison) et BonLivraison.BnoCommande = fdetail.fdnocomm
      		//		si hlitrecherche(BonLivraison,BnoCommande,fdetail.fdnocomm) alors
      		si BonLivraison.bfacture = 0 alors
      			si hlitrecherche(hfacture,Bnumero,BonLivraison.bnumero) alors
      				hlitrecherche(hfdetail,HFCLEUNIK,hfacture.HFCLEUNIK)
      				tantque pas hendehors(hfdetail) et hfdetail.HFCLEUNIK = hfacture.HFCLEUNIK
      					si hfdetail.ftype = 1 et hfdetail.fdligne= fdetail.fdligne alors
      						hfdetail.fdprixupied= fdetail.fdprixupied
      						hfdetail.fdprixu = fdetail.fdpiedcarrefacture * fdetail.fdprixupiedfacture
      						hfdetail.fdprixtotal = hfdetail.fdqteafacturer * hfdetail.fdprixu
      						hfdetail.fdprixupiedfacture = fdetail.fdprixupiedfacture
      						hfdetail.FDextra10X = fdetail.FDextra10X
      						hfdetail.FDextra5X = fdetail.FDextra5X
      						hfdetail.SUrchargeafacturer = fdetail.surchargeenergie * hfdetail.fdqteafacturer / fdetail.fdqte
      						hfdetail.surchargeenergie = fdetail.surchargeenergie * hfdetail.fdqteafacturer / fdetail.fdqte
      						hfdetail.fdprixtotal += hfdetail.fdqteafacturer * hfdetail.fdextraforme
      						HModifie(hfdetail,hnumenrencours)
      					FIN
      					hlitsuivant(hfdetail,HFCLEUNIK)
      			FIN
      		FIN
      
      	fin
      	HLitSuivant(BonLivraison,BnoCommande)
      fin
      
      
      hlitsuivant(fdetail,fdnocomm)
      FIN
      //fin
      HLitSuivant(Facture,faclient)
      FIN
      Ferme(AfficheMiseajour)
      
      
      
     type : 458752
   -
     name : ModifierCommandePeintureClient
     procedure_id : 5858940823803049131
     type_code : 14
     code : |1-
      Procédure ModifierCommandePeintureClient(ladate)
      lexception5 est un booleen = faux
      lexception10 est un booleen = faux
      lPrixCarreau est un reel
      //saisie1..Libellé = "Facture en cours ..."
      fsurchargepeinture est un reel
      fminpeinture est un reel
      
      OuvreSoeur(AfficheMiseajour)
      HLitRecherche(facture,faclient,client.numero)
      tantque pas HEnDehors(Facture) et facture.faclient = client.numero
      	si facture.fadate >= ladate alors
      		HLitSuivant(facture,faclient)
      		continuer
      	fin
      //	saisie1 = facture.fanumero
      
      	multitache(1)
      	hlitrecherche(client,numero,facture.faclient)
      	si client.cminimumPeinture <> 0 alors
      		fminpeinture = client.cminimumPeinture
      	sinon
      		fminpeinture = config.prixMinimumPeinture	
      	FIN
      
      
      	//	si facture.fanumero >= 50124 alors
      	si facture.fpeinture <> 0 et facture.fatypedocument = 1 alors
      		AfficheMiseajour.csnFacture = facture.fanumero
      		MultitacheRepeint(AfficheMiseajour)
      		hlitrecherche(fdetail,fdnocomm,facture.fanumero)
      		tantque pas hendehors(fdetail) et fdetail.fdnocomm = facture.fanumero 
      			si fdetail.ftype = 1 ou fdetail.ftype = 4 alors
      				TrouvePrixPeinture()
      				hmodifie(fdetail,hnumenrencours)
      			sinon si fdetail.ftype = 5
      				CalculPrixPeinture()
      				fsurchargepeinture += arrondi(fdetail.fdprixtotal,2)				
      				hmodifie(fdetail,hnumenrencours)
      			fin	
      
      			hlitrecherche(BonLivraison,BnoCommande,fdetail.fdnocomm)
      			tantque pas hendehors(BonLivraison) et BonLivraison.BnoCommande = fdetail.fdnocomm
      				//		si hlitrecherche(BonLivraison,BnoCommande,fdetail.fdnocomm) alors
      				si BonLivraison.bfacture = 0 alors
      					si hlitrecherche(hfacture,Bnumero,BonLivraison.bnumero) alors
      						hlitrecherche(hfdetail,HFCLEUNIK,hfacture.HFCLEUNIK)
      						tantque pas hendehors(hfdetail) et hfdetail.HFCLEUNIK = hfacture.HFCLEUNIK
      							si hfdetail.fdligne= fdetail.fdligne alors
      								si hfdetail.ftype = 1 ou hfdetail.ftype = 4  alors
      									hfdetail.fPrixCarreauPeinture = fdetail.fPrixCarreauPeinture
      									hfdetail.fTotalPeinture = fdetail.fTotalPeinture
      									hmodifie(hfdetail,hNumEnrEnCours)
      								sinon si hfdetail.ftype = 5
      									hfdetail.fdprixu = fdetail.fdprixu
      									hfdetail.fdprixupied = fdetail.fdprixupied
      									hfdetail.fdprixtotal = fdetail.fdprixtotal
      									hmodifie(hfdetail,hNumEnrEnCours)
      								fin
      							fin
      							hlitsuivant(hfdetail,HFCLEUNIK)
      						fin
      					fin
      				fin
      				HLitSuivant(BonLivraison,BnoCommande)
      			fin
      			hlitsuivant(fdetail,fdnocomm)
      		FIN
      
      	fin
      	si facture.fpeinture = 1 alors
      		si fsurchargepeinture < fminpeinture alors
      			facture.fSUrchargePeinture = fminpeinture-fsurchargepeinture
      			hmodifie(facture,hNumEnrEnCours)
      		FIN
      	FIN
      
      	HLitSuivant(Facture,faclient)
      FIN
      
      
      multitache(100)
      
      
      ferme(AfficheMiseajour)
     type : 458752
   -
     name : remplir_TableExtra
     procedure_id : 5858940824278250667
     type_code : 14
     code : |1+
      Procédure remplir_TableExtra()
      resultatCalcul est une chaine = ""
      _prixa est un reel
      _prixm est un reel
      _special est un booleen 
      _modifie est un booleen
      
      HExécuteRequête(RequeteProduitExtra)
      
      pour tout RequeteProduitExtra
      	_special = faux
      	_modifie = vrai
      	si RequeteProduitExtra.ibase alors
      		TableAjouteLigne(Table_Extra,RequeteProduitExtra.INUM,RequeteProduitExtra.IDESC,1,RequeteProduitExtra.IPRIXDOUBLE,...
      		RequeteProduitExtra.iprixdoublem,RequeteProduitExtra.iprixtriple,RequeteProduitExtra.iprixtriplem,0,0,"","",vrai,RequeteProduitExtra.IRationDoubleTriple)
      	sinon
      		si (sansespace(RequeteProduitExtra.ipextra) <> ""  et RequeteProduitExtra.ipextra <> RequeteProduitExtra.inum)ou (sansespace(RequeteProduitExtra.ipextrat) <> "" et RequeteProduitExtra.ipextrat <> RequeteProduitExtra.inum) alors
      			resultatCalcul = CalculPrixExtra(RequeteProduitExtra.inum)
      		    _prixa = val(ExtraitChaîne(resultatCalcul,1,","))
      			_prixm = val(ExtraitChaîne(resultatCalcul,2,","))
      			_special = val(ExtraitChaîne(resultatCalcul,3,","))
      			_modifie = val(ExtraitChaîne(resultatCalcul,4,","))
      
      		sinon
      			_prixa =RequeteProduitExtra.IPRIXA
      			_prixm = RequeteProduitExtra.IPRIXM
      		FIN
      		TableAjouteLigne(Table_Extra,RequeteProduitExtra.INUM,RequeteProduitExtra.IDESC,0,_prixa,_prixm,0,0,0,_special,requeteproduitextra.ipextra,requeteproduitextra.ipextrat,_modifie)
      	fin
      
      FIN
      
      
     type : 458752
   -
     name : Nouvelle_Procédure
     procedure_id : 5858940824243713195
     type_code : 14
     code : |1+
      Procédure Nouvelle_Procédure()
      
     type : 458752
   -
     name : maj_table_extra
     procedure_id : 5858940823956534443
     type_code : 14
     code : |1+
      Procédure maj_table_extra()
      i est un entier
      clederecherche est un chaine
      MajThermos est un booleen
      pour i = 1 a TableOccurrence(Table_Extra)
      	MajThermos = faux
      	si hlitrecherche(invent,INUM,table_extra.PPRODUIT[i]) alors 
      		si table_extra.Cimprime[i] ou table_extra.Cspecial[i] alors
      
      			clederecherche = HConstruitValClé(FclientExtra,IdClientNoProduit,client.IDClient,table_extra.pproduit[i])
      
      
      			si hlitrecherche(FclientExtra,IdClientNoProduit,clederecherche,hIdentique) alors
      				//				si table_extra.cspecial[i] alors
      
      				si Table_Extra.PBASE[i] alors
      					si fclientextra.PrixAnglaisD <> table_extra.PPRIXD[i] ou ...
      						fclientextra.PrixAnglaisT <> table_extra.PPRIXT[i] ou ...
      						fclientextra.PrixMetriqueD <> table_extra.PPRIXDM[i] ou ...
      						fclientextra.PrixMetriqueT <> table_extra.PPRIXTM[i] 	ALORS
      						MajThermos = vrai
      					FIN
      					fclientextra.PrixAnglaisD= table_extra.PPRIXD[i]
      					fclientextra.PrixAnglaisT= table_extra.PPRIXT[i]
      					fclientextra.PrixMetriqueD= table_extra.PPRIXDM[i]
      					fclientextra.PrixMetriqueT= table_extra.PPRIXTM[i]
      				sinon
      					si fclientextra.PrixAnglais <> table_extra.PPRIXD[i] ou ...
      						fclientextra.PrixMetrique <> table_extra.PPRIXDM[i] alors
      						MajThermos = vrai
      					FIN
      					fclientextra.PrixAnglais= table_extra.PPRIXD[i]
      					fclientextra.PrixMetrique= table_extra.PPRIXDM[i]
      				fin
      
      				//			fin
      				fclientextra.Pbase = Table_Extra.PBASE[i]
      				FclientExtra.ListeDePrix = table_extra.Cimprime[i]
      				FclientExtra.prixSpecial = table_extra.Cspecial[i]
      				hmodifie(fclientextra,hNumEnrEnCours)
      				si MajThermos alors
      					//recalculPrixThermos(client.IDClient,table_extra.pproduit[i])
      				fin
      
      			sinon
      				//				si table_extra.cspecial[i] alors
      				si Table_Extra.PBASE[i] alors
      					fclientextra.PrixAnglaisD= table_extra.PPRIXD[i]
      					fclientextra.PrixAnglaisT= table_extra.PPRIXT[i]
      					fclientextra.PrixMetriqueD= table_extra.PPRIXDM[i]
      					fclientextra.PrixMetriqueT= table_extra.PPRIXTM[i]
      				sinon
      					fclientextra.PrixAnglais= table_extra.PPRIXD[i]
      					fclientextra.PrixMetrique= table_extra.PPRIXDM[i]
      				fin
      				//				fin
      				FclientExtra.IdClient = client.IDClient
      				FclientExtra.NoProduit = table_extra.PPRODUIT[i]
      				FclientExtra.ListeDePrix = table_extra.Cimprime[i]
      				FclientExtra.prixSpecial = table_extra.Cspecial[i]
      				fclientextra.Pbase = Table_Extra.PBASE[i]
      				hajoute(fclientextra)
      			//	recalculPrixThermos(client.IDClient,table_extra.pproduit[i])
      
      			fin
      		sinon
      
      			clederecherche = HConstruitValClé(FclientExtra,IdClientNoProduit,client.IDClient,table_extra.pproduit[i])
      
      
      			si hlitrecherche(FclientExtra,IdClientNoProduit,clederecherche,hIdentique) alors
      				si pas Table_Extra.Cspecial[i] et pas Table_Extra.Cimprime[i] alors
      					HSupprime(FclientExtra,hnumenrencours)
      					//recalculPrixThermos(client.IDClient,table_extra.pproduit[i])
      				fin
      			fin 
      		FIN
      	fin
      fin
     type : 458752
   -
     name : CalculPrixThermos
     procedure_id : 5858940824307807403
     type_code : 14
     code : |1-
      Procédure CalculPrixThermos(NoThermos,_IDclient)
      resultat est un reel = 0
      NbThermos est un entier = 0
      Extra est une chaine
      ExtraT est une chaine
      PrixTotal est un reel = 0
      PrixTotalM est un reel = 0
      special est un booleen = faux
      
      
      
      
      
      //si hlitrecherche(requeteperso,ennumero,nothermos) ALORS
      	si sansespace(requeteperso.encomposant1) <> "" alors
      		NbThermos++
      
      
      		si hlitrecherche(invent,INUM,requeteperso.encomposant1)  alors
      			si pas invent.ibase alors
      				Extra = invent.ipextra
      				ExtraT = invent.ipextrat
      				si hlitrecherche(FclientExtra,IdClientNoProduit,HConstruitValClé(FclientExtra,IdClientNoProduit,_IDclient,sansespace(Extra))) et fclientextra.prixSpecial ALORS
      					PrixTotal+=FclientExtra.PrixAnglais
      					PrixTotalM+=FclientExtra.Prixmetrique
      					special=vrai
      				sinon
      					si hlitrecherche(invent,INUM,Extra) alors
      						PrixTotal+= arrondi(invent.IPRIXA,2)
      						PrixTotalM+= arrondi(invent.iprixm,2)
      					FIN
      				fin	
      				si hlitrecherche(FclientExtra,IdClientNoProduit,HConstruitValClé(FclientExtra,IdClientNoProduit,_IDclient,sansespace(ExtraT)))  et fclientextra.prixSpecial ALORS
      					PrixTotal+=FclientExtra.PrixAnglais
      					PrixTotalM+=FclientExtra.Prixmetrique
      					special=vrai
      				sinon
      					si hlitrecherche(invent,INUM,ExtraT) alors
      						PrixTotal+= arrondi(invent.IPRIXA,2)
      						PrixTotalM+= arrondi(invent.IPRIXm,2)
      					FIN
      				fin
      			fin
      
      
      		fin
      
      	Fin
      
      	si sansespace(requeteperso.encomposant2) <> "" alors
      		NbThermos++
      
      		si hlitrecherche(invent,INUM,requeteperso.encomposant2)  alors
      			si pas invent.ibase alors
      				Extra = invent.ipextra
      				ExtraT = invent.ipextrat
      				si hlitrecherche(FclientExtra,IdClientNoProduit,HConstruitValClé(FclientExtra,IdClientNoProduit,_IDclient,sansespace(Extra))) et fclientextra.prixSpecial ALORS
      					PrixTotal+=FclientExtra.PrixAnglais
      					PrixTotalM+=FclientExtra.Prixmetrique
      					special=vrai
      				sinon
      					si hlitrecherche(invent,INUM,Extra) alors
      						PrixTotal+= arrondi(invent.IPRIXA,2)
      						PrixTotalM+=arrondi(invent.IPRIXm,2)
      					FIN
      				fin
      				si hlitrecherche(FclientExtra,IdClientNoProduit,HConstruitValClé(FclientExtra,IdClientNoProduit,_IDclient,sansespace(ExtraT))) et fclientextra.prixSpecial ALORS
      					PrixTotal+=FclientExtra.PrixAnglais
      					PrixTotalM+=FclientExtra.Prixmetrique
      					special=vrai
      				sinon
      
      					si hlitrecherche(invent,INUM,ExtraT) alors
      						PrixTotal+= arrondi(invent.IPRIXA,2)
      						PrixTotalM+= arrondi(invent.IPRIXm,2)
      					FIN
      				fin
      			fin
      
      		fin
      
      	Fin
      
      
      	si sansespace(requeteperso.encomposant3) <> "" alors
      		NbThermos++
      
      		si hlitrecherche(invent,INUM,requeteperso.encomposant3)  alors
      			si pas invent.ibase alors
      				Extra = invent.ipextra
      				ExtraT = invent.ipextrat
      				si hlitrecherche(FclientExtra,IdClientNoProduit,HConstruitValClé(FclientExtra,IdClientNoProduit,_IDclient,sansespace(Extra))) et fclientextra.prixSpecial ALORS
      					PrixTotal+=FclientExtra.PrixAnglais
      					PrixTotalM+=FclientExtra.Prixmetrique
      					special=vrai
      				sinon
      					si hlitrecherche(invent,INUM,Extra) alors
      						PrixTotal+= arrondi(invent.IPRIXA,2)
      						PrixTotalM+= arrondi(invent.IPRIXm,2)
      					FIN
      				fin
      				si hlitrecherche(FclientExtra,IdClientNoProduit,HConstruitValClé(FclientExtra,IdClientNoProduit,_IDclient,sansespace(ExtraT))) et fclientextra.prixSpecial ALORS
      					PrixTotal+=FclientExtra.PrixAnglais
      					PrixTotalM+=FclientExtra.Prixmetrique
      				sinon
      
      					si hlitrecherche(invent,INUM,ExtraT) alors
      						PrixTotal+= arrondi(invent.IPRIXA,2)
      						PrixTotalM+= arrondi(invent.IPRIXm,2)
      						
      					FIN
      				fin
      			fin
      
      
      		fin
      
      	Fin
      	si hlitrecherche(FclientExtra,IdClientNoProduit,HConstruitValClé(FclientExtra,IdClientNoProduit,_IDclient,sansespace(requeteperso.epbase))) et fclientextra.prixSpecial ALORS
      		special=vrai
      		si NbThermos = 2 alors
      			PrixTotal+= arrondi(FclientExtra.PrixAnglaisD,2)
      			PrixTotalM+= arrondi(FclientExtra.PrixmetriqueD,2)
      		sinon si NbThermos = 3
      			PrixTotal+= arrondi(fclientextra.PrixAnglaisT,2)
      			PrixTotalM+= arrondi(fclientextra.PrixMetriqueT,2)
      		FIN
      	sinon
      		si hlitrecherche(invent,INUM,requeteperso.epbase) alors
      			si  NbThermos = 2  alors
      				PrixTotal+= arrondi(invent.IPRIXDOUBLE,2)
      				PrixTotalM+= arrondi(invent.IPRIXDOUBLEM,2)
      			sinon si  NbThermos = 3 
      				PrixTotal+= arrondi(invent.iprixtriple,2)
      				PrixTotalM+= arrondi(invent.iprixtripleM,2)
      
      			FIN
      		fin
      	FIN
      //fin
      
      
      
      renvoyer NumériqueVersChaine(PrixTotal)+","+numeriqueverschaine(PrixTotalM) + "," + special
     type : 458752
   -
     name : CalculPrixThermosRefresh
     procedure_id : 5858940824464831659
     type_code : 14
     code : |1-
      Procédure CalculPrixThermosRefresh(_Ligne,_NoLigne)
      resultat est un reel = 0
      NbThermos est un entier = 0
      Extra est une chaine
      ExtraT est une chaine
      PrixTotal est un reel = 0
      PrixTotalM est un reel = 0
      special est un booleen = faux
      _ligneTable est un entier
      _ligneatraiter est une chaine
      _ligneacalculer est une chaine
      
      _base est un booleen = val(extraitchaine(_Ligne,3,tab))
      
      
      NoProduit est une chaine = extraitchaine(_Ligne,1,tab)
      
      
      
      //si hlitrecherche(persoens,ennumero,nothermos) ALORS
      si table1.Tencomp1[_NoLigne] <> "" alors
      	NbThermos++
      	si table1.Tencomp1[_NoLigne] <> NoProduit  alors
      		_ligneTable = TableCherche(Table_Extra.PPRODUIT, table1.Tencomp1[_NoLigne])
      		si lignetable <> -1 alors
      			_ligneatraiter = table_extra[ligneTable]			
      		FIN
      	sinon 
      		_ligneatraiter = _Ligne
      	fin
      
      
      	si pas val(extraitchaine(_ligneatraiter,3,tab)) alors
      		Extra = ExtraitChaîne(_ligneatraiter,10,tab)
      		ExtraT = ExtraitChaîne(_ligneatraiter,11,tab)
      		si sansespace(Extra) <> "" ALORS
      			si Extra <> NoProduit alors
      				_ligneTable = TableCherche(Table_Extra.PPRODUIT, Extra)
      				si lignetable <> -1 alors
      					_ligneacalculer = table_extra[ligneTable]			
      				FIN
      			sinon
      				_ligneacalculer=_ligneatraiter
      			fin
      		fin
      		PrixTotal+=val(extraitchaine(_ligneacalculer,4,tab))
      		PrixTotalM+=Val(extraitchaine(_ligneacalculer,6,tab))
      		special=Val(extraitchaine(_ligneacalculer,3,tab))
      		
      		si sansespace(ExtraT) <> "" ALORS
      			si ExtraT <> NoProduit alors
      				_ligneTable = TableCherche(Table_Extra.PPRODUIT, ExtraT)
      				si lignetable <> -1 alors
      					_ligneacalculer = table_extra[ligneTable]			
      				FIN
      			sinon
      				_ligneacalculer=_ligneatraiter
      			fin
      		fin
      		PrixTotal+=val(extraitchaine(_ligneacalculer,4,tab))
      		PrixTotalM+=Val(extraitchaine(_ligneacalculer,6,tab))
      		special=Val(extraitchaine(_ligneacalculer,3,tab))
      	fin	
      
      fin
      
      
      
      
      
      
      
      //si hlitrecherche(FclientExtra,IdClientNoProduit,HConstruitValClé(FclientExtra,IdClientNoProduit,_IdClient,sansespace(persoens.epbase))) et fclientextra.prixSpecial ALORS
      //	special=vrai
      //	si NbThermos = 2 alors
      //		PrixTotal+= arrondi(FclientExtra.PrixAnglaisD,2)
      //		PrixTotalm+= arrondi(FclientExtra.PrixmetriqueD,2)
      //	sinon si NbThermos = 3
      //		PrixTotal+= arrondi(fclientextra.PrixAnglaisT,2)
      //		PrixTotalm+= arrondi(fclientextra.PrixMetriqueT,2)
      //	FIN
      //sinon
      //	si hlitrecherche(invent,INUM,persoens.epbase) alors
      //		si  NbThermos = 2  alors
      //			PrixTotal+= arrondi(invent.IPRIXDOUBLE,2)
      //			PrixTotalm+= arrondi(invent.IPRIXDOUBLEM,2)
      //		sinon si  NbThermos = 3 
      //			PrixTotal+= arrondi(invent.iprixtriple,2)
      //			PrixTotalm+= arrondi(invent.iprixtripleM,2)
      //
      //		FIN
      //	fin
      //FIN
      //fin
      
      
      
      renvoyer NumériqueVersChaine(PrixTotal)+","+numeriqueverschaine(PrixTotalM) + "," + special
     type : 458752
