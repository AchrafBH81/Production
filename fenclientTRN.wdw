               si  BTN_AddComponent..etat <> actif alors renvoyer faux
               SI TableInfoXY(TABLE_ForbiddenComponent,tiNumColonne,SourisPosX(),SourisPosY()) = 3 ET TableInfoXY(TABLE_ForbiddenComponent,tiNumLigne,SourisPosX(),SourisPosY()) = TableSelect(TABLE_ForbiddenComponent) ALORS
