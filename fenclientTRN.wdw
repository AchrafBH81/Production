          type : 9
          controls : []
          code_elements :
           type_code : 9
           p_codes :
            -
              code : |1+
               
               
               HLITPREMIER("client",cleparcours)
               HFiltreIdentique("inter","iclient",cl.numero)
               HFiltreIdentique(interclient,iDClient,client.IDClient)
               HFILTRE("spqte","spqclientproduit",CL.NUMERO+caract(0),CL.NUMERO+caract(255))
               HFILTRE("surchint","cleclientinter",CL.NUMERO+caract(0),CL.NUMERO+caract(255))
               hfiltre(ArchiveEmail,noClientdateEmail,client.numero,client.numero)
               
               tableaffiche("TABLE_1",taDebut)
               
               tableaffiche("TABLE_2",taDebut)
               
               tableaffiche("TABLE_10",taDebut)
               
               
               
              type : 14
            -
              type : 35
              enabled : false
            -
              code : |1+
               hfiltreidentique("inter","iclient",cl.numero)
               HFiltreIdentique(interclient,iDClient,client.IDClient)
               HFILTRE("spqte","spqclientproduit",CL.NUMERO+caract(0),CL.NUMERO+caract(255))
               
               HFILTRE("surchint","cleclientinter",CL.NUMERO+caract(0),CL.NUMERO+caract(255))
               
               TableSupprimeTout(Table_ArchiveEmail)
               dTempodate est une Date = datesys()
               dTempodate..Mois-= SAI_NbMoisCourriel
               SI HExécuteRequêteSQL(reqSql,hRequêteDéfaut,ChaîneConstruit(TxtSql,Complète(client.numero,10),dtempodate)) ALORS
               	FichierVersTableMémoire(Table_ArchiveEmail,reqSql)
               FIN
               
               tableaffiche("TABLE_1",taDebut)
               
               tableaffiche("TABLE_2",taDebut)
               
               
               tableaffiche("TABLE_10",taDebut)
               
               FillTableForbiddenComponent()
               
              type : 19
            -
              type : 22
              enabled : false
            -
              type : 24
              enabled : false
            -
              type : 23
              enabled : false
            -
              type : 25
              enabled : false
            -
              code : |1-
               //info(cl.numero)
               sablier(vrai)
               HLitRecherche(Client,numero,TABLE.NUMERO_1[TABLE])
               FichierVersEcran(fenclienttrn,client)
               
               si client.cBolqueLivraison alors
               	BTN_ETATBARRE..visible = vrai
               sinon
               	BTN_ETATBARRE..visible = faux
               
               FIN
               lignetable est un entier
               hfiltreidentique("inter","iclient",cl.numero)
               hfiltre(InterClient,iClient,client.IDClient)
               HFILTRE("spqte","spqclientproduit",CL.NUMERO+caract(0),CL.NUMERO+caract(255))
               HFILTRE("surchint","cleclientinter",CL.NUMERO+caract(0),CL.NUMERO+caract(255))
               hfiltre(ArchiveEmail,noClientdateEmail,client.numero,client.numero)
               
               tableaffiche("TABLE_1",taDebut)
               tableaffiche("TABLE_2",taDebut)
               tableaffiche("TABLE_10",taDebut)
               TableAffiche(table_archiveemail,taDébut)
               TableSupprimeTout(table_1)
               TableSupprimeTout(tablepeinture)
               TableSupprimeTout(table_extra)
               TableSupprimeTout(table1)
               
               
               hexecuterequete(RequeteProduitClient)
               remplir_table_produit()
               remplir_table_forme()
               remplir_table_Couleur()
               remplir_TableExtra()
               hexecuterequete(RequeteClientProduit,hRequêteDéfaut,sansespace(client.numero))
               hlitpremier(RequeteClientProduit)
               
               tantque pas hendehors(RequeteClientProduit)
               	lignetable = tablecherche(table_1.pproduit,Requeteclientproduit.Idproruit) 
               	si lignetable <> -1 alors
               		si RequeteClientProduit.IPprixSpecial alors
               			selon table_1.Ptype[lignetable]
               				cas 1
               					table_1.pprixa[lignetable] = Requeteclientproduit.IPrixa
               				cas 2,5
               					table_1.pprixa[lignetable] = Requeteclientproduit.iprixa
               					table_1.pprixm[lignetable] = Requeteclientproduit.iprixm
               				cas 4
               					table_1.pprixa[lignetable] = Requeteclientproduit.iprixa
               					table_1.pprixm[lignetable] = Requeteclientproduit.iprixm
               					table_1.PrixCarrPC[lignetable] = Requeteclientproduit.IPrixCarrPiedCarre
               					table_1.PrixcarrM[lignetable] = Requeteclientproduit.IPrixCarrMetCarre
               
               
               
               			fin
               		fin
               		table_1.Cimprime[lignetable] = RequeteClientProduit.IlisteDePrix
               		table_1.Cspecial[lignetable] = RequeteClientProduit.IPprixSpecial
               
               	fin
               
               	hlitsuivant(Requeteclientproduit)
               FIN
               
               
               
               
               
               /////////////////
               // forme
               /////////////////
               
               hexecuterequete(Requeteformeclient,hRequêteDéfaut,sansespace(client.numero))
               hlitpremier(RequeteFormeClient)
               tantque pas hendehors(RequeteFormeClient)
               	lignetable = tablecherche(tableforme.fforme,RequeteFormeClient.NoForme) 
               
               	si lignetable <> -1 alors
               		si Requeteformeclient.fPrixSpecial alors
               			Tableforme.fPrixdouble[lignetable] = RequeteFormeClient.fPrixdouble
               			Tableforme.fPrixtriple[lignetable] = RequeteFormeClient.FpRixtriple
               		fin
               		Tableforme.fspecial[lignetable] = RequeteFormeClient.fPrixSpecial
               		Tableforme.fimprime[lignetable] = RequeteFormeClient.fListePrix
               	fin
               	hlitsuivant(RequeteFormeClient)
               fin
               
               //////////////////////////////////
               
               
               
               /////////////////
               // Couleur
               /////////////////
               
               hexecuterequete(RequeteCouleurClient,hRequêteDéfaut,sansespace(client.numero))
               hlitpremier(RequetecouleurClient)
               tantque pas hendehors(RequetecouleurClient)
               	lignetable = tablecherche(TableCouleurExtra.coulnum,RequetecouleurClient.NoCouleur) 
               
               	si lignetable <> -1 alors
               		TableCouleurExtra.coulextralineaire[lignetable] = RequeteCouleurClient.fcExtra
               		TableCouleurExtra.coulextralineairem[lignetable] = RequeteCouleurClient.fcextralineaireM
               		TableCouleurExtra.coulextraunite[lignetable] = RequeteCouleurClient.fcextraunite
               		TableCouleurExtra.coulextracarreau[lignetable] = RequeteCouleurClient.fcExtracarreau
               
               		TableCouleurExtra.Coulspecial[lignetable] = vrai
               	fin
               	hlitsuivant(RequetecouleurClient)
               fin
               
               //////////////////////////////////
               
               
               
               
               
               
               
               
               tableaffiche(table_1,taCourantPremier)
               
               remplir_table_thermos()
               
               
               
               HExécuteRequête(RequeteTypecarr)
               fichierverstablememoire(tablevariablex,requetetypecarr)
               HExécuteRequête(RequeteTypeCarrClient,hRequêteDéfaut,sansespace(client.numero))
               
               hlitpremier(RequeteTypeCarrClient)
               tantque pas hendehors(RequeteTypeCarrClient)
               	lignetable = tablecherche(tablevariablex.Type_de_calcul,RequeteTypeCarrClient.TypeCalcul) 
               
               	si lignetable <> -1 alors
               		TableVariableX.VariableX[lignetable] = RequeteTypeCarrClient.VariableX
               		TableVariableX.VariableX1[lignetable] = RequeteTypeCarrClient.VariableX1
               
               	FIN
               	hlitsuivant(RequeteTypeCarrClient)
               FIN
               tableaffiche(tablevariablex,taCourantPremier)
               
               RequeteClientExtra.pIdClient = client.IDClient
               RequeteClientExtra.pListeDePrix = null
               RequeteClientExtra.pSpecial = null
               
               HExécuteRequête(RequeteClientExtra)
               hlitpremier(requeteclientextra)
               tantque pas hendehors(requeteclientextra)
               	lignetable = tablecherche(table_extra.PPRODUIT,requeteclientextra.NoProduit) 
               
               	si lignetable <> -1 alors
               		si Table_Extra.cModifiable[lignetable]
               			table_extra.Cspecial[lignetable] = RequeteClientExtra.prixSpecial
               			si RequeteClientExtra.prixSpecial alors
               				si RequeteClientExtra.Pbase alors
               					Table_Extra.PPRIXD[lignetable]  = RequeteClientExtra.PrixAnglaisD
               					Table_Extra.PPRIXT[lignetable]  = RequeteClientExtra.PrixAnglaisT
               					Table_Extra.PPRIXDM[lignetable] = RequeteClientExtra.PrixMetriqueD
               					Table_Extra.PPRIXTM[lignetable] = RequeteClientExtra.PrixMetriqueT
               				sinon
               					Table_Extra.PPRIXD[lignetable]  = RequeteClientExtra.PrixAnglais
               					Table_Extra.PPRIXDM[lignetable] = RequeteClientExtra.PrixMetrique
               				FIN
               			fin
               
               		fin
               	table_extra.Cimprime[lignetable] = RequeteClientExtra.ListeDePrix
               FIN
               hlitsuivant(RequeteclientExtra)
               FIN
               tableaffiche(table_extra,taCourantPremier)
               remplirTableGarantie()
               
               ExécuteTraitement(CboMessage,trtSélection)
               sablier(faux)
               
               // jour livraison
               GetInfoLivraison(client.IDClient)
               
               FillTableForbiddenComponent()
               ListeSelectPlus(Combo_SaisonLivraison,1)
               ExécuteTraitement(CLI_ONGLET.Combo_SaisonLivraison,trtSélection)
