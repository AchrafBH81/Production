  -
    name : BtnSave
    identifier : 0x2cf460462cae57a7
    internal_properties : 
    properties :
     x : 384
     y : 842
     width : 20
     height : 20
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         jliv est un entier
         POUR i = 1 A 7
         	
         	jliv += (JoursLivraison[i] ? 1 SINON 0) * Puissance(2,i-1)
         	//	JourLivraisonClient.IDCamions[i] = {"Combo_Camion"+i}..valeur
         FIN
         si minuscule(champencours()) = "btnsave" alors
         	si hlitrecherche(JourLivraisonClient,IDClientIDSaisonLivraison,[client.IDClient,Combo_SaisonLivraison]) alors
         		JourLivraisonClient.JourLivraison = jliv
         		POUR i = 1 A 7
         			si JoursLivraison[i] alors
         				si {"Combo_Camion"+i,indChamp}..Valeur <= 0 alors
         					erreur("Aucun camion associé à " + JoursLivraison[i]..Libellé)
                             JoursLivraison[i]=faux
         				sinon
         					JourLivraisonClient.IDCamions[i] = {"Combo_Camion"+i,indChamp}..Valeur
         					
         				fin
         			sinon
         				JourLivraisonClient.IDCamions[i] = 0
         				
         			FIN
         			
         		FIN
         		Hmodifie(JourLivraisonClient)
         	sinon
         		hraz(JourLivraisonClient)
         		JourLivraisonClient.IDClient = client.IDClient
         		JourLivraisonClient.IDSaisonLivraison = Combo_SaisonLivraison
         		JourLivraisonClient.JourLivraison = jliv
         		POUR i = 1 A 7
         			SI JoursLivraison[i] ALORS
         				SI {"Combo_Camion"+i,indChamp}..Valeur <= 0 ALORS
         					Erreur("Aucun camion associé à " + JoursLivraison[i]..Libellé)
         					JoursLivraison[i]=Faux
         				SINON
         					JourLivraisonClient.IDCamions[i] = {"Combo_Camion"+i,indChamp}..Valeur
         					
         				FIN
         			SINON
         				JourLivraisonClient.IDCamions[i] = 0
         				
         			FIN
         			
         		FIN
         		hajoute(JourLivraisonClient)
         	FIN
         fin
        type : 18
      -
        type : 161
        enabled : false
