                        //					cas 1
                        						table_1.PPRIXA[table_1] = invent.iprixPeinture
                        						table_1.PPRIXm[table_1] = invent.iprixpeintureM
                        
                        //					cas 2	
                        //						table_1.PPRIXA[table_1] = invent.iprixPeinture
                        //						table_1.PPRIXm[table_1] = invent.iprixpeintureM
                        //				fin
                        		FIN
                        	FIN
                        FIN
