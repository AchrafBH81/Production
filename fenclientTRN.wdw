                    code : |1+
                     //hfiltre("speciaux","numero",client.numero)
                     pdesc..couleur = ibleuclair
                     pproduit..couleur = ibleuclair
                     
                    type : 14
                  -
                    type : 35
                    enabled : false
                  -
                    code : |1+
                     si table_1 <> -1 alors
                     //	si intervalle[table_1] = vrai alors
                     //		//Code WinDev 5.5 remplacé par la migration :
                     //		//     TABLEAFFICHE("TABLE_3","I")
                     //		TABLEAFFICHE("TABLE_3",taDebut)
                     //		//Code WinDev 5.5 remplacé par la migration :
                     //		//	 table_3..etat = inactif
                     //		table_3..etat = AffichageSeulement; table_3..Visible=Vrai
                     //	sinon
                     //		//Code WinDev 5.5 remplacé par la migration :
                     //		//	 table_3..VISIBLE = FAUX
                     //		table_3..Visible=Faux
                     //	fin		 
                     fin
                    type : 19
                  -
                    code : |1+
                     si table_1.PrixMdisp[TABLE_1] ALORS
                     	TABLE_1.PPRIXM[TABLE_1]..ETAT = ACTIF
                     sinon	
                     	TABLE_1.PPRIXM[TABLE_1]..ETAT = inactif
                     FIN
                     si pas client.CalculCarrPied ou ptype[table_1] <> 4 alors
                     	PrixCarrPC[table_1]..etat = inactif
                     	PrixCarrm[table_1]..etat = inactif
                     	PrixCarrPC[table_1]..couleurfond = igrisfonce
                     	PrixCarrm[table_1]..couleurfond = igrisfonce
                     
                     sinon
                     	PrixCarrPC[table_1]..etat = actif
                     	PrixCarrm[table_1]..etat = actif
                     
                     FIN
                    type : 21
                  -
                    type : 22
                    enabled : false
                  -
                    type : 24
                    enabled : false
                  -
                    type : 23
                    enabled : false
                  -
                    type : 25
                    enabled : false
                  -
                    code : |1+
                     
                     si table_1 <> -1 alors
                     //	si intervalle[table_1] = vrai alors
                     //		//Code WinDev 5.5 remplacé par la migration :
                     //		//     TABLEAFFICHE("TABLE_3","I")
                     //		TABLEAFFICHE("TABLE_3",taDebut)
                     //		//Code WinDev 5.5 remplacé par la migration :
                     //		//	 table_3..etat = inactif
                     //		table_3..etat = AffichageSeulement; table_3..Visible=Vrai
                     //	sinon
                     //		//Code WinDev 5.5 remplacé par la migration :
                     //		//	 table_3..VISIBLE = FAUX
                     //		table_3..Visible=Faux
                     //	fin		 
                     	si pas client.CalculCarrPied ou ptype[table_1] <> 4 alors
                     		PrixCarrPC[table_1]..etat = inactif
                     		PrixCarrm[table_1]..etat = inactif
                     	sinon
                     		PrixCarrPC[table_1]..etat = actif
                     		PrixCarrm[table_1]..etat = actif
                     
                     	FIN
                     fin
                     
                     selon table_1.PTYPE[TABLE_1]
                     	CAS 1
                     		TABLE_1.PPRIXA..LIBELLE = "Prix"
                     		TABLE_1.PPRIXm..LIBELLE = ""
                     		table_1.pprixm[table_1]..couleurfond = igrisfonce 	
                     		table_1.pprixm[table_1]..etat = inactif 
                     		table_1..Hauteur = table_1..HauteurInitiale
                     		GrpCouleur..visible = faux
                     		GrpCouleur..etat =inactif
                     		TableProduitCouleur..visible = faux
                     	cas 2
                     		TABLE_1.PPRIXA..LIBELLE = "Prix Anglais"
                     		TABLE_1.PPRIXm..LIBELLE = "Prix Métrique	"
                     		table_1.pprixm[table_1]..etat = actif 
                     		table_1..Hauteur = table_1..HauteurInitiale
                     		GrpCouleur..visible = faux
                     		GrpCouleur..etat =inactif
                     		TableProduitCouleur..visible = faux
                     
                     	cas 4
                     		TABLE_1.PPRIXA..LIBELLE = "Prix Carreau"
                     		TABLE_1.PPRIXm..LIBELLE = "Prix de Base"
                     		table_1.pprixm[table_1]..etat = actif 
                     		table_1..Hauteur = table_1..HauteurInitiale
                     		GrpCouleur..visible = faux
                     		GrpCouleur..etat =inactif
                     		TableProduitCouleur..visible = faux
                     	cas 5
                     		TABLE_1.PPRIXA..LIBELLE = "Prix Anglais"
                     		TABLE_1.PPRIXm..LIBELLE = "Prix Métrique	"
                     		table_1.pprixm[table_1]..etat = actif 
                     		selon table_1.ttypepeinture[table_1]
                     			cas 1
                     				table_1..Hauteur = 285
                     				GrpCouleur..visible = vrai
                     				GrpCouleur..etat =actif
                     				TableProduitCouleur..visible = vrai
                     				TableProduitCouleur..etat = inactif
                     			autre cas
                     				table_1..Hauteur = table_1..HauteurInitiale
                     				GrpCouleur..visible = faux
                     				GrpCouleur..etat =inactif
                     				TableProduitCouleur..visible = faux
                     		FIN
                     		remplirtableCouleurProduit(client.numero,table_1.PPRODUIT[table_1])
                     
                     FIN
                     
                     
                     
                     
                    type : 33
