        -
          name : BTN_SurchargeAjoutModif
          identifier : 0x2aa98cc3df9a3258
          internal_properties : 
          properties :
           x : 487
           y : 36
           width : 121
           height : 24
          type : 4
          code_elements :
           type_code : 4
           p_codes :
            -
              code : |1+
               HCréationSiInexistant(PrixSurchargeClient)
               
               nLigne est un entier = TableSelect(Table1)
               
               SI nLigne <= 0 ALORS
               	Info("Sélectionnez un thermos.")
               	RETOUR
               FIN
               
               SI Client.IDClient <= 0 ALORS
               	Info("Sélectionnez un client enregistré.")
               	RETOUR
               FIN
               
               sThermos est une chaîne = Table1.Tennumero[nLigne]
               
               SI sThermos = "" ALORS
               	Info("Le numéro du thermos est vide.")
               	RETOUR
               FIN
               
               si Ouvre(FEN_PrixSurchargeClient, Client.IDClient, sThermos) ALORS
               	
               	remplir_table_thermos()
               FIN
              type : 18
            -
              type : 161
              enabled : false
        -
          name : BTN_SurchargeSupprimer
          identifier : 0x2aa98d13dfa66b55
          internal_properties : 
          properties :
           x : 624
           y : 36
           width : 143
           height : 24
          type : 4
          code_elements :
           type_code : 4
           p_codes :
            -
              code : |1+
               nLigne est un entier = TableSelect(Table1)
               
               SI nLigne <= 0 ALORS
               	Info("Sélectionnez un thermos.")
               	RETOUR
               FIN
               
               SI Client.IDClient <= 0 ALORS
               	Info("Sélectionnez un client enregistré.")
               	RETOUR
               FIN
               
               
               HLitRecherchePremier(PrixSurchargeClient,IDClientennumero, [client.IDClient,Complète(Table1.Tennumero[nLigne],20)], hIdentique)
               
               SI HErreur() <> 0 ALORS
               	Erreur("Impossible de lire la surcharge.", HErreurInfo())
               	RETOUR
               FIN
               
               SI PAS HTrouve(PrixSurchargeClient) ALORS
               	Info("Aucune surcharge n'existe pour ce client et ce thermos.")
               	RETOUR
               FIN
               
               SI PAS HSupprime(PrixSurchargeClient) ALORS
               	Erreur("Impossible de supprimer la surcharge.", HErreurInfo())
               	RETOUR
