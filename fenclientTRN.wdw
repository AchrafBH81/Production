          type : 9
          controls : []
          code_elements :
           type_code : 9
           p_codes :
            -
              code : |1+
               
               HLITPREMIER("surchint","cleclientinter")
               
              type : 14
            -
              code : |1+
               snumero = client.numero
               //si pas TABLE_10..Nouveau alors
               	// Bloque la ligne en cours
               //	si pas RADBloque(Faux) alors
               		// Blocage non effectué
               //		Table_10..Etat=Inactif	// La table est inactive
               //	sinon
               //		Table_10..Etat=Actif
               //	fin
               //fin
               
              type : 19
            -
              code : |1+
               
               si table_10..Modifie alors
               	si table_10..Nouveau alors
               		TableEnregistre("table_10")
               		// Le test hDoublon est inutile si le fichier n'a pas de clé unique
               //Code WinDev 5.5 remplacé par la migration :
               //		si HDoublon() alors
               		si HErreurDoublon() alors
               			Erreur("L'enregistrement ne peut être ajouté au fichier.",...
               			       "Un enregistrement contient déjà le même identifiant")
               		fin
               //		si HErrIntegrite() alors
               //			Erreur("Erreur d'intégrité")
               //			Retour
               //		Fin
               		// Pour effectuer une saisie en chaine
               		// On utilise la fonction TableAjoute
               //		TableAjoute("table_10")
               	sinon
               		// Modification
               		TableEnregistre("table_10")
               		// Le test hDoublon est inutile si le fichier n'a pas de clé unique
               //Code WinDev 5.5 remplacé par la migration :
               //		si HDoublon() alors
               		si HErreurDoublon() alors
               			Erreur("L'enregistrement ne peut être modifié.",...
               			       "Un enregistrement contient déjà le même identifiant.")
               		fin
               	fin
               fin
               
