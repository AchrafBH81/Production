  -
    name : BTN_MODIFIE
    identifier : 0x514f23a36f87b537
    internal_properties : 
    properties :
     x : 334
     y : 1
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         
         selon gLogCompt
         	cas "Acomba" 
         		si cli_onglet = 1 ou cli_onglet = 12 alors 
         			ouvre(creationclient,"M","Acomba")
         			si CLI_ONGLET = 1 alors
         			TableAffiche(table,taCourantPremier)
         		sinon
         			TableAffiche(tableinactif,taCourantPremier)
         
         			fin
         			
         		sinon
         			restaure_bouton()
         			si cli_onglet = 1 alors 
         				cli_onglet = 2
         			fin
         			btn_sortie..etat = grisé; btn_sortie..Visible=Vrai
         			cli_onglet[1]..etat = AffichageSeulement; cli_onglet[1]..Visible=Vrai
         			cli_onglet[11]..etat = AffichageSeulement; cli_onglet[11]..Visible=Vrai
         			fichierversecran
         			navigation..etat = GRISé; navigation..Visible=Vrai
         			validation..etat = actif; validation..Visible=Vrai
         			identifiant..etat = AffichageSeulement; identifiant..Visible=Vrai
         			prix..etat = actif; prix..Visible=Vrai
         			prix_option..etat = actif; prix_option..Visible=Vrai
         			fiche..etat = grisé; fiche..Visible=Vrai
         			affichage..etat = grisé; affichage..Visible=Vrai
         			modif = vrai
         			saisie_prix..etat = actif; saisie_prix..Visible=Vrai
         			grppeinture..visible = faux
         			TABLE_10..ETAT = ACTIF; TABLE_10..Visible=Vrai
         			TABLE1..ETAT = ACTIF
         			table_1..etat = actif
         			TablePeinture..etat = actif
         			TableCouleurExtra..etat = actif
         			Table_Extra..etat = actif
         			Tableforme..etat = actif
         			TableVariableX..etat = actif
         			nom..etat = actif
         		fin
         	cas "Cameleon","Aucun"
         		si cli_onglet = 1 alors 
         			ouvre(creationclient,"M")
         				TableAffiche(table,taCourantBandeau)
         			
         		sinon
         			btn_sortie..etat = grisé; btn_sortie..Visible=Vrai
         			cli_onglet[1]..etat = AffichageSeulement; cli_onglet[1]..Visible=Vrai
         			cli_onglet[11]..etat = AffichageSeulement; cli_onglet[11]..Visible=Vrai
         			fichierversecran
         			navigation..etat = GRISé; navigation..Visible=Vrai
         			validation..etat = actif; validation..Visible=Vrai
         			identifiant..etat = AffichageSeulement; identifiant..Visible=Vrai
         			prix..etat = actif; prix..Visible=Vrai
         			prix_option..etat = actif; prix_option..Visible=Vrai
         			fiche..etat = grisé; fiche..Visible=Vrai
         			affichage..etat = grisé; affichage..Visible=Vrai
         			modif = vrai
         			saisie_prix..etat = actif; saisie_prix..Visible=Vrai
         			TABLE_10..ETAT = ACTIF; TABLE_10..Visible=Vrai
         			TABLE1..ETAT = ACTIF
         			table_1..etat = actif
         			TablePeinture..etat = actif
         			TableCouleurExtra..etat = actif
         			Tableforme..etat = actif
         			TableVariableX..etat = actif
         			Table_Extra..etat = actif
         			nom..etat = actif
         
         			pour i = 1 a 7
         				{"Combo_camion"+i,indChamp}..Etat = (JoursLivraison[i] ? Actif SINON AffichageSeulement)
         				{"saisequence"+i,indChamp}..Etat = (JoursLivraison[i] ? Actif SINON AffichageSeulement)
         				
         			FIN
         		fin
         fin
         
         ExécuteTraitement(table_1,trtSélection)
         si calendrier1..visible alors calendrier1..etat = Actif
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_DETRUIRE
    identifier : 0x514f23a334a3b537
    internal_properties : 
    properties :
     x : 383
     y : 1
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         restaure_bouton()
         si acso_message("Question","Voulez-vous annuler ce client","OuiNon") = idyes alors
         sablier(vrai)
         
         	pour tout ProduitClient avec "IdClient = '"+sansespace(client.numero)+"'"
         		hsupprime(produitclient,hNumEnrEnCours)
         	FIN
         	pour tout formeClient avec "noClient = '"+sansespace(client.numero)+"'"
         
         		hsupprime(formeclient,hNumEnrEnCours)
         	FIN
         	pour tout FClientProduitCouleur avec"noClient = '"+sansespace(client.numero)+"'"
         		hsupprime(FClientProduitCouleur,hNumEnrEnCours)
         	fin
         
         	pour tout fcouleurClient avec "noClient = '"+sansespace(client.numero)+"'"
         		hsupprime(fcouleurclient,hNumEnrEnCours)
         	FIN
         	pour tout thermosClient avec "idClient = '"+sansespace(client.numero)+"'"
         		hsupprime(thermosclient,hNumEnrEnCours)
         	FIN
         	pour tout variablexClient avec "noClient = '"+sansespace(client.numero)+"'"
         		hsupprime(VariableXclient,hNumEnrEnCours)
         	FIN
         	pour tout inter avec "iClient = '"+sansespace(client.numero)+"'"
         		hsupprime(inter,hNumEnrEnCours)
         	FIN
         	pour tout surchint aVEC "numero = '"+client.numero+"'"
         		hsupprime(surchint,hNumEnrEnCours)
         	FIN
         
         
         	hsupprime(client)
         
         	sablier(faux)
         FIN
         ExécuteTraitement(SelClient,trtModification)
        type : 18
      -
        type : 161
        enabled : false
