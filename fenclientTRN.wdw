             identifier : 0x514f23a31c0ab4e7
             internal_properties : CQAAAAkAAAAD/XVdvTOyDYrugX1Gq/nDZe0X/qlScDlDXhGJs9JvKrZ3MMMSiHqo/Xn7MtJytvSX7Y1fVNi7fM+KE4JKRcPu+ZnStrJDjBX/d0vq4vlL/k/1+dEpz/R3wgcPkQav66ze+yYWRWwj5TjaM6UXNiBAsJXpfz8SuQ35bfah6F5pd4dW3I5m8o5sSUuFVCICib6XcEtM6rmiNX69IOXfWn9+zQj8Gznl2YMBvTyWlT3nMYtc8A==
             type : 2
             content :
              internal_properties : 
              properties : {}
              type : 2
             code_elements :
              internal_properties : CQAAAAkAAACVbIAZKIyLUtOx/TRl3LdawH8KiRIbZVPHIi3CQG0ZQWORAsfR1LV9KK1m6uVL3Trxd5kjIU0MB2uWkg==
              type_code : 3
              p_codes :
               -
                 code : |1+
                  lValeurOriginale = moimeme
                  
                 type : 15
               -
                 code : |1+
                  si PPRIXD <> 0 alors
                  	table_extra.PPRIXDM = moimeme * CONFIG.conversionam
                  	si table_extra.PBASE alors
                  		si table_extra.cRatio <> 0 alors
                  			Table_Extra.pprixt = moimeme * cratio
                  			ExécuteTraitement(Table_Extra.PPRIXT,trtSortie)
                  		FIN
                  	FIN
                  	si moimeme <> lvaleuroriginale alors
                  		table_extra.Cspecial[table_extra] = vrai
                  	fin
                  sinon
                  	si moimeme <> lvaleuroriginale alors
                  
                  		si acso_message("Question","Vous avez inscrit 0 comme valeur "+rc+"Voulez-vous continuer avec cette valeur","OuiNon") = idyes alors
                  			table_extra.PPRIXDM = moimeme * CONFIG.conversionam
                  			table_extra.Cspecial[table_extra] = vrai
                  		sinon
                  			moimeme = lvaleuroriginale
                  			reprisesaisie()
                  		FIN
                  	fin
                  fin
                 type : 16
               -
                 type : 276
                 enabled : false
