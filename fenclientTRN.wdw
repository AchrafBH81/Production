               si Table_Extra <> -1 alors
               	si Table_Extra.PBASE[Table_Extra] <> 1 alors
               		Table_Extra.PPRIXD..Libellé = "Prix Unit. A."   
               		Table_Extra.PPRIXT..Libellé = ""   
               		Table_Extra.PPRIXDM..Libellé = "Prix Unit. M."   
               		Table_Extra.PPRIXTM..Libellé = ""  
               		Table_Extra.PPRIXT[Table_Extra]..etat = inactif
               		Table_Extra.PPRIXTM[Table_Extra]..etat = inactif
               		si pas Table_Extra.cModifiable[Table_Extra] alors
               			Table_Extra.Cspecial[table_extra]..etat = inactif
               			Table_Extra.PPRIXD[Table_Extra]..etat = inactif
               			Table_Extra.PPRIXDM[Table_Extra]..etat = inactif
               		sinon
               			Table_Extra.Cspecial[table_extra]..etat = actif
               			Table_Extra.PPRIXD[Table_Extra]..etat = actif
               			Table_Extra.PPRIXDM[Table_Extra]..etat = actif
               		fin
               	sinon
               		Table_Extra.PPRIXD..Libellé = 	"Prix Double A."
               		Table_Extra.PPRIXDM..Libellé = "Prix Double M."   
               		Table_Extra.PPRIXT..Libellé = "Prix Triple A."  
               		Table_Extra.PPRIXTM..Libellé = "Prix Triple M."
               	fin
               
               fin
               
               
               
               
               
               
