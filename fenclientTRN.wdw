                        	FClientProduitCouleur.fcextraunite = TableProduitCouleur.cExtracouleur[TableProduitCouleur]
                        	FClientProduitCouleur.noClient = sansespace(table.NUMERO_1[table])
                        	FClientProduitCouleur.NoProduit = sansespace(table_1.PPRODUIT[table_1])
                        	hajoute(FClientProduitCouleur)
                        sinon
                        
                        	si hlitrecherche(FClientProduitCouleur,IDFCouleurClient,TableProduitCouleur.idClientProduit[TableProduitCouleur]) alors
                        		FClientProduitCouleur.NoCouleur = TableProduitCouleur.cNoCouleur[TableProduitCouleur]
                        		FClientProduitCouleur.fcdesccouleur = TableProduitCouleur.cDescCouleur[TableProduitCouleur]
                        		FClientProduitCouleur.fcextraunite = TableProduitCouleur.cExtracouleur[TableProduitCouleur]
                        		FClientProduitCouleur.noClient = sansespace(table.NUMERO_1[table])
                        		FClientProduitCouleur.NoProduit = sansespace(table_1.PPRODUIT[table_1])
                        		hmodifie(FClientProduitCouleur,hNumEnrEnCours)		
                        	FIN
                        FIN
                        fin
                        
                        TableProduitCouleur..etat = inactif
                        remplirtableCouleurProduit(sansespace(table.NUMERO_1[table]),table_1.PPRODUIT[table_1])
                        
                        
