                       internal_properties : CQAAAAkAAADZvWx7N04Ani6QsNIAD7/3Hg/t7SCF2bx2IaVjkjXz3Ke1ob84s1r5eL5hgzRFaLoEGE/s4cUC
                    type : 5
                   code_elements :
                    internal_properties : CQAAAAkAAACVbIAZKIyLUtOx/TRl3LdawH8KiRIbZVPHIi3CQG0ZQWORAsfR1LV9KK1m6uVL3Trxd5kjIU0MB2uWkg==
                    type_code : 5
                    p_codes :
                     -
                       code : |1+
                        si moimeme alors
                        sinon
                        	si hlitrecherche(invent,INUM,table_1.PPRODUIT[table_1]) alors
                        		selon table_1.Ptype[table_1]
                        			cas 1
                        				table_1.PPRIXA[table_1] = invent.IPRIXA
                        			cas 2
                        				table_1.PPRIXA[table_1] = invent.IPRIXunitaire
                        				table_1.PPRIXm[table_1] = invent.IPRIXunitem
                        
                        			cas 4	
                        				table_1.PPRIXA[table_1] = invent.IPRIXcarreau
                        				table_1.PPRIXm[table_1] = invent.iprixbasecarrelage
                        		FIN
                        	FIN
                        FIN
                       type : 17
