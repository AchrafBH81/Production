               //si moimeme > 1 alors
               //    SaiDatereference = ouvre(FendateReference)
               //fin
               
               SI TAFrequence[Combo_SaisonLivraison] = Null ALORS
               	_frequence est un stFrequence = allouer un stFrequence
               	_frequence.DateDeReference = ""
               	TAFrequence[Combo_SaisonLivraison] = _frequence
               	
               FIN
               TAFrequence[Combo_SaisonLivraison].frequence = MoiMême
               SI MoiMême > 1 ALORS
               	SaiDatereference = Ouvre(FendateReference)
               	TAFrequence[Combo_SaisonLivraison].DateDeReference = SaiDatereference
               FIN
