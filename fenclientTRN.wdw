                     	si TableProduitCouleur.idClientProduit[TableProduitCouleur] <> 0 alors
                     		si hlitrecherche(FClientProduitCouleur,IDFCouleurClient,TableProduitCouleur.idClientProduit[TableProduitCouleur]) alors
                     			hsupprime(FClientProduitCouleur,hNumEnrEnCours)
                     		fin	
                     	fin
                     	tablesupprime(TableProduitCouleur,TableProduitCouleur)
                     
                     FIN
                     
                     TableProduitCouleur..etat = inactif
