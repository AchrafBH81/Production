     type : 655360
   -
     name : GetGrillType
     procedure_id : 1521859432038355041
     type_code : 12
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      // GetGrillType ()
      //
      // Paramètres :
      //	Aucun
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE GetGrillType()
      
      Typecalcul est une chaine
      
      
      si :m_sGridCode <> "" alors 
      	//	si hlitrecherche(RelationEDI,IdClientdescriptionEDIClient,["013",4,:Grill+" " +:GrillSeal]) alors
      	//		:GrillNumberInternal = RelationEDI.IDCarrelage
      	si hlitrecherche(invent,INUM,:m_sGridCode) alors
      		SI PAS :m_bGridHalfThermos ALORS typecalcul = invent.itypecarr SINON typecalcul = invent.iTypecarrDemi
      
      		si hlitrecherche(typecarr,tcdescription,Typecalcul) alors
      			:m_stypecarrelage = typecarr.tcdescription
      		fin
      		
      	sinon
      		:bMessage = vrai
      		:TexteMessage+= "Un problème est survenu avec le carrelage " + :m_sGridCode  + rc 
      	fin
      
      	
      FIN
      
      
     type : 458752
   -
     name : SortingThermos
     procedure_id : 1521989441293595234
     type_code : 12
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      // SortingThermos ()
      //
      // Paramètres :
      //	Aucun
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE SortingThermos()
      si :CheckIfTempered() alors
      	SI SansEspace(:m_sShapeCode) <> "" ALORS
      		//	:m_nSortingType = 6
      		SELON Droite(SansEspace(:m_sBaseproduct),1)
      			CAS "3"
      				:m_nSortingType = 16
      			CAS "4"
      				:m_nSortingType = 17
      			CAS "5"
      				:m_nSortingType = 18
      			CAS "6"
      				:m_nSortingType = 19
      				
      			AUTRE CAS
      				:m_nSortingType = 10
      		FIN
      		
      	SINON	
      		SELON Droite(SansEspace(:m_sBaseproduct),1)
      			CAS "3"
      				:m_nSortingType = 11
      			CAS "4"
      				:m_nSortingType = 12
      			CAS "5"
      				:m_nSortingType = 13
      			CAS "6"
      				:m_nSortingType = 14
      				
      			AUTRE CAS
      				:m_nSortingType = 10
      		FIN
      	FIN
      	
      sinon
      	
      	si sansespace(:m_sShapeCode) <> "" alors
      		//	:m_nSortingType = 6
      		SELON Droite(SansEspace(:m_sBaseproduct),1)
      			CAS "3"
      				:m_nSortingType = 6
      			CAS "4"
      				:m_nSortingType = 7
      			CAS "5"
      				:m_nSortingType = 8
      			CAS "6"
      				:m_nSortingType = 9
      				
      			AUTRE CAS
      				:m_nSortingType = 10
      		FIN
      		
      	sinon	
      		selon droite(sansespace(:m_sBaseproduct),1)
      			cas "3"
      				:m_nSortingType = 1
      			CAS "4"
      				:m_nSortingType = 2
      			CAS "5"
      				:m_nSortingType = 3
      			CAS "6"
      				:m_nSortingType = 4
      				
      			AUTRE CAS
      				:m_nSortingType = 10
      		FIN
      	fin
      FIN
      
      
      
     type : 458752
   -
     name : CheckIfTempered
     procedure_id : 1521992039863053722
     type_code : 12
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] CheckIfTempered ()
      //
      // Paramètres :
      //	Aucun
      // Valeur de retour :
      // 	booléen : <indiquez ici le rôle de la valeur de retour>
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure CheckIfTempered()
      
      si hlitrecherche(invent,iNum,:m_sPane1) alors
      	si sansespace(invent.ipextrat) <> "" alors renvoyer vrai
      FIN
      si hlitrecherche(invent,iNum,:m_sPane2) alors
      	si sansespace(invent.ipextrat) <> "" alors renvoyer vrai
      FIN
      si hlitrecherche(invent,iNum,:m_sPane3) alors
      	si sansespace(invent.ipextrat) <> "" alors renvoyer vrai
      FIN
      renvoyer Faux
      
      
     type : 458752
   -
     name : CalculSpacer
     procedure_id : 1522220505321632422
     type_code : 12
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //CalculSpacer (<nCustomerID> est entier)
      //
      // Paramètres :
      //	nCustomerID (entier) : <indiquez ici le rôle de sCustomerNumber>
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      //	_purchaseorder (PurchaseOrderBasco) : <indiquez ici le rôle de _purchaseorder>
      PROCEDURE publique  CalculSpacer(nCustomerID est un entier) 
                                                         // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      // CalculSpacer ()
      //
      // Paramètres :
      //	Aucun
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      
      
      x est un entier
      bDifferent est un booléen = Faux   // si dans le fichier kit pas de lien intercallaire = faux
      continuerrecherche est un booléen = Vrai // si pas trouve avec le numero de produit aller voir le lien
      bDoubleexiste est un booléen = Faux
      lelien est une chaîne
      lelien1 est une chaîne
      lefini est un réel
      lespace est un réel 
      lespacetotale est un réel 
      clederecherche est une chaîne
      ldoublescellant est un réel =0
      bLinexblanc est un booléen = Faux
      bLinexnoir est un booléen = Faux
      bLinexgris est un booléen = Faux
      sLIndex est une chaîne
      sLtolerance est une chaîne
      sLtolerancemoins est une chaîne
      lmultiplicateur est un entier = 1
      sLFiniAlias est une chaîne
      sLretourrechercheintercalaire est un chaîne
      
      txtreq est une chaîne = [
      	select numero as NoIntercalaire, DimensionI+TolerancePlus as bornehaut,dimensioni-ToleranceMoins as bornebas from IntercalaireCouleurDimensions
      	where IntercalaireCouleurDimensions.IDIntercalaireCouleurs = %1 and %2 between bornebas and bornehaut
      ]
      Reqsql est une Source de Données
      
      sTxtreqNonTrouve est une chaine = [
      	select top 2 numero as NoIntercalaire, ABS(%2-DimensionI) Borne,%2-DimensionI as ecart from IntercalaireCouleurDimensions
      	where IntercalaireCouleurDimensions.IDIntercalaireCouleurs = %1 order by borne asc
      ]
      
      
      RequeteDimensionAlias.pDimensionAlias= "<"+SansEspace(:m_sfinish)+">"
      HExécuteRequête(RequeteDimensionAlias)
      SI HNbEnr(RequeteDimensionAlias) >= 1 ALORS
      	HLitPremier(RequeteDimensionAlias)
      	:m_sFinish = SansEspace(RequeteDimensionAlias.DImensionMaitre)
      FIN
      
      lelien = Complète(:m_spane1,10)+Complète(:m_spane2,10)+Complète(:m_spane3,10)
      //lelien = DROITE(commandetrn.cdcomposant1,1)+DROITE(commandetrn.cdcomposant2,1)+DROITE(commandetrn.cdcomposant3,1)
      lelien1 = Complète(:m_sbasecomponent1,10)+Complète(:m_sBaseComponent2,10)+Complète(:m_sBaseComponent3,10)
      clederecherche = HConstruitValClé(inter,cleclientproduit,complete("139",10),...
      Complète(:M_Spane1,10),Complète(:m_spane2,10),...
      Complète(:m_spane3,10),Complète(:m_sfinish,10))
      HLitRecherche("inter","cleclientproduit",clederecherche)
      
      
      RequeteClientFiniIntercalaire.pIdClient = nCustomerID
      RequeteClientFiniIntercalaire.pcomposant1 = Complète(:m_spane1,10)
      RequeteClientFiniIntercalaire.pcomposant2 = Complète(:m_spane2,10)
      RequeteClientFiniIntercalaire.pcomposant3 = Complète(:m_spane3,10)
      RequeteClientFiniIntercalaire.pFini = Complète(:m_sfinish,15)
      RequeteClientFiniIntercalaire.pIdIntercalaireCouleur = :SpacerID
      HExécuteRequête(RequeteClientFiniIntercalaire)
      
      
      
      SI  config.cDoubleScellantTous ALORS
      	ldoublescellant = Arrondi(RequeteClientFiniIntercalaire.dimdoublescellantM)
      	
      SINON
      	POUR i = 1 A 3
      		
      		SI PAS SansEspace({":composantbase"+NumériqueVersChaîne(i)}) = "" ALORS
      			
      			SI  PAS Droite(SansEspace({":composantbase"+NumériqueVersChaîne(i)}),1) = "3" ALORS
      				ldoublescellant = Arrondi(RequeteClientFiniIntercalaire.dimdoublescellantM)
      				SORTIR
      			FIN
      		FIN
      		
      	FIN
      FIN
      
      
      
      
      //si pas HEnDehors() et HTrouve() alors
      SI HNbEnr(RequeteClientFiniIntercalaire) = 1 ALORS
      	HLitPremier(RequeteClientFiniIntercalaire)
      	:Intercalaire1	= RequeteClientFiniIntercalaire.Spacer1
      	:intercalaire2  = RequeteClientFiniIntercalaire.Spacer2
      	//	commandetrn.cdespaceinex = intercal.idescinex
      	continuerrecherche = Faux
      	
      SINON
      	
      	
      	RequeteClientFiniIntercalaire.pIdClient = nCustomerID
      	RequeteClientFiniIntercalaire.pcomposant1 = Complète(:m_sBaseComponent1,10)
      	RequeteClientFiniIntercalaire.pcomposant2 = Complète(:m_sBaseComponent2,10)
      	RequeteClientFiniIntercalaire.pcomposant3 = Complète(:m_sBaseComponent3,10)
      	RequeteClientFiniIntercalaire.pFini = Complète(:m_sfinish,15)
      	RequeteClientFiniIntercalaire.pIdIntercalaireCouleur = :SpacerID
      	HExécuteRequête(RequeteClientFiniIntercalaire)
      	
      	//Code WinDev 5.5 remplacé par la migration :
      	//    si pas h.endehors et h.trouve alors
      	SI HNbEnr(RequeteClientFiniIntercalaire) = 1 ALORS
      		HLitPremier(RequeteClientFiniIntercalaire)
      		:intercalaire1	= RequeteClientFiniIntercalaire.Spacer1
      		:intercalaire2  = RequeteClientFiniIntercalaire.Spacer2
      		//	commandetrn.cdespaceinex = intercal.idescinex
      		continuerrecherche = Faux
      	FIN
      FIN
      
      
      //fin
      
      
      SI  :SpacerID = 0  ALORS
      	:Intercalaire1 = ""
      	:intercalaire2=""
      	:bMessage = vrai
      	:TexteMessage+= "Aucun intercalaire n'a été trouvé"
      FIN
      
      
      
      
      
      
      
      
      SI continuerrecherche ALORS
      	SI HLitRecherche(IntercalaireCouleurs,IDIntercalaireCouleurs,:Spacerid) ALORS
      		SI HLitRecherche(Intercalaires,IDIntercalaires,IntercalaireCouleurs.idIntercalaires) ALORS
      			ldoublescellant = Intercalaires.dimdoublescellantM
      		FIN
      	FIN
      	
      	
      	SI PAS Position(:m_sfinish,".") = 0 ALORS
      		lefini = Arrondi(Val(:m_sFinish) * 25.4,3)
      	SINON
      		SI PAS Position(:m_sfinish,"/") = 0 ALORS
      			lefini =NumériqueVersChaîne( ConvertAnglais(:m_sFinish,"fini") * 25.4,"6.3f")
      			
      		SINON
      			SI Val(:m_sfinish) < 6 ALORS
      				lefini =NumériqueVersChaîne( ConvertAnglais(:m_sfinish,"fini") * 25.4,"6.3f")
      			SINON
      				lefini = Arrondi(Val(:m_sfinish)/1000 * 25.4,3)
      				
      			FIN
      		FIN
      	FIN
      	
      	:m_rThickness+=ldoublescellant 
      	
      		
      	
      	
      	
      	SELON :m_nGlassNumber
      	
      		CAS 2
      			lespace = Arrondi((lefini - :m_rThickness) ,3)
      			lespacetotale = Arrondi((lefini - :m_nGlassNumber) ,3)
      			lmultiplicateur = 1
      		CAS 3
      			:m_rThickness+=ldoublescellant
      			lespace = Arrondi((lefini - :m_rThickness) / 2 ,3)
      			lespacetotale = Arrondi((lefini - :m_nGlassNumber) ,3)
      			lmultiplicateur = 2
      			
      	FIN	
      	
      	lespace = Arrondi(lespace/25.4,3)
      	lespacetotale = Arrondi(lespacetotale/25.4,3)
      	
      	// Jean Hamelin 18-10-2014
      	// décommenter pour calculer les spacers dans le cas d'un thermos triple
      	// pour touver une combinaison le plus pres possible de l,espace disponible
      	// il faut calculer avec l,espace totale et non l,espace divisée par 2
      	
      	SELON :m_nGlassNumber
      		CAS 3
      			
      			 :remplirTableauIntercalaire(lespacetotale)
      		CAS 2
      			SI HExécuteRequêteSQL(Reqsql,hModifieFichier,ChaîneConstruit(txtreq,:SpacerID,lespace)) ET HNbEnr(Reqsql) > 0 ALORS
      				HLitPremier(Reqsql)
      				:intercalaire1 = Reqsql.nointercalaire
      			SINON
      //				SI HExécuteRequêteSQL(Reqsql,hModifieFichier,ChaîneConstruit(txtreqNonTrouve,:SpacerID,lespace)) ET HNbEnr(Reqsql) > 0 ALORS
      //					HLitPremier(Reqsql)
      //					:Intercalaire1 = Reqsql.nointercalaire
      //					:bMessage = Vrai
      //					:TexteMessage+= "Plusieurs intercalaire étaient disponible, "+ :intercalaire1 + " à été choisi"
      //					
      //				FIN
      //				SI messageErreur ALORS
      //					ACSO_message("Erreur","Aucun intercalaire ne correspond à votre demande"+RC+"SVP l'inscrire manuellement","Erreur")
      //					RepriseSaisie(CDESPACE)
      //				FIN
      			FIN
      	
      
      	FIN
      
      	
      FIN
      
      
      SI  :intercalaire1 = ""  ALORS
      	:bMessage = Vrai
      	:TexteMessage+= "Aucun intercalaire n'a été trouvé"
      FIN
      //
      
      
      
      
      
      
      
      
      
      
      
     type : 458752
   -
     name : SetbaseComponent
     procedure_id : 1522221806927975427
     type_code : 12
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      // SetbaseComponent ()
      //
      // Paramètres :
      //	Aucun
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure SetbaseComponent()
      :m_rThickness = 0
      :m_nGlassNumber = 0
      SI PAS SansEspace(:m_sPane1) = "" _ET_ HLitRecherche(invent,INUM,:m_sPane1) ALORS
      	:m_sBaseComponent1 = invent.IPBASE
      	:m_rThickness+= invent.IEpaisseur
      	:m_nGlassNumber++
      FIN
      SI PAS SansEspace(:m_sPane2) = "" _ET_ HLitRecherche(invent,INUM,:m_sPane2) ALORS
      	:m_sBaseComponent2 = invent.IPBASE
      	:m_rThickness+= invent.iepaisseur
      	:m_nGlassNumber++
      FIN
      SI PAS SansEspace(:m_sPane3) = "" _ET_ HLitRecherche(invent,INUM,:m_sPane3) ALORS
      	:m_sBaseComponent3 = invent.IPBASE
      	:m_rThickness+= invent.iepaisseur
      	:m_nGlassNumber++
      FIN
      
      
     type : 458752
   -
     name : RemplirTableauIntercalaire
     procedure_id : 1522227536789040680
     type_code : 12
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //RemplirTableauIntercalaire (<lespacetotale>)
      //
      // Paramètres :
      //	lespacetotale :<indiquez ici le rôle de lespacetotale>
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      
      //
      //	SpacerID :<indiquez ici le rôle de SpacerID>
      PROCEDURE PRIVÉE RemplirTableauIntercalaire(lespacetotale)
      
      
      
      reqsql est un source de donnees
      txtsql est une chaine = "select * from IntercalaireCouleurDimensions where IDIntercalaireCouleurs = %1 order by dimensioni"
      txtsql = ChaîneConstruit(txtsql,:SpacerID)
      tabDimensioncroise est un tableau de 0 par 5 chaines
      tabdimension est un tableau de 0 par 4 chaine
      tabdimensionChoix est un tableau de 0 par 2 chaine
      Dimensionatrairer est une chaine = ""
      lchaine est une chaine 
      lmin est un reel
      lmax est un reel
      ldifferenceajoute est un reel = 0
      ldebut est un booleen = vrai
      
      cpt est un entier = 1
      cpt1 est un entier = 1
      SI HExécuteRequêteSQL(reqsql,hRequêteDéfaut,txtsql) ALORS
      	POUR TOUT reqsql 
      		Dimension(tabdimension,cpt,4)
      		tabdimension[cpt,1] = reqsql.numero
      		tabdimension[cpt,2] = NumériqueVersChaîne(Arrondi(reqsql.dimensioni,3))
      		tabdimension[cpt,3] = NumériqueVersChaîne(Arrondi(reqsql.toleranceplus,3))
      		tabdimension[cpt,4] = NumériqueVersChaîne(Arrondi(reqsql.tolerancemoins,3))
      		cpt++
      	FIN
      SINON
      	Info(HErreurInfo(hErrComplet))
      FIN
      
      
      POUR cpt = 1 _A_ Dimension(tabdimension)/4
      	POUR cpt1 = cpt _A_ Dimension(tabdimension)/4
      		TableauAjouteLigne(tabDimensioncroise,tabdimension[cpt,1]+","+tabdimension[cpt1,1] , NumériqueVersChaîne(Val(tabdimension[cpt,2]) +   Val(tabdimension[cpt1,2])),...
      		Min(tabdimension[cpt,3],tabdimension[cpt1,3]),Min(tabdimension[cpt,4],tabdimension[cpt1,4]),Abs(Val(lespacetotale)-(Val(tabdimension[cpt,2]) +   Val(tabdimension[cpt1,2]))))
      		
      		
      		
      		
      		
      	FIN
      FIN
      TableauTrie(tabDimensioncroise,ttCroissant,5)
      POUR cpt = 1 _A_ Dimension(tabDimensioncroise)/5
      	lmin = Val(tabDimensioncroise[cpt,2]) - Val(tabDimensioncroise[cpt,4])
      	lmax = Val(tabDimensioncroise[cpt,2]) + Val(tabDimensioncroise[cpt,3])
      	
      	
      	
      	SI lmin < lespacetotale < lmax ALORS
      		//		si Val(tabDimensioncroise[cpt,5]) = ldifferenceajoute ou ldebut alors
      		TableauAjouteLigne(tabdimensionChoix,tabDimensioncroise[cpt,1],tabDimensioncroise[cpt,2])
      		//		    ldifferenceajoute = Val(tabDimensioncroise[cpt,5])
      		//            ldebut = faux
      	SINON
      		SORTIR
      		//		fin
      		
      	FIN
      	
      FIN
      
      SI Dimension(tabdimensionChoix)/2 > 1 ALORS
      	:Intercalaire1 = ExtraitChaîne(SansEspace(tabdimensionChoix[1,1]),1,",")
      	:Intercalaire2 = ExtraitChaîne(SansEspace(tabdimensionChoix[1,1]),2,",")
          :bMessage = vrai
          :TexteMessage = "Plusieurs combinaison d'intercalaire étaient disponible "
          pour i = 1 a Dimension(tabdimensionChoix)/2 
          	:textemessage += "["+ExtraitChaîne(SansEspace(tabdimensionChoix[i,1]),1,",")+"-"+ExtraitChaîne(SansEspace(tabdimensionChoix[i,1]),2,",")+"],"
          FIN
          :textemessage = gauche(:textemessage,taille(:textemessage)-1)
          :textemessage += " (le premier de la liste à été utilisé)"+rc
      SINON SI Dimension(tabdimensionChoix) /2 = 1
      	:Intercalaire1 = ExtraitChaîne(SansEspace(tabdimensionChoix[1,1]),1,",")
      	:intercalaire2 = ExtraitChaîne(SansEspace(tabdimensionChoix[1,1]),2,",")
      sinon
      	:Intercalaire1 = ""
      	:intercalaire2 = ""
      	:bMessage = Vrai
      	:TexteMessage = "Aucun intercalaire trouvé"
      	
      FIN
      
      
      
      
      
      
      
      
      
      
      
      
      
