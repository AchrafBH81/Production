  p_codes :
   -
     code : |1+
      cExternalOrderDetails est une Classe <mapping=ExternalOrderDetails>
      	
      	// Le code se trouvant entre <MAPPING> et <FIN> est généré automatiquement.
      	// Il sera effacé et recréé entièrement à chaque génération depuis le menu contextuel
      	// du fichier dans l'explorateur de projet ou dans l'analyse "..Regénérer la classe modèle"
      	<MAPPING>
      	m_nIDCotation											est un entier sur 8 octets				<mapping=IDCotation>
      	m_nIDCotationDetails									est un entier sur 8 octets				<mapping=IDCotationDetails, clé unique>
      	m_sThermosCode											est une chaîne							<mapping=ThermosCode>
      	m_sTag													est une chaine							<mapping=tag>
      	m_sThermosDescription									est une chaîne							<mapping=ThermosDescription>
      	m_sSpacerType											est une chaîne							<mapping=SpacerType>
      	m_sSpacerDimension										est une chaîne							<mapping=SpacerDimension>
      	m_sFinish												est une chaîne							<mapping=Finish>
      	m_sThermosHeight										est une chaîne							<mapping=ThermosHeight>
      	m_sThermosHeight1										est une chaîne							<mapping=ThermosHeight1>
      	m_sThermosWidth											est une chaîne							<mapping=ThermosWidth>
      	m_sThermosHeightCalculate								est une chaîne ANSI						<mapping=ThermosHeightCalculate>
      	m_sThermosWidthCalculate								est une chaîne ANSI						<mapping=ThermosWidthCalculate>
      	m_sThermosHeight1Calculate								est une chaîne ANSI						<mapping=ThermosHeight1Calculate>
      	m_sPane1												est une chaîne							<mapping=Pane1>
      	m_sPane2												est une chaîne							<mapping=Pane2>
      	m_sPane3												est une chaîne							<mapping=Pane3>
      	m_sGridCode												est une chaîne							<mapping=GridCode>
      	m_sGridDescription										est une chaîne							<mapping=GridDescription>
      	m_nGridBase												est un entier sans signe sur 1 octet	<mapping=GridBase>
      	m_nGridheight											est un entier sans signe sur 1 octet	<mapping=Gridheight>
      	m_bGridHalfThermos										est un booléen							<mapping=GridHalfThermos>
      	m_sDrawingType											est une chaîne							<mapping=DrawingType>
      	m_bIsDeleted											est un booléen							<mapping=IsDeleted>
      	m_nQuantity												est un entier sans signe sur 2 octets	<mapping=Quantity>
      	m_sInteriorColorCode									est une chaîne							<mapping=InteriorColorCode>
      	m_sInteriorColorDescription								est une chaîne							<mapping=InteriorColorDescription>
      	m_sExteriorColorCode									est une chaîne							<mapping=exteriorColorCode>
      	m_sExteriorColorDescription								est une chaîne							<mapping=ExteriorColorDescription>
      	m_nNumberOfTiles										est un entier sans signe sur 1 octet	<mapping=NumberOfTiles>
      	m_sShapeCode											est une chaîne							<mapping=ShapeCode>
      	m_sShapeDescription										est une chaîne							<mapping=ShapeDescription>
      	m_rSurface												est un réel								<mapping=Surface>
      	m_moEnergySurcharge										est un monétaire						<mapping=EnergySurcharge>
      	m_moPrice5X												est un monétaire						<mapping=Price5X>
      	m_moPrice10X											est un monétaire						<mapping=Price10X>
      	m_moPriceShape											est un monétaire						<mapping=PriceShape>
      	m_moThermosUnitPrice									est un monétaire						<mapping=ThermosUnitPrice>
      	m_moShapeUnitPrice										est un monétaire						<mapping=ShapeUnitPrice>
      	m_moTotalThermosPrice									est un monétaire						<mapping=TotalThermosPrice>
      	m_moGridTilePrice										est un monétaire						<mapping=GridTilePrice>
      	m_moGridBaseprice										est un monétaire						<mapping=GridBaseprice>
      	m_moGridUnitPrice										est un monétaire						<mapping=GridUnitPrice>
      	m_moPaintUnitPrice										est un monétaire						<mapping=PaintUnitPrice>
      	m_sPane1description										est une chaîne							<mapping=Pane1description>
      	m_sPane2description										est une chaîne							<mapping=pane2description>
      	m_moTotalShapeprice										est un monétaire						<mapping=TotalShapeprice>
      	m_sPane3description										est une chaîne							<mapping=Pane3description>
      	m_sCalculType											est une chaîne							<mapping=CalculType>
      	m_rBilledSurface										est un réel								<mapping=BilledSurface>
      	m_rRealSurface											est un réel								<mapping=RealSurface>
      	m_moSquarefeetPrice										est un monétaire						<mapping=SquarefeetPrice>
      	m_moTotalGridprice										est un monétaire						<mapping=TotalGridprice>
      	m_nNumberOfTilesExt										est un entier							<mapping=NumberOfTilesExt>
      	m_nNumberOfTilesInt										est un entier							<mapping=NumberOfTilesInt>
      	m_moPaintUnitPriceExt									est un monétaire						<mapping=PaintUnitPriceExt>
      	m_moPaintUnitpriceInt									est un monétaire						<mapping=PaintUnitpriceInt>
      	m_moPaintTilePriceExt									est un monétaire						<mapping=PaintTilePriceExt>
      	m_moPaintTilepriceInt									est un monétaire						<mapping=PaintTilepriceInt>
      	m_moTotalPaintPrice										est un monétaire						<mapping=TotalPaintPrice>
      	m_sGridType												est une chaîne							<mapping=GridType>
      	m_moHalfGridPrice										est un monétaire						<mapping=HalfGridPrice>
      	m_sWidth												est une chaîne							<mapping=Width>
      	m_sWidth1												est une chaîne							<mapping=Width1>
      	m_sWidth2												est une chaîne							<mapping=Width2>
      	m_sHeight												est une chaîne							<mapping=Height>
      	m_sHeight1												est une chaîne							<mapping=Height1>
      	m_sHeight2												est une chaîne							<mapping=Height2>
      	m_sDiameter												est une chaîne							<mapping=Diameter>
      	m_sRadius												est une chaîne							<mapping=Radius>
      	m_sRadius1												est une chaîne							<mapping=Radius1>
      	m_sRadius2												est une chaîne							<mapping=Radius2>
      	m_bFifteenYearsWarranty									est un booléen							<mapping=FifteenYearsWarranty>
      	m_bExtraGazArgon										est un booléen							<mapping=ExtraGazArgon>
      	m_moFifteenYearsWarrantyTotal							est un monétaire						<mapping=FifteenYearsWarrantyTotal>
      	m_moExtraArgonGazTotal									est un monétaire						<mapping=ExtraArgonGazTotal>
      	m_nDTH													est un entier sans signe sur 2 octets	<mapping=DTH>
      	m_nBarrotinID											est un entier							<mapping=BarrotinID>
      	m_sGrillNote											est une chaîne							<mapping=GrillNote>
      	m_sBarrotinDescription									est une chaîne							<mapping=BarrotinDescription>
      	m_moBarrotinPrice										est un monétaire						<mapping=BarrotinPrice>
      	m_sBaseproduct											est une chaine							<mapping = baseproduct>
      	m_sThermosGL											est une chaine							<mapping = ThermosGL>
      	m_sGridGL												est une chaine							<mapping = GridGL>
      	m_bTemplateToCome										est un booleen							<mapping=TemplateToCome>
      	
      	<FIN>
      	m_nLigne			est un entier
      	Variablex			est un réel
      	variablex1			est un réel
      	SpacerID			est un entier
      	Intercalaire1		est une chaîne
      	intercalaire2		est une chaîne
      	m_sTypecarrelage	est une chaîne
      	bMessage			est un booléen
      	TexteMessage		est une chaîne
      	m_nSortingType		est un entier
      	m_sBaseComponent1	est une chaine
      	m_sBaseComponent2	est une chaine
      	m_sBaseComponent3	est une chaine
      	m_rThickness		est un reel
      	m_nGlassNumber		est un entier
      	m_nTrnnumber		est un entier
      	
      	
      FIN
     type : 131072
