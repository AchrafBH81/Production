 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1+
      PROCEDURE MaFenêtre(gnCustomerID est une entier , gsCustomerName est une chaine,gsCustomerNumber est une chaine)
      
      
      
      sTxtreq est une chaine = [
        select cotationdate,cotationnumber,manualOrderNumber as manualOrderNumber,identification,JobNumber,0 as NbLine,0 as nbThermos,0 as OrderTransfered,externalOrder.IDCotation from ExternalOrder 
        where externalOrder.idcustomer = %1 AND externalorder.sended = 1 and externalorder.isdeleted <> 1 order by externalorder.CotationNumber
      ]
      sdReqsql est une source de donnees
      
      //HChangeConnexion(ExternalOrder,gcnxConnexionHFExternal)
      //HChangeConnexion(ExternalOrderDetails,gcnxConnexionHFExternal)
      //HChangeConnexion(WebConfig,gcnxConnexionHFExternal)
      LIB_Customername = sansespace(gscustomername)
      GetArgonExtraPrice(sansespace(gscustomernumber))
      GetWarrantyExtraPrice(sansespace(gscustomernumber))
      hlit(config,1)
      si hlitrecherche(WebConfig,CustomerID,gncustomerid) alors
      	gnManualOrderNumber = WebConfig.SequentialOrderNumber
      sinon
      	gnManualOrderNumber = 1
      FIN
      
   -
     code : |1+
      
      si hexecuterequetesql(sdreqsql,hRequêteDéfaut,ChaîneConstruit(sTxtreq,gnCustomerID)) alors
      	FichierVersTableMémoire(tableCommandeRecu,sdReqsql)
      FIN
      si gnManualOrderNumber = 2 alors
      	tableCommandeRecu.No_Ordre..visible = faux
      	tableCommandeRecu.COL_manualNumber..visible = vrai
      SINON
      	tableCommandeRecu.No_Ordre..Visible			= vrai
      	tableCommandeRecu.COL_manualNumber..Visible	= faux
      FIN
      SI tableCommandeRecu..Occurrence = 0 ALORS Générer..Etat = Grisé
     type : 34
   -
     type : 180
     enabled : false
   -
     type : 230
     enabled : false
  procedures :
   -
     name : GetArgonExtraPrice
     procedure_id : 1522293769573317978
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //GetArgonExtraPrice (<CustomerNumber> est chaîne)
      //
      // Paramètres :
      //	CustomerNumber (chaîne ANSI) : <indiquez ici le rôle de CustomerNumber>
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE GetArgonExtraPrice(CustomerNumber est une chaine)
      clederecherche est une chaine = HConstruitValClé(ProduitClient,IdClientIdproruit,CustomerNumber,gsExtraArgon)
      
      SI HLitRecherche(ProduitClient,IdClientIdproruit,clederecherche) ET ProduitClient.IPprixSpecial ALORS
      		grextraargonprice = ProduitClient.IPrixa
      sinon
      	si hlitrecherche(invent,INUM,gsExtraArgon) ALORS
      		grExtraArgonPrice = invent.iprixunite
      	FIN
      FIN
      
     type : 458752
   -
     name : GetWarrantyExtraPrice
     procedure_id : 1522294478247477324
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //GetWarrantyExtraPrice (<CustomerNumber> est chaîne)
      //
      // Paramètres :
      //	CustomerNumber (chaîne ANSI) : <indiquez ici le rôle de CustomerNumber>
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE GetWarrantyExtraPrice(CustomerNumber est une chaine)
      clederecherche est une chaine = HConstruitValClé(ProduitClient,IdClientIdproruit,CustomerNumber,gsExtraWarranty)
      
      SI HLitRecherche(ProduitClient,IdClientIdproruit,clederecherche) ET ProduitClient.IPprixSpecial ALORS
      		grextraWarrantyprice = ProduitClient.IPrixa
      sinon
      	si hlitrecherche(invent,INUM,gsExtraWarranty) ALORS
      		grExtraWarrantyPrice = invent.iprixunite
      	FIN
      FIN
      
      
     type : 458752
