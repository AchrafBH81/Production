  -
    name : LIB_Customername
    identifier : 0x24fe484b06520891
    internal_properties : 
    properties :
     x : 127
     y : 20
     width : 768
     height : 38
    type : 3
    code_elements :
     type_code : 2
     p_codes : []
  -
    name : Générer
    identifier : 0x24ff95b621782b03
    internal_properties : 
    properties :
     x : 931
     y : 104
     width : 50
     height : 50
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         
         sordertocheck	est une chaine
         sdReqSql1		est une source de donnees
         
         
         sTxtsql1			est une chaine	= [
         	select top 30 * from (
         	select Facture.fanumero as commande,Facture.fadate as datecommande,facture.fpreparation as Prep,'' as NoFacture,facture.fatypedocument as typededocument  from Facture WHERE Facture.faclient = '%1' AND Facture.fanocommande = '%2'
         	union select hfacture.fanumero as commande,bonlivraison.bdatefacture as dateCommande,'X' as prep,BonLivraison.Bfacture as NoFacture,'4' as typededocument from hfacture inner join BonLivraison on BonLivraison.BnoCommande = hfacture.fanumero WHERE 
         	bonlivraison.bfacture <> 0 and hfacture.faclient = '%1' AND hfacture.fanocommande = '%2' 
         	) order by datecommande desc
         ]
         SI gnManualOrderNumber = 2 ALORS
         	sordertocheck	= SansEspace(Replace(tableCommandeRecu.COL_manualNumber,"'","''"))
         SINON
         	sordertocheck	= SansEspace(Replace(tableCommandeRecu.No_Ordre,"'","''"))
         FIN
         
         
         sTxtsql1			= ChaîneConstruit(sTxtsql1,gsCustomerNumber,sordertocheck)
         
         SI HExécuteRequêteSQL(sdReqSql1,hRequêteDéfaut,sTxtsql1) ALORS
         	SI HNbEnr(sdReqSql1) <> 0 ALORS
         		SI PAS OuiNon(0,"Cette commande à déjà été récupérée", "Voulez-vous continuer ?") ALORS RETOUR
         		
         	FIN
         FIN
         
         
         
         
         //
         //clCurrentOrder est un ccotation 
         sTxtsql			est une chaine	= "select * from externalOrderDetails where IDCotation = %1 order by idcotationdetails asc "
         sdReqSql		est un source de donnees
         nCustomerID est un entier
         
         
         
         
         quand exception dans
         
         
         clCurrentOrder	est un cExternalOrder
         SI HLitRecherche(ExternalOrder,IDCotation,tableCommandeRecu.COL_ID) ALORS
         	FichierVersMémoire(clCurrentOrder,ExternalOrder)
         FIN
         nCustomerID = clCurrentOrder.m_nIdCustomer
         SI HLitRecherche(ExternalOrder,IDCotation,tableCommandeRecu.COL_ID) ALORS
         	FichierVersMémoire(clCurrentOrder,ExternalOrder)
         	clCurrentOrder.GetCustomerInfo()
         	clCurrentOrder.m_clShippingdetail.GetShippingInfo(clCurrentOrder.m_nShippingAddressID,clCurrentOrder.m_clCustomerInfo.m_numero)
         	SI HExécuteRequêteSQL(sdReqSql,hRequêteDéfaut,ChaîneConstruit(sTxtsql,ExternalOrder.IDCotation)) ALORS
         		FichierVersTableau(clCurrentOrder.m_tabCExternalorderitem,sdReqSql) 
         	FIN	
         FIN
         pour chaque clItem de clCurrentOrder.m_tabCExternalorderitem
         //	si clitem:checkIfTempered() alors
         //		clitem.m_nSortingType = 5
         //	sinon
         		clItem.SortingThermos()	
         		
         //	FIN
         	clItem.setBaseComponent()
         	clItem.SpacerID = clCurrentOrder.GetSpacerID(clItem.m_sSpacerType)
         	clItem.CalculSpacer(nCustomerID)
         FIN
         
         bufCommande est un buffer
         serialise(clCurrentOrder,bufCommande,psdJSON)
         fsauvebuffer("c:\documents\commande.json",bufCommande)
         
         
         clCurrentOrder.GenererCommande()
         
         ExternalOrder.isdeleted  = Vrai
         hmodifie(ExternalOrder,hNumEnrEnCours)
         //tableCommandeRecu.CommandeExiste[tableCommandeRecu] = vrai
         iapercu(iapZoom100)
         iImprimeEtat(EtatExceptionEDITRN,clCurrentOrder)
         tableCommandeRecu.supprime(tablecommanderecu)
         si tableCommandeRecu..Occurrence = 0 alors generer..etat = grise
         FAIRE
           info(exceptioninfo(errComplet))
         FIN
        type : 18
      -
        type : 161
        enabled : false
