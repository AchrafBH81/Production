     code : |1+
      PROCEDURE Constructeur(nIdShipping est un entier,sCustomerNumber est une chaine)
      :GetShippingInfo(nIdShipping,sCustomerNumber)
      
     type : 589824
   -
     name : Destructeur
     procedure_id : 1521112309334027522
     type_code : 28
     code : |1-
      PROCEDURE Destructeur()
     type : 655360
   -
     name : GetShippingInfo
     procedure_id : 1521112665816396137
     type_code : 12
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] GetShippingInfo (<nShippindID> est entier, <sCustomerNumber> est chaîne)
      //
      // Paramètres :
      //	nShippindID (entier) : <indiquez ici le rôle de nShippindID>
      //	sCustomerNumber (chaîne ANSI) : <indiquez ici le rôle de sCustomerNumber>
      // Valeur de retour :
      // 	booléen : <indiquez ici le rôle de la valeur de retour>
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure GetShippingInfo(nShippindID est un entier,sCustomerNumber est une chaine)
      
      si nShippindID = 0 _et_ sCustomerNumber = 0 alors renvoyer faux
      
      si hlitrecherche(ClientLivraison,IDClientLivraison,nShippindID) ALORS
      		:m_nIDClientLivraison	= ClientLivraison.IDClientLivraison
      	    :m_sLNom		= ClientLivraison.lNom
      		:m_sLRue		= ClientLivraison.lRue
      		:m_sLVille		= ClientLivraison.lVille
      		:m_sLCodePostal	= ClientLivraison.lCodePostal
      		:m_sNote		= ClientLivraison.Note
      	
      sinon
      	SI HExécuteRequête(RequeteLivraisonDefaut,hRequêteDéfaut,SansEspace(sCustomerNumber)) ET HNbEnr(RequeteLivraisonDefaut) ALORS
      		
      		:m_nIDClientLivraison	= ClientLivraison.IDClientLivraison
      		:m_sLNom		= ClientLivraison.lNom
      		:m_sLRue		= ClientLivraison.lRue
      		:m_sLVille		= ClientLivraison.lVille
      		:m_sLCodePostal	= ClientLivraison.lCodePostal
      		:m_sNote		= ClientLivraison.Note
      	FIN
      FIN
      
      
      
      //POUR CHAQUE SaisonLivraison 
      //	_stjourlivraison											= allouer un stLivraison
