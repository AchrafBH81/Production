  p_codes :
   -
     code : |1+
      PROCEDURE MaFenêtre(gsCurrentShape est une chaine)
      mafenetre..ValeurRenvoyée = ""
      gnCurrentShape est un entier
      
   -
     code : |1+
      hlitpremier(forme,fnumero)
      //pour tout forme
      tantque pas hendehors(forme)
      	SI forme.IsActive ALORS
               gnCurrentShape = ZR_Shape.AjouteFI(FI_Shape,forme.fnumero)
               zr_shape[gnCurrentShape].ATT_ShapeNumber = forme.fnumero
      	FIN
      	hlitsuivant(forme,fnumero)
      FIN
      
      
      
