        type : 14
      -
        code : |1+
         
         // Entrée dans une table
         si TABLE..vide alors TableAjoute("TABLE")
         
         
        type : 15
      -
        code : |1+
         
         
         
        type : 19
      -
        code : |1+
         
         // Mémorise la modification
         si TABLE..Modifie alors
         	si TABLE..Nouveau alors
         		TableEnregistre("TABLE")
         		// Le test hDoublon est inutile si le fichier n'a pas de clé unique
         //Code WinDev 5.5 remplacé par la migration :
         //		si HDoublon() alors
         		si HErreurDoublon() alors
         			Erreur("L'enregistrement ne peut être ajouté au fichier.",...
         			       "Un enregistrement contient déjà le même identifiant")
         		fin
         //Code WinDev 5.5 remplacé par la migration :
         //		si HErrIntegrite() alors
         		si HErreurIntegrite() alors
         			Erreur("Erreur d'intégrité")
         			Retour
         		Fin
         		// Pour effectuer une saisie en chaine
         		// On utilise la fonction TableAjoute
         		TableAjoute("TABLE")
         	sinon
         		// Modification
         		TableEnregistre("TABLE")
         		// Le test hDoublon est inutile si le fichier n'a pas de clé unique
         //Code WinDev 5.5 remplacé par la migration :
         //		si HDoublon() alors
         		si HErreurDoublon() alors
         			Erreur("L'enregistrement ne peut être modifié.",...
         			       "Un enregistrement contient déjà le même identifiant.")
         		fin
         //Code WinDev 5.5 remplacé par la migration :
         //		si HErrIntegrite() alors
         		si HErreurIntegrite() alors
         			Erreur("Erreur d'intégrité")
         			Retour
         		Fin
         	fin
         fin
         
         
         
        type : 20
