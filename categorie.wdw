  -
    name : BTN_DETRUIRE
    identifier : 0x3e9d909e7fa6f588
    internal_properties : 
    properties :
     x : 135
     y : 5
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         
         // Suppression
         si TABLE..Nouveau alors
         	si TABLE..occurrence<2 alors
         		REPRISESAISIE("TABLE")
         	sinon
         		TableSupprime("TABLE")
         	fin
         sinon
         	si (Table..Etat=AffichageSeulement ET Table..Visible=Vrai) alors
         		acso_message("Erreur","Information déjà en utilisation","Erreur")
         		retour
         	fin
         	si acso_message("Question","Voulez-vous supprimer l'enregistrement?","OuiNon") =idyes alors
         		TableSupprime("TABLE")
         		si HErreurIntegrite() alors
         			Erreur(HErreurInfo())	// "Erreur d'intégrité"
         			Retour
         		Fin
         	fin
         fin
         
         si TableOccurrence("TABLE")=0 alors
         	REPRISESAISIE("TABLE")
         SINON
         	// Le bouton Supprimer est en interruption
         	// Il faut forcer l'entrée dans la nouvelle ligne
         	ExecuteTraitement("TABLE",trtENTREELIGNE)
         fin
         
        type : 18
      -
        type : 161
        enabled : false
