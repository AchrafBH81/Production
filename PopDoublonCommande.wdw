 menu :
  name : _Menu
  identifier : 0x292573e513b5f221
  internal_properties : 
  options : []
 languages :
  - fr-FR
 popup_menus : []
 message_bar :
  internal_properties : CQAAAAkAAAAjFWXItEk/EPvcbGR+hALkgRfdOpVtIn+yZNxHnmSRFJegE/AnD2HbGAaMfhGCqfzkryHG9FVhjtF+iQYkZ59QBQ88Okhh0vjCoVhOagox2hvIqrJnU30QK15/ZA==
 actionbar : {}
 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1-
      PROCEDURE MaFenêtre(NomClient est une chaine,NoCommandeclient est une chaine,resrequete est un source de donnees)
      LibClient = nomclient
      LibNoCommandeClient = NoCommandeclient
      LibDocument est une chaine
      LibStatut est une chaîne
      NoDocument est une chaine
      
      mafenetre..ValeurRenvoyée =  faux
   -
     code : |1+
      pour TOUT resrequete 
      	nodocument = resrequete.commande
      	selon resrequete.typededocument
      		cas 1
      			LibDocument = "Commande:"
      			selon sansespace(resrequete.Prep)
      				cas ""
      					LibStatut = "En commande"
      				cas "T"
      					LibStatut = "En Préparation"
      				CAS "F"
      					LibStatut = "Transférée Vidéojet"
      				CAS "B"
      					LibStatut = "En bon de livraison"
      					
      				AUTRE CAS
      					
      			FIN
      		cas 2
      			LibDocument = "Crédit:"
      		cas 3
      			LibDocument = "Soumission:"
      			LibStatut = "En Soumission"
      		cas 4		
      			LibDocument = "Facture:"
      			LibStatut = "Facturé"
      			nodocument = resrequete.NoFacture
      		AUTRE CAS
      			
      	FIN
      	ZRCommande.ajouteligne(libDocument,nodocument,resrequete.datecommande,libstatut)
      FIN
      
     type : 34
   -
     code : |1+
      
      
     type : 234
   -
     code : |1+
      
      
     type : 165
   -
     code : |1+
      
      
     type : 177
