  -
    name : Btn_Ok
    identifier : 0x2344b398a8654a76
    internal_properties : 
    properties :
     x : 721
     y : 81
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         si HLitRecherche(UserGroup,IDUserGroup,gnIdGroupe) ALORS
         	UserGroup.ModifPrix = INT_ModifPrix
         	HModifie(UserGroup)
         FIN
         pour chaque ligne de TABLEH
         	si hlitrecherche(Securite,IDUserGroupOptionMenu,[gnIdGroupe,tableh.COL_IDOption]) alors
         		securite.OptionActif = tableh.COL_Interrupteur
         		hmodifie(Securite,hNumEnrEnCours)
         	sinon
         		hraz(securite)
                 securite.IDUserGroup = gnIdGroupe
                 securite.OptionMenu = tableh.COL_IDOption
         		Securite.OptionActif = TABLEH.COL_Interrupteur
         		hajoute(Securite)
         	FIN
         FIN
         
         ferme(mafenetre)
        type : 18
      -
        type : 161
        enabled : false
  -
    name : Btn_Annule
    identifier : 0x2344b398a8674a95
    internal_properties : 
    properties :
     x : 721
     y : 137
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         Si tableh..modifié alors
         	si  ouinon("Voulez-vous annuler les modifications en cours ?") = Oui ALORS
         		ferme(mafenetre)
         	FIN
         sinon
         	Ferme(MaFenêtre)
         fin
         
         
         
         
        type : 18
      -
        type : 161
        enabled : false
