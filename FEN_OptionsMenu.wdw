 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1+
      PROCEDURE MaFenêtre(gsGroupe est une chaine,gnIdGroupe est un entier sur 8 octets)
      
      STOptionsMenu est une structure
      	sNomOption est une chaîne
      	sDescription est une chaîne
      fin
      gnIdmenu est une entier
   -
     code : |1+
      LIB_Groupe = gsgroupe
      SourceVersEcran()
      sdReqsql est une source de Données
      si hexecuterequetesql(sdReqsql,hRequêteDéfaut,"Select * from optionmenu where niveausuperieur = '' order by idoptionmenu") alors
      	pour TOUT sdReqsql
      		gnidmenu = tableajouteligne(TABLEH,sdReqsql.LibelleOption,0,sdReqsql.idoptionmenu)
      		FillMenu(gnidmenu,sdReqsql.LibelleOption)
      		
      	FIN
      fin
      
      POUR TOUT Securite AVEC IDUserGroup = gnIdGroupe
      	SI Securite.OptionActif ALORS
      		nRes est un entier = tablecherche(COL_IDOption,securite.OptionMenu,rechercheIdentique)
      		SI nRes <> -1 ALORS
      			TABLEH[nRes].COL_Interrupteur = Vrai
      		FIN
      	FIN
      	
      FIN
     type : 34
   -
     code : |1+
      
      
     type : 234
   -
     code : |1+
      
      
     type : 165
   -
     code : |1+
      
      
