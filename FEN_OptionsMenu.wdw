     type : 2
  procedures :
   -
     name : FillMenu
     procedure_id : 1385323645455820288
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //FillMenu (<gnidmenu>, <libelleoption1>)
      //
      // Paramètres :
      //	gnidmenu : <indiquez ici le rôle de gnidmenu>
      //	libelleoption1 : <indiquez ici le rôle de libelleoption>
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE FillMenu(gnidmenu,libelleoption1)
      nIdSousMenu est un entier
      
      
      
      pour tout optionmenu  avec  NiveauSuperieur = libelleoption1 DepuisFin
      	
      	nIdSousMenu = TableAjouteFils(TABLEH,gnidmenu,optionmenu.LibelleOption,0,OptionMenu.IDOptionMenu)
          FillMenu(nIdSousMenu,OptionMenu.NomOption)
      FIN
      
      
     type : 458752
   -
     name : CocheEnfant
     procedure_id : 1388415772671243359
     type_code : 14
     code : |1-
      PROCÉDURE CocheEnfant(i=0)
      j est un entier
      Value est un entier
      // Si aucun numéro de ligne n'a été passé en paramètre,
      // récupère l'indice de la ligne sélectionnée
      SI i = 0 ALORS i = TableSelect(TABLEH)
      Value = TABLEH[i].COL_Interrupteur
      j = TableRécupèreFils(TABLEH, i, taPremier)
      
      TANTQUE j <> -1
      	// Appel de la procédure en lui spécifiant
      	// le numéro de la ligne actuelle
      	TABLEH[j].COL_Interrupteur = Value 
      	Cocheenfant(j)
      	j = TableRécupèreFils(TABLEH, i, taSuivant)
      FIN
     type : 458752
