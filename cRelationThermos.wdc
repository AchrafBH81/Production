     name : Deleterelation
     procedure_id : 2009249979851904169
     type_code : 12
     code : |1-
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      // Deleterelation ()
      //
      // Paramètres :
      //	Aucun
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE Deleterelation()
      
      si :idRelation <> 0 alors
      	si hlitrecherche(RelationEDI,IDRelationEDI,:idRelation) alors
      		hsupprime(relationedi,hNumEnrEnCours)
      	FIN
      FIN
     type : 458752
   -
     name : SaveRelation
     procedure_id : 2008872160059936314
     type_code : 12
     code : |1-
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //SaveRelation (<idclient> est chaîne)
      //
      // Paramètres :
      //	idclient (chaîne ANSI) : <indiquez ici le rôle de idclient>
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE SaveRelation(idclient est une chaine)
      
      
      si :idRelation = 0 alors
      	MémoireVersFichier(objet,RelationEDI)
      	relationedi.IdClient = idclient
      	hajoute(RelationEDI)
      	SI HErreurDoublon() ALORS
      		
      	FIN
      sinon
      	si hlitrecherche(RelationEDI,IDRelationEDI,:idRelation) alors
            MémoireVersFichier(objet,RelationEDI)		
      	  HModifie(RelationEDI,hNumEnrEnCours)
      	FIN
      FIN
     type : 458752
