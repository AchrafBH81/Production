     p_codes :
      -
        code : |1+
         loriginal = moimeme
        type : 15
      -
        code : |1+
         //hlitrecherche("inter","cleclientproduit",cl.numero+complete(finispeciaux.icomposant1,10)+...
         //                                               complete(finispeciaux.icomposant2,10)+...
         //											   complete(finispeciaux.icomposant3,10)+complete(moimeme,40))
         si moimeme <> loriginal alors
         	RequeteClientIntercalaire.pIdClient = client.IDClient
         	RequeteClientIntercalaire.pidcomposant1 = complete(finispeciauxnew.icomposant1,10)
         	RequeteClientIntercalaire.pidcomposant2 = complete(finispeciauxnew.icomposant2,10)
         	RequeteClientIntercalaire.pidcomposant3 = complete(finispeciauxnew.icomposant3,10)
         	RequeteClientIntercalaire.pidFini = Complète(sansespace(moimeme),15)
         	
         	HExécuteRequête(RequeteClientIntercalaire)
         	
         	
         	
         	
         //	RequeteFiniSpacer.pClient = cl.numero
         //	RequeteFiniSpacer.pComposant1 = finispeciauxnew.icomposant1
         //	RequeteFiniSpacer.pComposant2 = finispeciauxnew.icomposant2
         //	RequeteFiniSpacer.pComposant3 = finispeciauxnew.icomposant3
         //	RequeteFiniSpacer.pFiniComplet = sansespace(moimeme)
         //	RequeteFiniSpacer.pFini = null
         //	HExécuteRequête(RequeteFiniSpacer)
         
         
         	//Code WinDev 5.5 remplacé par la migration :
         	//si pas h.endehors et h.trouve alors
         	si hnbenr(RequeteClientIntercalaire) <> 0 alors
         		//si pas HEnDehors() et HTrouve() alors
         		erreur("Cette fiche existe déja")
         		reprisesaisie(finispeciauxnew.icomposant1)
         	fin
         fin
