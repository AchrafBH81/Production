 controls :
  -
    name : BTN_OK
    identifier : 0x514f416227c14bbd
    internal_properties : 
    properties :
     x : 219
     y : 43
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         
         // Validation de la fiche
         
         EcranVersFichier
         InterClient.icomposant1 = complete(icomposant1,10)
         InterClient.icomposant2 = complete(icomposant2,10)
         InterClient.icomposant3 = complete(icomposant3,10)
         InterClient.ifini = complete(lefini,15)
         				// Transfert champs vers rubriques
         interclient.idclient = CL.idclient
         interclient.iClient = cl.numero
         
         
         // Enregistrement 
         selon ModeAppel
           cas "Création"
         	BOUCLE
         		// Adjonction de la fiche
         		HAjoute(NomFic)
         //        mafenetre..ValeurRenvoyée = {nomfic+".i2cleunik"}
                 
         		// test de "à chacun son tour"
         		Si pas HErreurBlocage() alors SORTIR
         	FIN
           cas "Modif"
         		BOUCLE
         
         			HModifie(NomFic)			// Modification
         			si pas HErreurBlocage() alors sortir
         		fin
           autre cas
         	Erreur("Mode incorrect: "+ModeAppel)
         	retour
         fin
         si HErreurDoublon() alors
         	Erreur("Erreur de doublon sur clé unique")
         	Retour
         fin
         si HErreurIntegrite() alors
         	Erreur(HErreurInfo())
         	Retour
         fin
         
         SaisieOK=Vrai	// Signale saisie validée
         Ferme			// Ferme la fenêtre
         
        type : 18
      -
        type : 161
        enabled : false
