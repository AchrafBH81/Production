    controls :
     -
       name : RUBRIQ1
       identifier : 0x51393f285df8aa65
       internal_properties : 
       properties :
        x : 30.9
        width : 89.01
        height : 4.762
       code_elements :
        type_code : 29
        p_codes :
         -
           code : |1+
            si client.CLangue=1 alors moimeme = sansespace(requeteextratrie.IDESC) sinon moimeme = sansespace(requeteextratrie.idesca)
            
           type : 327692
         -
           type : 327699
           enabled : false
     -
       name : CALCUL1
       identifier : 0x51393f285014aa65
       internal_properties : 
       properties :
        x : 119.91
        width : 18.721
        height : 4.762
       code_elements :
        type_code : 29
        p_codes :
         -
           code : |1+
            //si hlitrecherche(FclientExtra,IdClientNoProduit,HConstruitValClé(FclientExtra,IdClientNoProduit,client.IDClient,sansespace(requeteextratrie.INUM))) alors
            resultat est une chaine
            si fclientextra.prixSpecial alors
            	si requeteextratrie.ibase alors
            		calcul1 = FclientExtra.PrixAnglaisD
            		calcul2 = FclientExtra.PrixMetriqueD
            		calcul3 = FclientExtra.PrixAnglaisT
            		calcul4 = FclientExtra.PrixMetriqueT
            		calcul3..CouleurFond = iCouleurDéfaut
            		calcul4..CouleurFond = iCouleurDéfaut
            	sinon
            			
            		calcul1 = FclientExtra.PrixAnglais
            		calcul2 = FclientExtra.PrixMetrique
            		calcul3 = 0
            		calcul4 = 0
            		calcul3..CouleurFond = iGrisClair
            		calcul4..CouleurFond = iGrisClair
            
            		
            	FIN
            sinon
            	si requeteextratrie.ibase alors
            		calcul1 = requeteextratrie.IPRIXDOUBLE
            		calcul2 = requeteextratrie.iprixdoublem
            		calcul3 = requeteextratrie.IPRIXtriple
            		calcul4 = requeteextratrie.iprixtriplem
            		calcul3..CouleurFond = iCouleurDéfaut
            		calcul4..CouleurFond = iCouleurDéfaut
            	sinon
                    resultat = calculprixextra(requeteextratrie.INUM)
            		calcul1 = val(extraitchaine(resultat,1,","))
            		calcul2 = val(extraitchaine(resultat,2,","))
            		calcul3 = 0
            		calcul4 = 0
            		calcul3..CouleurFond = iGrisClair
            		calcul4..CouleurFond = iGrisClair
            	FIN
            
            FIN
            
           type : 327692
         -
           type : 327699
           enabled : false
     -
