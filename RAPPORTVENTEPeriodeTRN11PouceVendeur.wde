 controls : []
 code_elements :
  type_code : 13
  p_codes :
   -
     code : |1+
      Procedure RAPPORTVENTEPeriodeTRN11PouceVendeur(lchoixrapport="", lchoixsommaire="", lperiode="",lvendeur="",lmois="",lannee="",lsaut = 2,ltabhistoasso = null)
      
      
      
      
      
      global
      noclient est une chaine
      novendeur est une chaine
      cpt est un entier = 0	
      	sautdepage est un booleen
      //hlitpremier("config","COCLEUNIK")
      moisdebut est un entier = val(dateverschaine(gclconfig.m_dcanneeencoursdebut,"MM"))
      
      //szmodeetat = "PAYSAGE"
      anciensecteur est une chaine = ""
      si sansespace(lchoixrapport) = "Tous" et lchoixsommaire alors
      	sautdepage = faux
      sinon
      
      //	si lsaut = 1 alors
      		sautdepage = vrai
      //	fin
      
      	//Code WinDev 5.5 remplacé par la migration :
      	//	bloc_fin..VISIBLE = FAUX	
      	bloc_fin..Visible=Faux	
      FIN
      
      lmoisabrev est un tableau de 12 chaines
      lmoisabrev[1] = "Janv."
      lmoisabrev[2] = "Févr."
      lmoisabrev[3] = "Mars"
      lmoisabrev[4] = "Avril"
      lmoisabrev[5] = "Mai"
      lmoisabrev[6] = "Juin"
      lmoisabrev[7] = "Juil."
      lmoisabrev[8] = "Août"
      lmoisabrev[9] = "Sept."
      lmoisabrev[10] = "Oct."
      lmoisabrev[11] = "Nov."
      lmoisabrev[12] = "Déc."
      
     type : 327680
   -
     code : |1-
      pour tout lhistomois,idclient de ltabhistoasso
      	cpt++
      	SI  Gauche(idclient,1) <> novendeur ET novendeur <> "" ALORS
      		iImprimeBloc("BAS_RUPTURE-1")
      	FIN
      	
      	novendeur = Gauche(idclient,1)
      	
      	POUR j = 1 A 12
      		
      		{"totalclient"+j} +={"lhistomois.m"+j }
      		{"totalsecteur"+j} += {"lhistomois.m"+j }
      		{"toussecteur"+j} += {"lhistomois.m"+j }
      	FIN
      	
      	noclient = idclient
      
      	si sautdepage alors iImprimeBloc("BAS_RUPTURE-2")
      FIN
      
      
      "BAS_RUPTURE-2"..visible = faux
      renvoyer faux
     type : 327695
   -
     code : |1+
      //si client.cetat=2 alors renvoyer faux
      
      
      
     type : 327696
  procedures :
   -
     name : TRISECTEUR
     procedure_id : 1620935320728099579
     type_code : 14
     code : |1+
      Procédure TRISECTEUR()
      
      HLITRECHERCHE("client","numero",bonlivraison.bclient)
      
      //Code WinDev 5.5 remplacé par la migration :
      //SI PAS H.ENDEHORS ET H.TROUVE ALORS
      SI PAS HEnDehors() ET HTrouve() ALORS
      	RENVOYER client.secteur
      SINON
      	RENVOYER 0 
      FIN
      
     type : 458752
   -
     name : ajoutezero
     procedure_id : 1620935320728165115
     type_code : 14
     code : |1+
      Procédure ajoutezero(chaineamodifier)
      valeuraretourner est une chaine
      si val(chaineamodifier) > 12 alors
         chaineamodifier = sansespace(numeriqueverschaine(val(chaineamodifier) - 12))
      fin
      si taille(sansespace(chaineamodifier)) = 2 alors
      	valeuraretourner = chaineamodifier
      sinon
      	valeuraretourner = "0"+chaineamodifier	
      FIN
      renvoyer(valeuraretourner)
      
     type : 458752
  procedure_templates : []
  property_templates : []
