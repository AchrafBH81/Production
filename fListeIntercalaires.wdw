 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1+
      PROCEDURE MaFenêtre(ListeID est une chaine)
      
      mafenetre..ValeurRenvoyée = ""
      tabintercalaire est un tableau dynamique de 0 chaines
      IndiceTrouve est une entier
      pour TOUT Intercalaires sur intercalaires.OrdreAffichage
      	listeajoute(Liste_Intercalaires,Intercalaires.Description)
      FIN
   -
     code : |1+
      
      ChaîneVersTableau(listeid,tabintercalaire,";")
      pour chaque _inter de tabintercalaire
      	IndiceTrouve = ListeCherche("Liste_Intercalaires",_inter,vrai,1)
      	si  indicetrouve<> -1 ALORS
      		listeselectplus(Liste_Intercalaires,IndiceTrouve)
      	FIN
      FIN
      
     type : 34
   -
     type : 180
     enabled : false
   -
     type : 230
     enabled : false
