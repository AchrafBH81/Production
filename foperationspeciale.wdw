           p_codes : []
        -
          name : BtnEpurePDF
          identifier : 0x493437104dc68de9
          internal_properties : 
          properties :
           x : 462
           y : 37
           width : 36
           height : 36
          type : 4
          code_elements :
           type_code : 4
           p_codes :
            -
              code : |1+
               DateEnCours est une date
               
               TypeDoc est un tableau de 4 chaines
               TypeDoc = ["Conf","Soum","ListePrix","Facture"]
               TypeDocARecherche est un tableau dynamique de chaine
               pour i = 1 a 4
               	si IntDocuments[i] alors
               		TypeDocARecherche.ajoute(TypeDoc[i])
               	FIN
               FIN
               NbRecord est un entier = HNbEnr(ArchiveEmail)
               cpt est un entier
               
               
               OuvreSoeur(FenAttentePetite,"Epuration du fichier PDF en cours......")
               EpurationPdf(csnNbJours,TypeDocARecherche)
               
               
               pour tout ArchiveEmail 
               	DateEnCours = ArchiveEmail.dateEmail
               	
               	sChaîneExtraite est une chaine
               	
               	// Extraction de la chaîne
               	sChaîneExtraite = ExtraitChaîne(ArchiveEmail.lFichierAttaché, 1, "\PDF")
               	
               		
               	
               	
               	si sChaîneExtraite <> repdonnees _ou_ (Position(archiveemail.lFichierAttaché,TypeDocARecherche,1,DepuisDébut)  > 0 _et_ DateDifférence(DateEnCours,datesys()) >= val(csnNbJours)) ALORS
               		FenAttentePetite.libelle1 = "Suppression de la référence dans la base de données"+rc+rc+(sansespace(archiveemail.lFichierAttaché) = "" ? "aucun fichier attaché" sinon ArchiveEmail.lFichierAttaché)
               		
               		multitacherepeint(FenAttentePetite)
               		
               		HSupprime(ArchiveEmail,hNumEnrEnCours)
               	fin
               	cpt++
               	Message(cpt +" / " + NbRecord )
               	MultitâcheRepeint(foperationspeciale)
               fin
               
               multitache(100)
               ferme(FenAttentePetite)
               
              type : 18
            -
              type : 161
              enabled : false
        -
          name : csnNbJours
          identifier : 0x493437cd5f64734e
