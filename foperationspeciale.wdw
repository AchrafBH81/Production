        -
          name : BtnEpuration
          identifier : 0x48c1792a3347cc26
          internal_properties : 
          properties :
           x : 276
           y : 24
           width : 20
           height : 20
          type : 4
          code_elements :
           type_code : 4
           p_codes :
            -
              code : |1+
               
               si acso_message("Question","Voulez-vous épurer le fichier LOG ?","OuiNon") = idyes alors
                  hlit(config,1)
                  acso_message("Information","Seulement les transactions des "+config.NbJourLogFile+" derniers jours seront conservées","Info")
                  ouvresoeur(FenAttentePetite)
                  
               	pour tout logfile 
               		si DateDifférence(logfile.ldate,datesys()) > config.NbJourLogFile alors
               	        FenAttentePetite.libelle1 = "Suppression des données du "+DateVersChaine(LogFile.ldate,"JJ/MM/AAAA")
               		    MultitacheRepeint(FenAttentePetite)
               			HSupprime(LogFile,hNumEnrEnCours)
               		FIN
               	 fin
               	  multitache(100)
               	 ferme(FenAttentePetite) 
               //	fin	
               FIN
               
               
              type : 18
            -
              type : 161
              enabled : false
        -
          name : BtnCourriel
          identifier : 0x48c1982d6c131c1e
          internal_properties : 
          properties :
           x : 318
           y : 24
           width : 20
           height : 20
          type : 4
          code_elements :
           type_code : 4
           p_codes :
            -
              code : |1+
               si zipCrée("Logfile",ComplèteRep(repdonnees)+"logfile.wdz")=0  alors
               	zipAjouteFichier("Logfile",ComplèteRep(repdonnees)+"logfile.fic")
               	zipAjouteFichier("Logfile",ComplèteRep(repdonnees)+"logfile.ndx")
               	zipFerme("Logfile")
               	ouvre(FenEmail,config.EmailGestionErreur,"Fichier LOG","Fichier log compressé",ComplèteRep(repdonnees)+"logfile.wdz"+";")
               fin
              type : 18
            -
              type : 161
