     -
       name : MenuHier
       identifier : 0x4934415718d0b66d
       internal_properties : 
       code_elements :
        type_code : 26
        p_codes :
         -
           code : |1-
            dDateDébut 	est une Date
            dDateFin	est une Date
            sSuperChamp est une chaine = ""
            
            // Initialiser les deux dates à la date du jour
            dDateDébut = datesys()
            dDateFin = datesys()
            
            // Récupérer le nom du super champ
            sSuperChamp = ExtraitChaîne(ChampContextuel(), 1, ".")
            
            // Récupérer le jour précédent
            dDateDébut..jour--
            dDateFin..jour--
            
            // Initialiser les deux champs date avec la date du jour
            executetraitement(sSuperChamp + ".InitialiserChampDate", trtprocédure, dDateDébut, dDateFin, sSuperChamp)
           type : 32
     -
       name : MenuSemaineCourante
       identifier : 0x493441572cbbb66d
       internal_properties : 
       code_elements :
        type_code : 26
        p_codes :
         -
           code : |1-
            dDateDébut 	est une Date
            dDateFin	est une Date
            nNumJour 	est un entier = 0
            sSuperChamp est une chaine = ""
            
            // Initialiser les deux dates à la date du jour
            dDateDébut = datesys()
            dDateFin = datesys()
            
            // Récupérer le nom du super champ
            sSuperChamp = ExtraitChaîne(ChampContextuel(), 1, ".")
            
            // Récupérer le numéro du jour de la semaine
            nNumJour = EntierVersJour(dateversentier(dDateDébut))
            
            // Modifier le jour pour qu'il corresponde au Lundi
            dDateDébut..jour -= (nNumJour-1)
            
            // Initialiser les deux champs date avec la date du jour
            
            executetraitement(sSuperChamp + ".InitialiserChampDate", trtprocédure, dDateDébut, dDateFin, sSuperChamp)
           type : 32
     -
       name : MenuSemainePrécédente
       identifier : 0x4934415772a1b66d
       internal_properties : 
       code_elements :
        type_code : 26
        p_codes :
         -
           code : |1-
            dDateDébut 	est une Date
            dDateFin	est une Date
            nNumJour 	est un entier = 0
            sSuperChamp est une chaine = ""
            
            // Initialiser les deux dates à la date du jour
            dDateDébut = datesys()
            dDateFin = datesys()
            
            // Récupérer le nom du super champ
            sSuperChamp = ExtraitChaîne(ChampContextuel(), 1, ".")
            
            // Positionner le jour sur la semaine précédente
            dDateDébut..jour -= 7
            
            // Récupérer le numéro du jour de la semaine
            nNumJour = EntierVersJour(dateversentier(dDateDébut))
            
            // Modifier le jour pour qu'il corresponde au Lundi
            dDateDébut..jour -= (nNumJour-1)
            
            // Modifier le jour pour qu'il corresponde au Dimanche
            dDateFin = dDateDébut
            dDateFin..jour += 6
            
            // Initialiser les deux champs date avec la date du jour
            executetraitement(sSuperChamp + ".InitialiserChampDate", trtprocédure, dDateDébut, dDateFin, sSuperChamp)
           type : 32
