  p_codes :
   -
     code : |1+
      procedure foperationspeciale(mode est une chaine = "Normal",OrderNumber est une chaine = "")
   -
     code : |1+
      si mode = "Normal" alors
      	si sansespace(config.cMotDePasseSpecial) = "" alors
      		acso_message("Info","Le mot de passe pour accéder à l'option de récupération n'existe pas ","Info")
      		ouvre(facces,"creation")
      	FIN
      	
      	
      	moimeme..plan = 1
      	csnNbJours = config.NbJourPdf
      sinon
      	MoiMême..Plan = 2
      	Onglet1 = 3
      //	onglet1..etat = inactif
      	Onglet1[1]..Etat = Inactif
      	Onglet1[2]..Etat = Inactif
      	Onglet1[4]..Etat = Inactif
      	//	TableLog..etat = actif
      	BtnRefresh..Visible = Faux
      	BtnEpuration..Visible = Faux
      	BtnCourriel..Visible = Faux
      	csnnocommande = ordernumber
      	csnnocommande..etat = inactif
      	executetraitement(BtnRefresh,trtclic)
      	
      fin
     type : 34
