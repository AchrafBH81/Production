         -
           code : |1+
            moimeme..filtre=hconstruitvalcle("GPWConfiguration","Groupe_Configuration",vrai)
           type : 14
         -
           code : |1+
            // recherche de l'utilisateur dans le fichier de relation
            sValCle est une chaine=HConstruitValClé(GPWUtilisateurConfiguration,"Login_Application",Login,ProjetInfo())
            // recherche du login dans le fichier de relation entre les login et les applications
            HLitRecherchePremier(GPWUtilisateurConfiguration,"Login_Application",sValCle)
            si pas htrouve(GPWUtilisateurConfiguration) ALORS
            	sValCle=HConstruitValClé(GPWUtilisateurConfiguration,"Login_Application",Login,gpwDéfaut)
            	// recherche du login dans le fichier de relation entre les login et les applications
            	HLitRecherchePremier(GPWUtilisateurConfiguration,"Login_Application",sValCle)
            FIN
            
            // trouvé
            si htrouve(GPWUtilisateurConfiguration) ALORS
            	// modification de son groupe
            	GPWUtilisateurConfiguration.Configuration=moimeme
            	
            	// modification de l'utilisateur
            	si pas HModifie(GPWUtilisateurConfiguration) ALORS
            		erreur(<§$0005§>+RC+HErreurInfo())
            		// rafraichissement de la table
            		AfficheTable()
            	FIN
            FIN
            
            
