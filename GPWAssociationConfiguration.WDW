 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1+
      //-----------------------------------------------
      GPWUtilisateur est une source de données
      GPWUtilisateurConfiguration est une source de données
      GPWConfiguration est une source de données
      GPWConfigurationElement est une source de données
      GPWElement est une source de données
      //-----------------------------------------------
      
   -
     code : |1-
      // affichage de la table
      AfficheTable()
      
      // en mode LDAP le bouton d'importation doit être visible
      si gpwEnModeLDAP() ALORS
      	BTN_ImportLDAP..visible=vrai
      FIN
     type : 34
   -
     type : 180
     enabled : false
   -
     type : 230
     enabled : false
   -
     type : 11
   -
     type : 12
   -
     type : 17
   -
     type : 13
  procedures :
   -
     name : AfficheTable
     procedure_id : 4448710157701272704
     type_code : 14
     code : |1+
      // Mise à jour de la table
      Procédure AfficheTable()
      
      // récupération du login en cours
      sLogin est une chaine
      si Configuration_Utilisateur..Occurrence>0 ALORS
      	sLogin=Configuration_Utilisateur.Login
      FIN
      
      // vide la table
      TableSupprimeTout(Configuration_Utilisateur)
      
      sValCle est une chaine // valeur de la clé composée
      
      // parcours du fichier des utilisateurs pour les configuratons par défaut
      hlitpremier(GPWUtilisateur,"Login")
      tantque pas HEnDehors(GPWUtilisateur)
      	sValCle=HConstruitValClé(GPWUtilisateurConfiguration,"Login_Application",GPWUtilisateur.Login,gpwDéfaut)
      	// recherche du login dans le fichier de relation entre les login et les applications
      	HLitRecherchePremier(GPWUtilisateurConfiguration,"Login_Application",sValCle)
      	si HTrouve(GPWUtilisateurConfiguration) alors
      		// rempli la table
      		TableAjouteligne(Configuration_Utilisateur,GPWUtilisateur.Login,GPWUtilisateurConfiguration.Configuration,GPWUtilisateur.Nom,GPWUtilisateur.Prenom)
      	fin
      	// utilisateur suivant
      	hlitsuivant(GPWUtilisateur,"Login")
      FIN
      
      // parcours du fichier des utilisateurs pour les configuration superviseur
      hlitpremier(GPWUtilisateur,"Login")
      tantque pas HEnDehors(GPWUtilisateur)
      	sValCle=HConstruitValClé(GPWUtilisateurConfiguration,"Login_Application",GPWUtilisateur.Login,gpwSuperviseur)
      	// recherche du login dans le fichier de relation entre les login et les applications
      	HLitRecherchePremier(GPWUtilisateurConfiguration,"Login_Application",sValCle)
      	si HTrouve(GPWUtilisateurConfiguration) alors
      		// rempli la table
      		TableAjouteligne(Configuration_Utilisateur,GPWUtilisateur.Login,GPWUtilisateurConfiguration.Configuration,GPWUtilisateur.Nom,GPWUtilisateur.Prenom)
      	fin
      	// utilisateur suivant
      	hlitsuivant(GPWUtilisateur,"Login")
      FIN
      
      // parcours du fichier des utilisateurs
      hlitpremier(GPWUtilisateur,"Login")
      tantque pas HEnDehors(GPWUtilisateur)
      	// si le l'utilisateur n'est pas déjà dans la table
      	si TableCherche(Configuration_Utilisateur.Login,GPWUtilisateur.Login)<1 ALORS
      		// construction ed la clé composée
      		sValCle=HConstruitValClé(GPWUtilisateurConfiguration,"Login_Application",GPWUtilisateur.Login,ProjetInfo())
      		// recherche du login dans le fichier de relation entre les login et les applications
      		HLitRecherchePremier(GPWUtilisateurConfiguration,"Login_Application",sValCle)
      		
      		// si l'utilisateur n'est pas associé à l'application
      		si pas htrouve(GPWUtilisateurConfiguration) ALORS
      			// association de la configuration par défaut à l'utilisateur
      			HRAZ("GPWUtilisateurConfiguration")
      			GPWUtilisateurConfiguration.Login=GPWUtilisateur.Login
      			GPWUtilisateurConfiguration.Configuration=gpwAucun
      			GPWUtilisateurConfiguration.Application=ProjetInfo()
      	
      			// ajout de l'enregistrement
      			SI PAS HAjoute("GPWUtilisateurConfiguration") ALORS
      				Erreur(<§$0006§>+RC+HErreurInfo())
      				retour
      			FIN
      		FIN
      	
      		// ajoute la ligne dans la table
      		TableAjouteligne(Configuration_Utilisateur,GPWUtilisateur.Login,GPWUtilisateurConfiguration.Configuration,GPWUtilisateur.Nom,GPWUtilisateur.Prenom)
      	fin
      
      	// utilisateur suivant
      	hlitsuivant(GPWUtilisateur,"Login")
      FIN
      
      // repositionne le bandeau sur le login précédent
      nIndice est un entier=TableCherche(Configuration_Utilisateur.Login,sLogin,faux)
      si nIndice>0 alors
      	TableSelectPlus(Configuration_Utilisateur,nIndice)
      FIN
      
     type : 458752
