  -
    name : Modif_droits
    identifier : 0x3be8ff3d652f8f5f
    internal_properties : 
    properties :
     x : 653
     y : 157
     width : 132
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         // pas de gestion de droits sur le groupe superviseur
         SI CONFIGURATION=gpwSuperviseur ALORS
         	info(<§$0003§>)
         	retour
         FIN
         
         // pas de gestion de droits sur le groupe par défaut
         SI CONFIGURATION=gpwdefaut ALORS
         	info(<§$0004§>)
         	retour
         FIN
         
         // nom de la configuation
         sConfiguration est une chaine
         // si l'utilisateur n'est pas dans un groupe
         si Configuration=gpwAucun alors
         	// l'utiliateur a une configuration spécifique
         	sConfiguration=Login
         	
         	// recherche de la configuration
         	hlitrecherchepremier("GPWConfiguration","Application_Configuration",HConstruitValClé("GPWConfiguration","Application_Configuration",ProjetInfo(),Login))
         	si pas htrouve("GPWConfiguration") ALORS
         		// création de la configuration spécifique à l'utilisateur
         		hraz("GPWConfiguration")
         		GPWConfiguration.Application=ProjetInfo()
         		GPWConfiguration.Configuration=sConfiguration
         		GPWConfiguration.Groupe=Faux
         		si pas hajoute("GPWConfiguration") alors
         			erreur(<§$0002§>+rc+HErreurInfo())
         			retour
         		fin
         	FIN
         sinon
         	sConfiguration=Configuration
         FIN
         
         // ouvre la fenêtre de configuration des éléments
         ouvre("GPWDetailConfiguration",sConfiguration)
         	
         // rafraichissement de la combo
         listeaffiche(Configuration,taInit)
         // rafraichissement de la table
         AfficheTable()
        type : 18
      -
        type : 161
        enabled : false
