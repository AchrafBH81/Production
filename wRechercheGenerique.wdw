  -
    name : Btn_Recherche
    identifier : 0x445760c6017c8b1b
    internal_properties : 
    properties :
     x : 664
     y : 58
     width : 40
     height : 40
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         selon SelCritere
         	cas 1
         		RequeteRechercheGenerique.pNoTel = null
         		RequeteRechercheGenerique.pNom = cstvaleur
         
         	cas 2
         		RequeteRechercheGenerique.pNom = null
         		RequeteRechercheGenerique.pNotel = cstvaleur
         fin
         RequeteRechercheGenerique.pClientCash = config.NoClientComptant
         HExécuteRequête(RequeteRechercheGenerique)
         si pas hnbenr(RequeteRechercheGenerique) = 0 alors
         	tableaffiche(Table_RechercheGenerique,taDébut)
         	bouton1..etat = actif
         	reprisesaisie(Table_RechercheGenerique)
         sinon
         	acso_message("Info","Aucune facture ne correspond a votre demande","Info")
         	TableSupprimeTout(Table_RechercheGenerique)
         	TableAffiche(Table_RechercheGenerique,taInit)
         	cstvaleur = ""
         	reprisesaisie(cstvaleur)
         fin		
         
        type : 18
      -
        type : 161
        enabled : false
