  -
    name : BTN_OK
    identifier : 0x3e9d90ce70e4b07b
    internal_properties : 
    properties :
     x : 414
     y : 106
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         memcree("zonefacture")
         si selecteurcommande = 2 alors
         	//info(combo_secteur[combo_secteur])
         	si combo_secteur[combo_secteur] = -1 alors
         		erreur("Vous devez sélectionner un secteur")
         		reprisesaisie("combo_secteur")
         	FIN
         fin	 
         hexecuterequete(RequeteCommande)
         //hlitpremier("Facture","fanumero")
         hlitpremier(requetecommande)
         //Code WinDev 5.5 remplacé par la migration :
         //tantque pas h.endehors
         tantque pas HEnDehors(requetecommande)
         	//info(facture.fasecteur = sansespace(combo_secteur[combo_secteur]))
         hlitrecherche(facture,fanumero,requetecommande.fanumero)
         	si SelecteurCommande = 2 alors
         //		
         si sansespace(facture.fasecteur)  = sansespace(combo_secteur[combo_secteur]) alors
         			memajoute("zonefacture",h.numenr,h.numenr)
         		FIN
             sinon
         		memajoute("zonefacture",h.numenr,h.numenr)
         		
         	FIN
         	//    hlitsuivant("Facture","fanumero")
         	    hlitsuivant(requetecommande)
         fin
         
         iconfigure(sansespace(imprimanterapport),vrai)
         //Début du code généré par l'assistant de code de la fonction iParamètre
         
         
         iParamètre("DEFAUT=NON")
         iParamètre("FORMATPAPIER=LETTRE")
         iParamètre("QUALITE=HAUTE")
         
         
         
         si destination = 2 alors
         	iapercu(75,"Commandes")
         fin
         //iimprimeetat("LISTE DES COMMANDES","zonefacture")
         //iimprimeetat(LISTE_DES_COMMANDES_detail,"zonefacture")
         //iImprimeEtat("liste des commandes detail","zonefacture")
         iImprimeEtat(LISTE_DES_COMMANDES_detail,"zonefacture")
        type : 18
