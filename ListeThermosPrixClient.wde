    controls :
     -
       name : RUBRIQ1
       identifier : 0x4935797c3b662162
       internal_properties : 
       properties :
        x : 30.9
        width : 117.85
        height : 5.
       code_elements :
        type_code : 29
        p_codes :
         -
           code : |1+
            si hlitrecherche(persoens,ennumero,RequetePersoClient.IdThermos) alors
            	si client.CLangue=1 alors moimeme = persoens.endescription sinon moimeme = persoens.endescriptiona
            sinon
            	si client.CLangue=1 alors moimeme = "Thermos Inexistant" sinon moimeme = "Thermos not found"		
            FIN
           type : 327692
         -
           type : 327699
           enabled : false
     -
       name : CALCUL1
       identifier : 0x4935797c0e552162
       internal_properties : 
       properties :
        x : 148.8
        width : 22.
        height : 5.
       code_elements :
        type_code : 29
        p_codes :
         -
           code : |1+
            //calcul1 = calculprix(ENSEMBLE.encomposant1,ENSEMBLE.encomposant2,ENSEMBLE.encomposant3,"A",ENSEMBLE.epbase) //* (100 - spqteint.spqpourcentageescompte) / 100
            si RequetePersoClient.prixSpecial alors
            	calcul1 = RequetePersoClient.Tprixa
            	calcul2 = RequetePersoClient.Tprixm
            
            sinon
              si hlitrecherche(persoens,ennumero,RequetePersoClient.IdThermos) alors
            	calcul1 = persoens.enprixa * (100-client.Cpourescompte) / 100
            	calcul2 = Persoens.enprixm * (100-client.Cpourescompte) / 100
            sinon
            	calcul1 = 0
            	calcul2 = 0
            fin
              		
            FIN
           type : 327692
         -
           type : 327699
           enabled : false
