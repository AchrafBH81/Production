            //calcul2 = calcul_prixu(ENSEMBLE.encomposant1,ENSEMBLE.encomposant2,ENSEMBLE.encomposant3,"M",ENSEMBLE.epbase) //* (100 - spqteint.spqpourcentageescompte) / 100
            
