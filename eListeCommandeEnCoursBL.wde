   -
     code : |1+
      HAUT_DE_PAGE..visible= faux
     type : 327680
   -
     code : |1+
      si sansespace(requeteblnonfacturé.fprEPARATION) = "B" alors renvoyer faux
      
      SI requeteblnonfacturé.FANUMERO = 0 ALORS RENVOYER FAUX
      SI requeteblnonfacturé.fatypedocument <> 1 ALORS RENVOYER FAUX
      
      
     type : 327696
   -
     code : |1+
      
      gtotalthermosbl = rthermostotal1
      gtotalcarrelagebl = Rcarrelagetotal1
      gtotalcarrelageptbl = RCarrelagePtTotal1
      gtotalpeinturebl = RPeintureTotal1
      gtotalautresbl = RautresTotal1
      gtotaltotalbl = RTotalTotal1
      
      
      
     type : 327682
  procedures :
   -
     name : calculTotalCommande
     procedure_id : 5168322606942388210
     type_code : 14
     code : |1+
      Procédure calculTotalCommande(lNoCommande=0)
      TotalCommande est un reel
      //SI MODIF ALORS
      
      
      
      
      hlitrecherche(hfdetail,HFCLEUNIK,lNoCommande)
      //Code WinDev 5.5 remplacé par la migration :
      //tantque pas h.endehors
      tantque pas HEnDehors() et hfdetail.HFCLEUNIK= lNoCommande
      
      	selon hfdetail.ftype
      		cas 1
      			rthermos +=  arrondi(hfdetail.fdqteafacturer * ((hfdetail.fdpiedcarrefacture * hfdetail.fdprixupiedfacture) + ...
      			hfdetail.fdextraforme),2)+arrondi(hfdetail.fdqteafacturer *hfdetail.FDextra10X,2)+...
      			arrondi(hfdetail.fdqteafacturer *hfdetail.FDextra5x,2)+arrondi(hfdetail.SUrchargeafacturer,2)
      			rtotalcommande +=  arrondi(hfdetail.fdqteafacturer * ((hfdetail.fdpiedcarrefacture * hfdetail.fdprixupiedfacture) + ...
      			hfdetail.fdextraforme),2)+arrondi(hfdetail.fdqteafacturer *hfdetail.FDextra10X,2)+...
      			arrondi(hfdetail.fdqteafacturer *hfdetail.FDextra5x,2)+arrondi(hfdetail.SUrchargeafacturer,2)
      		cas 2
      			rthermos +=  arrondi(hfdetail.fdqteafacturer * hfdetail.fdprixu,2)
      			RTotalCommande +=  arrondi(hfdetail.fdqteafacturer * hfdetail.fdprixu,2)
      		cas 3
      			rautres +=  arrondi(hfdetail.fdqteafacturer * hfdetail.fdprixupied,2)
      			rtotalcommande +=  arrondi(hfdetail.fdqteafacturer * hfdetail.fdprixupied,2)
      		cas 4
      			rcarrelage +=  arrondi((hfdetail.frcarrprixu + hfdetail.fdcarrprixdebase)* hfdetail.fdqteafacturer,2)
      
      			rtotalcommande +=  arrondi((hfdetail.frcarrprixu + hfdetail.fdcarrprixdebase)* hfdetail.fdqteafacturer,2)...
      			+arrondi(((hfdetail.Ftotalcarreaupeinture*hfdetail.fPrixCarreauPeinture)...
      			+(hfdetail.FDnbcarreauPeinture1*hfdetail.fdprixcarreaupeinture1))...
      			* hfdetail.fdqteafacturer ,2)
      
      			rcarrelagept += arrondi(((hfdetail.Ftotalcarreaupeinture*hfdetail.fPrixCarreauPeinture)...
      			+(hfdetail.FDnbcarreauPeinture1*hfdetail.fdprixcarreaupeinture1))...
      			* hfdetail.fdqteafacturer ,2)
      		cas 5
      			rpeinture +=  arrondi(hfdetail.fdqteafacturer * (hfdetail.fdpiedcarrefacture * hfdetail.fdprixupied),2)
      			rtotalcommande+=  arrondi(hfdetail.fdqteafacturer * (hfdetail.fdpiedcarrefacture * hfdetail.fdprixupied),2)
      
      
      	FIN
      
      
      	//hmodifie("trdetail")
      	HLITSUIVANT(hfdetail,HFCLEUNIK)
      
      fin		 
      
      //FIN
      
     type : 458752
   -
     name : calculTotalCommandeBAK
     procedure_id : 5330509605697282935
     type_code : 14
     code : |1+
      Procédure calculTotalCommandeBAK(lNoCommande=0)
      TotalCommande est un reel
      //SI MODIF ALORS
      
      
      
      
      hlitrecherche(hfdetail,HFCLEUNIK,lNoCommande)
      //Code WinDev 5.5 remplacé par la migration :
      //tantque pas h.endehors
      tantque pas HEnDehors() et fdetail.fdnocomm= lNoCommande
      
      	selon fdetail.ftype
      		cas 1
      			rthermos+=arrondi(fdetail.fdprixtotal,2)+arrondi(fdetail.surchargeenergie,2)
      			RTotalCommande+=arrondi(fdetail.fdprixtotal,2)+arrondi(fdetail.surchargeenergie,2)
      		cas 2
      			rthermos+=arrondi(fdetail.fdprixtotal,2)+arrondi(fdetail.surchargeenergie,2)
      			RTotalCommande+=arrondi(fdetail.fdprixtotal,2)+arrondi(fdetail.surchargeenergie,2)
      		cas 3
      			rautres+=arrondi(fdetail.fdprixtotal,2)
      			RTotalCommande+=arrondi(fdetail.fdprixtotal,2)
      		cas 4
      			rcarrelage+=arrondi(fdetail.fdprixtotal,2)
      			RTotalCommande+=arrondi(fdetail.fdprixtotal,2)
      			si fdetail.fpeinture alors
      				RTotalCommande+=arrondi(fdetail.fTotalPeinture,2)
      				rcarrelagept+=arrondi(fdetail.fTotalPeinture,2)
      			fin
      		cas 5
      			rpeinture+=arrondi(fdetail.fdprixtotal,2)
      			RTotalCommande+=arrondi(fdetail.fdprixtotal,2)
      
      	FIN
      
      
      	//hmodifie("trdetail")
      	HLITSUIVANT(fdetail,fdnocomm)
      
      fin		 
      
      //FIN
      
