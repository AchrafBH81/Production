    name : BTN_SORTIE
    identifier : 0x520d60a56e9d10db
    internal_properties : 
    properties :
     x : 15
     y : 6
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         
         //RADDebloque()		// Débloque l'enregistrement
         Ferme
         
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_AJOUT
    identifier : 0x520d60a5561d10db
    internal_properties : 
    properties :
     x : 98
     y : 6
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         // Ajoute
         //Code WinDev 5.5 remplacé par la migration :
         //Table..Etat=Actif
         Table_Typecredit..Etat=Actif; Table_Typecredit..Visible=Vrai
         TableAjoute(Table_Typecredit)
         RepriseSaisie(Table_Typecredit.TypeCredit)
         
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_DETRUIRE
    identifier : 0x520d60a5304410db
    internal_properties : 
    properties :
     x : 135
     y : 6
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         
         // Suppression
         si Table_Typecredit..Nouveau alors
         	si Table_Typecredit..occurrence<2 alors
         		REPRISESAISIE(Table_Typecredit)
         	sinon
         		TableSupprime(Table_Typecredit)
         	fin
         sinon
         	si (Table_Typecredit..Etat=AffichageSeulement ET Table_Typecredit..Visible=Vrai) alors
         		acso_message("Erreur","Information déjà en utilisation ","Erreur")
         		retour
         	fin
         	si acso_message("Question","Voulez-vous supprimer l'enregistrement?","OuiNon") = idyes alors
         		TableSupprime(Table_Typecredit)
         		si HErreurIntegrite() alors
         			Erreur(HErreurInfo())	// "Erreur d'intégrité"
         			Retour
         		Fin
         	fin
         fin
         
         si TableOccurrence(Table_Typecredit)=0 alors
         	REPRISESAISIE(Table_Typecredit)
         SINON
         	// Le bouton Supprimer est en interruption
         	// Il faut forcer l'entrée dans la nouvelle ligne
         
         	ExecuteTraitement(Table_Typecredit,trtENTREELIGNE)
         fin
         tableaffiche(Table_Typecredit)
        type : 18
      -
        type : 161
        enabled : false
