 popup_menus :
  -
    name : MenuDatePrédéfinie
    identifier : 0x4d8271ba1e81d4d5
    internal_properties : 
    options :
     -
       name : MenuAujourdhui
       identifier : 0x4d8271ba4077d4d5
       internal_properties : 
       code_elements :
        type_code : 26
        p_codes :
         -
           code : |1-
            sSuperChamp est une chaine = ""
            
            // Récupérer le nom du super champ
            sSuperChamp = ExtraitChaîne(ChampContextuel(), 1, ".")
            
            // Initialiser les deux champs date avec la date du jour
            executetraitement(sSuperChamp + ".InitialiserChampDate", trtprocédure, DateDuJour(), DateDuJour(), sSuperChamp)
           type : 32
     -
       name : MenuHier
       identifier : 0x4d8271ba4a0ad4d5
       internal_properties : 
       code_elements :
        type_code : 26
        p_codes :
         -
           code : |1-
            dDateDébut 	est une Date
            dDateFin	est une Date
            sSuperChamp est une chaine = ""
            
            // Initialiser les deux dates à la date du jour
            dDateDébut = datesys()
            dDateFin = datesys()
            
            // Récupérer le nom du super champ
            sSuperChamp = ExtraitChaîne(ChampContextuel(), 1, ".")
            
            // Récupérer le jour précédent
            dDateDébut..jour--
            dDateFin..jour--
            
            // Initialiser les deux champs date avec la date du jour
            executetraitement(sSuperChamp + ".InitialiserChampDate", trtprocédure, dDateDébut, dDateFin, sSuperChamp)
           type : 32
     -
       name : MenuSemaineCourante
       identifier : 0x4d8271ba07dfd4d5
       internal_properties : 
       code_elements :
        type_code : 26
        p_codes :
         -
           code : |1-
            dDateDébut 	est une Date
            dDateFin	est une Date
            nNumJour 	est un entier = 0
            sSuperChamp est une chaine = ""
            
            // Initialiser les deux dates à la date du jour
            dDateDébut = datesys()
            dDateFin = datesys()
            
            // Récupérer le nom du super champ
            sSuperChamp = ExtraitChaîne(ChampContextuel(), 1, ".")
            
            // Récupérer le numéro du jour de la semaine
            nNumJour = EntierVersJour(dateversentier(dDateDébut))
            
            // Modifier le jour pour qu'il corresponde au Lundi
            dDateDébut..jour -= (nNumJour-1)
            
            // Initialiser les deux champs date avec la date du jour
            executetraitement(sSuperChamp + ".InitialiserChampDate", trtprocédure, dDateDébut, dDateFin, sSuperChamp)
           type : 32
     -
       name : MenuSemainePrécédente
       identifier : 0x4d8271ba03e1d4d5
       internal_properties : 
       code_elements :
        type_code : 26
        p_codes :
         -
           code : |1-
            dDateDébut 	est une Date
            dDateFin	est une Date
            nNumJour 	est un entier = 0
            sSuperChamp est une chaine = ""
            
            // Initialiser les deux dates à la date du jour
            dDateDébut = datesys()
            dDateFin = datesys()
            
            // Récupérer le nom du super champ
            sSuperChamp = ExtraitChaîne(ChampContextuel(), 1, ".")
            
            // Positionner le jour sur la semaine précédente
            dDateDébut..jour -= 7
            
            // Récupérer le numéro du jour de la semaine
            nNumJour = EntierVersJour(dateversentier(dDateDébut))
            
            // Modifier le jour pour qu'il corresponde au Lundi
            dDateDébut..jour -= (nNumJour-1)
            
            // Modifier le jour pour qu'il corresponde au Dimanche
            dDateFin = dDateDébut
            dDateFin..jour += 6
            
            // Initialiser les deux champs date avec la date du jour
            executetraitement(sSuperChamp + ".InitialiserChampDate", trtprocédure, dDateDébut, dDateFin, sSuperChamp)
           type : 32
     -
       name : MenuMoisCourant
       identifier : 0x4d8271ba5fc9d4d5
       internal_properties : 
       code_elements :
        type_code : 26
        p_codes :
         -
           code : |1-
            dDateDébut 	est une Date
            dDateFin	est une Date
            sSuperChamp est une chaine = ""
            
            // Initialiser les deux dates à la date du jour
            dDateDébut = datesys()
            dDateFin = datesys()
            
            // Récupérer le nom du super champ
            sSuperChamp = ExtraitChaîne(ChampContextuel(), 1, ".")
            
            // Modifier le jour pour qu'il corresponde au premier jour du mois
            dDateDébut..jour = 1
            
            // Initialiser les deux champs date avec la date du jour
            executetraitement(sSuperChamp + ".InitialiserChampDate", trtprocédure, dDateDébut, dDateFin, sSuperChamp)
           type : 32
     -
       name : MenuMoisPrécédent
       identifier : 0x4d8271ba4afdd4d5
       internal_properties : 
       code_elements :
        type_code : 26
        p_codes :
         -
           code : |1-
            dDateDébut 	est une Date
            dDateFin	est une Date
            sSuperChamp est une chaine = ""
            
            // Initialiser les deux dates à la date du jour
            dDateDébut = datesys()
            dDateFin = datesys()
            
            // Récupérer le nom du super champ
            sSuperChamp = ExtraitChaîne(ChampContextuel(), 1, ".")
            
            // Modifier le jour et le mois pour qu'ils correspondent au jour courant et au mois précédent
            dDateDébut..jour = 1
            dDateDébut..mois--
            
            // Se placer à la fin du mois précédent
            dDateFin = dDateDébut
            dDateFin..mois++
            dDateFin..jour--
            
            // Initialiser les deux champs date avec la date du jour
            executetraitement(sSuperChamp + ".InitialiserChampDate", trtprocédure, dDateDébut, dDateFin, sSuperChamp)
           type : 32
