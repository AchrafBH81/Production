           type : 32
     -
       name : MenuDernierMois
       identifier : 0x4d8271ba5e8fd4d5
       internal_properties : 
       code_elements :
        type_code : 26
        p_codes :
         -
           code : |1-
            dDateDébut	est une Date
            dDateFin	est une Date
            sSuperChamp est une chaine = ""
            
            // Initialiser les deux dates à la date du jour
            dDateDébut = datesys()
            dDateFin = datesys()
            
            // Récupérer le nom du super champ
            sSuperChamp = ExtraitChaîne(ChampContextuel(), 1, ".")
            
            // Construire la date correspondante au jour courant et au mois suivant
            dDateDébut..jour = 1
            
            // Se placer deux mois avant le mois en cours
            dDateDébut..mois -= 2
            
            // Construire la date correspondante au jour précédent et au mois précédent
            dDateFin = dDateDébut
            dDateFin..mois += 2	
            dDateFin..jour --
            
            // Initialiser les deux champs date avec la date du jour
            executetraitement(sSuperChamp + ".InitialiserChampDate", trtprocédure, dDateDébut, dDateFin, sSuperChamp)
           type : 32
