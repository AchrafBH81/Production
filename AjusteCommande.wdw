           type : 27
    type : 40
    code_elements :
     type_code : 34
     p_codes :
      -
        code : |1-
         // Ce super champ permet de définir très facilement une fourchette de dates (utile pour des statistiques,...).
         // L'utilisateur pourra soit choisir la période par un simple bouton (aujourd'hui, hier, mois en cours...) soit indiquer facilement
         // la date de début et de fin.
         // Pour calculer cette période, une procédure locale au super champ est appelée dans chaque option du menu contextuel. 
         // La procédure " InitialiserChampDate() " prend 3 paramètres : la date de début, la date de fin et le nom du super champ. Les deux 
         // dates sont ensuite affectées aux champs de saisie. 
         // Les propriétés " ..mois " et " ..jour " sont utilisé pour se placer sur la période correspondante.
         //
         // Ce super champ est composé de 3 champs :
         //			-> un champ de saisie pour la date de début de la période
         //			-> un champ de saisie pour la date de fin de la période
         //			-> un bouton auquel est associé un menu contextuel avec différentes périodes.
      -
        code : |1-
         // Initialiser les deux champs avec la date du jour
         datedebut = datesys()
         datefin = datesys()
        type : 14
      -
        code : |1-
         
        type : 15
      -
        code : |1-
         
        type : 16
      -
        code : |1-
         
        type : 17
     procedures :
      -
        name : InitialiserChampDate
        procedure_id : 5585151531687662836
        type_code : 14
        code : |1-
         Procédure InitialiserChampDate(dDateDébut, dDateFin, sSuperChamp)
         // Procédure qui permet d'initialiser les deux champs dates du super champ
         // ENTREE : sDateDébut : Date de début
         // ENTREE : sDateFin : Date de fin
         // ENTREE : sSuperChamp : Nom du super-champ	
         
         // Initialiser les deux champs avec les dates sDateDébut et sDateFin
         {sSuperChamp + ".DateDébut"}..valeur = dDateDébut
         {sSuperChamp + ".DateFin"}..valeur = dDateFin
        type : 458752
     procedure_templates : []
     property_templates : []
 menu :
  name : _Menu
  identifier : 0x4d82702209dc9a0b
  internal_properties : 
