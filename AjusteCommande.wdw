     -
       name : SpinDébut
       identifier : 0x4d8271ba0fc5d4e5
       internal_properties : 
       properties :
        x : 153
        y : 3
        width : 14
        height : 18
       type : 11
       code_elements :
        type_code : 18
        p_codes :
         -
           code : |1-
            
           type : 14
         -
           code : |1-
            dDate	est une Date
            
            quand exception
            	erreur(exceptioninfo())
            	retour
            FIN
            
            // Vérifier que la date ne soit pas inférieure à l'année 1800
            dDate = DateDébut
            
            si dDate..annee < 1800 ALORS
            	erreur("La date ne peut pas être inférieure au 1er Janvier 1800.")
            	DateDébut = datesys()
            	retour
            FIN
            
            DateDébut = entierversdate(dateversentier(DateDébut)+1)
            ExécuteTraitement(DateDébut,trtMODIFICATION)
           type : 26
         -
           code : |1-
            dDate	est une Date
            
            quand exception
            	erreur(exceptioninfo())
            	retour
            FIN
            
            // Vérifier que la date ne soit pas inférieure à l'année 1800
            dDate = DateDébut
            
            si dDate..annee < 1800 ALORS
            	erreur("La date ne peut pas être inférieure au 1er Janvier 1800.")
            	DateDébut = datesys()
            	retour
            FIN
            
            DateDébut = EntierVersDate(DateVersEntier(DateDébut)-1)
            ExécuteTraitement(DateDébut,trtMODIFICATION)
           type : 27
