  procedures :
   -
     name : InchFractionToInch
     procedure_id : 1922245221049282424
     type_code : 15
     code : |1-
      PROCEDURE InchFractionToInch(inchFraction est une chaine)
      calc est un calculator
      renvoyer arrondi(calc.Compute(FractionToArithmetic(inchFraction)),3)
     type : 458752
   -
     name : FractionToArithmetic
     procedure_id : 1922245397142982670
     type_code : 15
     code : |1+
      PROCEDURE FractionToArithmetic(equation est une chaine)
      //Remplace les fractions de format 5 1/2 par des équations calculables de format (5+1/2)
      renvoyer Remplace(sansespace(equation)," ","+")
      
     type : 458752
   -
     name : TextToMillimeter
     procedure_id : 1922247699245529933
     type_code : 15
     code : |1-
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] TextToMillimeter (<ValueToConvert>)
      //
      // Paramètres :
      //	ValueToConvert :<indiquez ici le rôle de ValueToConvert>
      // Valeur de retour :
      // 	chaîne ANSI : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE TextToMillimeter(ValueToConvert)
      Valeurderetour est une chaîne = NumériqueVersChaîne(Val(ValueToConvert)/1000)
      si Valeurderetour[[1]] = 0 alors Valeurderetour[[1]] = ""
      renvoyer Valeurderetour
     type : 458752
   -
     name : InchFractionToMillimeter
     procedure_id : 1924218887308077467
     type_code : 15
     code : |1-
      PROCEDURE InchFractionToMillimeter(inchFraction est une chaine)
      o_calculator est un calculator
      
      RENVOYER arrondi(o_calculator.Compute(FractionToArithmetic(inchFraction)) * 25.4,3)
     type : 458752
   -
     name : InchToInchFraction
     procedure_id : 1928325902597511508
     type_code : 15
     code : |1-
      PROCEDURE InchToInchFraction(inch est un réel)
      leftPart est une chaine = PartieEntière(inch)
      rightPart est un reel = PartieDécimale(inch)
      SI leftPart = 0 ALORS leftPart = ""
      si rightPart = 0 alors renvoyer leftPart
      SI DecimalToFraction(rightPart,64) = "1" ALORS
      	RENVOYER SansEspace(ChaîneConstruit("%1 %2",NumériqueVersChaîne(Val(leftPart)+1)))
      FIN
      
      RENVOYER SansEspace(ChaîneConstruit("%1 %2",leftPart,DecimalToFraction(rightPart,64)))
     type : 458752
   -
     name : DecimalToFraction
     procedure_id : 1928325962727133391
     type_code : 15
     code : |1-
      PROCEDURE restreint  DecimalToFraction(decimalToConvert est un reel , base est un entier=64)
      resultat est un entier = arrondi(decimalToConvert * base)
      SI resultat = 0 ALORS RENVOYER ""
      _base est un entier = base
      TANTQUE modulo(resultat,2) = 0
      	resultat = resultat/2
      	_base = _base /2 
      FIN
      SI resultat = _base ALORS RENVOYER "1"
      RENVOYER ChaîneConstruit("%1/%2",resultat,_base)
     type : 458752
   -
     name : MillimiterToInchFraction
     procedure_id : 1976189215471602033
     type_code : 15
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] MillimiterToInchFraction (<valueToConvert> est chaîne)
      //
      // Paramètres :
      //	valueToConvert (chaîne ANSI) :<indiquez ici le rôle de valueToConvert>
      // Valeur de retour :
      // 	Type indéterminé : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE MillimiterToInchFraction(valueToConvert est une chaine)
      
      renvoyer InchToInchFraction(arrondi(val(valueToConvert)/25.4,3))
      
      
      
     type : 458752
   -
     name : MillimiterToInchDecimal
     procedure_id : 1680409485246469068
     type_code : 15
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] MillimiterToInchDecimal (<valueToConvert> est chaîne)
      //
      // Paramètres :
      //	valueToConvert (chaîne ANSI) : <indiquez ici le rôle de valueToConvert>
      // Valeur de retour :
      // 	variant : <indiquez ici le rôle de la valeur de retour>
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE MillimiterToInchDecimal(valueToConvert est une chaine)
      
      renvoyer FractionToArithmetic(arrondi(val(valueToConvert)/25.4,3))
      
      
      
      
     type : 458752
