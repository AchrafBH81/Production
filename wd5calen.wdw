 languages :
  - fr-FR
 message_bar :
  internal_properties : CQAAAAkAAAAUXDLRIaY05Y7vA2ktUzdZxlJuZwIIPeVrcLIZ81P55i3GvRxloSmTOqSsnDVmRBmDzsKjKx4WNbZDDn9zjoVVolCjsw9iPWV/7hWJrdfiCSjdt6VySGh9RCdIUw==
 actionbar : {}
 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1+
      Fonction CALENDRI(dateencours=datesys())
      
      // Pour compatibilité 5.5
      MoiMême..Visible=Vrai
      
      global 
      //Code WinDev 5.5 remplacé par la migration :
      //	resultat est un entier long  //renvoyé par la fenêtre:entier-date choisie
      	resultat est un entier    //renvoyé par la fenêtre:entier-date choisie
      //Code WinDev 5.5 remplacé par la migration :
      //	Dateinitiale est un entier long
      	Dateinitiale est un entier  
      	Mois est un entier
      	NomFen est une chaine
      	IdEncours est un entier
      	DecorsEncours est une chaine
      	NumEvent est un entier
      	LastCases est un entier
      
      	eFenXPos est un entier
      	eFenYPos est un entier
      	
      	NomPolice est une chaine // Nom de la police (Par Exemple "Arial")
      	Hauteur est un entier // Hauteur de la police
      //Code WinDev 5.5 remplacé par la migration :
      //	Couleur est un entier long // Couleur de la police
      	Couleur est un entier   // Couleur de la police
      	Italique est un booleen // Vrai pour une police italique
      	Barré est un booleen // Vrai pour Une police barrée
      	Souligné est un booleen // Vrai pour une police soulignée
      	Gras est un entier // Epaisseur: Entre 0 et 900: 400=Normal, 900=très gras
      	ModifPolice est un booleen=faux
      	
      	NomINI est une chaine="WD5Calen.ini"
      	imgjour est une chaine
      	
      local
      // Saisie d'une date sur le calendrier
      Ch	est une chaine
      //DateInitiale=dateversentier(Datesys())
      si sansespace(dateencours)="" alors dateencours = datesys()
      DateInitiale=dateversentier(Dateencours)
      // Initialisation des champs suivant la date du jour
      // Vous pouvez initialiser à partir d'une autre date, passée en
      // paramètre
      Ch=entierversdate(DateInitiale)
      Annee=Milieu(Ch,1,4)
      Mois=val(Milieu(Ch,5,2))
      Jour=Milieu(Ch,7,2)
      NousSommes=entierversjourenlettre(dateversentier(datesys()))+" "+...
      			Jour+" "+...
      			entierversmoisenlettre(dateversentier(datesys()))+" "+...
      			Annee//+" / Saint "+RechercheSaint(DateInitiale)
      
      LIB2=entierversmoisenlettre(dateversentier(datesys()))
      
      listeajoute("CBDECOR",gimage("CALEND0.BMP")+gcoord(13,1)+gfond(itransparent)+"Fluo"+glien("Fluo"+tab+"1021"))
      listeajoute("CBDECOR",gimage("CALEND1.BMP")+gcoord(13,1)+gfond(itransparent)+"Marbré"+glien("Marbré"+tab+"1004"))
      listeajoute("CBDECOR",gimage("CALEND2.BMP")+gcoord(13,1)+gfond(itransparent)+"Soleil"+glien("Soleil"+tab+"1005"))
      listeajoute("CBDECOR",gimage("CALEND3.BMP")+gcoord(13,1)+gfond(itransparent)+"Italien"+glien("Italien"+tab+"1006"))
      listeajoute("CBDECOR",gimage("CALEND4.BMP")+gcoord(13,1)+gfond(itransparent)+"Printemps"+glien("Printemps"+tab+"1007"))
      listeajoute("CBDECOR",gimage("CALEND5.BMP")+gcoord(13,1)+gfond(itransparent)+"Métallisé"+glien("Métallisé"+tab+"1010"))
      listeajoute("CBDECOR",gimage("CALEND6.BMP")+gcoord(13,1)+gfond(itransparent)+"Spirale"+glien("Spirale"+tab+"1011"))
      listeajoute("CBDECOR",gimage("CALEND7.BMP")+gcoord(13,1)+gfond(itransparent)+"Sable"+glien("Sable"+tab+"1016"))
      listeajoute("CBDECOR",gimage("CALEND8.BMP")+gcoord(13,1)+gfond(itransparent)+"Goutelette"+glien("Goutelette"+tab+"1012"))
      listeajoute("CBDECOR",gimage("CALEND9.BMP")+gcoord(13,1)+gfond(itransparent)+"Patchwork"+glien("Patchwork"+tab+"1013"))
      
      IdEncours=inilit("DECOR","IDMENU","1016",NomINI)
      DecorsEncours=inilit("DECOR","IMAGE","CALEND7.BMP",NomINI)
      
      
      si inilit("DECOR","POLICE","N",NomINI)="N" alors
      	ModifPolice=faux
      sinon
      	ModifPolice=vrai
      	NomPolice=inilit("POLICE","NOM","ARIAL",NomINI)
      	Hauteur=inilit("POLICE","HAUTEUR","10",NomINI)
      	Couleur=inilit("POLICE","COULEUR","0",NomINI)
      	Italique=faux
      	si inilit("POLICE","ITALIQUE","N",NomINI)="O" alors
      		Italique=vrai
      	FIN
      	Barré=faux
      	si inilit("POLICE","BARRE","N",NomINI)="O" alors
      		Barré=vrai
      	FIN
      	Souligné=faux
      	si inilit("POLICE","SOULIGNE","N",NomINI)="O" alors
      		Souligné=vrai
      	FIN
      	Gras=faux
      	si inilit("POLICE","GRAS","N",NomINI)="O" alors
      		Gras=vrai
      	FIN
      FIN
      
      si frep(DecorsEncours,frfichier)<>"" alors
      	IMGJOUR=DecorsEncours
      	menumarque(IdEncours)
      	CBDECOR=val(DecorsEncours[[position(majuscule(DecorsEncours),"CALEND")+6]])+1
      sinon
      	DecorsEncours="CALEND4.bmp"
      	IdEncours=1016
      	IMGJOUR=DecorsEncours
      	menumarque(IdEncours)
      	CBDECOR=8
      fin
      
      Calendrier()		// affiche le calendrier
      
      NomFen="WD5Calen"
      CentreFenetre(NomFen)
      
      // Pour pouvoir déplacer la fenêtre
      evenement("Deplace",NomFen,0x0084)
      //NumEvent=evenement("FETEDUJOUR","CLICAGE",512)
      
   -
     type : 180
     enabled : false
   -
     type : 230
     enabled : false
   -
     code : |1+
      
      //Code WinDev 5.5 remplacé par la migration :
      //eFenXPos=fenextposh()
      eFenXPos=FenExtPosX()
      //Code WinDev 5.5 remplacé par la migration :
      //eFenYPos=fenextposV()
      eFenYPos=FenExtPosY()
      
      //Code WinDev 5.5 remplacé par la migration :
      //iniecrit("COORD","POSX",verschaine(eFenXPos),NomINI)
      iniecrit("COORD","POSX",NumeriqueVersChaine(eFenXPos),NomINI)
      //Code WinDev 5.5 remplacé par la migration :
      //iniecrit("COORD","POSY",verschaine(eFenYPos),NomINI)
      iniecrit("COORD","POSY",NumeriqueVersChaine(eFenYPos),NomINI)
      //Code WinDev 5.5 remplacé par la migration :
      //iniecrit("DECOR","IDMENU",verschaine(IDencours),NomINI)
      iniecrit("DECOR","IDMENU",NumeriqueVersChaine(IDencours),NomINI)
      si pas imgjour = "" alors
      iniecrit("DECOR","IMAGE",IMGJOUR,NomINI)
      fin
      si ModifPolice alors
      	iniecrit("DECOR","POLICE","0",NomINI)
      	iniecrit("POLICE","NOM",NomPolice,NomINI)
      //Code WinDev 5.5 remplacé par la migration :
      //	iniecrit("POLICE","HAUTEUR",verschaine(Hauteur),NomINI)
      	iniecrit("POLICE","HAUTEUR",NumeriqueVersChaine(Hauteur),NomINI)
      //Code WinDev 5.5 remplacé par la migration :
      //	iniecrit("POLICE","COULEUR",verschaine(Couleur),NomINI)
      	iniecrit("POLICE","COULEUR",NumeriqueVersChaine(Couleur),NomINI)
      	si Italique alors
      		iniecrit("POLICE","ITALIQUE","O",NomINI)
      	sinon
      		iniecrit("POLICE","ITALIQUE","N",NomINI)
      	fin
      	si Barré alors
      		iniecrit("POLICE","BARRE","O",NomINI)
      	sinon
      		iniecrit("POLICE","BARRE","N",NomINI)
      	fin
      	si Souligné alors
      		iniecrit("POLICE","SOULIGNE","O",NomINI)
      	sinon
      		iniecrit("POLICE","SOULIGNE","N",NomINI)
      	fin
      	si Gras alors
      		iniecrit("POLICE","GRAS","O",NomINI)
      	sinon
      		iniecrit("POLICE","GRAS","N",NomINI)
      	fin
      sinon
      	iniecrit("DECOR","POLICE","N",NomINI)
      fin
      
      si resultat = 0 alors resultat = dateversentier(dateencours)
      renvoyer entierversdate(resultat)
      
