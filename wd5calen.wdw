   -
     name : CALENDRIER
     procedure_id : 4511921587552162716
     type_code : 14
     code : |1+
      ind	est un entier
      X,Y	sont des entiers
      //Code WinDev 5.5 remplacé par la migration :
      //Date1	est un entier long
      Date1	est un entier  
      Jour1	est un entier
      //Code WinDev 5.5 remplacé par la migration :
      //pAttribut est un entier long
      pAttribut est un entier  
      
      Sablier
      ImageJour=ImgJour		// réinit du calendrier actuel
      IMGJOUR=DecorsEncours
      dDebutDessin("ImageJour")
      
      // Calcule le premier jour du mois
      //Code WinDev 5.5 remplacé par la migration :
      //Date1=DateVersEntier(Annee+Verschaine(Mois,"02d")+"01")
      Date1=DateVersEntier(Annee+NumeriqueVersChaine(Mois,"02d")+"01")
      Jour1=EntierVersJour(Date1)		// Jour de la semaine
      // Affiche tous les jours du mois
      pour ind=1 à 31
      	// Vérifie si le jour est valide
      	si Val(Milieu(EntierVersDate(Date1+ind-1),5,2))<>Mois alors
      		Sortir		// On a dépassé le dernier jour du mois
      	fin
          // Calcule la position 
          X=modulo(ind+Jour1-2,7)*40+4; Y=PartieEntiere((ind+Jour1-2)/7)*38+7
      	// Pointe ou Encadre le jour initial
      	si Date1+ind-1=DateInitiale alors
      		//dcercle(X+20,Y+2,X+20+10,Y+2+10,iblanc)
      		drectangle(X,Y-3,X+32,Y+28,itransparent,iblanc)
      		drectangle(X+1,Y-2,X+31,Y+27,itransparent,iblanc)
      	fin
      	//	dPolice("Arial",24,iGras,i*10)
      	
      	Si ModifPolice alors
      		pAttribut=inormal		
      		SI Italique Alors pAttribut=iitalique
      		SI Gras<=300 ALORS
      		SINON
      			pAttribut=pAttribut+igras
      		FIN
      		SI Souligne ALORS pAttribut=pAttribut+isouligne
      		SI Barré ALORS pAttribut=pAttribut+ibarre
      
      		dPolice(NomPolice,Hauteur,pAttribut)
      		si Hauteur>=14 alors
      			dTexte(X+10-10,Y+7-5,ind,Couleur)
      		sinon
      			dTexte(X+10,Y+7,ind,Couleur)
      		fin
      	sinon
      		dTexte(X+10,Y+7,ind)
      	FIN
      fin
      
      Multitache
      // Réaffiche le bouton Quitter effacé par le dessin
      //Code WinDev 5.5 remplacé par la migration :
      //Quitter..Etat=Invisible; Quitter..Etat=Actif
      Quitter..Visible=Faux; Quitter..Etat=Actif; Quitter..Visible=Vrai
      
     type : 458752
   -
     name : CentreFenetre
     procedure_id : 4511921587778524140
     type_code : 14
     code : |1+
      Procédure CentreFenetre(lNomFen)
      // Recentre la fenêtre dans l'espace de travail de Windows
      // Utile pour visualiser une fenêtre ouverte hors écran
      eFenLargeur, eFenHauteur sont des entiers=0
      
      // La fenêtre doit être ouverte
      si fenetat(lNomFen) = inexistant alors renvoyer faux
      
      // Largeur et Hauteur de la fenêtre
      eFenLargeur = fenextlarg(lNomFen)
      eFenHauteur = Fenexthaut(lNomFen)
      
      
      si frep(sysrep()+"\WD5Calen.ini",frfichier)<>"" alors
      	// Centrage en X
      	eFenXPos = inilit("COORD","POSX","",NomINI)
      	si eFenXPos=0 alors eFenXPos = (sysxres() - eFenLargeur) / 2
      	// Centrage en Y
      	eFenYPos = inilit("COORD","POSY","",NomINI)
      	si eFenYPos=0 alors eFenYPos = (Sysyres() - eFenHauteur) / 2
      sinon
      	// Centrage en X
      	eFenXPos = (sysxres() - eFenLargeur) / 2
      	// Centrage en Y
      	eFenYPos = (Sysyres() - eFenHauteur) / 2
      fin
      
      // déplacement de la fenêtre
      //Code WinDev 5.5 remplacé par la migration :
      //fentaille(lNomFen,eFenYPos,eFenXPos,defaut,defaut)
      fentaille(lNomFen,eFenXPos,eFenYPos,defaut,defaut)
      
     type : 458752
   -
     name : Deplace
