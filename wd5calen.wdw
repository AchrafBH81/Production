    name : SPMOIS
    identifier : 0x3e9d90c622549342
    internal_properties : 
    properties :
     x : 97
     y : 7
     width : 46
     height : 14
    type : 11
    code_elements :
     type_code : 18
     p_codes :
      -
        code : |1+
         Mois=Mois+1
         si Mois>12 alors
         	Mois=1
         	Annee=numeriqueverschaine(val(Annee)+1)
         	SPAnnee=SpAnnee+1
         FIN
         //Code WinDev 5.5 remplacé par la migration :
         //LIB2=entierversmoisenlettre(dateversentier(ANNEE+verschaine(Mois,"%02d")+"01"))
         LIB2=entierversmoisenlettre(dateversentier(ANNEE+NumeriqueVersChaine(Mois,"%02d")+"01"))
         Calendrier		// Redessine le calendrier
         
        type : 26
      -
        code : |1+
         Mois=Mois-1
         si Mois<1 alors
         	Mois=12
         	Annee=numeriqueverschaine(val(Annee)-1)
         	SPAnnee=SpAnnee-1
         FIN
         //Code WinDev 5.5 remplacé par la migration :
         //LIB2=entierversmoisenlettre(dateversentier(ANNEE+verschaine(Mois,"%02d")+"01"))
         LIB2=entierversmoisenlettre(dateversentier(ANNEE+NumeriqueVersChaine(Mois,"%02d")+"01"))
         Calendrier		// Redessine le calendrier
         
        type : 27
