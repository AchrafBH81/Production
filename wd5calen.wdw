      Procédure Deplace()
      
      _eve.retour=2
      
     type : 458752
   -
     name : FETEDUJOUR
     procedure_id : 4511921588044862484
     type_code : 14
     code : |1+
      Procédure FETEDUJOUR()
      
      // Sélection d'une date
      //Code WinDev 5.5 remplacé par la migration :
      //LeJour  est un entier long
      LeJour  est un entier  
      NomSaint est une chaine
      Cases	est un entier
      Jour1	est un entier
      //Code WinDev 5.5 remplacé par la migration :
      //Date1	est un entier long
      Date1	est un entier  
      // Récupère la position de survol
      
      // Calcule le n° de la case survolée
      
      Cases=PartieEntiere(LoWord(_EVE.lParam)*7/Clicage..Largeur)+...
           PartieEntiere(HiWord(_EVE.lParam)*6/Clicage..Hauteur)*7
      
      si Cases=LastCases alors retour
      
      LastCases=Cases
      
      // Calcule la date du premier jour du mois
      //Code WinDev 5.5 remplacé par la migration :
      //Date1=DateVersEntier(Annee+Verschaine(Mois,"02d")+"01")
      Date1=DateVersEntier(Annee+NumeriqueVersChaine(Mois,"02d")+"01")
      // Calcule de la case de départ du 1er du mois
      Jour1=EntierVersJour(Date1)-1
      // Vérifie qu'il n'y a pas eu sélection avant le premier jour
      si Cases<Jour1 alors
      	//Bip					// Emet un bip, c'est tout
      	JSaint=""
      	retour
      fin
      // Vérifie qu'il n'y a pas eu sélection aprés le dernier jour
      si Val(Milieu(EntierVersDate(Date1-Jour1+Cases),5,2))<>Mois alors
      	// Bip					// Emet un bip, c'est tout
      	JSaint=""
      	retour
      fin
      
      LeJour=Date1-Jour1+Cases
      finevenement(NumEvent)
      NomSaint=RechercheSaint(LeJour)
      NumEvent=evenement("FETEDUJOUR","CLICAGE",512)
      JSaint=NomSaint
      
     type : 458752
   -
     name : OUVRECHOIXPOLICE
     procedure_id : 4511921586857940038
     type_code : 14
     code : |1+
      //-- Procédure créée par l'assistant --
      Fonction OUVRECHOIXPOLICE(lNomPolice,lHauteur,lCouleur,lGras,lItalique,lSouligne,lBarré)
      
      // Informations sur l'imprimante
      ImpDriver est une chaine fixe sur 255
      ImpPort Est une chaine fixe sur 255
      imp est une chaine fixe sur 255
      
      // Structures utilisées par la Fenêtre de dialogue Windows
      
      // Fonte utilisée pour l'initialisation de la fenêtre et pour le retour
      lf est compose de
      //Code WinDev 5.5 remplacé par la migration :
      //	height est un entier
      	height est un entier sur 2 octets
      //Code WinDev 5.5 remplacé par la migration :
      //	Width est un entier
      	Width est un entier sur 2 octets
      //Code WinDev 5.5 remplacé par la migration :
      //	escape est un entier
      	escape est un entier sur 2 octets
      //Code WinDev 5.5 remplacé par la migration :
      //	orient est un entier
      	orient est un entier sur 2 octets
      //Code WinDev 5.5 remplacé par la migration :
      //	Weight est un entier
      	Weight est un entier sur 2 octets
      	italic est un Caractere
      	Under est un Caractere
      	strike est un Caractere
      	charset est un Caractere
      	outprec est un Caractere
      	clipprec est un Caractere
      	qual est un Caractere
      	PAF est un Caractere
      	fName est une chaine fixe sur 32
      fin
      
      lf32 est compose de
      //Code WinDev 5.5 remplacé par la migration :
      //	height32 est un entier long
      	height32 est un entier  
      //Code WinDev 5.5 remplacé par la migration :
      //	Width32 est un entier long
      	Width32 est un entier  
      //Code WinDev 5.5 remplacé par la migration :
      //	escape32 est un entier long
      	escape32 est un entier  
      //Code WinDev 5.5 remplacé par la migration :
      //	orient32 est un entier long
      	orient32 est un entier  
      //Code WinDev 5.5 remplacé par la migration :
      //	Weight32 est un entier long
      	Weight32 est un entier  
      	italic32 est un Caractere
      	Under32 est un Caractere
      	strike32 est un Caractere
      	charset32 est un Caractere
      	outprec32 est un Caractere
      	clipprec32 est un Caractere
      	qual32 est un Caractere
      	PAF32 est un Caractere
      	fName32 est une chaine fixe sur 32
      fin
      
      // Structure utilisée par la fenêtre de dialogue
      cf est composé de 
      //Code WinDev 5.5 remplacé par la migration :
      //	StructSize est un entier long
      	StructSize est un entier  
      //Code WinDev 5.5 remplacé par la migration :
      //	hWndOwner est un entier
      	hWndOwner est un entier systeme
      	
      	
      //Code WinDev 5.5 remplacé par la migration :
      //	hDC est un entier 
      	hDC est un entier sur 2 octets 
      //Code WinDev 5.5 remplacé par la migration :
      //	LogFont est un entier long
      	LogFont est un entier  systeme
      //Code WinDev 5.5 remplacé par la migration :
      //	PointSize est un entier
      	PointSize est un entier sur 2 octets
      //Code WinDev 5.5 remplacé par la migration :
      //	Flags est un entier long
      	Flags est un entier  
      //Code WinDev 5.5 remplacé par la migration :
      //	rvbColors est un entier long
      	rvbColors est un entier  
      //Code WinDev 5.5 remplacé par la migration :
      //	CustData est un entier long
      	CustData est un entier  
      //Code WinDev 5.5 remplacé par la migration :
      //	Hook est un entier long
      	Hook est un entier  
      //Code WinDev 5.5 remplacé par la migration :
      //	Template est un entier long
      	Template est un entier  
      //Code WinDev 5.5 remplacé par la migration :
      //	hInstance est un entier
      	hInstance est un entier sur 2 octets
      //Code WinDev 5.5 remplacé par la migration :
      //	Style est un entier long
      	Style est un entier  
      //Code WinDev 5.5 remplacé par la migration :
      //	FontType est un entier sans signe
      	FontType est un entier sur 2 octets sans signe
      //Code WinDev 5.5 remplacé par la migration :
      //	SizeMin est un entier
      	SizeMin est un entier sur 2 octets
      //Code WinDev 5.5 remplacé par la migration :
      //	SizeMax est un entier
      	SizeMax est un entier sur 2 octets
      fin
      
      cf32 est composé de 
      //Code WinDev 5.5 remplacé par la migration :
      //	StructSize32 est un entier long
      	StructSize32 est un entier  
      //Code WinDev 5.5 remplacé par la migration :
      //	hWndOwner32 est un entier long
      	hWndOwner32 est un entier systeme 
      //Code WinDev 5.5 remplacé par la migration :
      //	hDC32 est un entier long
      	hDC32 est un entier  
      //Code WinDev 5.5 remplacé par la migration :
      //	LogFont32 est un entier long
      	LogFont32 est un entier  systeme
      //Code WinDev 5.5 remplacé par la migration :
      //	PointSize32 est un entier long
      	PointSize32 est un entier  
      //Code WinDev 5.5 remplacé par la migration :
      //	Flags32 est un entier long
      	Flags32 est un entier  
      //Code WinDev 5.5 remplacé par la migration :
      //	rvbColors32 est un entier long
      	rvbColors32 est un entier  
      //Code WinDev 5.5 remplacé par la migration :
      //	CustData32 est un entier long
      	CustData32 est un entier  
      //Code WinDev 5.5 remplacé par la migration :
      //	Hook32 est un entier long
      	Hook32 est un entier  
      //Code WinDev 5.5 remplacé par la migration :
      //	Template32 est un entier long
      	Template32 est un entier  
      //Code WinDev 5.5 remplacé par la migration :
      //	hInstance32 est un entier long
      	hInstance32 est un entier  
      //Code WinDev 5.5 remplacé par la migration :
      //	Style32 est un entier long
      	Style32 est un entier  
      //Code WinDev 5.5 remplacé par la migration :
      //	FontType32 est un entier sans signe
      	FontType32 est un entier sur 2 octets sans signe
      //Code WinDev 5.5 remplacé par la migration :
      //	Bidon32	est un entier
      	Bidon32	est un entier sur 2 octets
      //Code WinDev 5.5 remplacé par la migration :
      //	SizeMin32 est un entier long
      	SizeMin32 est un entier  
      //Code WinDev 5.5 remplacé par la migration :
      //	SizeMax32 est un entier long
      	SizeMax32 est un entier  
      fin
      
      si VersionWindows()<>"32" alors
      	// Initialisation des paramètres utilisateur
      	// Définition de la police sélectionnée par défaut:
      	lf.height=lHauteur*(-4)/3 // lHauteur de la police = lHauteur classique * -1.333
      	cf.rvbColors=lCouleur // lCouleur de la police
      	lf.Weight=lGras // épaisseur de la lettre 0<lf.Weight <900
      	SI lItalique ALORS		// 0 Pour droit, 1 pour lItalique
      		lf.italic=CAract(1) 
      	SINON
      		lf.italic=CAract(0) 
      	FIN
      	SI lSouligne ALORS 		// 0 pour normal, 1 pour lSouligne
      		lf.Under=CAract(1) 
      	SINON
      		lf.Under=CAract(0)
      	FIN
      	SI lBarré ALORS 			// 0 pour normal, 1 pour lBarré
      		lf.strike=CAract(1)
      	SINON
      		lf.strike=CAract(0) 
      	FIN
      	lf.fName=lNomPolice+caract(0) // Nom de la police
      
      	// Paramétrage de la boite de dialogue
      	cf.Flags=323 // voir le SDK 3.1 pour connaître les différentes utilisations des flags
      
      	// Initialisation automatique des autres paramètres
      	lf.escape=0 // angle du texte 
      	lf.width=6 // 
      	lf.charset=CAract(128) //
      	lf.clipprec=CAract(2) //
      	lf.qual=CAract(1) // Qualité graphique de la police retournée
      	lf.PAF=CAract(34) // 
      	lf.outprec=CAract(1) // Précision de la correspondance entre la police choisie et la police retournée
      	lf.orient=0
      	cf.StructSize=taille(""+cf)
      	cf.hWndOwner=Handle("") 
      	// Récupère le dc de l'imprimante pour avoir les polices
      //Code WinDev 5.5 remplacé par la migration :
      //	appelDLL("KERNEL","GetProfileString","Windows","Device",NUll,&Imp,255)
      // Votre programme utilise ici une commande 16 bits. 
      // Cette version ne permet que des exécutables 32 bits.
      // 	appelDLL("KERNEL","GetProfileString","Windows","Device",NUll,&Imp,255)
      // Code ajouté par la migration
      Erreur("Votre programme utilise ici une commande 16 bits. Cette version ne permet que des exécutables 32 bits.")
      
      	ImpDriver=extraitchaine(imp,2,",")+caract(0)
      	ImpPort=extraitchaine(imp,3,",")+caract(0)
      	imp=SansEspace(imp)+caract(0)
      //Code WinDev 5.5 remplacé par la migration :
      //	cf.hDC=appelDLL("GDI","CreateDC",&ImpDriver,&Imp,&ImpPort,null)
      // Votre programme utilise ici une commande 16 bits. 
      // Cette version ne permet que des exécutables 32 bits.
      // 	cf.hDC=appelDLL("GDI","CreateDC",&ImpDriver,&Imp,&ImpPort,null)
      // Code ajouté par la migration
      Erreur("Votre programme utilise ici une commande 16 bits. Cette version ne permet que des exécutables 32 bits.")
      
      	cf.LogFont=&lf
      	cf.Pointsize=0
      	cf.CustData=null
      	cf.Hook=null
      	cf.Template=null
      	cf.hInstance=0
      	cf.Style=null
      	cf.FontType=0
      	cf.SizeMin=0
      	cf.SizeMax=0
      
      //Code WinDev 5.5 remplacé par la migration :
      //	if (AppelDll("CommDLG","ChooseFont",&cf))<>0 alors
      // Votre programme utilise ici une commande 16 bits. 
      // Cette version ne permet que des exécutables 32 bits.
      // 	if (AppelDll("CommDLG","ChooseFont",&cf))<>0 alors
      // Code ajouté par la migration
      Erreur("Votre programme utilise ici une commande 16 bits. Cette version ne permet que des exécutables 32 bits.")
      
      		// La structure lf Contient ici tous les paramètres de la police choisie dans la boite de dialogue
      		si asc(lf.Italic)<>0 alors lItalique=Vrai sinon lItalique=Faux
      		si asc(lf.Under)<>0 alors lSouligne=Vrai sinon lSouligne=Faux
      		si asc(lf.Strike)<>0 alors lBarré=Vrai sinon lBarré=Faux
      		lNomPolice=lf.FName
      		lHauteur=(lf.height*(-3)/4)
      		lCouleur=cf.rvbColors
      		lGras=lf.Weight
      		RENVOYER vrai
      	sinon
      		RENVOYER Faux
      	fin
      //sinon
      	// Initialisation des paramètres utilisateur
      	// Définition de la police sélectionnée par défaut:
      	lf32.height32=lHauteur*(-4)/3 // lHauteur de la police = lHauteur classique * -1.333
      	cf32.rvbColors32=lCouleur // lCouleur de la police
      	lf32.Weight32=lGras // épaisseur de la lettre 0<lf.Weight <900
      	SI lItalique ALORS		// 0 Pour droit, 1 pour lItalique
      		lf32.italic32=CAract(1) 
      	SINON
      		lf32.italic32=CAract(0) 
      	FIN
      	SI lSouligne ALORS 		// 0 pour normal, 1 pour lSouligne
      		lf32.Under32=CAract(1) 
      	SINON
      		lf32.Under32=CAract(0)
      	FIN
      	SI lBarré ALORS 			// 0 pour normal, 1 pour lBarré
      		lf32.strike32=CAract(1)
      	SINON
      		lf32.strike32=CAract(0) 
      	FIN
      	lf32.fName32=lNomPolice+caract(0) // Nom de la police
      
      	// Paramétrage de la boite de dialogue
      	cf32.Flags32=323 // voir le SDK 3.1 pour connaître les différentes utilisations des flags
      
      	// Initialisation automatique des autres paramètres
      	lf32.escape32=0 // angle du texte 
      	lf32.width32=6 // 
      	lf32.charset32=CAract(128) //
      	lf32.clipprec32=CAract(2) //
      	lf32.qual32=CAract(1) // Qualité graphique de la police retournée
      	lf32.PAF32=CAract(34) // 
      	lf32.outprec32=CAract(1) // Précision de la correspondance entre la police choisie et la police retournée
      	lf32.orient32=0
      	cf32.StructSize32=taille(""+cf32)
      	cf32.hWndOwner32=Handle("") 
      	// Récupère le dc de l'imprimante pour avoir les polices
      	appelDLL32("kernel32","GetProfileStringA","Windows","Device",NUll,&imp,255)
      	ImpDriver=extraitchaine(imp,2,",")+caract(0)
      	ImpPort=extraitchaine(imp,3,",")+caract(0)
      	imp=SansEspace(imp)+caract(0)
      	cf32.hDC32=appelDLL32("gdi32","CreateDCA",&ImpDriver,&imp,&ImpPort,null)
      	cf32.LogFont32=&lf32
      	cf32.Pointsize32=0
      	cf32.CustData32=null
      	cf32.Hook32=null
      	cf32.Template32=null
      	cf32.hInstance32=0
      	cf32.Style32=null
      	cf32.FontType32=0
      	cf32.SizeMin32=0
      	cf32.SizeMax32=0
      	si AppelDLL32("comdlg32.dll","ChooseFontA" ,&cf32)<>0 alors
      		// La structure lf32 contient ici tous les paramètres de la police choisie dans la boite de dialogue
      		si asc(lf32.Italic32)<>0 alors lItalique=Vrai sinon lItalique=Faux
      		si asc(lf32.Under32)<>0 alors lSouligne=Vrai sinon lSouligne=Faux
      		si asc(lf32.Strike32)<>0 alors lBarré=Vrai sinon lBarré=Faux
      		lNomPolice=lf32.FName32
      		lHauteur=(lf32.height32*(-3)/4)
      		lCouleur=cf32.rvbColors32
      		lGras=lf32.Weight32
      		RENVOYER vrai
      	sinon
      		RENVOYER Faux
      	fin
      //fin
      
     type : 458752
   -
     name : RechercheSaint
     procedure_id : 4511921587127424281
     type_code : 14
     code : |1+
      Procédure RechercheSaint(DateSaint)
      
      NumJour est une chaine
      NumFic est un entier
      lLigne est une chaine
      NomCh est une chaine=""
      
      NumJour=gauche(dateverschaine(entierversdate(DateSaint)),5)
      NumFic=fouvre("FETES.TXT",folecture)
      si NumFic>0 alors
      	lLigne=flitLigne(NumFic)
      	tantque lLigne<>eot
      		si sansespace(extraitchaine(lLigne,3,tab))=NumJour alors
      			NomCh=extraitchaine(lLigne,2,tab)
      			sortir
      		FIN
      		lLigne=flitLigne(NumFic)
      	FIN
      	fferme(NumFic)
      sinon
      	NomCh=""
      fin
      
      renvoyer NomCh
      
      
      
     type : 458752
