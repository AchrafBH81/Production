  -
    name : CLICAGE
    identifier : 0x3e9d90c6297992fc
    internal_properties : 
    properties :
     x : 10
     y : 56
     width : 283
     height : 230
    type : 8
    code_elements :
     type_code : 8
     p_codes :
      -
        code : |1+
         // Sélection d'une date
         Cases	est un entier
         Jour1	est un entier
         //Code WinDev 5.5 remplacé par la migration :
         //Date1	est un entier long
         Date1	est un entier  
         // Récupère la position de clicage
         
         // Calcule le n° de la case cliquée (de 0 à 38)
         //Code WinDev 5.5 remplacé par la migration :
         //Cases=PartieEntiere(SourisPosH()*7/Clicage..Largeur)+...
         Cases=PartieEntiere(SourisPosX()*7/Clicage..Largeur)+...
         //Code WinDev 5.5 remplacé par la migration :
         //     PartieEntiere(SourisPosV()*6/Clicage..Hauteur)*7
              PartieEntiere(SourisPosY()*6/Clicage..Hauteur)*7
         
         // Calcule la date du premier jour du mois
         //Code WinDev 5.5 remplacé par la migration :
         //Date1=DateVersEntier(Annee+Verschaine(Mois,"02d")+"01")
         Date1=DateVersEntier(Annee+NumeriqueVersChaine(Mois,"02d")+"01")
         // Calcule de la case de départ du 1er du mois
         Jour1=EntierVersJour(Date1)-1
         // Vérifie qu'il n'y a pas eu sélection avant le premier jour
         si Cases<Jour1 alors
         	Bip					// Emet un bip, c'est tout
         	retour
         fin
         // Vérifie qu'il n'y a pas eu sélection aprés le dernier jour
         si Val(Milieu(EntierVersDate(Date1-Jour1+Cases),5,2))<>Mois alors
         	Bip					// Emet un bip, c'est tout
         	retour
         fin
         // Rend le résultat
         Resultat=Date1-Jour1+Cases
         ferme
         
        type : 18
