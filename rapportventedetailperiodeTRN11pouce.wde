  -
    name : BLOC_CORPS
    identifier : 0x487221d333109f0e
    internal_properties : CQAAAAkAAAASbdMcEnaRAv7UrZue46FaSOMqtRt3dCMe4Zt55zSvTmm5IkPnDNn9wN5LIz9MMrZt0TpZoeW3VGsX8ICKkirDpvwzamyBqolfowoxurGzY5QPmbVI2ahlLJRXVQJ6OuvePiR/7bvO7eKmsBkDWDBdd04DYijd4WmCIq2/SFvz//wBvPCeG8YxWalt2II1WLVOa4GgG0Hd8TtkjU4BzaPyBhz5fCD55QqvBfS/HUICE4+rUYF4G521iL6V/SAePOLHoVO4BtfiwQUYvlP5/0U=
    properties :
     y : 124.013
     width : 269.4
     height : 1.515
    code_elements :
     type_code : 30
     p_codes :
      -
        code : |1+
         si RequeteventePeriodeProduit.lperiode >= ltableauperiode[1] et RequeteventePeriodeProduit.lperiode <= ltableauperiode[2] alors
         	TOTALPRODUIT+=RequeteventePeriodeProduit.lvente//+RequeteventePeriodeProduit.peinturecarrelage
         	TOTALQTE+=RequeteventePeriodeProduit.lqte
         	surchargeper+=RequeteventePeriodeProduit.lsurcharge
         	TotalPiedCourant+=RequeteventePeriodeProduit.lpied
         	lPeintureCarrelage+=RequeteventePeriodeProduit.peinturecarrelage
         	si RequeteventePeriodeProduit.lType = "T"  ALORS
         		TOTALQTETHERMOS1+=RequeteventePeriodeProduit.lqte
         		si RequeteventePeriodeProduit.LQteSimple = "S" alors
         			TOTALQTEVERRE+=RequeteventePeriodeProduit.lqte
         		sinon
         			TOTALQTETHERMOS+=RequeteventePeriodeProduit.lqte
         		FIN
         	sinon si RequeteventePeriodeProduit.lType = "C" alors
         		TOTALQTEcarrelage+=RequeteventePeriodeProduit.lqte
         	fin
         	
         sinon
         	TOTALPRODUITprec+=RequeteventePeriodeProduit.lvente//+RequeteventePeriodeProduit.peinturecarrelage
         	TOTALQTEprec+=RequeteventePeriodeProduit.lqte
         	surchargeperprec+=RequeteventePeriodeProduit.lsurcharge
         	TotalPiedprec+=RequeteventePeriodeProduit.lpied
         	lPeintureCarrelageprec+=RequeteventePeriodeProduit.peinturecarrelage
         	si RequeteventePeriodeProduit.lType = "T"  ALORS
         		TOTALQTEThermosprec1+=RequeteventePeriodeProduit.lqte
         		
         		SI RequeteventePeriodeProduit.LQteSimple = "S" ALORS
         			TOTALQTEVERREprec+=RequeteventePeriodeProduit.lqte
         		SINON
         			TOTALQTETHERMOSprec+=RequeteventePeriodeProduit.lqte
         		FIN
         	sinon si RequeteventePeriodeProduit.lType = "C" alors
         		TOTALQTEcarrelagePREC+=RequeteventePeriodeProduit.lqte
         	fin
         FIN
         
         
        type : 327692
      -
        code : |1+
         
         
         
        type : 327693
      -
        type : 327697
        enabled : false
