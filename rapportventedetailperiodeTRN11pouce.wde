     p_codes :
      -
        internal_properties : CQAAAAkAAAAMKk0bUnppf9n/DdIx+pD12FdjGBpDdPouTXmKpwRX8VSK7s3EyvfwpbA1UoOIDFhQRWUvEtPmaHQL3DqP9EYkvNp92ZaY8pL88p/fEQhlXNEtBTP55g==
        code : |1-
         
         totalclient+=surchargeper+LPeintureCarrelage
         totalclientprec+=surchargeperprec+LPeintureCarrelagePrec
         si totalclientprec <> 0 alors
         	variationtotal = (TOTALCLIENT - TOTALCLIENTprec) / totalclientprec * 100
         sinon
         	VariationTotal = 0
         FIN
         
         TOTALANNEE = ltableaucomparatif[LNumeroClient].AnneeCourante
         totalanneep = ltableaucomparatif[LNumeroClient].AnneePrecedente
         
         SI TOTALanneeP <> 0 ALORS
         	VariationTotalAnnee = (TOTAlannee - TOTALanneeP) / TOTALanneep * 100
         SINON
         	VariationTotalAnnee = 0
         FIN
         
         TOTALTRIMESTRE = ltableaucomparatif[LNumeroClient].Trimestreencours
         TOTALtrimestrep = ltableaucomparatif[LNumeroClient].TrimestrePrecedent
         
         SI TOTALtrimestreP <> 0 ALORS
         	VariationTotaltrimestre = (TOTALtrimestre - TOTALtrimestreP) / TOTALtrimestreP * 100
         SINON
         	VariationTotaltrimestre = 0
         FIN
         
         
         CAS EXCEPTION:
         	
         //	info(lnumeroclient)
        type : 327692
      -
        code : |1-
         TOTALQTETHERMOS = 0
         TOTALQTETHERMOSPREC = 0
         TOTALQTECARRELAGE = 0
         TOTALQTECARRELAGEPREC = 0
         totalannee = 0
         totalanneep = 0
         totaltrimestre = 0
         totaltrimestrep = 0
         TOTALCLIENT = 0
         TOTALCLIENTPREC = 0
         SURCHARGEPER = 0
         SURCHARGEPERPREC = 0
         HAUT_RUPTURE3..visible = vrai
         lcompteurligne = 0
        type : 327693
