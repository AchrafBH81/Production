    code_elements :
     type_code : 30
     p_codes :
      -
        code : |1+
         TotVariation est un reel = TOTALPRODUIT - TOTALPRODUITPREC
         si TOTALPRODUIT = 0 et TOTALPRODUITPREC = 0 alors
         	variation = 0
         sinon si TOTALPRODUIT = 0 et TOTALPRODUITPREC <> 0 alors
         	Variation = -100
         	
         sinon
         		
         	Variation = TOTALPRODUIT <> 0 ? (TOTALPRODUIT - TOTALPRODUITPREC) / TOTALPRODUIT * 100 SINON 0
         FIN
        type : 327692
      -
        code : |1-
         totalclient+=totalproduit
         totalclientprec+=totalproduitprec 
         totalproduit = 0
         totalqte = 0
         TotalPiedCourant = 0
         totalproduitprec = 0
         totalqteprec = 0
         TotalPiedPrec=0
         lcompteurLigne++
         si lcompteurligne = 23 alors
         	lcompteurligne = 0
         	bloc_haut..visible = vrai
         	HAUT_RUPTURE3..visible = faux
         	iTerminePage()
         FIN
        type : 327693
      -
        type : 327697
        enabled : false
