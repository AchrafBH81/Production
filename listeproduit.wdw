     -
       internal_properties : CQAAAAkAAADSYjxTBhm9uPUS0RCjiGOo2n8KFVtYBDjaGiZbmezW7JNyLV8kKLcG+xNZLwp36qEbd1/b5fXaNZPztlKRCLVoRvc1r9VT6p4cx2fy8ABFNlmwxhiXJ2oUFkKhWnNVPe3uF7JLnsy3AzWzeDm/jq+NPIRdsWAkRh4aNg==
     -
       internal_properties : CQAAAAkAAACG8WqUeXJUzazQKNOCjZ/DQCYgvYXHEsIBVOgK4YfaOS0WzCrGCX40VtTzCd2zJ0BwlSQ0/q/S0D+JkMHpaNs308OZIMcO/qR9oHWjzNi7F3axTNEtDlJibTPn3103SZjhLTbpvUD0zCaZaooJb8cr+Dj2vGsN7MWt
    type : 5
    controls : []
    code_elements :
     type_code : 5
     p_codes :
      -
        code : |1+
         selon indiceencours()
         
         cas 2
           si rapportaimprimer[2] alors
         //Code WinDev 5.5 remplacé par la migration :
         //	 filtreadditionnel..etat = actif
         	 filtreadditionnel..etat = actif; filtreadditionnel..Visible=Vrai
           sinon
         //Code WinDev 5.5 remplacé par la migration :
         //	 filtreadditionnel..etat = grisé
         	 filtreadditionnel..etat = grisé; filtreadditionnel..Visible=Vrai
           fin			 
         cas 3
           si rapportaimprimer[3] alors
         //Code WinDev 5.5 remplacé par la migration :
         //	 filtreunite..etat = actif
         	 filtreunite..etat = actif; filtreunite..Visible=Vrai
           sinon
         //Code WinDev 5.5 remplacé par la migration :
         //	 filtreunite..etat = grisé
         	 filtreunite..etat = grisé; filtreunite..Visible=Vrai
           fin			 
         cas 4
           si rapportaimprimer[4] alors
         //Code WinDev 5.5 remplacé par la migration :
         //	 filtrecontenant..etat = actif
         	 filtrecontenant..etat = actif; filtrecontenant..Visible=Vrai
           sinon
         //Code WinDev 5.5 remplacé par la migration :
         //	 filtrecontenant..etat = grisé
         	 filtrecontenant..etat = grisé; filtrecontenant..Visible=Vrai
           fin			 
         cas 5
           si rapportaimprimer[5] alors
         //Code WinDev 5.5 remplacé par la migration :
         //	 filtrecarrelage..etat = actif
         	 filtrecarrelage..etat = actif; filtrecarrelage..Visible=Vrai
           sinon
         //Code WinDev 5.5 remplacé par la migration :
         //	 filtrecarrelage..etat = grisé
         	 filtrecarrelage..etat = grisé; filtrecarrelage..Visible=Vrai
           fin			 
         cas 6
         	si rapportaimprimer[6] alors
         		//Code WinDev 5.5 remplacé par la migration :
         		//	 filtreverreunite..etat = actif
         		filtreverreunite..etat = actif; filtreverreunite..Visible=Vrai
         	sinon
         		//Code WinDev 5.5 remplacé par la migration :
         		//	 filtreverreunite..etat = grisé
         		filtreverreunite..etat = grisé; filtreverreunite..Visible=Vrai
         	fin			 
         cas 7
         	si rapportaimprimer[7] alors
         		//Code WinDev 5.5 remplacé par la migration :
         		//	 filtreverreunite..etat = actif
         		filtrepeinture..etat = actif; FILTREPEINTURE..Visible=Vrai
         	sinon
         		//Code WinDev 5.5 remplacé par la migration :
         		//	 filtreverreunite..etat = grisé
         		FILTREPEINTURE..etat = grisé; FILTREPEINTURE..Visible=Vrai
         	fin			 
         fin
         
        type : 17
  -
    name : BTN_IMPRIME
    identifier : 0x3e9d90cc244da8d0
    internal_properties : 
    properties :
     x : 367
     y : 86
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         iconfigure(sansespace(imprimanterapport),vrai)
         //Début du code généré par l'assistant de code de la fonction iParamètre
         
         
         //iParamètre("DEFAUT=NON")
         //iParamètre("FORMATPAPIER=DEFINIUTILISATEUR")
         //iParamètre("HAUTEURPAGE=2794")
         //iParamètre("LARGEURPAGE=2159")
         //Début du code généré par l'assistant de code de la fonction iParamètre
         
         
         //Ne sauvegarde pas les paramètres spécifiés
         iParamètre("DEFAUT=NON")
         //Format de papier prédéfini
         iParamètre("FORMATPAPIER=LETTRE")
         iParamètre("QUALITE=HAUTE")
         
         //Fin du code généré par l'assistant de code de la fonction iParamètre
         si rapportaimprimer[1] alors
          iimprimeetat("LISTE DE BASE")
         fin
         
         si rapportaimprimer[2] alors
          iimprimeetat("LISTE ADDITIONNEL",0,totalcatadditionnel)
         fin
         
         si rapportaimprimer[3] alors
          iimprimeetat("LISTE UNITE UNITE",0,totalcatunite)
         fin
         
         si rapportaimprimer[4] alors
          iimprimeetat("LISTE UNITE BOITE",0,totalcatcontenant)
         fin
         
         si rapportaimprimer[5] alors
          iimprimeetat("LISTE UNITE CARRELAGE",0,totalcatcarrelage)
         fin
         
         si rapportaimprimer[6] alors
          iimprimeetat("LISTE BASE PIED",0,totalcatverreunite)
         fin
         
         si rapportaimprimer[7] alors
         	iimprimeetat(listepeinture,0,totalcatpeinture)
         fin
         
         si rapportaimprimer[8] alors
         	// iimprimeetat("LISTE THERMOS")
         	iimprimeetat(LISTE_THERMOS_PRIX_global)
         fin
         
         
         si rapportaimprimer[9] alors
         	iimprimeetat(listeforme)
         fin
         
         
         
         restaure_bouton()
         
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_ECRAN
    identifier : 0x3e9d90cc108ba8ee
    internal_properties : 
    properties :
     x : 367
     y : 140
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         iconfigure(sansespace(imprimanterapport),vrai)
         //Début du code généré par l'assistant de code de la fonction iParamètre
         
         
         //iParamètre("DEFAUT=NON")
         //iParamètre("FORMATPAPIER=DEFINIUTILISATEUR")
         //iParamètre("HAUTEURPAGE=2794")
         //iParamètre("LARGEURPAGE=2159")
         iParamètre("DEFAUT=NON")
         //Format de papier prédéfini
         iParamètre("FORMATPAPIER=LETTRE")
         
         si rapportaimprimer[1] alors
          iapercu(1,"Liste des produits")
          iimprimeetat("LISTE DE BASE")
         fin
         
         si rapportaimprimer[2] alors
          iapercu(1,"Liste des produits")
          iimprimeetat("LISTE ADDITIONNEL",0,totalcatadditionnel)
         fin
         
         si rapportaimprimer[3] alors
         	
          iapercu(1,"Liste des produits")
          iimprimeetat("LISTE UNITE UNITE",0,totalcatunite)
         fin
         
         si rapportaimprimer[4] alors
          iapercu(1,"Liste des produits")
          iimprimeetat("LISTE UNITE BOITE",0,totalcatcontenant)
         fin
         
         si rapportaimprimer[5] alors
          iapercu(1,"Liste des produits")
          iimprimeetat("LISTE UNITE CARRELAGE",0,totalcatcarrelage)
         fin
         
         si rapportaimprimer[6] alors
         	iapercu(1,"Liste des produits")
         	iimprimeetat("LISTE BASE PIED",0,totalcatverreunite)
         fin
         
         si rapportaimprimer[7] alors
         	iapercu(1,"Liste des produits")
         	iimprimeetat(listePeinture,0,totalcatpeinture)
         fin
         
         si rapportaimprimer[8] alors
         	iapercu(1,"Liste des Thermos")
         
         	// iimprimeetat("LISTE THERMOS")
         	iimprimeetat(LISTE_THERMOS_PRIX_global)
         fin
         
         
         si rapportaimprimer[9] alors
         	iapercu(1,"Liste des Fomes")
         
         	// iimprimeetat("LISTE THERMOS")
         	iimprimeetat(listeforme)
         fin
         
         
         
         restaure_bouton()
         
        type : 18
      -
        type : 161
        enabled : false
