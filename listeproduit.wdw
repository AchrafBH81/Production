     x : 278
     y : 134
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         selon filtreactif
         
         cas "totalcatadditionnel"
            totalcatadditionnel = sauvetablecat()
         
         cas "totalcatunite"
            totalcatunite = sauvetablecat()
            
         cas "totalcatcontenant"
            totalcatcontenant = sauvetablecat()
         	
         cas "totalcatcarrelage"
            totalcatcarrelage = sauvetablecat()
         
         cas "totalcatverreunite"
         	totalcatverreunite = sauvetablecat()
         
         cas "totalcatpeinture"
         	totalcatpeinture = sauvetablecat()
         
         fin
         //Code WinDev 5.5 remplacé par la migration :
         //_onglet1..etat = actif
         MaFenetre..Plan=1
         
