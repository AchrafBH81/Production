 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1+
      
      // Pour compatibilité 5.5
      MoiMême..Visible=Vrai
      
      global
      totalcategorie est une chaine
      totalcatadditionnel est une chaine
      totalcatunite est une chaine
      totalcatcontenant est une chaine
      totalcatcarrelage est une chaine
      totalcatverreunite est une chaine
      totalcatthermos est une chaine
      totalcatpeinture est une chaine
      
      
      filtreactif est une chaine
      chargeimage(1,maitre.FichierImage..valeur,1,13)
      ListeAjoute("crochet",gImage(1,7))
      
      //Code WinDev 5.5 remplacé par la migration :
      //_onglet1..etat = actif
      MaFenetre..Plan=1
      
      hlitpremier("Categori","Description")
      
      //Code WinDev 5.5 remplacé par la migration :
      //tantque pas h.endehors
      tantque pas HEnDehors()
      	tableajoute("TABLE1",faux+tab+Categori.Description+tab+Categori.cnumero)
          totalcategorie += categori.cnumero+"_"
      	hlitsuivant("Categori","Description")
      FIN
      totalcatadditionnel = totalcategorie
      totalcatunite  = totalcategorie
      totalcatcontenant  = totalcategorie
      totalcatcarrelage = totalcategorie
      totalcatverreunite  = totalcategorie
      totalcatpeinture  = totalcategorie
      
      listeproduit.rapportaimprimer[1] = faux
      listeproduit.rapportaimprimer[2] = vrai
      listeproduit.rapportaimprimer[3] = vrai
      listeproduit.rapportaimprimer[4] = vrai
      listeproduit.rapportaimprimer[5] = vrai
      listeproduit.rapportaimprimer[6] = vrai
      listeproduit.rapportaimprimer[7] = vrai
      listeproduit.rapportaimprimer[8] = vrai
      listeproduit.rapportaimprimer[9] = vrai
      
      listeproduit.rapportaimprimer[1]..visible = faux
      
   -
     type : 180
     enabled : false
   -
     type : 230
     enabled : false
   -
     type : 11
   -
     type : 12
   -
     type : 17
   -
     type : 13
  procedures :
   -
     name : remplirtablecat
     procedure_id : 4511921609034738042
     type_code : 14
     code : |1+
      Procédure remplirtablecat(lefiltre)
      j est un entier
      
      pour j = 1 a tableoccurrence("TABLE1")
      	si position(lefiltre,complete(cat[j],3)) <> 0 alors
      		crochet[j] = vrai
      	sinon
      		crochet[j] = faux
      			
      	FIN
      	
      FIN
      
     type : 458752
   -
     name : sauvetablecat
     procedure_id : 4511921609242487182
     type_code : 14
     code : |1+
      Procédure sauvetablecat()
      lefiltre est une chaine = ""
      j est un entier
      
      pour j = 1 a tableoccurrence("TABLE1")
      	si crochet[j] alors
      		lefiltre += complete(cat[j],3)+"_"
      	FIN 
      FIN
      
      
      renvoyer(lefiltre)
      
     type : 458752
  procedure_templates : []
  property_templates : []
