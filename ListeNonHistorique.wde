    name : CORPS
    identifier : 0x41bd0b146e831b2b
    internal_properties : CQAAAAkAAABKVVsGqqkdiHa/xL0BeVbHu+iEFQz0CBiSVCSRB7+DvaY9Y5PJEcNIHs21FufigbbsFdf40HInoaB/Jha+gg7jJWH+LAuQesF7TxqzOHrndnabhhe+0q64yb01Y+OYnMkllkkJnP1YCjMmrsp16+xPHxP9Z4751i3+VCBZ6bKRYtHcQpvvQRCVAXUkbo+xbIFQ1Zub03FoBryijPY8tJsQRtTwIPtkEoIWkrIT/yyJVdM7sLKgYml0ZJvDb7rXv2ZZ2Q==
    properties :
     width : 195.9
