         selon lrapportaimprimer
         	cas 5
         		imessage..visible = Vrai
         		
         		imessage = config.textebaspage1listeprix
         	CAS 6
         		iMessage..Visible = Vrai
         		
         		iMessage = config.textebaspageformelisteprix		
         	AUTRE CAS
         		
         FIN
         
         
