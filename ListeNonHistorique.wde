    code_elements :
     type_code : 30
     p_codes :
      -
        code : |1-
         
        type : 327692
      -
        code : |1-
         
         
         
         
         
         
         iHautBasPageImbriqué(vrai)
         pour i = 1 a 7
         	lrapportaimprimer = POSITION(lordre,NumériqueVersChaine(i))
         
         	selon lrapportaimprimer
         		cas 1	
         		    iFenêtreAbandon(faux)
         			lNombreenrImprime = 0
         			si listeprix.rapportaimprimer[1] ALORS
         				iImprimeEtat(ListeUniteClient,0)
         				
         				si lNombreenrImprime <> 0 alors
         					iterminepage()
         				fin
         			fin
         		cas 2	
         			iFenêtreAbandon(faux)
         			lNombreenrImprime = 0
         			si listeprix.rapportaimprimer[2]
         				iImprimeEtat(ListeCarrelageClient,0)
         				si lNombreenrImprime <> 0 alors
         					iterminepage()
         				fin
         			fin
         		cas 3
         			iFenêtreAbandon(faux)
         			lNombreenrImprime = 0
         			si listeprix.rapportaimprimer[3]
         				iImprimeEtat(ListeVerreUniteClient,0)
         				si lNombreenrImprime <> 0 alors
         					iterminepage()
         				fin
         			fin
         		cas 4
         			iFenêtreAbandon(faux)
         			lNombreenrImprime = 0
         			si listeprix.rapportaimprimer[4]	
         				iImprimeEtat(Listepeintureclient,0)
         
         				si lNombreenrImprime <> 0 alors
         					iterminepage()
         				fin
         			fin
         		cas 5
         			iFenêtreAbandon(faux)
         			lNombreenrImprime = 0
         			si listeprix.rapportaimprimer[5]
         				selon gFormatFacture
         					cas 1	
         						iImprimeEtat(ListeThermosPrixClient,0)
         						
         					cas 2
         						iImprimeEtat(ListeThermosPrixClientTRN,0)
         				fin
         
         				si lNombreenrImprime <> 0 alors
         					iterminepage()
         				fin
         			fin
         			
         		cas 6
         			iFenêtreAbandon(faux)
         			lNombreenrImprime = 0
         			si listeprix.rapportaimprimer[6]
         				iImprimeEtat(listeformeclient,client.numero)
         
         				si lNombreenrImprime <> 0 alors
         					iterminepage()
         				fin
         			fin
         
         		cas 7
         			iFenêtreAbandon(faux)
         			lNombreenrImprime = 0
         			si listeprix.rapportaimprimer[7]
         
         //				iImprimeEtat(ListeExtraPrixClient,client.numero)
         				iImprimeEtat(ListeExtraPrixClientTrieStandard,client.numero,"1")
         				si lNombreenrImprime <> 0 alors
         					iterminepage()
         				fin
         				iImprimeEtat(ListeExtraPrixClientTrieStandard,client.numero,"2")
         				si lNombreenrImprime <> 0 alors
         					iterminepage()
         				fin
         			fin
         
         	fin
         
         fin
         si pas FenEtat(FenAttentePetite)=Inexistant alors
             multitache(200)
         	ferme(FenAttentePetite)
         FIN
        type : 327693
      -
        type : 327697
        enabled : false
