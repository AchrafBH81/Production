 code_elements :
  type_code : 13
  p_codes :
   -
     code : |1+
      procedure EBaisseClientParVendeur(Ldate est une chaine,lidvendeur est un entier = 0,gtabSales est un tableau de stsales=null,gtabDates est un tableau de chaines =null)
      
      Lib_currentYear = dateverschaine(gtabDates[1],"JJ/MM/AAAA") +rc+dateverschaine(gtabDates[2],"JJ/MM/AAAA")
      Lib_lastYear = dateverschaine(gtabDates[3],"JJ/MM/AAAA") +rc+dateverschaine(gtabDates[4],"JJ/MM/AAAA")
      
      
      
     type : 327680
   -
     code : |1+
      
      
     type : 327695
   -
     code : |1+
      
      
     type : 327696
