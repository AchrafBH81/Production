     -
       name : LibelleNIR
       identifier : 0x5871495f52595bf5
       internal_properties : 
       properties :
        x : 18.7
        y : 20.232
        width : 72.523
        height : 5.
       code_elements :
        type_code : 29
        p_codes :
         -
           code : |1+
            moimeme ="NIR Propriétaire:" + sansespace(Config.nir)
            
            
           type : 327692
         -
           type : 327699
           enabled : false
    properties :
     width : 215.9
     height : 84.669
    code_elements :
     type_code : 30
     p_codes :
      -
        code : |1+
         hlitrecherche(client,numero,requeteBletat.bclient)
         si client.IDHeuresOuverture <> 0 alors
         	si hlitrecherche(HeuresOuverture,IDHeuresOuverture,client.IDHeuresOuverture) alors
         		SELON Client.CLangue
         			CAS 0,1
         				SI HLitRecherche(Traduction,trecherche,"libheureouverture") ALORS
         					ShippingBilltrn.libheureouverture = Traduction.dfrancais + " " + HeuresOuverture.HODescription
         				FIN
         			cas 2
         				SI HLitRecherche(Traduction,trecherche,"libheureouverture") ALORS
         					ShippingBillTRN.LibHeureOuverture = Traduction.danglais + " " + HeuresOuverture.HODescription
         				FIN
         		fin		
         //		LibHeureOuverture = "Heures d'ouverture :"+ HeuresOuverture.HODescription
         	FIN
         FIN
         
         assigneLibelle()
         
         si RequeteBlEtat.lnom <> "" alors
         	NomClient2 = requetebletat.lNom
         	AdresseClient1 = RequeteBlEtat.lRue
         	VilleClient1 = RequeteBlEtat.lVille
         	CodePostalClient1 = RequeteBlEtat.lCodePostal	
         sinon
         	NomClient2 = "  M Ê M E / S A M E  "
         	AdresseClient1 = ""
         	VilleClient1 = ""
         	CodePostalClient1 = ""
         	TelephoneClient1 = ""	
         	
         FIN
         
         //si requetebletat.idlivraison <> 0 alors
         //	si hlitrecherche(ClientLivraison,IDClientLivraison,requetebletat.idlivraison) alors
         //		nomclient2 = ClientLivraison.lNom
         //		adresseclient1 = ClientLivraison.lRue
         //		VilleClient1 = ClientLivraison.lVille+","+ClientLivraison.lprovince
         //		CodePostalClient1 = ClientLivraison.lCodePostal	
         //		TelephoneClient1 = clientlivraison.ltelephone
         //	FIN
         //sinon
         //	nomclient2 = "  M Ê M E / S A M E  "
         //	adresseclient1 = ""
         //	VilleClient1 = ""
         //	CodePostalClient1 = ""
         //	TelephoneClient1 = ""	
         //FIN
         si sansespace(Requetebletat.fnopeinture) = "" alors
         	grppeinture..visible = faux
         	
         sinon
         	CCouleurPeinture = Requetebletat.fnopeinture
         	Cdescpeinture = Requetebletat.fdescpeinture
         	CCouleurPeinture2 = Requetebletat.fnopeinture
         	Cdescpeinture2 = Requetebletat.fdescpeinture
         	si Requetebletat.ftypepeinture1 = 1 alors
         		libelle10 = "Peinture extérieure:"
         		libelle12 = "Peinture extérieure:"
         		
         	FIN
         FIN
         si SansEspace(Requetebletat.fnopeinture1) <> "" alors
         	CCouleurPeinture1 = Requetebletat.fnopeinture1
         	Cdescpeinture1 = Requetebletat.fdescpeinture1
         	CCouleurPeinture3 = Requetebletat.fnopeinture1
         	Cdescpeinture3 = Requetebletat.fdescpeinture1
         	libelle10 = "Peinture extérieure:"
         	libelle12 = "Peinture extérieure:"
         	GrpPeintureInt..visible = vrai
         sinon
         	GrpPeintureInt..visible = faux    
         FIN
        type : 327692
      -
        code : |1+
         
         
        type : 327693
      -
        type : 327697
        enabled : false
  -
