 controls : []
 code_elements :
  type_code : 13
  p_codes :
   -
     code : |1+
      procedure ShippingBillTRN(_NbCopies = 1,param2="",param3="",param4="")
      tableaucarrelage est un tableau dynamique
      tableaucarrelage = allouer un tableau de 0 par 5 chaine
      dimensiontableaucarrelage est un entier = 0
      calculligne est un entier = 0
      AncienNumCommande est un entier = 99999999
      AncienNumCarrelage est une chaine = ""
      ldebut est un booleen = vrai
      lnombrethermos est un entier
      ltypeligne est une chaine
      
      hlit(config,1)
      
      iNumPage(1)
     type : 327680
  procedures :
   -
     name : Rupturefdcomm
     procedure_id : 1761269601975229413
     type_code : 14
     code : |1+
      Procédure Rupturefdcomm()
      
      iimprime("salut")
      
     type : 458752
   -
     name : assigneLibelle
     procedure_id : 1761269601975294949
     type_code : 14
     code : |1+
      Procédure assigneLibelle()
      i est un entier
      
      lTableauLibelle est un tableau de  30 chaines
      lTableauLibelle[1]  = "blentete"
      lTableauLibelle[2]  = "facpage"
      lTableauLibelle[3]  = "facpagede"
      lTableauLibelle[4]  = "blnoShippingbill"
      lTableauLibelle[5]  = "facdate"
      lTableauLibelle[6]  = "facnumcommande"
      lTableauLibelle[7]  = "facjobdetail"
      lTableauLibelle[8]  = "facquantite"
      lTableauLibelle[9]  = "faclargeur"
      lTableauLibelle[10] = "fachauteur"
      lTableauLibelle[11] = "facdescription"
      lTableauLibelle[12] = "facfini"
      lTableauLibelle[13] = "facspacer"
      lTableauLibelle[14] = "faccarrelage"
      lTableauLibelle[15] = "facrecupar"
      lTableauLibelle[16] = "facnumlot"
      lTableauLibelle[17] = "vendua"
      lTableauLibelle[18] = "livrea"
      lTableauLibelle[19] = "votrecommande"
      lTableauLibelle[20] = "notrereference"
      lTableauLibelle[21] = "NbThermos"
      lTableauLibelle[22] = "NbGrill"
      lTableauLibelle[23] = "votrereference" 
      
      
      
      selon client.CLangue
      	cas 0,1
      		pour i = 1 a 30
      			si hlitrecherche(Traduction,TRecherche,lTableauLibelle[i]) alors
      				{"Shippingbilltrn."+lTableauLibelle[i]} = traduction.dFrancais
      			fin
      		FIN
      
      	cas 2
      		pour i = 1 a 30
      			si hlitrecherche(Traduction,TRecherche,lTableauLibelle[i]) alors
      				{"Shippingbilltrn."+lTableauLibelle[i]} = traduction.danglais
      			fin
      		FIN
      fin
      
      Shippingbilltrn.Facnumlot1 = Shippingbilltrn.facnumlot
      Shippingbilltrn.Facnumcommande1 = Shippingbilltrn.facnumcommande
      Shippingbilltrn.Facjobdetail1 = Shippingbilltrn.Facjobdetail
      Shippingbilltrn.Facquantite1 = Shippingbilltrn.Facquantite
      Shippingbilltrn.Faclargeur1 = Shippingbilltrn.faclargeur
      Shippingbilltrn.Fachauteur1 = Shippingbilltrn.fachauteur
      Shippingbilltrn.Facdescription1 = Shippingbilltrn.Facdescription
      Shippingbilltrn.Facfini1 = Shippingbilltrn.facfini
      Shippingbilltrn.Facspacer1 = Shippingbilltrn.facspacer
      Shippingbilltrn.Faccarrelage1 = Shippingbilltrn.Faccarrelage
      //Shippingbilltrn.Facnorack1 = Shippingbilltrn.Facnorack
      Shippingbilltrn.blentete1 = Shippingbilltrn.blentete
      //Shippingbilltrn.Facpage1 = Shippingbilltrn.Facpage
      //Shippingbilltrn.Facpagede1 = Shippingbilltrn.Facpagede
      Shippingbilltrn.BlnoBonLivraison1 = Shippingbilltrn.Blnobonlivraison
      Shippingbilltrn.Facdate1 = Shippingbilltrn.Facdate
      Shippingbilltrn.VotreCommande1 =ShippingbillTRN.VotreCommande
      ShippingbillTRN.NotreReference1 = ShippingbillTRN.NotreReference
      ShippingbillTRN.votreReference2 = ShippingbillTRN.votreReference
     type : 458752
  procedure_templates : []
  property_templates : []
