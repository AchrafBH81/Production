 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1-
      procedure choixproduit(noproduit,comp1,comp2,comp3,noproduitrpl,comprpl1,comprpl2,comprpl3,lCap,lGAz,Provenance = "commande")
      
      // Pour compatibilité 5.5
      MoiMême..Visible=Vrai
      
      
      global
      	valeuraretourner est un entier
      
      si sansespace(comprpl1) = "" et sansespace(comprpl2) = "" et sansespace(comprpl3) = "" alors
      	BTN_CONTINUE..etat = grise
      
      FIN
      HLITRECHERCHE(persoens,clecomposantcapgaz,HConstruitValClé(persoens,clecomposantcapgaz,comprpl1,comprpl2,comprpl3,lcap,lgaz), hidentique)
      SI PAS HEnDehors() ET HTrouve() ALORS
      	tantque comprpl1 = persoens.encomposant1 et  comprpl2 = persoens.encomposant2 et ...
      		comprpl3 = persoens.encomposant3 et persoens.encap = lcap et persoens.engaz = lgaz 
      		si persoens.enactif alors  tableajouteligne(TableRempl,persoens.ennumero,persoens.endescription,persoens.encomposant1,persoens.encomposant2,persoens.encomposant3)
      		hlitsuivant(persoens,clecomposantcapgaz)
      	fin
      FIN
      si tablerempl..occurrence = 0 alors
      	TableAjouteLigne(TableRempl,"","Aucune configuration définie pour ces composantes",comprpl1,comprpl2,comprpl3)
      	
      FIN
   -
     code : |1-
      TableAffiche(TableRempl,taDébut)
      si pas TableOccurrence(TableRempl) = 0 alors
      	RepriseSaisie(TableRempl)
      sinon
      	BTN_CONTINUE..etat = grise
      fin
     type : 34
   -
     type : 180
     enabled : false
   -
     type : 230
     enabled : false
   -
     code : |1+
      renvoyer valeuraretourner
      
     type : 2
   -
     type : 11
   -
     type : 12
   -
     type : 17
   -
     type : 13
