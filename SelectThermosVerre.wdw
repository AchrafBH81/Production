  -
    name : Btn_Ok
    identifier : 0x2c465c3d030b4f73
    internal_properties : 
    properties :
     x : 45
     y : 6
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         tabChoix est un tableau de chaines
         VerreSimple est un booleen =  faux
         
         pour TOUTE LIGNE de Table1
         	si table1.selected alors
         		TableauAjouteLigne(tabChoix,sansespace(table1.Description)+";"+sansespace(Table1.Hauteur)+";"+sansespace(table1.Largeur)+";"+sansespace(table1.numero)+";"+Table1.Quantite+";"+sansespace(table1.fini)+";"+SansEspace(Table1.intercalaire)+";"+selecteur1...
         		                  +";"+table1.CarreauHauteur+";"+Table1.CarreauLargeur+";"+Table1.PeintureInterieure+";"+Table1.PeintureExterieure+";"+Table1.TypeCarrelage+";"+Table1.FiniDimension+";"+Table1.NumeroCarrelage+";"+Table1.CodeSpacer+";"+Table1.dth+";"+table1.notes...
         		                  +";"+table1.Barrotin+";"+table1.forme)
         		si pas VerreSimple alors 
         			si table1.NbVerre = "S" alors
         				VerreSimple = vrai                 
         			FIN
         		FIN
         	fin
         FIN
         mafenetre..ValeurRenvoyée = tabChoix
         fcommandeachat.ThermosFermeExterieur = selecteur1 = "T" ? vrai sinon faux
         //fcommandeachat.ThermosFermeExterieur = vrai
         
         selon selecteur1
         	// Thermos
         	CAS "T"
         		si VerreSimple alors
         			fCommandeAchat.ThermosOuVerre = "V"
         		sinon
         			fCommandeAchat.ThermosOuVerre = "T"	
         		FIN
         	// Verre
         	CAS "V"
         		fCommandeAchat.ThermosOuVerre = "V" 
         		
         FIN
         ferme(mafenetre)
        type : 18
      -
        type : 161
        enabled : false
