 menu :
  name : _Menu
  identifier : 0x2c4658d3010cfa8c
  internal_properties : 
  options : []
 languages :
  - fr-FR
 popup_menus : []
 message_bar :
  internal_properties : CQAAAAkAAACl6kflvHBOxqwP7W0c2Hg7uS9SZX3BbfK2DMxIqw5Lo+9Sh5M4SufR99FUN9h07jvT8Rsyb81qWiLdjcIFxjjkWbt84vHk3HAcgKjKU/wUGwGi4t9R0l/C62zk
 actionbar : {}
 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1+
      PROCEDURE MaFenêtre(noCommande est un entier = 0 )
      ReqSql est une requête SQL = 
      [
        select * from fdetail where fdetail.fdnocomm = {pNoComm} and fdetail.ftype = 1 and fdetail.fdqteafacturer <> 0 order by fdetail.fdligne<§cs:3§>
      ]
      mafenetre..ValeurRenvoyée = ""
      sSpacer est une chaîne
      sspacerCode est une chaine
      slargeur est une chaîne 
      sHauteur est une chaîne 
      ntypecalcul est un entier = 1// Anglais ou métrique
      
      si hlitrecherche(Facture,fanumero,nocommande) alors
      	ntypecalcul = facture.facalcul
      FIN
      pLargeur est une chaine ansi
      pHauteur est une chaine ansi
      
      
      
   -
     code : |1+
      Desccarrelage est une chaine
      Notes est une chaine
      sTypeCarrelage est une chaine
      sDTH est une chaine
      NbCarreauh est une chaîne
      NbCarreauv est une chaîne
      NoPeintureInterieure est une chaine
      NoPeintureExterieure est une chaine
      sFini est une chaîne
      
      
      tablesupprimetout(table1)
      reqsql.pnocomm = noCommande
      
      
      si HExécuteRequêteSQL(ReqSql) alors
      	pour TOUT ReqSql 
      		Desccarrelage = ""
      		sDTH = ""
      		sTypeCarrelage = ""
      		Notes  = ""
      		NbCarreauh =""
      		NbCarreauv = ""
      		sBarrotin est une chaine =""
      		si Sélecteur1 = 2 _ou_ reqsql.ThermosType = "S" alors
      			sFini = val(droite(sansespace(reqsql.fdbase),2))
      		sinon
      			sFini = reqsql.ffini
      		FIN
      		//		TypeCarrelage = GetCarrelageType(ReqSql.fdnumcarr)
      		SI ReqSql.fdcarrelage ALORS
      			Desccarrelage+= SansEspace(ReqSql.fddesccarr) + " " + ReqSql.fdcarreauv + " X "+ ReqSql.fdcarreauh
      			si hlitrecherche(invent,INUM,reqsql.fdnumcarr) alors
      				si hlitrecherche(typecarr,tcdescription,reqsql.fdtypecalcul) alors
      					si typecarr.Typedessin = 2 alors
      						sTypeCarrelage = "Contour"
      						sDTH = reqsql.fdvariablex
      					sinon
      						sTypeCarrelage = "Normal"
      						
      					FIN
      				FIN
      				si reqsql.tdemicarrelage alors
      					sTypeCarrelage = "Suspendu"
      					sDTH = reqsql.fdt
      				FIN
      			FIN
      			NbCarreauh = reqsql.fdcarreauh
      			NbCarreauv = ReqSql.fdcarreauv
      			si reqsql.fdBarrotin = 0 alors
      				sBarrotin = ""
      			sinon
      				si hlitrecherche(Barrotin,IDBarrotin,ReqSql.fdBarrotin) alors
      					sBarrotin = barrotin.Bdescription
      				sinon
      					sBarrotin = ""
      				FIN
      			fin
      		FIN
      		si reqsql.fpeinture alors
      			si reqsql.ftypepeinture = 2 alors
      				Desccarrelage+=rc+"Peint. TLT "+reqsql.fnopeintureexttout+ " " + reqsql.fdescpeintureexttout
      				NoPeintureExterieure = ReqSql.fnopeintureexttout
      				NoPeintureInterieure = ReqSql.fnopeintureexttout
      			sinon
      				si sansespace(ReqSql.fnopeintureexttout) <> "" alors
      					Desccarrelage+=RC+"Peint. Ext. "+ ReqSql.fnopeintureexttout+ " " + sansespace(ReqSql.fdescpeintureexttout) //+ "  (extérieur)"
      					NoPeintureExterieure = ReqSql.fnopeintureexttout
      				FIN
      				SI SansEspace(ReqSql.fnopeintureinterieure) <> "" ALORS
      					Desccarrelage+=RC+"Peint Int. "+ReqSql.fnopeintureinterieure+ " " + sansespace(ReqSql.fdescpeintureinterieure) // + "  (intérieur)"
      					NoPeintureInterieure = ReqSql.fnopeintureinterieure
      				FIN
      			fin
      		FIN
      		//	SI HLitRecherche(typespac,tnumero,ReqSql.ftypespacer) ALORS
      		SI HLitRecherche(IntercalaireCouleurs,IDIntercalaireCouleurs,ReqSql.ftypespacer) ALORS
      			sSpacer = SansEspace(IntercalaireCouleurs.Description)
      			sspacerCode =  SansEspace(IntercalaireCouleurs.DescriptionCourte)
      			
      		sinon
      			sspacer = "Spacer inconnu"	 
      			sspacerCode = ""
      		FIN
      		Notes = ""
      		SI ReqSql.fnotes <> "" ALORS
      			Notes+=sansespace(ReqSql.fnotes)
      		FIN
      		SI ReqSql.fnotes1 <> "" ALORS
      			Notes+=[rc]+sansespace(ReqSql.fnotes1)
      		FIN
      		
      		
      		selon ntypecalcul
      			cas 1
      				pLargeur = ReqSql.fdlargeura
      				phauteur = ReqSql.fdhauteura
      				
      				slargeur = arrondi(InchFractionToMillimeter(plargeur))
      				shauteur = arrondi(InchFractionToMillimeter(phauteur))
      				
      			cas 2
      				slargeur = val(ReqSql.fdlargeura)
      				sHauteur = val(ReqSql.fdhauteura)
      				
      				
      			AUTRE CAS
      				
      		FIN
      		//		tableajouteligne(Table1,Faux,reqsql.fdqte,reqsql.fdnumprod,reqsql.fddesc+" FINI:"+ReqSql.ffini + " " + "SPACER:" + ReqSql.fdespace + ":" + ReqSql.fdespace2,reqsql.fdlargeura,"X",reqsql.fdhauteura)
      		//		TableAjouteLigne(Table1,Faux,ReqSql.fdqte,ReqSql.fdnumprod,ReqSql.fddesc,ReqSql.fdlargeura,"X",ReqSql.fdhauteura," FINI:"+sansespace(ReqSql.ffini) + " " + sspacer+":" + sansespace(ReqSql.fdespace) + ":" + sansespace(ReqSql.fdespace2))
      		TableAjouteLigne(Table1,Faux,ReqSql.fdqteafacturer,ReqSql.fdnumprod,TrouveThermosDescription(ReqSql.fdnumprod,reqsql.fddesc)+(Desccarrelage <> "" ? RC+Desccarrelage SINON "")+(Notes <> "" ? RC+Notes SINON ""),slargeur,"X",shauteur," FINI:"+SansEspace(ReqSql.ffini) + " " + sSpacer ,...
      		sspacer,NbCarreauv,NbCarreauh,NoPeintureInterieure,NoPeintureExterieure,sTypeCarrelage,sFini,reqsql.fdnumcarr,sspacercode,sDTH,Notes,sBarrotin,reqsql.ThermosType,reqsql.fdforme)
      		
      	FIN
      sinon
      	info(herreurinfo(hErrComplet))
      FIN
