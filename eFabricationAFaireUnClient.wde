    properties :
     y : 10.
     width : 269.392
     height : 6.032
    code_elements :
     type_code : 30
     p_codes :
      -
        code : |1+
         
         //// ****************** Nouveau code ****************************
         
         j est un entier
         
         carrtrouve est un booleen = faux//A FAIRE :
         
         SI RequeteDetailUnJourUnClient.ftype = 1 ALORS
         	
         	lTypeLigne = "Verre"
         SINON SI RequeteDetailUnJourUnClient.ftype = 2 
         	SI PAS RequeteDetailUnJourUnClient.fdverreunite ALORS
         		lTypeLigne = "Unite"
         	SINON
         		lTypeLigne = "Verre"
         	FIN
         SINON SI RequeteDetailUnJourUnClient.ftype = 3
         	lTypeLigne = "Fourniture" 
         SINON SI RequeteDetailUnJourUnClient.ftype = 4
         	lTypeLigne = "Carrelage" 
         SINON SI RequeteDetailUnJourUnClient.ftype = 5
         	lTypeLigne = "Peinture" 
         FIN
         
         
         
         SELON lTypeLigne
         
         
         
         	CAS "Verre"
         		
         		totalfacture +=  Arrondi(RequeteDetailUnJourUnClient.fdqteafacturer * (RequeteDetailUnJourUnClient.fdpiedcarrefacture * RequeteDetailUnJourUnClient.fdprixupiedfacture),2)+ ...
         		Arrondi(RequeteDetailUnJourUnClient.fdqteafacturer *RequeteDetailUnJourUnClient.fdextraforme,2)+Arrondi(RequeteDetailUnJourUnClient.fdqteafacturer *RequeteDetailUnJourUnClient.FDextra10X,2)+...
         		Arrondi(RequeteDetailUnJourUnClient.fdqteafacturer *RequeteDetailUnJourUnClient.FDextra5x,2)
         		
         		
         		si sansespace(RequeteDetailUnJourUnClient.fdcomposant2) = "" et SansEspace(RequeteDetailUnJourUnClient.fdcomposant3) = "" alors
         			totalcarrelage+=RequeteDetailUnJourUnClient.fdqteafacturer+RequeteDetailUnJourUnClient.fdqtedejafacture 
         		sinon
         			
         			totalthermos+=RequeteDetailUnJourUnClient.fdqteafacturer+RequeteDetailUnJourUnClient.fdqtedejafacture 
         		FIN
         		totalpoids += (RequeteDetailUnJourunclient.fdqteafacturer+RequeteDetailUnJourUnClient.fdqtedejafacture) * RequeteDetailUnJourUnClient.PoidsUnitaire 
         		
         		RequeteBonLivraisonFacture.pNoCommande = RequeteDetailUnJourUnClient.fdnocomm
         		RequeteBonLivraisonFacture.pNoLigne = RequeteDetailUnJourUnClient.fdligne
         		SI HExécuteRequête(RequeteBonLivraisonFacture) ALORS
         			POUR TOUT RequeteBonLivraisonFacture 
         				//					SELON RequeteBonLivraisonFacture.ftype
         				//						CAS 1
         				SI SansEspace(RequeteBonLivraisonFacture.fdcomposant2) = "" ET SansEspace(RequeteBonLivraisonFacture.fdcomposant2) =""   ALORS
         					totalcarrelage-= RequeteBonLivraisonFacture.la_somme_fdqteafacturer
         					
         				SINON
         					totalthermos-= RequeteBonLivraisonFacture.la_somme_fdqteafacturer
         				FIN
         				//				totalthermos-= RequeteBonLivraisonFacture.la_somme_fdqteafacturer
         				totalpoids -= RequeteBonLivraisonFacture.la_somme_fdqteafacturer * RequeteDetailUnJourUnClient.PoidsUnitaire 
         				//						CAS 4
         				//							totalcarrelage -= RequeteBonLivraisonFacture.totalCarreau
         				//						AUTRE CAS
         				//							
         				//					FIN
         			FIN
         		FIN
         		
         		
         		totalsurcharge += Arrondi(RequeteDetailUnJourUnClient.surchargeenergie,2) //* requetedetailunjourUnClient.fdqteafacturer / requetedetailunjourUnClient.fdqte
         		totalcap+= Arrondi(RequeteDetailUnJourUnClient.FDExtraCap * RequeteDetailUnJourUnClient.fdqteafacturer,2)
         		
         		
         		
         	CAS "Carrelage"
         		
         		//		SI lLivraison ALORS
         		//			totalpage +=  Arrondi(RequeteDetailUnJourUnClient.fdcarrprixtotal+RequeteDetailUnJourUnClient.fTotalPeinture,2)
         		//			
         		//			totalfacture +=  Arrondi((RequeteDetailUnJourUnClient.frcarrprixu + RequeteDetailUnJourUnClient.fdcarrprixdebase)* RequeteDetailUnJourUnClient.fdqteafacturer,2)...
         		//			+Arrondi(((RequeteDetailUnJourUnClient.Ftotalcarreaupeinture*RequeteDetailUnJourUnClient.fPrixCarreauPeinture)...
         		//			+(RequeteDetailUnJourUnClient.FDnbcarreauPeinture1*RequeteDetailUnJourUnClient.fdprixcarreaupeinture1))...
         		//			* RequeteDetailUnJourUnClient.fdqteafacturer ,2)
         		//			
         		//			totalcarrelage+=(RequeteDetailUnJourUnClient.fdqteafacturer+RequeteDetailUnJourUnClient.fdqtedejafacture) * RequeteDetailUnJourUnClient.fdcarreauh * RequeteDetailUnJourUnClient.fdcarreauv
         		//			RequeteBonLivraisonFacture.pNoCommande = RequeteDetailUnJourUnClient.fdnocomm
         		//			RequeteBonLivraisonFacture.pNoLigne = RequeteDetailUnJourUnClient.fdligne
         		//			SI HExécuteRequête(RequeteBonLivraisonFacture) ALORS
         		//				POUR TOUT RequeteBonLivraisonFacture 
         		//					totalcarrelage -= RequeteBonLivraisonFacture.totalCarreau
         		//				FIN
         		//			FIN
         		//		fin
         FIN
         
         
         
         
         
         
         
         
         
         
         
         
