    properties :
     y : 97.106
     width : 269.4
     height : 5.02799999999999
    code_elements :
     type_code : 30
     p_codes :
      -
        code : |1+
         
         
         
         
         //************************** ancien code ******************************
         
         //j est un entier
         //indicecarr est un entier
         //carrtrouve est un booleen = faux
         //si RequeteBlEtat.ftype = 4 alors
         //	corps..visible = faux
         //sinon
         //	si requetebletat.ftype = 2 et pas requetebletat.fdverreunite alors
         //		corps..visible = vrai
         //
         //		si anciennumcommande <> RequeteBlEtat.fdnocomm alors
         //
         //			si pas anciennumcommande = 0 alors
         //				si dimensiontableaucarrelage <> 0 alors
         //					pour j = 1 a dimensiontableaucarrelage
         //						numprodcarr   = tableaucarrelage[j,1]
         //						qtecarr       = "" //tableaucarrelage[j,2]
         //						desccarr      = tableaucarrelage[j,3]
         //						calculligne++
         //						iimprimebloc(ITERATION1)
         //					fin
         //					dimension(tableaucarrelage,0,5)
         //					dimensiontableaucarrelage = 0
         //				fin		
         //				calculligne++
         //				iimprimebloc(ITERATION2)
         //			fin
         //			anciennumcommande = RequeteBlEtat.fdnocomm
         //		FIN
         //	SINON	
         //		corps..visible = vrai
         //		si anciennumcommande <> RequeteBlEtat.fdnocomm alors
         //
         //			si pas anciennumcommande = 0 alors
         //				si dimensiontableaucarrelage <> 0 alors
         //					pour j = 1 a dimensiontableaucarrelage
         //						numprodcarr   = tableaucarrelage[j,1]
         //						qtecarr       = "" //tableaucarrelage[j,2]
         //						desccarr      = tableaucarrelage[j,3]
         //						calculligne++
         //						iimprimebloc(ITERATION1)
         //					fin
         //					dimension(tableaucarrelage,0,5)
         //					dimensiontableaucarrelage = 0
         //				fin		
         //				calculligne++
         //				iimprimebloc(ITERATION2)
         //			fin
         //			anciennumcommande = RequeteBlEtat.fdnocomm
         //		fin
         //	FIN
         //	si RequeteBlEtat.fdcarrelage alors
         //		pour j = 1 a dimensiontableaucarrelage
         //			si tableaucarrelage[j,1] = requetebletat.fdnumcarr alors
         //				indicecarr = j
         //				carrtrouve = vrai
         //			FIN
         //		fin
         //		si carrtrouve alors
         //			tableaucarrelage[indicecarr,2]=numeriqueverschaine(val(tableaucarrelage[indicecarr,2])+(requetebletat.fdqte...
         //			* requetebletat.fdcarreauh * requetebletat.fdcarreauv))
         //
         //			tableaucarrelage[indicecarr,4]=numeriqueverschaine(val(tableaucarrelage[indicecarr,4])+(requetebletat.fdqteafacturer * ...
         //			requetebletat.fdcarreauh * requetebletat.fdcarreauv))
         //			tableaucarrelage[indicecarr,5]=numeriqueverschaine(val(tableaucarrelage[indicecarr,5])+((requetebletat.fdqte-requetebletat.fdqteafacturer)*...
         //			requetebletat.fdcarreauh * requetebletat.fdcarreauv))
         //
         //
         //
         //		sinon
         //			dimensiontableaucarrelage++
         //			dimension(tableaucarrelage,dimensiontableaucarrelage,5)
         //			tableaucarrelage[dimensiontableaucarrelage,1] = requetebletat.fdnumcarr
         //			hlitrecherche(invent,INUM,requetebletat.fdnumcarr)
         //			si htrouve(invent) alors
         //				tableaucarrelage[dimensiontableaucarrelage,3] = invent.IDESC
         //			FIN
         //			tableaucarrelage[dimensiontableaucarrelage,2]=numeriqueverschaine(requetebletat.fdqte * ...	
         //			requetebletat.fdcarreauh * requetebletat.fdcarreauv)
         //
         //			tableaucarrelage[dimensiontableaucarrelage,4]=numeriqueverschaine(requetebletat.fdqteafacturer* ...
         //			requetebletat.fdcarreauh * requetebletat.fdcarreauv)
         //			tableaucarrelage[dimensiontableaucarrelage,5]=numeriqueverschaine((requetebletat.fdqte-requetebletat.fdqteafacturer) * ...
         //			requetebletat.fdcarreauh * requetebletat.fdcarreauv)
         //
         //
         //
         //		fin
         //	FIN
         //	calculligne++
         //fin
         //
         
         
         ////************** Nouveau code ***************************
         j est un entier
         indicecarr est un entier
         carrtrouve est un booleen = faux
         si RequeteBlEtat.ftype = 4 alors
         	corps..visible = faux
         sinon
         	si requetebletat.ftype = 2 et pas requetebletat.fdverreunite alors
         		corps..visible = vrai
         
         		si anciennumcommande <> RequeteBlEtat.fdnocomm   alors
         
         
         			si dimensiontableaucarrelage <> 0 alors
         				pour j = 1 a 1
         					numprodcarr   = tableaucarrelage[j,1]
         					qtecarr       = "" //tableaucarrelage[j,2]
         					desccarr      = tableaucarrelage[j,3]
         					calculligne++
         					iimprimebloc(ITERATION1)
         				fin
         				dimension(tableaucarrelage,0,5)
         				dimensiontableaucarrelage = 0
         			fin		
         			si anciennumcommande <> RequeteBlEtat.fdnocomm ALORS
         				anciennumcommande = RequeteBlEtat.fdnocomm
         				AncienNumCarrelage = ""
         				si pas ldebut alors
         					calculligne++
         					iimprimebloc(ITERATION2)
         				sinon
         					ldebut = faux
         				FIN
         			fin
         		FIN
         
         	SINON
         		corps..visible = vrai
         		si RequeteBlEtat.facalcul = 1 alors
         			largeurmet = arrondi(val(RequeteBlEtat.fdlargeur) * 25.4)
         			hauteurmet = arrondi(val(RequeteBlEtat.fdhauteur) * 25.4)
         
         		sinon
         			largeurmet = ""
         			hauteurmet = ""
         
         		fin
         
         
         		si anciennumcommande <> RequeteBlEtat.fdnocomm  alors
         
         			si dimensiontableaucarrelage <> 0 alors
         				pour j = 1 a 1
         					numprodcarr   = tableaucarrelage[j,1]
         					qtecarr       = "" //tableaucarrelage[j,2]
         					desccarr      = tableaucarrelage[j,3]
         					calculligne++
         					iimprimebloc(ITERATION1)
         				fin
         				dimension(tableaucarrelage,0,5)
         				dimensiontableaucarrelage = 0
         			fin		
         			si anciennumcommande <> RequeteBlEtat.fdnocomm ALORS  
         				anciennumcommande = RequeteBlEtat.fdnocomm
         				AncienNumCarrelage = ""
         				si pas ldebut alors
         					calculligne++
         					iimprimebloc(ITERATION2)
         				sinon
         					ldebut = faux
         				FIN
         			FIN
         		FIN
         
         
         	FIN
         
         	si RequeteBlEtat.fdcarrelage alors
         		si AncienNumCarrelage <> RequeteBlEtat.fdnumcarr alors
         			si pas AncienNumCarrelage = "" alors 
         				si dimensiontableaucarrelage <> 0 alors
         					pour j = 1 a 1
         						numprodcarr   = tableaucarrelage[j,1]
         						qtecarr       = "" //tableaucarrelage[j,2]
         						desccarr      = tableaucarrelage[j,3]
         						calculligne++
         						iimprimebloc(ITERATION1)
         					fin
         					dimension(tableaucarrelage,0,5)
         					dimensiontableaucarrelage = 0
         				fin		
         			fin
         
         			AncienNumCarrelage = RequeteBlEtat.fdnumcarr
         
         
         		fin
         		pour j = 1 a dimensiontableaucarrelage
         			si tableaucarrelage[j,1] = requetebletat.fdnumcarr alors
         				indicecarr = j
         				carrtrouve = vrai
         			FIN
         		fin
         		si carrtrouve alors
         			//			tableaucarrelage[indicecarr,2]=numeriqueverschaine(val(tableaucarrelage[indicecarr,2])+(requetebletat.fdqte...
         			//			* requetebletat.fdcarreauh * requetebletat.fdcarreauv))
         			//			tableaucarrelage[indicecarr,4]=numeriqueverschaine(val(tableaucarrelage[indicecarr,4])+(requetebletat.fdqteafacturer * ...
         			//			requetebletat.fdcarreauh * requetebletat.fdcarreauv))
         			//			tableaucarrelage[indicecarr,5]=numeriqueverschaine(val(tableaucarrelage[indicecarr,5])+((requetebletat.fdqte-requetebletat.fdqteafacturer)*...
         			//			requetebletat.fdcarreauh * requetebletat.fdcarreauv))
         
         			//  Pour avoir le nombre exact de carreau
         
         			tableaucarrelage[indicecarr,2]=numeriqueverschaine(val(tableaucarrelage[indicecarr,2])+(requetebletat.fdqte...
         			* requetebletat.fdnbcarreau))
         			tableaucarrelage[indicecarr,4]=numeriqueverschaine(val(tableaucarrelage[indicecarr,4])+(requetebletat.fdqteafacturer * ...
         			requetebletat.fdnbcarreau))
         			tableaucarrelage[indicecarr,5]=numeriqueverschaine(val(tableaucarrelage[indicecarr,5])+((requetebletat.fdqte-requetebletat.fdqteafacturer)*...
         			requetebletat.fdnbcarreau))
         
         
         		sinon
         			dimensiontableaucarrelage++
         			dimension(tableaucarrelage,dimensiontableaucarrelage,5)
         			tableaucarrelage[dimensiontableaucarrelage,1] = requetebletat.fdnumcarr
         			hlitrecherche(invent,INUM,requetebletat.fdnumcarr)
         			si htrouve(invent) alors
         				tableaucarrelage[dimensiontableaucarrelage,3] = invent.IDESC
         			FIN
         			//			tableaucarrelage[dimensiontableaucarrelage,2]=numeriqueverschaine(requetebletat.fdqte * ...	
         			//			requetebletat.fdcarreauh * requetebletat.fdcarreauv)
         			//			tableaucarrelage[dimensiontableaucarrelage,4]=numeriqueverschaine(requetebletat.fdqteafacturer* ...
         			//			requetebletat.fdcarreauh * requetebletat.fdcarreauv)
         			//			tableaucarrelage[dimensiontableaucarrelage,5]=numeriqueverschaine((requetebletat.fdqte-requetebletat.fdqteafacturer) * ...
         			//			requetebletat.fdcarreauh * requetebletat.fdcarreauv)
         
         			// Pour avoir le nombre exact de carreau
         
         			tableaucarrelage[dimensiontableaucarrelage,2]=numeriqueverschaine(requetebletat.fdqte * ...	
         			requetebletat.fdnbcarreau)
         			tableaucarrelage[dimensiontableaucarrelage,4]=numeriqueverschaine(requetebletat.fdqteafacturer* ...
         			requetebletat.fdnbcarreau)
         			tableaucarrelage[dimensiontableaucarrelage,5]=numeriqueverschaine((requetebletat.fdqte-requetebletat.fdqteafacturer) * ...
         			requetebletat.fdnbcarreau)
         
         		FIN
         	FIN
         	calculligne++
         fin
        type : 327692
      -
        code : |1+
         si RequeteBlEtat.ftype <> 4 alors
         	si RequeteBlEtat.ftype = 1 alors
         		CNombreThermos+=requetebletat.fdqteafacturer
         		CNombreThermostotal+=requetebletat.fdqteafacturer
         	fin
         	si pas sansespace(requetebletat.fnotes) = "" alors
         		calculligne++
         		iImprimeBloc(ITERATION3)
         	FIN
         	si pas sansespace(requetebletat.fnotes1) = "" alors
         		calculligne++
         		iImprimeBloc(ITERATION4)
         	FIN
         fin
         
        type : 327693
      -
        type : 327697
        enabled : false
