      -
        code : |1-
         //BAS_DE_PAGE..visible = faux
         
         j est un entier
         si dimensiontableaucarrelage <> 0 alors
         	pour j = 1 a dimensiontableaucarrelage
         		numprodcarr   = tableaucarrelage[j,1]
         		qtecarr       = ""//tableaucarrelage[j,2]
         		desccarr      = tableaucarrelage[j,3]
         		calculligne++
         		iimprimebloc(ITERATION1)
         	fin
         fin
         
         CNombreThermos1 = CNombreThermos
         
         FIN_DOCUMENT..visible = faux
         CnombreThermosTotal..Visible=vrai
         libelle1..Visible=vrai
        type : 327692
