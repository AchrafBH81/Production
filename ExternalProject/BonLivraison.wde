 controls : []
 code_elements :
  type_code : 13
  p_codes :
   -
     code : |1+
      tableaucarrelage est un tableau dynamique
      tableaucarrelage = allouer un tableau de 0 par 5 chaine
      dimensiontableaucarrelage est un entier = 0
      calculligne est un entier = 0
      AncienNumCommande est un entier = 99999999
      AncienNumCarrelage est une chaine = ""
      ldebut est un booleen = vrai
      
      hlit(config,1)
      
      
      
     type : 327680
  procedures :
   -
     name : Rupturefdcomm
     procedure_id : 4575749156434745613
     type_code : 14
     code : |1+
      Procédure Rupturefdcomm()
      
      iimprime("salut")
      
     type : 458752
   -
     name : assigneLibelle
     procedure_id : 5049969422256476757
     type_code : 14
     code : |1+
      Procédure assigneLibelle()
      i est un entier
      
      lTableauLibelle est un tableau de  30 chaines
      lTableauLibelle[1]  = "blentete"
      lTableauLibelle[2]  = "facpage"
      lTableauLibelle[3]  = "facpagede"
      lTableauLibelle[4]  = "blnobonlivraison"
      lTableauLibelle[5]  = "facdate"
      lTableauLibelle[6]  = "facnumcommande"
      lTableauLibelle[7]  = "facjobdetail"
      lTableauLibelle[8]  = "facquantite"
      lTableauLibelle[9]  = "faclargeur"
      lTableauLibelle[10] = "fachauteur"
      lTableauLibelle[11] = "facdescription"
      lTableauLibelle[12] = "facfini"
      lTableauLibelle[13] = "facspacer"
      lTableauLibelle[14] = "faccarrelage"
      lTableauLibelle[15] = "facrecupar"
      lTableauLibelle[16] = "facnumlot"
      lTableauLibelle[17] = "facnorack"
      
      
      selon client.CLangue
      	cas 0,1
      		pour i = 1 a 30
      			si hlitrecherche(Traduction,TRecherche,lTableauLibelle[i]) alors
      				{"bonlivraison."+lTableauLibelle[i]} = traduction.dFrancais
      			fin
      		FIN
      
      	cas 2
      		pour i = 1 a 30
      			si hlitrecherche(Traduction,TRecherche,lTableauLibelle[i]) alors
      				{"bonlivraison."+lTableauLibelle[i]} = traduction.danglais
      			fin
      		FIN
      fin
      
      bonlivraison.Facnumlot1 = bonlivraison.facnumlot
      bonlivraison.Facnumcommande1 = bonlivraison.facnumcommande
      bonlivraison.Facjobdetail1 = bonlivraison.Facjobdetail
      bonlivraison.Facquantite1 = bonlivraison.Facquantite
      bonlivraison.Faclargeur1 = bonlivraison.faclargeur
      bonlivraison.Fachauteur1 = bonlivraison.fachauteur
      bonlivraison.Facdescription1 = bonlivraison.Facdescription
      bonlivraison.Facfini1 = bonlivraison.facfini
      bonlivraison.Facspacer1 = bonlivraison.facspacer
      bonlivraison.Faccarrelage1 = bonlivraison.Faccarrelage
      bonlivraison.Facnorack1 = bonlivraison.Facnorack
      bonlivraison.blentete1 = bonlivraison.blentete
      bonlivraison.Facpage1 = bonlivraison.Facpage
      bonlivraison.Facpagede1 = bonlivraison.Facpagede
      bonlivraison.Blnobonlivraison1 = bonlivraison.Blnobonlivraison1
      bonlivraison.Facdate1 = bonlivraison.Facdate
      BonLivraison.Facrecupar1 = BonLivraison.Facrecupar
     type : 458752
   -
     name : convert_anglais
     procedure_id : 5262034308748806570
     type_code : 14
     code : |1+
      Procédure convert_anglais(variable,provenance = "")
      //variable est une chaine = moimeme
      hlitpremier("config","COCLEUNIK")
      longueur est un entier = taille(variable)
      position_espace est un entier = position(variable," ")
      //position_espace1 est un entier = position(variable," ",position_espace+1)
      resultat_gauche est une chaine  
      resultat_droit est une chaine        
      valeuraretourner est un reel
      si position_espace = 0 alors
      	si position(variable,"/") = 0 alors
      		resultat_gauche = ""
      	sinon
      		resultat_gauche = "0"
      	fin	
      sinon	
      
      	resultat_gauche = gauche(variable,position_espace-1)
      
      FIN
      
      si position_espace = 0 alors
      
      	resultat_droit = variable
      
      sinon	
      
      	resultat_droit = milieu(variable,position_espace +1, longueur - position_espace)
      
      FIN
      
      
      si pas position(resultat_droit,"/") = 0 alors
      	resultat_droit = memrecherche("tableau_metrique",resultat_droit)
      FIN
      
      
      
      
      
      
      	valeuraretourner = resultat_gauche+resultat_droit
      
      
      
      renvoyer valeuraretourner
      
     type : 458752
