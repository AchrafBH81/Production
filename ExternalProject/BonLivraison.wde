    properties :
     width : 269.4
     height : 61.649
    code_elements :
     type_code : 30
     p_codes :
      -
        code : |1+
         hlitrecherche(client,numero,requeteBletat.bclient)
         
         assigneLibelle()
         
         si requetebletat.idlivraison <> 0 alors
         	si hlitrecherche(ClientLivraison,IDClientLivraison,requetebletat.idlivraison) alors
         		nomclient2 = ClientLivraison.lNom
         		adresseclient1 = ClientLivraison.lRue
         		VilleClient1 = ClientLivraison.lVille+","+ClientLivraison.lprovince
         		CodePostalClient1 = ClientLivraison.lCodePostal	
         	FIN
         sinon
         	GrpLivreA..visible=faux	
         FIN
        type : 327692
      -
        type : 327697
        enabled : false
