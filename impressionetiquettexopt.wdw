  procedures :
   -
     name : impressiondirecte
     procedure_id : 4511921603965199641
     type_code : 14
     code : |1+
      Procédure impressiondirecte()
      reppourxopt est une chaine = sansespace(config.DossierOptimisation)
      numerodefichier est un entier = fouvre(reppourxopt+"\"+"etiq.asc",folecture)
      //uneligne est une chaine
      uneligne est une tableau de 9 chaine
      ligneclient est un entier = 3
      lignedecommande est un entier = 4
      ligneproduit est un entier = 1
      lignedimension est un entier = 5
      ligneposition est un entier = 7
      i est un entier
      findefichier est un booleen = faux
      port est une chaine = extraitchaine(inilit("Devices",imprimanteetiquette),2,",")
      portimp est un entier
      dimensionanglais est une chaine
      aveccap est un booleen = faux
      aveccarrelage est un booleen = faux
      job est une chaine
      argon est un booleen
      ligneaimprimer est une chaine
      Ref est une chaine
      low_e est un booleen
      surface est un booleen
      description est une chaine
      selon port
      
      cas "LPT1:"
         portimp = -1
      cas "LPT2:"
         portimp = -2
      cas "LPT3:"
         portimp = -3
      autres cas
      //   erreur(MessTraduit(2000))		  //2000:L'imprimante choisie pour les étiquettes n'est pas locale.Choisir une imprimante loc...
      //  renvoyer 0
      fin
      //Début du code généré par l'assistant de code de la fonction iParamètre
      
      
      //Ne sauvegarde pas les paramètres spécifiés
      
      //Qualité d'impression
      //iParamètre("QUALITE=BASSE")
      
      //Fin du code généré par l'assistant de code de la fonction iParamètre
      
      
      //	iimprimeetat("ETIQUETTE FORME 99 MASTER")
      
      souvre(portimp,100,100)
      sablier(vrai)
      si  numerodefichier <> - 1 alors
          //simprimeligne(portimp,caract(27)+caract(77))
          
          flitligne(numerodefichier)
      	
      	boucle
      		pour i  = 1 a 9
      			uneligne[i] = flitligne(numerodefichier)
      			si uneligne[i] = eot alors
      				findefichier = vrai
      				sortir
      			FIN
      			
      			
      		fin	
      		si findefichier alors
      		//	info("fin de fichier")
      		    sortir
      		FIN
             dimensionanglais = ""
      	   aveccap = faux
      	   aveccarrelage = faux
             si (milieu(uneligne[ligneclient],18,1)  = "L" ou impressionetiquettexopt.lowe ) alors
      		 low_e = vrai
             sinon
      		 low_e = faux
      		
             FIN
             si milieu(uneligne[ligneclient],19,1) = "A" alors
      		 argon = vrai
             sinon
      		 argon = FAUX
             FIN
             si (milieu(uneligne[ligneclient],20,1) = "S" ou impressionetiquettexopt.lowe ) alors
      		 surface = vrai
      	   sinon
      		 surface = faux
             FIN
      	   dimensionanglais = trouvelignecommande(milieu(uneligne[lignedecommande],2,6),milieu(uneligne[ligneclient],5,3) ) 
      	   aveccap = trouvelignecommande(milieu(uneligne[lignedecommande],2,6),milieu(uneligne[ligneclient],5,3) ,"Cap") 
             aveccarrelage = trouvelignecommande(milieu(uneligne[lignedecommande],2,6),milieu(uneligne[ligneclient],5,3) ,"Carrelage")
            // argon = trouvelignecommande(milieu(uneligne[lignedecommande],2,6),milieu(uneligne[ligneclient],5,3) ,"Argon")
             job = trouvelignecommande(milieu(uneligne[lignedecommande],2,6),milieu(uneligne[ligneclient],5,3) ,"Job")
      	   Ref = trouvelignecommande(milieu(uneligne[lignedecommande],2,6),milieu(uneligne[ligneclient],5,3) ,"Ref")
      	   description = trouvelignecommande(milieu(uneligne[lignedecommande],2,6),milieu(uneligne[ligneclient],5,3) ,"Desc")
      	  // low_e = trouvelignecommande(milieu(uneligne[lignedecommande],2,6),milieu(uneligne[ligneclient],5,3) ,"Lowe")
      	  // Surface = trouvelignecommande(milieu(uneligne[lignedecommande],2,6),milieu(uneligne[ligneclient],5,3) ,"Surface")
      	   si pas milieu(uneligne[ligneclient],2,7) = "Plateau" alors
      		simprimeligne(portimp,caract(27)+caract(77)) 
      		simprimeligne(portimp,gauche(trouvenomclient(milieu(uneligne[ligneclient],8,10)),28)+"  ")
              simprimeligne(portimp,droite(uneligne[ligneproduit],10)+rc)
      		
      		simprimeligne(portimp,milieu(uneligne[lignedecommande],2,6)+repete(" ",16))
      		simprimeligne(portimp,milieu(uneligne[ligneclient],26,15)+rc)
      		ligneaimprimer = ""
      		si aveccarrelage  alors
                    ligneaimprimer+="Carrelage"
      			  //  simprimeligne(portimp,"Carrelage"+rc)
      		sinon
      	            ligneaimprimer+="         "
      				//	simprimeligne(portimp,rc)
      		fin
              si pas job = "" alors
      		 ligneaimprimer+=repete(" ",14)+"Job:"+job
      		fin 
      		simprimeligne(portimp,ligneaimprimer+rc)
      //		simprimeligne(portimp,milieu(uneligne[ligneproduit],2,10)+ " "+milieu(uneligne[ligneproduit],12,17)+rc)
      //		simprimeligne(portimp,rc)
      		simprimeligne(portimp,milieu(uneligne[ligneproduit],2,9)+rc)
      		simprimeligne(portimp,milieu(uneligne[ligneproduit],11,1)+ milieu(uneligne[ligneproduit],12,8)+" "+description+rc)
      		simprimeligne(portimp,milieu(uneligne[ligneproduit],20,9)+rc)
              si aveccap = vrai alors
      		  simprimeligne(portimp,transformeligne(uneligne[lignedimension])+rc)
      		sinon
      		  simprimeligne(portimp,uneligne[lignedimension]+rc)
      	    fin
      		simprimeligne(portimp,repete(" ",15)+dimensionanglais+rc)
      		si milieu(uneligne[lignedecommande],8,1) = "F" alors
      			 simprimeligne(portimp,repete(" ",33)+"FORME"+rc)
      		sinon
      				simprimeligne(portimp,rc)
      		fin
      		SI low_e alors
      			simprimeligne(portimp,caract(27)+caract(14))
      			simprimeligne(portimp,"Low-e ")
      		sinon
      			simprimeligne(portimp,caract(27)+caract(14))
      			simprimeligne(portimp,"      ")
      		fin
      		si argon alors
      	       simprimeligne(portimp,"Argon"+rc)
      		sinon
            	simprimeligne(portimp,"     "+rc)
      					
      		FIN
      		si surface alors
      			simprimeligne(portimp,caract(27)+caract(14))
      			simprimeligne(portimp,"Surface intérieure"+rc)
      			simprimeligne(portimp,caract(20))
             sinon
      		simprimeligne(portimp,rc)
      			
      	    fin
      //		SI impressionetiquettexopt.lowe alors
      //			simprimeligne(portimp,caract(27)+caract(14))
      //			simprimeligne(portimp,"Low-e ")
      //			si argon alors
      //		       simprimeligne(portimp,"Argon"+rc)
      //		    sinon
      //      		simprimeligne(portimp,rc)
      //				
      //			FIN
      //			simprimeligne(portimp,caract(27)+caract(14))
      //			simprimeligne(portimp,"Surface intérieure"+rc)
      //			simprimeligne(portimp,caract(20)+rc)
      //       sinon
      //		simprimeligne(portimp,rc)
      //		simprimeligne(portimp,rc)
      			
      //	    fin
      //		simprimeligne(portimp,rc)
      		//simprimeligne(portimp,rc)
      		si pas sansespace(Ref) = "" alors
      		   simprimeligne(portimp," Ref: "+Ref+rc)
      	    sinon
      		  simprimeligne(portimp,rc)
      				
      		FIN
      		simprimeligne(portimp,uneligne[ligneposition])
      		simprimeligne(portimp,rc)
      		simprimeligne(portimp,rc)
      		simprimeligne(portimp,rc)
             sinon
              simprimeligne(portimp,rc)
              simprimeligne(portimp,rc)
              simprimeligne(portimp,rc)
              simprimeligne(portimp,rc)
              simprimeligne(portimp,milieu(uneligne[ligneclient],2,7)+" "+milieu(uneligne[ligneclient],10,20)+rc)
              simprimeligne(portimp,rc)
              simprimeligne(portimp,rc)
      		simprimeligne(portimp,uneligne[lignedecommande]+rc)
              simprimeligne(portimp,rc)
              simprimeligne(portimp,rc)
      		simprimeligne(portimp,uneligne[lignedimension]+rc)
              simprimeligne(portimp,rc)
              simprimeligne(portimp,rc)
              simprimeligne(portimp,rc)
              simprimeligne(portimp,rc)
      		
      		
      	   fin	
      	//	ifinimprime
      		//info("|"+uneligne[ligneclient]+"|")
      		//info("|"+uneligne[lignedecommande]+"|")
      		//info("|"+uneligne[ligneproduit]+"|")
      		//info("|"+uneligne[lignedimension]+"|")
      		//info("|"+uneligne[ligneposition]+"|")
      //		sablier(faux)
      
      	fin
              simprimeligne(portimp,rc)
              simprimeligne(portimp,rc)
              simprimeligne(portimp,rc)
              simprimeligne(portimp,rc)
              simprimeligne(portimp,rc)
              simprimeligne(portimp,rc)
      		simprimeligne(portimp,caract(27)+caract(14)+"       G E O N"+rc)
      //		simprimeligne(portimp,caract(18)+rc)
              simprimeligne(portimp,rc)
              simprimeligne(portimp,rc)
              simprimeligne(portimp,rc)
              simprimeligne(portimp,rc)
              simprimeligne(portimp,rc)
              simprimeligne(portimp,rc)
              simprimeligne(portimp,rc)
              simprimeligne(portimp,rc)
      
      
      FIN
      sablier(faux)
      SIMPRIMELIGNE(portimp,CARACT(27)+CARACT(77))
      sferme(portimp)
      fferme(numerodefichier)
      
     type : 458752
   -
     name : simprimeligne
     procedure_id : 4511921604334560917
     type_code : 14
     code : |1+
      Procédure simprimeligne(portimp,sligne)
      
      
      secrit(portimp,ansiversoem(sligne))
      
     type : 458752
   -
     name : transformeligne
     procedure_id : 4511921604471596693
     type_code : 14
     code : |1+
      Procédure transformeligne(ligneamodifier)
      valeuraretourner est une chaine = ligneamodifier
      
      souschaine est une chaine
      souschainemodifie est une chaine
      souschaine = milieu(ligneamodifier,15,6)
      souschainemodifie = numeriqueverschaine(val(souschaine)+4,"6d")
      valeuraretourner = remplace(valeuraretourner,souschaine,souschainemodifie)
      
      souschaine = milieu(ligneamodifier,23,6)
      souschainemodifie = numeriqueverschaine(val(souschaine)+4,"6d")
      
      valeuraretourner = remplace(valeuraretourner,souschaine,souschainemodifie)
      
      
      renvoyer valeuraretourner
      
     type : 458752
   -
     name : trouvelignecommande
     procedure_id : 4511921604300351155
     type_code : 14
     code : |1+
      Procédure trouvelignecommande(numerocommande,numeroligne,type = "")
      valeuraretourner est une chaine = ""
      clederecherche est une chaine
      commandeconverti est une chaine
      ligneconverti est une chaine
      hconvertl(commandeconverti,val(numerocommande))
      hconvertl(ligneconverti,val(numeroligne))
      clederecherche = commandeconverti+ligneconverti
      hlitrecherche("tempo","clecommandeligne",clederecherche)
      //hlitrecherche("tempo","clecommandeligne",val(numerocommande)+val(numeroligne))
      
      //Code WinDev 5.5 remplacé par la migration :
      //si pas h.endehors alors
      si pas HEnDehors() alors
      //Code WinDev 5.5 remplacé par la migration :
      //	si h.trouve alors
      	si HTrouve() alors
      		selon type
      		cas  "Cap" 
      			si pas position(tempo.tcapgaztube,"C") = 0 alors
      				
      				valeuraretourner = vrai
      			sinon   
      				valeuraretourner = faux
      			fin   
      		cas  "Argon" 
      			si pas position(tempo.tcapgaztube,"Z") = 0 aLORS
      				
      				valeuraretourner = vrai
      			sinon   
      				valeuraretourner = faux
      			fin   
      		cas "Carrelage"
      			si tempo.tcarrelage alors
      				valeuraretourner = vrai
      			sinon
      				valeuraretourner = faux	
      			FIN
      		cas "Job"
      			valeuraretourner = sansespace(tempo.tjob)
      		cas "Ref"
      			valeuraretourner = gauche(sansespace(tempo.tjobligne),29)
      		cas "Desc"
      			valeuraretourner = gauche(sansespace(tempo.tdescription),28)
      		cas "Lowe"
      			valeuraretourner = tempo.tienergiverre
      		cas "Surface"
      			valeuraretourner = tempo.tsurfaceinterieure
      		autres cas
      			si tempo.ttype = "1" alors
      				valeuraretourner = sansespace(tempo.tlargeura) + "  X  " + tempo.thauteura
      			fin
      		fin   
      		
