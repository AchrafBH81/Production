  -
    name : BTN_OK
    identifier : 0x3e9d90cb1672a478
    internal_properties : 
    properties :
     x : 359
     y : 89
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         reppourxopt est une chaine = sansespace(config.DossierOptimisation)
         lefichier est une chaine = reppourxopt+"\etiq.asc"
         numerodefichier est un entier = fouvre(reppourxopt+"\"+"etiq.asc",folecture)
         //uneligne est une chaine
         uneligne est une tableau de 9 chaine
         ligneclient est un entier = 3
         lignedecommande est un entier = 4
         ligneproduit est un entier = 1
         lignedimension est un entier = 5
         ligneposition est un entier = 7
         i est un entier
         findefichier est un booleen = faux
         
         
         
         
         
         
         
         
         
         
         si destination = 2 alors
         
         //iconfigure(sansespace(imprimanteetiquette),vrai)
         //iparametre("FORMATPAPIER = DEFINIUTILISATEUR")
         //iparametre("HAUTEURPAGE = 635")
         //iparametre("LARGEURPAGE = 1020")
         iconfigure(sansespace(imprimanteetiquette),vrai)
         
         iParamètre("DEFAUT=NON")
         iparametre("FORMATPAPIER = DEFINIUTILISATEUR")
         iparametre("HAUTEURPAGE = 635")
         iparametre("LARGEURPAGE = 1020")
         
         //	iimprimeetat("ETIQUETTE FORME 99 MASTER")
         
         
         
         si  numerodefichier <> - 1 alors
             flitligne(numerodefichier)
         	
         	boucle
         		si destination = 2 alors
         			iapercu(75,"Etiquette après optimisation",faux)
         			//	iapercu(50,"Etiquettes")
         		fin
                  si destination = 1 alors
         			sablier(vrai)
                  fin
         		ifenetreabandon(faux)
         //        iCreePolice(1,10,iNormal,"Courier",iNoir,0)
         		iCreePolice(1,11,iNormal,"Times New Roman",iNoir,0)
         		iCreePolice(2,18,inormal+iitalique,"Times New Roman",iNoir,0)
         		iCreePolice(3,20,inormal,"Times New Roman",iNoir,0)
         		
         		
         		pour i  = 1 a 9
         			uneligne[i] = flitligne(numerodefichier)
         			si uneligne[i] = eot alors
         				findefichier = vrai
         				sortir
         			FIN
         			
         			
         		fin	
         		si findefichier alors
         		//	info("fin de fichier")
         		    sortir
         		FIN
         	    
                si pas milieu(uneligne[ligneclient],2,7) = "Plateau" alors
         		iimprimemot(ipolice(1)+gauche(trouvenomclient(milieu(uneligne[ligneclient],8,10)),28))
         //Code WinDev 5.5 remplacé par la migration :
         //		iimprime(IPOSH(60)+droite(uneligne[ligneproduit],10))
         		iimprime(iPosX(60)+droite(uneligne[ligneproduit],10))
         		iimprimemot(milieu(uneligne[lignedecommande],2,6)+repete(" ",16))
         //Code WinDev 5.5 remplacé par la migration :
         //		iimprime(iposh(54)+milieu(uneligne[ligneclient],26,15))
         		iimprime(iPosX(54)+milieu(uneligne[ligneclient],26,15))
         		isauteligne
         //Code WinDev 5.5 remplacé par la migration :
         //		iimprime(IPOSV(IPOSV()-3)+iposh(5)+milieu(uneligne[ligneproduit],2,27))
         		iimprime(iPosY(iPosY()-3)+iPosX(5)+milieu(uneligne[ligneproduit],2,27))
         		isauteligne
         //Code WinDev 5.5 remplacé par la migration :
         //		iimprime(IPOSV(IPOSV()-3)+uneligne[lignedimension])
         		iimprime(iPosY(iPosY()-3)+uneligne[lignedimension])
         		iimprime(trouvelignecommande(milieu(uneligne[lignedecommande],2,6),milieu(uneligne[ligneclient],5,3)))
         //		isauteligne
         		isauteligne
         		SI impressionetiquettexopt.lowe alors
         			iimprime(ipolice(2)+"low-e argon")
         			iimprime("surface intérieure")
         		fin
         		
         //Code WinDev 5.5 remplacé par la migration :
         //		iimprime(ipolice(1)+IPOSV(46)+uneligne[ligneposition])
         		iimprime(ipolice(1)+iPosY(46)+uneligne[ligneposition])
                sinon
                 isauteligne
         		iimprime(ipolice(1)+milieu(uneligne[ligneclient],2,7)+" "+milieu(uneligne[ligneclient],10,20))
                 isauteligne
                 isauteligne
         		iimprime(uneligne[lignedecommande])
                 isauteligne
                 isauteligne
         		iimprime(uneligne[lignedimension])
         		
         		
         	   fin	
         		ifinimprime
         		//info("|"+uneligne[ligneclient]+"|")
         		//info("|"+uneligne[lignedecommande]+"|")
         		//info("|"+uneligne[ligneproduit]+"|")
         		//info("|"+uneligne[lignedimension]+"|")
         		//info("|"+uneligne[ligneposition]+"|")
         		sablier(faux)
         
         	fin
         //Code WinDev 5.5 remplacé par la migration :
         //			iimprime(ipolice(3)+iposv(32)+iposh(15)+ipolice(3)+"G E O N ")
         			iimprime(ipolice(3)+iPosY(32)+iPosX(15)+ipolice(3)+"G E O N ")
                     ifenetreabandon(faux)
          			ifinimprime
         
         FIN
         // 			ifinimprime
         sablier(faux)
         sinon
          impressiondirecte()
         fin	 
         //info("fermeture de fichier")
         multitache(50)
         fferme(numerodefichier)
         
        type : 18
      -
        type : 161
        enabled : false
