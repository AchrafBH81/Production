 message_bar :
  internal_properties : CQAAAAkAAAAjFWXItEk/EPvcbGR+hALkgRfdOpVtIn+yZNxHnmSRFJegE/AnD2HbGAaMfhGCqfzkryHG9FVhjtF+iQYkZ59QBQ88Okhh0vjCoVhOagox2hvIqrJnU30QK15/ZA==
 actionbar : {}
 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1+
      PROCEDURE MaFenêtre(gsFileName est une chaine)
      
      gnId est un entier = fouvre(gsfilename)
      gsLigneLue est une chaîne
      
      gsProd est une chaine
      gsDim est une chaine
      gsFini est une chaine
      gsSpacer est une chaîne
      gsCarrelage est une chaine
      gsMessage est une chaine
      
      
   -
     code : |1+
      gslignelue = fLitLigne(gnid)
      LIB_Commande = extraitchaine(gsLigneLue,2,"|")
      gsLigneLue = fLitLigne(gnId)
      tantque gsLigneLue <> EOT
      	
      	gsProd = SansEspace(ExtraitChaîne(gsLigneLue,5,"|")) + " X " + SansEspace(ExtraitChaîne(gsLigneLue,9,"|"))
      	gsdim = SansEspace(ExtraitChaîne(gsLigneLue,6,"|")) + " X " + SansEspace(ExtraitChaîne(gsLigneLue,7,"|"))
      	gsfini = SansEspace(ExtraitChaîne(gsLigneLue,8,"|"))
      	gsspacer = SansEspace(ExtraitChaîne(gsLigneLue,10,"|"))
      	si SansEspace(ExtraitChaîne(gsLigneLue,11,"|")) <> "" alors
      		gscarrelage = SansEspace(ExtraitChaîne(gsLigneLue,11,"|")) + " "+SansEspace(ExtraitChaîne(gsLigneLue,12,"|")) + " X " + SansEspace(ExtraitChaîne(gsLigneLue,13,"|"))
      	sinon
      	   gscarrelage = ""
      	fin
      	gsmessage = SansEspace(ExtraitChaîne(gsLigneLue,21,"|"))+[rc]+SansEspace(ExtraitChaîne(gsLigneLue,22,"|"))
      	
      	tableajouteligne(TABLE_Visu,gsprod,gsdim,gsfini,gsspacer,gscarrelage,gsmessage)
      	gslignelue = flitligne(gnId)
      	
      FIN
      
     type : 34
