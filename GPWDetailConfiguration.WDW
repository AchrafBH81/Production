  -
    name : Supprimer
    identifier : 0x23f2ef650886ec4f
    internal_properties : 
    properties :
     x : 384
     y : 73
     width : 80
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         // si ce n'est pas la configuration par défaut
         si ComboConfiguration<>gpwdefaut alors
         	// demande de confirmation
         	nRes est un entier=confirmer(<§$0001§>)
         
         	// positionnement sur l'enregistrement
         	HLitRecherchePremier("GPWConfiguration","Configuration",ComboConfiguration)
         
         	// selon le résultat de la confirmation
         	selon nRes
         		// annulation
         		cas annuler : retour
         
         		// suppression des configurations uniquement
         		cas non :
         			// il faut supprimer la configuration aux utilisateurs qui ont cette configuration
         			si pas bModifieConfigurationUtilisateur(GPWConfiguration.Configuration) ALORS retour
         		
         		// suppression des utilisateurs
         		cas oui :
         			si pas bSupprimeUtilisateur() alors retour
         	FIN
         	
         	// suppression de l'enregistrement
         	si pas hsupprime("GPWConfiguration") ALORS
         		erreur(<§$0000§>+rc+HErreurInfo())
         		retour
         	FIN
         	// rafraichissement de la combo
         	InitComboConfiguration()
         
         	// si il n'y a plus de configuration, ferme la fenêtre
         	si ListeOccurrence(ComboConfiguration)=0 alors ferme
         
         	// sélection de la première ligne
         	listeselectplus(ComboConfiguration,1)
         
         	// rafraichissement de la fenêtre
         	rafraichissement()
         FIN
        type : 18
      -
        type : 161
        enabled : false
