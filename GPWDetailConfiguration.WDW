 menu :
  name : _Menu
  identifier : 0x23f2ef650892ec4f
  internal_properties : 
  options : []
 languages :
  - fr-FR
 popup_menus : []
 message_bar :
  internal_properties : CQAAAAkAAAAL/hH/gcEXeKbQCJHSY3i1zlVEGVYDTkQ3sB8SKJsqxB4VaVyegJR8wXnigrCZ66HKj4FL1X35KdXjjYCYLQhE9MsfvX2Xhf5Xh3/568Xf5H2uydmNQ+RLTw3W78q9aPs=
 actionbar : {}
 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1+
      // Paramètrage des configurations
      // Entrée:	sConfiguration	nom de la configuration
      procedure GPWConfigurationElement(sConfiguration="")
      
      //-----------------------------------------------
      GPWUtilisateur est une source de données
      GPWUtilisateurConfiguration est une source de données
      GPWConfiguration est une source de données
      GPWConfigurationElement est une source de données
      GPWElement est une source de données
      //-----------------------------------------------
      
      constante
      	TypFenetreInterneSource = 32
      FIN
      
      // constantes correspondants aux différents filtres d'éléments
      constantE
      	eTOUS 			= 1
      	eGROUPE			= 2
      	eMENU 			= 3 
      	eMENUCONTEXTUEL = 4
      	eBOUTON 		= 5
      	eSAISIE 		= 6
      	eLIBELLE 		= 7
      	eLISTE 			= 8
      	eBOITEOUTILS	= 9
      	eCOMBO 			= 10
      	eSELECTEUR 		= 11
      	eINTERRUPTEUR	= 12
      	eTABLE 			= 13
      	eBARREOUTILS	= 14
      	eIMAGE 			= 15
      	eONGLET 		= 16
      	eVOLET 			= 17
      	eSUPERCHAMP		= 18
      	eAUTRE 			= 19
      FIN
   -
     code : |1+
      // remplit la combo
      InitComboConfiguration()
      
      // sélection de la bonne configuration
      SelectConfiguration()
      
      // rafraichissement de la fenêtre
      Rafraichissement()
     type : 34
   -
     type : 180
     enabled : false
   -
     type : 230
     enabled : false
   -
     type : 11
   -
     type : 12
   -
     type : 17
   -
     type : 13
  procedures :
   -
     name : Rafraichissement
     procedure_id : 1437474448160844879
     type_code : 14
     code : |1+
      // Rafraichissement de la fenêtre en fonction de la sélection de la fenêtre et de la configuration
      Procédure Rafraichissement()
      
      // propose d'activer les options du menu "?"
      si Fenetre[Fenetre]="FI_MenuHWinDevHelp" alors
      	si ListeOccurrence(ColEtat)<>5
      		listeAjoute(ColEtat,<§$000c§>)
      	fin
      sinon si ListeOccurrence(ColEtat)=5 ALORS
      	listeSupprime(ColEtat,5)
      fin
      
      // vide la table
      TableSupprimeTout(EtatObjet)
      
      // filtre le fichier de configiguration des éléments
      hfiltre("GPWConfigurationElement","Configuration",Comboconfiguration)
      
      // selon la sélection dans la liste
      // il faut remplir correctement
      selon type
      	cas eTOUS : RemplirTous(Fenetre[Fenetre])
      	cas eGROUPE : Remplirparent(Fenetre[Fenetre],typGrp)
      	cas eMENU : RemplirMenu(Fenetre[Fenetre])
      	cas eMENUCONTEXTUEL : RemplirMenuContextuel(Fenetre[Fenetre])
      	cas eBOUTON : RemplirElement(Fenetre[Fenetre],typBouton)
      	cas eSAISIE : RemplirSaisie(Fenetre[Fenetre])
      	cas eLIBELLE : RemplirElement(Fenetre[Fenetre],typLibellé)
      	cas eLISTE : RemplirElement(Fenetre[Fenetre],typListe)
      	cas eCOMBO : RemplirCombo(Fenetre[Fenetre])
      	cas eSELECTEUR : RemplirElement(Fenetre[Fenetre],typSélect)
      	cas eINTERRUPTEUR : RemplirElement(Fenetre[Fenetre],typInterr)
      	cas eTABLE : RemplirElement(Fenetre[Fenetre],typTable)
      	cas eBARREOUTILS : RemplirElement(Fenetre[Fenetre],typBarreOutils)
      	cas eIMAGE : RemplirImage(Fenetre[Fenetre])
      	cas eONGLET : Remplirparent(Fenetre[Fenetre],typOnglet)
      	cas eVOLET : RemplirVolet(Fenetre[Fenetre])
      	CAS eSUPERCHAMP : RemplirParent(Fenetre[Fenetre],typSuperChamp)
      	cas eAUTRE : RemplirAutre(Fenetre[Fenetre])
      	cas eBOITEOUTILS : Remplirparent(Fenetre[Fenetre],typBoîteAOutils)
      FIN
     type : 458752
   -
     name : RemplirTous
     procedure_id : 1437474448160910415
     type_code : 14
     code : |1+
      // Remplit la table avec tous les champs de la fenêtre
      // Entrée:	sParent		Nom de l'élément parent
      Procédure RemplirTous(sParent)
      
      // Premier champ de la fenêtre
      sNomChamp est une chaîne=Enuméresouselement(sParent,enumPremier)
      TANTQUE sNomChamp<>""
      
      	// nom complet du champ
      	sNomComplet est une chaine=sParent+"."+sNomChamp
      	// récupération du type de l'élément
      	nType est un entier={sNomComplet,indgpw}..Type
      	
      	// si c'est un groupe de champs ou un onglet
      	si nType=typOnglet ou nType=typtable ou nType=typBarreOutils ou nType=typBoîteAOutils OU nType=typSuperChamp ou nType=TypFenetreInterneSource ALORS
      		// énumération des champs qui sont à l'interieur
      		remplirTous(sNomComplet)
      	sinon
      		// ne fait rien si c'est une option de menu
      		si nType<>typOptionMenu ALORS
      			// ajout de l'élément dans la table
      			AjouteElement(sNomComplet,nType,{sNomComplet,indgpw}..libelle,{sNomComplet,indgpw}..groupe)
      		FIN
      	FIN
      
      	// Champ suivant
      	sNomChamp=Enuméresouselement(sParent)
      FIN
      
      
     type : 458752
   -
     name : RemplirMenu
     procedure_id : 1437474448160975951
     type_code : 14
     code : |1+
      Procédure RemplirMenu(sParent, nNiveau est un entier = 0)
      	
      // énumération des options de menu
      sOption est une chaine=EnumèreSousElément(sParent,enumpremier+enumMenuPrincipal)
      
      // il ne faut pas mettre le nom du menu
      si nNiveau=0 et sOption<>"" alors
      	RemplirMenu(sParent+"."+sOption, nNiveau + 1)
      	retour
      FIN
      
      tantque sOption<>""
      	
      	// nom complet de l'option de menu
      	sNomComplet est une chaine=sParent+"."+sOption
      	
      	// ajoute l'option de menu
      	si {sNomComplet,indgpw}..type=typOptionMenu ALORS
      		ajouteelement(sNomComplet,typOptionMenu,{sNomComplet,indgpw}..libelle,"", nNiveau)
      	FIN
      	
      	// remplit les options du niveau supérieur
      	RemplirMenu(sNomComplet, nNiveau + 1)
      	
      	// option suivante
      	sOption=EnumèreSousElément(sParent)
      FIN
     type : 458752
   -
     name : RemplirSaisie
     procedure_id : 1437474448161041487
     type_code : 14
     code : |1+
      // Remplit la table avec les champs de saisie de la fenêtre
      // Entrée:	sParent		Nom de l'élément parent
      Procédure RemplirSaisie(sParent)
      
      // Premier champ de la fenêtre
      sNomChamp est une chaîne=EnumèreSousElément(sParent,enumPremier) 
      TANTQUE sNomChamp<>""
      
      	// nom complet du champ
      	sNomComplet est une chaine=sParent+"."+sNomChamp
      
      	// selon le type du champ
      	selon {sNomComplet,indgpw}..Type
      		// champs de saisie
      		cas  typTexte,...
      			 typNum,...
      			 typHeure,...
      			 typDate,...
      			 typMonétaire :
      				AjouteElement(sNomComplet,{sNomComplet,indgpw}..Type,{sNomComplet,indgpw}..libelle,{sNomComplet,indgpw}..groupe)
      
      		// groupe, onglet, table, menu contextuel
      		cas typOnglet, typtable, typBarreOutils, typBoîteAOutils, typOptionMenu, typSuperChamp, TypFenetreInterneSource : remplirSaisie(sNomComplet)
      	FIN
      
      	// Champ suivant
      	sNomChamp=EnumèreSousElément(sParent)
      FIN
      
     type : 458752
   -
     name : RemplirCombo
     procedure_id : 1437474448161107023
     type_code : 14
     code : |1+
      // Remplit la table avec les combos de la fenêtre
      // Entrée:	sParent		Nom de l'élément parent
      Procédure RemplirCombo(sParent)
      
      // Premier champ de la fenêtre
      sNomChamp est une chaîne=EnumèreSousElément(sParent,enumpremier) 
      TANTQUE sNomChamp<>""
      
      	// nom complet du champ
      	sNomComplet est une chaine=sParent+"."+sNomChamp
      	// type de l'élément
      	nType est une entier = {sNomComplet,indgpw}..Type
      
      	// selon le type du champ
      	selon nType
      		// Liste
      		cas typComboAVS, typComboSNS : AjouteElement(sNomComplet,nType,{sNomComplet,indgpw}..libelle,{sNomComplet,indgpw}..groupe)
      		// onglet, table, menu contextuel
      		cas typOnglet, typTable, typBarreOutils, typBoîteAOutils, typOptionMenu, typSuperChamp, TypFenetreInterneSource : RemplirCombo(sNomComplet)
      	FIN
      
      	// Champ suivant
      	sNomChamp=EnumèreSousElément(sParent)
      FIN
      
     type : 458752
   -
     name : RemplirImage
     procedure_id : 1437474448161172559
     type_code : 14
     code : |1-
      // Remplit la table avec les images de la fenêtre
      // Entrée:	sParent		Nom de l'élément parent
      Procédure RemplirImage(sParent)
      
      // Premier champ de la fenêtre
      sNomChamp est une chaîne=EnumèreSousElément(sParent,enumpremier)
      TANTQUE sNomChamp<>""
      
      	// nom complet du champ
      	sNomComplet est une chaine=sParent+"."+sNomChamp
      	// type de l'élément
      	nType est un entier = {sNomComplet,indgpw}..Type
      
      	// selon le type du champ
      	selon nType
      		// image et zone de cliquage
      		cas typimage, typClicage : AjouteElement(sNomComplet,nType,{sNomComplet,indgpw}..libelle,{sNomComplet,indgpw}..groupe)
      		// onglet, table, menu contextuel
      		cas typOnglet, typtable, typBarreOutils, typBoîteAOutils, typOptionMenu, typSuperChamp : RemplirImage(sNomComplet)
      	FIN
      
      	// Champ suivant
      	sNomChamp=EnumèreSousElément(sParent)
      FIN
     type : 458752
   -
     name : RemplirOnglet
     procedure_id : 1437474448161238095
     type_code : 14
     code : |1+
      // Remplit la table avec les onglets de la fenêtre
      // Entrée:	sParent		Nom de l'élément parent
      Procédure RemplirOnglet(sParent)
      
      // Premier champ de la fenêtre
      sNomChamp est une chaîne=EnumèreSousElément(sParent,enumpremier)
      TANTQUE sNomChamp<>""
      
      	// nom complet de l'objet
      	sNomComplet est une chaine=sParent+"."+sNomChamp
      	
      	// si c'est un conteneur
      	si {sNomComplet,indgpw}..Type=typOnglet ou {sNomComplet,indgpw}..Type=typBoîteAOutils  OU {sNomComplet,indGPW}..Type=typSuperChamp alors
      		// ajoute le champ dans la table
      		AjouteElement(sNomChamp,{sNomComplet,indgpw}..Type,{sNomComplet,indgpw}..libelle,{sNomComplet,indgpw}..groupe)
      	FIN
      
      	// Champ suivant
      	sNomChamp=EnumèreSousElément(sParent)
      FIN
      
      
     type : 458752
   -
     name : RemplirAutre
     procedure_id : 1437474448161303631
     type_code : 14
     code : |1+
      // Remplit la table avec les types de champs divers de la fenêtre
      // Entrée:	sParent		Nom de l'élément parent
      Procédure RemplirAutre(sParent)
      
      // Premier champ de la fenêtre
      sNomChamp est une chaîne=EnumèreSousElément(sParent,enumpremier)
      TANTQUE sNomChamp<>""
      
      	// nom complet du champ
      	sNomComplet est une chaine=sParent+"."+sNomChamp
      	// type de l'élément
      	nTypeElement est un entier = {sNomComplet,indgpw}..Type
      
      	// selon le type du champ
      	selon nTypeElement
      		// champs de saisie
      		cas typForme,...
      			typJauge,...
      			typOle,...
      			typPotentiomètreRotatif,...
      			typPotentiomètre,...
      			typSélect,...
      			typSpin,...
      			typTreeView,...
      			typActiveX,...
      			typAsc :
      				AjouteElement(sNomComplet,nTypeElement,{sNomComplet,indgpw}..libelle,{sNomComplet,indgpw}..groupe)
      
      		// groupe, onglet, table, menu contextuel
      		cas typOnglet, typtable, typBarreOutils, typBoîteAOutils, typOptionMenu, typSuperChamp, TypFenetreInterneSource : RemplirAutre(sNomComplet)
      	FIN
      
      	// Champ suivant
      	sNomChamp=EnumèreSousElément(sParent)
      FIN
      
     type : 458752
   -
     name : AjouteElement
     procedure_id : 1437474448161369167
     type_code : 14
     code : |1+
      // Ajout d'un élément dans la table
      // Entrée:	sElement	Nom de l'élément à ajouter
      //			nType		Type de l'élément (-1 pour les menus)
      //			sLibelle	Libellé de l'élément
      //			sGroupe		Nom du groupe
      //			nNiveau		Niveau d'indentation de l'élément
      Procédure AjouteElement(sElement, nType, sLibelle, sGroupe, nNiveau est un entier = 0)
      
      // élément affiché
      sElementAffiche est une chaine=sRecupNomAffiche(sElement,nType,sLibelle,nNiveau)
      
      // récupération de l'état
      nEtat est un entier=nRecupEtat(ComboConfiguration..Nom, Fenetre[Fenetre], sElement, nType, sGroupe)
      
      // ajout de l'élément dans la table
      tableajoute(EtatObjet,sElement+tab+sElementAffiche+tab+Milieu(sElement,position(sElement,".")+1)+tab+nEtat+tab+sGroupe+tab+nType)
     type : 458752
   -
     name : RemplirElement
     procedure_id : 1437474448161434703
     type_code : 14
     code : |1+
      // Remplit la table avec les champs du type demandé de la fenêtre
      // Entrée:	sParent		Nom de l'élément parent
      //			nType		Type de champs recherché
      Procédure RemplirElement(sParent, nType)
      
      // Premier champ de la fenêtre
      sNomChamp est une chaîne=EnumèreSousElément(sParent,enumpremier)
      TANTQUE sNomChamp<>""
      
      	// nom complet du champ
      	sNomComplet est une chaine=sParent+"."+sNomChamp
      	// type de l'élément
      	nTypeElement est une entier = {sNomComplet,indgpw}..Type
      
      	// selon le type du champ
      	selon nTypeElement
      		// Liste
      		cas nType : AjouteElement(sNomComplet,nTypeElement,{sNomComplet,indgpw}..libelle,{sNomComplet,indgpw}..groupe)
      		// onglet, table, menu contextuel
      		cas typOnglet, typtable, typBarreOutils, typBoîteAOutils, typOptionMenu, typSuperChamp, TypFenetreInterneSource : RemplirElement(sNomComplet,nType)
      	FIN
      
      	// Champ suivant
      	sNomChamp=EnumèreSousElément(sParent)
      FIN
      
     type : 458752
   -
     name : RemplirParent
     procedure_id : 1437474448161500239
     type_code : 14
     code : |1+
      // Remplit la table avec les éléments parents (onglets, groupe) de la fenêtre
      // Entrée:	sParent		Nom de l'élément parent
      Procédure RemplirParent(sParent, nType)
      
      // Premier champ de la fenêtre
      nValRech est un entier=enumpremier
      si nType=typGrp alors nValRech+=enumGroupe
      sNomChamp est une chaîne=EnumèreSousElément(sParent,nValRech)
      TANTQUE sNomChamp<>""
      
      	// nom complet du champ
      	sNomComplet est une chaine=sParent+"."+sNomChamp
      
      	// si on énumération des groupes
      	si nType=typGrp alors
      		// ajout de l'élément dans la table
      		AjouteElement(sNomComplet,nType,"","")
      	sinon
      		// si le type correspond, ajout de l'élément dans la table
      		si {sNomComplet,indgpw}..Type=nType alors AjouteElement(sNomComplet,nType,{sNomComplet,indgpw}..libelle,{sNomComplet,indgpw}..groupe)
      	fin
      
      	// Champ suivant
      	sNomChamp=EnumèreSousElément(sParent)
      FIN
     type : 458752
   -
     name : ModifEtat
     procedure_id : 1437474448161827919
     type_code : 14
     code : |1+
      // Modification de l'état d'un élément
      // Entrée:	sElement		Nom logique de l'élément
      //			nEtat			Nouvel état de l'élément
      //			sListeGroupe	Liste des groupes de l'élément
      //			nType			Type de l'élément
      Procédure ModifEtat(sElement est une chaine, local nEtat est un entier, sListeGroupe est une chaine, LOCAL nType est un entier)
      
      // si le type est un groupe, un onglet une table ou une option de menu
      si nType=typGrp ou nType=typOnglet ou nType=typTable ou nType=typOptionMenu ou nType=typBarreOutils ou nType=typBoîteAOutils  OU nType=typSuperChamp ALORS
      	// suppression de tous les sous-éléments de l'élément en cours
      	SupprimeFils(ComboConfiguration, sElement, nType)
      FIN
      
      // vérification de la dissociation d'un groupe
      VerifDissociation(ComboConfiguration, Fenetre[Fenetre], sElement, nEtat, sListeGroupe, nType)
      
      // recherche de l'élément dans le fichier de configuration des éléments
      sValCleComp est une chaine=HConstruitValClé("GPWConfigurationElement","Configuration_Element",ComboConfiguration,sElement)
      HLitRecherchePremier("GPWConfigurationElement","Configuration_Element",sValCleComp)
      si htrouve("GPWConfigurationElement") alors
      	// modification de l'état de l'élément
      	GPWConfigurationElement.Etat=nEtat
      	si pas HModifie("GPWConfigurationElement") alors
      		erreur(<§$0005§>+rc+herreurinfo())
      	FIN
      
      // si l'élément n'existe pas
      sinon
      	// configure l'élément
      	AjouteConfigurationElement(ComboConfiguration, sElement, nEtat, nType)
      FIN
      
     type : 458752
   -
     name : InitComboConfiguration
     procedure_id : 1437474448162483279
     type_code : 14
     code : |1+
      // Initialisation de la conbo contenant le nom des configuration
      PROCEDURE InitComboConfiguration()
      
      ListeSupprimeTout(ComboConfiguration)
      
      // filtre le fichier des configurations
      HFiltre("GPWConfiguration","Application",ProjetInfo())
      // parcours du fichier filtré
      HLitPremier("GPWConfiguration","Application")
      TANTQUE PAS HEnDehors("GPWConfiguration")
      	// si c'est un groupe
      	SI GPWConfiguration.Groupe ALORS
      		// ajout de ce groupe dans la combo
      		ListeAjoute(ComboConfiguration,GPWConfiguration.Configuration)
      	SINON
      		// si l'utilisateur n'est pas dans un groupe
      		sVal est une chaîne=HConstruitValClé("GPWUtilisateurConfiguration","Login_Application",GPWConfiguration.Configuration,ProjetInfo())
      		HLitRecherchePremier("GPWUtilisateurConfiguration","Login_Application",sVal)
      		SI HTrouve("GPWUtilisateurConfiguration") ET GPWUtilisateurConfiguration.Configuration=gpwAucun ALORS
      			// ajout de l'utilisateur dans la combo
      			ListeAjoute(ComboConfiguration,GPWConfiguration.Configuration)
      		FIN
      		// désactivation du filtre
      		HDésactiveFiltre("GPWUtilisateurConfiguration")
      	FIN
      	// suivant
      	HLitSuivant("GPWConfiguration","Application")
      FIN
      // désactivation du filtre
      HDésactiveFiltre("GPWConfiguration")
      
     type : 458752
   -
     name : SelectConfiguration
     procedure_id : 1437474448162548815
     type_code : 14
     code : |1-
      // Sélection de la bonne configuration dans la combo
      Procédure SelectConfiguration()
      
      // si une configuration a été précisée
      si sConfiguration<>"" alors
      	// sélection de la configuration
      	ComboConfiguration=sConfiguration
      sinon
      	// sélection de la première ligne
      	listeselectplus(ComboConfiguration,1)
      FIN
     type : 458752
   -
     name : RemplirMenuContextuel
     procedure_id : 1437479417446306900
     type_code : 14
     code : |1+
      Procédure RemplirMenuContextuel(sParent, nNiveau est un entier = 0)
      	
      // énumération des options de menu
      sOption est une chaine=EnumèreSousElément(sParent,enumpremier+enumMenuContextuel)
      
      // si on est à la racine d'un menu contextuel
      si nNiveau=0 alors
      	// parcours des menus contextuels de la fenêtre
      	tantque sOption<>""
      		// pour les sous-options
      		RemplirMenuContextuel(sParent+"."+sOption, nNiveau + 1)
      
      		// option suivante
      		sOption=EnumèreSousElément(sParent)
      	FIN
      
      // si c'est une sous-option
      sinon
      	// parcours des sous-options
      	tantque sOption<>""
      		// nom complet de l'option de menu
      		sNomComplet est une chaine=sParent+"."+sOption
      		
      		// ajoute l'option de menu
      		si {sNomComplet,indgpw}..type=typOptionMenu ALORS
      			ajouteelement(sNomComplet,typOptionMenu,{sNomComplet,indgpw}..libelle,"",nNiveau)
      		FIN
      		
      		// remplit les options du niveau supérieur
      		RemplirMenuContextuel(sNomComplet, nNiveau + 1)
      		
      		// option suivante
      		sOption=EnumèreSousElément(sParent)
      	FIN
      FIN
      
     type : 458752
   -
     name : RemplirVolet
     procedure_id : 1437510727755158044
     type_code : 14
     code : |1+
      // Remplit la table avec les volets des onglets de la fenêtre
      // Entrée:	sParent		Nom de l'élément parent
      //			bOnglet		Vrai si le parent est un onglet
      Procédure RemplirVolet(sParent, bOnglet=Faux)
      
      // Premier champ de la fenêtre
      sNomChamp est une chaîne=EnumèreSousElément(sParent,enumPremier+enumVolet) 
      TANTQUE sNomChamp<>""
      
      	// nom complet du champ
      	sNomComplet est une chaine=sParent+"."+sNomChamp
      	
      	// si le parant un onglet
      	si bOnglet alors
      		AjouteElement(sNomComplet,-1,{sNomComplet,indgpw}..libelle,"")
      	// si le champ est un onglet
      	sinon
      		si {sNomComplet,indgpw}..Type=typOnglet alors
      			RemplirVolet(sNomComplet,Vrai)
      		fin
      	FIN
      
      	// Champ suivant
      	sNomChamp=EnumèreSousElément(sParent)
      FIN
      
     type : 458752
  procedure_templates : []
  property_templates : []
