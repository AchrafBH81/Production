  -
    name : Copier_configuration
    identifier : 0x23f2ef650891ec4f
    internal_properties : 
    properties :
     x : 456
     y : 508
     width : 160
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         // choix de la configuration à copier
         sConfigACopier est une chaine=ouvre("GPWChoixConfiguration",ComboConfiguration)
         
         // aucune configuration sélectionnée ou même configuration
         si sConfigACopier="" ou sConfigACopier=ComboConfiguration alors retour
         
         // suppression de la config en cours
         hfiltre("GPWConfigurationElement","Configuration",ComboConfiguration)
         hlitpremier("GPWConfigurationElement","Configuration")
         tantque pas HEnDehors("GPWConfigurationElement")
         	// suppression de la configuration de l'élément
         	si pas bSupprimeConfigurationElement(ComboConfiguration, GPWConfigurationElement.Element) alors retour
         FIN
         
         // filtre sur la configuration à copier
         hfiltre("GPWConfigurationElement","Configuration",sConfigACopier)
         pour tout "GPWConfigurationElement" sur "Configuration"
         	// copie de la configuration de l'élément
         	GPWConfigurationElement.Configuration=ComboConfiguration
         	si pas hajoute("GPWConfigurationElement") ALORS
         		erreur(<§$0008§>+rc+herreurinfo())
         		sortir
         	FIN
         FIN
         
         // rafraichissement de la fenêtre
         rafraichissement()
        type : 18
      -
        type : 161
        enabled : false
