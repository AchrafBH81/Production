  -
    name : Btn_Ok
    identifier : 0x24b2a6de2b34eeb5
    internal_properties : 
    properties :
     x : 705
     y : 82
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         gtabSurfaceComposante.SupprimeTout()
         
         //goto impression
         OuvreSoeur(FEN_AttenteSommaireParComposante)
         FEN_AttenteSommaireParComposante.LIB_Recup..Couleur		= RougeClair
         FEN_AttenteSommaireParComposante.IMG_Attente..Visible	= Vrai
         FEN_AttenteSommaireParComposante.IMG_Attente..Animation	= Vrai
         nCPT	est un entier
         
         
         //IMG_Attente..visible = vrai
         //IMG_Attente..Animation = vrai
         
         sTxtreq	est une chaîne	= [
         	SELECT distinct
         	hfacture.facalcul AS facalcul,	
         	hfdetail.fdbase AS base,	
         	Client.nom AS name,
         	hfacture.faclient as num,	
         	hfdetail.fdnocomm AS fdnocomm,
              hfdetail.fdcomposant1,	
              hfdetail.fdcomposant2,	
              hfdetail.fdcomposant3,
         	hfdetail.ftype,
         	(CASE WHEN hfacture.facalcul = 1  THEN round(wl.val(hfdetail.fdhauteur) * wl.val(hfdetail.fdlargeur) / 144,2) ELSE round(wl.val(hfdetail.fdhauteur) * wl.val(hfdetail.fdlargeur) / 0.0929,2) end) * hfdetail.fdqteafacturer as surface
             
         	FROM 
         	(
         	(
         	hfdetail
         	INNER JOIN
         	hfacture
         	ON hfacture.fanumero = hfdetail.fdnocomm
         	)
         	INNER JOIN
         	Client
         	ON hfacture.faclient = Client.numero
         	)
         	full outer JOIN
         	BonLivraison
         	ON BonLivraison.Bnumero = hfacture.fanofacture
         	WHERE 
         	(
         	BonLivraison.BDateFacture BETWEEN {pdatedebut} AND {pdateFin}
         	AND	BonLivraison.Bfacture <> 0 and client.categorie = {pcategorie} and hfacture.faclient = {pNumClient}
         	)
         ]
         
         
         sdReqsql est une Source de Données
         sdreqsql.pdatedebut	= sai_datedebut
         sdreqsql.pdatefin	= sai_datefin
         selon SélecteurClient
         	// Tous les clients
         	CAS 1
         		si val(CBOCategorie) = 0 alors sdReqsql.pCategorie=null sinon sdreqsql.pCategorie	= val(CBOCategorie)
         		sdreqsql.pNumClient	= Null
         		
         	// Un client
         	CAS 2
         		
         		sdreqsql.pCategorie	= null
         		sdreqsql.pNumClient	= fclient
         FIN
         
         
         //trace(timesys())
         SI HExécuteRequêteSQL(sdReqsql,hRequêteDéfaut,sTxtreq) ALORS
         FIN
         TANTQUE PAS sdReqsql..ExécutionTerminée
         	nCPT++
         	Message(FEN_AttenteSommaireParComposante.CBM_SansNom,NumériqueVersChaîne(nCPT))
         	Multitâche(-1)
         FIN
         //trace(timesys())
         //trace(hnbenr(sdReqsql))	
         
         
         FEN_AttenteSommaireParComposante.LIB_Recup..Couleur	= CouleurDéfaut
         FEN_AttenteSommaireParComposante.LIB_tri..Couleur	= RougeClair
         FEN_AttenteSommaireParComposante.IMG_Attente..Y		= FEN_AttenteSommaireParComposante.LIB_tri..Y
         
         
         nRes		est un entier
         
         POUR TOUT sdReqsql 
         	Message(FEN_AttenteSommaireParComposante.CBM_SansNom,sdReqsql.fdnocomm)
         	MultitâcheRepeint(MaFenêtre)
         	SI sdReqsql.ftype =1 ALORS
         		SI SansEspace(sdReqsql.fdcomposant1) <> "" ALORS
         			nres = gtabSurfaceComposante.Cherche(tcLinéaire,"sComposante",sansespace(sdReqsql.fdcomposant1))
         			si nres <> -1 alors 
         				gtabSurfaceComposante[nres].rSurface+=sdReqsql.surface 
         			sinon
         				si hlitrecherche(invent,INUM,sansespace(sdReqsql.fdcomposant1)) alors gstCurrentSurfaceComposante.sDescription = invent.IDESC
         				gstCurrentSurfaceComposante.sComposante	=  sansespace(sdReqsql.fdcomposant1)
         				gstCurrentSurfaceComposante.rSurface	=  sdReqsql.surface
         				gtabSurfaceComposante.ajoute(gstCurrentSurfaceComposante)
         				
         			FIN
         			
         		FIN
         		
         		SI SansEspace(sdReqsql.fdcomposant2) <> "" ALORS
         			nRes = gtabSurfaceComposante.Cherche(tcLinéaire,"sComposante",SansEspace(sdReqsql.fdcomposant2))
         			SI nRes <> -1 ALORS 
         				gtabSurfaceComposante[nRes].rSurface+=sdReqsql.surface 
         			SINON
         				SI HLitRecherche(invent,INUM,sansespace(sdReqsql.fdcomposant2)) ALORS gstCurrentSurfaceComposante.sDescription = invent.IDESC
         				gstCurrentSurfaceComposante.sComposante	=  sansespace(sdReqsql.fdcomposant2)
         				gstCurrentSurfaceComposante.rSurface	=  sdReqsql.surface
         				gtabSurfaceComposante.Ajoute(gstCurrentSurfaceComposante)
         				
         			FIN
         			
         		FIN
         		
         		SI SansEspace(sdReqsql.fdcomposant3) <> "" ALORS
         			nRes = gtabSurfaceComposante.Cherche(tcLinéaire,"sComposante",SansEspace(sdReqsql.fdcomposant3))
         			SI nRes <> -1 ALORS 
         				gtabSurfaceComposante[nRes].rSurface+=sdReqsql.surface 
         			SINON
         				SI HLitRecherche(invent,INUM,sansespace(sdReqsql.fdcomposant3)) ALORS gstCurrentSurfaceComposante.sDescription = invent.IDESC
         				gstCurrentSurfaceComposante.sComposante	=  sansespace(sdReqsql.fdcomposant3)
         				gstCurrentSurfaceComposante.rSurface	=  sdReqsql.surface
         				gtabSurfaceComposante.Ajoute(gstCurrentSurfaceComposante)
         				
         			FIN
         			
         		FIN
         	FIN
         	Multitâche(-1)
         FIN
         Ferme(FEN_AttenteSommaireParComposante)
         
         gtabSurfaceComposante.Trie(ttMembre,"sComposante")
         Impression:
         
         
         sLibDate				est une chaîne	= "Du " + DateVersChaine(sai_datedebut,"JJ/MM/AAAA") + " au " + DateVersChaine(sai_datefin,"JJ/MM/AAAA")
         sLibCategorieOuClient	est une chaîne
         
         si SélecteurClient = 1 alors
         	sLibCategorieOuClient = "Catégorie : " +CBOCategorie.ValeurAffichée
         sinon
         	sLibCategorieOuClient		= "Client : " +fclient + " "+ nom
         FIN
         
         iapercu()
         iImprimeEtat(ETAT_Pi2ParComposante,slibdate,sLibCategorieOuClient,gtabSurfaceComposante)
         //POUR CHAQUE rClTotal,sCle de  taCompile 
         //	TableAjouteLigne(TABLE_SansNom1,sCle,rClTotal)
         //	Multitâche(-1)
         //	
         //	
         //FIN
         //Trace(TimeSys())
         
        type : 18
      -
        type : 161
        enabled : false
