      -
        code : |1+
         moimeme = 1
        type : 14
      -
        code : |1+
         selon moimeme
         	// Tous les clients
         	CAS 1
         		CBOCategorie..etat = actif
         		GR_Client..visible = faux
         
         		
         	// Un client
         	CAS 2
         		CBOCategorie = 0
         		CBOCategorie..Etat = grise
         		GR_Client..Visible = vrai
         		FCLIENT	= ""
         		nom		= ""		
         FIN
