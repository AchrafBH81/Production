      		nombredeverre++
      FIN
      	
      //hlitrecherche("ENSEMBLE","clecomposant",spqteint.spqcomposant1+spqteint.spqcomposant2+spqteint.spqcomposant3)
      //si pas h.endehors et h.trouve alors
          hpos = hsauveposition("invent")
      	hlitrecherche("invent","INUM",produitdebase)
      //Code WinDev 5.5 remplacé par la migration :
      //    si pas h.endehors et h.trouve alors
          si pas HEnDehors() et HTrouve() alors
      	selon nombredeverre
      	cas 2
      		selon udemesure
      		cas "A"
      		   montant = invent.iprixdouble
      		cas "M"
      		   montant = invent.iprixdoublem
      	
               FIN
      	cas 3
      		selon udemesure
      		cas "A"
      		   montant = invent.iprixtriple
      		cas "M"
      		   montant = invent.iprixtriplem
      		fin   
      	FIN
          
      //fin
      FIN
      
      renvoyer montant + totalextra
      
