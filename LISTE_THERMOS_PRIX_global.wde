      						escomptet[3] = trouve_escompte(client.numero+invent.inum,...
      						client.numero+repete(" ",10)+invent.icategorie)
      						si sansespace(invent.idateprixfutur) = "" alors
      							si udemesure = "A" alors
      								pextra[3] = invent.iprixa
      							sinon
      								pextra[3] = invent.iprixm
      							fin
      							
      						sinon
      							si daterequise > invent.idateprixfutur ou sansespace(daterequise) = "" alors
      								daterequise = invent.idateprixfutur
      						    fin
