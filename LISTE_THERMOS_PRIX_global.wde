      	FIN
      	si pas pextrat[1] = "" alors
      		nett[3] = pextrat[3] * (100 - escomptet[3]) / 100
      	FIN
      fin
      
      
      
      si pas indice = 0 alors
      	
      	hlitrecherche("invent","INUM",produitdebase)
      	
      //Code WinDev 5.5 remplacé par la migration :
      //	si pas h.endehors alors
      	si pas HEnDehors() alors
      //Code WinDev 5.5 remplacé par la migration :
      //		si h.trouve alors
