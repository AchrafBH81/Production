   -
     name : assigneLibelle
     procedure_id : 5080830300476228764
     type_code : 14
     code : |1+
      Procédure assigneLibelle()
      i est un entier
      
      lTableauLibelle est un tableau de  8 chaines
      lTableauLibelle[1]  = "lentete,lentete"
      lTableauLibelle[2]  = "lthermos,lthermos"
      lTableauLibelle[3]  = "lthermossuite,lthermossuite"
      lTableauLibelle[4]  = "lnumero,lnumero"
      lTableauLibelle[5]  = "facdescription,facdescription"
      lTableauLibelle[6]  = "lprix,lprix"
      lTableauLibelle[7]  = "lagnlais,langlais"
      lTableauLibelle[8]  = "lmetrique,lmetrique"
      
      		pour i = 1 a 8
      			si hlitrecherche(Traduction,TRecherche,extraitchaine(lTableauLibelle[i],1,",")) alors
      				{"LISTE_THERMOS_PRIX_global."+ExtraitChaîne(lTableauLibelle[i],2,",")} = traduction.dFrancais
      			fin
      		FIN
      
      
      
      
      
      
     type : 458752
