      //saisieformetrn.flargeur = forme.formulelargeur
      saisieformetrn.fextrad  = forme.extradouble
      saisieformetrn.fextrat  = forme.extratriple
      saisieformetrn.fextradm = forme.extradoublem
      saisieformetrn.fextratm = forme.extratriplem
