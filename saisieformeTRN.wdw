   -
     name : affichechamp
     procedure_id : 5145309503504962610
     type_code : 14
     code : |1+
      Procédure affichechamp(modif)
      sFirstActiveControl est une chaîne  = ""
      
      si  forme.wactif alors
      	SAI_width..visible = vrai
      	si sFirstActiveControl = "" alors sFirstActiveControl = "Sai_width"
      FIN
      si  forme.w1actif alors
      	SAI_width1..visible = vrai
      	SI sFirstActiveControl = "" ALORS sFirstActiveControl = "Sai_width1"
      FIN
      si  forme.w2actif alors
      	SAI_width2..visible				= vrai
      	SI sFirstActiveControl = "" ALORS sFirstActiveControl = "Sai_width2"
      FIN
      si  forme.hactif alors
      	SAI_height..visible = vrai
      	SI sFirstActiveControl = "" ALORS sFirstActiveControl = "Sai_height"
      FIN
      si  forme.h1actif alors
      	SAI_Height1..visible = vrai	
      	SI sFirstActiveControl = "" ALORS sFirstActiveControl = "Sai_height1"
      FIN
      si  forme.h2actif alors
      	SAI_height2..Visible = vrai
      	SI sFirstActiveControl = "" ALORS sFirstActiveControl = "Sai_height2"
      FIN
      si  forme.dactif alors
      	SAI_Diameter..visible = vrai	
      	SI sFirstActiveControl = "" ALORS sFirstActiveControl = "Sai_Diameter"
      FIN
      si  forme.ractif alors
      	SAI_Radius..visible = vrai
      	SI sFirstActiveControl = "" ALORS sFirstActiveControl = "Sai_radius"
      FIN
      si  forme.r1actif alors
      	SAI_Radius1..visible = vrai
      	SI sFirstActiveControl = "" ALORS sFirstActiveControl = "Sai_radius1"
      FIN
      si  forme.r2actif alors
      	SAI_Radius2..visible = vrai	
      	SI sFirstActiveControl = "" ALORS sFirstActiveControl = "Sai_radius2"
      FIN
      
      
      si sFirstActiveControl <> "" alors reprisesaisie(sFirstActiveControl)
     type : 458752
   -
     name : convert_anglais
     procedure_id : 5145309502622585906
     type_code : 14
     code : |1+
      Procédure convert_anglais(variable,provenance = "")
      //variable est une chaine = moimeme
      hlitpremier("config","COCLEUNIK")
      
      longueur est un entier = taille(variable)
      position_espace est un entier = position(variable," ")
      //position_espace1 est un entier = position(variable," ",position_espace+1)
      resultat_gauche est une chaine  
      resultat_droit est une chaine        
      valeuraretourner est une chaine
      si position_espace = 0 alors
      si position(variable,"/") = 0 alors
       resultat_gauche = ""
      sinon
       resultat_gauche = "0"
      fin	
      sinon	
      
       resultat_gauche = gauche(variable,position_espace-1)
      
      FIN
      si position_espace = 0 alors
      
      resultat_droit = variable
      
      sinon	
      
      resultat_droit = milieu(variable,position_espace +1, longueur - position_espace)
      
      FIN
      
      
      si pas position(resultat_droit,"/") = 0 alors
      	resultat_droit = memrecherche("tableau_metrique",resultat_droit)
      FIN
      
      
      
      
      
      //si provenance = "fini" alors
        valeuraretourner = resultat_gauche+resultat_droit
        
      //sinon
      //  moimeme = resultat_gauche+resultat_droit
      //  valeuraretourner = vrai
      		
      //FIN
      
      si val(valeuraretourner) > config.dimensionmaxanglais et pas valeuraretourner = "" alors
      //	erreur("Donnée incorrecte")
      	valeuraretourner = ""
      FIN
      
      
      
      renvoyer valeuraretourner
      
     type : 458752
   -
     name : convert_metrique
     procedure_id : 5145309503195108402
     type_code : 14
     code : |1+
      Procédure convert_metrique(valeuraconvertir,videpermis = faux)
      hlitpremier("config","COCLEUNIK")
      valeurderetour est une chaine
      variable est une chaine = valeuraconvertir
      longueur est un entier = taille(variable)
      partie_decimale est une chaine
      partie_entier est une chaine
      si longueur <> 0 alors
      	si position(variable,".") = 0 alors
      		si longueur <= 3 alors
      			variable = "."+repete("0",3-longueur)+variable
      		sinon
      			partie_decimale = droite(variable,3)
      			partie_entier   = gauche(variable,longueur-3)
      			variable = partie_entier+"."+partie_decimale
      		FIN
      	fin
      	
      	valeurderetour = variable
      sinon
      	si videpermis alors
      		valeurderetour = vrai
      	sinon	 
      		valeurderetour = faux
      	fin
      fin 	
      si val(valeuraconvertir) < config.dimensionmaximetrique et pas valeuraconvertir = "" alors
      //	erreur("Donnée incorrecte")
      	valeurderetour = faux
      FIN
      
      renvoyer valeurderetour
      
     type : 458752
   -
     name : decimaleenfraction
     procedure_id : 5145309503002498098
     type_code : 14
     code : |1+
      Procédure decimaleenfraction(valeur)
      
      valeuraretourner est une chaine
      wdecimale est une chaine = arrondi(partiedecimale(val(valeur)-0.001),3) * 1000
      wentier est une chaine  =  partieentiere(val(valeur))
      
      si pas partiedecimale(val(valeur)) = 0  alors
       hlitrecherche("fraction","decimale",wdecimale)
      
      //Code WinDev 5.5 remplacé par la migration :
      // si pas h.endehors alors
       si pas HEnDehors() alors
      	
       valeuraretourner = wentier+ " "+ fraction.fraction	
      sinon
      valeuraretourner = ""	
      FIN
      sinon
       valeuraretourner = wentier	
      
      fin	
      renvoyer valeuraretourner
      
     type : 458752
