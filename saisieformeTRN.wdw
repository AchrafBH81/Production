      //saisieformetrn.saisie14 = decimaleenfraction(trdetail.fdr2)
      //saisieformetrn.saisie15 = decimaleenfraction(trdetail.fds)
      //saisieformetrn.saisie16= decimaleenfraction(trdetail.fdf)
      //sinon	
