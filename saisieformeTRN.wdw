   -
     name : validechamp
     procedure_id : 5145309501843231794
     type_code : 14
     code : |1+
      Procédure validechamp()
      j est un entier
      i est une chaine
      validite est un booleen = vrai
      commandetrn.wfnombre = 0
      pour j = 1 a 14
      	i = sansespace(numeriqueverschaine(j,"2d"))
      //Code WinDev 5.5 remplacé par la migration :
      //	si {"saisieformetrn.saisie"+i}..etat = actif alors
      	si ({"saisieformetrn.saisie"+i}..etat = actif ET {"saisieformetrn.saisie"+i}..Visible=Vrai) alors
      		commandetrn.wfnombre++
      		si sansespace({"saisieformetrn.saisie"+i}..valeur) = "" alors
      		    validite = faux
      			sortir
      		FIN
      	FIN
      FIN
      si pas validite alors
      	erreur("Tous les champs sont obligatoire")
          reprisesaisie("saisieformetrn.saisie"+i)
      FIN
      renvoyer validite
      
     type : 458752
