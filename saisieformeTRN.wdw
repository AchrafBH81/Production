 menu :
  name : _Menu
  identifier : 0x4767cfbb53b3d464
  internal_properties : 
  options : []
 languages :
  - fr-FR
 popup_menus : []
 message_bar :
  internal_properties : CQAAAAkAAADi0iS3c5T627wZ0ac7QU2nvFgQfex2y8sZIsBGLYlaRqFS1ejdjfHHvjDwAKkCyuMNFPCJfQwMy5Bt1L0VjSp8SP7RhTk4F7+F5BuDp830H94LZXesFjpPah2+JQ==
 actionbar : {}
 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1+
      procedure saisieformetrn(numero="",wclient="",wmodif=faux)
      
      
      // Pour compatibilité 5.5
      MoiMême..Visible=Vrai
      
      global
      	saisieok est un booleen = faux
      si numero = "" alors
      	ferme
      FIN
      
      // Migration : Déplacement de variables globales
      global
      	W		est une chaine
      	W1		est une chaine
      	W2		est une chaine
      	HAU		est un chaine
      	HAU1	Est une chaine
      	HAU2	est une chaine
      	D		est une chaine
      	R		est une chaine
      	R1		est une chaine
      	R2		est une chaine
      	S		est un reel 
      	F		est un reel 
      	T1		EST UNE CHAINE	= saisieformetrn.saisie7
      	T2		EST UNE CHAINE	= saisieformetrn.saisie8
      	T3		EST UNE CHAINE	= saisieformetrn.saisie9
      	T4		EST UNE CHAINE	= saisieformetrn.saisie10
      	//Code WinDev 5.5 remplacé par la migration :
      //cap..VISIBLE = FAUX
      cap..Visible=Faux
      DossierForme est une chaîne = ComplèteRep(config.Dossierforme)
      
      hlitrecherche("forme","fnumero",numero)
      //Code WinDev 5.5 remplacé par la migration :
      //si pas h.endehors et h.trouve alors
      
      si pas HEnDehors() et HTrouve() alors
      	// saisieformetrn.image1 = COMPLETEREP(REPENCOURS)+COMPLETEREP(SANSESPACE(config.Dossierforme))+forme.fchemin
      	lib_shape				= sansespace(forme.fnumero)  + " - " + forme.fdescription
      	saisieformeTRN.IMAGE1	= DossierForme+sansespace(forme.fchemin	)
      	fichierversecran("saisieformetrn","forme")
      	remplirdefaut(wmodif)
      	//Code WinDev 5.5 remplacé par la migration :
      	// saisie..VISIBLE = FAUX
      	saisie..Visible=Faux
      	affichechamp(modif)
      	ecranpremier("SAISIE1") 
      fin 
      
