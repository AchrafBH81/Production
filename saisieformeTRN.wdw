  -
    name : BTN_OK
    identifier : 0x4767cfbb69b1d446
    internal_properties : 
    properties :
     x : 669
     y : 8
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         
         sUneformule	est une chaine
         sLeresultat	est une chaine
         //global
         //W est un reel 
         //W1 est un reel 
         //W2 est un reel 
         //HAU est un reel 
         //HAU1 Est un reel 
         //HAU2 est un reel 
         //D est un reel 
         //R est un reel 
         //R1 est un reel 
         //R2 est un reel 
         //S est un reel 
         //F est un reel 
         //T1 EST UNE CHAINE = saisieformetrn.saisie7
         //T2 EST UNE CHAINE = saisieformetrn.saisie8
         //T3 EST UNE CHAINE = saisieformetrn.saisie9
         //T4 EST UNE CHAINE = saisieformetrn.saisie10
         
         
         W		= saisieformeTRN.SAI_width
         W1		= saisieformeTRN.SAI_width1
         W2		= saisieformeTRN.SAI_width2
         HAU		= saisieformeTRN.SAI_height
         HAU1	= saisieformeTRN.SAI_Height1
         HAU2	= saisieformeTRN.SAI_height2
         D		= saisieformeTRN.SAI_Diameter
         R		= saisieformeTRN.SAI_Radius
         R1      = saisieformeTRN.SAI_Radius1
         R2      = saisieformeTRN.SAI_Radius2
         S		= saisieformetrn.saisie13
         F		= saisieformetrn.saisie14
         
         //validechamp()
         //majtrdetail() // pour la mise a jour des transaction avec cap
         //uneformule = "y est une chaine"+RC+"y="+saisieformetrn.fhauteur+RC+"renvoyer(y)"
         
         //Calcul hauteur
         Quand exception dans 
         SI forme.formulehauteur <> "" ALORS
         	commandeTRN.CDHAUTEUR = {SansEspace(forme.formulehauteur),indVariable}
         	SELON commandeTRN.facalcul
         		CAS 1
         			commandeTRN.fdhauteuranglais = commandetrn.CDHAUTEUR
         			commandeTRN.fdhauteura = commandetrn.CDHAUTEUR
         			commandetrn.cdhauteur = InchFractionToInch(commandetrn.cdhauteur)
         		CAS 2
         			//		commandeTRN.fdlargeuranglais = calcul_anglais(MoiMême)
         			commandeTRN.fdhauteuranglais	= commandeTRN.CDHAUTEUR
         			commandeTRN.fdhauteura			= commandeTRN.CDHAUTEUR
         			commandeTRN.fdhauteuranglais	= MillimiterToInchFraction(commandetrn.CDHAUTEUR)
         	FIN	
         FIN
         FAIRE
         FIN
         
         quand exception dans
         
         SI forme.formulehauteur1 <> "" ALORS
         	commandeTRN.CDHAUTEUR1 = {SansEspace(forme.formulehauteur1),indVariable}
         	SELON commandeTRN.facalcul
         		CAS 1
         			commandeTRN.fdhauteuranglais1	= commandeTRN.CDHAUTEUR1
         			commandeTRN.fdhauteur1a			= commandeTRN.CDHAUTEUR1
         			commandeTRN.CDHAUTEUR1			= InchFractionToInch(commandeTRN.CDHAUTEUR1)
         		CAS 2
         			//		commandeTRN.fdlargeuranglais = calcul_anglais(MoiMême)
         			commandeTRN.fdhauteuranglais1	= commandeTRN.CDHAUTEUR1
         			commandeTRN.fdhauteur1a			= commandeTRN.CDHAUTEUR1
         			commandeTRN.cdhauteur1	= MillimiterToInchFraction(commandeTRN.CDHAUTEUR1)
         	FIN	
         	
         FIN
         FAIRE
         FIN
         
         
         quand exception dans
         SI forme.formuleLargeur <> "" ALORS
         	commandeTRN.CDlargeur = {SansEspace(forme.formulelargeur),indVariable}
         	SELON commandeTRN.facalcul
         		CAS 1
         			commandeTRN.fdlargeuranglais	= commandeTRN.CDlargeur
         			commandeTRN.fdlargeura			= commandeTRN.CDlargeur
         			commandeTRN.CDlargeur			= InchFractionToInch(commandeTRN.CDlargeur)
         		CAS 2
         			//		commandeTRN.fdlargeuranglais = calcul_anglais(MoiMême)
         			commandeTRN.fdlargeuranglais	= commandeTRN.CDlargeur
         			commandeTRN.fdlargeura			= commandeTRN.CDlargeur
         			commandeTRN.fdlargeuranglais	= MillimiterToInchFraction(commandeTRN.CDlargeur)
         	FIN	
         	
         fIN
         faire
         fin
         
         
         //
         //
         //uneformule = "y est un reel"+RC+"y="+saisieformetrn.fhauteur+RC+"renvoyer(y)"
         //leresultat = compile("reponse",uneformule)
         ////
         //si leresultat = "" alors
         //	si commandetrn.facalcul = 1 alors
         //			    commandetrn.cdhauteur = reponse()
         //			    commandetrn.fdhauteura = decimaleenfraction(commandetrn.cdhauteur)
         //			    //commandetrn.cdhauteur = convert_anglais(reponse())
         ////		//Code WinDev 5.5 remplacé par la migration :
         ////		//        execute("commandetrn.cdhauteur..ent")
         ////		//        ExecuteTraitement("commandetrn.cdhauteur",TRTentree)
         //	sinon
         //			    commandetrn.cdhauteur = arrondi(reponse()* 1000,0)
         //			    commandetrn.fdhauteura = commandetrn.cdhauteur 
         ////		//		commandetrn.cdhauteur = convert_metrique(commandetrn.fdhauteura)
         //	fin
         //fin
         
         
         
         
         // calcul largeur
         //
         //
         //uneformule = "y est un reel"+RC+"y="+saisieformetrn.flargeur+RC+"renvoyer(y)"
         //leresultat = compile("reponse",uneformule)
         //si leresultat = "" alors
         //	si commandetrn.facalcul = 1   alors
         //		//	    commandetrn.cdlargeur = reponse()
         //		//	    commandetrn.fdlargeura = decimaleenfraction(commandetrn.cdlargeur) 
         //		//		commandetrn.cdlargeur = commandetrn.fdlargeura
         //	sinon
         //		//	    commandetrn.cdlargeur = arrondi(reponse()* 1000,0)
         //		//	    commandetrn.fdlargeura = commandetrn.cdlargeur 
         //		//		commandetrn.cdlargeur = convert_metrique(commandetrn.fdlargeura)
         //	fin
         //fin
         //info(decimaleenfraction(commandetrn.cdlargeur))
         //commandetrn.wfw       = saisieformetrn.saisie1
         //commandetrn.wfw1      = saisieformetrn.saisie2
         //commandetrn.wfw2      = saisieformetrn.saisie3
         //commandetrn.wfh       = saisieformetrn.saisie4
         //commandetrn.wfh1      = saisieformetrn.saisie5
         //commandetrn.wfh2      = saisieformetrn.saisie6
         //commandetrn.wft1      = saisieformetrn.saisie7
         //commandetrn.wft2      = saisieformetrn.saisie8
         //commandetrn.wft3      = saisieformetrn.saisie9
         //commandetrn.wft4      = saisieformetrn.saisie10
         //commandetrn.wfd       = saisieformetrn.saisie11
         //commandetrn.wfr       = saisieformetrn.saisie12
         //commandetrn.wfr1      = saisieformetrn.saisie13
         //commandetrn.wfr2      = saisieformetrn.saisie14
         //commandetrn.wfs       = saisieformetrn.saisie15
         //commandetrn.wff       = saisieformetrn.saisie16
         //commandetrn.wfcapw    = saisieformetrn.wcap
         //commandetrn.wfcapw1   = saisieformetrn.w1cap
         //commandetrn.wfcapw2   = saisieformetrn.w2cap
         //commandetrn.wfcaph    = saisieformetrn.hcap
         //commandetrn.wfcaph1   = saisieformetrn.h1cap
         //commandetrn.wfcaph2   = saisieformetrn.h2cap
         //commandetrn.wfcapd    = saisieformetrn.dcap
         //commandetrn.wfcapr    = saisieformetrn.rcap
         //commandetrn.wfcapr1    = saisieformetrn.r1cap
         //commandetrn.wfcapr2    = saisieformetrn.r2cap
         //commandetrn.wfcaps    = saisieformetrn.scap
         //commandetrn.wfcapf    = saisieformetrn.fcap
         
         commandetrn.wfw			= saisieformetrn.SAI_width
         commandetrn.wfw1		= saisieformetrn.SAI_width1
         commandetrn.wfw2		= saisieformetrn.SAI_width2
         commandetrn.wfh			= saisieformetrn.SAI_height
         commandetrn.wfh1		= saisieformetrn.SAI_Height1
         commandetrn.wfh2		= saisieformetrn.SAI_height2
         commandetrn.wfd			= saisieformetrn.SAI_Diameter
         commandetrn.wfr			= saisieformetrn.SAI_Radius
         commandetrn.wfr1		= saisieformetrn.SAI_Radius1
         commandetrn.wfr2		= saisieformetrn.SAI_Radius2
         
         
         
         si sansespace(commandetrn.nbverre) = "" alors
         	si commandetrn.CDCOMPOSANT3 = "" alors
         		commandeTRN.nbverre = "double"
         	sinon
         		commandeTRN.nbverre = "triple"
         	FIN
         FIN
         si hlitrecherche(formeclient,IdClientNoForme,hconstruitvalcle(FormeClient,IdClientNoForme,wclient,numero)) alors
         	si formeclient.fPrixSpecial alors
         		si commandetrn.nbverre = "double" alors
         			commandetrn.fdextraforme = formeclient.fPrixdouble
         		sinon
         			commandetrn.fdextraforme  = formeclient.FpRixtriple
         		fin	
         	sinon
         		si commandetrn.nbverre = "double" alors
         			commandetrn.fdextraforme  = saisieformetrn.fextrad
         		sinon
         			commandetrn.fdextraforme  = saisieformetrn.fextrat
         		fin	
         	fin
         	
         sinon	
         	si commandetrn.nbverre = "double" alors
         		commandetrn.fdextraforme  = saisieformetrn.fextrad
         	sinon
         		commandetrn.fdextraforme  = saisieformetrn.fextrat
         	fin	
         fin
         
         saisieok = vrai
         
         ferme
         
        type : 18
      -
        type : 161
        enabled : false
