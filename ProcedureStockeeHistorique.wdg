   -
     name : EpureHistoriquePDF
     procedure_id : 2129694112504659015
     type_code : 15
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      // EpureHistoriquePDF ()
      //
      // Paramètres :
      //	Aucun
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE EpureHistoriquePDF()
      
      //nbjours est un entier = config.NbJourPdf
      nbjours est un entier systeme= 90
      repdonnees =INILit("donnees","donnees","vide",completerep(frepencours())+"production.ini")
      fListeFichier(repdonnees+"\pdf\Conf*.pdf",PIEpurePDF,nbjours)
      
      	Procedure interne PIEpurePDF(lChemin,lnom,lchange,lnbjours)
      	
      	SI DateVersEntier(DateSys())-DateVersEntier(fDate(lChemin+lnom)) >= lnbjours ALORS
      		fSupprime(lChemin+lnom)
      		
      	FIN
      	fin
     type : 458752
