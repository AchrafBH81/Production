    properties :
     y : 53.392
     width : 269.4
     height : 10.054
    code_elements :
     type_code : 30
     p_codes :
      -
        code : |1-
         
        type : 327694
      -
        code : |1+
         
         //// ****************** Nouveau code ****************************
         
         
         
         
         
         
         
         
         
         si lLivraison alors
         	QteCarreau=(RequeteProductionAfaireCarrelage.fdqteafacturer+RequeteProductionAfaireCarrelage.fdqtedejafacture) * RequeteProductionAfaireCarrelage.fdcarreauh * RequeteProductionAfaireCarrelage.fdcarreauv
         	QteCarr=(RequeteProductionAfaireCarrelage.fdqteafacturer+RequeteProductionAfaireCarrelage.fdqtedejafacture)
         	RequeteBonLivraisonFacture.pNoCommande = RequeteProductionAfaireCarrelage.fdnocomm
         	RequeteBonLivraisonFacture.pNoLigne = RequeteProductionAfaireCarrelage.fdligne
         	SI HExécuteRequête(RequeteBonLivraisonFacture) ALORS
         		POUR TOUT RequeteBonLivraisonFacture 
         			si RequeteBonLivraisonFacture.Bfacture <> 0 alors
         				qtecarreau -= RequeteBonLivraisonFacture.totalCarreau
         				qtecarr -= RequeteBonLivraisonFacture.la_somme_fdqteafacturer
         			FIN
         		fin
         	FIN
         	//	QteCarreau=(RequeteProductionAfaireCarrelage.fdqtedejafacture) * RequeteProductionAfaireCarrelage.fdcarreauh * RequeteProductionAfaireCarrelage.fdcarreauv
         	//	QteCarr=(RequeteProductionAfaireCarrelage.fdqtedejafacture)
         sinon
         	qtecarreau=RequeteProductionAfaireCarrelage.fdqteafacturer * RequeteProductionAfaireCarrelage.fdcarreauh * RequeteProductionAfaireCarrelage.fdcarreauv
         	Qtecarr=RequeteProductionAfaireCarrelage.fdqteafacturer
         fin
         
         
         
         
         
         
         
         
         
         
         
