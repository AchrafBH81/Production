 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1+
      procedure FenetreAjoutModificationIntercalaire(_Titre = "",_type = "A")
      
      
   -
     code : |1+
      mafenetre..titre += " ( "+sansespace(_titre) + " )"
      si _type = "M" alors
      	numero..etat = inactif
          fichierversecran(FenetreAjoutModificationIntercalaireCouleurDimension,IntercalaireCouleurDimensions)
      FIN
      
     type : 34
   -
     type : 180
     enabled : false
   -
     type : 230
     enabled : false
   -
     code : |1+
      ecranversfichier(FenetreAjoutModificationIntercalaireCouleurDimension,IntercalaireCouleurDimensions)
      si _type = "A" alors
      	IntercalaireCouleurDimensions.IDIntercalaireCouleurs = IntercalaireCouleurs.IDIntercalaireCouleurs
      	hajoute(IntercalaireCouleurDimensions)
      sinon
      	hmodifie(IntercalaireCouleurDimensions,hNumEnrEnCours)
      
      FIN
     type : 2
   -
     type : 11
   -
     type : 12
   -
     type : 17
