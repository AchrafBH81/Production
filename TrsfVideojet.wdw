      CH5 est un reel
      CH6 est un reel
      CH7 est un reel
      CH8 est un reel
      CH9 est un reel
      CH10 est un reel
      
      SL1 est un reel
      SL2 est un reel
      SL3 est un reel
      SL4 est un reel
      SL5 est un reel
      SL6 est un reel
      SL7 est un reel
      SL8 est un reel
      SL9 est un reel
      SL10 est un reel
      
      SH1 est un reel
      SH2 est un reel
      SH3 est un reel
      SH4 est un reel
      SH5 est un reel
      SH6 est un reel
      SH7 est un reel
      SH8 est un reel
      SH9 est un reel
      SH10 est un reel
      
      
      
      j est un entier
      lesformules est un tableau de 20 chaine
      hlitpremier("videojet","VICLEUNIK")
      //Code WinDev 5.5 remplacé par la migration :
      //tantque pas h.endehors
      tantque pas HEnDehors()
      	j = val(sansespace(videojet.videonumero))	
      	lesformules[j] = sansespace(videojet.videodescription)	
      
      	hlitsuivant("videojet","VICLEUNIK")
      FIN
      // Fin des variables
      si gTypeOptimisation = "optima" alors
      	TrsfVideojet.NUMEROOPT..visible = vrai
      	TrsfVideojet.IntBL..visible = vrai
      FIN
      
      HDésactiveFiltre(fdetail)
      hdesactivefiltre(facture)
      hdesactivefiltre(bonlivraison)
      
      
