   -
     name : transférerVideojet
     procedure_id : 4575381860297034774
     type_code : 14
     code : |1+
      Procédure transférerVideojet()
      messageaafficher est une chaine
      hlitpremier(tempo,cletrait_base_esp_comm_ligne)
      si tempo.tnumeroprep <> 0 alors
      	messageaafficher  = "Transfert du lot # " + tempo.tnumeroprep + " vers le Vidéojet"
      fin
      acso_message("Info",messageaafficher,"Info") 
      //ouvresoeur(FenAttentePetite,"Transfert en cours..............")
      //sablier(vrai)
      selon gFormatFacture
      	cas 1
      		executetraitement(trsfvideojet.Boutonnovy,trtclic)
      	cas 2
      		executetraitement(trsfvideojet.Boutontrn,trtclic)
      fin
      
     type : 458752
   -
     name : MajCarrelage
     procedure_id : 4798045436042722156
     type_code : 14
     code : |1+
      Procédure MajCarrelage()
      //HRAZ(impvideo)
      impvideo.vimprime = " "
      impvideo.vnoligne = tempo.tlignedecommande
      impvideo.vnoprep = tempo.tnumeroprep
      impvideo.vcommande = tempo.tcomm
      impvideo.vlignecommande = tempo.tnoetiq
      impvideo.vclientnom = gauche(tempo.tnomclient,gclconfig.m_nvjclient)
      impvideo.vdate = tempo.tdate
      impvideo.vespace  = tempo.tespace
      impvideo.vcommandeclient = tempo.tcommclient
      impvideo.vcapgazlowe = tempo.tcapgaztube
      impvideo.vtraitementspecial = tempo.ttraitementspecial
      impvideo.vpbase = tempo.tbase
      impvideo.vlargeur = tempo.tlargeur
      impvideo.vhauteur = tempo.thauteur
      impvideo.vcode   = tempo.TNumCarr
      //impvideo.vNbCarreauH = tempo.TnbCarreauH
      //impvideo.vNbCarreaul = tempo.TnbCarreaul
      impvideo.vhauteurcontour = tempo.THauteurContour
      impvideo.vlargeurcontour = tempo.TlargeurContour
      impvideo.vhauteurtete = tempo.THauteurtete
      										// barre du bas différente
      
      
      si pas position(tempo.tcapgaztube,"I") = 0 alors
      	impvideo.vesptype = "Inex"
      sinon
      	impvideo.vesptype = "Alu."
      FIN
      
      impvideo.vqte = tempo.tqte
      si hlitrecherche(invent,INUM,tempo.TNumCarr) alors
      	impvideo.vdescCarr = invent.idesc
      fin
      
      
      impvideo.vcarrelage = tempo.tcarrelage
      CAlculCarrelage()
      hajoute(impvideo)
      si herreurdoublon() alors
      
      FIN
      //si tempo.tFlagBarreDifferente alors
      //	Maz_Marquage("impvideo")
      //	impvideo.vcode = tempo.TNumCarrBarre
      //	si hlitrecherche(invent,INUM,tempo.TNumCarrbarre) alors
      //		impvideo.vdescriptionCarr = invent.idesc
      //	fin
      //	impvideo.vNbCarreauH = 2
      //	impvideo.vNbCarreaul = 1
      //	impvideo.vNumCarrBarrepos = 2   // pour empecher les doublons quand carrelage de tete avec
      //	// barre du bas différente
      //
      //
      //    CAlculCarrelage(vrai)
      //	hajoute(impvideo)
      //	si herreurdoublon() alors
      //
      //	FIN
      //FIN
      
     type : 458752
   -
     name : CAlculCarrelage
     procedure_id : 4798062617228133136
     type_code : 14
     code : |1+
      Procédure CAlculCarrelage(BarreDifferente = faux)
      
      i est un entier
      formule est une chaine
      nAEnlever est un entier = 0 
      nAenlevertete est un entier = 0
      sFvtcv est une chaine
      sFvtch est une chaine
      nPositionInvent est un entier
      resultatcondition est un booleen = faux
      clederecherche est une chaine
      
      si pas hlitrecherche(invent,INUM,tempo.TNumCarr) alors
      	retour
      FIN
      
      
      //C    = invent.tccadre
      NBH  = tempo.tcarreauh
      NBL  = tempo.TCarreauv
      H1   =  tempo.thauteur
      L1   = tempo.tlargeur
      //ETH  = invent.tctigehor
      //ETL  = invent.tctigevert
      //lcc = val(tempo.tLargeurcontour) * 25.4
      //HCC = val(tempo.THauteurContour) * 25.4
      //HTE = arrondi(val(tempo.THauteurTete) * 25.4)
      lcc = tempo.tvx
      HCC = tempo.Tvx1
      HTE = tempo.Tvx
      DDV = tempo.tddv
      DDh = tempo.tddh
      vx = tempo.tvx
      vx1 = tempo.tvx1
      DTH = tempo.tdt
      //hlitrecherche(typecarr,tcdescription,invent.itypecarr)
      hlitrecherche(typecarr,tcdescription,tempo.TtypeCalcul)
      
      //c = typecarr.EpaisseurCadre
      etl = typecarr.EpaisseurTigeLargeur
      eth = typecarr.EpaisseurTigeHauteur
      si tempo.TDemiCarrelage alors
      	TigerCarrelage.VTypeDessin = 3
      sinon
      
      	TigerCarrelage.VTypeDessin = typecarr.Typedessin
      FIN
      //tigercarrelage.Vhauteurtete = typecarr.VariableUtil
      tigercarrelage.vhauteurcontour = typecarr.VariableUtil1
      tigercarrelage.vlargeurcontour = typecarr.VariableUtil
      
      //si hlitrecherche(typespac,tnumero,tempo.TtypeSpacer) alors
      //	selon typespac.ttype
      //		cas 1
      //			c= typecarr.EpaisseurCadreAluminium
      //		cas 2
      //			c= typecarr.EpaisseurCadreinex
      //		cas 3
      //			c= typecarr.EpaisseurCadreGlassEdge
      //		cas 4
      //			c= typecarr.EpaisseurCadreSuperSpacer
      //	fin	
      //FIN
      
      
      si  hlitrecherche(IntercalaireCouleurDimensions,IDIntercalaireCouleursnumero,...
      	hconstruitvalcle(IntercalaireCouleurDimensions,IDIntercalaireCouleursnumero,sansespace(tempo.ttypespacer),sansespace(tempo.tespace))) alors
      //fin
      
      
      //si hlitrecherche(IntercalaireCouleurs,IDIntercalaireCouleurs,tempo.TtypeSpacer) alors
      	si pas position(tempo.tcapgaztube,"Z") = 0 alors
      		VarInter1=IntercalaireCouleurDimensions.VarInter1A
      		VarInter2=IntercalaireCouleurDimensions.VarInter2A
      		VarInter3=IntercalaireCouleurDimensions.VarInter3A
      		VarInter4=IntercalaireCouleurDimensions.VarInter4A
      		VarInter5=IntercalaireCouleurDimensions.VarInter5A
      	sinon
      		VarInter1=IntercalaireCouleurDimensions.VarInter1
      		VarInter2=IntercalaireCouleurDimensions.VarInter2
      		VarInter3=IntercalaireCouleurDimensions.VarInter3
      		VarInter4=IntercalaireCouleurDimensions.VarInter4
      		VarInter5=IntercalaireCouleurDimensions.VarInter5
      	fin
      	si hlitrecherche(IntercalaireCouleurs,IDIntercalaireCouleurs,tempo.TtypeSpacer) alors
      		si hlitrecherche(intercalaires,IDIntercalaires,IntercalaireCouleurs.idIntercalaires) alors
      			c = intercalaires.EpaisseurCadre
      		fin
      	fin
      FIN
      
      
      
      //si Position(tempo.tcapgaztube,"I") = 0 alors
      //	alum = config.ValeurAlum
      //sinon
      //	alum = 0	
      //FIN
      si Position(tempo.tcapgaztube,"T") <> 0 alors
      	ALUM = 0
      	ICN = gclconfig.m_nvAleurICN
      sinon si Position(tempo.tcapgaztube,"I") = 0 et Position(tempo.tcapgaztube,"T") = 0 alors
      	alum = gclconfig.m_nValeurAlum
      	ICN = 0
      sinon
      	alum = 0	
      	ICN = 0
      FIN
      
      pour i = 1 a 20
      	{"K"+i} = typecarr.TConstantes[i]
      FIN
      pour i = 1 a 10
      	{"NM"+i} = 0
      	{"DM"+i} = 0
      	{"VM"+i} = 0
      	{"VD"+i} = 0
      	{"HM"+i} = 0
      	{"HD"+i} = 0
      	{"CL"+i} = 0
      	{"CH"+i} = 0
      	{"SL"+i} = 0
      	{"SH"+i} = 0
      
      FIN
      
      
      res est une chaine
      si tempo.tcap
      	H1-=4
      	L1-=4
      FIN
      
      
      pour i = 1 a 10
      
      	formule = sansespace(typecarr.nbmorceau[i])
      	formule = RemplaceFormule(formule)
      	res = compile("formule1","y est un reel"+rc+"y="+formule+rc+"renvoyer y") 
      	si res = "" alors
      
      		si pas valideformule(formule) alors
      			{"NM"+i} = 0
      		sinon
      			{"NM"+i} = executetraitement("formule1",trtProcédure)
      		fin
      		si 	{"NM"+i} < 0 alors
      			{"NM"+i} = 0
      		FIN
      
      		si sansespace(typecarr.conditionsinm[i]) = "" alors
      			impvideo.vnbmorceau[i] = {"NM"+i}
      			TigerCarrelage.vNbMorceau[i] = {"NM"+i}
      		sinon
      			formule = sansespace(typecarr.conditionsinm[i])
      			formule = RemplaceFormule(formule)
      			res = compile("formule2","y est un reel"+RC+"y="+formule+RC+"renvoyer y ")
      			si res = "" alors
      				resultatcondition = ExécuteTraitement("formule2",trtProcédure)
      
      				si resultatcondition  alors
      					formule = sansespace(typecarr.conditionalorsnm[i])
      					formule = RemplaceFormule(formule)
      					res = compile("formule2","y est un reel"+RC+"y="+formule+RC+"renvoyer y ")
      					si res = "" ALORS
      						{"NM"+i} = (ExécuteTraitement("formule2",trtProcédure))
      
      						impvideo.vnbmorceau[i] = {"NM"+i}
      						TigerCarrelage.vNbMorceau[i] = {"NM"+i}
      					sinon
      						{"NM"+i} = 0
      
      					fin
      
      				sinon
      					impvideo.vnbmorceau[i] = {"NM"+i}
      					TigerCarrelage.vNbMorceau[i] = {"NM"+i}
      
      				fin
      			sinon
      				{"NM"+i} = 0
      
      			fin
      
      		fin
      
      	FIN
      	impvideo.vnbmorceau[i] = {"NM"+i}
      	TigerCarrelage.vNbMorceau[i] = {"NM"+i}
      
      
      
      
      
      	formule = sansespace(typecarr.nbdimension[i])
      	formule = RemplaceFormule(formule)
      	res = compile("formule1","y est un reel"+rc+"y="+formule+rc+"renvoyer y") 
      	si res = "" alors
      		si pas valideformule(formule) alors
      			{"DM"+i} = 0
      		sinon
      			{"DM"+i} = executetraitement("formule1",trtProcédure)
      		fin
      		si 	{"DM"+i} < 0 alors
      			{"DM"+i} = 0
      		FIN
      
      
      
      		si sansespace(typecarr.conditionsidm[i]) = "" alors
      			impvideo.vdimensionmorceau[i] = {"DM"+i}
      			TigerCarrelage.vDimesionMorceau[i] = {"DM"+i}
      		sinon
      			formule = sansespace(typecarr.conditionsidm[i])
      			formule = RemplaceFormule(formule)
      			res = compile("formule2","y est un reel"+RC+"y="+formule+RC+"renvoyer y ")
      			si res = "" alors
      				resultatcondition = ExécuteTraitement("formule2",trtProcédure)
      
      				si resultatcondition  alors
      					formule = sansespace(typecarr.conditionalorsdm[i])
      					formule = RemplaceFormule(formule)
      					res = compile("formule2","y est un reel"+RC+"y="+formule+RC+"renvoyer y ")
      					si res = "" ALORS
      						{"DM"+i} = (ExécuteTraitement("formule2",trtProcédure))
      
      						impvideo.vdimensionmorceau[i] = {"DM"+i}
      						TigerCarrelage.vDimesionMorceau[i] = {"DM"+i}
      					sinon
      						{"DM"+i} = 0
      
      					fin
      
      				sinon
      					impvideo.vdimensionmorceau[i] = {"DM"+i}
      					TigerCarrelage.vDimesionMorceau[i] = {"DM"+i}
      				fin
      			sinon
      				{"DM"+i} = 0
      
      			fin
      
      		fin
      
      	FIN
      	impvideo.vdimensionmorceau[i] = {"DM"+i}
      	TigerCarrelage.vDimesionMorceau[i] = {"DM"+i}
      
      fin
      
      //pour i = 1 a nbh - 1 - aenlever
      pour i = 1 a 10
      	formule = sansespace({"typecarr.tcformuleCL"}[i])
      	formule = RemplaceFormule(formule)
      	res = compile("formule1","y est un reel"+rc+"y="+formule+rc+"renvoyer y") 
      	si res = "" alors
      		si pas valideformule(formule) alors
      			{"CL"+i} = 0
      		sinon
      			{"CL"+i} = executetraitement("formule1",trtProcédure)
      		fin
      		si 	{"CL"+i} < 0 alors
      			{"CL"+i} = 0
      		FIN
      
      
      		si sansespace(typecarr.conditionsicl[i]) = "" alors
      			impvideo.vMarquageLC[i] = {"CL"+i}
      			TigerCarrelage.vMarquageL[i] = {"CL"+i}
      		sinon
      			formule = sansespace(typecarr.conditionsicl[i])
      			formule = RemplaceFormule(formule)
      			res = compile("formule2","y est un reel"+RC+"y="+formule+RC+"renvoyer y ")
      			si res = "" alors
      				resultatcondition = ExécuteTraitement("formule2",trtProcédure)
      
      				si resultatcondition  alors
      					formule = sansespace(typecarr.conditionalorscl[i])
      					formule = RemplaceFormule(formule)
      					res = compile("formule2","y est un reel"+RC+"y="+formule+RC+"renvoyer y ")
      					si res = "" ALORS
      						{"CL"+i} = (ExécuteTraitement("formule2",trtProcédure))
      
      						impvideo.vMarquageLC[i] = {"CL"+i}
      						TigerCarrelage.vMarquageL[i] = {"CL"+i}
      					sinon
      						{"CL"+i} = 0
      
      					fin
      
      				sinon
      					impvideo.vMarquageLC[i] = {"CL"+i}
      					TigerCarrelage.vMarquageL[i] = {"CL"+i}
      				fin
      			sinon
      				{"CL"+i} = 0
      
      			fin
      
      		fin
      
      
      
      
      
      	FIN
      
      	impvideo.vMarquageLC[i] = {"CL"+i}
      	TigerCarrelage.vMarquageL[i] = {"CL"+i}
      fin
      
      
      
      
      pour i =1 a 10
      	//pour i =1 a nbl-1 -aenlever
      	formule = sansespace({"typecarr.tcformuleCH"}[i])
      	formule = RemplaceFormule(formule)
      
      	res = compile("formule1","y est un reel"+rc+"y="+formule+rc+"renvoyer y") 
      	si res = "" alors
      		si pas valideformule(formule) alors
      			{"CH"+i} = 0
      		sinon
      			{"CH"+i} = executetraitement("formule1",trtProcédure)
      		fin
      		si 	{"CH"+i} < 0 alors
      			{"CH"+i} = 0
      		FIN
      
      		si sansespace(typecarr.conditionsich[i]) = "" alors
      			impvideo.vMarquagehC[i] = {"CH"+i}
      			TigerCarrelage.vMarquageh[i] = {"CH"+i}
      		sinon
      			formule = sansespace(typecarr.conditionsich[i])
      			formule = RemplaceFormule(formule)
      			res = compile("formule2","y est un reel"+RC+"y="+formule+RC+"renvoyer y ")
      			si res = "" alors
      				resultatcondition = ExécuteTraitement("formule2",trtProcédure)
      
      				si resultatcondition  alors
      					formule = sansespace(typecarr.conditionalorsch[i])
      					formule = RemplaceFormule(formule)
      					res = compile("formule2","y est un reel"+RC+"y="+formule+RC+"renvoyer y ")
      					si res = "" ALORS
      						{"CH"+i} = (ExécuteTraitement("formule2",trtProcédure))
      
      						impvideo.vMarquagehC[i] = {"CH"+i}
      						TigerCarrelage.vMarquageh[i] = {"CH"+i}
      					sinon
      						{"CH"+i} = 0
      
      					fin
      
      				sinon
      					impvideo.vMarquageHC[i] = {"CH"+i}
      					TigerCarrelage.vMarquageh[i] = {"CH"+i}
      				fin
      			sinon
      				{"CH"+i} = 0
      
      			fin
      		FIN
      
      
      	FIN
      	impvideo.vMarquagehC[i] = {"CH"+i}
      	TigerCarrelage.vMarquageh[i] = {"CH"+i}
      fin
      
      
      //pour i = 1 a nbh-1-aenlever- aenlevertete
      pour i = 1 a 10
      	formule = sansespace({"typecarr.tcformuleSL"}[i])
      	formule = RemplaceFormule(formule)
      
      	res = compile("formule1","y est un reel"+rc+"y="+formule+rc+"renvoyer y") 
      	si res = "" alors
      		si pas valideformule(formule) alors
      			{"SL"+i} = 0
      		sinon
      			{"SL"+i} = executetraitement("formule1",trtProcédure)
      		fin
      		si 	{"SL"+i} < 0 alors
      			{"SL"+i} = 0
      		FIN
      		//		impvideo.vMarquageLC[i] = numeriqueverschaine(formule1())
      
      		si sansespace(typecarr.conditionsisl[i]) = "" alors
      			impvideo.vMarquagels[i] = {"SL"+i}
      			TigerCarrelage.vMarquagelc[i] = {"SL"+i}
      		sinon
      			formule = sansespace(typecarr.conditionsisl[i])
      			formule = RemplaceFormule(formule)
      			res = compile("formule2","y est un reel"+RC+"y="+formule+RC+"renvoyer y ")
      			si res = "" alors
      				resultatcondition = ExécuteTraitement("formule2",trtProcédure)
      
      				si resultatcondition  alors
      					formule = sansespace(typecarr.conditionalorssl[i])
      					formule = RemplaceFormule(formule)
      					res = compile("formule2","y est un reel"+RC+"y="+formule+RC+"renvoyer y ")
      					si res = "" ALORS
      						{"SL"+i} = (ExécuteTraitement("formule2",trtProcédure))
      
      						impvideo.vMarquagels[i] = {"SL"+i}
      						TigerCarrelage.vMarquagelc[i] = {"SL"+i}
      					sinon
      						{"SL"+i} = 0
      
      					fin
      
      				sinon
      					impvideo.vMarquageLS[i] = {"SL"+i}
      					TigerCarrelage.vMarquagelc[i] = {"SL"+i}
      				fin
      			sinon
      				{"SL"+i} = 0
      
      			fin
      
      		FIN
      
      	fin
      	impvideo.vMarquageLS[i] = {"SL"+i}
      	TigerCarrelage.vMarquagelc[i] = {"SL"+i}
      fin
      
      
      //pour i =1 a nbl-1-aenlever 
      pour i =1 a 10
      	formule = sansespace({"typecarr.tcformuleSH"}[i])
      	formule = RemplaceFormule(formule)
      
      	res = compile("formule1","y est un reel"+rc+"y="+formule+rc+"renvoyer y") 
      	si res = "" alors
      		si pas valideformule(formule) alors
      			{"SH"+i} = 0
      		sinon
      			{"SH"+i} = executetraitement("formule1",trtProcédure)
      		fin
      		si 	{"SH"+i} < 0 alors
      			{"SH"+i} = 0
      		FIN
      		//		impvideo.vMarquageLC[i] = numeriqueverschaine(formule1())
      
      		si sansespace(typecarr.conditionsish[i]) = "" alors
      			impvideo.vMarquagehs[i] = {"SH"+i}
      			TigerCarrelage.vMarquagehc[i] = {"SH"+i}
      
      		sinon
      			formule = sansespace(typecarr.conditionsish[i])
      			formule = RemplaceFormule(formule)
      			res = compile("formule2","y est un reel"+RC+"y="+formule+RC+"renvoyer y ")
      			si res = "" alors
      				resultatcondition = ExécuteTraitement("formule2",trtProcédure)
      
      				si resultatcondition  alors
      					formule = sansespace(typecarr.conditionalorssh[i])
      					formule = RemplaceFormule(formule)
      					res = compile("formule2","y est un reel"+RC+"y="+formule+RC+"renvoyer y ")
      					si res = "" ALORS
      						{"SH"+i} = (ExécuteTraitement("formule2",trtProcédure))
      
      						impvideo.vMarquagehs[i] = {"SH"+i}
      						TigerCarrelage.vMarquagehc[i] = {"SH"+i}
      					sinon
      						{"SH"+i} = 0
      
      					fin
      
      				sinon
      					impvideo.vMarquageHS[i] = {"SH"+i}
      					TigerCarrelage.vMarquagehc[i] = {"SH"+i}
      				fin
      			sinon
      				{"SH"+i} = 0
      
      			fin
      
      		FIN
      
      
      	FIN
      
      	impvideo.vMarquagehs[i] = {"SH"+i}
      	TigerCarrelage.vMarquagehc[i] = {"SH"+i}
      fin
      
      clederecherche = hconstruitvalcle(fdetail,fdcle,tempo.tcomm,tempo.tlignedecommande)
      si hlitrecherche(fdetail,fdcle,clederecherche) alors
      	//	si fdetail.fdlien <> 0 alors
      	//		hlitsuivant(fdetail,fdcle)
      	//		si fdetail.fdlien = tempo.tligne alors
      
      	pour i = 1 a 10
      		fdetail.vnbmorceau[i] = impvideo.vnbmorceau[i]
      		fdetail.vDimensionMorceau[i] = impvideo.vDimensionMorceau[i]
      		fdetail.vMarquageHC[i] = impvideo.vMarquageHC[i]
      		fdetail.vMarquageHs[i] = impvideo.vMarquageHs[i]
      		fdetail.vMarquageLC[i] = impvideo.vMarquagelC[i]
      		fdetail.vMarquagels[i] = impvideo.vMarquagels[i]
      
      	FIN
      	//	dessinecarrelage(fdetail.fdtypecalcul)
      	//	fdetail.Imagecarrelage = imagecarrelage
      	hmodifie(fdetail,hNumEnrEnCours)
      	//		fin
      	//	FIN
      fin
      
      
     type : 458752
   -
     name : DessineCarrelage
     procedure_id : 4812808076092938197
     type_code : 14
     code : |1+
      Procédure DessineCarrelage(TypeDeCalcul)
      // Position du dessin du thermos
      i est un entier
      typedessin est une chaine
      Normaltete est un booleen = faux        // pour aviser qu'on dessine la barre d'un carrelage de tete seulement
      si fdetail.fdcarreauv = 0 ou fdetail.fdcarreauh= 0 ou val(fdetail.fdlargeura) = 0 ou val(fdetail.fdhauteura) = 0 alors
      	retour
      FIN
      //si hlitrecherche(invent,INUM,noproduit) alors
      	si HLitRecherche(typecarr,tcdescription,TypeDeCalcul) alors
      		selon typecarr.Typedessin
      			cas 1
      				typedessin = "Normal"
      			cas 2
      				typedessin = "Contour"
      			cas 3
      				typedessin = "Tete"
      				//			cas 4
      				//				typedessin = "ContourTete"
      
      		FIN
      
      	sinon
      		retour
      	fin
      
      //sinon
      //	retour
      //
      //FIN
      
      
      
      PositionX1 est un entier     
      PositionY1 est un entier
      PositionX2 est un entier
      PositionY2 est un entier
      PositionX3 est un entier   // position de départ apres le petit carreau largeur  
      PositionY3 est un entier   // position de départ apres le petit carreau hauteur
      positiony4 est un entier    // position de bas pour carrelage de tete
      LargeurDessin est un entier
      Hauteurdessin est un entier
      Hauteurdessin1 est un entier  // hauteur du dessin pour carrelage de tete
      
      LargeurCarreau est un entier
      HauteurCarreau est un entier
      
      // pour contour
      
      LargeurCarreauPetit est un entier = val(fdetail.fdvariablex )   //* 25.4
      HauteurCarreauPetit est un entier   = val(fdetail.FDvariablex1)  //* 25.4
      LargeurCarreauCentre est un entier 
      hauteurCarreauCentre est un entier
      
      
      // échelle de grandeur , pour ne pas dépasser l'image
      
      Echelle est un entier 
      
      // Nombre de carreau
      
      NbCarreauLargeur est un entier = fdetail.fdcarreauv + typecarr.AjustNbCarLargeur
      NbCarreauHauteur est un entier = fdetail.fdcarreauh + typecarr.AjustNbCarHauteur
      
      // carrelage de tete avec barre inférieure différente.Pour le dessin de la barre seulement
      // il faut changer ces parametres
      
      //si typedessin = "Normal" et fdetail.fdFlagBarreDifferente alors  
      //	NbCarreauHauteur = 1
      //	NbCarreauLargeur = 1
      //	typedessin = "Tete" 
      //    Normaltete = vrai
      //FIN
      //NbCarreauLargeur est un entier =  4
      //NbCarreauHauteur est un entier = 4
      
      
      LargeurCarrelage est un entier = fdetail.fdlargeura
      Hauteurcarrelage est un entier = fdetail.fdhauteura
      
      hlitrecherche(Facture,fanumero,fdetail.fdnocomm)
      si facture.facalcul = 1 alors
      	LargeurCarrelage  = val(fdetail.fdlargeura) * 25.4
      	Hauteurcarrelage  = val(fdetail.fdhauteura)  * 25.4
      
      sinon
      	LargeurCarrelage  = val(fdetail.fdlargeura)
      	Hauteurcarrelage  = val(fdetail.fdhauteura)
      fin
      
      
      //LargeurCarrelage = 800
      //Hauteurcarrelage = 800
      
      EchelleLargeur est un entier = LargeurCarrelage / 200
      EchelleHauteur est un entier = Hauteurcarrelage / 200
      
      Echelle = arrondi(max(EchelleHauteur,EchelleLargeur),0)+1
      si Echelle < 1 alors
      	Echelle = 1
      FIN
      
      selon typedessin
      	cas "Normal"
      
      		PositionX1 = (200 - (LargeurCarrelage / Echelle)) / 2
      		PositionX2 = PositionX1 +( LargeurCarrelage / Echelle)
      		PositionY1 = (200 - (Hauteurcarrelage / Echelle)) / 2
      		PositionY2 = PositionY1 + ( Hauteurcarrelage / Echelle )
      		LargeurDessin = PositionX2-PositionX1
      		Hauteurdessin = PositionY2-PositionY1
      
      		// calcul de la grandeur des carreaux a dessiner
      
      		LargeurCarreau = arrondi(LargeurDessin / NbCarreauLargeur,0)
      		HauteurCarreau = arrondi(Hauteurdessin / NbCarreauHauteur,0)
      
      		ddebutdessin(ImageCarrelage)
      		dRectangle(PositionX1,PositionY1,PositionX2,PositionY2,iblanc,inoir)
      
      		// tracage des lignes pour dessiner les carreau
      		pour i = 1 a NbCarreauLargeur-1
      
      			dligne(PositionX1+(LargeurCarreau*i),PositionY1,PositionX1+(LargeurCarreau*i),PositionY2,inoir)
      
      		FIN
      
      		pour i = 1 a NbCarreauHauteur-1
      
      			dligne(PositionX1,PositionY1+(HauteurCarreau*i),PositionX2,PositionY1+(HauteurCarreau*i),inoir)
      
      		FIN
      
      
      		//		imprimecarrelage..plan = 2
      		//		info("")
      
      		// CarrelageContour
      
      
      	cas "Contour"
      
      		PositionX1 = (200 - (LargeurCarrelage / Echelle)) / 2
      		PositionX2 = PositionX1 +( LargeurCarrelage / Echelle)
      		PositionY1 = (200 - (Hauteurcarrelage / Echelle)) / 2
      		PositionY2 = PositionY1 + ( Hauteurcarrelage / Echelle )
      		LargeurDessin = PositionX2-PositionX1
      		Hauteurdessin = PositionY2-PositionY1
      		//		LargeurCarreauPetit = arrondi(75.2 / echelle,0)
      		//		HauteurCarreauPetit = arrondi(101.6/echelle,0)
      		LargeurCarreauPetit = arrondi(LargeurCarreauPetit / Echelle,0)
      		HauteurCarreauPetit = arrondi(HauteurCarreauPetit/Echelle,0)
      
      
      
      
      
      		// calcul de la grandeur des carreaux a dessiner
      
      		si NbCarreauLargeur > 0 alors
      			LargeurCarreau = arrondi(LargeurDessin / NbCarreauLargeur,0)
      		sinon
      			LargeurCarreau = 0
      		fin
      
      		si NbCarreauHauteur > 0 alors
      			HauteurCarreau = arrondi(Hauteurdessin / NbCarreauHauteur,0)
      		sinon
      			HauteurCarreau = 0
      		fin
      		PositionX3 = PositionX1+LargeurCarreauPetit
      		PositionY3 = PositionY1+HauteurCarreauPetit
      		si NbCarreauLargeur > 2 alors
      			LargeurCarreauCentre = (LargeurDessin - (2 * LargeurCarreauPetit)) / (NbCarreauLargeur-2)
      		sinon
      			LargeurCarreauCentre = 0
      		fin
      
      		si NbCarreauHauteur > 2 alors
      
      			hauteurCarreauCentre = (Hauteurdessin - (2 * HauteurCarreauPetit)) / (NbCarreauHauteur-2)
      		sinon
      			hauteurCarreauCentre = 0
      		fin
      
      		ddebutdessin(ImageCarrelage)
      		dRectangle(PositionX1,PositionY1,PositionX2,PositionY2,iblanc,inoir)
      
      		// tracage des lignes horizontale pour dessiner les  petits carreaux
      
      		si typecarr.TcInterrupteurHaut alors
      			dligne(PositionX1,PositionY1+HauteurCarreauPetit,PositionX2,PositionY1+HauteurCarreauPetit,inoir)
      		fin
      		si typecarr.TcInterrupteurBas alors
      			dligne(PositionX1,PositionY2-HauteurCarreauPetit,PositionX2,PositionY2-HauteurCarreauPetit,inoir)
      		fin
      
      		// tracage des lignes Verticale pour dessiner les  petits carreaux
      
      		si typecarr.TcInterrupteurGauche alors
      			dligne(PositionX1+LargeurCarreauPetit,PositionY1,PositionX1+LargeurCarreauPetit,PositionY2,inoir)
      		FIN
      		si typecarr.TcInterrupteurDroit alors
      			dligne(PositionX2-LargeurCarreauPetit,PositionY1,PositionX2-LargeurCarreauPetit,PositionY2,inoir)
      		FIN
      
      		// tracage des petite lignes sur la largeur
      
      		pour i = 1 a NbCarreauLargeur - 3
      			si typecarr.TcInterrupteurHaut alors
      				dligne(PositionX3+(LargeurCarreauCentre*i),PositionY1,PositionX3+(LargeurCarreauCentre*i),PositionY1+HauteurCarreauPetit,inoir)
      		fin
      		si typecarr.TcInterrupteurBas alors
      			dligne(PositionX3+(LargeurCarreauCentre*i),PositionY2-HauteurCarreauPetit,PositionX3+(LargeurCarreauCentre*i),PositionY2,inoir)
      		fin
      fin
      
      // tracage des petite lignes sur la largeur
      
      pour i = 1 a NbCarreauHauteur - 3
      	si typecarr.TcInterrupteurGauche alors
      		dligne(PositionX1,PositionY3+(hauteurCarreauCentre*i),PositionX1+LargeurCarreauPetit,PositionY3+(hauteurCarreauCentre*i),inoir)
      fin
      si typecarr.TcInterrupteurDroit alors
      
      	dligne(PositionX2-LargeurCarreauPetit,PositionY3+(hauteurCarreauCentre*i),PositionX2,PositionY3+(hauteurCarreauCentre*i),inoir)
      FIN
      //			dligne(positionx3+(LargeurCarreaucentre*i),positiony2-HauteurCarreauPetit,positionx3+(LargeurCarreaucentre*i),PositionY2,inoir)
      
      fin
      
      
      
      
      Cas "Tete"
      	PositionX1 = (200 - (LargeurCarrelage / Echelle)) / 2
      	PositionX2 = PositionX1 +( LargeurCarrelage / Echelle)
      	PositionY1 = (200 - (Hauteurcarrelage / Echelle)) / 2
      	PositionY2 = PositionY1 + ( Hauteurcarrelage / Echelle )
      	LargeurDessin = PositionX2-PositionX1
      	Hauteurdessin = (PositionY2-PositionY1)
      	positiony4 = PositionY1 + (Hauteurdessin/3)
      	// calcul de la grandeur des carreaux a dessiner
      	Hauteurdessin1 = positiony4 - PositionY1
      
      	si NbCarreauLargeur > 0 alors
      		LargeurCarreau = arrondi(LargeurDessin / NbCarreauLargeur,0)
      	sinon
      		LargeurCarreau = 0
      fin
      
      
      si NbCarreauHauteur > 0 alors
      	HauteurCarreau = arrondi(Hauteurdessin1 / NbCarreauHauteur,0)
      sinon
      	HauteurCarreau = 0 
      FIN
      
      
      ddebutdessin(ImageCarrelage)
      dRectangle(PositionX1,PositionY1,PositionX2,PositionY2,iblanc,inoir)
      // tracage des lignes pour dessiner les carreau
      pour i = 1 a NbCarreauLargeur-1
      
      	dligne(PositionX1+(LargeurCarreau*i),PositionY1,PositionX1+(LargeurCarreau*i),positiony4,inoir)
      
      FIN
      
      pour i = 1 a NbCarreauHauteur-1
      
      	dligne(PositionX1,PositionY1+(HauteurCarreau*i),PositionX2,PositionY1+(HauteurCarreau*i),inoir)
      
      FIN
      //		si pas fdetail.fdFlagBarreDifferente  ou normaltete alors
      si NbCarreauHauteur > 0 alors
      	dligne(PositionX1,positiony4,PositionX2,positiony4,inoir)
      fin
      //		fin	
      
      
      
      // CarrelageContour
      
      cas "ContourTete"
      
      	PositionX1 = (200 - (LargeurCarrelage / Echelle)) / 2
      	PositionX2 = PositionX1 +( LargeurCarrelage / Echelle)
      	PositionY1 = (200 - (Hauteurcarrelage / Echelle)) / 2
      	PositionY2 = PositionY1 + ( Hauteurcarrelage / Echelle )
      	LargeurDessin = PositionX2-PositionX1
      	Hauteurdessin = PositionY2-PositionY1
      	LargeurCarreauPetit = arrondi(75.2 / Echelle,0)
      	HauteurCarreauPetit = arrondi(101.6/Echelle,0)
      
      	positiony4 = PositionY1 + (Hauteurdessin/2)
      	// calcul de la grandeur des carreaux a dessiner
      	Hauteurdessin1 = positiony4 - PositionY1
      
      
      
      
      
      	// calcul de la grandeur des carreaux a dessiner
      
      	LargeurCarreau = arrondi(LargeurDessin / NbCarreauLargeur,0)
      	HauteurCarreau = arrondi(Hauteurdessin / NbCarreauHauteur,0)
      	PositionX3 = PositionX1+LargeurCarreauPetit
      	PositionY3 = PositionY1+HauteurCarreauPetit
      	LargeurCarreauCentre = (LargeurDessin - (2 * LargeurCarreauPetit)) / (NbCarreauLargeur-2)
      	hauteurCarreauCentre = (Hauteurdessin1 - (2 * HauteurCarreauPetit)) / (NbCarreauHauteur-2)
      
      	ddebutdessin(ImageCarrelage)
      	dRectangle(PositionX1,PositionY1,PositionX2,PositionY2,iblanc,inoir)
      
      	// tracage des lignes horizontale pour dessiner les  petits carreaux
      
      	dligne(PositionX1,PositionY1+HauteurCarreauPetit,PositionX2,PositionY1+HauteurCarreauPetit,inoir)
      	dligne(PositionX1,positiony4-HauteurCarreauPetit,PositionX2,positiony4-HauteurCarreauPetit,inoir)
      	dligne(PositionX1,positiony4,PositionX2,positiony4,inoir)
      
      	// tracage des lignes Verticale pour dessiner les  petits carreaux
      
      	dligne(PositionX1+LargeurCarreauPetit,PositionY1,PositionX1+LargeurCarreauPetit,positiony4,inoir)
      	dligne(PositionX2-LargeurCarreauPetit,PositionY1,PositionX2-LargeurCarreauPetit,positiony4,inoir)
      
      	// tracage des petite lignes sur la largeur
      
      	pour i = 1 a NbCarreauLargeur - 3
      		dligne(PositionX3+(LargeurCarreauCentre*i),PositionY1,PositionX3+(LargeurCarreauCentre*i),PositionY1+HauteurCarreauPetit,inoir)
      		dligne(PositionX3+(LargeurCarreauCentre*i),positiony4-HauteurCarreauPetit,PositionX3+(LargeurCarreauCentre*i),positiony4,inoir)
      
      fin
      
      // tracage des petite lignes sur la largeur
      
      pour i = 1 a NbCarreauHauteur - 3
      	dligne(PositionX1,PositionY3+(hauteurCarreauCentre*i),PositionX1+LargeurCarreauPetit,PositionY3+(hauteurCarreauCentre*i),inoir)
      	dligne(PositionX2-LargeurCarreauPetit,PositionY3+(hauteurCarreauCentre*i),PositionX2,PositionY3+(hauteurCarreauCentre*i),inoir)
      	//			dligne(positionx3+(LargeurCarreaucentre*i),positiony2-HauteurCarreauPetit,positionx3+(LargeurCarreaucentre*i),PositionY2,inoir)
      
      fin
      
      
      
      
      
      fin
      
      
      //EcranVersFichier(imprimecarrelage,fdetail)
      ////
      //hmodifie(fdetail,hNumEnrEnCours)
      
      
     type : 458752
   -
     name : valideformule
     procedure_id : 4813212203397803544
     type_code : 14
     code : |1+
      Procédure valideformule(Formulaverifier)
      xposition est un entier = 0  // position du caractere /
      xposition1 est un entier = 1 // position du caractere )
      souschaine est une chaine
      i est un entier = 1
      formule1 est une chaine
      res est une chaine
      boucle
      	xposition = position(Formulaverifier,"/",xposition+1)
      	si xposition = 0 alors
      		sortir
      	FIN
      	xposition1 = position(Formulaverifier,")",xposition)
          si xposition1 = 0 alors
             xposition1 = taille(Formulaverifier)
          fin
          	
      	souschaine = milieu(Formulaverifier,xposition+1,xposition1-xposition)
      	souschaine = remplace(souschaine,"(","")
      	souschaine = remplace(souschaine,")","")
      	formule1 = "y est un reel"+RC+"y="+souschaine+RC+"renvoyer y "
      	res = compile("formule2",formule1)
      	si ExécuteTraitement("formule2",trtProcédure) = 0 alors
      		renvoyer faux
      	FIN
      FIN
      
      renvoyer vrai
      
      
      
     type : 458752
   -
     name : RemplirArchivePrep
     procedure_id : 5068556070684600816
     type_code : 14
     code : |1+
      Procédure RemplirArchivePrep()
      
      pour tout TQtePrep
      	HCopieEnreg(ArchivePrep,TQtePrep)
      	hajoute(ArchivePrep)
      FIN
      
     type : 458752
   -
     name : MajCarrelageTRN
     procedure_id : 5220328107089376012
     type_code : 14
     code : |1+
      Procédure MajCarrelageTRN()
      HRAZ(TigerCarrelage)
      TigerCarrelage.vimprime = " "
      TigerCarrelage.vnoligne = tempo.tlignedecommande
      TigerCarrelage.vnoprep = tempo.tnumeroprep
      TigerCarrelage.vcommande = tempo.tcomm
      TigerCarrelage.vlignecommande = tempo.tnoetiq
      TigerCarrelage.vclientnom = gauche(tempo.tnomclient,gclconfig.m_nvjclient)
      TigerCarrelage.vdate = tempo.tdate
      // Modification nécessaire pour TRN.
      // TRN fonctionne avec le numéro de lot de OPTIMA
      // c'est ce numéro de lot qui apparait à l'écran de Tigerstop 
      // ce numéro est sauvegardé dans le champ vespace du fichier tiger
      // ce champ de sera jamais de plus de 2 caractere.
      TigerCarrelage.vespace  = sansespace(tempo.tespace)+"-"+sansespace(TrsfVideojet.NUMEROOPT)
      TigerCarrelage.vcommandeclient = tempo.tcommclient
      TigerCarrelage.vcapgazlowe = tempo.tcapgaztube
      TigerCarrelage.vtraitementspecial = tempo.ttraitementspecial
      TigerCarrelage.vpbase = tempo.tbase
      TigerCarrelage.vlargeur = tempo.tlargeur
      TigerCarrelage.vhauteur = tempo.thauteur
      TigerCarrelage.vcode   = tempo.TNumCarr
      tigercarrelage.vNbCarreauH = tempo.TCarreauH
      tigercarrelage.vNbCarreaul = tempo.TCarreauv
      tigercarrelage.vhauteurcontour = tempo.THauteurContour
      tigercarrelage.vlargeurcontour = tempo.TlargeurContour
      tigercarrelage.vhauteurtete = tempo.THauteurtete
      TigerCarrelage.vNumCarrBarrepos = 1   // pour empecher les doublons quand carrelage de tete avec
      										// barre du bas différente
      
      
      //si pas position(tempo.tcapgaztube,"I") = 0 alors
      //	TigerCarrelage.vesptype = "Inex"
      //sinon
      //	TigerCarrelage.vesptype = "Alu."
      //FIN
      //A FAIRE : Ajuster la ligne suivante
      SI HLITRECHERCHE(typespac,tnumero,TEMPO.TtypeSpacer) ALORS
      	//impvideo.vtypespacer"}    = tempo.TtypeSpacer
      	TigerCarrelage.vesptype  = GAUCHE(typespac.tdesccourte,5)
      FIN
      
      
      TigerCarrelage.vqte = tempo.tqte
      si hlitrecherche(invent,INUM,tempo.TNumCarr) alors
      	TigerCarrelage.vdescriptionCarr = invent.idesc
      fin
      
      
      TigerCarrelage.vcarrelage = tempo.tcarrelage
      
      si sansespace(Tempo.tcouleurcarr) <> ""  ou sansespace(tempo.tcouleurcarr2) <> "" alors
      	TigerCarrelage.vpeinture = vrai
      sinon
      	TigerCarrelage.vpeinture = faux
      FIN
      tigercarrelage.VNoForme = tempo.tnoforme
      CAlculCarrelage()
      hajoute(TigerCarrelage)
      si herreurdoublon() alors
      FIN
      
      
     type : 458752
   -
     name : ImprimeBonLivraison
     procedure_id : 5605172987089101648
     type_code : 14
     code : |1-
      Procédure ImprimeBonLivraison(NoEnregistrement)
      j est un entier
      i est un entier
      numerofacture est un entier 
      lAdresseCourriel est une chaine
      lNumeroClient est une chaine
      ListeFichier est une chaine
      ListeNoFacture est une chaine
      lSujet est une chaine
      lMessage est une chaine 
      lCommandeTransferee est une chaine
      lNbCopieBlivraison est un entier
      lnomfichier est une chaine
      
      //hlit(config,1)
      lNbCopieBlivraison = gclconfig.m_nnbcopieBlivraison
      
      OuvreSoeur(FenAttentePetite)
      
      
      
      
      
      numerofacture =TrouveProchainNumero()
      
      
      si numerofacture = 0 alors goto SortieSurErreur
      
      hraz(BonLivraison)
      epurefacturetrn(NoEnregistrement,numerofacture)
      bonlivraison.Bclient = hfacture.faclient
      bonlivraison.bdate =DateDuJour()
      bonlivraison.Bnumero = numerofacture
      bonlivraison.Bcommandeclient = hfacture.fanocommande
      bonlivraison.Bnocommande = hfacture.fanumero
      bonlivraison.bstotal = hfacture.fatotal
      bonlivraison.btvh = hfacture.fatps
      bonlivraison.bTauxTvh = gclconfig.m_rtauxtps
      bonlivraison.bTauxTvq = gclconfig.m_rtauxtvq
      bonlivraison.brien = numeriqueverschaine(hfacture.fatypedocument)
              BonLivraison.cvendeur = hfacture.cvendeur
      hajoute(BonLivraison)
      
      pour tout hfacture avec "bnumero = " + BonLivraison.Bnumero
      	pour tout Fcoutant avec "cNoCommande = "+ hfacture.fanumero
      		fcoutant.CdateLivraison = BonLivraison.bdate
      		fcoutant.CNoBlivraison = bonlivraison.bnumero
      		hmodifie(Fcoutant,hnumenrencours)
      	FIN
      	pour tout Fcoutantligne avec "cNoCommande = "+ hfacture.fanumero
      		fcoutantligne.CdateLivraison = BonLivraison.bdate
      		fcoutantligne.CNoBlivraison = bonlivraison.bnumero
      		hmodifie(Fcoutantligne,hnumenrencours)
      	FIN
      fin	
      
      
      si herreurdoublon() alors
      FIN
      hexecuterequete(RequeteBlEtat,hrequetedefaut,bonlivraison.bnumero)
      
      	iFenêtreAbandon(faux)
      	FenAttentePetite.libelle1 = "Impression du Bon de livraison "+BonLivraison.bnumero
      	multitache(50)
      	iconfigure(sansespace(imprimantefacture),vrai)
      	iParamètre("DEFAUT=NON")
      //	iParamètre("COPIES="+lnbcopieBlivraison)
      	iParamètre("QUALITE=HAUTE")
      //	iimprimeetat(BonLivraisontrn)
          iimprimeetat(BonLivraisonMultiple,lNbCopieBlivraison)
      
      
      
      
      ferme(FenAttentePetite)
      
      goto SortieSansErreur
      
      // Se rend ici si on a pas été capable d,assigner un numéro de bon de livraison
      // Incapable de Bloquer le fichier config
      
      SortieSurErreur:
      
      
      SortieSansErreur:
      
      //info(lCommandeTransferee)
     type : 458752
   -
     name : TrouveProchainNumero
     procedure_id : 5605192121081241016
     type_code : 14
     code : |1+
      Procédure TrouveProchainNumero()
      valeurarerourner est un entier = 0
      _continuer est un booleen
      
      
      boucle
      
      	hlitpremier(config,COCLEUNIK,HBlocageEcriture)
      
      	si HErreurBlocage() alors
      		si acso_message("Question","Impossible d'assigner un numéro de Bon de Livraison"+rc+"Le fichier de configuration est possiblement utilisé par un autre utilisateur"+rc+...
      			"Il devrait être disponible dans quelques secondes."+rc+"Essayer de nouveau","OuiNon")=idno alors 
      			_continuer = faux
      			sortir
      		fin
      	sinon
      		_continuer = vrai
      		sortir
      	fin
      fin
      //sinon
      
      si _continuer alors
      	boucle
      		valeurarerourner = config.numbl
      		config.numbl++
      		hmodifie(config,hNumEnrEnCours)
              HForceEcriture(config)
      		si pas hlitrecherche(BonLivraison,Bnumero,valeurarerourner) alors
      			sortir
      		fin
      
      	fin
      
      	hdebloquefichier(config)
      
      fin
      
      renvoyer valeurarerourner
      
     type : 458752
   -
     name : epurefactureTRN
     procedure_id : 5605193477053575598
     type_code : 14
     code : |1+
      Procédure epurefactureTRN(numeroenregistrement,lignedetable)
      
      majhistorique(numeroenregistrement,lignedetable)
      toutelafacture = vrai
      
      hlit("Facture",numeroenregistrement)
      
      RequetefactureDetail.pNoComm = facture.fanumero
      RequetefactureDetail.pNoLigne = null
      
      HExécuteRequête(requetefacturedetail,hModifieFichier)
      
      //hlitrecherche("fdetail","fdnocomm",facture.fanumero)
      
      //Code WinDev 5.5 remplacé par la migration :
      //tantque fdetail.fdnocomm = facture.fanumero et pas h.endehors
      //tantque fdetail.fdnocomm = facture.fanumero et pas HEnDehors()
      Pour tout RequetefactureDetail
      	RequetefactureDetail.fdqtedejafacture =  RequetefactureDetail.fdqtedejafacture +RequetefactureDetail.fdqteafacturer
      	RequetefactureDetail.fdqteafacturer = RequetefactureDetail.fdqte -RequetefactureDetail.fdqtedejafacture
      	RequetefactureDetail.SUrchargedejafacture = RequetefactureDetail.SUrchargedejafacture+RequetefactureDetail.SUrchargeafacturer
      	RequetefactureDetail.SUrchargeafacturer = RequetefactureDetail.surchargeenergie- RequetefactureDetail.SUrchargedejafacture
      	si RequetefactureDetail.fdqteafacturer <> 0 alors  // = fdetail.fdqte-fdetail.fdqtedejafacture alors  
      		//     hcopieenreg("aliasfdet","fdetail")
      		//	 hajoute("aliasfdet")
      		//	 hsupprime("fdetail")
      		//   sinon
      		toutelafacture = faux
      	fin
      	hmodifie(RequetefactureDetail,hNumEnrEnCours)
      	//     hcopieenreg("aliasfdet","fdetail")
      	//	 hajoute("aliasfdet")
      
      //hlitsuivant("fdetail","fdnocomm")
      
      FIN
      
      //hcopieenreg("aliasfac","facture")
      //hajoute("aliasfac")
      
      si toutelafacture alors
      //    hsupprime(facture,hNumEnrEnCours)
      	facture.FPREPARATION = "B"
      	facture.livrepartiel = ""
      	hmodifie(Facture,hNumEnrEnCours)
      sinon
          facture.livrepartiel = "P"
      	facture.faimprimer = 0
      	hmodifie(facture,hNumEnrEnCours)	
      FIN
      
     type : 458752
   -
     name : majhistorique
     procedure_id : 5605193537895507812
     type_code : 14
     code : |1-
      Procédure majhistorique(numeroenregistrement,nocommande)
      hgereintegrite(faux)
      
      multiplicateur est un entier
      //hlit(config,1)
      hlit("Facture",numeroenregistrement)
      si facture.fatypedocument  = 2 alors
      	multiplicateur = -1
      sinon
      	multiplicateur = 1	
      FIN
      hfacture.ftransfere      = faux
      hfacture.fanumero        = facture.fanumero
      hfacture.fadate          = facture.fdaterequise
      hfacture.fadatecommande  = facture.fadate
      hfacture.fatype          = facture.fatype
      hfacture.faclient        = facture.faclient
      hfacture.bnumero         = nocommande
      hfacture.fanofacture     = nocommande
      hfacture.fanojob         = facture.fanojob
      hfacture.fanocommande    = facture.fanocommande
      hfacture.fasecteur       = facture.fasecteur
      hfacture.facalcul        = facture.facalcul
      hfacture.fasurcharge     = facture.fasurcharge 
      hfacture.fatotal         = facture.fatotal     
      hfacture.fatps           = facture.fatps       
      hfacture.fatvq           = facture.fatvq       
      hfacture.fatypedocument  = Facture.fatypedocument
      hfacture.fareference     = Facture.fareference
      hfacture.fabonlivraison  = facture.fabonlivraison
      hfacture.NoLot           = facture.nolot
      hfacture.fafraistransport= Facture.fafraistransport * multiplicateur
      hfacture.fsurchargepeinture = facture.fsurchargepeinture
      hfacture.NoGlSurchargePeinture = facture.NoGlSurchargePeinture
      hfacture.idlivraison        = facture.idLivraison
      hfacture.SUrchargePeinture = facture.SUrchargePeinture
      hfacture.fpeinture = facture.fpeinture
      hfacture.idlivraison = facture.idLivraison
      hfacture.nom 			 = facture.nom
      hfacture.adresse 		 = facture.adresse
      hfacture.Ville 			 = facture.ville
      hfacture.CodePostal		 = facture.CodePostal
      hfacture.noTelephone	 = facture.noTelephone
      hfacture.ftypecredit     = facture.Ftypecredit
      hfacture.cvendeur  		 = facture.cvendeur
      hfacture.IDCamions    = Facture.IDCamions
      
      hajoute("hfacture")
      //Code WinDev 5.5 remplacé par la migration :
      //si hdoublon() alors
      si HErreurDoublon() alors
      	erreur("Impossible d'ajouter la facture "+numeriqueverschaine(facture.fanofacture,"10d"))
      	renvoyer vrai
      FIN
      
      
      //hlitrecherche(requetefacturedetail,fdnocomm,facture.fanumero)
      RequetefactureDetail.pNoComm = facture.fanumero
      RequetefactureDetail.pNoLigne = null
      HExécuteRequête(RequetefactureDetail)
      
      //Code WinDev 5.5 remplacé par la migration :
      //tantque requetefacturedetail.fdnocomm = facture.fanumero et pas h.endehors
      pour tout requetefacturedetail
      	//tantque requetefacturedetail.fdnocomm = facture.fanumero et pas HEnDehors()
      	si requetefacturedetail.fdqteafacturer <> 0 alors  
      		hfdetail.fdnocomm       = facture.fanumero
      		hfdetail.fdligne        = requetefacturedetail.fdligne
      		hfdetail.fdnumprod      = requetefacturedetail.fdnumprod
      		hfdetail.fddesc         = requetefacturedetail.fddesc
      		hfdetail.fdqte          = requetefacturedetail.fdqte
      		hfdetail.fdqteafacturer = requetefacturedetail.fdqteafacturer  * multiplicateur
      		hfdetail.fdqtedejafacture = requetefacturedetail.fdqtedejafacture  * multiplicateur
      
      		hfdetail.fdespace       = requetefacturedetail.fdespace
      		hfdetail.fdlargeur      = requetefacturedetail.fdlargeur
      		hfdetail.fdhauteur      = requetefacturedetail.fdhauteur
      		hfdetail.fdhauteur1     = requetefacturedetail.fdhauteur1
      		hfdetail.fdlargeura     = requetefacturedetail.fdlargeura
      		hfdetail.fdhauteura     = requetefacturedetail.fdhauteura
      		hfdetail.fdhauteur1a    = requetefacturedetail.fdhauteur1a
      		hfdetail.fdprixu        = requetefacturedetail.fdprixu
      		hfdetail.fdcarrelage    = requetefacturedetail.fdcarrelage
      		hfdetail.fdcarreauh     = requetefacturedetail.fdcarreauh
      		hfdetail.fdcarreauv     = requetefacturedetail.fdcarreauv
      		hfdetail.fdnumcarr      = requetefacturedetail.fdnumcarr
      		hfdetail.ftype          = requetefacturedetail.ftype
      		hfdetail.fdprixtotal    = requetefacturedetail.fdprixtotal
      		hfdetail.fdcarrpruxuc   = requetefacturedetail.fdcarrpruxuc
      		hfdetail.frcarrprixu    = requetefacturedetail.frcarrprixu * multiplicateur
      		hfdetail.fdcarrprixtotal= requetefacturedetail.fdcarrprixtotal * multiplicateur
      		hfdetail.fdprixupied    = requetefacturedetail.fdprixupied
      		hfdetail.fdcodegl       = requetefacturedetail.fdcodegl
      		hfdetail.fcapgaztube    = requetefacturedetail.fcapgaztube 
      		hfdetail.fdverreunite   = requetefacturedetail.fdverreunite
      		hfdetail.fdnofact       = nocommande
      		hfdetail.FDJOBLIGNE      = requetefacturedetail.FDJOBLIGNE
      		hfdetail.fdcomposant1    =requetefacturedetail.fdcomposant1
      		hfdetail.fdcomposant2    =requetefacturedetail.fdcomposant2
      		hfdetail.fdcomposant3    =requetefacturedetail.fdcomposant3
      		hfdetail.fdcarrprixdebase=requetefacturedetail.fdcarrprixdebase * multiplicateur
      		hfdetail.surchargeenergie=requetefacturedetail.surchargeenergie  * multiplicateur
      		hfdetail.fdcommentaire   = requetefacturedetail.fdcommentaire
      		hfdetail.fdlargeuru      = requetefacturedetail.fdlargeuru
      		hfdetail.fdhauteuru      = requetefacturedetail.fdhauteuru
      		hfdetail.fdforme         = requetefacturedetail.fdforme
      		hfdetail.fdextraforme    = requetefacturedetail.fdextraforme //* MULTIPLICATEUR
      		hfdetail.HFCLEUNIK       = hfacture.HFCLEUNIK
      		hfdetail.ffini           = requetefacturedetail.ffini 
      		hfdetail.fdhauteuranglais=RequetefactureDetail.fdhauteuranglais
      		hfdetail.fdhauteuranglais1=RequetefactureDetail.fdhauteuranglais1
      		
      		hfdetail.fdlargeuranglais=requetefacturedetail.fdlargeuranglais
      		hfdetail.fdpiedcarre     = requetefacturedetail.fdpiedcarre
      		hfdetail.fdpiedcarrefacture=requetefacturedetail.fdpiedcarrefacture
      		hfdetail.ftypespacer       = requetefacturedetail.ftypespacer
      		hfdetail.FDespace2         = requetefacturedetail.FDespace2
      		hfdetail.fdprixupiedfacture=requetefacturedetail.fdprixupiedfacture
      		hfdetail.fdextracap       = requetefacturedetail.fdextracap //* MULTIPLICATEUR 
      		hfdetail.fnotes           = requetefacturedetail.fnotes
      		hfdetail.fnotes1           = requetefacturedetail.fnotes1
      		hfdetail.fdvariablex       = requetefacturedetail.fdvariablex
      		hfdetail.fdvariablex1       = requetefacturedetail.fdvariablex1
      		hfdetail.fdtypecalcul     = requetefacturedetail.fdtypecalcul
      		hfdetail.fdnbcarreau       = requetefacturedetail.fdnbcarreau
      		hfdetail.fTypePeinture         = requetefacturedetail.fTypePeinture
      		hfdetail.fNoPeintureExtTout     = requetefacturedetail.fNoPeintureExtTout
      		hfdetail.FnopeintureInterieure     = requetefacturedetail.FnopeintureInterieure
      		hfdetail.fdescpeintureExtTout    = requetefacturedetail.fdescpeintureExtTout
      		hfdetail.fDescPeintureInterieure    = requetefacturedetail.fDescPeintureInterieure
      		hfdetail.fTotalPeinture             = requetefacturedetail.fTotalPeinture
      		hfdetail.fPrixCarreauPeinture      = requetefacturedetail.fPrixCarreauPeinture
      		hfdetail.Ftotalcarreaupeinture     = requetefacturedetail.Ftotalcarreaupeinture
      		hfdetail.fpeinture                  = requetefacturedetail.fpeinture
      		hfdetail.libelleNbCarreauExtTlt     = requetefacturedetail.libelleNbCarreauExtTlt
      		hfdetail.libelleNbcarreauinterieur     = requetefacturedetail.libelleNbcarreauinterieur
      		hfdetail.FtotalbarrePeinture     = requetefacturedetail.FtotalbarrePeinture
      		hfdetail.fnopeinture = requetefacturedetail.fnopeinture
      		hfdetail.fdescpeinture = requetefacturedetail.fdescpeinture
      		hfdetail.fextrapeinture = requetefacturedetail.fextrapeinture
      		hfdetail.fdescpeinture1 = requetefacturedetail.fdescpeinture1
      		hfdetail.fTypePeinture1     = requetefacturedetail.fTypePeinture1
      		hfdetail.fnopeinture1 = requetefacturedetail.fnopeinture1
      		hfdetail.FDnbcarreauPeinture1 = requetefacturedetail.FDnbcarreauPeinture1
      		hfdetail.fdprixcarreaupeinture1 = requetefacturedetail.fdprixcarreaupeinture1
      		hfdetail.fdfabrication = requetefacturedetail.FDfabrication
      		hfdetail.SUrchargeafacturer = requetefacturedetail.SUrchargeafacturer
      		hfdetail.surchargeenergie = requetefacturedetail.SUrchargeafacturer
      		hfdetail.SUrchargedejafacture = requetefacturedetail.SUrchargedejafacture
      		hfdetail.FDextra10X=requetefacturedetail.FDextra10x
      		hfdetail.FDextra5X=requetefacturedetail.FDextra5x
      		hfdetail.TDemiCarrelage = requetefacturedetail.TDemiCarrelage
      		hfdetail.FDextraCarrelagedemi = requetefacturedetail.FDextraCarrelagedemi
      		hfdetail.fdpiedcarrefacture = requetefacturedetail.fdpiedcarrefacture
      		hfdetail.fdsurfacemodifie = requetefacturedetail.fdsurfacemodifie
      		hfdetail.FDprixmodifie = requetefacturedetail.FDprixmodifie
      		hfdetail.ExtraArgonPrice = Fdetail.ExtraArgonPrice
      		hfdetail.CalculArgon = Fdetail.CalculArgon
      		hfdetail.PietageArgon = Fdetail.PietageArgon
      		hfdetail.fdbase = Fdetail.fdbase
      		hfdetail.fnolot = fdetail.fnolot
      		
      
      		hajoute("hfdetail")
      
      
      
      	fin
      	//hlitsuivant("requetefacturedetail","fdnocomm")
      
      
      FIN
      
      hgereintegrité(vrai)
