  -
    name : BTN_OK_2
    identifier : 0x461b929171118c17
    internal_properties : 
    properties :
     x : 301
     y : 163
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         NoPrep est un entier
         
         si sansespace(NUMEROOPT) = "" et gTypeOptimisation = "optima" alors
         	ACSO_message("Erreur","Numéro de lot obligatoire","Erreur")
         	reprisesaisie(NUMEROOPT)
         FIN
         
         //memcree("enregistrement")
         
         ouvresoeur(FenAttente,"Recherche des commandes à transférer en cours")
         HExécuteRequête(RequeteCommandeEnPreparation)
         
         //hlitpremier(facture,fanumero)
         si HErreurBlocage() alors
         	acso_message("Erreur","Information deja en utilisation sur un autre poste","Erreur")
         
         FIN
         //tantque pas HEnDehors()
         //	si facture.FPREPARATION = "T" alors
         //		memajoute("enregistrement",hnumenr(Facture),hnumenr(facture))
         //	fin
         //	hlitsuivant(facture,fanumero)
         //	si HErreurBlocage() alors
         //		acso_message("Erreur","Facture numéro"+ facture.fanumero+" déjà en utilisation sur un autre poste","Erreur")
         //	FIN
         //FIN
         Ferme(FenAttente)
         
         
         HLitPremier(Tempo,TECLEUNIK)
         NoPrep = tempo.tnumeroprep
         
         iconfigure(imprimanterapport,vrai)
         iParamètre("DEFAUT=NON")
         iparametre("ORIENTATION = PAYSAGE")
         
         
         
         
         
         si pas  HNbEnr(RequeteCommandeEnPreparation) = 0 alors
         	si destination = 2 alors
         		iapercu(2,"Liste de transfert au vidéojet")
         	fin
         		iimprimeetat(TransfertVideojet,NoPrep)
         fin
         
         si iImpressionAbandonnée() alors
         	acso_message("Erreur","L'affichage ne s'est pas terminé normalement, le transfert est abandonné.","Erreur")
         	ferme(TrsfVideojet)
         FIN
         
         HExécuteRequête(requeteprep)
         si pas HNbEnr(RequeteCommandeEnPreparation) = 0 alors
         	si ACSO_message("Question","Transfert au videojet","OuiNon") = idyes alors
         
         		transférerVideojet()
         		hlitpremier(requeteprep)
         		tantque pas HEnDehors(requeteprep)
         			si hlitrecherche(facture,fanumero,requeteprep.fanumero) alors	
         				si pas intbl alors
         					facture.FPREPARATION = "F"
         				fin
         				facture.nolot = tempo.tnumeroprep
         				hmodifie("Facture")
         				pour tout fcoutant avec "cNoCommande ="+ facture.fanumero
         					fcoutant.nolot = facture.nolot
         					hmodifie(Fcoutant)
         				fin	
         				pour tout fcoutantligne avec "cNoCommande ="+ facture.fanumero
         					FcoutantLigne.nolot = facture.nolot
         					hmodifie(FcoutantLigne)
         				fin	
         			fin
         			hlitsuivant(requeteprep)
         		FIN
         
         		supprimetempo()
         		hlitpremier("infoprep","I1CLEUNIK",HBlocageEcriture)
         		si HErreurBlocage() alors
         			erreur("Information déja en utilisation sur un autre poste")
         		sinon
         			infoprep.ipdate = ""
         			hmodifie("infoprep")
         		fin
         	FIN
         fin
         RemplirArchivePrep()
         si pas FenEtat(FenAttentepetite) =  Inexistant alors
         	ferme(fenattentepetite)
         FIN
         sablier(faux)
         HDESACTIVEFILTRE("Facture")
         //memsupprimetout("enregistrement")
         ferme
        type : 18
      -
        type : 161
        enabled : false
