  -
    name : BTN_OK_1
    identifier : 0x3f7f046f400ee58c
    internal_properties : 
    properties :
     x : 766
     y : 56
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         memcree("enregistrement")
         
         hexecuterequete(RequetePrep)
         //hfiltre("Facture","facture.fpreparation = 'T'")
         si hnbenr(RequetePrep) = 0 alors
         	acso_message("Erreur","Aucune commande à transférer au Vidéojet","Erreur")
         	ferme
         FIN
         ouvresoeur(FenAttente,"Recherche des commandes à transférer en cours")
         
         hlitpremier(RequetePrep)
         si HErreurBlocage() alors
         	acso_message("Erreur","Information deja en utilisation sur un autre poste","Erreur")
         FIN
         tantque pas HEnDehors()
         	hlitrecherche("fdetail","fdnocomm",requeteprep.fanumero)
         	si HErreurBlocage() alors
         		acso_message("Erreur","La commande numéro "+sansespace(NumériqueVersChaine(requeteprep.fanumero,"10d"))+ "  n'a pu être traitée","Erreur")
         		hdesactivefiltre("Facture")
         		renvoyer vrai
         	FIN
         	tantque pas HEnDehors() et fdetail.fdnocomm = requeteprep.fanumero
         		memajoute("enregistrement",h.numenr,h.numenr)
         		hlitsuivant("fdetail","fdnocomm")  	
         		si HErreurBlocage() alors
         			acso_message("Erreur","La commande numéro "+sansespace(NumériqueVersChaine(requeteprep.fanumero,"10d"))+ "  n'a pu être traitée","Erreur")
         			hdesactivefiltre("Facture")
         			renvoyer vrai
         		FIN
         	FIN
         	hlitsuivant(requeteprep)
         	si HErreurBlocage() alors
         		acso_message("Erreur","Commande numéro "+requeteprep.fanumero+" deja en utilisation sur un autre poste","Erreur")
         	FIN
         
         FIN
         iconfigure(imprimanterapport,vrai)
         hlitrecherche("Rapport","RAPNOM","Bulletin de commande")
         si pas HEnDehors() et HTrouve() alors
         	iParamètre("DEFAUT=NON")
         	iParamètre("FORMATPAPIER=LEGAL")
         	iparametre("ORIENTATION = PAYSAGE")
         	iParamètre("QUALITE=HAUTE")
         
         fin
         
         ferme(fenattente)
         
         si pas memoccurrence("enregistrement") = 0 alors
         	si destination = 2 alors
         		iapercu(2,"Bulletin de commande")
         	fin
         	iimprimeetat("BULLETIN","enregistrement",rapport.raporientation)
         fin
         si pas memoccurrence("enregistrement") = 0 alors
         	si acso_message("Question","Transfert au videojet ?","OuiNon") = idyes alors
         		transférerVideojet()
         		hlitpremier(requeteprep)
         		tantque pas HEnDehors(requeteprep)
         			si hlitrecherche(facture,fanumero,requeteprep.fanumero) alors	
         				facture.FPREPARATION = "F"
         				hmodifie("Facture")
         			fin
         
         			hlitsuivant(requeteprep)
         		FIN
         
         		supprimetempo()
         		hlitpremier("infoprep","I1CLEUNIK",HBlocageEcriture)
         		si HErreurBlocage() alors
         			acso_message("Erreur","Information deja en utilisation sur un autre poste","Erreur")
         		sinon
         			infoprep.ipdate = ""
         			hmodifie("infoprep")
         		fin
         	FIN
         fin
         HDESACTIVEFILTRE("Facture")
         memsupprimetout("enregistrement")
         ferme
        type : 18
      -
        type : 161
        enabled : false
  -
    name : DESTINATION
    identifier : 0x3f7f04a57ff4ba64
    internal_properties : 
    properties :
     x : 165
     y : 146
     width : 86
     height : 58
    options :
     -
       internal_properties : CQAAAAkAAADc1QHFe4WxfwEGP3M/5Z+ZogK84kPeb4euVCoBcvF8/40lgvYIFjsiNYEv1duCra+L0PHPi6RAf1TYNpg7uYq/0RFebfnA/L3Z+FlSIE+EinTYlRhdqIj7u30dlEvy4m25yHyjjmutrJAXS49zodBV/lbrUzboh3WwmmAztw==
     -
       internal_properties : CQAAAAkAAAAjlb1XFSGQUmOXgFmS6fvUmAWtKLQIqinGCiLQ9fXkvk/Vglp7mcx1LjdnMVtUhCDOTt/6VtZDiXxvoG8oDqJDXbVEf/q4b1h0jc7bgs+9nRHYZ1BYwAlQPAhoY1Om8SiywEda2NWKQa/4wnZHC7OnGTdCHUX/OA==
