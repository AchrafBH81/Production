      -
        code : |1-
         iHautBasPageImbriqué(vrai)
         hexecuterequete(RequeteListeHistodetail,hRequêteDéfaut,lIdentifiant,1)
         si hnbenr(RequeteListeHistoDetail) <> 0 alors
         	iimprimeetat(ListeUniteClientHisto)
         	iterminepage()
         fin
         
         hexecuterequete(RequeteListeHistodetail,hRequêteDéfaut,lIdentifiant,2)
         si hnbenr(RequeteListeHistoDetail) <> 0 alors
         	iimprimeetat(ListeVerreUniteClientHisto)
         	iterminepage()
         fin
         
         hexecuterequete(RequeteListeHistodetail,hRequêteDéfaut,lIdentifiant,3)
         si hnbenr(RequeteListeHistoDetail) <> 0 alors
         	iimprimeetat(ListeCarrelageClientHisto)
         	iterminepage()
         fin
         hexecuterequete(RequeteListeHistodetail,hRequêteDéfaut,lIdentifiant,4)
         si hnbenr(RequeteListeHistoDetail) <> 0 alors
         	iimprimeetat(ListeThermosPrixClientHisto)
         	iterminepage()
         fin
         
         hexecuterequete(RequeteListeHistodetail,hRequêteDéfaut,lIdentifiant,5)
         si hnbenr(RequeteListeHistoDetail) <> 0 alors
         	iimprimeetat(ListePeintureClientHisto)
         	iterminepage()
         fin
         
         hexecuterequete(RequeteListeHistodetail,hRequêteDéfaut,lIdentifiant,6)
         
         si hnbenr(RequeteListeHistoDetail) <> 0 alors
         	iimprimeetat(ListeFormeClientHisto,client.numero)
         	iterminepage()
         fin
         
         hexecuterequete(RequeteListeHistodetail,hRequêteDéfaut,lIdentifiant,7)
         si hnbenr(RequeteListeHistoDetail) <> 0 alors
         	iimprimeetat(ListeExtraPrixClientHisto,client.numero)
         	iterminepage()
         fin
