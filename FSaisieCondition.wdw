 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1-
      PROCEDURE FSaisieCondition(NomBouton)
      idbouton est une chaine
   -
     code : |1+
      idbouton = droite(nombouton,taille(nombouton)-9)
      si gauche(idbouton,2) = "NM" alors
      	cstDescription..visible = vrai
      	FSaisieCondition.cstDescription..LiaisonFichier = "typecarr.tdescription"+"["+val(milieu(idbouton,3))+"]"
      FIN
      
      LibelléAlors..libelle = "Alors "+(gstylo(irougeclair)+idbouton)+ gstylo(inoir)+" ="
      
      FSaisieCondition.CsSi..LiaisonFichier = "typecarr.ConditionSi"+gauche(idbouton,2)+"["+val(milieu(idbouton,3))+"]"
      FSaisieCondition.CsAlors..LiaisonFichier = "typecarr.ConditionAlors"+gauche(idbouton,2)+"["+val(milieu(idbouton,3))+"]"
      
      fichierversecran(FSaisieCondition,typecarr)
      evenement("BtnClicDroite",".*",WM_rBUTTONDOWN)
      
     type : 34
   -
     type : 180
     enabled : false
   -
     type : 230
     enabled : false
   -
     type : 11
   -
     type : 12
   -
     type : 17
   -
     type : 13
  procedures :
   -
     name : ValideSaisie
     procedure_id : 4796939508644701719
     type_code : 14
     code : |1-
      
     type : 458752
   -
     name : BtnClicDroite
     procedure_id : 4797642314975990757
     type_code : 14
     code : |1+
      Procédure BtnClicDroite()
      AncienneValeur est une chaine = moimeme
      numerocomposante est une chaine
      si Minuscule(gauche(moimeme..nom,2)) = "cs" alors
      	si pas moimeme..etat <> actif  alors
      		moimeme = AncienneValeur + ouvre(FenetreAbrev)
      
      		moimeme..curseur = taille(moimeme + 1)
      		reprisesaisie(moimeme)
      	fin
      FIN
      
      
      
     type : 458752
  procedure_templates : []
  property_templates : []
