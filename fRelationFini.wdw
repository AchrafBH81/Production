     p_codes :
      -
        code : |1-
         HSurErreur(RelationEDI,hErrDoublon,"")
         
         pour i = 1 _a_ TableOccurrence(Table__tabrelationfini)
         	hraz(RelationEDI)
         	relationedi.TYpeObjet = 4
         	RelationEDI.IdClient = idclientcourant
         	
         	relationedi.descriptionEDIClient = Table__tabrelationfini.Description[i]
         	relationedi.fini = Table__tabrelationfini.Colonne1[i]
         	hajoute(relationedi)
         	si HErreurDoublon() alors
         
         	FIN
         FIN
         
         ferme(mafenetre)
        type : 18
      -
        type : 161
        enabled : false
