  -
    name : BtnModifie
    identifier : 0x2be227c4017509bb
    internal_properties : 
    properties :
     x : 985
     y : 147
     width : 42
     height : 39
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         test est un crelationthermos <- Table__tabrelationThermos
         
         
         
         TableSauvePositionEtSélection(Table__tabrelationThermos)
         si ouvre(fenRelationThermosFiche,test,"M") alors
         
         	tableaffiche(Table__tabrelationThermos)
         	TableRestaurePositionEtSélection(Table__tabrelationThermos)
         fin
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BtnAjout
    identifier : 0x2be227c4017709ca
    internal_properties : 
    properties :
     x : 985
     y : 100
     width : 42
     height : 39
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         
         AjoutFiche est un cRelationThermos = allouer un cRelationThermos()
         ouvre(fenRelationThermosFiche,AjoutFiche,"A")
         tableauajoute(relationThermos,AjoutFiche)
         //tableajouteligne(Table__tabrelationThermos,AjoutFiche)
         tableaffiche(Table__tabrelationThermos,taDébut)
         
        type : 18
      -
