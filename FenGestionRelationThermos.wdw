      -
        code : |1-
         
         FicheASupprimer est un cRelationThermos <- Table__tabrelationThermos
         FicheASupprimer.IsDeleted = pas FicheASupprimer.IsDeleted 
         tableaffiche(Table__tabrelationThermos,taCourantBandeau)
