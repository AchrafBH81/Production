     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         POUR CHAQUE relation de relationThermos
         	SI relation.isModified ALORS	relation.SaveRelation(idclientcourant)
         	SI relation.IsDeleted ALORS relation.Deleterelation()
         FIN
         Ferme()
         
        type : 18
      -
