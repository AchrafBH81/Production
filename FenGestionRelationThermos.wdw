 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1+
      procedure FenGestionRelationThermos(clclient est un mclient)
      idclientcourant est une chaine = clclient.m_numero
      txtreq est un chaine = [
      select * from relationedi where idclient = '%1' order by extracustomer
      ]
      Reqsql est une source de Données
      
      txtreq = ChaîneConstruit(txtreq,idclientcourant)
      relationThermos est un tableau de cRelationThermos
      
      si HExécuteRequêteSQL(Reqsql,hRequêteDéfaut,txtreq) alors
      	FichierVersTableau(relationThermos,reqsql)
      fin
      
      //tableselectplus(Table__tabrelationThermos,1)
      
      
      
   -
     code : |1+
      ListeAjoute(IsDeleted,gimage(BtnDeleted..image))
      ListeAjoute(IsModified,gImage(btnModifier..Image))
      
      
      tableaffiche(Table__tabrelationThermos)
      tableselectplus(Table__tabrelationThermos,1)
     type : 34
   -
     type : 180
     enabled : false
   -
     type : 230
     enabled : false
