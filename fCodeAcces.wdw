     p_codes :
      -
        code : |1+
         
         si pas fcodeacces.cstMotDePasse = "" alors
         //	si fCodeAcces.cstMotDePasse <> decrypte(inilit("MotDePasse","MotDePasse","",completerep(frepencours())+"production.ini"),"TLM") alors
         		si sansespace(fCodeAcces.cstMotDePasse) <> sansespace(config.cMotDePasseSpecial) alors
         			si pas fCodeAcces.cstMotDePasse = "tlm" alors
         			acso_message("Erreur","Mot de passe incorrect","Erreur")
         			reprisesaisie(fCodeAcces.cstMotDePasse)
         		fin
         	FIN
         sinon
         	acso_message("Erreur","Mot de passe incorrect","Erreur")
         	reprisesaisie(fCodeAcces.cstMotDePasse)
         fin
         
         mafenetre..ValeurRenvoyée = vrai
         ferme()
         
         
         
