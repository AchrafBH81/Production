    name : BTN_MODIFIE
    identifier : 0x2344ad93a65fc690
    internal_properties : 
    properties :
     x : 566
     y : 96
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         Ouvre(FEN_OptionsMenu,TABLE_UserGroup.COL_Description,TABLE_UserGroup.COL_IDUserGroup)
         TableAffiche(TABLE_UserGroup)
        type : 18
      -
