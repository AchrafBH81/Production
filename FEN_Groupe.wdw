  -
    name : BTN_DETRUIRE
    identifier : 0x2344ae43a6957370
    internal_properties : 
    properties :
     x : 566
     y : 152
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         si TABLE_UserGroup.COL_Description = "Admin" alors
         	Erreur("Impossible de supprimer ce groupe")
         	renvoyer faux
         FIN
         
         
         sdReqsql est une source de données
         si HExécuteRequêteSQL(sdReqsql,hRequêteDéfaut,"select * from usager where idgroupe = " + TABLE_UserGroup.COL_IDUserGroup) alors
         	si hnbenr(sdReqsql) > 0 alors
         	   Erreur("Impossible de supprimer ce groupe "+RC+"Il est configuré dans la fiche de certains usagers")
         	sinon
         		Si ouinon("Voulez-vous supprime le groupe "+TABLE_UserGroup.COL_Description) = Oui ALORS
         			HExécuteRequêteSQL(sdReqsql,hRequêteDéfaut,"delete from securite where idgroupe = " + TABLE_UserGroup.COL_IDUserGroup) 
         			si hlitrecherche(UserGroup,IDUserGroup,TABLE_UserGroup.COL_IDUserGroup) alors
         				hsupprime(UserGroup,hNumEnrEnCours)
         				tableaffiche(TABLE_UserGroup)
         			FIN
         				
         		FIN
         	FIN
         FIN
        type : 18
      -
        type : 161
        enabled : false
