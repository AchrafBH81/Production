  -
    name : BTN_AJOUT
    identifier : 0x2344ad93a65dc681
    internal_properties : 
    properties :
     x : 566
     y : 58
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         sGroupename est une chaîne
         si saisie("Inscrivez le nom du groupe",sGroupename) = 1 alors
         	hRAZ(UserGroup)
         	usergroup.Description = sGroupename
         	usergroup.IsAdmin = False
         	hajoute(usergroup)
         	ouvre(FEN_OptionsMenu,UserGroup.Description,UserGroup.IDUserGroup)
         	tableaffiche(TABLE_UserGroup)
         FIN
         
         
        type : 18
      -
        type : 161
        enabled : false
