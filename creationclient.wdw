     p_codes : []
  -
    name : BTN_SORTIE
    identifier : 0x3e9d90cd0437addc
    internal_properties : 
    properties :
     x : 6
     y : 5
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         ferme("creationclient")
         
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_OK
    identifier : 0x3e9d90cd4766ade6
    internal_properties : 
    properties :
     x : 70
     y : 5
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         
         selon gLogCompt
         	cas "Acomba"	
         		si ltype = "M"  alors
         			EcranVersFichier(creationclient,client)
         			hmodifie(client,hNumEnrEnCours)
         		sinon
         			si acso_message("Question","Voulez-vous importer cette fiche ?","OuiNon") = idyes alors
         				client.numero  = creationclient.numero
         				client.nom     = creationclient.nom
         				client.crue    = creationclient.crue
         				client.cville  = creationclient.cville
         				client.ccodepostal = creationclient.ccodepostal
         				client.ctelephone  = creationclient.ctelephone
         				client.cfax        = creationclient.cfax
         				client.secteur     = "1"
         				client.videojet  = "1"
         				si modifclient alors
         					hmodifie(client)
         				sinon
         					hajoute(client)
         				fin
         				acso_message("Information","Importation réussie","Info")
         				raz()
         				btn_sortie..etat = actif; btn_sortie..Visible=Vrai
         				btn_ok..etat = grisé; btn_ok..Visible=Vrai
         				btn_annule..etat = grise; btn_annule..Visible=Vrai
         			FIN
         		fin
         		
         	cas "Cameleon","Aucun"
         		selon ltype
         			cas "A"
         				si sansespace(numero) = "" ALORS
         					ACSO_message("Erreur","Le numéro est obligatoire","Erreur")
         					reprisesaisie(numero)
         				fin
         				si sansespace(nom) = "" ALORS
         					ACSO_message("Erreur","Le nom est obligatoire","Erreur")
         					reprisesaisie(nom)
         				fin
         
         				ecranversfichier(creationclient,client)
                         client.cetat = 1
         				hajoute(client)
         
         
         			cas "M"
         				ecranversfichier(creationclient,client)
         				hmodifie(client)	 
         		fin
         FIN
         ferme(creationclient)
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_ANNULE
    identifier : 0x3e9d90cd71b9adf0
    internal_properties : 
    properties :
     x : 118
     y : 5
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         //Code WinDev 5.5 remplacé par la migration :
         //btn_sortie..etat =actif
         btn_sortie..etat =actif; btn_sortie..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         //btn_ok..etat = grisé
         btn_ok..etat = grisé; btn_ok..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         //btn_annule..etat = grisé
         btn_annule..etat = grisé; btn_annule..Visible=Vrai
         raz()
         ferme()
        type : 18
      -
        type : 161
        enabled : false
  -
    name : numero
    identifier : 0x3e9d90cd6d51adfa
    internal_properties : 
    properties :
     x : 59
     y : 48
     width : 123
     height : 24
    type : 2
    code_elements :
     type_code : 3
     p_codes :
      -
        code : |1+
         selon gLogCompt
         	cas "Acomba"	
         		si pas moimeme = "" alors
         			tableaureponse est un tableau dynamique  
         			si ACCC_FicheExiste(moimeme) alors
         				tableaureponse =  ACCC_FicheLecture(ACCC_FicheCardPos(moimeme))
         				creationclient.nom = tableaureponse[4]
         				creationclient.crue = tableaureponse[5]
         				creationclient.cville = tableaureponse[6]
         				creationclient.ccodepostal = tableaureponse[7]
         				creationclient.ctelephone = tableaureponse[9]
         				creationclient.cfax = tableaureponse[11]
         				btn_ok..etat = actif
         				btn_annule..etat =actif
         				hlitrecherche(client,numero,moimeme)
         				si htrouve(client) alors
         					modifclient = vrai
         				sinon
         					modifclient = faux
         				fin	
         			sinon
         				acso_message("Erreur","Client inexistant dans ACOMBA","Erreur")
         			FIN
         		fin
         	cas "Cameleon","Aucun"
         		si pas moimeme = "" alors
         			si ltype = "A" alors
         				si hrecherche(client,numero,moimeme,hIdentique) alors
         					acso_message("Erreur","Ce numéro de client existe déjà","Erreur")
         				FIN
         			fin
         		fin
         fin
         
        type : 16
