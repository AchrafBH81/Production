 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1+
      procedure creationclient(ltype = "A",lcomptabilite="")
      // Pour compatibilité 5.5
      MoiMême..Visible=Vrai
          global
      	modifclient est un booleen 
      
      
   -
     code : |1-
      selon ltype
      	cas "A"
      		hraz(client)
      
      		selon gLogCompt
      			cas "Cameleon","Aucun"
      				FicheClient..etat = actif
      				validation..etat = actif
      		FIN
      		Combo_vendeur = 1
      		
      	cas "M"
      		fichierversecran(creationclient,client)
      		selon gLogCompt
      			cas "Cameleon","Aucun"
      				FicheClient..etat = actif
      				numero..etat = inactif
      				validation..etat = actif
      			cas "Acomba"
      				numero..etat = inactif
      				GrpContact..etat = actif
      				validation..etat = actif
      		FIN
      FIN
     type : 34
   -
     type : 180
     enabled : false
   -
     type : 230
     enabled : false
   -
     code : |1+
      	 //avantage.av_deconnecter(nomdelasocket01)
      
     type : 2
   -
     type : 11
   -
     type : 12
   -
     type : 17
   -
     type : 13
  procedures :
   -
     name : oteguillemet
     procedure_id : 4511921611979402846
     type_code : 14
     code : |1+
      Procédure oteguillemet(lachaine,laposition)
      positiondepart est un entier= laposition+1
      positionfin est un entier= position(lachaine,"""",positiondepart)-1
      lalongueur est un entier = positionfin-positiondepart+1
      laposition = positionfin+3
      renvoyer milieu(lachaine,positiondepart,lalongueur)
      
     type : 458752
  procedure_templates : []
  property_templates : []
