  -
    name : BTN_OK
    identifier : 0x40322d4272b1e0c6
    internal_properties : 
    properties :
     x : 90
     y : 100
     width : 80
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         
        type : 14
      -
        code : |1+
         // Insérer ici le code de vérification du mot de passe
         si pas modeacces = "creation" alors
         	si sansespace(CaccesAncien) = "" alors
         		acso_message("Erreur","Votre ancien code d'accès ne peut pas être vide","Erreur")
         		reprisesaisie(CaccesAncien)
         	FIN
         fin
         //si facces.CaccesAncien <> decrypte(inilit("MotDePasse","MotDePasse","",completerep(frepencours())+"production.ini"),"TLM") alors
         si pas modeacces = "creation" alors
         	si facces.CaccesAncien <> sansespace(config.cMotDePasseSpecial) alors
         		si pas facces.CaccesAncien = "tlm" alors
         			acso_message("Erreur","Ancien code d'accès incorrect","Erreur")
         			reprisesaisie(FAcces.CaccesAncien)
         		fin
         	FIN
         
         fin
         
         
         si sansespace(cacces) = "" alors
         	acso_message("Erreur","Votre code d'accès ne peut pas être vide","Erreur")
         	reprisesaisie(cacces)
         FIN
         
         si CaccesConfirmation <> cacces alors
         	acso_message("Erreur","Votre code d'acces ne peut pas être validé","Erreur")
         	reprisesaisie(cacces)
         FIN
         
         si facces.Cacces = facces.CaccesAncien alors
         	acso_message("Erreur","Votre nouveau code d'acces ne peut pas être identique à l'ancien","Erreur")
         	reprisesaisie(cacces)
         
         FIN
         config.cMotDePasseSpecial=cacces
         hmodifie(config,hNumEnrEnCours)
         
         si modeacces = "creation" alors
         	acso_message("Info","Votre code d'accès à été créé avec succès","Info")
         sinon
         	acso_message("Info","Votre code d'accès à été modifié avec succès","Info")
         FIN
         ferme()
         
        type : 18
      -
        type : 161
        enabled : false
