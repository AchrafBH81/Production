  p_codes :
   -
     code : |1+
      Procedure FichierTransfertThermosNew(_pParam1="",gtabTransferReport est un tableau de STTransferReport=null)
      
      
      
      _posDebut est un entier
      _posFin est un entier
      
      gCurrentBorder est un Border
      gCurrentBorder.epaisseur = 0.5
      gCurrentBorder.couleur = noir
      
      gCurrentNoBorder est un Border
      gCurrentNoBorder.epaisseur = 1
      gCurrentNoBorder.couleur = itransparent
      
      
      
      
      
      
      
      
      
      
      
      
      
