  -
    name : BTN_DETRUIRE
    identifier : 0x273649ca0a5d21d8
    internal_properties : 
    properties :
     x : 190
     y : 6
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         
         // Suppression
         si Table_TypeBarrotin..Nouveau alors
         	si Table_TypeBarrotin..occurrence<2 alors
         		REPRISESAISIE(Table_TypeBarrotin)
         	sinon
         		TableSupprime(Table_TypeBarrotin)
         	fin
         sinon
         	si (Table_TypeBarrotin..Etat=AffichageSeulement ET Table_TypeBarrotin..Visible=Vrai) alors
         		acso_message("Erreur","Information déjà en utilisation ","Erreur")
         		retour
         	fin
         	si acso_message("Question","Voulez-vous supprimer l'enregistrement?","OuiNon") = idyes alors
         		TableSupprime(Table_TypeBarrotin)
         		si HErreurIntegrite() alors
         			Erreur(HErreurInfo())	// "Erreur d'intégrité"
         			Retour
         		Fin
         	fin
         fin
         
         si TableOccurrence(Table_TypeBarrotin)=0 alors
         	REPRISESAISIE(Table_TypeBarrotin)
         SINON
         	// Le bouton Supprimer est en interruption
         	// Il faut forcer l'entrée dans la nouvelle ligne
         
         	ExecuteTraitement(Table_TypeBarrotin,trtENTREELIGNE)
         fin
         tableaffiche(Table_TypeBarrotin)
        type : 18
      -
        type : 161
        enabled : false
