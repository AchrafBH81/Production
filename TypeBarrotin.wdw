     x : 414
     y : 71
     width : 32
     height : 32
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         selon gsType
         	CAS "A"
         		Barrotin.Bdescription	= SAI_barrotindescription
         		Barrotin.ExtraNumber	= SAI_barrotinExtra
         		Hajoute(Barrotin)
         		TableAffiche(Table_TypeBarrotin,taCourantEnreg)
         		
         	cas "M"	
         		barrotin.Bdescription = SAI_barrotindescription
         		barrotin.ExtraNumber = SAI_barrotinExtra
         		hmodifie(Barrotin,hnumenrencours)
         	AUTRE CAS
         		
         FIN
         mafenetre..plan = 1
        type : 18
      -
        type : 161
        enabled : false
