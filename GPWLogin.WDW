 message_bar :
  internal_properties : CQAAAAkAAADqkqJzxKWZdhJZp/UzUpDrQ13bqfT7Lj0SB5adlPUsY+Dz29xY08NEihX2V8ygvWy1akkZD/lviEMkNk57Ywtou72YQ0i9jVFSzZg14MfqrF4ueUm++SiBuaZYCHhd
 actionbar : {}
 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1+
      // Fenêtre de Login
      
      //-----------------------------------------------
      GPWUtilisateur est une source de données
      GPWUtilisateurConfiguration est une source de données
      GPWConfiguration est une source de données
      GPWConfigurationElement est une source de données
      GPWElement est une source de données
      //-----------------------------------------------
      
      global
      	gnNbEssai est un entier = 0					// nombre d'essai
      	gbAvecConfirmation est un booléen = vrai	// Vrai si la fenêtre affiche le champ de confirmation de mot de passe
      	constantE nNBESSAISMAX = 3					// nombre d'essais maximum
      	constante nMODIFHAUTEUR =30					// différence de hauteur lorsque la fenêtre est agrandie
      	gbSecurite est un booléen=Vrai				// Faux pour avoir la combo des utilisateurs
      
      // pas de confirmation de  mot de passe à l'ouverture de la fenêtre
      AvecConfirmation(faux)
   -
     code : |1+
      // si on en dans le mode LDAP ou en mode sécurisé
      SI gpwEnModeLDAP() ou gbSecurite ALORS
      	// on n'affiche pas une combo dans ce cas mais seulement un champ de saisie pour saisir son mot de passe
      	COMBO_Login..visible=Faux
      	SAI_LOGIN..visible=Vrai
      fin
      
      // initialise la combo auto-alimentée si on n'est pas en mode LDAP sans fichier
      SI pas gpwEnModeLDAP()
      	// initialisation
      	SI PAS gpwInitAnalyse() ALORS
      		MaFenêtre..ValeurRenvoyée=gpwErreur
      		Erreur(<§$0000§> + ErreurInfo())
      		Ferme()
      	FIN
      	
      	// si utilisation de la combo des utilisateurs
      	SI PAS gbSecurite ALORS
      		// description de la combo
      		COMBO_Login..RubriqueParcourue = "Login"
      		COMBO_Login..RubriqueAffichée = "Login"
      		COMBO_Login..RubriqueMémorisée = "Login"
      		COMBO_Login..FichierParcouru = "GPWUtilisateur"
      	
      		// intilisation de la combo auto alimentée
      		ListeAffiche(COMBO_Login,taInit)
      		ListeSelectMoins(COMBO_Login)
      	FIN
      FIN
     type : 34
   -
     type : 180
     enabled : false
   -
     type : 230
     enabled : false
   -
     type : 11
   -
     type : 12
   -
     type : 17
   -
     type : 13
  procedures :
   -
     name : VerifLogin
     procedure_id : 4312177304049488224
     type_code : 14
     code : |1+
      // Vérification du Login
      Procédure VerifLogin()
      
      // recherche du login dans le fichier
      HLitRecherchePremier("GPWUtilisateur","Login",Majuscule(gbSecurite ? SAI_Login sinon COMbo_Login))
      
      // un essai de plus
      gnNbEssai++
      
      // vérification de l'utilisateur
      VerifUtilisateur()
      
      // sortie si erreur
      SI MaFenêtre..ValeurRenvoyée<>gpwOk ALORS RETOUR
      
      // si le mot de passe n'est pas encore initialisé
      si GPWUtilisateur.MotPasseASaisir alors
      	// initialisation du mot de passe
      	InitialisationMotPasse()
      	// sortie si erreur
      	si mafenetre..ValeurRenvoyée<>gpwOk ALORS retour
      FIN
      
      // vérification du mot de passe
      VerifMotPasse()
      
     type : 458752
   -
     name : VerifUtilisateur
     procedure_id : 4312254488678779844
     type_code : 14
     code : |1+
      // Vérification de l'utilisateur saisie
      Procédure VerifUtilisateur()
      
      // si on n'est pas en mode LDAP
      	si pas HTrouve(GPWUtilisateur) alors
      		si gnNbEssai=nNBESSAISMAX alors
      			// utilisateur inconnu
      			erreur(<§$0002§>)
      			// fixe la valeur de retour
      			mafenetre..ValeurRenvoyée=gpwUtilisateurInconnu
      			// terminé
      			retour
      		FIN
      
      	// utilisateur inconnu
      	erreur(<§$0003§>)
      	// reprend la saisie
      	reprisesaisie(gbSecurite ? SAI_Login sinon COMBO_Login)
      fin
      
     type : 458752
   -
     name : InitialisationMotPasse
     procedure_id : 4312254801737902161
     type_code : 14
     code : |1+
      // Initialisation du mot de passe
      Procédure InitialisationMotPasse()
      
      // erreur de confirmation du mot de passe
      si majuscule(confirmation)<>majuscule(MotPasse) alors
      	erreur(<§$0005§>+rc+<§$0006§>)
      	reprisesaisie(MotPasse)
      FIN
      
      // modification de l'enregistrement dans le fichier
      GPWUtilisateur.MotPasse=Majuscule(MotPasse)
      GPWUtilisateur.MotPasseASaisir=faux
      si pas HModifie("GPWUtilisateur") ALORS
      	erreur(<§$0007§>+rc+<§$0008§>)
      	// fixe la valeur de retour
      	mafenetre..ValeurRenvoyée=gpwerreur
      FIN
      
     type : 458752
   -
     name : VerifMotPasse
     procedure_id : 4312264733254528567
     type_code : 14
     code : |1+
      // Vérification du mot de passe
      Procédure VerifMotPasse()
      
      // le mot de passe n'est pas correct
      si Majuscule(MotPasse)<>GPWUtilisateur.MotPasse ALORS
      	si gnNbEssai=nNBESSAISMAX alors
      		// mot de passe incorrect
      		erreur(<§$0001§>)
      		// fixe la valeur de retour
      		mafenetre..ValeurRenvoyée=gpwMotPasseInvalide
      		// terminé
      		retour
      	FIN
      
      	// mot de passe invalide
      	erreur(<§$0004§>)
      	// reprend la saisie
      	reprisesaisie(MotPasse)
      FIN
      
     type : 458752
   -
     name : AvecConfirmation
     procedure_id : 4320388400489363957
     type_code : 14
     code : |1+
      // Affiche ou cache le champ de confirmation du mot de passe
      // Entrée:	bAvec		Vrai affiche le champ
      //						Faux cache le champ
      Procédure AvecConfirmation(bAvec)
      
      // si la fenêtre est déjà dans le bon état
      // on ne fait rien
      si gbAvecConfirmation=bAvec alors retour
      
      // s'il faut afficher le champ
      si bAvec alors
      		// modification de la hauteur de la fenêtre
      		mafenetre..hauteur=mafenetre..HauteurInitiale
      		// modification de la position des champs
      		ok..Y=ok..YInitial
      		Annuler..y=Annuler..YInitial
      		// cache le champ de confirmation
      		GP_CONFIRM..Visible=vrai
      		Forme..visible=faux
      		// conserve l'état courant
      		gbAvecConfirmation=vrai
      
      // s'il faut cacher le champ
      sinon
      	// modification de la hauteur de la fenêtre
      	mafenetre..hauteur=mafenetre..HauteurInitiale-nMODIFHAUTEUR
      	// modification de la position des champs
      	ok..y=ok..YInitial-nMODIFHAUTEUR
      	Annuler..y=Annuler..YInitial-nMODIFHAUTEUR
      	// affiche le champs de confirmation
      	GP_CONFIRM..Visible=faux
      	Forme..visible=vrai
      
      	// conserve l'état courant
      	gbAvecConfirmation=faux
      FIN
      
     type : 458752
   -
     name : VerifConfirmation
     procedure_id : 1741774891127655892
     type_code : 14
     code : |1+
      // Il faut afficher la champ de confirmation du mot de passe
      // si l'utilisateur se connecte la première fois et que son mot de passe
      // est à saisir par l'utilisateur
      Procédure VerifConfirmation()
      
      SI PAS gpwEnModeLDAP() ALORS
      	// recherche du login dans le fichier
      	HLitRecherchePremier("GPWUtilisateur","Login",Majuscule(gbSecurite ? SAI_Login SINON COMBO_Login..ValeurAffichée))
      	// par défaut le champ est invisible
      	AvecConfirmation(Faux)
      	
      	// si l'utilisateur existe et qu'il doit confirmer son mot de passe
      	SI HTrouve("GPWUtilisateur") ET GPWUtilisateur.MotPasseASaisir ALORS
      		// le champ de confirmation devient visible
      		AvecConfirmation(Vrai)
      		// le focus est donné au champ contenant le mot de passe
      		RepriseSaisie(MotPasse)
      	FIN
      FIN
     type : 458752
  procedure_templates : []
  property_templates : []
