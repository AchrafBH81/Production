  -
    name : OK
    identifier : 0x3bd590f30b071ef4
    internal_properties : 
    properties :
     x : 77
     y : 178
     width : 80
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         // valeur renvoyée par défaut
         MaFenêtre..ValeurRenvoyée=gpwOk
         
         // si l'authentification n'est pas faite avec un annuaire LDAP
         SI PAS gpwEnModeLDAP() ALORS
         	// vérification du Login en allant lire dans le fichier
         	VerifLogin()
         fin
         
         si mafenetre..ValeurRenvoyée=gpwok ALORS
         	sablier()
         	mafenetre..ValeurRenvoyée=GPWLogin(gpwEnModeLDAP() ou gbSecurite ? SAI_Login sinon COMBO_Login..ValeurAffichée,MotPasse)
         	
         	// en LDAP, on affiche le message d'erreur après l'appel au GPWLogin
         	si gpwEnModeLDAP() et MaFenêtre..ValeurRenvoyée<>gpwOk et MaFenêtre..ValeurRenvoyée<>gpwAnnulation ALORS
         		// trop d'essais
         		si gnNbEssai=nNBESSAISMAX-1 ALORS
         			Ferme()
         		FIN
         		
         		// affiche l'erreur
         		Erreur(<§$000c§>+rc+RC+ErreurInfo())
         		
         		// un essai de plus
         		gnNbEssai++
         		
         		// redonne le focus à la saisie du login
         		RepriseSaisie(gpwEnModeLDAP() ou gbSecurite ? SAI_Login sinon COMBO_Login)
         	FIN
         FIN
         
         // fermeture de la fenêtre et lancement automatique de l'application
         ferme()
        type : 18
      -
        type : 161
        enabled : false
