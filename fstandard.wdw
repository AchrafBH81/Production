  -
    name : BTN_OK
    identifier : 0x3e9d90db5337e1a7
    internal_properties : 
    properties :
     x : 59
     y : 4
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         restaure_bouton()
         
         ecranversfichier
         si ajout alors
          hajoute("dimstand")
         fin
         si modif alors
          hmodifie("dimstand")
         fin
         //Code WinDev 5.5 remplacé par la migration :
         //si hdoublon() alors
         si HErreurDoublon() alors
         	erreur("Cette dimension existe déjà.","Apporter les corrections nécessaires")
         	
         sinon
         //Code WinDev 5.5 remplacé par la migration :
         // fiche..etat = actif
          fiche..etat = actif; fiche..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         // validation..etat = grisé
          validation..etat = grisé; validation..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         // STANDARD_SAISIE..ETAT = GRISE
          STANDARD_SAISIE..ETAT = GRISE; STANDARD_SAISIE..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         // PRIX..ETAT = GRISE
          PRIX..ETAT = GRISE; PRIX..Visible=Vrai
          ajout = faux
          modif = faux
         //Code WinDev 5.5 remplacé par la migration :
         // TABLE..ETAT = INACTIF
          TABLE..ETAT = AffichageSeulement; TABLE..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         // tableaffiche("TABLE","I")
          tableaffiche("TABLE",taDebut)
         fin
         
        type : 18
      -
        type : 161
        enabled : false
