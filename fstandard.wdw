  -
    name : BTN_DETRUIRE
    identifier : 0x3e9d90db4709e1e3
    internal_properties : 
    properties :
     x : 431
     y : 4
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         restaure_bouton()
         si acso_message("Question","Attention !!!!  Supprimer cette fiche entrainera la suppression de tous les liens avec les produits"+rc+"Voulez quand même la supprimer","OuiNon") = idyes
         	hlitrecherche("dimstrpr","ddimension",complete(tlargeurm,5)+complete(thauteurm,5))
         	tantque pas HEnDehors() et complete(dimstrpr.ddimension,10) = complete(tlargeurm,5)+complete(thauteurm,5)
         		hsupprime("dimstrpr")
         		hlitsuivant("dimstrpr","ddimension")
         	FIN
         
         	hlitrecherche("spdimdim","spdimension",complete(tlargeurm,5)+complete(thauteurm,5))
         	tantque pas HEnDehors() et complete(spdimdim.spdimension,10) = complete(tlargeurm,5)+complete(thauteurm,5)
         		hsupprime("spdimdim")
         		hlitsuivant("spdimdim","spdimension")
         	FIN
         
         	hlitrecherche("spdimstd","spdimension",complete(tlargeurm,5)+complete(thauteurm,5))
         	tantque pas HEnDehors() et complete(spdimstd.spdimension,10) = complete(tlargeurm,5)+complete(thauteurm,5)
         		hsupprime("spdimstd")
         		hlitsuivant("spdimstd","spdimension")
         	FIN
         
         
         
         
         	hsupprime("dimstand")
         	tableaffiche("TABLE",taDebut)
         fin
         
        type : 18
      -
        type : 161
        enabled : false
