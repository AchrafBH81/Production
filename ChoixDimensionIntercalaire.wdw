 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1+
      procedure choixIntercalaireCarrelage(ltabdimension est un tableau dynamique,lespacetotale est un reel,lTriple est un booleen = vrai)
      cpt est une entier
      pour cpt = 1 a  dimension(ltabdimension)/2
      	si ltriple ALORS
      		TableAjouteLigne(table1,extraitchaine(ltabdimension[cpt,1],1,","),ExtraitChaîne(ltabdimension[cpt,1],2,","),val(ltabdimension[cpt,2])-lespacetotale )
      	sinon
      		TableAjouteLigne(Table1,ltabdimension[cpt,1],"",ltabdimension[cpt,2] )
      	FIN
      FIN
      si pas ltriple alors table1.Intercalaire2..etat = grise
      mafenetre..ValeurRenvoyée = ""
      
      
      
   -
     type : 180
     enabled : false
