 code_elements :
  type_code : 13
  p_codes :
   -
     code : |1+
      Procedure _LISTE_UNITE_CARRELAGE_CLIENT(_pParam1="", _pParam2="", _pParam3="", _pParam4="")
      
      GLOBAL
      	numeroclient est une chaine = _pparam1
      
      si pas gImprimeCondPMT alors
      	GrpCondPmt..visible=faux
      sinon
      	iSubstBloc(BLOC_HAUT,EnteteComposante)
      	iSubstBloc(BLOC_CORPS,DetailComposante)
      FIN
      
      assigneLibelle()
     type : 327680
   -
     code : |1-
      
     type : 327696
  procedures :
   -
     name : assigneLibelle
     procedure_id : 5275275890367882744
     type_code : 14
     code : |1-
      Procédure assigneLibelle()
      i est un entier
      
      lTableauLibelle est un tableau de  21 chaines
      lTableauLibelle[1]  = "lentete,lentete"
      lTableauLibelle[2]  = "lvigueur,lvigueur"
      lTableauLibelle[3]  = "lremplace,lremplace"
      lTableauLibelle[4]  = "faccarrelage,faccarrelage"
      lTableauLibelle[5]  = "faccarrelage,Faccarrelage1"
      lTableauLibelle[6]  = "lnumero,lnumero"
      lTableauLibelle[7]  = "facdescription,facdescription"
      lTableauLibelle[8]  = "lprixcarreau,lprixcarreau"
      lTableauLibelle[9]  = "lprixcarreau,lprixcarreau1"
      lTableauLibelle[10]  = "lprix,lprixbase"
      lTableauLibelle[11]  = "lprix,lprixbase1"
      lTableauLibelle[12]  = "facpiedcarre,facpiedcarre"
      lTableauLibelle[13]  = "facmetrecarre,facmetrecarre"
      lTableauLibelle[14]  = "lvigueur,LVigueur"
      lTableauLibelle[15]  = "lvigueur,LVigueur1"
      lTableauLibelle[16]  = "lremplace,lremplace"
      lTableauLibelle[17]  = "lremplace,lremplace1"
      lTableauLibelle[18]  = "lentete,lEntete1"
      lTableauLibelle[19]  = "facdescription,facdescription"
      lTableauLibelle[20]  = "lcondpaiement,LCondpaiement"
      lTableauLibelle[21]  = "lcondpaiement,LCondpaiement1"
      
      
      selon client.CLangue
      	cas 1
      		pour i = 1 a 21
      			si hlitrecherche(Traduction,TRecherche,extraitchaine(lTableauLibelle[i],1,",")) alors
      				{"ListeCarrelageClientHisto."+ExtraitChaîne(lTableauLibelle[i],2,",")} = traduction.dFrancais
      			fin
      		FIN
      
      
      	cas 2
      		pour i = 1 a 21
      			si hlitrecherche(Traduction,TRecherche,extraitchaine(lTableauLibelle[i],1,",")) alors
      				{"ListeCarrelageClientHisto."+ExtraitChaîne(lTableauLibelle[i],2,",")} = traduction.danglais
      			fin
      		FIN
      fin
     type : 458752
