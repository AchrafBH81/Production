 controls : []
 code_elements :
  type_code : 13
  p_codes :
   -
     code : |1-
      fonction eachatintercalaire(gtabAchat est un tableau de STAchatIntercalaire,gbDetail est un booleen)
      
      
      si gbdetail alors
      	LIB_Description1..visible = faux
      sinon
      	DEBUT_RUPTURE1..visible = faux
      	corps..visible = faux
      	CALC_SansNom1..Cadre..Couleur = itransparent
      	
      	
      FIN
     type : 327680
