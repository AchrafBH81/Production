 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1-
      PROCEDURE MaFenêtre(gnNoCamion est un entier,gtaAllTruck est un tableau associatif de STAllTruck)
      
      gbTruckNumberChange est un booleen = Faux
      
      gstCamion est un STAllTruck
      gbChangeTruck est un booleen   //  pour savoir si le numéro de camion à été modifié
      
      pour chaque stCamion,sKeyTruck de gtaAllTruck
      	si val(sKeyTruck) <> gnnocamion alors
      		
      		COMBO_camion.ajoute("Camion"+sKeyTruck+gValeurMémorisée(sansespace(sKeyTruck)))
      	
      	FIN
      	
      FIN
      COMBO_camion.selectplus(1)
      SAI_TruckFrom	= "Camion"+gnnoCamion
      
      gbCancel est un booleen = faux
      
      mafenetre..ValeurRenvoyée = 0
   -
     code : |1+
      ExécuteTraitement(COMBO_camion,trtSélection)
     type : 34
   -
     type : 180
     enabled : false
   -
     type : 230
     enabled : false
   -
     code : |1+
      renvoyer (COMBO_camion,gbcancel)
     type : 2
