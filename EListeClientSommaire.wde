    code_elements :
     type_code : 30
     p_codes :
      -
        code : |1-
         si ltype = 3 alors
         	policebarre est une Police =policecree("Times New Roman", 10, iGras + iItalique)
         	
         	policenormal est une Police = policeCrée("Times New Roman", 10, igras)
         	
         	
         	
         	si client.cetat = 2 alors
         		rubrique2..police = policebarre
         		RUBRIQUE3..Police = policebarre
         		RUBRIQUE4..Police = policebarre
         		RUBRIQUE5..Police = policebarre
         	sinon
         		RUBRIQUE2..Police = policenormal
         		RUBRIQUE3..Police = policenormal
         		RUBRIQUE4..Police = policenormal
         		RUBRIQUE5..Police = policenormal
         	FIN
         	
         fin
        type : 327692
