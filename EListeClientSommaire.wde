 controls : []
 code_elements :
  type_code : 13
  p_codes :
   -
     code : |1-
      fonction EListeClientSommaire(lOrdre = "Nom",ltype = 1)
      si lordre = "Numero" alors
      		EListeClientSommaire..RubriqueParcourue = "numero"
      FIN
      selon ltype
      cas 1
      	LIBELLEType += "Actif"
      	CAS 2
      		LIBELLEType += "Inactif"
      	CAS 3
      		LIBELLEType += "Tous"
      fin
      	
      	
      	
     type : 327680
   -
     code : |1+
      si ltype <> 3 _et_ client.cetat <> ltype alors renvoyer Faux
      
     type : 327696
