        p_codes :
         -
           code : |1+
            si taille(sansespace(moimeme)) = 10 alors
            moimeme = gauche(moimeme,3)+"-"+milieu(moimeme,4,3)+"-"+milieu(moimeme,7,4)
            sinon si taille(sansespace(moimeme)) = 7 
            	moimeme = gauche(moimeme,3)+"-"+milieu(moimeme,4,4)
            fin
           type : 327692
