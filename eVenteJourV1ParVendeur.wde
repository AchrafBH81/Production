    code_elements :
     type_code : 30
     p_codes :
      -
        code : |1-
         
        type : 327694
      -
        code : |1+
         
         //// ****************** Nouveau code ****************************
         
         j est un entier
         indicecarr est un entier
         carrtrouve est un booleen = faux//A FAIRE :
         carrnogl est une chaine
         si RequeteDetailUnJourV1ParVendeur.ftype = 1 alors
         	lTypeLigne = "Verre"
         sinon si RequeteDetailUnJourV1ParVendeur.ftype = 2 
         	si pas RequeteDetailUnJourV1ParVendeur.fdverreunite alors
         		lTypeLigne = "Unite"
         	sinon
         		lTypeLigne = "Verre"
         	fin
         sinon si RequeteDetailUnJourV1ParVendeur.ftype = 3
         	ltypeligne = "Fourniture" 
         sinon si RequeteDetailUnJourV1ParVendeur.ftype = 4
         	ltypeligne = "Carrelage" 
         sinon si RequeteDetailUnJourV1ParVendeur.ftype = 5
         	ltypeligne = "Peinture" 
         fin
         
         //si RequeteDetailUnJourV1ParVendeur.ftype = 4 alors
         //	corps..visible = faux
         //sinon
         
         
         selon lTypeLigne
         	cas "Unite"
         	//	CORPS..VISIBLE = VRAI
         		rubrique17 = RequeteDetailUnJourV1ParVendeur.fdprixu
         		rubrique16 = 1
         		//		rubrique16..visible = faux
         	cas "Verre"	
         //		corps..visible = vrai
         		//		rubrique16..visible = vrai
         	cas "Carrelage"
         //		corps..visible = faux
                 iImprimeBloc(ITERATION1)
         	cas "Peinture"
         //		corps..visible = faux
         		iImprimeBloc(ITERATION2)
         fin
         
         
         
         
         
         //	si pas facturereimpression alors
         //		remplir_tableau(rubrique21,arrondi(rubrique4 * (rubrique16 * rubrique17),2))
         //	FIN
         
         //	totalpage +=  arrondi(RequeteDetailUnJourV1ParVendeur.fdqte * RequeteDetailUnJourV1ParVendeur.fdpiedcarrefacture * RequeteDetailUnJourV1ParVendeur.fdprixupiedfacture,2)
         //	totalfacture +=  arrondi(RequeteDetailUnJourV1ParVendeur.fdqte * RequeteDetailUnJourV1ParVendeur.fdpiedcarrefacture * RequeteDetailUnJourV1ParVendeur.fdprixupiedfacture,2)
         
         
         selon lTypeLigne
         	cas "Unite"
         		//		FIN
         		//		si RequeteDetailUnJourV1ParVendeur.ftype = 2 et pas RequeteDetailUnJourV1ParVendeur.fdverreunite alors
         		totalpage +=  arrondi(RequeteDetailUnJourV1ParVendeur.fdqteafacturer * RequeteDetailUnJourV1ParVendeur.fdprixu,2)
         		totalfacture +=  arrondi(RequeteDetailUnJourV1ParVendeur.fdqteafacturer * RequeteDetailUnJourV1ParVendeur.fdprixu,2)
         	cas "Fourniture"
         //		totalpage +=  arrondi(requetebletat.fdqte * requetebLETAT.fdprixupied,2)
         		totalfacture +=  arrondi(RequeteDetailUnJourV1ParVendeur.fdqteafacturer * RequeteDetailUnJourV1ParVendeur.fdprixupied,2)
         
         
         	cas "Verre"
         		//sinon
         //		totalpage +=  arrondi(RequeteDetailUnJourV1ParVendeur.fdqte * ((RequeteDetailUnJourV1ParVendeur.fdpiedcarrefacture * RequeteDetailUnJourV1ParVendeur.fdprixupiedfacture) + ...
         //		RequeteDetailUnJourV1ParVendeur.fdextraforme),2)
         		totalfacture +=  arrondi(RequeteDetailUnJourV1ParVendeur.fdqteafacturer * (RequeteDetailUnJourV1ParVendeur.fdpiedcarrefacture * RequeteDetailUnJourV1ParVendeur.fdprixupiedfacture),2)+ ...
         		arrondi(RequeteDetailUnJourV1ParVendeur.fdqteafacturer *RequeteDetailUnJourV1ParVendeur.fdextraforme,2)+arrondi(RequeteDetailUnJourV1ParVendeur.fdqteafacturer *RequeteDetailUnJourV1ParVendeur.FDextra10X,2)+...
         		arrondi(RequeteDetailUnJourV1ParVendeur.fdqteafacturer *RequeteDetailUnJourV1ParVendeur.FDextra5x,2)
         
         //		totalfacture +=  arrondi(RequeteDetailUnJourV1ParVendeur.fdqte * ((RequeteDetailUnJourV1ParVendeur.fdpiedcarrefacture * RequeteDetailUnJourV1ParVendeur.fdprixupiedfacture)+ ...
         //		RequeteDetailUnJourV1ParVendeur.fdextraforme),2)
         
         		totalthermos+=RequeteDetailUnJourV1ParVendeur.fdqteafacturer 
         
         		totalsurcharge += arrondi(RequeteDetailUnJourV1ParVendeur.surchargeenergie,2) //* RequeteDetailUnJourV1ParVendeur.fdqteafacturer / RequeteDetailUnJourV1ParVendeur.fdqte
         		totalcap+= arrondi(RequeteDetailUnJourV1ParVendeur.FDExtraCap * RequeteDetailUnJourV1ParVendeur.fdqteafacturer,2)
         
         
         
         	cas "Carrelage"
         		//		FIN
         		//		si RequeteDetailUnJourV1ParVendeur.ftype = 2 et pas RequeteDetailUnJourV1ParVendeur.fdverreunite alors
         		totalpage +=  arrondi(RequeteDetailUnJourV1ParVendeur.fdcarrprixtotal+RequeteDetailUnJourV1ParVendeur.fTotalPeinture,2)
         
         		totalfacture +=  arrondi((RequeteDetailUnJourV1ParVendeur.frcarrprixu + RequeteDetailUnJourV1ParVendeur.fdcarrprixdebase)* RequeteDetailUnJourV1ParVendeur.fdqteafacturer,2)...
         		+arrondi(((RequeteDetailUnJourV1ParVendeur.Ftotalcarreaupeinture*RequeteDetailUnJourV1ParVendeur.fPrixCarreauPeinture)...
         		+(RequeteDetailUnJourV1ParVendeur.FDnbcarreauPeinture1*RequeteDetailUnJourV1ParVendeur.fdprixcarreaupeinture1))...
         		* RequeteDetailUnJourV1ParVendeur.fdqteafacturer ,2)
         
         
         //		totalfacture +=  arrondi(RequeteDetailUnJourV1ParVendeur.fdcarrprixtotal+RequeteDetailUnJourV1ParVendeur.fTotalPeinture,2)
         		//		AlimenteHistoriqueProduit(sansespace(client.numero),RequeteDetailUnJourV1ParVendeur.BDateFacture,2,RequeteDetailUnJourV1ParVendeur.fdnumprod,"","","", arrondi(RequeteDetailUnJourV1ParVendeur.fdqte * RequeteDetailUnJourV1ParVendeur.fdprixu,2),...
         		//		RequeteDetailUnJourV1ParVendeur.surchargeenergie,RequeteDetailUnJourV1ParVendeur.fddesc,RequeteDetailUnJourV1ParVendeur.fdqte)
         		totalcarrelage+=RequeteDetailUnJourV1ParVendeur.fdqteafacturer * RequeteDetailUnJourV1ParVendeur.fdcarreauh * RequeteDetailUnJourV1ParVendeur.fdcarreauv
         
         	cas "Peinture"
         		//		FIN
         		//		si RequeteDetailUnJourV1ParVendeur.ftype = 2 et pas RequeteDetailUnJourV1ParVendeur.fdverreunite alors
         		totalpage +=  arrondi(RequeteDetailUnJourV1ParVendeur.fdprixtotal,2)
         		totalfacture +=  arrondi(RequeteDetailUnJourV1ParVendeur.fdqteafacturer * (RequeteDetailUnJourV1ParVendeur.fdpiedcarrefacture * RequeteDetailUnJourV1ParVendeur.fdprixupied),2)
         //		totalfacture +=  arrondi(RequeteDetailUnJourV1ParVendeur.fdprixtotal,2)
         		totaldepeinture+= arrondi(RequeteDetailUnJourV1ParVendeur.fdprixtotal,2) * RequeteDetailUnJourV1ParVendeur.fdqteafacturer / RequeteDetailUnJourV1ParVendeur.fdqte
         		//		AlimenteHistoriqueProduit(sansespace(client.numero),RequeteDetailUnJourV1ParVendeur.BDateFacture,2,RequeteDetailUnJourV1ParVendeur.fdnumprod,"","","", arrondi(RequeteDetailUnJourV1ParVendeur.fdqte * RequeteDetailUnJourV1ParVendeur.fdprixu,2),...
         		//		RequeteDetailUnJourV1ParVendeur.surchargeenergie,RequeteDetailUnJourV1ParVendeur.fddesc,RequeteDetailUnJourV1ParVendeur.fdqte)
         	
         fin
         
         
         
         
         
         
         
         
         
         
        type : 327692
      -
        code : |1+
         si RequeteDetailUnJourV1ParVendeur.ftype <> 4 alors
         
         
         
         
         	si pas sansespace(RequeteDetailUnJourV1ParVendeur.fnotes) = ""  ou RequeteDetailUnJourV1ParVendeur.fdextraforme <> 0 ALORS
         
         		iImprimeBloc(ITERATION3)	
         		//  totalpage +=  totalextraforme
         		//  totalfacture +=  totalextraforme
         	FIN
         	si pas sansespace(RequeteDetailUnJourV1ParVendeur.fnotes1) = ""   ALORS
         
         		iImprimeBloc(ITERATION5)	
         		//  totalpage +=  totalextraforme
         		//  totalfacture +=  totalextraforme
         	FIN
         sinon
         	si RequeteDetailUnJourV1ParVendeur.fpeinture alors
         
         		iImprimeBloc(ITERATION6)	
         
         	FIN
         fin
         
        type : 327693
      -
        type : 327697
        enabled : false
