     y : 156.486
     width : 269.4
     height : 3.44000000000003
    code_elements :
     type_code : 30
     p_codes :
      -
        code : |1+
         //QteCarr7 = RequeteDetailUnJourV1ParVendeur.fanocommande
         //numprodcarr1 = RequeteDetailUnJourV1ParVendeur.fp
         qtecarr9 = RequeteDetailUnJourV1ParVendeur.fdqte
         qtecarr28 = RequeteDetailUnJourV1ParVendeur.fdcarreauv
         qtecarr64 = RequeteDetailUnJourV1ParVendeur.fdcarreauh
         qtecarr65 = RequeteDetailUnJourV1ParVendeur.fdcarreauv * RequeteDetailUnJourV1ParVendeur.fdcarreauh
         PrixUnitCarr1 = RequeteDetailUnJourV1ParVendeur.fPrixCarreauPeinture
         TotalCarr1 =qtecarr65 * PrixUnitCarr1 * qtecarr9
         selon RequeteDetailUnJourV1ParVendeur.fTypePeinture
         	cas 2
         		DescriptionPeinture = "Peint.TLT" + RequeteDetailUnJourV1ParVendeur.fNoPeintureExtTout + " " + sansespace(RequeteDetailUnJourV1ParVendeur.fdescpeintureExtTout)
         	cas 1
         		DescriptionPeinture = "Peint. ext." + RequeteDetailUnJourV1ParVendeur.fNoPeintureExtTout + " " + sansespace(RequeteDetailUnJourV1ParVendeur.fdescpeintureExtTout)
         FIN
        type : 327692
      -
        code : |1+
         
         si sansespace(RequeteDetailUnJourV1ParVendeur.FnopeintureInterieure) <> "" alors
         	iImprimeBloc(ITERATION8)
         fin
         
        type : 327693
      -
        type : 327697
        enabled : false
