  -
    name : LEFINI
    identifier : 0x3e9d90b021603c9c
    internal_properties : 
    properties :
     x : 30
     y : 132
     width : 132
     height : 23
    type : 2
    code_elements :
     type_code : 3
     p_codes :
      -
        code : |1+
         loriginal = moimeme
        type : 15
      -
        code : |1+
         //hlitrecherche("inter","cleclientproduit",cl.numero+complete(finispeciaux.icomposant1,10)+...
         //                                               complete(finispeciaux.icomposant2,10)+...
         //											   complete(finispeciaux.icomposant3,10)+complete(moimeme,40))
         si moimeme <> loriginal alors
         	RequeteFiniSpacer.pClient = cl.numero
         	RequeteFiniSpacer.pComposant1 = finispeciaux.icomposant1
         	RequeteFiniSpacer.pComposant2 = finispeciaux.icomposant2
         	RequeteFiniSpacer.pComposant3 = finispeciaux.icomposant3
         	RequeteFiniSpacer.pFiniComplet = sansespace(moimeme)
         	RequeteFiniSpacer.pFini = null
         	HExécuteRequête(RequeteFiniSpacer)
         
         
         	//Code WinDev 5.5 remplacé par la migration :
         	//si pas h.endehors et h.trouve alors
         	si hnbenr(RequeteFiniSpacer) <> 0 alors
         		//si pas HEnDehors() et HTrouve() alors
         		erreur("Cette fiche existe déja")
         		reprisesaisie("finispeciaux.icomposant1")
         	fin
         fin
        type : 16
      -
        type : 276
        enabled : false
      -
        type : 277
        enabled : false
      -
