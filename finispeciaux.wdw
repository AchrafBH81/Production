  height : 331
  widthClient : 502
  heightClient : 299
 controls :
  -
    name : BTN_OK
    identifier : 0x3e9d90b067a83c60
    internal_properties : 
    properties :
     x : 439
     y : 43
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         
         // Validation de la fiche
         
         EcranVersFichier				// Transfert champs vers rubriques
         inter.iclient = CL.NUMERO
         
         // Enregistrement 
         selon ModeAppel
           cas "Création"
         	BOUCLE
         		// Adjonction de la fiche
         		HAjoute(NomFic)
                 mafenetre..ValeurRenvoyée = {nomfic+".i2cleunik"}
                 
         		// test de "à chacun son tour"
         		Si pas HErreurBlocage() alors SORTIR
         	FIN
           cas "Modif"
         		BOUCLE
         
         			HModifie(NomFic)			// Modification
         			si pas HErreurBlocage() alors sortir
         		fin
           autre cas
         	Erreur("Mode incorrect: "+ModeAppel)
         	retour
         fin
         si HErreurDoublon() alors
         	Erreur("Erreur de doublon sur clé unique")
         	Retour
         fin
         si HErreurIntegrite() alors
         	Erreur(HErreurInfo())
         	Retour
         fin
         
         SaisieOK=Vrai	// Signale saisie validée
         Ferme			// Ferme la fenêtre
         
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_ANNULE
    identifier : 0x3e9d90b061143c6a
    internal_properties : 
    properties :
     x : 439
     y : 90
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
