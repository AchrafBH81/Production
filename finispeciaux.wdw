 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1-
      Procedure Fiche(ModeAppel="Création",SaisieOK=Faux)
      MoiMême..Visible=Vrai
      
      Global
      NomFic			est une chaine		// Nom du fichier associé à la fenêtre
      NomFic="inter"
      loriginal est une chaine
      
      selon ModeAppel
        cas "Création"
      	GR_Champ..Etat=Actif; GR_Champ..Visible=Vrai
      
      	SI ensemblepersoactif alors
          sinon
           ecranpremier("icomposant1")
          fin
      		
      	//descr_produit = ""			// Champs liés actifs
      	RAZ			//  Efface les champs
      	HRAZ(NomFic)		// Efface les rubriques
      
      	// Tapez ici le code d'initialisation des champs
      
        cas "Modif"
      	GR_Champ..Etat=Actif; GR_Champ..Visible=Vrai			// Champs liés actifs
      
      	FichierVersEcran()
      //		finispeciaux.no_produit..etat = grisé
      //		finispeciaux.descr_produit..etat = grisé
      		finispeciaux.icomposant1..etat = grisé
      		finispeciaux.icomposant2..etat = grisé
      		finispeciaux.icomposant3..etat = grisé
      //    	finispeciaux.lefini..etat = grisé
      //		prixspeciaux.descr_produit..etat = grisé
      //		ecranpremier("finispeciaux.lespace")
      			
      				// Affiche les rubriques
        autre cas
      	Erreur("Mode d'appel de fenêtre incorrect: "+ModeAppel)
      	Ferme
      Fin
      //NUMEROEVENEMENT[1] = EVENEMENT("DOUBLECLIC","BTN_PRODUIT",WM_LBUTTONDBLCLK)
      //NUMEROEVENEMENT[2] = EVENEMENT("DOUBLECLIC","BTN_CATEGORIE",WM_LBUTTONDBLCLK)
      
      moimeme..ValeurRenvoyée = 0
      _Identifiant est un tableau de 4 chaine
      
      
      pour tout CatSpacer sur IDCatSpacer
      
      	_Identifiant[catspacer.idcatspacer] = CatSpacer.Identifiant
      	{"inter"+catspacer.idcatspacer}[1]..libelle = "Intercalaire " + CatSpacer.Description
      	{"inter"+catspacer.idcatspacer}..visible = vrai
      	{"espace"+catspacer.idcatspacer}..visible = vrai
      	{"btnrecherche"+catspacer.idcatspacer}..visible = vrai
      	{"espace"+catspacer.idcatspacer+"2"}..visible = vrai
      	{"btnrecherche"+catspacer.idcatspacer+"2"}..visible = vrai
      	ExecuteTraitement("inter"+catspacer.idcatspacer,trtModification)
      FIN
