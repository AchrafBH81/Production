 message_bar :
  internal_properties : CQAAAAkAAACmjuBzz8CGl3hd7dPnHYkTCIxEkXBgIR0bIMJNz3KOJu0G7UyFoVkzCgRsvCX2jCF79np7Y2buPQ7bRjdLM5vDZN6xoRFYK1NpGM/X85GoU5JHKTPg2gabptn64Q==
 actionbar : {}
 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1+
      
      
      // Pour compatibilité 5.5
      MoiMême..Visible=Vrai
      
      //Code WinDev 5.5 remplacé par la migration :
      //TailleDispo est un entier long
      TailleDispo est un entier  
      
      //si on est en 32 bits
      si VersionWindows()="32" alors             
      	//déclaration de la structure d'infos
      	sys_inf est compose de
      //Code WinDev 5.5 remplacé par la migration :
      //		dwOemId est un entier long
      		dwOemId est un entier  
      //Code WinDev 5.5 remplacé par la migration :
      //		dwPageSize est un entier long
      		dwPageSize est un entier  
      //Code WinDev 5.5 remplacé par la migration :
      //		lpMinAppAdd est un entier long
      		lpMinAppAdd est un entier  
      //Code WinDev 5.5 remplacé par la migration :
      //		lpMaxAppAdd est un entier long
      		lpMaxAppAdd est un entier  
      //Code WinDev 5.5 remplacé par la migration :
      //		dwActPrcMask est un entier long
      		dwActPrcMask est un entier  
      //Code WinDev 5.5 remplacé par la migration :
      //		dwNumberProc est un entier long
      		dwNumberProc est un entier  
      //Code WinDev 5.5 remplacé par la migration :
      //		dwProcType est un entier long
      		dwProcType est un entier  
      //Code WinDev 5.5 remplacé par la migration :
      //		dwAllocgranu est un entier long
      		dwAllocgranu est un entier  
      //Code WinDev 5.5 remplacé par la migration :
      //		wProcLevel est un entier sans signe
      		wProcLevel est un entier sur 2 octets sans signe
      //Code WinDev 5.5 remplacé par la migration :
      //		wProcRev est un entier sans signe
      		wProcRev est un entier sur 2 octets sans signe
      	fin                                    
          
      	//remplissage de la structure d'ifo par un appel d'API 32 bits
      	AppelDll32("Kernel32","GetSystemInfo",&sys_inf)
      	Mode="32 bits"	
      	selon sys_inf.dwProcType
      		cas 386: Process="386"
      				 x87="???"
      		cas 486: Process="486"   
         				 X87="Oui"
      		cas 586: Process="Pentium"
      				 X87="Oui"
      	fin
      	//Taille mémoire
      	TailleDispo=sysEspace() / 1024
      //Code WinDev 5.5 remplacé par la migration :
      //	Space=sansespace(Verschaine(TailleDispo,"10dS"))+" Ko"
      	Space=sansespace(NumeriqueVersChaine(TailleDispo,"10dS"))+" Ko"
      sinon
      	//on est en 16 bits
      //Code WinDev 5.5 remplacé par la migration :
      //	Flag        est un entier long
      	Flag        est un entier  
      	
      //Code WinDev 5.5 remplacé par la migration :
      //	Flag=AppelDll("KERNEL","GetWinFlags")
      // Votre programme utilise ici une commande 16 bits. 
      // Cette version ne permet que des exécutables 32 bits.
      // 	Flag=AppelDll("KERNEL","GetWinFlags")
      // Code ajouté par la migration
      //Erreur("Votre programme utilise ici une commande 16 bits. Cette version ne permet que des exécutables 32 bits.")
      
      
      	//Affichage des informations système
      	si EtBinaire(Flag,32) alors Mode="386 Etendu" SINON Mode ="Standard"
      	si EtBinaire(Flag,2) alors
      		Process="286"
      	sinon
      		SI EtBinaire(Flag,4) alors
      			Process="386"
      		sinon
      			SI EtBinaire(Flag,8) alors
      				Process="486 ou +"
      			fin
      		fin
      	fin
      	SI EtBinaire(Flag,1024) alors X87="Oui" sinon X87="Non"
      	//Taille mémoire
      	TailleDispo=sysEspace() / 1024
      //Code WinDev 5.5 remplacé par la migration :
      //	Space=sansespace(Verschaine(TailleDispo,"10dS"))+" Ko"
      	Space=sansespace(NumeriqueVersChaine(TailleDispo,"10dS"))+" Ko"
      fin
      
   -
     type : 180
     enabled : false
   -
     type : 230
     enabled : false
   -
     type : 11
   -
     type : 12
   -
     type : 17
   -
     type : 13
