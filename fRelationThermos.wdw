  -
    name : Bouton1
    identifier : 0x2782edd80509bafe
    internal_properties : 
    properties :
     x : 31
     y : 6
     width : 139
     height : 38
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         HSurErreur(RelationEDI,hErrDoublon,"")
         
         
         pour i = 1 _a_ TableOccurrence(Table__tabrelationThermos)
         	si sansespace(Table__tabrelationThermos.NotreComposant[i]) <> "" _ou_ Table__tabrelationThermos.IsException[i] alors
         		hraz(RelationEDI)
         		relationedi.TYpeObjet = 1
         		RelationEDI.IdClient = idclientcourant
         		
         		relationedi.ExtraCustomer= Table__tabrelationThermos.Composant[i]
         		RelationEDI.IsEnergetic = Table__tabrelationThermos.IsEnergetic[i]
         		RelationEDI.IsTempered = Table__tabrelationThermos.IsTempered[i]
         		RelationEDI.ExtraSupplier= Table__tabrelationThermos.notreComposant[i]
         		RelationEDI.IsException = Table__tabrelationThermos.IsException[i]
         		relationedi.ExceptionTexte = Table__tabrelationThermos.Texte_Exception[i]
         		hajoute(relationedi)
         		si HErreurDoublon() alors
         			
         		FIN
         	fin
         FIN
         mafenetre..ValeurRenvoyée = vrai
         ferme(mafenetre)
        type : 18
      -
        type : 161
        enabled : false
  -
    name : Bouton2
    identifier : 0x278f8c243448ffce
    internal_properties : 
