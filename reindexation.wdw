  procedures :
   -
     name : FichierDejaDansTable
     procedure_id : 4511921599126741455
     type_code : 14
     code : |1+
      fonction FichierDejaDansTable(sUnNomFichier)
      eIndiceDejaLa est un entier
      
      
      eIndiceDejaLa=0
      boucle
      	//Recher d'un fichier sui a le même nom physique
      	eIndiceDejaLa=tablecherche(nomlogique,extraitchaine(sUnNomFichier,2),vrai,eIndiceDejaLa+1)
      	//Une ligne a était trouvée ?
      	si eIndiceDejaLa=-1 alors 
      		//Non, on peut sortir
      		sortir
      	sinon
      		//Oui, le repertoire et le nom logique sont-ils aussi identiques ?
      		si REPERTOIRE[eIndiceDejaLa]=extraitchaine(sUnNomFichier,3) et ...
      			NOMLOGIQUE[eIndiceDejaLa]=extraitchaine(sUnNomFichier,1) alors
      			//Oui, on sort
      			sortir
      		fin
      	fin
      fin
      
      //Une ligne identique a-t-elle etait trouvée ?
      renvoyer eIndiceDejaLa<>-1
      
     type : 458752
   -
     name : MajTableDesFichiers
     procedure_id : 4511921599330296291
     type_code : 14
     code : |1+
      Procédure MajTableDesFichiers(sNomPointRep)
      //Maj de la table contenant les nom des fichiers de l'analyse
      
      eIndiceFichier 			est un entier
      eIndiceDejaLa			est un entier
      sUnNomFichier 			est une chaine
      sListeFichierResultat 	est une chaine
      
      
      
      //Récuperation des nom de fichiers correspondant à l'analyse en cours
      //sListeFichierResultat=hlisterep(sNomPointRep,hExistant)
      sListeFichierResultat=hlistefichier(hLstTriée+hLstDétail+hlsttout)
      
      
      //Rempli la table avec les nom des fichiers trouvés dans le .REP
      eIndiceFichier=1
      boucle
      	//Recuperation d'un nom de fichier
      	sUnNomFichier=extraitchaine(sListeFichierResultat,eIndiceFichier,rc)
      	si sUnNomFichier<>eot alors
      		//Ce fichier est déja dans la table ?
      		si pas FichierDejaDansTable(sUnNomFichier) alors
      			//non, ajpout dans la table
      			tableajoute("TABLEDESFICHIERS",1+tab+sUnNomFichier)
      			//MAJ des libelle indiquant le nb de ligne selectionnées
      			LIBNBTOTAL=val(LIBNBTOTAL)+1
      			//LIBNBSELECT=val(LIBNBSELECT)+1
      		fin
      		eIndiceFichier++
      	sinon
      		sortir
      	fin
      fin
      
     type : 458752
   -
     name : RendNomSeul
     procedure_id : 4511921600484254199
     type_code : 14
     code : |1+
      fonction RendNomSeul(pNomComplet)
      // Rend le nom du fichier seul (sans le repertoire)
      
      Ind			est un entier
      NomComplet	est une chaine
      
      NomComplet=SansEspace(pNomComplet)
      
      si NomComplet="" alors renvoyer ""
      
      // Recherche le dernier "\" ou ":"
      pour Ind=Taille(NomComplet) à 1 pas -1
      	si NomComplet[[Ind]]="\" ou NomComplet[[Ind]]=":" alors
      		renvoyer Milieu(NomComplet,Ind+1)	// Fin du nom
      	fin
      fin
      
      renvoyer NomComplet		// Pas de chemin
      
     type : 458752
   -
     name : RendRepSeul
     procedure_id : 4511921600996614667
     type_code : 14
     code : |1+
      fonction RendRepSeul(NomComplet)
      // Rend le répertoire seul (sans "\" en fin et sans le nom di fichier)
      
      Ind	est un entier
      
      // Recherche le dernier "\"
      pour Ind=Taille(NomComplet) à 1 pas -1
      	si NomComplet[[Ind]]="\" ou NomComplet[[Ind]]=":" alors
      		sortir
      	fin
      fin
      
      si NomComplet[[Ind]]="\" alors renvoyer gauche(NomComplet,Ind-1)	// Sans "\" en fin
      si NomComplet[[Ind]]=":" alors renvoyer gauche(NomComplet,Ind)
      // Pas de répertoire
      renvoyer ""
      
     type : 458752
