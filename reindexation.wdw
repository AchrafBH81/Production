 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1+
      procedure Index(sNomAnalyse="",bRechercheReseau=vrai)
      //sNomAnalyse doit être le nom de l'analyse en cours(sans chemin ni mot de passe)
      //recherche des .REP dans les repertoires HSF reseau si bRechercheReseau=vrai
      //sinon ne recherche que dans les repertoire HSF des disques locaux
      
      //nom du fichier .REP
      
      // Pour compatibilité 5.5
      MoiMême..Visible=Vrai
      
      sNomPointRep 			est une chaine
      //nom des différentes unités accessibles
      sNomUnite				est une chaine
      //entier utilise comme indice
      eIndiceCaractere	 	est un entier
      
      //activation du premier plan
      //Code WinDev 5.5 remplacé par la migration :
      //_onglet1..etat=actif
      MaFenetre..Plan=1
      // Vérifie la présence d'une analyse
      h.errignore=vrai
      //Code WinDev 5.5 remplacé par la migration :
      //si hListeFichier()="" alors
      si hListeFichier(Vrai)="" alors
      //Code WinDev 5.5 remplacé par la migration :
      //	BOUTON1..etat=grise
      	BOUTON1..etat=grise; BOUTON1..Visible=Vrai
      	//Affichage d'un message
      //Code WinDev 5.5 remplacé par la migration :
      //	erreur(messtraduit(2022))//Il n'y a pas d'analyse reliée au projet en cours, impossible de lancer l'indexation.
      	erreur(<§$0016§>)//Il n'y a pas d'analyse reliée au projet en cours, impossible de lancer l'indexation.
      	ferme
      fin
      h.errignore=faux
      
      //Initialisation de la combo de selection
      
      si chargeimage(1,maitre.FichierImage..valeur,1,13) alors
      	//l'image c'est correctement chargée, on ajoute dans la combo
      	ListeAjoute("SELECTION","")
      	ListeAjoute("SELECTION",gImage(1,7))
      sinon	
      	//l'image ne c'est pas chargée, on ajoute "oui","non" dans la combo
      	ListeAjoute("SELECTION","Oui")
      	ListeAjoute("SELECTION","Non")
      fin
      
      
      
      //MAJ des libelle indiquant le nb de ligne selectionnées
      LIBNBTOTAL="0"
      LIBNBSELECT="0"
      		
      //Recuperation du nom du fichier .REP
      //Pour les projets utilisant "HGereRepOui(NomRepertoire)"
      sNomPointRep=inilit(sNomAnalyse,"REP", "","HFREP.INI")
      
      //Un nom de fichier .REP a été lu ?
      si sNomPointRep<>"" alors
      	//Maj de la table contenant les nom des fichiers de l'analyse
      	MajTableDesFichiers(sNomPointRep)
      fin
      
      //recherche des REP dans tous repertoire HSF de tous les lecteurs
      //pour eIndiceCaractere=0 a 25 
      //	sNomUnite=caract(asc("A")+eIndiceCaractere)
      //	//Disque dur local ou réseau ?
      //Code WinDev 5.5 remplacé par la migration :
      //	si ftypedisque(sNomUnite)=2 ou (ftypedisque(sNomUnite)=4 et bRechercheReseau) alors
      //	si fDisqueInfo(sNomUnite,fdTypeDisque)=2 ou (fDisqueInfo(sNomUnite,fdTypeDisque)=4 et bRechercheReseau) alors
      //		//un fichier .REP de l'analyse dans un repertoire HSF ?
      //		si frep(sNomUnite+":\HSF\"+sNomAnalyse+".REP",frfichier)<>"" alors
      //			//Maj de la table contenant les nom des fichiers de l'analyse
      //			MajTableDesFichiers(sNomUnite+":\HSF\"+sNomAnalyse+".REP")
      //		fin
      //	fin
      //fin
      
      MajTableDesFichiers(completerep(frepencours())+"Production.rep")
      
      
   -
