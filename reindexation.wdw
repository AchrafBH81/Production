  -
    name : BTNSELECTTOUT
    identifier : 0x3e9d90ca2659a0d5
    internal_properties : 
    properties :
     x : 117
     y : 372
     width : 80
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         eNumLigne est un entier
         eTypeSelect est un entier
         
         //Type non selectionnée
         eTypeSelect=2
         //Parcour de la table a la recherche d'un element non selectionné
         pour eNumLigne=1 a tableoccurrence("TABLEDESFICHIERS")
         	//Un élément est-il non selectionné ?
         	si SELECTION[eNumLigne]=2 alors
         		//Oui : alors selection de toutes les lignes
         		eTypeSelect=1
         		sortir
         	fin
         fin
         
         //Selection de toutes la tables ?
         si eTypeSelect=2 alors
         	//Oui, nb de lignes selectionnées=nb total de lignes
         	LIBNBSELECT=LIBNBTOTAL
         sinon
         	//Oui, nb de lignes selectionnées=0
         	LIBNBSELECT="0"
         fin
         
         //Parcour de la table
         pour eNumLigne=1 a tableoccurrence("TABLEDESFICHIERS")
         	SELECTION[eNumLigne]=eTypeSelect
         fin
         
        type : 18
