  -
    name : BTNAUTRE
    identifier : 0x3e9d90ca121ba107
    internal_properties : 
    properties :
     x : 301
     y : 372
     width : 80
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         sRep 			est une chaine
         sNomIniFichier 	est une chaine= ""
         sTitre 			est une chaine=  "Sélection d'un fichier Hyper File"
         sFiltre 		est une chaine
         sExtension 		est une chaine= "FIC"
         sFichier		est une chaine= ""
         sNomRep			est une chaine
         sNomPhys		est une chaine
         sListeDescription est une chaine
         sUnNomLogique	est une chaine
         eIndice			est un entier
         
         //recuperation du repertoire en cours
         sRep=frepencours()
         
         //filtre de selection
         sFiltre= "Fichiers Hyper File (*.FIC)" +TAB+ "*.FIC"+RC+...
         		"Tous fichiers (*.*)"+TAB+"*.*"
         
         //Affichage du selecteur
         sFichier = fSelecteur(sRep,sNomIniFichier,sTitre,sFiltre,sExtension)
         
         //Un fichier a été selectionné ?
         Si sFichier <> "" alors
         	//extraction du nom du repertoire
         	sNomRep=RendRepSeul(sFichier)
         	//extraction du nom du fichier
         	sNomPhys=RendNomSeul(sFichier)
         	
         	//recuperation des noms des fichiers logique de l'analyse en cours
         	sListeDescription=hlistefichier(faux)//	NomFic1
         	
         	//Fermeture de tous les fichiers de l'analyse
         	hferme("")
         	
         	//recherche du nom logique qui correspond au fichier selectionné
         	eIndice=1
         	boucle
         		//extraction d'un nom logique de fichier
         		sUnNomLogique=extraitchaine(sListeDescription,eIndice,rc)
         		
         		si sUnNomLogique=eot alors
         			//plus de nom logique : sortie de la boucle
         			sortir
         		fin
         		
         		//Assignation du repertoire
         //Code WinDev 5.5 remplacé par la migration :
         //		hassigne(sUnNomLogique,sNomRep)
         		HChangeRep(sUnNomLogique,sNomRep)
         		//Nom physique
         //Code WinDev 5.5 remplacé par la migration :
         //		hsubstnom(sUnNomLogique,sNomPhys)
         		HChangeNom(sUnNomLogique,sNomPhys)
         		
         		//Tentative d'ouverture avec le nom logique extrait
         		h.errignore=vrai
         		houvre(sUnNomLogique)
         		h.errignore=faux
         		//L'ouverture a-t-elle réussie ?
         		si h.erreur=0 alors
         			//Oui
         			//Fermeture du fichier
         			HFerme(sUnNomLogique)
         			//annulation des substitutions de nom et de repertoire
         //Code WinDev 5.5 remplacé par la migration :
         //			hsubstnom(sUnNomLogique,"")
         			HChangeNom(sUnNomLogique,"")
         //Code WinDev 5.5 remplacé par la migration :
         //			hassigne(sUnNomLogique,"")
         			HChangeRep(sUnNomLogique,"")
         			//le nom logique a été trouvé : Sortie de la boucle
         			sortir
         		sinon
         			//annulation des substitutions de nom et de repertoire
         //Code WinDev 5.5 remplacé par la migration :
         //			hsubstnom(sUnNomLogique,"")
         			HChangeNom(sUnNomLogique,"")
         //Code WinDev 5.5 remplacé par la migration :
         //			hassigne(sUnNomLogique,"")
         			HChangeRep(sUnNomLogique,"")
         		fin
         		eIndice++
         	fin
         	
         	//le nom logique a été trouvé ?
         	si sUnNomLogique=eot alors
         		//Non
         		acso_message("Erreur","Le fichier sélectionné n'appartient pas è l'analyse en cours","Erreur")
         	sinon
         		//oui,
         		//fichier déja present dans la table ?
         		si pas FichierDejaDansTable(sUnNomLogique+tab+extraitchaine(majuscule(sNomPhys),1,".")+tab+sNomRep) alors
         			//non, ajout dans la table
         			tableajoute("TABLEDESFICHIERS",1+tab+sUnNomLogique+tab+extraitchaine(majuscule(sNomPhys),1,".")+tab+sNomRep)
         			//MAJ des libelle indiquant le nb de ligne selectionnées
         			LIBNBTOTAL=val(LIBNBTOTAL)+1
         			LIBNBSELECT=val(LIBNBSELECT)+1
         		fin
         	fin
         	
         Fin
         
        type : 18
      -
        type : 161
        enabled : false
