    name : BTNFICHIER
    identifier : 0x3e9d90ca05eea175
    internal_properties : 
    properties :
     x : 301
     y : 372
     width : 80
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         sRep 			est une chaine
         sNomIniFichier 	est une chaine= ""
         sTitre 			est une chaine=  "Création d'un fichier texte"
         sFiltre 		est une chaine
         sExtension 		est une chaine= "TXT"
         sFichier		est une chaine= ""
         sNomRep			est une chaine
         sNomPhys		est une chaine
         sListeDescription est une chaine
         sUnNomLogique	est une chaine
         eIndice			est un entier
         eNumFichier		est un entier
         
         //recuperation du repertoire en cours
         sRep=frepencours()
         
         //filtre de selection
         sFiltre= "Fichiers Hyper File (*.TXT)" +TAB+ "*.TXT"+RC+...
         		"Tous fichiers (*.*)"+TAB+"*.*"
         
         //Affichage du selecteur
         sFichier = fSelecteur(sRep,sNomIniFichier,sTitre,sFiltre,sExtension,fSelCree+fselexiste)
         
         //Un fichier a été selectionné ?
         Si sFichier <> "" alors
         	//Creation et ouverture du fichier
         	eNumFichier=fcree(sFichier)
         	//fichier correctement créé ?
         	si eNumFichier<>-1 alors
         		//ecritue dans le fichier
         		si fecrit(eNumFichier,SAIRESULTAT)=-1 alors
         			//L'ecritue c'est mal passée
         //Code WinDev 5.5 remplacé par la migration :
         //			erreur(messtraduit(2021))//Les informations n'ont pas pu être ajoutées dans le fichier.
         			erreur(<§$0015§>)//Les informations n'ont pas pu être ajoutées dans le fichier.
         		fin
         		fferme(eNumFichier)
         	sinon
         //Code WinDev 5.5 remplacé par la migration :
         //		erreur(messtraduit(2020))//Le fichier n'a pas pu être créé.
         		erreur(<§$0014§>)//Le fichier n'a pas pu être créé.
         	fin
         Fin
         
        type : 18
      -
        type : 161
        enabled : false
