  -
    name : BOUTON1
    identifier : 0x3e9d90ca6190a099
    internal_properties : 
    properties :
     x : 393
     y : 372
     width : 80
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         eIndiceLigne est un entier
         eErreurIndexation est un entier
         sMessagesErreurs est une chaine=""
         
         //Parcour total de la table
         Pour eIndiceLigne=1 a tableoccurrence("TABLEDESFICHIERS")
         	//la ligne est-elle selectionnée ?
         	si SELECTION[eIndiceLigne]=2 alors
         		//Selection de l'element dans la table
         		tableselectplus("TABLEDESFICHIERS",eIndiceLigne)
         		//pour permettre l'affichage de la selection
         		multitache()
         		
         		//Oui, Lancement de l'indexation
         //Code WinDev 5.5 remplacé par la migration :
         //		eErreurIndexation=HRéindexe(NOMLOGIQUE[eIndiceLigne], NOMPHYSIQUE[eIndiceLigne], REPERTOIRE[eIndiceLigne], NdxNormal, Handle())
         		//		eErreurIndexation=hReindexe_55(NOMLOGIQUE[eIndiceLigne], NOMPHYSIQUE[eIndiceLigne], REPERTOIRE[eIndiceLigne], hNdxNormal, Handle())
         		selon TYPEREINDEXATION
         			cas 1
         				eErreurIndexation=hReindexe(NOMLOGIQUE[eIndiceLigne], hNdxNormal, Handle())
         			cas 2
         				eErreurIndexation=hReindexe(NOMLOGIQUE[eIndiceLigne], hNdxSuppression, Handle())
         			cas 3
         				eErreurIndexation=hReindexe(NOMLOGIQUE[eIndiceLigne], hNdxCompactage, Handle())
         
         		fin
         			
         		
         				eErreurIndexation=hReindexe(NOMLOGIQUE[eIndiceLigne], hNdxNormal, Handle())
         		//Une erreur à-t-elle eu lieu durant l'indexation ?
         			//	si eErreurIndexation <>0 alors
         					si eErreurIndexation =0 alors
         						//Oui, message d'erreur
         			//	1 : Fichier sans clé (donc sans index)
         			//	2 : Fichier de données introuvable
         			//	3 : Erreur à l'ouverture du fichier de données
         			//	4 : Version de fichier incorrecte
         			//	5 : Taille d'enregistrement incorrecte
         			//	6 : Le fichier n'appartient pas à l'analyse en cours
         			//	7: Erreur pendant la réindexation
         			//	8: Il reste des enregistrements endommagés
         			//	9 : Erreur à la fermeture du fichier de données
         			//	10 : Pas de module pour partager les fichiers
         			//  11 : Fichier inconnu dans l'analyse en cours
         			//	12 : Répertoire physique non défini
         			//	13 : Analyse compatible 1.5 non gérée
         			//	14 : Mode de réindexation incorrect
         			//	15 : Impossible de bloquer complètement le fichier avant réindexation
         			//Erreur(messtraduit(2001),messtraduit(2001+eErreurIndexation))
         			si sMessagesErreurs<>"" alors
         				sMessagesErreurs=sMessagesErreurs+rc
         			fin
         //Code WinDev 5.5 remplacé par la migration :
         //			sMessagesErreurs=sMessagesErreurs+messtraduit(2018)+REPERTOIRE[eIndiceLigne]+NOMPHYSIQUE[eIndiceLigne]+rc+messtraduit(2001+eErreurIndexation)
         			sMessagesErreurs=sMessagesErreurs+<§$0012§>+REPERTOIRE[eIndiceLigne]+NOMlogique[eIndiceLigne]+rc+<§$0001§>
         		sinon
         			//Pas d'erreur, on décoche la ligne
         			SELECTION[eIndiceLigne]=1
         			LIBNBSELECT=val(LIBNBSELECT)-1
         		fin
         	fin
         	//pour permettre l'affichage de la combo décochée
         	multitache()
         fin
         
         //Des messages d'erreurs sont-ils apparrus ?
         si sMessagesErreurs<>"" alors
         	//Des erreur
         	//affectation du champ pour visualiser les erreurs
         	SaiResultat=sMessagesErreurs
         	//
         //Code WinDev 5.5 remplacé par la migration :
         //	_onglet2..etat=actif
         	MaFenetre..Plan=2
         sinon
         	//Pas d'erreur
         //Code WinDev 5.5 remplacé par la migration :
         //	info(messtraduit(2019))
         
         	acso_message("Information","L'indexation des fichiers s'est correctement déroulée","Info")
         
         fin
         
        type : 18
      -
        type : 161
        enabled : false
