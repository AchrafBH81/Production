         //
         //	fin
         //	calculligne++
         //fin
         
         //// ****************** Nouveau code ****************************
         
         j est un entier
         indicecarr est un entier
         carrtrouve est un booleen = faux//A FAIRE :
         carrnogl est une chaine
         si RequeteBlEtat.ftype = 4 alors
         	corps..visible = faux
         sinon
         
         	si requetebletat.ftype = 2 et pas requetebletat.fdverreunite alors
         		CORPS..VISIBLE = VRAI
         		rubrique17 = requetebletat.fdprixu
         		rubrique16 = 1
         		si anciennumcommande <> RequeteBlEtat.fdnocomm alors
         
         			si pas anciennumcommande = 0 alors
         				si dimensiontableaucarrelage <> 0 alors
         					pour j = 1 a dimensiontableaucarrelage
         						numprodcarr   = tableaucarrelage[j,1]
         						qtecarr24       = tableaucarrelage[j,2]
         						desccarr      = tableaucarrelage[j,3]
         						prixUnitCarr  = tableaucarrelage[j,4]
         						totalcarr = arrondi(val(qtecarr24) * val(prixunitcarr),2)
         						AlimenteHistoriqueProduit(sansespace(client.numero),requetebletat.BDateFacture,4,numprodcarr,"","","",totalcarr,0,desccarr,qtecarr24)
         						si noglcredit <> "" alors
         							carrnogl = noglcredit
         						sinon	
         							si hlitrecherche(invent,INUM,numprodcarr) alors
         								carrnogl = invent.ICODEGL
         							sinon
         
         								carrnogl = config.glventedefaut
         							fin	
         						FIN
         
         						Remplir_tableau_gl(carrnogl,totalcarr)						
         						calculligne++
         						iimprimebloc(ITERATION1)
         						totalpage +=  totalcarr
         						totalfacture +=  totalcarr
         					fin
         					dimension(tableaucarrelage,0,5)
         					dimensiontableaucarrelage = 0
         				fin		
         
         			fin
         			si pas ldebut alors
         				calculligne++
         				iimprimebloc(ITERATION2)
         			sinon
         				ldebut = faux
         			fin
         			anciennumcommande = RequeteBlEtat.fdnocomm
         			AncienNumcarrelage = ""
         		fin
         
         		//		rubrique16..visible = faux
         	sinon	
         		corps..visible = vrai
         		//		rubrique16..visible = vrai
         		si anciennumcommande <> RequeteBlEtat.fdnocomm alors
         
         			si pas anciennumcommande = 0 alors
         				si dimensiontableaucarrelage <> 0 alors
         					pour j = 1 a dimensiontableaucarrelage
         						numprodcarr   = tableaucarrelage[j,1]
         						qtecarr24       = tableaucarrelage[j,2]
         						desccarr      = tableaucarrelage[j,3]
         						prixUnitCarr  = tableaucarrelage[j,4]
         						totalcarr = arrondi(val(qtecarr24) * val(prixunitcarr),2)
         						AlimenteHistoriqueProduit(sansespace(client.numero),requetebletat.BDateFacture,4,numprodcarr,"","","",totalcarr,0,desccarr,qtecarr24)
         						si noglcredit <> "" alors
         							carrnogl = noglcredit
         						sinon	
         							si hlitrecherche(invent,INUM,numprodcarr) alors
         								carrnogl = invent.ICODEGL
         							sinon
         
         								carrnogl = config.glventedefaut
         							fin	
         						FIN
         
         						Remplir_tableau_gl(carrnogl,totalcarr)
         						calculligne++
         						iimprimebloc(ITERATION1)
         						totalpage +=  totalcarr
         						totalfacture +=  totalcarr
         					fin
         					dimension(tableaucarrelage,0,5)
         					dimensiontableaucarrelage = 0
         				fin		
         			fin
         			si pas ldebut alors
         				calculligne++
         				iimprimebloc(ITERATION2)
         			sinon
         				ldebut = faux
         			fin
         			anciennumcommande = RequeteBlEtat.fdnocomm
         			AncienNumcarrelage = ""
         		fin
         	fin
         
         
         	si RequeteBlEtat.fdcarrelage alors
         
         		//		si AncienNumCarrelage <> RequeteBlEtat.fdnumcarr alors
         		//			si dimensiontableaucarrelage <> 0 alors
         		//				pour j = 1 a 1
         		//					numprodcarr   = tableaucarrelage[j,1]
         		//					qtecarr24       = tableaucarrelage[j,2]
         		//					desccarr      = tableaucarrelage[j,3]
         		//					prixUnitCarr  = tableaucarrelage[j,4]
         		//					totalcarr = arrondi(val(qtecarr24) * val(prixunitcarr),2)
         		//					si hlitrecherche(invent,INUM,numprodcarr) alors
         		//						carrnogl = invent.ICODEGL
         		//					sinon
         		//						carrnogl = config.glventedefaut
         		//					fin	
         		//					Remplir_tableau_gl(carrnogl,totalcarr)
         		//					calculligne++
         		//					totalpage +=  totalcarr
         		//					totalfacture +=  totalcarr
         		//					iimprimebloc(ITERATION1)
         		//				fin
         		//				dimension(tableaucarrelage,0,5)
         		//				dimensiontableaucarrelage = 0
         		//			fin
         		//
         		//			AncienNumCarrelage = RequeteBlEtat.fdnumcarr
         		//
         		//
         		//		fin
         
         
         
         
         		pour j = 1 a dimensiontableaucarrelage
         			si tableaucarrelage[j,1] = requetebletat.fdnumcarr et val(tableaucarrelage[j,4]) = RequeteBlEtat.fdcarrpruxuc alors
         				indicecarr = j
         				carrtrouve = vrai
         			FIN
         		fin
         		si carrtrouve alors
         			//			tableaucarrelage[indicecarr,2]=numeriqueverschaine(val(tableaucarrelage[indicecarr,2])+(requetebletat.fdqteafacturer...
         			//			* requetebletat.fdcarreauh * requetebletat.fdcarreauv))
         			// modification pour avoir le nombre de carreau exact
         
         			tableaucarrelage[indicecarr,2]=numeriqueverschaine(val(tableaucarrelage[indicecarr,2])+(requetebletat.fdqteafacturer...
         			* requetebletat.fdnbcarreau))
         
         			//	tableaucarrelage[indicecarr,4]=numeriqueverschaine(val(tableaucarrelage[indicecarr,4])+(requetebletat.fdqteafacturer * ...
         			//	requetebletat.fdcarreauh * requetebletat.fdcarreauv))
         			//	tableaucarrelage[indicecarr,5]=numeriqueverschaine(val(tableaucarrelage[indicecarr,5])+((requetebletat.fdqte-requetebletat.fdqteafacturer)*...
         			//	requetebletat.fdcarreauh * requetebletat.fdcarreauv))
         
         
         
         		sinon
         			si dimensiontableaucarrelage <> 0 alors
         				pour j = 1 a 1
         					numprodcarr   = tableaucarrelage[j,1]
         					qtecarr24       = tableaucarrelage[j,2]
         					desccarr      = tableaucarrelage[j,3]
         					prixUnitCarr  = tableaucarrelage[j,4]
         					totalcarr = arrondi(val(qtecarr24) * val(prixunitcarr),2)
         					AlimenteHistoriqueProduit(sansespace(client.numero),requetebletat.BDateFacture,4,numprodcarr,"","","",totalcarr,0,desccarr,qtecarr24)
         					si noglcredit <> "" alors
         						carrnogl = noglcredit
         					sinon	
         						si hlitrecherche(invent,INUM,numprodcarr) alors
         							carrnogl = invent.ICODEGL
         						sinon
         
         							carrnogl = config.glventedefaut
         						fin	
         					FIN	
         					Remplir_tableau_gl(carrnogl,totalcarr)
         					calculligne++
         					totalpage +=  totalcarr
         					totalfacture +=  totalcarr
         					iimprimebloc(ITERATION1)
         				fin
         				dimension(tableaucarrelage,0,5)
         				dimensiontableaucarrelage = 0
         			fin
         
         			AncienNumCarrelage = RequeteBlEtat.fdnumcarr
         
         			dimensiontableaucarrelage++
         			dimension(tableaucarrelage,dimensiontableaucarrelage,5)
         			tableaucarrelage[dimensiontableaucarrelage,1] = requetebletat.fdnumcarr
         			hlitrecherche(invent,INUM,requetebletat.fdnumcarr)
         			si htrouve(invent) alors
         				tableaucarrelage[dimensiontableaucarrelage,3] = Client.CLangue = 1 ? invent.IDESC SINON invent.idesca
         //				tableaucarrelage[dimensiontableaucarrelage,3] = 
         				
         			FIN
         			//			tableaucarrelage[dimensiontableaucarrelage,2]=numeriqueverschaine(requetebletat.fdqteafacturer * ...	
         			//			requetebletat.fdcarreauh * requetebletat.fdcarreauv,"5.2f")
         
         
         			//           pour avoir le nombre exact de carreau
         
         			tableaucarrelage[dimensiontableaucarrelage,2]=numeriqueverschaine(requetebletat.fdqteafacturer * ...	
         			requetebletat.fdnbcarreau,"5.2f")
         
         			//
         
         			tableaucarrelage[dimensiontableaucarrelage,4]=numeriqueverschaine(requetebletat.fdcarrpruxuc,"5.2f")
         
         
         			//tableaucarrelage[dimensiontableaucarrelage,5]=numeriqueverschaine((requetebletat.fdqte-requetebletat.fdqteafacturer) * ...
         			//requetebletat.fdcarreauh * requetebletat.fdcarreauv)
         
         
         
         		fin
         	fin
         	//	si pas facturereimpression alors
         	//		remplir_tableau(rubrique21,arrondi(rubrique4 * (rubrique16 * rubrique17),2))
         	//	FIN
         
         	//	totalpage +=  arrondi(requetebletat.fdqteafacturer * requetebletat.fdpiedcarrefacture * requetebletat.fdprixupiedfacture,2)
         	//	totalfacture +=  arrondi(requetebletat.fdqteafacturer * requetebletat.fdpiedcarrefacture * requetebletat.fdprixupiedfacture,2)
         
         	si requetebletat.ftype = 2 et pas requetebletat.fdverreunite alors
         		totalpage +=  arrondi(requetebletat.fdqteafacturer * requetebLETAT.fdprixu,2)
         		totalfacture +=  arrondi(requetebletat.fdqteafacturer * requetebLETAT.fdprixu,2)
         		AlimenteHistoriqueProduit(sansespace(client.numero),requetebletat.BDateFacture,2,requetebletat.fdnumprod,"","","", arrondi(requetebletat.fdqteafacturer * requetebLETAT.fdprixu,2),...
         		RequeteBlEtat.surchargeenergie,requetebletat.fddesc,RequeteBlEtat.fdqteafacturer)
         	sinon
         		totalpage +=  arrondi(requetebletat.fdqteafacturer * ((requetebletat.fdpiedcarrefacture * requetebletat.fdprixupiedfacture) + ...
         		REQUETEBLETAT.fdextraforme),2)
         		totalfacture +=  arrondi(requetebletat.fdqteafacturer * ((requetebletat.fdpiedcarrefacture * requetebletat.fdprixupiedfacture)+ ...
         		RequeteBlEtat.fdextraforme),2)
         
         		//		totalpage +=  arrondi(requetebletat.fdqteafacturer * requetebletat.fdpiedcarrefacture * requetebletat.fdprixupiedfacture,2) + ...
         		//		arrondi(requetebletat.fdqteafacturer * REQUETEBLETAT.fdextraforme,2)
         		//		totalfacture +=  arrondi(requetebletat.fdqteafacturer * requetebletat.fdpiedcarrefacture * requetebletat.fdprixupiedfacture,2) + ...
         		//		arrondi(requetebletat.fdqteafacturer * REQUETEBLETAT.fdextraforme,2)
         
         
         		totalsurcharge += arrondi(requetebletat.surchargeenergie,2)
         		totalcap+= arrondi(requetebletat.FDExtraCap * REQUETEBLETAT.fdqteafacturer,2)
         
         
         		AlimenteHistoriqueProduit(sansespace(client.numero),requetebletat.BDateFacture, requetebletat.ftype,requetebletat.fdnumprod,RequeteBlEtat.fdcomposant1,...
         		RequeteBlEtat.fdcomposant2,RequeteBlEtat.fdcomposant3,arrondi(requetebletat.fdqteafacturer * ((requetebletat.fdpiedcarrefacture * requetebletat.fdprixupiedfacture)+ ...
         		RequeteBlEtat.fdextraforme),2),...
         		RequeteBlEtat.surchargeenergie,requetebletat.fddesc,RequeteBlEtat.fdqteafacturer)
         
         	fin
         	calculligne++
         fin
         
         
         
         
         
        type : 327692
      -
        code : |1+
         si RequeteBlEtat.ftype <> 4 alors
         
         	si pas facturereimpression alors
         		si RequeteBlEtat.ftype <> 4 alors
         			SI REQUETEBLETAT.FDExtraCap <> 0 ALORS
         				remplir_tableau(rubrique21,arrondi(rubrique18,2) - (arrondi(requetebletat.FDExtraCap,2) * REQUETEBLETAT.fdqteafacturer))
         				remplir_tableau(CONFIG.CapGL,arrondi(requetebletat.FDExtraCap,2) * REQUETEBLETAT.fdqteafacturer)
         			SINON
         				remplir_tableau(rubrique21,arrondi(rubrique18,2))
         			FIN
         		fin
         	FIN
         
         
         
         	si pas sansespace(RequeteBlEtat.fnotes) = ""  ou requetebletat.fdextraforme <> 0 ALORS
         		calculligne++
         		iImprimeBloc(ITERATION3)	
         		//  totalpage +=  totalextraforme
         		//  totalfacture +=  totalextraforme
         	FIN
         	si pas sansespace(RequeteBlEtat.fnotes1) = ""   ALORS
         		calculligne++
         		iImprimeBloc(ITERATION5)	
         		//  totalpage +=  totalextraforme
         		//  totalfacture +=  totalextraforme
         	FIN
         fin
         
         si CORPS..visible ALORS
         	TotaldePage+=rubrique18
         FIN
        type : 327693
      -
        type : 327697
        enabled : false
