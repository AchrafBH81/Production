         //
         //		AlimenteHistoriqueProduit(sansespace(client.numero),requetebletat.BDateFacture, requetebletat.ftype,requetebletat.fdnumprod,RequeteBlEtat.fdcomposant1,...
         //		RequeteBlEtat.fdcomposant2,RequeteBlEtat.fdcomposant3,arrondi(requetebletat.fdqteafacturer * ((requetebletat.fdpiedcarrefacture * requetebletat.fdprixupiedfacture)+ ...
         //	    RequeteBlEtat.fdextraforme),2),...
