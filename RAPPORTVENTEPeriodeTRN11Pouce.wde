    properties :
     y : 39.455
     width : 269.4
     height : 3.89700000000001
    code_elements :
     type_code : 30
     p_codes :
      -
        code : |1+
         j est un entier
         jj est une chaine
         jjj est un entier
         tot est un reel = 0
         
         
         //pour j = 1 a 12
         POUR j = 1 A 12
         	
         	 HLitRecherche(HistoAnneeMois,lanneeMois,...
         		HConstruitValClé(HistoAnneeMois,lanneeMois,SansEspace(Client.numero),Val(lperiode[j,2]),Val(lperiode[j,1])),hIdentique)
         	tantque sansespace(HistoAnneeMois.hclient) = sansespace(client.numero) et val(HistoAnneeMois.lAnnee) = Val(lperiode[j,2]) et val(HistoAnneeMois.lmois) =  Val(lperiode[j,1])	
         		{"totalclient"+j} += HistoAnneeMois.lvente
         		{"totalsecteur"+j} += HistoAnneeMois.lvente
         		{"toussecteur"+j} += HistoAnneeMois.lvente
         		tot+=HistoAnneeMois.lvente
         		hlitsuivant(HistoAnneeMois,lanneeMois)
         	FIN
         FIN
         
         
         //pour j = 1 a 12
         //	
         //	si hlitrecherche(HistoAnneeMois,lanneeMois,...
         //		HConstruitValClé(HistoAnneeMois,lanneeMois,sansespace(client.numero),val(lperiode[j,2]),val(lperiode[j,1])),hIdentique) alors
         //		{"totalclient"+j} += HistoAnneeMois.lvente
         //		{"totalsecteur"+j} += HistoAnneeMois.lvente
         //		{"toussecteur"+j} += HistoAnneeMois.lvente
         //		tot+=HistoAnneeMois.lvente
         //	fin
         //fin
         
         SI sautdepage
         	si tot =  0 ALORS
         		//Code WinDev 5.5 remplacé par la migration :
         		//	bloc_frpt2..VISIBLE = FAUX
         		BLOC_CORPS..Visible=Faux
         	sinon
         		BLOC_CORPS..Visible=vrai
         		
         	FIN
         fin
         
        type : 327692
      -
        type : 327697
        enabled : false
