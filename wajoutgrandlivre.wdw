  -
    name : BTN_DETRUIRE
    identifier : 0x475398b44a17db43
    internal_properties : 
    properties :
     x : 135
     y : 5
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         
         // Suppression
         si tablegl..Nouveau alors
         	si tablegl..occurrence<2 alors
         		REPRISESAISIE("tablegl")
         	sinon
         		TableSupprime("tablegl")
         	fin
         sinon
         	si acso_Message("Question","Voulez-vous supprimer l'enregistrement?","OuiNon") = idyes alors
         		TableSupprime("tablegl")
         		si HErreurIntegrite() alors
         			Erreur(HErreurInfo())	// "Erreur d'intégrité"
         			Retour
         		Fin
         	fin
         fin
         
         si TableOccurrence("tablegl")=0 alors
         	REPRISESAISIE("tablegl")
         SINON
         	// Le bouton Supprimer est en interruption
         	// Il faut forcer l'entrée dans la nouvelle ligne
         	ExecuteTraitement("tablegl",trtENTREELIGNE)
         fin
         
        type : 18
      -
        type : 161
        enabled : false
