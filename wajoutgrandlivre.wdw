     p_codes :
      -
        code : |1-
         si acso_message("Question","Voulez-vous purger le fichier des comptes de Grand Livre ?","OuiNon") = idyes ALORS
         	pour tout glivre
         		hsupprime(glivre,hnumenrencours)
         	FIN
         FIN
         tableaffiche(TABLEGL,taInit)
