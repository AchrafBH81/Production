        type_code : 29
        p_codes :
         -
           code : |1+
            MOIMEME = "Intercalaire inexistant"
            //selon ltypespacer
            //	cas "Inex"
            //		si hlitrecherche(spacer,stypesnumero,HConstruitValClé(spacer,stypesnumero,"I",sansespace(rnospacer))) alors
            //			moimeme = spacer.sdescription
            //		fin
            //	Cas "Aluminium"
            //		si hlitrecherche(spacer,stypesnumero,HConstruitValClé(spacer,stypesnumero,"A",sansespace(rnospacer))) alors
            //			moimeme = spacer.sdescription
            //		fin
            //	cas "ThermoPlastique"	
            //		si hlitrecherche(spacer,stypesnumero,HConstruitValClé(spacer,stypesnumero,"T",sansespace(rnospacer))) alors
            //			moimeme = spacer.sdescription	
            //		fin
            //FIN
            
            
            si hlitrecherche(IntercalaireCouleurDimensions,IDIntercalaireCouleursnumero,...
            	hconstruitvalcle(IntercalaireCouleurDimensions,IDIntercalaireCouleursnumero,sansespace(requeteDétailCommandeTous.ftypespacer),sansespace(requeteDétailCommandeTous.fdespace))) alors
                moimeme = IntercalaireCouleurDimensions.Description
                lepaisseurpetite = (IntercalaireCouleurDimensions.Varinter1A = 0)
            
            fin
            
            
            
            
           type : 327692
