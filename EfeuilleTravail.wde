 internal_properties : 
 languages :
  - fr-FR
 blocks :
  -
    name : CORPS
    identifier : 0x4766e3dd4df82759
    internal_properties : CQAAAAkAAABytqhkxMJ+oWNlxgxtmR9ck+dvDsiXId3dWCEIRPj/wN+kG6Zw8qgy4QyBw13hi7THRvaj60Q5wAH9VsXvKQfrC9YfOWQWczImEv6fxLtxMZKy/4oyJ36gFtQUyY1rlMknAC/776ICYmI1lsLqYqgtn2O3gNvEAEPNOkMFO3uikY50SKzILeZI1K2xkMi790t6D3oMdOTLLclPeW0wFKy+tNB07CfENyMNj11sfNWTWyRoKBlKAlAaElmeJQ==
    properties :
     width : 205.9
     height : 5.22
    code_elements :
     type_code : 30
     p_codes :
      -
        code : |1+
         i est un entier
         NbSpacerHauteur =  requeteDétailCommandeTous.fdqteafacturer * ldoubleTriple * 2
         NbSpacerHauteur1 = requeteDétailCommandeTous.fdqteafacturer * ldoubleTriple * 2
         si pas requeteDétailCommandeTous.fpeinture alors
         	GrpPeinture..visible = faux
         sinon
         	GrpPeinture..visible = vrai
         	si sansespace(requeteDétailCommandeTous.FnopeintureInterieure) = "" alors
         		LibInterieur..visible = faux
         		DescCouleurInt..visible = faux
         		CouleurInt..visible = faux
         		LibInterieur1..visible = faux
         		DescCouleurInt1..visible = faux
         		CouleurInt1..visible = faux
         		LibInterieur2..visible = faux
         		DescCouleurInt2..visible = faux
         		CouleurInt2..visible = faux
         	FIN
         	si requeteDétailCommandeTous.fTypePeinture = 1 alors
         		LibExtTlt = "Extérieur"
         		LibExtTlt1 = "Extérieur"
         		LibExtTlt2 = "Extérieur"
         	FIN
         FIN
         
         
         
         si ltype = "Tout" ou ltype = "TrsfVideojet" alors
         	iImprimeBloc(IIntercalaire)
         	si requeteDétailCommandeTous.fdcarrelage alors
         		iImprimeBloc(icarrelage)
         	FIN
         fin
         //si ltype = "Tout" ou ltype = "Commande" alors
         //	si requeteDétailCommandeTous.fpeinture alors
         //		pour i = 1 a 3
         //			iimprimebloc(IPeinture)
         //		fin
         //	FIN
         //fin
         
        type : 327692
      -
        type : 327697
        enabled : false
