         -
           code : |1+
            MOIMEME = ""
            
            //si sansespace(rnospacer1) <> "" alors
            //	MOIMEME = "Intercalaire inexistant"
            //	selon ltypespacer
            //		cas "Inex"
            //			si hlitrecherche(spacer,stypesnumero,HConstruitValClé(spacer,stypesnumero,"I",sansespace(rnospacer1))) alors
            //				moimeme = spacer.sdescription
            //			fin
            //		Cas "Aluminium"
            //			si hlitrecherche(spacer,stypesnumero,HConstruitValClé(spacer,stypesnumero,"A",sansespace(rnospacer1))) alors
            //				moimeme = spacer.sdescription
            //			fin
