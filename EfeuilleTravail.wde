            	MOIMEME = "Intercalaire inexistant"
            	si hlitrecherche(IntercalaireCouleurDimensions,IDIntercalaireCouleursnumero,...
            		hconstruitvalcle(IntercalaireCouleurDimensions,IDIntercalaireCouleursnumero,sansespace(requeteDétailCommandeTous.ftypespacer),sansespace(requeteDétailCommandeTous.fdespace2))) alors
