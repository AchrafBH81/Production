 controls : []
 code_elements :
  type_code : 13
  p_codes :
   -
     code : |1+
      procedure EfeuilleTravail(ltype = "Tout" , NoLot est une chaine  = "")
      
      
      hlit(config,1)
      Aenlever est un reel
      lInex est un booleen
      lTypeSpacer est une chaine
      largon est un booleen
      ldoubleTriple est un entier = 1
      lepaisseurpetite est un booleen 
     type : 327680
   -
     code : |1+
      //si requeteDétailCommandeTous.ftype <> 1 alors renvoyer faux
      
      //si ltype = "Commande" et pas requeteDétailCommandeTous.fpeinture alors renvoyer faux
      
      
      
      
      //si hlitrecherche(typespac,tnumero,requeteDétailCommandeTous.ftypespacer) alors
      //	selon typespac.ttype
      //		cas 1
      //			lTypeSpacer = "Inex"
      //		CAs 2
      //			lTypeSpacer = "Aluminium"
      //		cas 3
      //			lTypeSpacer = "ThermoPlastique"	
      //	FIN
      ////	si minuscule(gauche(typespac.tdescription,4))="inex" alors
      ////		linex = vrai
      ////	sinon
      ////		linex=faux
      ////	FIN
      //sinon
      //	lTypeSpacer = "Inex"
      ////	linex=vrai
      //FIN
      
      //si ChaîneOccurrence(requetedetailcommandetous.fcapgaztube,"I") <> 0 alors
      //	linex = vrai
      //sinon
      //	linex = faux	
      //FIN
      si ChaîneOccurrence(requetedetailcommandetous.fcapgaztube,"Z") <> 0 alors
      	largon = vrai
      sinon
      	lArgon = faux	
      FIN
      si sansespace(requetedetailcommandetous.fdcomposant3) = "" ALORS
      	ldoubletriple = 1
      sinon
      	ldoubletriple = 2
      FIN
      SI HLitRecherche(IntercalaireCouleurDimensions,IDIntercalaireCouleursnumero,...
      	HConstruitValClé(IntercalaireCouleurDimensions,IDIntercalaireCouleursnumero,SansEspace(requeteDétailCommandeTous.ftypespacer),SansEspace(requeteDétailCommandeTous.fdespace))) ALORS
      	lepaisseurpetite = (IntercalaireCouleurDimensions.Varinter1A = 0)
      	
      FIN
      SI ldoubleTriple = 2 _ET_ largon _ET_ lepaisseurpetite ALORS
      	LIBELLE54..Visible = Vrai
      	LIBELLE56..Visible = Vrai
      SINON
      	LIBELLE54..Visible = faux
      	LIBELLE56..Visible = faux
      	
      FIN
      //si linex et largon alors
      //	aenlever = config.AenleverInexArgon
      //sinon si linex et pas largon alors
      //	aenlever = config.AenleverInex
      //sinon si pas linex et largon alors
      //	aenlever = config.AenleverAluArgon
      //sinon si pas linex et pas largon alors
      //	aenlever = config.AenleverAlu	
      //FIN
      
      si  hlitrecherche(IntercalaireCouleurDimensions,IDIntercalaireCouleursnumero,...
      	hconstruitvalcle(IntercalaireCouleurDimensions,IDIntercalaireCouleursnumero,sansespace(requeteDétailCommandeTous.ftypespacer),sansespace(requeteDétailCommandeTous.fdespace))) alors
      
      	//si hlitrecherche(IntercalaireCouleurs,IDIntercalaireCouleurs,requeteDétailCommandeTous.ftypespacer) alors
      	//	si hlitrecherche(Intercalaires,IDIntercalaires,IntercalaireCouleurs.idIntercalaires) alors
      	//		si largon alors
      	//			Aenlever = intercalaires.AenleverVideojetargon
      	//		sinon
      	//			aenlever = Intercalaires.AenleverVideojet
      	//	fin
      	si largon alors
      		Aenlever = IntercalaireCouleurDimensions.AenleverVideojetargon
      	sinon
      		aenlever = IntercalaireCouleurDimensions.AenleverVideojet
      	fin
      
      	//	FIN
      FIN
      
      
      
      //selon lTypeSpacer
      //	cas "Inex"
      //		si largon alors
      //			Aenlever = config.AenleverInexArgon
      //		sinon
      //			aenlever = config.AenleverInex	
      //	fin
      //cas "Aluminium"
      //	si largon alors
      //		Aenlever = config.AenleveraluArgon
      //	sinon
      //		aenlever = config.Aenleveralu
      //FIN
      //cas "ThermoPlastique"
      //	si largon alors
      //		Aenlever = config.AenleverICNArgon
      //	sinon
      //		aenlever = config.AenleverICN	
      //FIN
      
      //FIN
      //si requeteDétailCommandeTous.TDemiCarrelage ou pas sansespace(requeteDétailCommandeTous.fdforme) = "" alors
      
      
      // pour permettre d'afficher les calcul pour le demi carrelage aussi
      si pas sansespace(requeteDétailCommandeTous.fdforme) = "" alors
      	GrpDimension..visible = faux
      	GrpDimensionSpacer..visible= vrai
      sinon
      	GrpDimension..visible = vrai
      	GrpDimensionSpacer..visible= vrai
      
      FIN
     type : 327695
   -
     code : |1+
      si ltype = "Commande" et pas requeteDétailCommandeTous.fpeinture alors renvoyer faux
      si ltype = "TrsfVideojet" et requeteDétailCommandeTous.fpeinture_Fa = 1 alors renvoyer faux
     type : 327696
 code_parameters :
