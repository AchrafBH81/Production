  -
    name : BTN_Valider
    identifier : 0x2aa99010e04318f5
    internal_properties : 
    properties :
     x : 143
     y : 97
     width : 76
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         SI SAI_PrixAnglais < 0 OU SAI_PrixMetrique < 0 ALORS
         	Info("Les prix ne peuvent pas être négatifs.")
         	RETOUR
         FIN
         
         bAjout est un booléen = (gnIDSurcharge = 0)
         
         SI bAjout ALORS
         	
         	// Préparer un nouvel enregistrement.
         	HRAZ(PrixSurchargeClient)
         	
         	PrixSurchargeClient.IDClient	= nIDClient
         	PrixSurchargeClient.ennumero	= sNumeroThermos
         	
         SINON
         	
         	// Relire l'enregistrement : ne pas dépendre du buffer
         	// qui était chargé à l'ouverture de la fenêtre.
         	HLitRecherchePremier(PrixSurchargeClient, ...
         	IDPrixSurchargeClient, gnIDSurcharge, hIdentique)
         	
         	SI HErreur() <> 0 ALORS
         		Erreur("Impossible de relire la surcharge.", HErreurInfo())
         		RETOUR
         	FIN
         	
         	SI PAS HTrouve(PrixSurchargeClient) ALORS
         		Info("Cette surcharge a été supprimée. Fermez puis rouvrez la fenêtre.")
         		RETOUR
         	FIN
         	
         FIN
         
         // Affecter les montants saisis.
         PrixSurchargeClient.PrixAnglais		= SAI_PrixAnglais
         PrixSurchargeClient.PrixMetrique	= SAI_PrixMetrique
         
         SI bAjout ALORS
         	
         	SI PAS HAjoute(PrixSurchargeClient) ALORS
         		Erreur("Impossible d'ajouter la surcharge.", HErreurInfo())
         		RETOUR
         	FIN
         	
         SINON
         	
         	SI PAS HModifie(PrixSurchargeClient) ALORS
         		Erreur("Impossible de modifier la surcharge.", HErreurInfo())
         		RETOUR
         	FIN
         	
         FIN
         
         Ferme(FEN_PrixSurchargeClient,vrai)
        type : 18
      -
