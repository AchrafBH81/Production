 message_bar :
  internal_properties : CQAAAAkAAAAjFWXItEk/EPvcbGR+hALkgRfdOpVtIn+yZNxHnmSRFJegE/AnD2HbGAaMfhGCqfzkryHG9FVhjtF+iQYkZ59QBQ88Okhh0vjCoVhOagox2hvIqrJnU30QK15/ZA==
 actionbar : {}
 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1+
      PROCÉDURE FEN_PrixSurchargeClient(LOCAL nIDClient est un entier, LOCAL sNumeroThermos est une chaîne)
      	
      
      // Zéro signifie : création d'une nouvelle surcharge.
      gnIDSurcharge est un entier sur 8 octets = 0
   -
     code : |1-
      
      SI nIDClient <= 0 OU sNumeroThermos = "" ALORS
      	Erreur("Client ou thermos invalide.")
      	Ferme(FEN_PrixSurchargeClient,faux)
      	RETOUR
      FIN
      
      SAI_PrixAnglais		= 0
      SAI_PrixMetrique	= 0
      
      
      
      Si HLitRecherchePremier(PrixSurchargeClient,IDClientennumero,HConstruitValClé(PrixSurchargeClient,IDClientennumero,nIDClient,Complète(sNumeroThermos,20)))
      
      	gnIDSurcharge		= PrixSurchargeClient.IDPrixSurchargeClient
      	
      	SAI_PrixAnglais		= PrixSurchargeClient.PrixAnglais
      	SAI_PrixMetrique	= PrixSurchargeClient.PrixMetrique
      	
      	MaFenêtre..Titre	= "Modifier la surcharge — " + sNumeroThermos
      	
      SINON
      	
      	gnIDSurcharge		= 0
      	
      	MaFenêtre..Titre	= "Ajouter une surcharge — " + sNumeroThermos
      	
      FIN
     type : 34
   -
     type : 180
     enabled : false
   -
     type : 230
     enabled : false
