    properties :
     y : 1.25
     width : 335.6
     height : 37.2
    code_elements :
     type_code : 30
     p_codes :
      -
        code : |1+
         j est un entier
         jj est une chaine
         pour j = 1 a 12
         	jj = sansespace(numeriqueverschaine(j))
         //	{"mois"+jj} = gauche(entierversmoisenlettre(dateversentier(lperiode[j,2]+lperiode[j,1]+"01")),4)+ " "+droite(lperiode[j,2],2)
         	{"mois"+jj} = lmoisabrev[val(lperiode[j,1])]+ " "+droite(lperiode[j,2],2)
         FIN
         
         
         //bloc_corps..VISIBLE = FAUX
         si pas sautdepage alors
         //Code WinDev 5.5 remplacé par la migration :
         //	bloc_frpt2..VISIBLE = FAUX
         	BAS_RUPTURE2..Visible=Faux
         FIN
         anciensecteur = secteur.secteur
         
         
        type : 327692
      -
        type : 327697
        enabled : false
