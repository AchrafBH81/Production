    code_elements :
     type_code : 30
     p_codes :
      -
        code : |1+
         QteCarr1 = requetefeuillelivraison.fanocommande
         qtecarr = requetefeuillelivraison.fdqteafacturer
         qtecarr6 = requetefeuillelivraison.fdcarreauv
         qtecarr8 = requetefeuillelivraison.fdcarreauh
         DescCarr = requetefeuillelivraison.fddesc
         qtecarr24 = RequetefeuilleLivraison.fdnbcarreau
         si RequetefeuilleLivraison.TDemiCarrelage alors
         	PrixUnitCarr = RequetefeuilleLivraison.fdcarrpruxuc
         	TotalCarr = arrondi((((RequetefeuilleLivraison.fdcarrpruxuc)*RequetefeuilleLivraison.fdnbcarreau)...
         	 + RequetefeuilleLivraison.fdcarrprixdebase)* RequetefeuilleLivraison.fdqteafacturer,2)
         sinon
         	PrixUnitCarr = RequetefeuilleLivraison.fdcarrpruxuc
         	TotalCarr = arrondi((RequetefeuilleLivraison.frcarrprixu + RequetefeuilleLivraison.fdcarrprixdebase)* RequetefeuilleLivraison.fdqteafacturer,2)
         FIN
         
         
        type : 327692
      -
        code : |1+
         totaldepage+=totalcarr
         si RequetefeuilleLivraison.TDemiCarrelage alors
         	iImprimeBloc(ITERATION12)
         FIN
