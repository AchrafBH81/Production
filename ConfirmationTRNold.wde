    properties :
     y : 167.554
     width : 269.4
     height : 4.
    code_elements :
     type_code : 30
     p_codes :
      -
        code : |1-
         QteCarr7 = requetefeuillelivraison.fanocommande
         qtecarr9 = requetefeuillelivraison.fdqteafacturer
         qtecarr28 = requetefeuillelivraison.fdcarreauv
         qtecarr64 = requetefeuillelivraison.fdcarreauh
         qtecarr65 = requetefeuillelivraison.fdcarreauv * requetefeuillelivraison.fdcarreauh
         PrixUnitCarr1 = requetefeuillelivraison.fPrixCarreauPeinture
         TotalCarr1 =qtecarr65 * PrixUnitCarr1 * qtecarr9
         selon requetefeuillelivraison.fTypePeinture
         	cas 2
         		si client.CLangue=1 alors DescriptionPeinture = "Peint.TLT" + requetefeuillelivraison.fNoPeintureExtTout + " " + sansespace(requetefeuillelivraison.fdescpeintureExtTout) sinon DescriptionPeinture = "TLT Paint" + requetefeuillelivraison.fNoPeintureExtTout + " " + sansespace(requetefeuillelivraison.fdescpeintureExtTout)
         	cas 1
         		si client.CLangue=1 alors DescriptionPeinture = "Peint. ext." + requetefeuillelivraison.fNoPeintureExtTout + " " + sansespace(requetefeuillelivraison.fdescpeintureExtTout) sinon DescriptionPeinture = "Ext. Paint" + requetefeuillelivraison.fNoPeintureExtTout + " " + sansespace(requetefeuillelivraison.fdescpeintureExtTout)
         FIN
         calculligne++
        type : 327692
      -
        code : |1+
         Remplir_tableau_gl(config.GlPeinturecarrelage,TotalCarr1)
         totaldepage+=totalcarr1
         si sansespace(requetefeuillelivraison.FnopeintureInterieure) <> "" alors
         	iImprimeBloc(ITERATION8)
         fin
         
        type : 327693
      -
        type : 327697
        enabled : false
  -
