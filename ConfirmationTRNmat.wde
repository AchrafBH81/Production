    properties :
     y : 83.145
     width : 205.9
     height : 6.08600000000001
    code_elements :
     type_code : 30
     p_codes :
      -
        code : |1-
         
        type : 327694
      -
        code : |1-
         
         j est un entier
         indicecarr est un entier
         carrtrouve est un booleen = faux//A FAIRE :
         carrnogl est une chaine
         si requetefeuillelivraison.ftype = 1 alors
         	lTypeLigne = "Verre"
         sinon si requetefeuillelivraison.ftype = 2 
         	si pas requetefeuillelivraison.fdverreunite alors
         		lTypeLigne = "Unite"
         	sinon
         		lTypeLigne = "Verre"
         	fin
         sinon si requetefeuillelivraison.ftype = 4
         	ltypeligne = "Carrelage" 
         sinon si requetefeuillelivraison.ftype = 5
         	ltypeligne = "Peinture" 
         fin
         
         calculligne++
         
         selon lTypeLigne
         	cas "Unite"
         		CORPS..VISIBLE = VRAI
         		rubrique17 = requetefeuillelivraison.fdprixu
         		rubrique16 = 1
         	cas "Verre"	
         		corps..visible = vrai
         	cas "Carrelage"
         		corps..visible = faux
                 iImprimeBloc(ITERATION1)
         	cas "Peinture"
         		corps..visible = faux
         		iImprimeBloc(ITERATION2)
         fin
         
         selon lTypeLigne
         	cas "Unite"
         		totalpage +=  arrondi(requetefeuillelivraison.fdqteafacturer * requetefeuillelivraison.fdprixu,2)
         		totalfacture +=  arrondi(requetefeuillelivraison.fdqteafacturer * requetefeuillelivraison.fdprixu,2)
         	cas "Verre"
         		totalpage +=  arrondi(requetefeuillelivraison.fdqteafacturer * ((requetefeuillelivraison.fdpiedcarrefacture * requetefeuillelivraison.fdprixupiedfacture) + ...
         		requetefeuillelivraison.fdextraforme),2)
         		totalfacture +=  arrondi(requetefeuillelivraison.fdqteafacturer * ((requetefeuillelivraison.fdpiedcarrefacture * requetefeuillelivraison.fdprixupiedfacture)+ ...
         		requetefeuillelivraison.fdextraforme),2)
         
         		totalsurcharge += arrondi(requetefeuillelivraison.surchargeenergie,2)
         		totalcap+= arrondi(requetefeuillelivraison.FDExtraCap * requetefeuillelivraison.fdqteafacturer,2)
                 lnombrethermos += requetefeuillelivraison.fdqteafacturer
                 
         	cas "Carrelage"
         		totalpage +=  arrondi(requetefeuillelivraison.fdcarrprixtotal+requetefeuillelivraison.fTotalPeinture,2)
         		totalfacture +=  arrondi(requetefeuillelivraison.fdcarrprixtotal+requetefeuillelivraison.fTotalPeinture,2)
         		lnombrethermosCarrelage += requetefeuillelivraison.fdqteafacturer
         		
         	cas "Peinture"
         		totalpage +=  arrondi(requetefeuillelivraison.fdprixtotal,2)
         fin
        type : 327692
      -
        code : |1+
         si requetefeuillelivraison.ftype <> 4 alors
         
         	si pas facturereimpression alors
         		si requetefeuillelivraison.ftype <> 4 alors
         			SI requetefeuillelivraison.FDExtraCap <> 0 ALORS
         				remplir_tableau(rubrique21,arrondi(rubrique18,2) - (arrondi(requetefeuillelivraison.FDExtraCap) * requetefeuillelivraison.fdqteafacturer))
         				remplir_tableau(CONFIG.CapGL,arrondi(requetefeuillelivraison.FDExtraCap) * requetefeuillelivraison.fdqteafacturer)
         			SINON
         				remplir_tableau(rubrique21,arrondi(rubrique18,2))
         			FIN
         		fin
         	FIN
         
         
         	si pas sansespace(requetefeuillelivraison.fdforme) = ""  //ou requetefeuillelivraison.fdextraforme <> 0 ALORS
         		calculligne++
         		iImprimeBloc(ITERATION9)	
         	FIN
         	si pas sansespace(requetefeuillelivraison.fnotes) = ""  //ou requetefeuillelivraison.fdextraforme <> 0 ALORS
         		calculligne++
         		iImprimeBloc(ITERATION3)
         	FIN
         	si pas sansespace(requetefeuillelivraison.fnotes1) = ""   ALORS
         		calculligne++
         		iImprimeBloc(ITERATION5)	
         	FIN
         sinon
         	si requetefeuillelivraison.fpeinture alors
         		calculligne++
         		iImprimeBloc(ITERATION6)	
         	FIN
         fin
         
         si CORPS..visible ALORS
         	TotaldePage+=rubrique18
         FIN
        type : 327693
      -
        type : 327697
        enabled : false
