     width : 205.9
     height : 5.50300000000001
    code_elements :
     type_code : 30
     p_codes :
      -
        code : |1+
         qtecarr82 = requetefeuillelivraison.fdqteafacturer
         qtecarr87 = requetefeuillelivraison.fdcarreauv
         qtecarr88 = requetefeuillelivraison.fdcarreauh
         qtecarr89 = RequetefeuilleLivraison.fdnbcarreau
         DescCarr1 = "Surcharge Demi Thermos"
         
        type : 327692
      -
        type : 327697
        enabled : false
 controls : []
 code_elements :
  type_code : 13
  p_codes :
   -
     code : |1-
      procedure confirmationtrn(facturereimpression = faux,numerobonl=0,Avecprix=vrai)
      
      tableaucarrelage est un tableau dynamique
      tableaucarrelage = allouer un tableau de 0 par 5 chaine
      dimensiontableaucarrelage est un entier = 0
      calculligne est un entier = 0
      AncienNumCommande est un entier
      AncienNumcarrelage est une chaine = ""
      ldebut est un entier = vrai
      lTypeLigne est une chaine = "" // Verre, verre a l'unité, Unité , carrelage , Peinture
      totalpage est un reel = 0
      totalpage1 est un reel = 0
      totalfacture est un reel = 0
      totalsurcharge est un reel = 0
      totalcap est un reel = 0
      lnombrethermos est un entier
      lnombrethermosCarrelage est un entier
      
      
      
      libérer fac_detail
      fac_detail = allouer un tableau de 1 par 4 chaine
      fac_detail[1,1] = ""
      fac_detail[1,2] = "0.00"
      hlit(config,1)
      si pas avecprix alors
      	grpprix..visible = faux
          //FIN_DOCUMENT..VISIBLE = FAUX
          iteration7..visible=faux
      FIN
     type : 327680
   -
     code : |1-
      
     type : 327695
  procedures :
   -
     name : Rupturefdcomm
     procedure_id : 5145052380760704563
     type_code : 14
     code : |1+
      Procédure Rupturefdcomm()
      
      iimprime("salut")
      
     type : 458752
   -
     name : Remplir_tableau
     procedure_id : 5145052378914096691
     type_code : 14
     code : |1+
      Procédure Remplir_tableau(codegl,montantgl,taxegl=faux)
      codegltrouve est un booleen = faux
      j est un entier = (dimension(fac_detail)/4)
      k est un entier
      si pas j = 1 alors
      pour k = 2 a j
      	si fac_detail[k,1] = codegl alors
      		codegltrouve = vrai
      		fac_detail[k,2]=numeriqueverschaine(val(fac_detail[k,2])+montantgl)
      	    sortir
      	FIN
      FIN
      fin
      
      si pas codegltrouve alors
          
      	dimension(fac_detail,j+1,4)
      	fac_detail[j+1,1] = codegl
      	fac_detail[j+1,2] = numeriqueverschaine(montantgl)
          si taxegl alors
          	fac_detail[j+1,3] = "1"
          fin	
      FIN
      
      
      
     type : 458752
   -
     name : assigneLibelle
     procedure_id : 5145052380465858099
     type_code : 14
     code : |1+
      Procédure assigneLibelle()
      i est un entier
      
      lTableauLibelle est un tableau de  35 chaines
      lTableauLibelle[1]  = "facentete"
      lTableauLibelle[2]  = "facpage"
      lTableauLibelle[3]  = "facpagede"
      lTableauLibelle[4]  = "facnumero"
      lTableauLibelle[5]  = "facdate"
      lTableauLibelle[6]  = "facnumcommande"
      lTableauLibelle[7]  = "facjobdetail"
      lTableauLibelle[8]  = "facquantite"
      lTableauLibelle[9]  = "faclargeur"
      lTableauLibelle[10] = "fachauteur"
      lTableauLibelle[11] = "faclargeurpouce"
      lTableauLibelle[12] = "fachauteurpouce"
      lTableauLibelle[13] = "facdescription"
      lTableauLibelle[14] = "facfini"
      lTableauLibelle[15] = "facspacer"
      lTableauLibelle[16] = "faccarrelage"
      lTableauLibelle[17] = "factotalcarr"
      lTableauLibelle[18] = "facpiedcarre"
      lTableauLibelle[19] = "facpiedcarrefacture"
      lTableauLibelle[20] = "facprixuni"
      lTableauLibelle[21] = "facprixuni"
      lTableauLibelle[22] = "facsurcharge"
      lTableauLibelle[23] = "facsoustotal"
      lTableauLibelle[24] = "facsoustotal"
      lTableauLibelle[25] = "factotal"
      lTableauLibelle[26] = "factotalpage"
      lTableauLibelle[27] = "facrecupar"
      lTableauLibelle[28] = "facmetrecarre"
      lTableauLibelle[29] = "facmetrecarrefacture"
      lTableauLibelle[30] = "facprixunimetre"
      lTableauLibelle[31] = "facprixunimetre"
      lTableauLibelle[32] = "facnotvq"
      lTableauLibelle[33] = "facnotps"
      lTableauLibelle[34] = "factvq"
      lTableauLibelle[35] = "factps"
      
      selon client.CLangue
      	cas 1
      		pour i = 1 a 35
      		   
      			si hlitrecherche(Traduction,TRecherche,lTableauLibelle[i]) alors
      				{"confirmationtrnmat."+lTableauLibelle[i]} = traduction.dFrancais
      			fin
      		FIN
      
      	cas 2
      		pour i = 1 a 35
      			si hlitrecherche(Traduction,TRecherche,lTableauLibelle[i]) alors
      				{"confirmationtrnmat."+lTableauLibelle[i]} = traduction.danglais
      			fin
      		FIN
      fin
     type : 458752
   -
     name : AlimenteHistorique
     procedure_id : 5145052380207253043
     type_code : 14
     code : |1+
      Procédure AlimenteHistorique(lclient,ldate,lmontant)
      
      si  facturereimpression alors
      	renvoyer vrai
      FIN
      lannee est un entier= ldate..Année
      lmois est un entier = ldate..mois
      
      
      si hlitrecherche(HistoAnneeMois,lanneeMois,HConstruitValClé(HistoAnneeMois,lanneemois,lclient,lannee,lmois)) alors
      	HistoAnneeMois.lvente+= lmontant
      	hmodifie(HistoAnneeMois,hNumEnrEnCours)
      sinon
      	HistoAnneeMois.hclient = lclient
      	HistoAnneeMois.lAnnee = lannee
      	HistoAnneeMois.lmois = lmois
      	HistoAnneeMois.lvente = lmontant
      	hajoute(HistoAnneeMois)
      FIN
      
      renvoyer vrai
      
      
      
     type : 458752
   -
     name : AlimenteHistoriqueProduit
     procedure_id : 5145052380832007731
     type_code : 14
     code : |1+
      Procédure AlimenteHistoriqueProduit(lclient,ldate,ltype,lnumprod,lcomp1,lcomp2,lcomp3,lmontant,lsurcharge,ldesc,lqte)
      
      si  facturereimpression alors
      	renvoyer vrai
      FIN
      
      i est un entier
      lannee est un entier = numeriqueverschaine(ldate..annee)
      lmois est une chaine = remplir_zero(sansespace(numeriqueverschaine(ldate..mois)),2)
      lperiode est une chaine= lannee+lmois
      
      
      
      
      
      selon ltype
      
      	cas 1
      		si hlitrecherche(HistoAnneeMoisProduit,hClientlComp1lcomp2lcomp3lAnneelmois,...
      			HConstruitValClé(HistoAnneeMoisProduit,hClientlComp1lcomp2lcomp3lAnneelmois,lclient,"",lcomp1,...
      			lcomp2,lcomp3,lannee,lmois)) alors
      			HistoAnneeMoisProduit.lqte += lqte
      			HistoAnneeMoisProduit.lvente +=  arrondi(lmontant,2)
      			HistoAnneeMoisProduit.lsurcharge +=  arrondi(lsurcharge,2)
      			hmodifie(HistoAnneeMoisProduit,hNumEnrEnCours)
      		sinon
      			HistoAnneeMoisProduit.lperiode = lperiode
      			HistoAnneeMoisProduit.hClient = lclient
      			HistoAnneeMoisProduit.lAnnee = lannee
      			HistoAnneeMoisProduit.lmois = lmois
      			HistoAnneeMoisProduit.ldescription = ldesc
      			HistoAnneeMoisProduit.lProduit = lnumprod
      			HistoAnneeMoisProduit.lComp1 = lcomp1
      			HistoAnneeMoisProduit.lComp2 = lcomp2
      			HistoAnneeMoisProduit.lComp3 = lcomp3
      			HistoAnneeMoisProduit.lsurcharge =  arrondi(lsurcharge,2)
      			HistoAnneeMoisProduit.lqte = lqte
      			HistoAnneeMoisProduit.lType = "T"
      			HistoAnneeMoisProduit.lvente =  arrondi(lmontant,2)
      			hajoute(HistoAnneeMoisProduit)
      		FIN
      		
      		
      		
      	cas 4
      		si hlitrecherche(HistoAnneeMoisProduit,hClientlComp1lcomp2lcomp3lAnneelmois,...
      			HConstruitValClé(HistoAnneeMoisProduit,hClientlComp1lcomp2lcomp3lAnneelmois,lclient,lnumprod,"","","",lannee,lmois)) alors
      			HistoAnneeMoisProduit.lqte += lqte
      			HistoAnneeMoisProduit.lvente +=  arrondi(lmontant,2)
      			HistoAnneeMoisProduit.lsurcharge +=  arrondi(lsurcharge,2)
      			hmodifie(HistoAnneeMoisProduit,hNumEnrEnCours)
      		sinon
      			HistoAnneeMoisProduit.lperiode = lperiode
      			HistoAnneeMoisProduit.hClient = lclient
      			HistoAnneeMoisProduit.lAnnee = lannee
      			HistoAnneeMoisProduit.lmois = lmois
      			HistoAnneeMoisProduit.ldescription = ldesc
      			HistoAnneeMoisProduit.lComp1 = ""
      			HistoAnneeMoisProduit.lComp2 = ""
      			HistoAnneeMoisProduit.lComp3 = ""
      			HistoAnneeMoisProduit.lProduit = lnumprod
      			HistoAnneeMoisProduit.lsurcharge =  arrondi(lsurcharge,2)
      			HistoAnneeMoisProduit.lqte = lqte
      			HistoAnneeMoisProduit.lType = "C"
      			HistoAnneeMoisProduit.lvente =  arrondi(lmontant,2)
      			hajoute(HistoAnneeMoisProduit)
      		FIN
      	autre cas
      		si hlitrecherche(HistoAnneeMoisProduit,hClientlComp1lcomp2lcomp3lAnneelmois,...
      			HConstruitValClé(HistoAnneeMoisProduit,hClientlComp1lcomp2lcomp3lAnneelmois,lclient,lnumprod,"","","",lannee,lmois)) alors
      			HistoAnneeMoisProduit.lqte += lqte
      			HistoAnneeMoisProduit.lvente +=  arrondi(lmontant,2)
      			HistoAnneeMoisProduit.lsurcharge +=  arrondi(lsurcharge,2)
      			hmodifie(HistoAnneeMoisProduit,hNumEnrEnCours)
      		sinon
      			HistoAnneeMoisProduit.lperiode = lperiode
      			HistoAnneeMoisProduit.hClient = lclient
      			HistoAnneeMoisProduit.lAnnee = lannee
      			HistoAnneeMoisProduit.lmois = lmois
      			HistoAnneeMoisProduit.ldescription = ldesc
      			HistoAnneeMoisProduit.lComp1 = ""
      			HistoAnneeMoisProduit.lComp2 = ""
      			HistoAnneeMoisProduit.lComp3 = ""
      			HistoAnneeMoisProduit.lProduit = lnumprod
      			HistoAnneeMoisProduit.lsurcharge =  arrondi(lsurcharge,2)
      			HistoAnneeMoisProduit.lqte = lqte
      			HistoAnneeMoisProduit.lvente =  arrondi(lmontant,2)
      			hajoute(HistoAnneeMoisProduit)
      		FIN
      FIN
      
      
      
      
     type : 458752
