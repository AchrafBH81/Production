    properties :
     width : 205.9
     height : 83.145
    code_elements :
     type_code : 30
     p_codes :
      -
        code : |1+
         hlitrecherche(client,numero,requetefeuillelivraison.faclient)
         clientfax = client.cfax
         assigneLibelle()
         
         selon client.CImpressionAngMet
         	cas 0,1
         		Facpiedcarre..visible = vrai
         		Facmetrecarre..visible = faux
         		si avecprix alors
         			Facpiedcarrefacture..visible = vrai
         			Facprixuni..visible = vrai
         			Facmetrecarrefacture..visible = faux
         			Facprixunimetre..visible = faux
         		fin
         	cas 2 
         		Facpiedcarre..visible = faux
         		Facmetrecarre..visible = vrai
         		si Avecprix alors
         			Facpiedcarrefacture..visible = faux
         			Facprixuni..visible = faux
         			Facmetrecarrefacture..visible = vrai
         			Facprixunimetre..visible = vrai
         		fin
         FIN
         
         SI RequetefeuilleLivraison.lnom <> "" ALORS
         	NomClient1 = RequetefeuilleLivraison.lnom
         	AdresseClient1 = RequetefeuilleLivraison.lrue
         	VilleClient1 = RequetefeuilleLivraison.lville
         	CodePostalClient1 = RequetefeuilleLivraison.lcodepostal	
         SINON
         	NomClient1 = "  M Ê M E / S A M E  "
         	AdresseClient1 = ""
         	VilleClient1 = ""
         	CodePostalClient1 = ""	
         	
         FIN
         
         //si requetefeuillelivraison.idlivraison <> 0 alors
         //	si hlitrecherche(ClientLivraison,IDClientLivraison,requetefeuillelivraison.idlivraison) alors
         //		nomclient1 = ClientLivraison.lNom
         //		adresseclient1 = ClientLivraison.lRue
         //		VilleClient1 = ClientLivraison.lVille+","+ClientLivraison.lprovince
         //		CodePostalClient1 = ClientLivraison.lCodePostal	
         //		
         //FIN
         //sinon
         //	nomclient1 = "  M Ê M E / S A M E  "
         //	adresseclient1 = ""
         //	VilleClient1 = ""
         //	CodePostalClient1 = ""	
         //FIN
         
         si sansespace(RequetefeuilleLivraison.fnopeinture) = "" alors
         	grppeinture..visible = faux
         	
         sinon
         	CCouleurPeinture = RequetefeuilleLivraison.fnopeinture
         	Cdescpeinture = RequetefeuilleLivraison.fdescpeinture
         	si RequetefeuilleLivraison.ftypepeinture1 = 1 alors
         		libelle10 = "Peinture extérieure:"
         	FIN
         FIN
         si SansEspace(RequetefeuilleLivraison.fnopeinture1) <> "" alors
         	CCouleurPeinture1 = RequetefeuilleLivraison.fnopeinture1
         	Cdescpeinture1 = RequetefeuilleLivraison.fdescpeinture1
         	libelle10 = "Peinture extérieure:"
         	GrpPeintureInt..visible = vrai
         sinon
         	GrpPeintureInt..visible = faux    
         FIN
        type : 327692
      -
        type : 327697
        enabled : false
