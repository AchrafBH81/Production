        p_codes :
         -
           code : |1+
            //si hlitrecherche(typespac,tnumero,RequetefeuilleLivraison.ftypespacer) ALORS
            //	moimeme = typespac.tdesccourte
            //FIN
            SI Val(SansEspace(RequetefeuilleLivraison.ftypespacer)) <> 0 _AND_ HLitRecherche(IntercalaireCouleurs,IDIntercalaireCouleurs,Val(SansEspace(RequetefeuilleLivraison.ftypespacer))) ALORS
            	SI Client.CLangue=1 ALORS MoiMême=IntercalaireCouleurs.DescriptionCourte SINON MoiMême=IntercalaireCouleurs.DesctiptionCourteAnglais
