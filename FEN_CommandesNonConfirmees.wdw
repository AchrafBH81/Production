  -
    name : COMBO_User
    identifier : 0x20e8621bf909f860
    internal_properties : 
    properties :
     x : 598
     y : 36
     width : 369
     height : 24
    dropdown :
     internal_properties : 
     type : 7
    type : 14
    code_elements :
     type_code : 23
     p_codes :
      -
        code : |1-
         
         sCondition est une chaîne
         
         
         si COMBO_User..ValeurAffichée <> "<Tous>" alors
           sCondition = "AND Facture.Username = '" + sansespace(COMBO_User) + "'"	
         FIN
         TableSupprimeTout(TABLE_SansNom1)
         SI HExécuteRequêteSQL(gsdReqsql,hRequêteDéfaut,ChaîneConstruit(gsTxtSql,SaiDateDebut,SaiDateFin,sCondition)) ALORS
         	FichierVersTableMémoire(TABLE_SansNom1,gsdReqsql)
         FIN
         
         TableTrie(TABLE_SansNom1,"COL_Date","COL_user")
        type : 33
      -
        type : 17
        enabled : false
