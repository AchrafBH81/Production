 message_bar :
  internal_properties : CQAAAAkAAAAjFWXItEk/EPvcbGR+hALkgRfdOpVtIn+yZNxHnmSRFJegE/AnD2HbGAaMfhGCqfzkryHG9FVhjtF+iQYkZ59QBQ88Okhh0vjCoVhOagox2hvIqrJnU30QK15/ZA==
 actionbar : {}
 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1+
      PROCEDURE MaFenêtre()
      gsdReqsql est une source de Données
      gsTxtSql est une chaîne =[
      	select Facture.fatypedocument,facture.fanumero,facture.fanocommande,facture.fadate,facture.faclient,
      	facture.nom,usager.prenom+' '+usager.nom as nomcomplet,client.cconfirmation,facture.CreatedTime from facture
      	inner join client on client.numero = facture.faclient
      	left join usager on usager.NomUsager = facture.username
      	where facture.fadate between '%1' and '%2' %3 and facture.ConfirmationSended = 0
      	order by facture.fanumero
      ]
      gtabUser est un tableau de cUser
      gsdReqsqlUser est une source de Données
      gsTxtSqlUser est une chaine = [
      select * from usager where usager.isactive = 1
      ]
      si HExécuteRequêteSQL(gsdReqsqlUser,hRequêteDéfaut,gsTxtSqlUser) alors
      	FichierVersMémoire(gtabuser,gsdReqsqlUser)
      	listeaffiche(COMBO_User)
      	listeselectplus(COMBO_User,1)
      FIN
