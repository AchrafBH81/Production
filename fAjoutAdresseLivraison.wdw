   -
     name : SaveFrequence
     procedure_id : 2134831649325828229
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //SaveFrequence (<_IDClientLivraison>)
      //
      // Paramètres :
      // 	_IDClientLivraison : <indiquez ici le rôle de _IDClientLivraison>
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE SaveFrequence(_IDClientLivraison)
      
      pour chaque _frequence,id de TAFrequence
      	si hlitrecherche(ClientLivraisonFrequence,IDClientLivraisonIDSaisonLivraison,[_IDClientLivraison,id]) alors
      		ClientLivraisonFrequence.Frequence = _frequence.Frequence
      		ClientLivraisonFrequence.DateDeReference = _frequence.DateDeReference
      		hmodifie(ClientLivraisonFrequence,hNumEnrEnCours)
      	sinon
      		hraz(ClientLivraisonFrequence)
      		ClientLivraisonFrequence.IDClientLivraison = _IDClientLivraison
      		ClientLivraisonFrequence.IDSaisonLivraison = id
      		ClientLivraisonFrequence.Frequence = _frequence.Frequence
      		ClientLivraisonFrequence.DateDeReference = _frequence.DateDeReference
      		
      		hajoute(ClientLivraisonFrequence)	
      	FIN
      FIN
      
      
