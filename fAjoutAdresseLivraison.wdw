            -
              code : |1-
               si moimeme _ou_ IntPickUp alors
               	OngletAdresseLivraison[2]..etat = grise 
               sinon 
               	si pas IntPickUp alors
               		si TAjourlivraisonsaison..occurrence = 0 alors
               			POUR TOUT SaisonLivraison 
               				jourlivraison = allouer un stJoursLivraison
               				TAjourlivraisonsaison[SaisonLivraison.IDSaisonLivraison] = jourlivraison
               			FIN
               		fin
               		
               		OngletAdresseLivraison[2]..etat = actif
               		ListeSelectPlus(Combo_SaisonLivraison,1)
               		ExécuteTraitement(Combo_SaisonLivraison,trtSélection)
               	fin
