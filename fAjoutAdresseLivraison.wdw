           type_code : 5
           p_codes :
            -
              code : |1+
               //JLiv est un entier = 0
               //JLiv = gpclPresentation.JoursLivraison
               //i est entier
               //POUR i = 1 A 7
               //	si JLiv & Puissance(2,i-1) > 0 alors
               //		JoursLivraison[i] = (JoursLivraison[i]..etat = actif)
               //	sinon
               //		JoursLivraison[i] = faux
               //	FIN
               //FIN
               
              type : 14
            -
              code : |1-
               
              type : 15
            -
              code : |1+
               //JLiv est un entier = 0
               //i est entier
               //
               //SI PAS blnMemesJoursLivraisonPourTousClients ALORS
               //	POUR i = 1 A 7
               //		JLiv += (JoursLivraison[i] ? 1 SINON 0) * Puissance(2,i-1)
               //	FIN
               //	gpclPresentation.JoursLivraison = JLiv
               //FIN
               //
               //si pas blnEnChargement alors
               //	ProcéduresInterface.configurer_Ecran_Fiche("M")
               //	
               //	BtnFlechePrecedent..Grisé = Vrai
               //	BtnFlecheSuivant..Grisé = Vrai
               //FIN
               //ExécuteTraitement(OngletAdresseLivraison.BtnSave,trtClic)
               TAjourlivraisonsaison[Combo_SaisonLivraison].JoursLivraisonClientCompile=0
               POUR i = 1 A 7
               	
               	TAjourlivraisonsaison[Combo_SaisonLivraison].JoursLivraisonClientCompile += (JoursLivraison[i] ? 1 SINON 0) * Puissance(2,i-1)
               FIN
               
               
               
               AfficherJourLivraisonPourUnMois()
               lIndice est un entier = indiceencours()
               TAjourlivraisonsaison[Combo_SaisonLivraison].tabJourLivraison[lIndice] = jourslivraison[lIndice]
               si pas JoursLivraison[lIndice] alors TAjourlivraisonsaison[Combo_SaisonLivraison].tabJourLivraisonCamion[lIndice] = 0
               
               	si JoursLivraison[lIndice] alors
               		{"Combo_Camion"+lIndice,indChamp}..visible = Vrai
               		{"Combo_Camion"+lIndice,indChamp}..etat = actif
               		{"SaiSequence"+lIndice,indChamp}..visible = Vrai
               		{"SaiSequence"+lIndice,indChamp}..etat = actif
               		
               	sinon
               		{"Combo_Camion"+lIndice,indChamp}..valeur = -1
               		{"Combo_Camion"+lIndice,indChamp}..Visible = faux
               		{"Combo_Camion"+lIndice,indChamp}..Etat = AffichageSeulement
               		{"SaiSequence"+lIndice,indChamp}..visible = faux
               		{"SaiSequence"+lIndice,indChamp}..etat = AffichageSeulement
               	FIN
              type : 17
