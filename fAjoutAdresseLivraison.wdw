  widthClient : 691
  heightClient : 477
 controls :
  -
    name : BTN_SORTIE
    identifier : 0x4756b026273d70e1
    internal_properties : 
    properties :
     x : 26
     y : 6
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         si grpdata..Modifié alors
         	si acso_message("Question","Certaines modifications n'ont pas été sauvegardé"+rc+"Voulez-vous quitter sans sauvegarder?","OuiNon") = idyes ALORS
         		ferme(fAjoutAdresseLivraison)
         	FIN
         sinon
         	ferme(fAjoutAdresseLivraison)
         
         FIN
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_OK
    identifier : 0x4756b0262c5b70e1
    internal_properties : 
    properties :
     x : 70
     y : 6
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         EcranVersFichier(fAjoutAdresseLivraison,ClientLivraison)
         selon ltype
         	cas "A"
         		ecranversfichier(fAdresseLivraison,ClientLivraison)
         		ClientLivraison.idclient = sansespace(client.numero)
         		hajoute(ClientLivraison)
         		SaveJourCamion(ltype,Client.IDClient,ClientLivraison.IDClientLivraison)
         		SaveFrequence(ClientLivraison.IDClientLivraison)
         	cas "M"
         		EcranVersFichier(fAdresseLivraison,ClientLivraison)
         		hmodifie(ClientLivraison,hNumEnrEnCours)
         		si pas IntJourLivraison alors
         			SaveJourCamion(ltype,Client.IDClient,ClientLivraison.IDClientLivraison)
         		sinon
         			POUR TOUT JourLivraisonClient AVEC IdAdresseLivraison = ClientLivraison.IDClientLivraison
         				HSupprime(JourLivraisonClient,hNumEnrEnCours)
         			FIN
         		fin
         		SaveFrequence(ClientLivraison.IDClientLivraison)
         		
         FIN
         
         ferme(fAjoutAdresseLivraison)
        type : 18
      -
        type : 161
        enabled : false
