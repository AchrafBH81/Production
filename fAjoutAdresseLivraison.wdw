   -
     code : |1+
      procedure fAjoutAdresseLivraison(lnoclient="",ltype="A",lvideojet=faux)
      
      
      
      TAjourlivraisonsaison est un tableau associatif (*, *, wlEntier) de stJoursLivraison
      TAFrequence est un tableau associatif (*, *, wlEntier) de stFrequence
      jourlivraison est une stJoursLivraison
      si lvideojet alors
      	grpVideojet..visible = vrai
      sinon
      	grpVideojet..visible = faux
      	
      FIN
      mafenetre..ValeurRenvoyée = 0
      st_frequence est un stFrequence
      
      
   -
     code : |1-
      
      
      selon ltype
      	cas "A"
      		raz()
      		hraz(ClientLivraison)
      
      		
              pour TOUT SaisonLivraison 
                  jourlivraison = allouer un stJoursLivraison
              	TAjourlivraisonsaison[SaisonLivraison.IDSaisonLivraison] = jourlivraison
              	TAFrequence[SaisonLivraison.IDSaisonLivraison] = st_frequence
              fin
              listeselectplus(Combo_SaisonLivraison,1)	
              	
      	cas "M"
      		FillObject(clientlivraison.IDClientLivraison)
      		FichierVersEcran(fAjoutAdresseLivraison,ClientLivraison)	
      		ExécuteTraitement(IntJourLivraison,trtModification)
      FIN
      si pas IntJourLivraison alors ExécuteTraitement(Combo_SaisonLivraison,trtSélection)
     type : 34
   -
     type : 180
     enabled : false
   -
     type : 230
     enabled : false
   -
     code : |1-
      
      si ltype ="A" alors
      	mafenetre..ValeurRenvoyée = ClientLivraison.IDClientLivraison
      FIN
     type : 2
   -
     type : 11
   -
     type : 12
   -
     type : 17
   -
     type : 13
  procedures :
   -
     name : AfficherJourLivraisonPourUnMois
     procedure_id : 2132274207164193851
     type_code : 14
     code : |1-
      PROCEDURE AfficherJourLivraisonPourUnMois()
      
      UneDate est une date = CalendrierPosition(CalendrierLivraison)
      
      UneDate..Jour = 31
      
      LeNombreDeJour est un entier = UneDate..jour
      
      
      
      jliv est un entier = 21
      
      
      i est entier
      
      //POUR i = 1 A 7
      //	SI jliv & Puissance(2,i-1) > 0 ALORS
      //		JoursLivraison[i] = Vrai
      //	SINON
      //		JoursLivraison[i] = Faux
      //	FIN
      //FIN
      
      UneDate..Jour = 1
      
      POUR i = 1 A LeNombreDeJour
      	UneDate..Jour = i
      	SI EstJourFerie(UneDate) ALORS
      		CalendrierLivraison[UneDate]..CouleurFond = iRougeClair
      		CalendrierLivraison[UneDate]..Couleur = iBlanc
      		CONTINUER
      	FIN	
      	si pas JoursLivraison[DateVersJour(UneDate)] _et_ pas JoursLivraison[DateVersJour(UneDate)]..Etat = Actif alors
      		CalendrierLivraison[UneDate]..CouleurFond = iGrisClair
      		continuer
      	FIN
      	SI SaiFrequence > 1 ALORS
      		SI modulo(DateDifférence(PremierJourDeLaSemaine(saiDateReference),PremierJourDeLaSemaine(UneDate)),SaiFrequence*7) <> 0
      			
      			//		si modulo(NoSemaine,Frequence) <> NoRefLocal alors
      			CalendrierLivraison[UneDate]..CouleurFond = iTransparent
      			CONTINUER
      			
      		FIN
      	FIN
      	
      	
      	SI JoursLivraison[DateVersJour(UneDate)] ALORS
      		CalendrierLivraison[UneDate]..CouleurFond = VertClair
      	SINON si JoursLivraison[DateVersJour(UneDate)]..etat = actif 
      		CalendrierLivraison[UneDate]..CouleurFond = iTransparent
      	sinon
      		CalendrierLivraison[UneDate]..CouleurFond = iGrisClair
      		
      	FIN
      	
      	
      	
      	
      FIN
     type : 458752
   -
     name : SaveJourCamion
     procedure_id : 2133123880342431003
     type_code : 14
     code : |1-
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //SaveJourCamion (<_Type> est chaîne, <_IdClient> est entier, <_idclientlivraison> est entier)
      //
      // Paramètres :
      //	_Type (chaîne ANSI) : <indiquez ici le rôle de _Type>
      //	_IdClient (entier) : <indiquez ici le rôle de _IdClient>
      //	_idclientlivraison (entier) : <indiquez ici le rôle de _idclientlivraison>
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE SaveJourCamion(_Type est une chaine,_IdClient est un entier,_idclientlivraison est un entier)
      
      _message est un booleen = faux
      pour tout _jourLivraisonCamion,_idsaison de TAjourlivraisonsaison
      	selon _Type
      		cas "A"
      			hraz(JourLivraisonClient)
      			JourLivraisonClient.IDClient = _IdClient
      			JourLivraisonClient.IdAdresseLivraison = _idclientlivraison
      			JourLivraisonClient.JourLivraison = _jourLivraisonCamion.JoursLivraisonClientCompile
      			JourLivraisonClient.IDSaisonLivraison = _idsaison
      			pour i = 1 a 7
      				SI _jourLivraisonCamion.JoursLivraisonClientCompile & Puissance(2,i-1) <> 0 _ET_ _jourLivraisonCamion.tabJourLivraisonCamion[i] <= 0  ALORS
      //					_jourLivraisonCamion.tabJourLivraison[i] = Faux
      //					JourLivraisonClient.JourLivraison -= ReCompileJoursLivraison(i)
      					_message = Vrai
      				SINON
      					JourLivraisonClient.IDCamions[i] = _jourLivraisonCamion.tabJourLivraisonCamion[i]
      					JourLivraisonClient.ShippingSequence[i] = _jourLivraisonCamion.tabShippingSequence[i]
      					
      				FIN
      			fin
      //			JourLivraisonClient.JourLivraison -= CompileCamion(_jourLivraisonCamion)
      			hajoute(JourLivraisonClient)
      		Cas "M"
      			si hlitrecherche(JourLivraisonClient,IDClientIDSaisonLivraison,[_IdClient,_idsaison,_idclientlivraison]) ALORS
      				
      				JourLivraisonClient.JourLivraison = _jourLivraisonCamion.JoursLivraisonClientCompile
      				POUR i = 1 a 7
      					SI _jourLivraisonCamion.JoursLivraisonClientCompile & Puissance(2,i-1) <> 0 _ET_ _jourLivraisonCamion.tabJourLivraisonCamion[i] <= 0  ALORS
      //						_jourLivraisonCamion.tabJourLivraison[i] = Faux
      //						JourLivraisonClient.JourLivraison -= ReCompileJoursLivraison(i)
      						_message = Vrai
      					SINON
      						JourLivraisonClient.IDCamions[i] = _jourLivraisonCamion.tabJourLivraisonCamion[i]
      						JourLivraisonClient.ShippingSequence[i] = _jourLivraisonCamion.tabShippingSequence[i]
      					FIN
      				FIN
      				hmodifie(JourLivraisonClient,hNumEnrEnCours)
      			sinon
      				HRAZ(JourLivraisonClient)
      				JourLivraisonClient.IDClient = _IdClient
      				JourLivraisonClient.IdAdresseLivraison = _idclientlivraison
      				JourLivraisonClient.JourLivraison = _jourLivraisonCamion.JoursLivraisonClientCompile
      				JourLivraisonClient.IDSaisonLivraison = _idsaison
      				POUR i = 1 a 7
      					SI _jourLivraisonCamion.JoursLivraisonClientCompile & Puissance(2,i-1) <> 0 _ET_ _jourLivraisonCamion.tabJourLivraisonCamion[i] <= 0  ALORS
      //						_jourLivraisonCamion.tabJourLivraison[i] = Faux
      //						JourLivraisonClient.JourLivraison -= ReCompileJoursLivraison(i)
      						_message = Vrai
      					SINON
      						JourLivraisonClient.IDCamions[i] = _jourLivraisonCamion.tabJourLivraisonCamion[i]
      						JourLivraisonClient.ShippingSequence[i] = _jourLivraisonCamion.tabShippingSequence[i]
      					FIN
      				FIN
      	//						JourLivraisonClient.JourLivraison = CompileCamion(_jourLivraisonCamion)
      				HAjoute(JourLivraisonClient)
      				
      			FIN
      	fin
      FIN
      
      si _message alors
      	Erreur("Certains camions pour certaines journées n'étaient pas définies","Veuillez vérifier")
      FIN
     type : 458752
   -
     name : FillObject
     procedure_id : 2133130494592164723
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //FillObject (<_IDClientLivraison>)
      //
      // Paramètres :
      // 	_IDClientLivraison : <indiquez ici le rôle de _IDClientLivraison>
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE FillObject(_IDClientLivraison)
      TAjourlivraisonsaison.SupprimeTout()
      TAFrequence.SupprimeTout()
      _stjourlivraison est un stJoursLivraison
      pour CHAQUE SaisonLivraison 
      	_stjourlivraison = allouer un stJoursLivraison
      	TAjourlivraisonsaison[SaisonLivraison.IDSaisonLivraison] = _stjourlivraison
      	
      FIN
      hlitrecherchepremier(JourLivraisonClient,IdAdresseLivraison,_IDClientLivraison)
      tantque JourLivraisonClient.IdAdresseLivraison = _IDClientLivraison _ET_ pas hendehors(JourLivraisonClient)
      		_stjourlivraison = allouer un stLivraison
      		_stjourlivraison.JoursLivraisonClientCompile = JourLivraisonClient.JourLivraison
      		pour i = 1 a 7
      			_stjourlivraison.tabJourLivraisonCamion[i] = JourLivraisonClient.IDCamions[i]
      			_stjourlivraison.tabShippingSequence[i] = JourLivraisonClient.ShippingSequence[i]
      			
      		fin
      		TAjourlivraisonsaison[JourLivraisonClient.IDSaisonLivraison] = _stjourlivraison
      		hlitsuivant(JourLivraisonClient,IdAdresseLivraison)
      fin
      
      hlitrecherche(ClientLivraisonFrequence,IDClientLivraison,_IDClientLivraison)
      tantque ClientLivraisonFrequence.IDClientLivraison = _IDClientLivraison _et_ pas hendehors(ClientLivraisonFrequence)
      	_frequence est un stFrequence = allouer un stfrequence
      	_frequence.Frequence = ClientLivraisonFrequence.Frequence
      	_frequence.DateDeReference = ClientLivraisonFrequence.DateDeReference
      	TAFrequence[ClientLivraisonFrequence.IDSaisonLivraison] = _frequence
      	hlitsuivant(ClientLivraisonFrequence)
      FIN
      
      
