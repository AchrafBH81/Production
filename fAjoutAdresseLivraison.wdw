        -
          name : Combo_SaisonLivraison
          identifier : 0x2d975a3cca0e9a33
          internal_properties : 
          properties :
           x : 30
           y : 30
           width : 228
           height : 24
          dropdown :
           internal_properties : 
           type : 7
          type : 14
          code_elements :
           type_code : 23
           p_codes :
            -
              code : |1+
               HLitRecherche(SaisonLivraison,IDSaisonLivraison,moimeme)
               i est entier
               POUR i = 1 À 7
               	JoursLivraison[i] = faux
               	JoursLivraison[i]..Etat  = actif
               	{"Combo_camion"+i,indChamp}..visible = faux
               fin
               POUR i = 1 À 7
               	SI SaisonLivraison.JoursLivraison & Puissance(2,i-1) = 0 ALORS
               		JoursLivraison[i]..Etat  = Grisé
               	SINON	
               		
               	FIN
               FIN
               
               
               
               
               si val(moimeme) > 0 alors
               	lJoursLivraisonClient est un stJoursLivraison= TAjourlivraisonsaison[moimeme]
               	
               	
               	POUR i = 1 À 7
               		
               		SI lJoursLivraisonClient.JoursLivraisonClientCompile & Puissance(2,i-1) <> 0 ALORS
               			jourslivraison[i] = (JoursLivraison[i]..Etat  = actif)
               		SINON	
               			JoursLivraison[i]= faux
               		FIN
               		
               		{"Combo_camion"+i,indChamp}..visible = JoursLivraison[i]
               		{"Combo_camion"+i,indChamp} = lJoursLivraisonClient.tabJourLivraisonCamion[i]
               		
               		si {"Combo_camion"+i,indChamp}..Visible alors 
               			{"Combo_camion"+i,indChamp}..etat = actif
               		sinon
               			{"Combo_camion"+i,indChamp}..valeur = -1
               		fin
               		{"saisequence"+i,indChamp}..visible = JoursLivraison[i]
               		{"saisequence"+i,indChamp} = lJoursLivraisonClient.tabShippingSequence[i]
               		si {"saisequence"+i,indChamp}..Visible alors
               			{"saisequence"+i,indChamp}..etat = actif 
               		sinon
               			{"saisequence"+i,indChamp}..etat = AffichageSansSélection
               			{"saisequence"+i,indChamp} = 0
               		fin
               	FIN
               	si TAFrequence[moimeme] <> null alors
               		SaiFrequence = TAFrequence[moimeme].frequence
               		SaiDatereference = TAFrequence[moimeme].DateDeReference
               	sinon
               		_frequence est un stFrequence = allouer un stFrequence
               		_frequence.Frequence = 1
               		_frequence.DateDeReference = ""
               		TAFrequence[moimeme] = _frequence
               		SaiFrequence = TAFrequence[MoiMême].frequence
               		SaiDatereference = TAFrequence[MoiMême].DateDeReference
               	fin
               	
               	AfficherJourLivraisonPourUnMois()
               fin
              type : 33
            -
              type : 17
              enabled : false
        -
