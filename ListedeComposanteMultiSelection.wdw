 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1+
      
      fonction ListedeComposanteMultiSelection(CurrentList est une chaine = "",gnType est un entier =1)
      // L'appel à cette fenêtre est du type:
      //       OUVRE(nom_fen,SaisieOK)
      //		 si SaisieOK alors 		// Un enregistrement a été sélectionné
      // Vous pouvez aussi utiliser la syntaxe d'appel suivante:
      //       SI OUVRE(nom_fen) alors		// Un enregistrement a été sélectionné
      
      
      MaFenêtre..ValeurRenvoyée	= ""
      // Pour compatibilité 5.5
      MoiMême..Visible			= Vrai
      Global
      STProduct est une structure
      	sProductNumber	est une chaîne
      	sProductName	est une chaîne
      	
      fin
      resultat		est une chaine
      gtabCurrentList	est un tableau de chaine
      ChaîneVersTableau(currentlist,gtabCurrentList,";")
      gnRes		est une entier
      
      gsTxtsql	est une chaine	= [
      	select  inum as sProductNumber,idesc as sProductName from invent where invent.itype = 1 AND invent.iactif = 1 
      ]
      gsdReqsql est une source de donnees
      gtabProduct est un tableau de STProduct
      
      HExécuteRequêteSQL(gsdReqsql,hRequêteDéfaut,gsTxtsql)
      fichierverstableau(gtabproduct,gsdreqsql)
      gtabProduct.trie(ttMembre,"sProductNumber")
      
   -
     code : |1-
      si gtabProduct..Occurrence = 0 alors
      	erreur("Aucun produit disponible")
      	ferme(mafenetre)
      FIN
      TableAffiche(TABLE,taInit)
      
      pour chaque sComposante de gtabCurrentList
      	gnres =  TableCherche(ProductNumber,complete(sComposante,10),rechercheIdentique) 
      	si gnres<> -1 alors table.SelectPlus(gnres)
      FIN
      TablePosition(TABLE,1,tavisible)
     type : 34
   -
     type : 180
     enabled : false
   -
     type : 230
     enabled : false
   -
     code : |1+
      
      hdesactivefiltre(invent)
      
      //Renvoyer SaisieOK
      
      
      
     type : 2
