  -
    name : Btn_Ok
    identifier : 0x2352a8fc0ed1e943
    internal_properties : 
    properties :
     x : 427
     y : 59
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         sablier(vrai)
         sdReqSql est un source de donnees
         sTxtSql est une chaine = [
         	select ftypespacer as Intercalaire, IntercalaireCouleurs.Description as description, sum(round(pietage,2)) as Piedlineaire,epaisseur,sum(qte) as TotQte  from
         	
         	(select ftypespacer,fdespace as epaisseur,
         	sum((wl.val(fdlargeur)+wl.val(fdhauteur)) * 2 * fdqteafacturer / 12) as pietage,
         sum(hfdetail.fdqteafacturer) as QTE
         	from hfdetail 
         	inner join hfacture on hfacture.fanumero = hfdetail.fdnocomm  where hfacture.fadate Between  '%1' and '%2' and hfdetail.ftype = 1 and hfdetail.fdverreunite = 0 and hfacture.facalcul = 1 and ftypespacer <> 0
         	group by ftypespacer,epaisseur
         	union all
         	
         	select ftypespacer,fdespace as epaisseur,
         	sum((wl.val(fdlargeur)+wl.val(fdhauteur)) * 2 * fdqteafacturer * 3.28084) as pietage,
         sum(hfdetail.fdqteafacturer) as QTE
         	from hfdetail 
         	inner join hfacture on hfacture.fanumero = hfdetail.fdnocomm  where hfacture.fadate Between  '%1' and '%2' and hfdetail.ftype = 1 and hfdetail.fdverreunite = 0 and hfacture.facalcul = 2 and ftypespacer <> 0
         	group by ftypespacer,epaisseur
         	
         	
         	union all
         	
         	select ftypespacer,fdespace2 as epaisseur,
         	sum((wl.val(fdlargeur)+wl.val(fdhauteur)) *2 * fdqteafacturer / 12) as pietage,
         sum(hfdetail.fdqteafacturer) as QTE
         	from hfdetail 
         	inner join hfacture on hfacture.HFCLEUNIK = hfdetail.HFCLEUNIK  where
         	hfacture.fadate Between  '%1' and '%2' and hfdetail.ftype = 1 and hfdetail.fdverreunite = 0 and hfacture.facalcul = 1 and ftypespacer <> 0 and wl.val(fdespace2) > 0
         	group by ftypespacer,epaisseur
         	union all
         	
         	select ftypespacer,fdespace2 as epaisseur,
         	sum((wl.val(fdlargeur)+wl.val(fdhauteur)) * 2 * fdqteafacturer * 3.28084) as pietage,
         sum(hfdetail.fdqteafacturer) as QTE
         	from hfdetail 
         	inner join hfacture on hfacture.HFCLEUNIK = hfdetail.HFCLEUNIK 
         	where hfacture.fadate Between  '%1' and '%2' and hfdetail.ftype = 1 and hfdetail.fdverreunite = 0 and hfacture.facalcul = 2 and ftypespacer <> 0 and wl.val(fdespace2) > 0
         	group by ftypespacer,epaisseur
         	
         	) as req
         	
         	left join IntercalaireCouleurs on IntercalaireCouleurs.IDIntercalaireCouleurs = wl.val(req.ftypespacer)
         	group by intercalaire,description,epaisseur
         	order by description,epaisseur
         	
         ]
         gtabAchatSpacer.SupprimeTout()
         sTxtSql = ChaîneConstruit(sTxtSql,csddatedebut,csddatefin)
         
         ouvrefille(FEN_AttenteGif,"Calcul des intercalaires en cours .....")
         ThreadExécute("Achat",threadNormal,getAchat,sTxtSql)
         tantque Threadetat("Achat") = threadEnCours
         	multitache(-1)
         FIN
         ferme(FEN_AttenteGif)
         //si hexecuterequetesql(sdReqSql,hRequêteDéfaut,sTxtSql)  alors
         //	tantque pas sdReqSql..ExécutionTerminée
         //		multitache(-1)
         //	FIN
         //	
         //	
         //	pour TOUT sdReqSql 
         //		gstCurrentAchatSpacer = allouer un STAchatIntercalaire()
         //		gstCurrentAchatSpacer.sDescription = sdReqSql.description
         //		gstCurrentAchatSpacer.xTotal = sdReqSql.piedlineaire
         //		gtabAchatSpacer.ajoute(gstCurrentAchatSpacer)
         //	FIN
         //	
         //fin
         Sablier(Faux)
         
         iConfigure(imprimanterapport,Vrai)
         
         iParamètre("DEFAUT=NON")
         iParamètre("ORIENTATION=PORTRAIT")
         iParamètre("QUALITE=HAUTE")
         
         SI SélecteurDestination = 1 ALORS
         	iAperçu(2,"Achat d'intercalaires")
         FIN
         
         
         
         
         
         iimprimeetat(EAchatIntercalaire,gtabAchatSpacer,SélecteurType = "D")
         
         
        type : 18
      -
        type : 161
        enabled : false
