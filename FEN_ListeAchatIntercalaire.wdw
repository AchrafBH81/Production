  procedures :
   -
     name : getAchat
     procedure_id : 1392439160636747433
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //getAchat (<sTxtSql> est chaîne)
      //
      // Paramètres :
      //	sTxtSql (chaîne ANSI) : <indiquez ici le rôle de sTxtSql>
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE getAchat(sTxtSql est une chaine)
      sdReqsql est une source de donnees
      
      SI HExécuteRequêteSQL(sdReqsql,hRequêteDéfaut,sTxtSql)  ALORS
      	TANTQUE PAS sdReqsql..ExécutionTerminée
      		Multitâche(-1)
      	FIN
      	
      	
      	POUR TOUT sdReqsql 
      		gstCurrentAchatSpacer = allouer un STAchatIntercalaire()
      		gstCurrentAchatSpacer.sDescription = sdReqsql.description
      		gstCurrentAchatSpacer.xTotal = sdReqsql.piedlineaire
      		gstCurrentAchatSpacer.sEpaisseur = sdReqsql.epaisseur
      		gstCurrentAchatSpacer.nQte = sdreqsql.totqte
      		gtabAchatSpacer.Ajoute(gstCurrentAchatSpacer)
      	FIN
      	
      FIN
     type : 458752
