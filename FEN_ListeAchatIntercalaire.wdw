 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1+
      
      gtabAchatSpacer est un tableau de STAchatIntercalaire
      gstCurrentAchatSpacer est un STAchatIntercalaire
      
   -
     code : |1+
      
      csddatedebut = datesys()
      csddatefin = datesys()
     type : 34
   -
