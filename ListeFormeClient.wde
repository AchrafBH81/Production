 controls : []
 code_elements :
  type_code : 13
  p_codes :
   -
     code : |1-
      procedure listeforme(NoClient = "",_param2="",_param3="",_param4="")
      //cheminforme = ComplèteRep(fRepEnCours())+"formes\"
      //cheminforme = ComplèteRep(repdonnees)+"formes\"
      HLit(config,1)
      cheminforme = ComplèteRep(config.Dossierforme)
      
      compteur est un entier
      si pas listeprix.NouvelleListe alors
      	GrpDateRempl..visible = faux
      	Lvigueur..visible = faux
      	ldate..visible=vrai
      sinon
      	GrpDateRempl..visible = vrai
      
      FIN
      
      si pas gImprimeCondPMT alors
      	GrpCondPmt..visible=faux
      FIN
      listeprix.ListeImprimee = faux
      HLit(config,1)
      
      AssigneLibelle()
      iMessage=client.clangue = 1 ? config.textebaspageformelisteprix sinon config.TexteBasPageFormeListePrixAnglais
     type : 327680
   -
     code : |1+
      si noclient <> "" alors
      	si hlitrecherche(FormeClient,IdClientNoForme,HConstruitValClé(FormeClient,IdClientNoForme,sansespace(noclient)...
      		,sansespace(forme.fnumero))) alors
      		si pas FormeClient.fListePrix alors
      			renvoyer faux
      		sinon 
      			renvoyer vrai
      		FIN
      	sinon
      		renvoyer faux
      	FIN
      FIN
      
     type : 327696
   -
     code : |1+
      lNombreenrImprime = moimeme..NbEnrImprimé
      
     type : 327682
  procedures :
   -
     name : AssigneLibelle
     procedure_id : 5742479912017326912
     type_code : 14
     code : |1-
      Procédure AssigneLibelle()
      
      i est un entier
      
      lTableauLibelle est un tableau de 7 chaines
      lTableauLibelle[1]  = "lentete,lentete"
      lTableauLibelle[2]  = "lvigueur,lvigueur"
      lTableauLibelle[3]  = "lremplace,lremplace"
      lTableauLibelle[4]  = "lcondpaiement,LCondpaiement"
      lTableauLibelle[5]  = "lformes,lforme"
      lTableauLibelle[6]  = "lextradouble,lextradouble"
      lTableauLibelle[7]  = "lextratriple,lextratriple"
      
      selon client.CLangue
      	cas 1
      		pour i = 1 a 7
      			si hlitrecherche(Traduction,TRecherche,extraitchaine(lTableauLibelle[i],1,",")) alors
      				{"ListeFormeClient."+ExtraitChaîne(lTableauLibelle[i],2,",")} = traduction.dFrancais
      			fin
      		FIN
      	cas 2
      		pour i = 1 a 7
      			si hlitrecherche(Traduction,TRecherche,extraitchaine(lTableauLibelle[i],1,",")) alors
      				{"ListeFormeClient."+ExtraitChaîne(lTableauLibelle[i],2,",")} = traduction.danglais
      			fin
      		FIN
      fin
     type : 458752
  procedure_templates : []
  property_templates : []
