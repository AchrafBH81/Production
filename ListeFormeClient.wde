    properties :
     y : 69.001
     width : 195.9
     height : 23.447
    code_elements :
     type_code : 30
     p_codes :
      -
        code : |1+
         si noclient <> "" ALORS
         	si hlitrecherche(FormeClient,IdClientNoForme,HConstruitValClé(FormeClient,IdClientNoForme,sansespace(noclient),forme.fnumero)) alors
         		si formeclient.fPrixSpecial alors
         			RExtraDouble = FormeClient.fPrixdouble
         			RExtraTriple = FormeClient.FpRixtriple
         		fin
         	FIN
         FIN
         
        type : 327692
      -
        code : |1-
         
         si listeprix.nouvelleliste   alors
         	ListeHistoDetail.IDListeHisto = ListeHisto.IDListeHisto
         	ListeHistoDetail.iDescription = RUBRIQUE3
         	ListeHistoDetail.INoProduit = rubrique2
         	ListeHistoDetail.iPrixa = RExtraDouble
         	ListeHistoDetail.iPrixm = RExtraTriple
         	ListeHistoDetail.ITypeProduit = 6
         	hajoute(ListeHistoDetail)
         FIN
        type : 327693
      -
        type : 327697
        enabled : false
