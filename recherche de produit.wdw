 message_bar :
  internal_properties : CQAAAAkAAACA8IZVlSpYOdJL593hB4sdCo6qo07Ob2OhmvDRoX/QdJdgE7BnzyHb2EZM/hGCiRxEz0Em1PWBrrFeKWZkJpMnvlgjF5eaeSE7KtHV8ZOuVZRBE9lOtNzxyLvcxw==
 actionbar : {}
 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1+
      
      fonction vision(SaisieOK=0,type="",NumProduit = "")
      // L'appel à cette fenêtre est du type:
      //       OUVRE(nom_fen,SaisieOK)
      //		 si SaisieOK alors 		// Un enregistrement a été sélectionné
      // Vous pouvez aussi utiliser la syntaxe d'appel suivante:
      //       SI OUVRE(nom_fen) alors		// Un enregistrement a été sélectionné
      
      
      // Pour compatibilité 5.5
      MoiMême..Visible=Vrai
      Global
          resultat est une chaine
      	NomFic		est une chaine		// Nom du fichier associé à la fenêtre
      //	CleParcours	est une chaine		// Nom de la clé de parcours
          pos est un entier 
       NomFic="invent"						// Fichier principal de la fenêtre
       CleParcours="INUM"	// Détermine l'ordre de tri initial de la table
      
      // Affiche dans la table, depuis le début du fichier, avec ascenseur variable.
      // Pas de filtre sur le fichier, le total des enregistrements peut-être visualisé.
      pos = hsauveposition("invent")
      
      selon type
      
      cas "base"  
          //info("salut")
      		Requête_rechercheproduit.pIactif =1
      		Requête_rechercheproduit.pIbase =1
      		Requête_rechercheproduit.pItype = null
      		
      //	hfiltre("invent","inum","","zzzzzzzzzz","ibase=1 et iactif=1")
      cas "extra"
      		Requête_rechercheproduit.pIactif =1
      		Requête_rechercheproduit.pIbase =0
      		Requête_rechercheproduit.pItype = 1
      //		hfiltre("invent","inum","","zzzzzzzzzz","ibase=0 et itype = 1 et iactif = 1")
      cas "baseextra"
      		Requête_rechercheproduit.pIactif =1
      		Requête_rechercheproduit.pIbase = null
      		Requête_rechercheproduit.pItype = 1
      		
      //	hfiltre("invent","inum","","zzzzzzzzzz","( ibase=0 ou ibase = 1 ) et itype = 1 et iactif = 1")
      cas "verre"
      		Requête_rechercheproduit.pIactif =1
      		Requête_rechercheproduit.pIbase = null
      		Requête_rechercheproduit.pItype = 1
      		
      //	hfiltre("invent","inum","","zzzzzzzzzz","itype = 1 et iactif = 1")
      cas "carrelage"
      		Requête_rechercheproduit.pIactif =1
      		Requête_rechercheproduit.pIbase = null
      		Requête_rechercheproduit.pItype = 4
      		
      //	hfiltre("invent","inum","","zzzzzzzzzz","itype = 4 et iactif = 1")
      cas "pas verre"
      		Requête_rechercheproduit.pIactif =1
      		Requête_rechercheproduit.pIbase =null
      		Requête_rechercheproduit.pItype = 1
      		
      //	hfiltre("invent","inum","","zzzzzzzzzz","itype <> 1 et iactif = 1")
      cas "fourniture"
      		Requête_rechercheproduit.pIactif =1
      		Requête_rechercheproduit.pIbase =null
      		Requête_rechercheproduit.pItype = 3
      		
      //	hfiltre("invent","inum","","zzzzzzzzzz","itype = 3 et iactif = 1")
      
      		
      autres cas
      		Requête_rechercheproduit.pIactif =1
      		Requête_rechercheproduit.pIbase =null
      		Requête_rechercheproduit.pItype = Null
      //		hfiltre("invent","inum","","zzzzzzzzzz","iactif = 1")
      
      FIN
      
      hexecuterequete(Requête_rechercheproduit)
      tableaffiche(TABLE)
      //si numproduit <> "" alors
      //	res est un entier = tablecherche("inum",NumProduit)
      //	si res <> -1 alors tableselectplus(TABLE,res)
      //	
      //FIN
      //TableMode("Table","NbEnreg")
      
      //EcranPremier("Table")	// Se place sur la table
      
   -
     type : 180
     enabled : false
   -
     type : 230
     enabled : false
   -
     code : |1+
      
      hdesactivefiltre(nomfic)
      
      //Renvoyer SaisieOK
      
      Renvoyer resultat
      
     type : 2
   -
     type : 11
   -
     type : 12
   -
     type : 17
   -
     type : 13
