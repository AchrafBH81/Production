    identifier : 0x3e9d90fe26616c68
    internal_properties : CQAAAAkAAABl4X0AJzWn1ipK1YCKt9kgx+hbxLfGGC4fhSph4Srb58yjhP1pK5wlDCixc4FITdo+6tBTsqYwYfhVv8zE/KU1IumV8TRIOvHVWCQcyBnFYf8Xo7r4zOpIWk5xdx4FHLp9pSbAOoPDC2FmpS1Z0WfTioRdss9OOk8jQKgjqmqyh6MDvmEn76U1xReOqGyeiVGpXP/OqpRjhFufNuxdc/iFpqCBBqlYYjTor4WzYD6CSGdOWOM+xFi9VxoOtCF7vbAlamAvnp4iLi9CDq7GwQ==
    properties :
     y : 19.97
     width : 190.
     height : 1.
    code_elements :
     type_code : 30
     p_codes :
      -
        code : |1+
         selon tempo.tdoubletriple
         
         cas "Double"
         	total1 += tempo.tqte * tempo.tqtebase / 2
         cas "Triple"
         	total1 += tempo.tqte * tempo.tqtebase / 3
         autres cas 
         	total1+= tempo.tqte * tempo.tqtebase 
         FIN
         
         si tempo.tcomm <> commandeprecedente ou tempo.tlignedecommande <> ligneprecedente alors
         	totalpied += val(tempo.thauteur)/1000 * val(tempo.tlargeur)/1000 * config.conversionam
         	commandeprecedente = tempo.tcomm
         	ligneprecedente    = tempo.tlignedecommande
         FIN
         
        type : 327693
      -
        type : 327697
        enabled : false
