     y : 143
     width : 167
     height : 21
    options :
     -
       internal_properties : CQAAAAkAAADV4mMc24EvafnMH9AIRVfL8o/v2VsIiq1g2UCwOEfjxhb4+KvI7uYDXrxfZofrXzifb94xCftIVr17+Y5VZZdt5wZZARfuin29eYSAcntElKrZvKjlGOSV1WKguJ3AdFWl4DNbwtVdksiiFWn3lXsoOheItNrQp8VODO2KQYPk44gLqE7q
    type : 5
    controls : []
    code_elements :
     type_code : 5
     p_codes :
      -
        code : |1+
         si moimeme alors
         //Code WinDev 5.5 remplacé par la migration :
         //	 pourvunite..etat = actif
         	 pourvunite..etat = actif; pourvunite..Visible=Vrai
         ////Code WinDev 5.5 remplacé par la migration :
         ////	 datevunite..etat = actif
         //	 datevunite..etat = actif; datevunite..Visible=Vrai
         ////Code WinDev 5.5 remplacé par la migration :
         ////     filtreverreunite..etat = actif
         //     filtreverreunite..etat = actif; filtreverreunite..Visible=Vrai
         sinon
         //Code WinDev 5.5 remplacé par la migration :
         //	 pourvunite..etat = grisé
         	 pourvunite..etat = grisé; pourvunite..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
