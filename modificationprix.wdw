  -
    name : BTN_OK
    identifier : 0x3e9d90d1636abb97
    internal_properties : 
    properties :
     x : 380
     y : 115
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         modificationprix..etat = grise
         
         hlitpremier("invent","INUM")
         //Code WinDev 5.5 remplacé par la migration :
         //tantque pas h.endehors
         produitEnCours..visible = vrai
         
         tantque pas HEnDehors()
         	produitencours = invent.inum
         	multitacherepeint(modificationprix)
         	selon invent.itype
         
         
         
         		// Verre produit de base et additionnel
         
         		cas 1 
         		cas 2 
         			selon invent.iunitetype
         				// verre a l'unite
         				cas 2   
         					si invent.iactif alors
         						si modificationprix.casevunite alors
         							produitEnCours = invent.inum
         							multitache(1)
         							invent.iprixfuturunite = arrondi(invent.iprixunitaire  * (1 + ( modificationprix.pourvunite /100)),2)
         							invent.iprixfuturunitem = invent.iprixfuturunite  * tauxconversionam
         						fin
         					fin
         
         				cas 3
         					si invent.iactif alors
         						si modificationprix.casepunite alors
         							si pas  invent.iprixuniterouleau = 0 alors
         								produitEnCours = invent.inum
         								multitache(1)
         								invent.iprixfuturuniterouleau = arrondi(invent.iprixuniterouleau  * (1 + ( modificationprix.pourpunite /100)),2)
         								invent.iprixfuturu = invent.iprixfuturuniterouleau  * invent.ipiedparboite / invent.iunitemultiplicateur
         								//	invent.idateprixfutur = modificationprix.datepunite
         							fin    
         						fin 	
         					fin
         				autres cas
         					si invent.iactif alors
         						si modificationprix.casepunite alors
         							produitEnCours = invent.inum
         							multitache(1)
         							invent.iprixfuturu = arrondi(invent.iprixunite  * (1 + ( modificationprix.pourpunite /100)),2)
         							//   invent.idateprixfutur = modificationprix.datepunite
         						fin
         					fin
         			FIN
         
         			// carrelage
         		cas 4   
         
         			si invent.iactif alors
         				si modificationprix.casecarr alors
         					produitEnCours = invent.inum
         					multitache(1)
         					invent.iprixfuturbasecarrelage =  arrondi(invent.iprixbasecarrelage  * (1 + ( modificationprix.pourcarr /100)),2)
         			fin	
         			si modificationprix.casecarrcarreau alors
         
         				produitEnCours = invent.inum
         				multitache(1)
         				invent.iprixfuturcarreau = 	 arrondi(invent.iprixcarreau  * (1 + ( modificationprix.pourcarrcarreau /100)),2)
         				//	invent.idateprixfutur = modificationprix.datecarr
         			fin	
         			si modificationprix.CasePeintureCarreau alors
         				produitEnCours = invent.inum
         				invent.iprixbasePeinturec =  arrondi(invent.iprixbasePeinturec  * (1 + ( modificationprix.POURPeinturecarreau /100)),2)
         				invent.iprixcarreauPeinture =  arrondi(invent.iprixcarreauPeinture  * (1 + ( modificationprix.POURPeinturecarreau /100)),2)
         			fin
         
         	fin
         
         	// peinture
         cas 5   
         
         	si invent.iactif alors
         		si modificationprix.CasePeinture alors
         			produitEnCours = invent.inum
         			multitache(1)
         			invent.iprixFuturPeinture =  arrondi(invent.iprixPeinture  * (1 + ( modificationprix.POURPeinture /100)),2)
         			selon invent.iUniteMesure
         				cas 1
         					invent.iprixfuturpeinturem = 0
         				cas 2,3
         					invent.iprixFuturPeinturem = invent.iprixFuturPeinture * tauxconversionamlineaire
         				cas 4
         					invent.iprixFuturPeinturem = invent.iprixFuturPeinture * tauxconversionam
         			FIN
         	fin	
         fin
         fin
         
         
         hmodifie("invent")
         hlitsuivant("invent","INUM")
         fin
         
         
         //hlitpremier(persoens,ennumero)
         //tantque pas hendehors(persoens)
         //	si persoens.enactif alors
         //		si modificationprix.casethermos alors
         //			si persoens.enactif alors
         //				produitEnCours = persoens.ennumero
         //				multitache(1)
         //				persoens.enprixfutura = arrondi(persoens.enprixa  * (1 + ( modificationprix.pourthermos /100)),2)
         //				persoens.enprixfuturm = arrondi(persoens.enprixfutura * tauxconversionam,2)
         //				hmodifie(persoens,hnumenrencours)
         //			fin
         //	fin
         //fin
         //hlitsuivant(persoens,ennumero)
         //FIN
         si casefabrep alors
         	RequeteThermosFabrication.Paramenfabrication = 1
         	RequeteThermosFabrication.ParamenVerreUnite = 0
         	HExécuteRequête(RequeteThermosFabrication,hModifieFichier)
         	pour tout RequeteThermosFabrication
         		RequeteThermosFabrication.enprixfutura = arrondi(RequeteThermosFabrication.enprixa  * (1 + ( modificationprix.pourextra /100)),2)
         		RequeteThermosFabrication.enprixfuturm = arrondi(RequeteThermosFabrication.enprixfutura * tauxconversionam,2)	
         		hmodifie(RequeteThermosFabrication,hNumEnrEnCours)
         	FIN
         FIN
         
         si CASEVERREUNITE alors
         	RequeteThermosFabrication.Paramenfabrication = 0
         	RequeteThermosFabrication.ParamenVerreUnite = 1
         	HExécuteRequête(RequeteThermosFabrication,hModifieFichier)
         	pour tout RequeteThermosFabrication
         		RequeteThermosFabrication.enprixfutura = arrondi(RequeteThermosFabrication.enprixa  * (1 + ( modificationprix.POURVERREUNITE /100)),2)
         		RequeteThermosFabrication.enprixfuturm = arrondi(RequeteThermosFabrication.enprixfutura * tauxconversionam,2)	
         		hmodifie(RequeteThermosFabrication,hNumEnrEnCours)
         	FIN
         FIN
         
         si modificationprix.CASEEXTRA alors
         	HExécuteRequête(RequeteProduitExtra,hModifieFichier)
         	pour tout RequeteProduitExtra
         		produitencours = RequeteProduitExtra.INUM
         		multitacherepeint(modificationprix)
         		si RequeteProduitExtra.ibase et CASEPBASE alors
         			RequeteProduitExtra.iprixfuturdouble = arrondi(RequeteProduitExtra.IPRIXDOUBLE * (1 + ( modificationprix.POURextra /100)),2) 
         			RequeteProduitExtra.iprixfuturtriple = arrondi(RequeteProduitExtra.IPRIXtriple * (1 + ( modificationprix.POURextra /100)),2) 
         			RequeteProduitExtra.iprixfuturdoublem = arrondi(RequeteProduitExtra.IPRIXDOUBLEm * (1 + ( modificationprix.POURextra /100)),2) 
         			RequeteProduitExtra.iprixfuturtriplem = arrondi(RequeteProduitExtra.IPRIXtriplem * (1 + ( modificationprix.POURextra /100)),2) 
         		sinon
         			RequeteProduitExtra.iprixfutur = arrondi(RequeteProduitExtra.iprixa * (1 + ( modificationprix.POURextra /100)),2) 
         			RequeteProduitExtra.iprixfuturm = arrondi(RequeteProduitExtra.IPRIxm * (1 + ( modificationprix.POURextra /100)),2) 
         
         	fin
         	hmodifie(RequeteProduitExtra,hNumEnrEnCours)
         fin
         
         FIN
         
         
         si modificationprix.CasePeinture alors
         	pour tout fcouleur
         		fcouleur.cExtracarreau=arrondi(FCouleur.cExtracarreau  * (1 + ( modificationprix.POURPeinture /100)),2)  
         		fcouleur.cExtraLineaire=arrondi(FCouleur.cExtraLineaire  * (1 + ( modificationprix.POURPeinture /100)),2)  
         		fcouleur.CExtraLineaireM=arrondi(FCouleur.CExtraLineaireM  * (1 + ( modificationprix.POURPeinture /100)),2)  
         		fcouleur.cextraUnite=arrondi(FCouleur.cextraUnite  * (1 + ( modificationprix.POURPeinture /100)),2)  
         		HModifie(fcouleur,hNumEnrEnCours)
         	FIN
         FIN
         
         si modificationprix.CaseFormes alors
         	pour tout forme
         		forme.extradouble = arrondi(forme.extradouble * (1 + (modificationprix.pourFormes / 100)),2)
         		forme.extratriple = arrondi(forme.extratriple * (1 + (modificationprix.pourFormes / 100)),2)
         		HModifie(forme,hNumEnrEnCours)
         
         	FIN
         FIN
         multitache(100)
         ferme(modificationprix)
        type : 18
      -
        type : 161
        enabled : false
