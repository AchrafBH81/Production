  procedures :
   -
     name : RemplirLignedetail
     procedure_id : 1632190355359867343
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //RemplirLignedetail (<ccommandeligne> est oCommandeEdiLigne)
      //
      // Paramètres :
      //	ccommandeligne (oCommandeEdiLigne) : <indiquez ici le rôle de ccommandeligne>
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE RemplirLignedetail(ccommandeligne est un oCommandeEdiLigne)
      reqtxt est une chaine
      
      
      
      Sai_NoLigne = ccommandeligne._noLigne
      sai_qte = ccommandeligne._Quantite
      sai_Largeur = ccommandeligne._largeur
      sai_hauteur = ccommandeligne._Hauteur
      sai_norefClient = ccommandeligne._RefClient
      sai_cap = ccommandeligne._Cap
      sai_gaz = ccommandeligne._Gaz
      sai_DoubleSeal = ccommandeligne._DoubleSeal
      sai_fini = ccommandeligne._fini
      sai_distance = ccommandeligne._DistanceSiContour
      sai_intercalaire = ccommandeligne._TypeIntercalaire
      sai_DescCarrelage = ccommandeligne._TypeCarrelage
      sai_Descverre = ccommandeligne._DescriptionVerre
      sai_TypeCarrelage = ccommandeligne._Type
      sai_nbCarreauLargeur = ccommandeligne._NbCarreauVertical
      sai_nbcarreauhauteur = ccommandeligne._NbCarreauHorizontal
      sai_Proportion = ccommandeligne._ProportionTete
      sai_Alignement = ccommandeligne._CommandeAlignement
      sai_DescCarrelage2 = ccommandeligne._TypeCarrelage2
      cmb_Verre = Minuscule(ccommandeligne._NbVerre) = "double" ? 1 sinon 2
      ListeSupprimeTout(cboverre)
      selon cmb_verre
      	cas 1
      		reqtxt = [
      		select * from persoens where encomposant3 = '' and encomposant2 <> '' and enfabrication = 0 and enverreunite = 0 and enactif = 1 order by endescription
      		] 
      		
      	cas 2
      		reqtxt = [
      		select * from persoens where encomposant3 <> '' and enfabrication = 0 and enverreunite = 0 and enactif = 1 order by endescription
      		]
      		
      	AUTRE CAS
      		
      FIN
      
      
      si HExécuteRequêteSQL(reqsql,hRequêteDéfaut,reqtxt) alors
      	pour TOUT reqsql sur "ennumero"
      		listeajoute(cboVerre,gauche(reqsql.ennumero,10)+tab+reqsql.endescription)
      	fin
      	
      	//FichierVersListeMémoire(cboVerre,reqsql,"endescription","endescription","pecleunik")
      	
      sinon
      	
      FIN
      
      /////// Recherche si on a une relation pour ce client au niveau du verre.
      
      si hlitrecherche(fEdiRelation,NOMCLIENTTYpeRelation,HConstruitValClé(fEdiRelation,NOMCLIENTTYpeRelation,saiNomClient, "Verre")) alors
      	
      FIN
      
      /////// Recherche si on a une relation pour ce client au niveau du Carrelage.
      
      SI HLitRecherche(fEdiRelation,NOMCLIENTTYpeRelation,HConstruitValClé(fEdiRelation,NOMCLIENTTYpeRelation,saiNomClient, "Carrelage")) ALORS
      	
      FIN
      
      /////// Recherche si on a une relation pour ce client au niveau du Intercalaire.
      
      SI HLitRecherche(fEdiRelation,NOMCLIENTTYpeRelation,HConstruitValClé(fEdiRelation,NOMCLIENTTYpeRelation,saiNomClient, "Intercalaire")) ALORS
      	
      FIN
      
      /////// Recherche si on a une relation pour ce client au niveau du Fini.
      
      SI HLitRecherche(fEdiRelation,NOMCLIENTTYpeRelation,HConstruitValClé(fEdiRelation,NOMCLIENTTYpeRelation,saiNomClient, "Fini")) ALORS
      	
      FIN
     type : 458752
   -
     name : savecommandeedi
     procedure_id : 1643735772973258724
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //savecommandeedi (<ccommandeedi> est oCommandeEdi)
      //
      // Paramètres :
      //	ccommandeedi (oCommandeEdi) : <indiquez ici le rôle de ccommandeedi>
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE savecommandeedi(ccommandeedi est un oCommandeEdi)
      
      hraz(FactureInternet)
      FactureInternet.fiAcheteur = ccommandeedi._Acheteur
      FactureInternet.fiClient = ccommandeedi._Client
      FactureInternet.fiDateCommande = ccommandeedi._DateCommande
      FactureInternet.fiDateRequise = ccommandeedi._DateRequise
      FactureInternet.FiNoPorte = ccommandeedi._NoPorte
      FactureInternet.FiNumeroCommande = ccommandeedi._NoCommande
      FactureInternet.fiTelAchat = ccommandeedi._Telephoneachat
      FactureInternet.fiTelLivraison = ccommandeedi._Telephonelivraison
      hajoute(FactureInternet)
      
      pour tout ocommandeligne de ccommandeedi.tabLigneCommande
      	hraz(FdetailInternet)
      	FdetailInternet.noLigne = ocommandeligne._noLigne
      	FdetailInternet.QUANTITE = ocommandeligne._Quantite
      	FdetailInternet.LARGEUR = ocommandeligne._largeur
      	FdetailInternet.HAUTEUR = ocommandeligne._Hauteur
      	FdetailInternet.NbVerre = ocommandeligne._NbVerre
      	FdetailInternet.TYpeVerre1 = ocommandeligne._TypeVerre1
      	FdetailInternet.TYpeVerre2 = ocommandeligne._TypeVerre2
      	FdetailInternet.TYpeVerre3 = ocommandeligne._TypeVerre3
      	FdetailInternet.descriptionVerre = ocommandeligne._DescriptionVerre
      	FdetailInternet.TYpeIntercalaire = ocommandeligne._TypeIntercalaire
      	FdetailInternet.fini = ocommandeligne._fini
      	FdetailInternet.Intercalaire1 = ocommandeligne._Intercalaire1
      	FdetailInternet.Intercalaire2 = ocommandeligne._Intercalaire2
      	FdetailInternet.cap = ocommandeligne._Cap
      	FdetailInternet.gaz = ocommandeligne._Gaz
      	FdetailInternet.réfClient = ocommandeligne._RefClient
      	FdetailInternet.tYpecarrelage = ocommandeligne._TypeCarrelage
      	FdetailInternet.NbCarreauHorizontal = ocommandeligne._NbCarreauHorizontal
      	FdetailInternet.NbCarreauVertical = ocommandeligne._NbCarreauVertical
      	FdetailInternet.DoubleSeal = ocommandeligne._DoubleSeal
      	FdetailInternet.ProportionTete = ocommandeligne._ProportionTete
      	FdetailInternet.type = ocommandeligne._Type
      	FdetailInternet.dImensionSiContour = ocommandeligne._DistanceSiContour
      	FdetailInternet.COmmandeAlignement = ocommandeligne._CommandeAlignement
      	FdetailInternet.ligneAlignement = ocommandeligne._LigneAlignement
      	FdetailInternet.typeAlignement = ocommandeligne._TypeAlignement
      	fdetailinternet.UniteMesure = ocommandeligne._UniteDeMesure = "IN" ? 2 sinon 1
      	hajoute(FdetailInternet)
      	
      	
      	
      	
      	
      	
      	
      	
      	
      	
      	
      	
      FIN
      
      
      
      
      
