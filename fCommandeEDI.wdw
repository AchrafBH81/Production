 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1+
      ccommandeedi est un oCommandeEdi = new oCommandeEdi()
      reqsql est un source de donnees
      gLienActive(cboCarrelage,vrai)
      TypeParametre est un tableau de 5 chaines = ["Verre","Intercalaire","Carrelage","Fini","Client"]
      tabListeFichier est un tableau de chaines 
      fid est un entier
      cListe est une chaine
      
      
   -
     code : |1+
      
      
      //fid est un entier = fouvre(fSélecteur("g:\edi", "", "Sélectionnez un fichier...", "Tous les fichiers (*.*)" + TAB + "*.*", "*.*"),foLecture)
      //ccommandeedi = GetCommandeEdi(fid)
      //SourceVersEcran()
      //tableaffiche(Table_tabLigneCommande)
      POUR TOUT invent AVEC "itype = 4" sur inum
      	ListeAjoute(cboCarrelage,gLien(invent.INUM)+invent.inum+tab+invent.IDESC)
      	
      FIN
      ListeSupprimeTout(cboTypeCalcul)
      HLitPremier(typecarr,tcdescription)
      TANTQUE PAS HEnDehors(typecarr)
      		ListeAjoute(cboTypeCalcul,typecarr.tcdescription)
      
      	HLitSuivant(typecarr)
      FIN
      
