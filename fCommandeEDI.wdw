      -
        code : |1+
         cListe =  fListeFichier("g:\edi\*.dat",frNonRécursif)
         
         POUR TOUTE CHAINE UnFichier DE cliste SEPAREE PAR RC
         	// Ajout du fichier dans la table TableFic
         	fid = fOuvre(UnFichier,foLecture)
         	ccommandeedi = GetCommandeEdiFromDatFile(fid)
         	savecommandeedi(ccommandeedi)
         FIN
         tableaffiche(TableCommande,taInit)
         ExécuteTraitement(TableCommande,trtSélection)
