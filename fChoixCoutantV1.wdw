     p_codes :
      -
        code : |1-
         
         selon moimeme
         	cas 1 
         		selectlot..etat = actif
         		selectdate..etat = grise
         		executetraitement(selectlot,trtModification)
         
         	cas 2
         		selectdate..etat = actif
         		selectlot..etat = grise
         		executetraitement(selectdate,trtModification)
         
         FIN
        type : 17
  -
    name : BTN_DETRUIRE
    identifier : 0x466e8dfc12c2f8f2
    internal_properties : 
    properties :
     x : 59
     y : 6
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         si csnlotdebut <> 0 alors
         	si acso_message("Question","Vous êtes sur le point de supprimer le lot # "+csnLotdebut+rc+"Voulez-vous continuer ?","OuiNon") = idyes alors
         		pour tout fcoutant avec "nolot = "+csnlotdebut
         			HSupprime(Fcoutant,hnumenrencours)
         
         		fin
         		pour tout FcoutantLigne avec "nolot = "+csnlotdebut
         			HSupprime(Fcoutantligne,hnumenrencours)
         		fin
         	FIN
         ACSO_message("Information","Le lot "+ csnlotdebut +" à été supprimé")
         csnLotdebut = 0
         FIN
        type : 18
      -
        type : 161
        enabled : false
