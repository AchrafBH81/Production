  -
    name : BtnOk
    identifier : 0x46423b0e131c8a6e
    internal_properties : 
    properties :
     x : 360
     y : 98
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         ldateDebut est une chaine
         ldatefin est une chaine
         lNoClient est une chaine
         lNoLotDebut est une chaine
         lNoLotfin est une chaine
         
         
         si DESTINATION = 2 alors
         	iapercu()
         FIN
         
         selon SélectLotdate
         	// Par date
         
         	cas 2	
         		selon SELECTCLIENT
         
         			// Tous les clients
         
         			cas 1 
         				// 1 = toutes les dates
         				// sinon intervalle
         				RequeteCoutantCommandeArchiveV2.pNoLotDebut = null
         				RequeteCoutantCommandeArchiveV2.pNoLotfin = null
         				RequeteCoutantCommandeArchiveV2.pLotnul = null
         
         				si SELECTDate = 1 alors
         					RequeteCoutantCommandeArchivev2.pdateFactureDebut = null
         					RequeteCoutantCommandeArchivev2.pDatefacturefin = null
         					RequeteCoutantCommandeArchiveV2.pdateNulle = null
         
         				sinon
         					RequeteCoutantCommandeArchivev2.pDatefactureDebut = csddatedebut
         					RequeteCoutantCommandeArchivev2.pDatefacturefin = csddatefin
         					RequeteCoutantCommandeArchiveV2.pdateNulle = null
         					ldateDebut = csddatedebut
         					ldatefin = csddatefin
         				FIN
         
         				RequeteCoutantCommandeArchivev2.pNoClient = null
         
         
         				HExécuteRequête(RequeteCoutantCommandeArchivev2) 
         				si selectdate = 1 alors
         					hlitpremier(RequeteCoutantCommandeArchiveV2,cdatefacture)
         					ldateDebut = RequeteCoutantCommandeArchiveV2.cDAteFacture
         					hlitdernier(RequeteCoutantCommandeArchiveV2,cdatefacture)
         					ldatefin = RequeteCoutantCommandeArchiveV2.cDAteFacture
         
         				fin	
         
         				selon SELECTType
         					cas 1
         						iapercu()
         						iImprimeEtat(ECoutantCommandeSommaireArchivev1,ldateDebut,ldatefin,lNoClient)
         					cas 2
         						iapercu()
         						iImprimeEtat(ECoutantCommandedetailleeArchiveV1,ldateDebut,ldatefin,lNoClient)
         
         				fin	
         			cas 2
         				lNoClient = fChoixCoutantv1.cstNoClient
         				RequeteCoutantCommandeArchiveV2.pNoLotDebut = null
         				RequeteCoutantCommandeArchiveV2.pNoLotfin = null
         				RequeteCoutantCommandeArchiveV2.pLotnul = null
         				si SELECTDate = 1 alors
         					RequeteCoutantCommandeArchivev2.pDatefactureDebut = null
         					RequeteCoutantCommandeArchivev2.pDatefacturefin = null
         					RequeteCoutantCommandeArchiveV2.pdateNulle = ""
         
         					ldateDebut = "Début"
         					ldatefin = "Fin"
         
         				sinon
         					RequeteCoutantCommandeArchivev2.pDatefactureDebut = csddatedebut
         					RequeteCoutantCommandeArchivev2.pDatefacturefin = csddatefin
         					RequeteCoutantCommandeArchiveV2.pdateNulle = null
         					ldateDebut = csddatedebut
         					ldatefin = csddatefin
         				FIN
         				RequeteCoutantCommandeArchivev2.pNoClient = complete(cstNoClient,10)
         				HExécuteRequête(RequeteCoutantCommandeArchivev2) 
         
         				si selectdate = 1 alors
         					hlitpremier(RequeteCoutantCommandeArchiveV2,cdatefacture)
         					ldateDebut = RequeteCoutantCommandeArchiveV2.cdatefacture
         					hlitdernier(RequeteCoutantCommandeArchiveV2,cdatefacture)
         					ldatefin = RequeteCoutantCommandeArchiveV2.cdatefacture
         
         
         				fin	
         				selon SELECTType
         					cas 1
         						iImprimeEtat(ECoutantCommandeSommaireunClientv1,ldateDebut,ldatefin,lNoClient)
         					cas 2
         						iImprimeEtat(ECoutantCommandeDetailleeUnClientv1,ldateDebut,ldatefin,lNoClient)
         
         				fin	
         
         		FIN
         
         		// par Lot
         
         	cas 1
         		// Tous les clients
         
         
         		selon selectclient
         			cas 1 
         				// 1 = toutes les dates
         				// sinon intervalle
         				RequeteCoutantCommandeArchivev2.pdateFactureDebut = null
         				RequeteCoutantCommandeArchivev2.pDatefacturefin = null
         				RequeteCoutantCommandeArchiveV2.pdateNulle = null
         				RequeteCoutantCommandeArchivev2.pNoClient = null
         				selon SELECTlot
         					cas 1
         						RequeteCoutantCommandeArchiveV2.pNoLotDebut = null
         						RequeteCoutantCommandeArchiveV2.pNoLotfin = null
         						RequeteCoutantCommandeArchiveV2.pLotNul = 0
         					cas 2
         						RequeteCoutantCommandeArchiveV2.pNoLotDebut = csnLotdebut
         						RequeteCoutantCommandeArchiveV2.pNoLotfin = csnLotFin
         						lNoLotDebut = csnlotdebut
         						lNoLotfin = csnlotfin
         
         						RequeteCoutantCommandeArchiveV2.pLotNul = null
         				fin
         
         				HExécuteRequête(RequeteCoutantCommandeArchivev2) 
         				si selectlot = 1 alors
         					hlitpremier(RequeteCoutantCommandeArchiveV2,nolot)
         					lNoLotDebut = RequeteCoutantCommandeArchiveV2.nolot
         					hlitdernier(RequeteCoutantCommandeArchiveV2,nolot)
         					lNoLotfin = RequeteCoutantCommandeArchiveV2.nolot
         				fin	
         
         				selon SELECTType
         					cas 1
         						iapercu()
         						iImprimeEtat(ECoutantCommandeSommaireArchivev1,"","",lNoClient,lNoLotDebut,lNoLotfin)
         					cas 2
         						iapercu()
         						iImprimeEtat(ECoutantCommandedetailleeArchivev1,ldateDebut,ldatefin,lNoClient,lNoLotDebut,lNoLotfin)
         
         				fin	
         			cas 2
         				lNoClient = fChoixCoutantv1.cstNoClient
         				RequeteCoutantCommandeArchivev2.pdateFactureDebut = null
         				RequeteCoutantCommandeArchivev2.pDatefacturefin = null
         				RequeteCoutantCommandeArchiveV2.pdateNulle = null
         				RequeteCoutantCommandeArchivev2.pNoClient = complete(cstNoClient,10)
         				selon SELECTlot
         					cas 1
         						RequeteCoutantCommandeArchiveV2.pNoLotDebut = null
         						RequeteCoutantCommandeArchiveV2.pNoLotfin = null
         						RequeteCoutantCommandeArchiveV2.pLotNul = 0
         					cas 2
         						RequeteCoutantCommandeArchiveV2.pNoLotDebut = csnLotdebut
         						RequeteCoutantCommandeArchiveV2.pNoLotfin = csnLotFin
         						lNoLotDebut = csnlotdebut
         						lNoLotfin = csnlotfin
         
         						RequeteCoutantCommandeArchiveV2.pLotNul = null
         				fin
         
         				HExécuteRequête(RequeteCoutantCommandeArchivev2) 
         				si selectlot = 1 alors
         					hlitpremier(RequeteCoutantCommandeArchiveV2,nolot)
         					lNoLotDebut = RequeteCoutantCommandeArchiveV2.nolot
         					hlitdernier(RequeteCoutantCommandeArchiveV2,nolot)
         					lNoLotfin = RequeteCoutantCommandeArchiveV2.nolot
         				fin	
         
         				selon SELECTType
         					cas 1
         						iImprimeEtat(ECoutantCommandeSommaireunClientv1,ldateDebut,ldatefin,lNoClient,lNoLotDebut,lNoLotfin)
         					cas 2
         						iImprimeEtat(ECoutantCommandeDetailleeUnClientv1,ldateDebut,ldatefin,lNoClient,lNoLotDebut,lNoLotfin)
         
         				fin	
         
         		FIN
         
         
         fin
        type : 18
      -
        type : 161
        enabled : false
