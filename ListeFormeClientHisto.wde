 controls : []
 code_elements :
  type_code : 13
  p_codes :
   -
     code : |1+
      procedure ListeFormeClientHisto(NoClient = "")
      //cheminforme = ComplèteRep(fRepEnCours())+"formes\"
      hlit(config,1)
      cheminforme = ComplèteRep(config.dossierforme)
      
      
      si pas gImprimeCondPMT alors
      	GrpCondPmt..visible=faux
      FIN
      
      AssigneLibelle()
     type : 327680
   -
     code : |1-
      
     type : 327696
   -
     code : |1+
      lNombreenrImprime = moimeme..NbEnrImprimé
      
     type : 327682
  procedures :
   -
     name : AssigneLibelle
     procedure_id : 5742493253169468659
     type_code : 14
     code : |1+
      Procédure AssigneLibelle()
      i est un entier
      
      lTableauLibelle est un tableau de 7 chaines
      lTableauLibelle[1]  = "lentete,lentete"
      lTableauLibelle[2]  = "lvigueur,lvigueur"
      lTableauLibelle[3]  = "lremplace,lremplace"
      lTableauLibelle[4]  = "lcondpaiement,LCondpaiement"
      lTableauLibelle[5]  = "lformes,lforme"
      lTableauLibelle[6]  = "lextradouble,lextradouble"
      lTableauLibelle[7]  = "lextratriple,lextratriple"
      
      selon client.CLangue
      	cas 1
      		pour i = 1 a 7
      			si hlitrecherche(Traduction,TRecherche,extraitchaine(lTableauLibelle[i],1,",")) alors
      				{"ListeFormeClientHisto."+ExtraitChaîne(lTableauLibelle[i],2,",")} = traduction.dFrancais
      			fin
      		FIN
      	cas 2
      		pour i = 1 a 7
      			si hlitrecherche(Traduction,TRecherche,extraitchaine(lTableauLibelle[i],1,",")) alors
      				{"ListeFormeClientHisto."+ExtraitChaîne(lTableauLibelle[i],2,",")} = traduction.danglais
      			fin
      		FIN
      fin
     type : 458752
  procedure_templates : []
  property_templates : []
