 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1+
      PROCEDURE MaFenêtre()
      
      CompileOrders est un structure
      	sUser est une chaine
      	xtotalEdi est un monetaire
      	nNumberOrdersEDI est un entier
      	nNumberOfLinesEDI est un entier
      	nNumberOfThermosEDI est un entier
      	xtotal est un monetaire
      	nNumberOrders est un entier
      	nNumberOfLines est un entier
      	nNumberOfThermos est un entier
      	xtotalQuotation est un monetaire
      	nNumberOrdersQuotation est un entier
      	nNumberOfLinesQuotation est un entier
      	nNumberOfThermosQuotation est un entier
      	
      	
      	
      	
      fin
      reqsql est une source de donnees
      orderTracking est un tableau associatif de CompileOrders
      CurrentOrderTracking est un CompileOrders
   -
     code : |1+
      //txtreq est une chaine = [
      //select distinct TRIM(Computername) as scomputername from tracking order by TRIM(computername)
      //]
      txtreq est une chaine = [
      	select distinct TRIM(nomusager) as username,trim(usager.Prenom)+' '+trim(usager.nom) as sUserCompletedname  from usager 
      	where isactive = 1 order by TRIM(sUserCompletedname)
      ]
      
      si pas hexecuterequetesql(Reqsql,hRequêteDéfaut,txtreq) alors
      	info(herreurinfo())
      FIN
      Listeajoute(ComboUser,GLIEN("<TOUS>")+"<TOUS>")
      pour TOUT reqsql 
      	listeajoute(ComboUser,glien(reqsql.username)+reqsql.susercompletedname)
      FIN
      
      //FichierVersListeMémoire(ComboUser,reqsql,"sComputername")
      listeselectplus(ComboUser,1)
      SI SansEspace(config.cMotDePasseSpecial) = "" ALORS
      	ACSO_message("Info","Le mot de passe pour accéder à l'option de récupération n'existe pas ","Info")
      	Ouvre(FAcces,"creation")
      FIN
      
      
      MoiMême..Plan = 1
      
     type : 34
