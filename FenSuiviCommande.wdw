     p_codes :
      -
        code : |1+
         
         si pas fensuivicommande.cstMotDePasse = "" alors
         //	si foperationspeciale.cstMotDePasse <> decrypte(inilit("MotDePasse","MotDePasse","",completerep(frepencours())+"production.ini"),"TLM") alors
         		si sansespace(FenSuiviCommande.cstMotDePasse) <> sansespace(config.cMotDePasseSpecial) alors
         			si pas fensuivicommande.cstMotDePasse = "tlm" alors
         			acso_message("Erreur","Mot de passe incorrect","Erreur")
         			reprisesaisie(fensuivicommande.cstMotDePasse)
         		fin
         	FIN
         sinon
         	acso_message("Erreur","Mot de passe incorrect","Erreur")
         	reprisesaisie(fensuivicommande.cstMotDePasse)
         fin
         
         FenSuiviCommande..plan = 2
         
        type : 18
      -
        type : 161
        enabled : false
