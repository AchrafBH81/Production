  -
    name : BtnRefresh
    identifier : 0x2f8b143a0b441182
    internal_properties : 
    properties :
     x : 793
     y : 33
     width : 80
     height : 80
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         orderTracking.SupprimeTout()
         
         //txtreq est une chaine = [
         //	select tracking.isedi,tracking.DocumentType,sum(tracking.amount) as Total,
         //	count(tracking.IDTracking) as NumberOfInvoice,sum(tracking.NumberOfThermos) as numberofthermos,
         //	sum(tracking.NumberOfLines) as numberofLines,trim(tracking.Computername) as scomputername
         //	from tracking 
         //	where tracking.InvoiceDate between '%1' and '%2' %3
         //	group by scomputername,isedi,documenttype
         //	order by scomputername
         //]
         txtreq est une chaine = [
         	select tracking.isedi,tracking.DocumentType,sum(tracking.amount) as Total,
         	count(tracking.IDTracking) as NumberOfInvoice,sum(tracking.NumberOfThermos) as numberofthermos,
         	sum(tracking.NumberOfLines) as numberofLines,
         	trim(Tracking.Username) as susername,
         	trim(usager.Prenom)+' '+trim(usager.nom) as sUserCompletedname
         	from tracking 
         	inner join usager on usager.NomUsager = tracking.Username
         	where tracking.InvoiceDate between '%1' and '%2' %3
         	group by isedi,documenttype,sUserCompletedname,susername
         	order by sUserCompletedname
         ]
         ReqSqlData est une source de donnees
         TexteRequete est un chaine
         si pas datevalide(fensuivicommande.SaiDateDebut) OR PAS DateValide(FenSuiviCommande.SaiDatefin) alors
         	erreur("Date incorrecte")
         	reprisesaisie(SaiDateDebut)
         FIN
         //SI ComboUser..ValeurAffichée = "<TOUS>" ALORS
         	SI ComboUser = "<TOUS>" ALORS
         		TexteRequete = ChaîneConstruit(txtreq,SaiDateDebut,SaiDateFin,"")
         sinon
         	TexteRequete = ChaîneConstruit(txtreq,SaiDateDebut,SaiDateFin," AND SUSERNAME ='" + ComboUser + "'")
         //	TexteRequete = ChaîneConstruit(txtreq,SaiDateDebut,SaiDateFin," AND SCOMPUTERNAME ='" + ComboUser..ValeurAffichée + "'")
         	
         FIN
         sablier(vrai)
         si hexecuterequetesql(ReqSqlData,hRequêteDéfaut,TexteRequete) alors
         	pour TOUT ReqSqlData 
         		si ordertracking[ReqSqlData.sUserCompletedname] = Null ALORS
         			CurrentOrderTracking = allouer un CompileOrders
         			selon ReqSqlData.DocumentType
         				CAS "F"
         					si ReqSqlData.isedi alors
         						CurrentOrderTracking.nNumberOfLinesEDI = ReqSqlData.Numberoflines
         						CurrentOrderTracking.nNumberOfThermosEDI = ReqSqlData.numberofthermos
         						CurrentOrderTracking.xtotalEdi = ReqSqlData.Total
         						CurrentOrderTracking.nNumberOrdersEDI = ReqSqlData.Numberofinvoice
         						
         					sinon
         						CurrentOrderTracking.nNumberOfLines = ReqSqlData.Numberoflines
         						CurrentOrderTracking.nNumberOfThermos = ReqSqlData.numberofthermos
         						CurrentOrderTracking.xtotal = ReqSqlData.Total
         						CurrentOrderTracking.nNumberOrders = ReqSqlData.Numberofinvoice	
         					FIN
         				CAS "S"
         					CurrentOrderTracking.nNumberOfLinesQuotation = ReqSqlData.Numberoflines
         					CurrentOrderTracking.nNumberOfThermosQuotation = ReqSqlData.numberofthermos
         					CurrentOrderTracking.xtotalQuotation = ReqSqlData.Total
         					CurrentOrderTracking.nNumberOrdersQuotation = ReqSqlData.Numberofinvoice	
         				AUTRE CAS
         					
         			FIN
         			orderTracking[ReqSqlData.sUserCompletedname] = CurrentOrderTracking
         		sinon
         			SELON ReqSqlData.DocumentType
         				CAS "F"
         					SI ReqSqlData.isedi ALORS
         						orderTracking[ReqSqlData.sUserCompletedname].nNumberOfLinesEDI = ReqSqlData.Numberoflines
         						orderTracking[ReqSqlData.sUserCompletedname].nNumberOfThermosEDI = ReqSqlData.numberofthermos
         						orderTracking[ReqSqlData.sUserCompletedname].xtotalEdi = ReqSqlData.Total
         						orderTracking[ReqSqlData.sUserCompletedname].nNumberOrdersEDI = ReqSqlData.Numberofinvoice
         						
         					SINON
         						orderTracking[ReqSqlData.sUserCompletedname].nNumberOfLines = ReqSqlData.Numberoflines
         						orderTracking[ReqSqlData.sUserCompletedname].nNumberOfThermos = ReqSqlData.numberofthermos
         						orderTracking[ReqSqlData.sUserCompletedname].xtotal = ReqSqlData.Total
         						orderTracking[ReqSqlData.sUserCompletedname].nNumberOrders = ReqSqlData.Numberofinvoice	
         					FIN
         				CAS "S"
         					
         					orderTracking[ReqSqlData.sUserCompletedname].nNumberOfLinesQuotation = ReqSqlData.Numberoflines
         					orderTracking[ReqSqlData.sUserCompletedname].nNumberOfThermosQuotation = ReqSqlData.numberofthermos
         					orderTracking[ReqSqlData.sUserCompletedname].xtotalQuotation = ReqSqlData.Total
         					orderTracking[ReqSqlData.sUserCompletedname].nNumberOrdersQuotation = ReqSqlData.Numberofinvoice	
         				AUTRE CAS
         					
         			FIN
         			
         			
         		fin
         		
         		
         	FIN
         sinon
         	erreur(herreurinfo(hErrComplet)	)
         FIN
         tablesupprimetout(Table1)
         pour chaque compileTracking,cle de ordertracking
         	tableajouteligne(Table1,cle,compileTracking.nNumberOrders,compileTracking.nNumberOfLines,compileTracking.nNumberOfThermos,compileTracking.xtotal,...
         	compileTracking.nNumberOrdersEDI,compileTracking.nNumberOfLinesEDI,compileTracking.nNumberOfThermosEDI,compileTracking.xtotalEdi,...
         	compileTracking.nNumberOrdersQuotation,compileTracking.nNumberOfLinesQuotation,compileTracking.nNumberOfThermosQuotation,compileTracking.xtotalQuotation)
         FIN
         sablier(faux)
        type : 18
      -
        type : 161
        enabled : false
