 popup_menus :
  -
    name : MenuDatePrédéfinie
    identifier : 0x2f8b134f08f67ec7
    internal_properties : 
    options :
     -
       name : MenuAujourdhui
       identifier : 0x2f8b134f08f77ec7
       internal_properties : 
       code_elements :
        type_code : 26
        p_codes :
         -
           code : |1-
            sSuperChamp est une chaîne
            dDate est une date = DateSys()
            
            // Récupérer le nom du super champ
            sSuperChamp = ExtraitChaîne(ChampContextuel(), 1, ".")
            
            {sSuperChamp+".SAI_DateDébut",indChamp} = dDate
            {sSuperChamp+".LIB_JOUR_DEB",indChamp} = EntierVersJourEnLettre(dDate)
            
            {sSuperChamp+".SAI_DateFin",indChamp} = dDate
            {sSuperChamp+".LIB_JOUR_FIN",indChamp} = EntierVersJourEnLettre(dDate)
            
            {sSuperChamp,indChamp}..valeur = dDate+TAB+dDate
           type : 32
     -
       name : MenuHier
       identifier : 0x2f8b134f08f87ec7
       internal_properties : 
       code_elements :
        type_code : 26
        p_codes :
         -
           code : |1-
            dDate 	est une date = DateSys()
            sSuperChamp est une chaîne
            
            // Récupérer le nom du super champ
            sSuperChamp = ExtraitChaîne(ChampContextuel(), 1, ".")
            
            // Récupérer le jour précédent
            dDate..jour--
            
            {sSuperChamp+".SAI_DateDébut",indChamp} = dDate
            {sSuperChamp+".LIB_JOUR_DEB",indChamp} = EntierVersJourEnLettre(dDate)
            
            {sSuperChamp+".SAI_DateFin",indChamp} = dDate
            {sSuperChamp+".LIB_JOUR_FIN",indChamp} = EntierVersJourEnLettre(dDate)
            
            {sSuperChamp,indChamp}..valeur = dDate+TAB+dDate
           type : 32
     -
       name : MenuSemaineCourante
       identifier : 0x2f8b134f08f97ec7
       internal_properties : 
       code_elements :
        type_code : 26
        p_codes :
         -
           code : |1-
            dDateDebut 	est une date = DateSys()
            dDateFin	est une date = DateSys()
            nNumJour 	est un entier
            sSuperChamp est une chaîne
            
            // Récupérer le nom du super champ
            sSuperChamp = ExtraitChaîne(ChampContextuel(), 1, ".")
            
            // Récupérer le numéro du jour de la semaine
            nNumJour = EntierVersJour(dDateDebut)
            
            // Semaine courante
            dDateDebut..jour -= (nNumJour-1)
            
            {sSuperChamp+".SAI_DateDébut",indChamp} = dDateDebut
            {sSuperChamp+".LIB_JOUR_DEB",indChamp} = EntierVersJourEnLettre(dDateDebut)
            
            dDateFin = dDateDebut
            dDateFin..Jour += 6
            
            {sSuperChamp+".SAI_DateFin",indChamp} = dDateFin
            {sSuperChamp+".LIB_JOUR_FIN",indChamp} = EntierVersJourEnLettre(dDateFin)
            
            {sSuperChamp,indChamp}..valeur = dDateDebut+TAB+dDateFin
           type : 32
     -
       name : MenuSemainePrécédente
       identifier : 0x2f8b134f08fa7ec7
       internal_properties : 
       code_elements :
        type_code : 26
        p_codes :
         -
           code : |1-
            dDateDebut 	est une date = DateSys()
            dDateFin	est une date = DateSys()
            sSuperChamp est une chaîne
            
            // Récupérer le nom du super champ
            sSuperChamp = ExtraitChaîne(ChampContextuel(), 1, ".")
            
            // Positionner le jour sur la semaine précédente
            dDateDebut..jour -= 6
            
            {sSuperChamp+".SAI_DateDébut",indChamp} = dDateDebut
            {sSuperChamp+".LIB_JOUR_DEB",indChamp} = EntierVersJourEnLettre(dDateDebut)
            
            {sSuperChamp+".SAI_DateFin",indChamp} = dDateFin
            {sSuperChamp+".LIB_JOUR_FIN",indChamp} = EntierVersJourEnLettre(dDateFin)
            
            {sSuperChamp,indChamp}..valeur = dDateDebut+TAB+dDateFin
           type : 32
     -
       name : Semaine_précédente
       identifier : 0x2f8b134f08fb7ec7
       internal_properties : 
       code_elements :
        type_code : 26
        p_codes :
         -
           code : |1-
            dDateDebut 	est une date = DateSys()
            dDateFin	est une date = DateSys()
            nNumJour 	est un entier
            sSuperChamp est une chaîne
            
            // Récupérer le nom du super champ
            sSuperChamp = ExtraitChaîne(ChampContextuel(), 1, ".")
            
            // Semaine précédente
            dDateDebut..jour -= 7
            nNumJour = EntierVersJour(dDateDebut)
            dDateDebut..jour -= (nNumJour-1)
            dDateFin = dDateDebut
            dDateFin += 6
            
            {sSuperChamp+".SAI_DateDébut",indChamp} = dDateDebut
            {sSuperChamp+".LIB_JOUR_DEB",indChamp} = EntierVersJourEnLettre(dDateDebut)
            
            {sSuperChamp+".SAI_DateFin",indChamp} = dDateFin
            {sSuperChamp+".LIB_JOUR_FIN",indChamp} = EntierVersJourEnLettre(dDateFin)
            
            {sSuperChamp,indChamp}..valeur = dDateDebut+TAB+dDateFin
           type : 32
     -
       name : MenuMoisCourant
       identifier : 0x2f8b134f08fc7ec7
       internal_properties : 
       code_elements :
        type_code : 26
        p_codes :
         -
           code : |1-
            dDateDebut 	est une date = DateSys()
            dDateFin	est une date = DateSys()
            sSuperChamp est une chaîne
            
            // Récupérer le nom du super champ
            sSuperChamp = ExtraitChaîne(ChampContextuel(), 1, ".")
            
            // Mois courant
            dDateDebut..jour = 1
            
            {sSuperChamp+".SAI_DateDébut",indChamp} = dDateDebut
            {sSuperChamp+".LIB_JOUR_DEB",indChamp} = EntierVersJourEnLettre(dDateDebut)
            
            {sSuperChamp+".SAI_DateFin",indChamp} = dDateFin
            {sSuperChamp+".LIB_JOUR_FIN",indChamp} = EntierVersJourEnLettre(dDateFin)
            
            {sSuperChamp,indChamp}..valeur = dDateDebut+TAB+dDateFin
           type : 32
     -
       name : MenuMoisFlottant
       identifier : 0x2f8b134f08fd7ec7
       internal_properties : 
       code_elements :
        type_code : 26
        p_codes :
         -
           code : |1-
            dDateDebut 	est une date = DateSys()
            dDateFin	est une date = DateSys()
            sSuperChamp est une chaîne
            
            // Récupérer le nom du super champ
            sSuperChamp = ExtraitChaîne(ChampContextuel(), 1, ".")
            
            // Mois flottant
            dDateDebut..mois--
            dDateDebut..jour++
            
            {sSuperChamp+".SAI_DateDébut",indChamp} = dDateDebut
            {sSuperChamp+".LIB_JOUR_DEB",indChamp} = EntierVersJourEnLettre(dDateDebut)
            
            {sSuperChamp+".SAI_DateFin",indChamp} = dDateFin
            {sSuperChamp+".LIB_JOUR_FIN",indChamp} = EntierVersJourEnLettre(dDateFin)
            
            {sSuperChamp,indChamp}..valeur = dDateDebut+TAB+dDateFin
           type : 32
     -
       name : MenuMoisPrécédent
       identifier : 0x2f8b134f08fe7ec7
       internal_properties : 
       code_elements :
        type_code : 26
        p_codes :
         -
           code : |1-
            dDateDebut 	est une date = DateSys()
            dDateFin	est une date = DateSys()
            sSuperChamp est une chaîne
            
            // Récupérer le nom du super champ
            sSuperChamp = ExtraitChaîne(ChampContextuel(), 1, ".")
            
            // Mois précédent
            dDateDebut..mois--
            dDateDebut..jour = 1
            dDateFin..mois--
            dDateFin..jour = 31
            
            {sSuperChamp+".SAI_DateDébut",indChamp} = dDateDebut
            {sSuperChamp+".LIB_JOUR_DEB",indChamp} = EntierVersJourEnLettre(dDateDebut)
            
            {sSuperChamp+".SAI_DateFin",indChamp} = dDateFin
            {sSuperChamp+".LIB_JOUR_FIN",indChamp} = EntierVersJourEnLettre(dDateFin)
            
            {sSuperChamp,indChamp}..valeur = dDateDebut+TAB+dDateFin
           type : 32
     -
       name : MenuAnnéeCourante
       identifier : 0x2f8b134f08ff7ec7
       internal_properties : 
       code_elements :
        type_code : 26
        p_codes :
         -
           code : |1-
            dDateDebut 	est une date = DateSys()
            dDateFin	est une date = DateSys()
            sSuperChamp est une chaîne
            
            // Récupérer le nom du super champ
            sSuperChamp = ExtraitChaîne(ChampContextuel(), 1, ".")
            
            // Année courante
            dDateDebut..jour = 1
            dDateDebut..mois = 1
            
            {sSuperChamp+".SAI_DateDébut",indChamp} = dDateDebut
            {sSuperChamp+".LIB_JOUR_DEB",indChamp} = EntierVersJourEnLettre(dDateDebut)
            
            {sSuperChamp+".SAI_DateFin",indChamp} = dDateFin
            {sSuperChamp+".LIB_JOUR_FIN",indChamp} = EntierVersJourEnLettre(dDateFin)
            
            {sSuperChamp,indChamp}..valeur = dDateDebut+TAB+dDateFin
