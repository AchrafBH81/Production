  -
    name : EXEC_CODE
    identifier : 0x3db6ac8e47c82009
    internal_properties : 
    properties :
     x : 360
     y : 68
     width : 106
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         NumFic est un entier
         NomFichier est une chaine
         UneLigne est une chaine
         source est une chaine
         resultat est une chaine
         
         sablier(vrai)
         
         NomFichier=sansespace(Frepencours())+"\Code_Ext\"+nom[tableselect("TABLE1")]
         
         // Ouverture du fichier et vérification du résultat
         NumFic=fOuvre(NomFichier,FOLecture+0)
         SI NumFic=-1 ALORS
         	Erreur(<§$0000§>+NomFichier)
         	RETOUR
         FIN
         
         // Lecture complète, ligne par ligne
         BOUCLE
         	UneLigne = fLitLigne(NumFic)
         	SI UneLigne = EOT ALORS 
         		SORTIR
         	FIN
         	source=source+UneLigne+rc
         FIN
         fFerme(NumFic)
         
         resultat=compile("locCode_Externe",source)
         si sansespace(resultat)="" alors
         	resultat=<§$0001§>
         FIN
         si ACSO_message("Question",resultat+rc+"Voulez-vous continuer ?","OuiNon") = idyes
         	ExécuteTraitement("locCode_Externe",trtProcédure)
         fin
         sablier(faux)
         
         info(<§$0003§>)
         
        type : 18
      -
        type : 161
        enabled : false
