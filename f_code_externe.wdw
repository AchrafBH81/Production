  -
    name : NOUVEAU
    identifier : 0x3db6ac8e5c3d1fd5
    internal_properties : 
    properties :
     x : 359
     y : 6
     width : 106
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         Numéro_Fichier est un entier
         nom_fichier1 est une chaine
         
         nom_fichier1=sansespace(Frepencours())+"\Code_Ext\Code_Ext.txt"
         
         // Créer fichier de paramètres
         Numéro_Fichier = fCrée(nom_fichier1)
         Si Numéro_Fichier = -1 alors 
         	ERREUR(<§$0005§>+nom_fichier1)
         sinon
         	fFerme(Numéro_Fichier)
         Fin
         
         //Code WinDev 5.5 remplacé par la migration :
         //DDELance("NOTEPAD.EXE "+nom_fichier1,ddeactif,vrai)
         LanceAppli("NOTEPAD.EXE "+nom_fichier1,ExeActif,vrai)
         init_table()
         
        type : 18
