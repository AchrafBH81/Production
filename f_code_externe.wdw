  procedures :
   -
     name : Init_Table
     procedure_id : 4446931409536884805
     type_code : 14
     code : |1+
      Procédure Init_Table()
      ch est une Chaîne
      NumFic est un entier
      NomFichier est une chaine
      nom_fichier1 est une chaine
      UneLigne est une chaine
      
      nom_fichier1=sansespace(Frepencours())+"\Code_Ext\*.txt"
      
      
      tablesupprimetout("TABLE1")
      
      ch = fRep(nom_fichier1,FRFichier)
      TantQue ch<>""
      	tableAjoute("TABLE1",ch)
         	ch = fRep("")
      Fin
      //Code WinDev 5.5 remplacé par la migration :
      //tabletri("nom")
      TableTrie("nom")
      
     type : 458752
