     code : |1-
      // Traitement automatique des exceptions :   exécuter le bloc de code CAS EXCEPTION:
      //
      procedure f_code_externe(execution=faux)
      local
      noficerr est un entier
      nomfic est une chaine
      
      // Pour compatibilité 5.5
      MoiMeme..Visible=Vrai
      
      fRepCree(sansespace(frepencours()+"\Code_Ext"))
      
      init_table()
      
      //QUAND EXCEPTION
      //	frepcree("Erreur")
      //	nomfic = frepencours()+"\Erreur\"+datesys()+"-"+heuresys()+".txt"
      //	noficerr=fcree(nomfic)
      //	si noficerr>-1 alors
      //		fEcrit(noficerr,ExceptionInfo(errComplet))
      //		fferme(noficerr)
      //	FIN
      //	LanceAppliAssociée(nomfic)
      //	//ExceptionActive()
      //fin
      
      
      CAS EXCEPTION:
      	info(ExceptionInfo(errMessage))
      	
   -
