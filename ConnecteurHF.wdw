         -
           internal_properties : CQAAAAkAAAAMKk0bUnppf9n/DdIx+pD12FdjGBpDdPouTXmKpwRX8VSK7s3EyvfwpbA1UoOIDFhQRWUvEtPmaHQL3DqP9EYkvNp92ZaY8pL88p/fEQhlXNEtBTP55g==
           code : |1-
            
            
            
            lConnexionhf..Serveur = nomserveur+":"+noport
            lconnexionhf..MotDePasse = pass
            lconnexionhf..provider = hAccèsHFClientServeur
            lConnexionhf..Utilisateur = nomusr
            lConnexionhf..BaseDeDonnées = cbobases..ValeurAffichée
            
            //HDécritConnexion("HF",nomUsr,pass,nomServeur+":"+noPort,motdepasse.cboBases..ValeurAffichée,hAccèsHFClientServeur)
            gsuser = sai_User
            gspassword = sai_passWord
            //si gsPassword = "" alors 
            //	erreur("Le mot de passe ne doit pas être vide !!!")
            //	reprisesaisie(gsPassword)
            //FIN
            //HClient.Machine = NetNomMachine("127.0.0.1")
            //hclient.Application = "Production.exe"
            //HDéconnecteClient(gConnexionHF,"fermeture",0)
            
            SI pas HOuvreConnexion(lconnexionhf) ALORS
               	valeuraretourner = 3 
            sinon
                si lConnexionhf..BaseDeDonnées = "" alors
            		valeuraretourner = 3 
                fin
                	
            FIN
            
            
            
            valeuraretourner = 1
            
            ferme
            
            
            
            CAS EXCEPTION:
            	info("Erreur de connexion"+exceptioninfo(hErrComplet))
            	
