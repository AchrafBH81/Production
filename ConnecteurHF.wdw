     -
       name : BtnConnecter
       identifier : 0x22daad799b04828d
       internal_properties : 
       properties :
        x : 311
        y : 195
        width : 113
        height : 36
       type : 4
       code_elements :
        type_code : 4
        p_codes :
         -
           code : |1+
            lConnexion..Provider		= hAccèsHFClientServeur
            lConnexion..Utilisateur		= nomUsr
            lConnexion..MotDePasse		= pass
            lConnexion..Serveur			= nomServeur + ":" + noPort
            lConnexion..BaseDeDonnées	= ""
            lConnexion..Cryptage		= hCryptageNon
            
            si HOuvreConnexion(lConnexion) alors
            	ListeSupprimeTout(cboBases)
            	res		est une chaine	= HListeBaseDeDonnées(lconnexion)
            	nomBd	est une chaine	= ExtraitChaîne(res,1,TAB)
            	ct		est une entier	= 1
            	TANTQUE nomBd <>"" ET nomBd <> EOT
            		ct++
            		ListeAjoute(cboBases,nomBd)
            		nomBd= ExtraitChaîne(res,ct,TAB)
            		
            	FIN
            	
            FIN
            HFermeConnexion(lConnexion)
            
            si enmodetest() alors
            	si nomServeur = "192.168.20.9" alors
            		gcnxConnexionHFExternal.Serveur					= nomServeur + ":" + noPort
            		gcnxConnexionHFExternal..Utilisateur			= "admin"
            		gcnxConnexionHFExternal..MotDePasse				= ""
            		gcnxConnexionHFExternal..BaseDeDonnées			= "ThermosrnWebTest"
            		gcnxConnexionHFExternal..Cryptage				= hCryptageNon
            		gcnxConnexionHFExternal..Provider				= hAccèsHFClientServeur
            		
            	sinon
            		
            		gcnxConnexionHFExternal.serveur					= "127.0.0.1"
            		gcnxConnexionHFExternal..Utilisateur			= "admin"
            		gcnxConnexionHFExternal..MotDePasse				= ""
            		gcnxConnexionHFExternal..BaseDeDonnées			= "ThermosrnWeb"
            		gcnxConnexionHFExternal..Cryptage				= hCryptageNon
            		gcnxConnexionHFExternal..Provider				= hAccèsHFClientServeur
            	FIN
            	
            sinon
            	SI nomServeur = "192.168.20.9" ALORS
            		gcnxConnexionHFExternal.Serveur					= "192.168.20.9:4900"
            		gcnxConnexionHFExternal..Utilisateur			= "admin"
            		gcnxConnexionHFExternal..MotDePasse				= ""
            		gcnxConnexionHFExternal..BaseDeDonnées			= "ThermosrnWebTest"
            		gcnxConnexionHFExternal..Cryptage				= hCryptageNon
            		gcnxConnexionHFExternal..Provider				= hAccèsHFClientServeur
            	sinon	
            		gcnxConnexionHFExternal.Serveur					= "192.168.20.9:4900"
            		gcnxConnexionHFExternal..Utilisateur			= "admin"
            		gcnxConnexionHFExternal..MotDePasse				= ""
            		gcnxConnexionHFExternal..BaseDeDonnées			= "ThermosrnWeb"
            		gcnxConnexionHFExternal..Cryptage				= hCryptageNon
            		gcnxConnexionHFExternal..Provider				= hAccèsHFClientServeur
            	Fin
            	
            FIN
            
            ////listeselectplus(cboBases,1)
            
            //SI HOuvreConnexion(gcnxConnexionHFExternal) ALORS
            //	HChangeConnexion(ExternalOrder,gcnxConnexionHFExternal)
            //	HChangeConnexion(ExternalOrderDetails,gcnxConnexionHFExternal)
            //	HChangeConnexion(WebConfig,gcnxConnexionHFExternal)
            //	
            //SINON
            //	Info(HErreurInfo(hErrComplet))
            //FIN
            
            
            
