 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1+
      //Description des paramètres d'entrée/sortie de 'motdepasse' :
      //
      //Syntaxe :
      //motdepasse ([<av_usager>[,<av_password>[,<av_compagnie>[,<av_souvenir>]]]])
      //
      //Paramètres :
      //	av_usager : <indiquez ici le rôle de av_usager>
      //	av_password : <indiquez ici le rôle de av_password>
      //	av_compagnie : <indiquez ici le rôle de av_compagnie>
      //	av_souvenir : <indiquez ici le rôle de av_souvenir>
      //Valeur de retour :
      //	Aucune
      //
      //Notes :
      //détaillez ici le fonctionnement
      //précisez les cas particuliers et les limites.
      //
      //Exemple :
      //indiquez ici un exemple d'utilisation.
      //
      //Aucune documentation n'a été saisie par le concepteur du composant ()
      procedure ConnecteurHF(lConnexionhf= "",aco_sortie = vrai)
      // Pour compatibilité 5.5
      
      MoiMême..Visible=Vrai
      moimeme..etat = actifdevant
      
      valeuraretourner est un entier = 2 
      
      
      
      
      lConnexion est une connexion
      
      
      
      nomini est une chaine
      
      
      
      nomini = ComplèteRep(frepencours())+"production.ini"
      
      nomServeur = INILit("Serveur","Nom","ServeurG6",nomini)
      noPort = Val(INILit("Serveur","Port","4900",nomini))
      nomUsr = INILit("Serveur","User","Admin",nomini)
      pass = INILit("Serveur","Pass","",nomini)
      
      lConnexion..Provider = hAccèsHFClientServeur
      lConnexion..Utilisateur = nomUsr
      lConnexion..MotDePasse = pass
      lConnexion..Serveur = nomServeur + ":" + noPort
      lConnexion..BaseDeDonnées = ""
      lConnexion..Cryptage = hCryptageNon
      
      
       
      //ecranpremier("MUSAGER")
      //disconnecte_login = vrai
      //motdepasse.musager = inilit("USAGER","USAGER","",repencours+"therma.INI")
      //motdepasse.souvenir = inilit("USAGER","SOUVENIR","",repencours+"therma.INI")
      //motdepasse.motdepasse = inilit("USAGER","MOTDEPASSE","",repencours+"therma.INI")
      ExécuteTraitement(BtnConnecter,trtClic)
      
   -
     code : |1-
      si pas aco_sortie alors
      	ConnecteurHF.BTN_SORTIE..visible = faux
      sinon
      	ConnecteurHF.BTN_SORTIE..visible = vrai
      
      FIN
      TiroirServeur = Faux
      
      
      
      
      
      
      //ExécuteTraitement(motdepasse.MUSAGER,trtClic)
     type : 34
   -
     type : 180
     enabled : false
   -
     type : 230
     enabled : false
   -
     code : |1+
      
      connecteurhf..valeurrenvoyée = valeuraretourner
      INIecrit("Serveur","Nom",nomserveur,nomini)
      INIEcrit("Serveur","Port",numeriqueverschaine(noport),nomini)
      INIecrit("Serveur","User",nomusr,nomini)
      INIecrit("Serveur","Pass",pass,nomini)
      
     type : 2
