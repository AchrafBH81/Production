    identifier : 0x2fdce07908f9e74c
    internal_properties : 
    properties :
     x : 919
     y : 627
     width : 80
     height : 80
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         supprimetempo()
         hlit(config,1)
         si IntCourriel alors
         	ladressecourriel est une chaine	
         	pour chaque ligne de TableCourriel
         		si TableCourriel.IntEnvoi alors
         			ladressecourriel += SansEspace(tablecourriel.AdresseCourriel)+";"
         		fin
         	fin
         	ouvre(FenEmail,ladressecourriel,config.SujetSpacer,config.TexteSpacer,completerep(CheminPdfDocument)+SaiNoLot+".pdf;","",Faux,9,vrai,"P")
         	
         FIN
         
         Ferme(MaFenêtre)	
         
         
         
         
