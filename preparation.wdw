     p_codes : []
  -
    name : BtnRefresh1
    identifier : 0x2fdbffc6e50c2ed8
    internal_properties : 
    properties :
     x : 871
     y : 126
     width : 80
     height : 80
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        internal_properties : CQAAAAkAAACiyCFtGEN9JwOhSk11QNgOOOvzgqpfoMp6CTVKhwhXZfD+7l30PptoCXTRBNUCtoZKT/c9zE1wYm41ZqQRbjgaDkQlOTocne+znVP2xnnwqZl13dVbRA==
        code : |1-
         si SaiNoLot = "" alors 
         	erreur("Inscrivez un numéro de lot")
         	reprisesaisie(SaiNoLot)
         FIN
         mafenetre..plan = pExecution
         bAbort est un booleen = faux
         
         
         chemintempo est une chaine = ".\"+NetAdresseIP()
         //chemintempo est une chaine = completerep(sysrep(srAppDataLocal))+"temp"
         
         SI CleUsb ALORS chemintempo = ComplèteRep(repencours)+"tempo\"
         
         
         SI TABLE1..Vide ALORS RENVOYER Vrai
         
         j est un entier
         hsupprimetout(tqteprep)
         //HCréation(TQtePrep)
         //HCréation(Fdetailtempo)
         hsupprimetout(Fdetailtempo)
         HAlias(Fdetailtempo,fdetailtempoc)
         HAlias(Fdetailtempo,fdetailtempoc1)
         HAlias(Fdetailtempo,fdetailtempoc2)
         HAlias(Fdetailtempo,fdetailtempo0)
         HAlias(Fdetailtempo,fdetailtempo1)
         HAlias(Fdetailtempo,fdetailtempo2)
         HAlias(Fdetailtempo,fdetailtempoF)
         
         
         
         
         
         HChangeRep(fdetailtempoc,chemintempo)
         HChangeRep(fdetailtempoc1,chemintempo)
         HChangeRep(fdetailtempoc2,chemintempo)
         HChangeRep(fdetailtempo0,chemintempo)
         HChangeRep(fdetailtempo1,chemintempo)
         HChangeRep(fdetailtempo2,chemintempo)
         HChangeRep(fdetailtempoF,chemintempo)
         
         HCréation(fdetailtempoc)
         HCréation(fdetailtempoc1)
         HCréation(fdetailtempoc2)
         HCréation(fdetailtempo0)
         HCréation(fdetailtempo1)
         HCréation(fdetailtempo2)
         HCréation(fdetailtempoF)
         
         
         gtabTransferReport.supprimetout()
         
         SI HNbEnr(infoprep) = 0 ALORS
         	HAjoute(infoprep)
         FIN
         HLitPremier(infoprep,"I1CLEUNIK",hBlocageEcriture)
         SI HErreurBlocage() ALORS
         	ACSO_message("Erreur","Impossible d'obtenir l'exclusivité sur le fichier de préparation"+rc+"Réessayez dans quelques instants","Erreur")
         	bAbort = vrai
         SINON
         	HBloqueFichier(tempo)
         	SI HErreurBlocage() ALORS
         		ACSO_message("Erreur","Impossible d'obtenir l'exclusivité sur le fichier temporaire nécessaire à la préparation"+RC+"Réessayez dans quelques instants","Erreur")
         		bAbort = Vrai
         	SINON
         		HLitPremier("config","COCLEUNIK",hBlocageEcriture)
         		SI HErreurBlocage() ALORS
         			ACSO_message("Erreur","Impossible d'obtenir l'exclusivité sur le fichier de configuration "+RC+"Réessayez dans quelques instants","Erreur")
         			bAbort = Vrai
         		SINON
         			prochainnumeroprep = config.numeropreparation
         			SI verifiesilotexiste(prochainnumeroprep) ALORS
         				SI ACSO_message("Message","Le lot "+prochainnumeroprep+ " existe déjà !"+RC+"Voulez-vous l'écraser ?","OuiNon") = IDYES ALORS
         					POUR TOUT ArchivePrep AVEC "tnolot = "+ prochainnumeroprep
         						HSupprime(ArchivePrep,hNumEnrEnCours)
         						
         					FIN
         				SINON
         					RENVOYER Vrai	
         				FIN
         			FIN
         			Lib_Preparation += " " + prochainnumeroprep
         			
         			config.numeropreparation = prochainnumeroprep + 1
         			HModifie(config,hNumEnrEnCours)
         			
         			
         			SI prep_tempo_trn_new_tri()   ALORS
         				infoprep.ipdate = SaiDate
         				POUR j = 1 À 25
         					infoprep.ipsecteur[j] = ""
         				FIN
         				
         				POUR j = 1 _À_ Dimension(listedesecteurprep)
         					//si sansespace(listedesecteur[j]) = "" alors sortir
         					infoprep.ipsecteur[j] = trouvesecteur(Complète(listedesecteurprep[j],2))
         				FIN
         				infoprep.IpCamion = Combo_Camions..ValeurAffichée
         				infoprep.ipCarrelage = IntOptions[1]
         				infoprep.ipForme = IntOptions[2]
         				infoprep.ipproduitSpeciaux = IntOptions[3]
         				lEpaisseur est une chaine = ""
         				POUR i = 1 a 4
         					lEpaisseur += IntEpaisseur[i] ? [","]+IntEpaisseur[i]..Libellé SINON ""  
         				FIN
         				infoprep.ipEpaisseur = lEpaisseur[[2 À ]]
         				
         				HModifie(infoprep,hNumEnrEnCours)
         				
         			FIN
         			SI HErreurBlocage() ALORS
         			FIN
         			BTN_CHOIX..Etat = Actif; BTN_CHOIX..Visible=Vrai
         			BTN_PREPARE..Etat = Grisé; BTN_PREPARE..Visible=Vrai
         		FIN
         	FIN
         FIN
         
         
         JaugePrep = 100
         //ouvre(afficheNbverre,ltableauNbVerre)
         HDébloqueFichier(tempo)
         //ebloquefichier("tempo99")
         HDébloqueFichier(config)
         HDébloqueFichier(infoprep)
         BTN_CHOIX..Etat = Actif; BTN_CHOIX..Visible=Vrai
         HFerme(fdetailtempoc)
         HFerme(fdetailtempoc1)
         HFerme(fdetailtempoc2)
         HFerme(fdetailtempo0)
         HFerme(fdetailtempo1)
         HFerme(fdetailtempo2)
         HFerme(fdetailtempoF)
         hferme(tqteprep)
         HAnnuleAlias(fdetailtempoc)
         HAnnuleAlias(fdetailtempoc1)
         HAnnuleAlias(fdetailtempoc2)
         HAnnuleAlias(fdetailtempo0)
         HAnnuleAlias(fdetailtempo1)
         HAnnuleAlias(fdetailtempo2)
         HAnnuleAlias(fdetailtempoF)
         
         SI bAbort ALORS 
         	MaFenêtre..Plan = pPreparation
         	RENVOYER Vrai
         FIN
         remplir_table_separe()
         
         HLitPremier(Tempo,TECLEUNIK)
         
         OPTIMARack(SansEspace(NumériqueVersChaîne(Tempo.tnumeroprep)),Faux,JaugeOptima)  // premiere passe pour thermos a optimiser
         OPTIMARack(SansEspace(NumériqueVersChaîne(Tempo.tnumeroprep))+"FAB",Vrai,Jaugeoptima) // deuxieme passe pour fabrication seulemen
         
         gtabTransferReport.trie(ttMembre,"SSlotNumber")
         
         
         
         HExécuteRequête(RequeteCommandeEnPreparation)
         HExécuteRequête(RequetePrep)
         SI PAS HNbEnr(RequeteCommandeEnPreparation) = 0 ALORS
         	TransfertVideojet1(SaiNoLot)
         	HLitPremier(RequetePrep)
         	TANTQUE PAS HEnDehors(RequetePrep)
         		SI HLitRecherche(Facture,fanumero,RequetePrep.fanumero) ALORS	
         			
         			Facture.FPREPARATION = "F"
         			
         			Facture.NoLot = Tempo.tnumeroprep
         			HModifie("Facture")
         			
         		FIN
         		HLitSuivant(RequetePrep)
         	FIN
         	//	supprimetempo()
         	HLitPremier("infoprep","I1CLEUNIK",hBlocageEcriture)
         	SI HErreurBlocage() ALORS
         		Erreur("Information déja en utilisation sur un autre poste")
         	SINON
         		infoprep.ipdate = ""
         		HModifie("infoprep")
         	FIN
         FIN
         sablier(faux)
         ExécuteTraitement(IntCourriel,trtModification)
         mafenetre..plan = pConfirm
         
         CAS EXCEPTION:
         HFerme(fdetailtempoc)
         HFerme(fdetailtempoc1)
         HFerme(fdetailtempoc2)
         HFerme(fdetailtempo0)
         HFerme(fdetailtempo1)
         HFerme(fdetailtempo2)
         HFerme(fdetailtempoF)
         HFerme(TQtePrep)
         Erreur(Exceptioninfo(errMessage))
         
         CAS ERREUR:
         HFerme(fdetailtempoc)
         HFerme(fdetailtempoc1)
         HFerme(fdetailtempoc2)
         HFerme(fdetailtempo0)
         HFerme(fdetailtempo1)
         HFerme(fdetailtempo2)
         HFerme(fdetailtempoF)
         HFerme(TQtePrep)
         Erreur(erreurInfo(errMessage))
        type : 18
      -
        type : 161
        enabled : false
