         enabled : false
 actionbar : {}
 code_elements :
  type_code : 1
  p_codes :
   -
     internal_properties : CQAAAAkAAACiyCFtGEN9JwOhSk11QNgOOOvzgqpfoMp6CTVKhwhXZfD+7l30PptoCXTRBNUCtoZKT/c9zE1wYm41ZqQRbjgaDkQlOTocne+znVP2xnnwqZl13dVbRA==
     code : |1+
      // Traitement automatique des erreurs :   exécuter le bloc de code CAS ERREUR
      //
      // Traitement automatique des exceptions :   exécuter le bloc de code CAS EXCEPTION:
      //
      
      //STTransferReport est une structure
      //	nOrderNumber est un entier
      //	sLargeur est une chaine
      //	sHauteur est une chaîne
      //	sSlotNumber est une chaîne
      //	sGlassCode est une chaîne
      //	sShape est une chaîne
      //	sGrill est une chaîne
      //	sSpacerDimension est une chaîne
      //	sSpacerType est une chaîne
      //fin
      gtabTransferReport est un tableau de stTransferReport
      gstCurrentTransferReport est un STTransferreport
      
      
      fdetailtempoc est une source de données
      fdetailtempoc1 est une source de données
      fdetailtempoc2 est une source de données
      fdetailtempo0 est une Source de Données
      fdetailtempo1 est une Source de Données
      fdetailtempo2 est une Source de Données
      fdetailtempoF est une Source de Données
      
      
      gsFichierLP   est une chaine
      gsFichierLOG  est une chaine
      gsFichierSOL  est une chaine
      
      gAltEnfonce est un booleen
      
      
      CONSTANTE
      	// NOM de la DLL
      	DLL_NOM = "lpsolve55.dll"
      	// MODES VERBEUX ======================================================================================================
      	CST_VERBOSE_NEUTRAL 		= 0  	//Only some specific debug messages in de debug print routines are reported.
      	CST_VERBOSE_CRITICAL		= 1 	//Only critical messages are reported. Hard errors like instability, out of memory, ...
      	CST_VERBOSE_SEVERE 			= 2 	//Only severe messages are reported. Errors.
      	CST_VERBOSE_IMPORTANT		= 3 	//Only important messages are reported. Warnings and Errors.
      	CST_VERBOSE_NORMAL			= 4		//Normal messages are reported. This is the default.
      	CST_VERBOSE_DETAILED		= 5 	//Detailed messages are reported. Like model size, continuing B&B improvements, ...
      	CST_VERBOSE_FULL			= 6 	//All messages are reported. Useful for debugging purposes and small models.
      	//====================================================================================================================
      	// VALEURS RENVOYEES PAR LA FONCTION solve :
      	CST_RES_NOMEMORY 		= -2		//Out of memory
      	CST_RES_OPTIMAL			= 0			//An optimal solution was obtained
      	CST_RES_SUBOPTIMAL		= 1			//The model is sub-optimal. Only happens if there are integer variables and there is already an integer solution found. The solution is not guaranteed the most optimal one.
      	CST_RES_INFEASIBLE		= 2			//The model is infeasible
      	CST_RES_UNBOUNDED		= 3			//The model is unbounded
      	CST_RES_DEGENERATE		= 4			//The model is degenerative
      	CST_RES_NUMFAILURE		= 5			//Numerical failure encountered
      	CST_RES_USERABORT		= 6			//The abort routine returned TRUE. See put_abortfunc
      	CST_RES_TIMEOUT			= 7			//A timeout occurred. A timeout was set via set_timeout
      	CST_RES_PRESOLVED		= 9			//The model could be solved by presolve. This can only happen if presolve is active via set_presolve
      	CST_RES_PROCFAIL		= 10		//The B&B routine failed
      	CST_RES_PROCBREAK		= 11		//The B&B was stopped because of a break-at-first (see set_break_at_first) or a break-at-value (see set_break_at_value)
      	CST_RES_FEASFOUND		= 12		//A feasible B&B solution was found
      	CST_RES_NOFEASFOUND		= 13		//No feasible B&B solution found
      FIN
      
      
      
      
      
      
      
      
      
      
      
      
      
      
      // Pour compatibilité 5.5
      MoiMême..Visible=Vrai
      
      global
      	wligne est un entier   // # ligne de facture
      	//numeroevenement[1] = evenement("DOUBLECLIC","btn_secteur",WM_LBUTTONDBLCLK)
      	forme est une chaine = ""
      	listedesecteurprep est un tableau dynamique de 1 chaine
      	traitementspecial est un booleen = faux  // pour savoir si deux produits ont un
      	// traitement spécial entre eux CL03 et ENG3 par exemple
      	prochainnumeroprep est un entier  // numero de preparation
      	ltableauNbVerre est un tableau dynamique
      ltableauNbVerre = allouer un tableau de 0 par 2 chaines
      nbl est un entier
      nbh est un entier
      
      lMaxQteMoins est un entier
      lMaxQtePlus est un entier
      EcartToleranceHauteur est un entier = gclconfig.m_nEcartHauteur
      EcartToleranceLargeur est un entier = gclconfig.m_nEcartLargeur
      EcartToleranceHauteurTriFinal est un entier = gclconfig.m_nEcartHauteurTriFinal
      EcartToleranceLargeurTriFinal est un entier = gclconfig.m_nEcartLargeurTriFinal
      
      CheminPdfDocument est une chaine = sansespace(gclconfig.m_sCheminPdfSpacer)
      si pas fRépertoireExiste(CheminPdfDocument) alors frepcree(CheminPdfDocument)
      
      _groupe est un entier 
      _positionJauge est un entier = 1
      
      
      lMinQteTableSiIdentique est un entier
      lEcartHauteur est un entier
      lEcartLargeur est un entier
      lHER est un booleen
      ldimensionAverifierPrep est un entier
      ConstanteAAjouter est un entier = 0
      cpt est un entier = 1
      
      //hlit(config,1)
      lMaxQteMoins=gclconfig.m_nMaxQteClair1300Moins
      lMaxQtePlus=gclconfig.m_nMaxQteClair1300Plus
      lMinQteTableSiIdentique=gclconfig.m_nMaxQteTableSiIdentique
      lEcartHauteur = gclconfig.m_nEcartHauteur
      lEcartLargeur = gclconfig.m_nEcartLargeur
      ldimensionAverifierPrep = gclconfig.m_nDimensionAverifierPrep
      
      NbCommandeSelectionnees est un entier
      
      
      rangtrtspe est une chaine
      noprodtrtspe est un chaine
      
      CptDepart est un entier = 1
      
      fid est un entier
      gPosition est un entier = 0
      chargeimage(1,maitre.FichierImage,1,13)
      ListeAjoute("crochet",gImage(1,7))
      
      hlitpremier("infoprep","I1CLEUNIK")
      SI gFormatFacture <> 2 ALORS
      	si pas sansespace(infoprep.ipdate) = "" alors
      
      		btn_preparation..etat = grisé; btn_preparation..Visible=Vrai
      		btn_prepare..etat = grisé; btn_prepare..Visible=Vrai
      		
      	sinon
      		information..etat = grisé; information..Visible=Vrai
      		btn_choix..etat = grisé; btn_choix..Visible=Vrai
      	fin
      sinon
      	SI PAS SansEspace(infoprep.ipdate) = "" ALORS
      		SI ACSO_message("Question","Une préparation est en cours"+RC+"Voulez-vous l'annuler ?","OuiNon") = idyes ALORS
      			ExécuteTraitement(INFORMATION,trtClic)
      		SINON
      			Ferme(preparation)	 
      		FIN
      	fin
      	
      fin
      
      
      tablesupprimetout("TABLE1")
      
      ListeAjoute(Combo_Camions,gLien(0)+"0 - Tous les camions")
      pour chaque camions sur camions.NoCamion
      	listeajoute(Combo_Camions,glien(camions.IDCamions)+Camions.NoCamion+" - "+camions.Description) 
      FIN
      
      
      
      reppourxopt est une chaine = sansespace(gclconfig.m_sDossierOptimisation)
      FileCreatedArray est une tableau de chaînes
      resultat est un entier
      //HLit(config,1)
      //reponse est une chaine
      TH est une chaine = sansespace(gclconfig.m_svjthermafix)
      SN est une chaine = sansespace(gclconfig.m_svjstnazaire)
      IG est une chaine = sansespace(gclconfig.m_stexteigma)
      IC est une chaine = sansespace(gclconfig.m_svjindcover)
      v1 est une chaine = sansespace(gclconfig.m_svjvariable1)
