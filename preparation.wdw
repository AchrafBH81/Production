     type : 458752
   -
     name : TriUnx
     procedure_id : 5386536676634486133
     type_code : 14
     code : |1+
      Procédure TriUnx(ecartHauteur = 50,ecartLargeur=100,lqteminimum=6,lespacetri=0)
      VueEspaceTri est une source de données
      maxClairPetit est un entier = 12
      maxClairGrand est un entier = 8
      MaxClair est une entier 
      
      i est un entier
      lnorec est un entier
      lhauteurcourant est un entier
      llargeurcourant est un entier
      ltricourant est un entier
      ltrisuivant est un entier
      lChangement est un entier = 0
      lDifferenceLargeur est un entier = 0
      lNoRecAConserver est un entier
      isAllDeleted est un booleen
      lqte est un entier = 0
      ligneaecrire est une chaine
      
      MemCrée("Batch")
      
      pour tout Fdetailtempo sur HAUTEURLARGEURfNoForme
      	i++
      	fdetailtempo.tposition = i
      	fdetailtempo.tpositiontempo = i
      	HModifie(Fdetailtempo,hNumEnrEnCours)
      FIN
      i=1
      //hexecuterequete(vueespacetri,hModifieFichier,lespacetri)
      info(HCréeVue(VueEspaceTri,Fdetailtempo,"*","tposition","fespacetri = "+lespacetri,hVueblocage))
      info(HNbEnr(VueEspaceTri))
      hlitpremier(VueEspaceTri)
      lhauteurcourant = VueEspaceTri.HAUTEUR
      llargeurcourant = VueEspaceTri.LARGEUR
      lnouveau est un booleen = vrai
      lNoRecAConserver = HNumEnr(VueEspaceTri)
      
      boucle
      	i++
      	message("Passage :"+i)
      	lChangement=0
      
      	hlitpremier(VueEspaceTri)
      	lDifferenceLargeur  = 0
      
      	tantque pas HEnDehors(VueEspaceTri)
      		si pas VueEspaceTri.deleted et pas HNumEnr(VueEspaceTri) = lNoRecAConserver et VueEspaceTri.fEspaceTri = lespacetri alors
      			si abs(lhauteurcourant - VueEspaceTri.HAUTEUR)   <= ecartHauteur  alors //et lhauteurcourant - vueespacetri.HAUTEUR >= 0 alors
      				si abs(VueEspaceTri.LARGEUR - llargeurcourant) <= ecartLargeur et VueEspaceTri.LARGEUR >= lDifferenceLargeur alors
      					lDifferenceLargeur  = VueEspaceTri.LARGEUR 
      					lNoRecAConserver = HNumEnr(VueEspaceTri)
      				FIN
      			sinon
      				sortir
      			FIN
      		fin
      		HLitSuivant(VueEspaceTri)
      	FIN
      
      	si lNoRecAConserver=0 alors
      		si lqte < lqteminimum alors
      			pour i = 1 a MemOccurrence("Batch")
      				hlit(VueEspaceTri,Memrecupere("Batch",i))
      					//vueespacetri.deleted = faux
      				VueEspaceTri.Differe = vrai
      				//			vueespacetri.deleted = faux
      				HModifie(VueEspaceTri,hNumEnrEnCours)
      				HVueVersFichier(VueEspaceTri)
      			fin
      			ligneaecrire=""
      		sinon
      			pour i = 1 a MemOccurrence("Batch")
      				hlit(VueEspaceTri,Memrecupere("Batch",i))
                      HCopieEnreg(Fdetailtempotri,VueEspaceTri)
                      gposition++
                      fdetailtempotri.tposition = gposition
      				hajoute(Fdetailtempotri)
      				//vueespacetri.deleted = faux
      			fin
      			ligneaecrire+="********** FIN *******************"
      			fEcritLigne(fid,ligneaecrire)
      			ligneaecrire=""
      		fin
      		MemSupprimeTout("Batch")
      		memcréé("Batch")	
      		//		fEcritLigne(fid,"********** FIN *******************")
      		hlitpremier(VueEspaceTri)
      		tantque VueEspaceTri.deleted et VueEspaceTri.fEspaceTri = lespacetri
      			HLitSuivant(VueEspaceTri)
      		FIN
      		lhauteurcourant = VueEspaceTri.HAUTEUR
      		llargeurcourant = VueEspaceTri.LARGEUR
      		lNoRecAConserver = HNumEnr(VueEspaceTri)
      		lqte=0
      		lnouveau = vrai
      		continuer
      	fin
      
      	hlit(VueEspaceTri,lNoRecAConserver)
      	si lnouveau alors
      		si VueEspaceTri.LARGEUR >= 1300 ou VueEspaceTri.hauteur >=1300 alors
      			MaxClair = maxClairGrand
      		sinon
      			MaxClair = maxClairPetit   
      		fin
      		lnouveau = faux
      	fin
      
      	si lqte+VueEspaceTri.tqte > MaxClair alors
      		//		fEcritLigne(fid,"********** FIN *******************")
      		pour i = 1 a MemOccurrence("Batch")
      			hlit(VueEspaceTri,Memrecupere("Batch",i))
      			HCopieEnreg(Fdetailtempotri,VueEspaceTri)
      			gposition++
      			fdetailtempotri.tposition = gposition
      			hajoute(Fdetailtempotri)
      			//vueespacetri.deleted = faux
      		fin
      		ligneaecrire+="********** FIN *******************"
      		fEcritLigne(fid,ligneaecrire)
      		ligneaecrire=""
      		hlitpremier(VueEspaceTri)
      		tantque VueEspaceTri.deleted et VueEspaceTri.fEspaceTri = lespacetri
      			HLitSuivant(VueEspaceTri)
      		FIN
      		lhauteurcourant = VueEspaceTri.HAUTEUR
      		llargeurcourant = VueEspaceTri.LARGEUR
      		lNoRecAConserver = HNumEnr(VueEspaceTri)
      		lqte=0
      		lnouveau = vrai
      		MemSupprimeTout("Batch")
      		memcréé("Batch")
      		continuer
      	fin	
      	VueEspaceTri.deleted = vrai
      	VueEspaceTri.differe = faux
      	lqte+=VueEspaceTri.tqte
      	memajoute("Batch",HNumEnr(VueEspaceTri),hnumenr(VueEspaceTri))
      	hmodifie(VueEspaceTri,hNumEnrEnCours)
      	HVueVersFichier(VueEspaceTri)
      	lhauteurcourant = VueEspaceTri.HAUTEUR
      	llargeurcourant = VueEspaceTri.LARGEUR
      
      	ligneaecrire +=VueEspaceTri.fdnocomm+"-"+VueEspaceTri.fdligne+","+VueEspaceTri.HAUTEUR+"X"+VueEspaceTri.LARGEUR+" ( "+lqte +" ) " +rc
      	//	fEcritLigne(fid,vueespacetri.fdnocomm+"-"+vueespacetri.fdligne+","+vueespacetri.HAUTEUR+"X"+vueespacetri.LARGEUR+" ( "+lqte +" ) ")
      
      	//	hsupprime(vueespacetri,hNumEnrEnCours)
      	isAllDeleted = vrai
      	lNoRecAConserver = 0
      	pour tout VueEspaceTri
      		si pas VueEspaceTri.deleted alors
      			isAllDeleted = faux
      			sortir
      		FIN
      	fin
      	si isAllDeleted alors
      		sortir
      	fin	
      
      fin
      si lqte < lqteminimum alors
      	pour i = 1 a MemOccurrence("Batch")
      		hlit(VueEspaceTri,Memrecupere("Batch",i))
      		//vueespacetri.deleted = faux
      		VueEspaceTri.Differe = vrai
      		//			vueespacetri.deleted = faux
      		HModifie(VueEspaceTri,hNumEnrEnCours)
      		HVueVersFichier(VueEspaceTri)
      	fin
      	ligneaecrire=""
      fin
      
      //si MemOccurrence("Batch") = 1 alors
      //	hlit(vueespacetri,MemPremier("Batch"))
      //	//vueespacetri.deleted = faux
      //	vueespacetri.Differe = vrai
      //	HModifie(vueespacetri,hNumEnrEnCours)
      //fin
      MemSupprimeTout("Batch")
      memcréé("Batch")	
      
      
     type : 458752
   -
     name : TriPrincipal
     procedure_id : 5386583180744564027
     type_code : 14
     code : |1+
      Procédure TriPrincipal(lespacetri=0)
      i est un entier
      si hnbenr(fdetailtempo) = 0 alors
      	renvoyer vrai
      FIN
      triun(lecartHauteur,lecartLargeur,lMinQteTable,lespacetri)
      hexecuterequete(RequeteEspaceTri,hModifieFichier,lespacetri)
      pour tout RequeteEspaceTri 
      	si pas RequeteEspaceTri.Differe alors
      		HSupprime(RequeteEspaceTri,hNumEnrEnCours)
      	sinon
      		RequeteEspaceTri.deleted = faux
      		RequeteEspaceTri.Differe = faux
      		HModifie(RequeteEspaceTri,hNumEnrEnCours)	
      	FIN
      FIN
      
      si hnbenr(fdetailtempo) = 0 alors
      	renvoyer vrai
      FIN
      triun(lecartHauteur*1.5,lecartLargeur*1.5,lMinQteTable,lespacetri)
      hexecuterequete(RequeteEspaceTri,hModifieFichier,lespacetri)
      pour tout RequeteEspaceTri 
      	si pas RequeteEspaceTri.Differe alors
      		HSupprime(RequeteEspaceTri,hNumEnrEnCours)
      	sinon
      		RequeteEspaceTri.deleted = faux
      		RequeteEspaceTri.Differe = faux
      		HModifie(RequeteEspaceTri,hNumEnrEnCours)	
      	FIN
      FIN
      hexecuterequete(RequeteEspaceTri,hModifieFichier,lespacetri)
      pour tout RequeteEspaceTri 
      	RequeteEspaceTri.Differe = vrai
      	HModifie(RequeteEspaceTri,hNumEnrEnCours)	
      FIN
      
      
      
      pour i = 1 a 6
      	si hnbenr(fdetailtempo) = 0 alors
      		renvoyer vrai
      	FIN
      	trideux(lecartHauteur,lecartLargeur * (1+((i-1)*0.10)),lMaxQteTriDeux,lespacetri)
      	hexecuterequete(RequeteEspaceTri,hModifieFichier,lespacetri)
      	pour tout RequeteEspaceTri 
      		si RequeteEspaceTri.Deleted alors
      			Hsupprime(RequeteEspaceTri,hNumEnrEnCours)	
      		fin
      	FIN
      fin
      
      
      
      
      
      renvoyer vrai
      
      
      
      
      
      
      
      
      
      
     type : 458752
   -
     name : TriDeux
     procedure_id : 5386594992625062310
     type_code : 14
     code : |1+
      procedure TriDeux(ecartHauteur = 50,ecartLargeur=100,lqteMaximum=6,lespacetri=0)
      //fdetailtempotri est une source de donnees
      //halias(Fdetailtempo,fdetailtempotri)
      //hcreation(fdetailtempotri)
      maxClairPetit est un entier = 12
      maxClairGrand est un entier = 8
      MaxClair est une entier 
      //fid est un entier = fcree("C:\ordre.txt")
      i est un entier
      lnorec est un entier
      lhauteurcourant est un reel
      llargeurcourant est un reel
      ltricourant est un entier
      ltrisuivant est un entier
      lChangement est un entier = 0
      lDifferenceLargeur est un reel = 0
      lTotalDimension est un reel = 0
      lNoRecAConserver est un entier
      lNoRecCourant est un entier
      isNoDiffere est un booleen
      lqte est un entier = 0
      
      
      pour tout Fdetailtempo sur HAUTEURLARGEURfNoForme
      	i++
      	fdetailtempo.tposition = i
      	fdetailtempo.tpositiontempo = i
      	HModifie(Fdetailtempo,hNumEnrEnCours)
      FIN
      i=1
      boucle
      	hlitpremier(Fdetailtempo,tposition)
      	tantque pas Fdetailtempo.differe ET FDETAILTEMPO.fEspaceTri = lespacetri
      		HLitSuivant(Fdetailtempo,tposition)
      	FIN
      	si hendehors(Fdetailtempo) ou  Fdetailtempo.fEspaceTri <> lespacetri alors
      		sortir
      	FIN
      	lhauteurcourant = Fdetailtempo.HAUTEUR
      	llargeurcourant = Fdetailtempo.LARGEUR
      	lnouveau est un booleen = vrai
      	lTotalDimension = Fdetailtempo.LARGEUR + Fdetailtempo.HAUTEUR
      	Fdetailtempo.Differe = faux
      	fdetailtempo.Deleted = vrai
      	hmodifie(Fdetailtempo,hNumEnrEnCours)
      	lNoRecCourant = HNumEnr(Fdetailtempo)
      	lNoRecAConserver=0
      	gposition++
      	HCopieEnreg(Fdetailtempotri,Fdetailtempo)
      	fdetailtempotri.tposition = gposition
      	si Fdetailtempo.tqte = 6 alors
      		fdetailtempotri.rupture = vrai
      	sinon
      		fdetailtempotri.rupture = faux
      	FIN
      	hajoute(Fdetailtempotri)
      
      	fEcritLigne(fid,Fdetailtempo.fdnocomm+"-"+Fdetailtempo.fdligne+","+Fdetailtempo.HAUTEUR+"X"+Fdetailtempo.LARGEUR+" ( "+fdetailtempo.tqte +" ) ")
      	lqte=Fdetailtempo.tqte
      	isNoDiffere = vrai
      	pour tout Fdetailtempo
      		si Fdetailtempo.differe alors
      			isNoDiffere = faux
      			sortir
      		FIN
      	fin
      	si isNoDiffere alors
      		sortir
      	fin	
      	boucle
      		i++
      		message("Passage :"+i)
      		lChangement=0
      
      		hlitpremier(Fdetailtempo,tposition)
      		lDifferenceLargeur  = 10000
      
      		tantque pas HEnDehors(Fdetailtempo)
      			si Fdetailtempo.differe et pas HNumEnr(Fdetailtempo) = lNoRecCourant ET FDETAILTEMPO.fEspaceTri = lespacetri alors
      				//			si abs(lhauteurcourant - Fdetailtempo.HAUTEUR)   <= 50  alors //et lhauteurcourant - Fdetailtempo.HAUTEUR >= 0 alors
      				//			si Fdetailtempo.hauteur+Fdetailtempo.LARGEUR < lTotalDimension alors
      				si Fdetailtempo.hauteur+Fdetailtempo.LARGEUR < lTotalDimension  ou abs((Fdetailtempo.hauteur+Fdetailtempo.LARGEUR)- lTotalDimension) < ecartLargeur alors
      					si abs(Fdetailtempo.hauteur-lhauteurcourant)+abs(fdetailtempo.largeur - llargeurcourant) < lDifferenceLargeur alors
      						si abs(fdetailtempo.largeur - llargeurcourant) < ecartLargeur ou fdetailtempo.largeur < llargeurcourant alors
      							lDifferenceLargeur  = abs(Fdetailtempo.hauteur-lhauteurcourant)+abs(fdetailtempo.largeur - llargeurcourant) 
      							lNoRecAConserver = HNumEnr(Fdetailtempo)
      						fin
      					fin
      				FIN
      			fin
      			HLitSuivant(Fdetailtempo,tposition)
      		FIN
      		si lNoRecAConserver = 0 alors
      			hlitpremier(Fdetailtempo,tPosition)
      			tantque pas Fdetailtempo.differe ET FDETAILTEMPO.fEspaceTri = lespacetri
      				HLitSuivant(Fdetailtempo,tPosition)
      			FIN
      			si hendehors(Fdetailtempo) ou  Fdetailtempo.fEspaceTri <> lespacetri alors
      				isNoDiffere =vrai
      				sortir
      			FIN
      			lhauteurcourant = Fdetailtempo.HAUTEUR
      			llargeurcourant = Fdetailtempo.LARGEUR
      			lNoRecCourant = HNumEnr(Fdetailtempo)
      			//		lnorecaconserver = HNumEnr(Fdetailtempo)
      			lTotalDimension = Fdetailtempo.LARGEUR + Fdetailtempo.HAUTEUR
      			lqte=0
      			lnouveau = vrai
      			Fdetailtempotri.rupture = vrai
      			hmodifie(fdetailtempotri,hNumEnrEnCours)
      
      			sortir
      		fin
      
      		hlit(Fdetailtempo,lNoRecAConserver)
      
      		si lqte+Fdetailtempo.tqte > 6 alors
      
      			si 6 - lqte > 0 alors
      				gposition++
      				HCopieEnreg(Fdetailtempotri,Fdetailtempo)
      				fdetailtempotri.tposition = gposition
      				//				fdetailtempotri.rupture = faux
      				Fdetailtempotri.tqte = (6-lqte)
      				fdetailtempotri.rupture= vrai
      				hajoute(Fdetailtempotri)
      				Fdetailtempo.tqte -= (6-lqte)
      				hmodifie(Fdetailtempo,hNumEnrEnCours)
      			FIN
      			fEcritLigne(fid,Fdetailtempo.fdnocomm+"-"+Fdetailtempo.fdligne+","+Fdetailtempo.HAUTEUR+"X"+Fdetailtempo.LARGEUR+" ( "+(6-lqte) +" ) ")
      			fEcritLigne(fid,"********** FIN *******************")
      			//            hlitdernier(Fdetailtempotri,"tposition")
      			//            fdetailtempotri.rupture = vrai
      			//            hmodifie(Fdetailtempotri,hNumEnrEnCours)
      			hlitpremier(Fdetailtempo,tPosition)
      			tantque pas Fdetailtempo.differe ET FDETAILTEMPO.fEspaceTri = lespacetri
      				HLitSuivant(Fdetailtempo,tPosition)
      			FIN
      			si hendehors(Fdetailtempo) ou  Fdetailtempo.fEspaceTri <> lespacetri alors
      				isNoDiffere =vrai
      				sortir
      			FIN
      			lhauteurcourant = Fdetailtempo.HAUTEUR
      			llargeurcourant = Fdetailtempo.LARGEUR
      			lNoRecCourant = HNumEnr(Fdetailtempo)
      			lTotalDimension = Fdetailtempo.LARGEUR + Fdetailtempo.HAUTEUR
      			lqte=0
      			lnouveau = vrai
      			sortir
      		fin	
      		Fdetailtempo.differe = faux
      		Fdetailtempo.deleted = vrai
      		lqte+=Fdetailtempo.tqte
      		hmodifie(Fdetailtempo,hNumEnrEnCours)
      		lhauteurcourant = Fdetailtempo.HAUTEUR
      		llargeurcourant = Fdetailtempo.LARGEUR
      		lTotalDimension = Fdetailtempo.LARGEUR + Fdetailtempo.HAUTEUR
      		lNoRecCourant = HNumEnr(Fdetailtempo)
      		//		si lNoRecAConserver <> HNumEnr(Fdetailtempo) alors
      		gposition++
      		HCopieEnreg(Fdetailtempotri,Fdetailtempo)
      		fdetailtempotri.tposition = gposition
      		si lqte = 6 alors
      			fdetailtempotri.rupture = vrai
      		sinon	
      			fdetailtempotri.rupture = faux
      		fin
      		hajoute(Fdetailtempotri)
      		fEcritLigne(fid,Fdetailtempo.fdnocomm+"-"+Fdetailtempo.fdligne+","+Fdetailtempo.HAUTEUR+"X"+Fdetailtempo.LARGEUR+" ( "+lqte +" ) ")
      		//		fin
      		//	hsupprime(Fdetailtempo,hNumEnrEnCours)
      		isNoDiffere = vrai
      		lNoRecAConserver = 0
      		pour tout Fdetailtempo
      			si Fdetailtempo.differe alors
      				isNoDiffere = faux
      				sortir
      			FIN
      		fin
      		si isNoDiffere alors
      			sortir
      		fin	
      	fin
      	si isNoDiffere alors
      		fEcritLigne(fid,"********** FIN *******************")
      		sortir
      	fin	
      
      
      
      fin
      hlitdernier(Fdetailtempotri,"tposition")
      fdetailtempotri.rupture = vrai
      hmodifie(Fdetailtempotri,hNumEnrEnCours)
     type : 458752
   -
     name : TriUn
     procedure_id : 5386618288755660726
     type_code : 14
     code : |1+
      Procédure TriUn(ecartHauteur = 50,ecartLargeur=100,lqteminimum=6,lespacetri=0)
      
      
      maxQteDimension est une entier 
      
      i est un entier
      lnorec est un entier
      lhauteurcourant est un reel
      llargeurcourant est un reel
      ltricourant est un entier
      ltrisuivant est un entier
      lChangement est un entier = 0
      lLargeuraConserver est un reel = 0
      lHauteuraConserver est un reel = 0
      lNoRecAConserver est un entier
      isAllDeleted est un booleen
      lqte est un entier = 0
      ligneaecrire est une chaine
      
      MemCrée("Batch")
      
      pour tout Fdetailtempo sur HAUTEURLARGEURfNoForme
      	i++
      	fdetailtempo.tposition = i
      	fdetailtempo.tpositiontempo = i
      	Fdetailtempo.tDimensionTotale = fdetailtempo.HAUTEUR+Fdetailtempo.LARGEUR
      	HModifie(Fdetailtempo,hNumEnrEnCours)
      FIN
      
      i=1
      hexecuterequete(RequeteEspaceTri,hModifieFichier,lespacetri)
      si hnbenr(RequeteEspaceTri) = 0 alors
      	renvoyer vrai
      FIN
      hlitpremier(requeteespacetri,tposition)
      lhauteurcourant = requeteespacetri.HAUTEUR
      llargeurcourant = requeteespacetri.LARGEUR
      lnouveau est un booleen = vrai
      lNoRecAConserver = RequeteEspaceTri.IDFdetailtempo
      lLargeuraConserver = requeteespacetri.LARGEUR
      boucle
      	i++
      	message("Passage :"+i)
      	lChangement=0
      
      	hlitpremier(requeteespacetri,tposition)
      	//	lLargeuraConserver  = 0
      	lHauteuraConserver  = 0
      
      	tantque pas HEnDehors(requeteespacetri)
      		si pas requeteespacetri.deleted et pas requeteespacetri.IDFdetailtempo = lNoRecAConserver et requeteespacetri.fEspaceTri = lespacetri alors
      			si abs(lhauteurcourant - requeteespacetri.HAUTEUR)   <= ecartHauteur  alors //et requeteespacetri.HAUTEUR < lhauteurcourant alors
      				si abs(requeteespacetri.LARGEUR - llargeurcourant) <= ecartLargeur alors //et requeteespacetri.largeur < llargeurcourant alors
      					//					si abs(lhauteurcourant - requeteespacetri.HAUTEUR) < abs(requeteespacetri.LARGEUR - llargeurcourant)  alors
      					//	si lhauteurcourant + llargeurcourant < requeteespacetri.LARGEUR + requeteespacetri.hauteur  alors
      					//					si abs(llargeurcourant - requeteespacetri.largeur) < abs(requeteespacetri.largeur - lLargeuraConserver) ou ...
      					//						abs(lhauteurcourant - requeteespacetri.HAUTEUR) < abs(requeteespacetri.hauteur - lHauteuraConserver)	alors
      					lLargeuraConserver  = requeteespacetri.LARGEUR 
      					lHauteuraConserver  = requeteespacetri.Hauteur 
      					lNoRecAConserver = RequeteEspaceTri.IDFdetailtempo
      					//					fin
      				FIN
      			sinon
      				sortir
      			FIN
      		fin
      		HLitSuivant(requeteespacetri,tposition)
      	FIN
      
      
      	si lNoRecAConserver=0 alors
      		si lqte < lqteminimum alors
      			pour i = 1 a MemOccurrence("Batch")
      				hlitrecherche(requeteespacetri,iDFdetailtempo,Memrecupere("Batch",i))
      				//requeteespacetri.deleted = faux
      				requeteespacetri.Differe = vrai
      				//			requeteespacetri.deleted = faux
      				HModifie(requeteespacetri,hNumEnrEnCours)
      			fin
      			ligneaecrire=""
      		sinon
      			TriMemoire("Batch")
      			pour i = 1 a MemOccurrence("Batch")
      				//	pour i = 1 a MemOccurrence("Batch")
      				hlitrecherche(requeteespacetri,iDFdetailtempo,Memrecupere("Batch",i))
      				HCopieEnreg(Fdetailtempotri,requeteespacetri)
      				gposition++
      				fdetailtempotri.tposition = gposition
      				fdetailtempotri.rupture = faux
      				
      				hajoute(Fdetailtempotri)
      				//requeteespacetri.deleted = faux
      			fin
      			fdetailtempotri.rupture = vrai
      
      			hmodifie(Fdetailtempotri,hNumEnrEnCours)
      			ligneaecrire+="********** FIN *******************"
      			fEcritLigne(fid,ligneaecrire)
      			ligneaecrire=""
      		fin
      		MemSupprimeTout("Batch")
      		memcréé("Batch")	
      		//		fEcritLigne(fid,"********** FIN *******************")
      		hlitpremier(requeteespacetri,tposition)
      		tantque requeteespacetri.deleted et requeteespacetri.fEspaceTri = lespacetri
      			HLitSuivant(requeteespacetri,Tposition)
      		FIN
      		lhauteurcourant = requeteespacetri.HAUTEUR
      		llargeurcourant = requeteespacetri.LARGEUR
      		lLargeuraConserver = requeteespacetri.LARGEUR
      		lNoRecAConserver = requeteespacetri.IDFdetailtempo
      		lqte=0
      		lnouveau = vrai
      		continuer
      	fin
      
      	hlitrecherche(requeteespacetri,iDFdetailtempo,lNoRecAConserver)
      	si lnouveau alors
      		si lHER alors
      			si requeteespacetri.LARGEUR >= ldimensionAverifierPrep ou requeteespacetri.hauteur >=ldimensionAverifierPrep alors
      				maxQteDimension = lMaxQteHER1300Plus
      			sinon
      				maxQteDimension = lMaxQteHER1300moins   
      			fin
      		sinon
      			si requeteespacetri.LARGEUR >= ldimensionAverifierPrep ou requeteespacetri.hauteur >=ldimensionAverifierPrep alors
      				maxQteDimension = lMaxQteClair1300Plus
      			sinon
      				maxQteDimension = lMaxQteClair1300moins   
      			fin
      
      		fin
      		lnouveau = faux
      	fin
      
      
      	si lqte+requeteespacetri.tqte > maxQteDimension alors
      		//		fEcritLigne(fid,"********** FIN *******************")
      		si pas MemExiste("Batch") alors
      			MemCrée("Batch")
      		fin
      		si maxQteDimension - lqte > 0 alors
      			RequeteEspaceTri.TQteRupture = maxQteDimension - lqte
      			RequeteEspaceTri.tqte-=RequeteEspaceTri.TQteRupture
      			hmodifie(RequeteEspaceTri,hNumEnrEnCours)
      			memajoute("Batch",RequeteEspaceTri.IDFdetailtempo,RequeteEspaceTri.IDFdetailtempo)
      		FIN
      
      
      		//		pour i = 1 a MemOccurrence("Batch")	
      		TriMemoire("Batch")
      		pour i = 1 a MemOccurrence("Batch") 
      			hlitrecherche(requeteespacetri,iDFdetailtempo,Memrecupere("Batch",i))
      			HCopieEnreg(Fdetailtempotri,requeteespacetri)
      			si RequeteEspaceTri.TQteRupture <> 0 alors
      				fdetailtempotri.tqte = RequeteEspaceTri.TQteRupture
      				RequeteEspaceTri.TQteRupture=0
      				hmodifie(RequeteEspaceTri,hNumEnrEnCours)
      			FIN
      			gposition++
      			fdetailtempotri.tposition = gposition
      			fdetailtempotri.rupture = faux
      
      			hajoute(Fdetailtempotri)
      			//requeteespacetri.deleted = faux
      		fin
      		fdetailtempotri.rupture = vrai
      
      		hmodifie(Fdetailtempotri,hNumEnrEnCours)
      		ligneaecrire+="********** FIN *******************"
      		fEcritLigne(fid,ligneaecrire)
      		ligneaecrire=""
      		hlitpremier(requeteespacetri,tposition)
      		tantque requeteespacetri.deleted et requeteespacetri.fEspaceTri = lespacetri
      			HLitSuivant(requeteespacetri,Tposition)
      		FIN
      		lhauteurcourant = requeteespacetri.HAUTEUR
      		llargeurcourant = requeteespacetri.LARGEUR
      		lNoRecAConserver =requeteespacetri.IDFdetailtempo
      		lqte=0
      		lnouveau = vrai
      		MemSupprimeTout("Batch")
      		memcréé("Batch")
      		continuer
      	fin	
      	requeteespacetri.deleted = vrai
      	lqte+=requeteespacetri.tqte
      	hmodifie(requeteespacetri,hNumEnrEnCours)
      	memajoute("Batch",requeteespacetri.IDFdetailtempo,requeteespacetri.IDFdetailtempo)
      	lhauteurcourant = requeteespacetri.HAUTEUR
      	llargeurcourant = requeteespacetri.LARGEUR
      
      	ligneaecrire +=requeteespacetri.fdnocomm+"-"+requeteespacetri.fdligne+","+requeteespacetri.HAUTEUR+"X"+requeteespacetri.LARGEUR+" ( "+lqte +" ) " +rc
      	//	fEcritLigne(fid,requeteespacetri.fdnocomm+"-"+requeteespacetri.fdligne+","+requeteespacetri.HAUTEUR+"X"+requeteespacetri.LARGEUR+" ( "+lqte +" ) ")
      
      	//	hsupprime(requeteespacetri,hNumEnrEnCours)
      	isAllDeleted = vrai
      	lNoRecAConserver = 0
      	pour tout requeteespacetri
      		si pas requeteespacetri.deleted alors
      			isAllDeleted = faux
      			sortir
      		FIN
      	fin
      	si isAllDeleted alors
      		sortir
      	fin	
      
      fin
      si lqte < lqteminimum alors
      	//pour i = 1 a MemOccurrence("Batch")
      	pour i = 1 a MemOccurrence("Batch")
      		hlitrecherche(requeteespacetri,iDFdetailtempo,Memrecupere("Batch",i))
      		//requeteespacetri.deleted = faux
      		requeteespacetri.Differe = vrai
      		//			requeteespacetri.deleted = faux
      		HModifie(requeteespacetri,hNumEnrEnCours)
      	fin
      	ligneaecrire=""
      sinon
      	TriMemoire("Batch")
      	pour i = 1 a MemOccurrence("Batch") 
      		//	pour i = 1 a MemOccurrence("Batch")
      		hlitrecherche(requeteespacetri,iDFdetailtempo,Memrecupere("Batch",i))
      		HCopieEnreg(Fdetailtempotri,requeteespacetri)
      		gposition++
      		fdetailtempotri.tposition = gposition
      		fdetailtempotri.rupture = faux
      
      		hajoute(Fdetailtempotri)
      		//requeteespacetri.deleted = faux
      	fin
      	fdetailtempotri.rupture = vrai
      
      	hmodifie(Fdetailtempotri,hNumEnrEnCours)
      	ligneaecrire+="********** FIN *******************"
      	fEcritLigne(fid,ligneaecrire)
      	ligneaecrire=""
      fin
      
      
      //si MemOccurrence("Batch") = 1 alors
      //	hlit(requeteespacetri,MemPremier("Batch"))
      //	//requeteespacetri.deleted = faux
      //	requeteespacetri.Differe = vrai
      //	HModifie(requeteespacetri,hNumEnrEnCours)
      //fin
      MemSupprimeTout("Batch")
      memcréé("Batch")	
      
      
     type : 458752
   -
     name : TriTrois
     procedure_id : 5386898440573703024
     type_code : 14
     code : |1+
      Procédure TriTrois(lespacetri=0)
      
      maxClairPetit est un entier = 12
      maxClairGrand est un entier = 8
      MaxClair est une entier 
      
      i est un entier
      
      
      
      pour tout Fdetailtempo sur HAUTEURLARGEURfNoForme
      	i++
      	fdetailtempo.tposition = i
      	fdetailtempo.tpositiontempo = i
      	HModifie(Fdetailtempo,hNumEnrEnCours)
      FIN
      i=1
      hexecuterequete(RequeteEspaceTri,hModifieFichier,lespacetri)
      
      hlitpremier(requeteespacetri,tposition)
      tantque pas hendehors(RequeteEspaceTri)
      	HCopieEnreg(Fdetailtempotri,requeteespacetri)
      	gposition++
      	fdetailtempotri.tposition = gposition
      	fdetailtempotri.rupture = faux
      	hajoute(Fdetailtempotri)
      	hsupprime(RequeteEspaceTri,hNumEnrEnCours)
          hlitsuivant(RequeteEspaceTri,tposition)
      	//requeteespacetri.deleted = faux
      fin
      
      
      
      
      
