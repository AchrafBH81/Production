    name : BTN_MARQUE
    identifier : 0x2fb27d3203a00f7c
    internal_properties : 
    properties :
     x : 1109
     y : 386
     width : 80
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         si crochet = vrai alors
         	crochet = faux
         	csnCommande--
         	CalculRack(table1.COMMANDE[table1],"Moins")
         sinon
         	crochet = vrai	
         	csnCommande++
         	CalculRack(table1.COMMANDE[table1],"Plus")
         FIN
         Message("Nombre de commandes traitées " + csnCommande)
         
        type : 18
      -
