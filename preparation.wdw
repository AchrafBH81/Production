         -
           code : |1+
            i est un entier
            
            pour i = 1 a TableSelectOccurrence(TABLE1)
            	si pas table1.CROCHET[TableSelect(TABLE1,i)] alors
            		CalculRack(table1.COMMANDE[TableSelect(TABLE1,i)],"Plus")
            		csnCommande++
            	FIN
            	
            	TABLE1.CROCHET[TableSelect(TABLE1,i)] = vrai
            FIN
            
            TableSelectMoins(TABLE1)
            Message("Nombre de commandes traitées " + csnCommande)
            
           type : 32
     -
       name : Deselectionner
       identifier : 0x4a78902a7b8e3471
       internal_properties : 
       code_elements :
        type_code : 26
        p_codes :
         -
           code : |1+
            i est un entier
            
            pour i = 1 a TableSelectOccurrence(TABLE1)
            	si table1.CROCHET[TableSelect(TABLE1,i)] alors
            		CalculRack(table1.COMMANDE[TableSelect(TABLE1,i)],"Moins")
            		csnCommande--
            	FIN
            	TABLE1.CROCHET[TableSelect(TABLE1,i)] = faux
            FIN
            
            TableSelectMoins(TABLE1)
            Message("Nombre de commandes traitées " + csnCommande)
           type : 32
