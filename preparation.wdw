     type : 458752
   -
     name : TrouveOrdreNbRack
     procedure_id : 5651925896405906712
     type_code : 14
     code : |1+
      Procédure TrouveOrdreNbRack()
      
      //Procédure pour trouver le nombre de thermos a mettre dans un rackl
      // Aller voir dans le fichier ordretrtxopt si on trouve le thermos.Si oui , si case a cocher qteunprep est vrai la quantité est  1
      // Si trouve et pas de coche ou trouve pas la quantité est 2
      
      valeuraretourner est une chaine = ""
      RequêteTrouveThermos.pNumero = null
      RequêteTrouveThermos.pComposant1 = null
      RequêteTrouveThermos.pComposant2 = null
      RequêteTrouveThermos.pComposant3 = null
      si SansEspace(fdetail.fdnumprod) <> "" alors
      	RequêteTrouveThermos.pNumero = fdetail.fdnumprod	
      sinon
      	RequêteTrouveThermos.pComposant1 = fdetail.fdcomposant1
      	RequêteTrouveThermos.pComposant2 = fdetail.fdcomposant2
      	RequêteTrouveThermos.pComposant3 = fdetail.fdcomposant3
      
      FIN
      hexecuterequete(RequêteTrouveThermos)
      si hnbenr(RequêteTrouveThermos) <> 0 alors
      	HLitPremier(RequêteTrouveThermos)
      	valeuraretourner = RequêteTrouveThermos.OrdreTrtXopt+","+RequêteTrouveThermos.nbThermosPArRack
      FIN
      
      renvoyer valeuraretourner
     type : 458752
   -
     name : Remplirfdetailtempocc
     procedure_id : 5869998776834319448
     type_code : 14
     code : |1-
      Procédure Remplirfdetailtempocc()
      j est un entier
      i est un entier
      Dimensiontempo est un reel
      PositionEnCours est un entier
      TotQte est un entier = 0
      _debut est un booleen = vrai
      _energiverre est un booleen 
      _DimensionBase est un reel = config.DimensionAverifierPrep
      Carrelage est un booleen = vrai
      
      
      _TypeDeDimensionEnCours est une chaine 
      _DimensionEnCours est un entier
      _QteDimensionEnCours est un entier
      
      ouvrefille("FENJAUGE","Préparation des tables")
      
      
      
      pour j = 1 a tableoccurrence("TABLE1")
      	_positionjauge++
      	si _positionJauge  > 100 alors
      		_positionjauge=1	
      	FIN
      	execute("fenjauge.progression",_positionJauge)
      	si crochet[j] alors
      		hlitrecherche("Facture","fanumero",commande[j])
      		si HErreurBlocage() alors
      			erreur("la commande "+commande[j])
      		FIN
      		si hlitrecherche(facture,fanumero,TABLE1.COMMANDE[j]) alors
      			//info(facture.fanumero)
      		fin
      
      		hlitrecherche(fdetail,fdnocommfdligne,hconstruitvalcle(fdetail,fdnocommfdligne,facture.fanumero,1))
      		//		hlitrecherche(fdetail,fdcle,hconstruitvalcle(fdetail,fdcle,facture.fanumero))
      
      		si HErreurBlocage() alors
      			erreur("la commande "+commande[j]+ " ne peut pas etre traitée")
      			ferme("FENJAUGE")
      			renvoyer faux
      		FIN
      
      		tantque fdetail.fdnocomm = facture.fanumero et pas HEnDehors()
      			SI sansespace(fdetail.fdcomposant1) = "" et sansespace(fdetail.fdcomposant2) = "" et sansespace(fdetail.fdcomposant3) = "" alors  	
      			sinon
      			si fdetail.fdcarrelage <> Carrelage alors goto LireRecordSuivant
      			 
      				hraz(fdetailtempoc)
      
      				fdetailtempoc.fdnocomm = fdetail.fdnocomm
      				fdetailtempoc.fdligne = fdetail.fdligne
      				fdetailtempoc.fEspace = fdetail.fdespace
      				fdetailtempoc.tqte = Fdetail.fdqteafacturer+fdetail.fdqtedejafacture
      				fdetailtempoc.tenergiverre = fdetail.fdenergiverre
      				fdetailtempoc.tnothermos = fdetail.fdnumprod
      				fdetailtempoc.fQteTotal = total[j]
      
      //				si sansespace(fdetail.fdforme) <> "" alors
      //					fdetailtempoc.fEspaceTri = 9999
      //					fdetailtempoc.fNoForme = "X"
      //				sinon
      //					fdetailtempoc.fNoForme = " "
      //				FIN
      
      				SI facture.facalcul = 1 alors 
      					fdetailtempoc.HAUTEUR = numeriqueverschaine(val(fdetail.fdhauteur)/12 * 0.3048 * 1000,"7.2f")
      					fdetailtempoc.LARGEUR = numeriqueverschaine(val(fdetail.fdlargeur)/12 * 0.3048 * 1000,"7.2f")
      					fdetailtempoc.tHAUTEURreelle = numeriqueverschaine(val(fdetail.fdhauteur)/12 * 0.3048 * 1000,"7.2f")
      					fdetailtempoc.tLARGEURreelle = numeriqueverschaine(val(fdetail.fdlargeur)/12 * 0.3048 * 1000,"7.2f")
      				sinon
      					fdetailtempoc.HAUTEUR = NumeriqueVersChaine(val(fdetail.fdhauteur) * 1000)
      					fdetailtempoc.LARGEUR = NumeriqueVersChaine(val(fdetail.fdlargeur) * 1000)
      					fdetailtempoc.tHAUTEURreelle = NumeriqueVersChaine(val(fdetail.fdhauteur) * 1000)
      					fdetailtempoc.tLARGEURreelle = NumeriqueVersChaine(val(fdetail.fdlargeur) * 1000)
      				fin
      				si fdetailtempoc.largeur > fdetailtempoc.hauteur alors
      					Dimensiontempo = fdetailtempoc.hauteur
      					fdetailtempoc.HAUTEUR = fdetailtempoc.LARGEUR
      					fdetailtempoc.LARGEUR = Dimensiontempo
      				FIN
      				si fdetailtempoc.Largeur < _DimensionBase alors
      					si fdetailtempoc.tqte < config.MaxQteClair1300moins alors
      						fdetailtempoc.fespacetri = 9000
      					FIN
      				sinon
      					si fdetailtempoc.tqte < config.MaxQteClair1300plus alors
      						fdetailtempoc.fespacetri = 9000
      					FIN
      
      		
      				fin
      
      				si (sansespace(fdetail.fdespace) = "750" ou val(fdetail.fdespace <= 375)) et ...
      					(  fdetailtempoc.Largeur < _DimensionBase et pas fdetailtempoc.tqte < config.MaxQteClair1300moins)  et...
      					( fdetailtempoc.Largeur > _DimensionBase et pas  fdetailtempoc.tqte < config.MaxQteClair1300plus) alors
      					
      					fdetailtempoc.fEspaceTri = 9998
      				sinon
      					//						si fdetail.fdqte < config.MaxQteClair1300Plus alors
      					//					fdetailtempoc.fespacetri = 9000
      				fin
      				si sansespace(fdetail.fdforme) <> "" alors
      					fdetailtempoc.fEspaceTri = 9999
      					fdetailtempoc.fNoForme = "X"
      				FIN
      				
      				hajoute(fdetailtempoc)
      				si pas lher alors
      					si fdetail.fdenergiverre alors
      						lher = vrai
      					fin	
      				fin
      			fin
      		LireRecordSuivant:
      			
      			hlitsuivant(fdetail,fdnocommfdligne)
      		fin
      		facture.fpreparation = "T"
      		//	facture.livrepartiel = " "
      		facture.FImprimeFeuille = vrai
      		hmodifie("Facture")
      	fin
      
      fin
      
      
      
      
      
      TriIdentique()
      _groupe = 101
      
      boucle
      	si TriAutrePlus() = 0 alors sortir
      fin
      
      
      VerifieRejetPlus()
      
      //TriAutrePlus1()
      _groupe = 201
      
      boucle
      	si triautremoins() = 0 alors sortir
      fin
      //VerifieRejetMoins()
      
      VerifieRejetMoins()
      
      Verifierejetmoins(Vrai)
      
      VerifieRejetMoinsEntreEux()
      _groupe = 301
      
      boucle
      	si TriAutrePlus(9998) = 0 alors sortir
      fin
      _groupe = 401
      
      boucle
      	si triautremoins(9998) = 0 alors sortir
      fin
      
      VerifieRejetMoins9998()
      
      
      VerifieRejetMoins9998EntreEux()
      oldgroupe est une chaine
      
      Hlitpremier(fdetailtempoc,"fEspaceTriTposition")
      _DimensionEnCours =  fdetailtempoc.HAUTEUR
      _QteDimensionEnCours = 0
      
      tantque pas hendehors(fdetailtempoc)
      	si fdetailtempoc.tqte < 10 et fdetailtempoc.tgroupe = 0 et pas fdetailtempoc.fEspaceTri = 9999 alors
      		si fdetailtempoc.HAUTEUR <= _DimensionBase alors
      			si _TypeDeDimensionEnCours = "" alors 
      				_TypeDeDimensionEnCours ="Petit"
      			fin
      			//			si fdetailtempoc.HAUTEUR = _DimensionEnCours et _maxTableHERPlusPetitSiPareil <> 0 alors
      			si (_TypeDeDimensionEnCours = "Grand" et TotQte+fdetailtempoc.tqte > lMaxQtePlus) ou TotQte+fdetailtempoc.tqte > lMaxQteMoins  alors
      				//				si totqte+fdetailtempoc.tqte > _maximummoins ou _TypeDeDimensionEnCours = "Grand" alors
      				TotQte=fdetailtempoc.tqte
      				cpt++
      				PositionEnCours = 1
      				fdetailtempoc.tnotable = cpt
      				fdetailtempoc.tposition = PositionEnCours
      				hmodifie(fdetailtempoc,hNumEnrEnCours)
      				si _TypeDeDimensionEnCours = "Grand" alors
      					_TypeDeDimensionEnCours = "Petit"
      				FIN	
      
      			sinon
      				PositionEnCours++
      				fdetailtempoc.tposition = PositionEnCours
      				TotQte+=fdetailtempoc.tqte
      				fdetailtempoc.tnotable = cpt
      				hmodifie(fdetailtempoc,hNumEnrEnCours)
      			fin
      
      		sinon
      			si _TypeDeDimensionEnCours = "" alors 
      				_TypeDeDimensionEnCours ="Grand"
      			fin
      
      			Si TotQte+fdetailtempoc.tqte > lMaxQtePlus ou _TypeDeDimensionEnCours = "Petit" alors
      				cpt++
      				PositionEnCours=1
      				TotQte=fdetailtempoc.tqte
      				fdetailtempoc.tnotable = cpt
      				fdetailtempoc.tposition = PositionEnCours
      				hmodifie(fdetailtempoc,hNumEnrEnCours)
      				si _TypeDeDimensionEnCours = "Petit" alors
      					_TypeDeDimensionEnCours = "Grand"
      				FIN
      			sinon
      				PositionEnCours++
      				TotQte+=fdetailtempoc.tqte
      				fdetailtempoc.tnotable = cpt
      				fdetailtempoc.tposition = PositionEnCours
      				hmodifie(fdetailtempoc,hNumEnrEnCours)
      			fin			  	
      		fin
      		hlitsuivant(fdetailtempoc,"fEspaceTriTposition")
      	sinon si fdetailtempoc.tgroupe <> 0
      		oldgroupe =  fdetailtempoc.tgroupe 
      
      		tantque fdetailtempoc.tgroupe = oldgroupe et pas hendehors(fdetailtempoc)
      			PositionEnCours++
      			fdetailtempoc.tnotable = cpt
      			hmodifie(fdetailtempoc,hNumEnrEnCours)
      			hlitsuivant(fdetailtempoc,"fEspaceTriTposition")
      
      		fin
      		cpt++
      	sinon
      		fdetailtempoc.tnotable = cpt
      		fdetailtempoc.Tposition = 1
      		hmodifie(fdetailtempoc,hNumEnrEnCours)
      		cpt++
      		hlitsuivant(fdetailtempoc,"fEspaceTriTposition")
      	fin
      
      
      FIN
      
      cpt+=1
      
      
      ferme(fenjauge)
      
      //ExécuteTraitement(Bouton15,trtClic)
     type : 458752
   -
     name : TriFdetailTempo
     procedure_id : 5870005433912231731
     type_code : 14
     code : |1+
      Procédure TriFdetailTempo(lJauge est un champ = null)
      j est un entier = 1
      nombre est un entier = HNbEnr(Fdetailtempo)
      //hlitpremier(Fdetailtempo,fEspaceTriTposition)
      //HLitPremier(Fdetailtempo,TNoTableTposition)
      HLitPremier(Fdetailtempo)
      
      tantque pas HEnDehors(Fdetailtempo)
      	_positionJauge++
      	SI _positionJauge  > 100 ALORS
      		_positionJauge=1	
      	FIN
      	hlitrecherche(Fdetail,fdnocommfdligne,HConstruitValClé(Fdetail,fdnocommfdligne,Fdetailtempo.fdnocomm,Fdetailtempo.fdligne))
      	hlitrecherche(facture,fanumero,fdetail.fdnocomm)
      	valide_composant()
      
      
      	si fdetail.fdlien = 0 alors
      		AjouterTableau(1,fdetail.fdnumprod,fdetail.fdlargeura,fdetail.fdhauteura,"",fdetail.fddesc,facture.facalcul,fdetail.fdqteafacturer)
      	sinon si fdetail.fdlien = fdetail.fdligne alors
      		AjouterTableau(1,fdetail.fdnumprod,fdetail.fdlargeura,fdetail.fdhauteura,"",fdetail.fddesc,facture.facalcul,fdetail.fdqteafacturer)
      	sinon
      		AjouterTableau(2,fdetail.fdnumprod,fdetail.fdcarreauv,fdetail.fdcarreauh,fdetail.fdtypecalcul,fdetail.fddesc,facture.facalcul,fdetail.fdqteafacturer)
      	fin
      
      
      	HLitSuivant(Fdetailtempo)
      
      	si HErreurBlocage() alors
      	FIN
      
      FIN
     type : 458752
   -
     name : TriFdetailTempoc
     procedure_id : 5870005789322300427
     type_code : 14
     code : |1+
      Procédure TriFdetailTempoc()
      j est un entier = 1
      nombre est un entier = HNbEnr(Fdetailtempoc)
      
      hlitpremier(Fdetailtempoc,"fEspaceTriTposition")
      
      tantque pas HEnDehors(Fdetailtempoc)
      	j++
      	execute("fenjauge.progression",j/nombre * 100)
      
      	hlitrecherche(Fdetail,fdnocommfdligne,HConstruitValClé(Fdetail,fdnocommfdligne,Fdetailtempoc.fdnocomm,Fdetailtempoc.fdligne))
      	hlitrecherche(facture,fanumero,fdetail.fdnocomm)
      	valide_composant()
      	//			si cptdepart > config.MaxCase alors
      	//				info(cptdepart)
      	//				acso_message("Erreur","Vous dépassez le nombre maximum de case","Erreur")
      	//				hexecuterequete(RequeteSecteurPrepare,hModifieFichier)
      	//                pour tout RequeteSecteurPrepare
      	//                    RequeteSecteurPrepare.FPREPARATION = ""
      	//                    hModifie(RequeteSecteurPrepare,hNumEnrEnCours)
      	//                fin
      	//         	
      	//				ferme(fenjauge)
      	//				renvoyer faux
      	//			FIN
      
      	si fdetail.fdlien = 0 alors
      		AjouterTableau(1,fdetail.fdnumprod,fdetail.fdlargeura,fdetail.fdhauteura,"",fdetail.fddesc,facture.facalcul,fdetail.fdqteafacturer)
      	sinon si fdetail.fdlien = fdetail.fdligne alors
      		AjouterTableau(1,fdetail.fdnumprod,fdetail.fdlargeura,fdetail.fdhauteura,"",fdetail.fddesc,facture.facalcul,fdetail.fdqteafacturer)
      	sinon
      		AjouterTableau(2,fdetail.fdnumprod,fdetail.fdcarreauv,fdetail.fdcarreauh,fdetail.fdtypecalcul,fdetail.fddesc,facture.facalcul,fdetail.fdqteafacturer)
      	fin
      
      
      	//	hlitsuivant(Fdetailtempo,Tposition)
      	hlitsuivant(Fdetailtempoc,"fEspaceTriTposition")
      	//	hlitsuivant(Fdetailtempo,fEspaceTri)
      	si HErreurBlocage() alors
      	FIN
      
      FIN
      
