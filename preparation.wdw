     x : 730
     y : 261
     width : 137
     height : 27
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         j est un entier
         csnCommande = 0
         pour j = 1 to tableoccurrence("TABLE1")
         	csncommande++
         	si pas crochet[j] alors
         		
         		calculrack(table1.COMMANDE[j],"Plus")
         	fin
         	crochet[j] = Vrai
         	
         FIN
         Message("Nombre de commandes traitées " + csnCommande)
        type : 18
      -
        type : 161
        enabled : false
