      Procédure FactureEstHER(lNumero)
      valeuraretourner est un booleen = faux
      
      si hlitrecherche(facture,fanumero,lNumero) alors
      	pour tout fdetail avec "fdetail.fdnocomm = "+facture.fanumero
      		si fdetail.fdenergiverre alors
      			valeuraretourner = vrai
      			sortir
      		FIN
      	FIN
      FIN
      
      renvoyer valeuraretourner
     type : 458752
   -
     name : TriDeux1
     procedure_id : 5390231618815628733
     type_code : 14
     code : |1+
      procedure TriDeux1(ecartHauteur = 50,ecartLargeur=100,lqteMaximum=6,lespacetri=0)
      //fdetailtempotri est une source de donnees
      //halias(Fdetailtempo,fdetailtempotri)
      //hcreation(fdetailtempotri)
      maxClairPetit est un entier = 12
      maxClairGrand est un entier = 8
      MaxClair est une entier 
      //fid est un entier = fcree("C:\ordre.txt")
      i est un entier
      lnorec est un entier
      lhauteurcourant est un reel
      llargeurcourant est un reel
      ltricourant est un entier
      ltrisuivant est un entier
      lChangement est un entier = 0
      lDifferenceLargeur est un reel = 0
      lTotalDimension est un reel = 0
      lNoRecAConserver est un entier
      lNoRecCourant est un entier
      isNoDiffere est un booleen
      lqte est un entier = 0
      
      
      pour tout Fdetailtempo sur HAUTEURLARGEURfNoForme
      	i++
      	fdetailtempo.tposition = i
      	fdetailtempo.tpositiontempo = i
      	HModifie(Fdetailtempo,hNumEnrEnCours)
      FIN
      i=1
      boucle
      	hlitpremier(Fdetailtempo,tposition)
      	tantque pas Fdetailtempo.differe ET FDETAILTEMPO.fEspaceTri = lespacetri
      		HLitSuivant(Fdetailtempo,Tposition)
      	FIN
      	si hendehors(Fdetailtempo) alors
      		sortir
      	FIN
      	lhauteurcourant = Fdetailtempo.HAUTEUR
      	llargeurcourant = Fdetailtempo.LARGEUR
      	lnouveau est un booleen = vrai
      	lTotalDimension = Fdetailtempo.LARGEUR + Fdetailtempo.HAUTEUR
      	Fdetailtempo.Differe = faux
      	fdetailtempo.Deleted = vrai
      	hmodifie(Fdetailtempo,hNumEnrEnCours)
      	lNoRecCourant = HNumEnr(Fdetailtempo)
      	lNoRecAConserver=0
      	gposition++
      	HCopieEnreg(Fdetailtempotri,Fdetailtempo)
      	fdetailtempotri.tposition = gposition
      	si Fdetailtempo.tqte = 6 alors
      		fdetailtempotri.rupture = vrai
      	sinon
      		fdetailtempotri.rupture = faux
      	FIN
      	hajoute(Fdetailtempotri)
      
      	fEcritLigne(fid,Fdetailtempo.fdnocomm+"-"+Fdetailtempo.fdligne+","+Fdetailtempo.HAUTEUR+"X"+Fdetailtempo.LARGEUR+" ( "+fdetailtempo.tqte +" ) ")
      	lqte=Fdetailtempo.tqte
      	isNoDiffere = vrai
      	pour tout Fdetailtempo
      		si Fdetailtempo.differe alors
      			isNoDiffere = faux
      			sortir
      		FIN
      	fin
      	si isNoDiffere alors
      		sortir
      	fin	
      	boucle
      		i++
      		message("Passage :"+i)
      		lChangement=0
      
      		hlitpremier(Fdetailtempo,tposition)
      		lDifferenceLargeur  = 10000
      
      		tantque pas HEnDehors(Fdetailtempo)
      			si Fdetailtempo.differe et pas HNumEnr(Fdetailtempo) = lNoRecCourant ET FDETAILTEMPO.fEspaceTri = lespacetri alors
      				//			si abs(lhauteurcourant - Fdetailtempo.HAUTEUR)   <= 50  alors //et lhauteurcourant - Fdetailtempo.HAUTEUR >= 0 alors
      	//			si Fdetailtempo.hauteur+Fdetailtempo.LARGEUR < lTotalDimension alors
      				si Fdetailtempo.hauteur+Fdetailtempo.LARGEUR < lTotalDimension  ou abs((Fdetailtempo.hauteur+Fdetailtempo.LARGEUR)- lTotalDimension) < (ecartLargeur*1.5) alors
      						si abs(Fdetailtempo.hauteur-lhauteurcourant)+abs(fdetailtempo.largeur - llargeurcourant) < lDifferenceLargeur alors
      						si abs(fdetailtempo.largeur - llargeurcourant) < ecartLargeur ou fdetailtempo.largeur < llargeurcourant alors
      							lDifferenceLargeur  = abs(Fdetailtempo.hauteur-lhauteurcourant)+abs(fdetailtempo.largeur - llargeurcourant) 
      							lNoRecAConserver = HNumEnr(Fdetailtempo)
      						fin
      					fin
      				FIN
      			fin
      			HLitSuivant(Fdetailtempo,tposition)
      		FIN
            si lNoRecAConserver = 0 alors
      		hlitpremier(Fdetailtempo,tposition)
      		tantque pas Fdetailtempo.differe ET FDETAILTEMPO.fEspaceTri = lespacetri
      			HLitSuivant(Fdetailtempo,Tposition)
      		FIN
      		lhauteurcourant = Fdetailtempo.HAUTEUR
      		llargeurcourant = Fdetailtempo.LARGEUR
      		lNoRecCourant = HNumEnr(Fdetailtempo)
      //		lnorecaconserver = HNumEnr(Fdetailtempo)
      		lTotalDimension = Fdetailtempo.LARGEUR + Fdetailtempo.HAUTEUR
      		lqte=0
      		lnouveau = vrai
      		Fdetailtempotri.rupture = vrai
      		hmodifie(fdetailtempotri,hNumEnrEnCours)
      		
      		sortir
             fin
             
      		hlit(Fdetailtempo,lNoRecAConserver)
      
      		si lqte+Fdetailtempo.tqte > 6 alors
      
      			si 6 - lqte > 0 alors
      				gposition++
      				HCopieEnreg(Fdetailtempotri,Fdetailtempo)
      				fdetailtempotri.tposition = gposition
      //				fdetailtempotri.rupture = faux
      				Fdetailtempotri.tqte = (6-lqte)
      				fdetailtempotri.rupture= vrai
      				hajoute(Fdetailtempotri)
      				Fdetailtempo.tqte -= (6-lqte)
      				hmodifie(Fdetailtempo,hNumEnrEnCours)
      			FIN
      			fEcritLigne(fid,Fdetailtempo.fdnocomm+"-"+Fdetailtempo.fdligne+","+Fdetailtempo.HAUTEUR+"X"+Fdetailtempo.LARGEUR+" ( "+(6-lqte) +" ) ")
      			fEcritLigne(fid,"********** FIN *******************")
      			//            hlitdernier(Fdetailtempotri,"tposition")
      			//            fdetailtempotri.rupture = vrai
      			//            hmodifie(Fdetailtempotri,hNumEnrEnCours)
      			hlitpremier(Fdetailtempo,tposition)
      			tantque pas Fdetailtempo.differe ET FDETAILTEMPO.fEspaceTri = lespacetri
      				HLitSuivant(Fdetailtempo,Tposition)
      			FIN
      			lhauteurcourant = Fdetailtempo.HAUTEUR
      			llargeurcourant = Fdetailtempo.LARGEUR
      			lNoRecCourant = HNumEnr(Fdetailtempo)
      			lTotalDimension = Fdetailtempo.LARGEUR + Fdetailtempo.HAUTEUR
      			lqte=0
      			lnouveau = vrai
      			sortir
      		fin	
      		Fdetailtempo.differe = faux
      		Fdetailtempo.deleted = vrai
      		lqte+=Fdetailtempo.tqte
      		hmodifie(Fdetailtempo,hNumEnrEnCours)
      		lhauteurcourant = Fdetailtempo.HAUTEUR
      		llargeurcourant = Fdetailtempo.LARGEUR
      		lTotalDimension = Fdetailtempo.LARGEUR + Fdetailtempo.HAUTEUR
      		lNoRecCourant = HNumEnr(Fdetailtempo)
      		//		si lNoRecAConserver <> HNumEnr(Fdetailtempo) alors
      		gposition++
      		HCopieEnreg(Fdetailtempotri,Fdetailtempo)
      		fdetailtempotri.tposition = gposition
      		si lqte = 6 alors
      			fdetailtempotri.rupture = vrai
      		sinon	
      			fdetailtempotri.rupture = faux
      		fin
      		hajoute(Fdetailtempotri)
      		fEcritLigne(fid,Fdetailtempo.fdnocomm+"-"+Fdetailtempo.fdligne+","+Fdetailtempo.HAUTEUR+"X"+Fdetailtempo.LARGEUR+" ( "+lqte +" ) ")
      		//		fin
      		//	hsupprime(Fdetailtempo,hNumEnrEnCours)
      		isNoDiffere = vrai
      		lNoRecAConserver = 0
      		pour tout Fdetailtempo
      			si Fdetailtempo.differe alors
      				isNoDiffere = faux
      				sortir
      			FIN
      		fin
      		si isNoDiffere alors
      			sortir
      		fin	
      	fin
      	si isNoDiffere alors
      		fEcritLigne(fid,"********** FIN *******************")
      		sortir
      	fin	
      
      
      
      fin
      hlitdernier(Fdetailtempotri,"tposition")
      fdetailtempotri.rupture = vrai
      hmodifie(Fdetailtempotri,hNumEnrEnCours)
     type : 458752
   -
     name : TriIdentique
     procedure_id : 5612499887723538004
     type_code : 14
     code : |1+
      Procédure TriIdentique(_constanteaajouter = 0)
      TableauQte est un tableau dynamique de 0 par 3 entier
      i est un entier = 0
      t est un entier
      formula est une chaine
      objectif est une chaine
      solution est une chaine
      _message est une chaine
      _groupe est un entier = 0
      _max est une chaine = "max : "
      _formula est une chaine
      _Init1 est une chaine 
      _Int est une chaine= "int "
      _ldebut est un booleen = vrai
      _maxParTable est un entier = config.MaxQteTableSiIdentique
      TotQte est un entier = 0
      TotQteCourante est un entier
      
      RequeteFdetailIdentique.pDimension = config.DimensionAverifierPrep
      RequeteFdetailIdentique.pQteTable = config.MaxQteClair1300Moins
      RequeteFdetailIdentique.pQteTableSiIdentique = config.MaxQteTableSiIdentique
      HExécuteRequête(RequeteFdetailIdentique)
      
      
      
      pour tout RequeteFdetailIdentique
      	_positionjauge++
      	si _positionJauge  > 100 alors
      		_positionjauge=1	
      	FIN
      	execute("fenjauge.progression",_positionJauge)
      	//	Boucle
      	TableauQte = allouer un tableau dynamique de 0 par 3 entier
      	TotQte = 0
      	pour tout Fdetailtempo avec "HAUTEUR = " + RequeteFdetailIdentique.HAUTEUR +" et LARGEUR = " + RequeteFdetailIdentique.LARGEUR
      		i++
      		dimension(TableauQte,i,3)
      		TableauQte[i,1] = Fdetailtempo.tqte
      		TableauQte[i,2] = fdetailtempo.IDFdetailtempo
      		TableauQte[i,3] = 0
      	FIN
      	boucle
      		_max = "max : "
      		_formula =""
      		_Init1 =""
      		_Int = "int "
      		_ldebut  = vrai
      		_groupe+=1
      		TotQteCourante = 0
      		pour t = 1 a dimension(TableauQte)/3
      			si pas TableauQte[t,3] alors
      				si pas _ldebut alors  
      					_max += " + x"+NumériqueVersChaine(t) 
      					_formula  +="+ " + NumériqueVersChaine(TableauQte[t,1])+ " x"+NumériqueVersChaine(t)
      					_Int+= ","+ "x"+NumériqueVersChaine(t)
      				sinon  
      					_ldebut = faux
      					_max += " x"+NumériqueVersChaine(t)
      					_formula  += NumériqueVersChaine(TableauQte[t,1])+ " x"+NumériqueVersChaine(t)
      					_Int+= "x"+NumériqueVersChaine(t)
      				fin
      				_Init1 += "x"+NumériqueVersChaine(t)+ "<=1;"+rc
      			fin
      		FIN
      		_max += ";"
      		_formula+= " <= " + NumériqueVersChaine(config.MaxQteTableSiIdentique)+";"
      		_Int+=";"
      
      		formula = _max+rc+rc+_formula+rc+_Init1+rc+_Int+rc
      
      		si LPSolveResoudre(formula,objectif,solution,_message) alors
      			pour  i  =1 a chaineoccurrence(solution,RC)
      				si extraitchaine(extraitchaine(solution,i,rc),2,tab) <> 0 alors
      					si hlitrecherche(fdetailtempo,IDFdetailtempo,TableauQte[extraitchaine(extraitchaine(solution,i,rc),1,tab)[[2 a ]],2]) alors
      						TableauQte[extraitchaine(extraitchaine(solution,i,rc),1,tab)[[2 a ]],3] = vrai
      						Fdetailtempo.fEspaceTri = 500+_groupe
      						Fdetailtempo.tGroupe = _groupe
      						TotQte+=fdetailtempo.tqte
      						hmodifie(Fdetailtempo,hNumEnrEnCours)
      					FIN
      
      				FIN
      			FIN
      
      		FIN
      		
      		
              si pas RequeteFdetailIdentique.la_somme_tqte - TotQte > config.MaxQteClair1300Moins alors
                sortir
              fin
              	
      	fin
      
      Fin
      
      
      
     type : 458752
   -
     name : LPSolveResoudre
     procedure_id : 5612556744147499275
     type_code : 14
     code : |1+
      PROCEDURE LPSolveResoudre(sFormulationLP, pnObjectif, psSolution, psMessage)
      
      // Variables
      nInstanceDLL est un entier systeme
      
      nLP		     est un entier sur 8 octet
      sNomPL	     est une chaine 
      nRésolution  est un entier sur 8 octets
      sLig		 est une chaine
      sSol		 est une chaine
      bDébutSolOk  est un booléen
      
      // Initialisation
      sNomPL = <§$0001§>
      nInstanceDLL = ChargeDLL(DLL_NOM)
      bDébutSolOk = Faux
      
      // Chargement de la DLL LpSolve
      SI nInstanceDLL = 0 ALORS
      	psMessage = <§$0002§>+DLL_NOM
      	RENVOYER Faux
      FIN
      
      // Récupération de noms de fichiers temporaires pour la résolution du problème
      gsFichierLP  = fFichierTemp("FLP", fRepExe()) // Fichier contenant la Formulation du Problème Linéaire
      gsFichierLOG = fFichierTemp("LOG", fRepExe()) // Fichier contenant la log d'exécution des fonctions de la DLL lpsolve55.dll
      gsFichierSOL = fFichierTemp("SOL", fRepExe()) // Fichier contenant la solution trouvée par la fonction lpsolve de la DLL lpsolve55.dll
      
      // On sauvegarde la formulation dans le fichier qui sera lu par la fonction read_LP
      fSauveTexte(gsFichierLP, sFormulationLP)
      
      // Chargement du problème linaire
      nLP = API(DLL_NOM, "read_LP", gsFichierLP, CST_VERBOSE_NORMAL, sNomPL)
      SI nLP = 0 ALORS
      	psMessage = <§$0003§>+RC+<§$0004§>
      	RENVOYER Faux
      FIN
      
      // On définit le fichier de log pour les fonctions de la DLL LP Solve
      API(DLL_NOM, "set_outputfile", nLP, gsFichierLOG)
      
      // Résolution du problème
      nRésolution = API(DLL_NOM, "solve", nLP)
      
      SELON nRésolution
      	CAS CST_RES_NOMEMORY
      		psMessage = <§$0005§>
      		RENVOYER Faux
      		
      	CAS CST_RES_OPTIMAL			
      		psMessage = <§$0006§>
      		
      	CAS CST_RES_SUBOPTIMAL
      		psMessage = <§$0007§>
      		
      	CAS CST_RES_INFEASIBLE		
      		psMessage = <§$0008§>
      		RENVOYER Faux
      		
      	CAS CST_RES_UNBOUNDED	
      		psMessage = <§$0009§>
      		RENVOYER Faux
      		
      	CAS CST_RES_DEGENERATE	
      		psMessage = <§$000a§>
      		RENVOYER Faux
      		
      	CAS CST_RES_NUMFAILURE	
      		psMessage = <§$000b§>
      		RENVOYER Faux
      		
      	CAS CST_RES_USERABORT	
      		psMessage = <§$000c§>
      		RENVOYER Faux
      		
      	CAS CST_RES_TIMEOUT		
      		psMessage = <§$000d§>
      		
      	CAS CST_RES_FEASFOUND	
      		psMessage = <§$000e§>
      		
      	CAS CST_RES_NOFEASFOUND		
      		psMessage = <§$000f§>
      		RENVOYER Faux
      FIN
      
      // On définit le fichier qui contient la solution
      API(DLL_NOM, "set_outputfile", nLP, gsFichierSOL)
      API(DLL_NOM, "print_objective", nLP)
      API(DLL_NOM, "print_solution", nLP, 1)
      
      // On parcours le fichier de solution pour afficher les valeurs dans l'application
      sSol = fChargeTexte(gsFichierSOL)
      psSolution = ""
      i est un entier = 1
      tantque sLig <> eot
      	sLig = ExtraitChaîne(sSol,i,rc)
      	si sLig = eot alors sortir
      	SI sLig [= "Value of objective function:" ALORS
      		pnObjectif = Val(sLig[[Taille("Value of objective function:")+1 A ]])
      	SINON SI sLig [= "Actual values of the variables:" ALORS
      		bDébutSolOk = Vrai
      	SINON SI bDébutSolOk
      		sVar est une chaine	= ExtraitChaîne(sLig, 1, " ")
      		SI sVar<>"" ALORS
      			nVal est un entier	= val(SansEspace(sLig[[taille(sVar)+1 a ]]))
      			psSolution += sVar + TAB + nVal +rc
      		FIN
      	FIN
      	i++
      FIN
      
      
      SI nLP <> 0 ALORS
      	API(DLL_NOM, "set_outputfile", nLP, "") //Ferme le fichier de sortie pour pouvoir le supprimer
      	fSupprime(gsFichierLP,frLectureSeule)
      	fSupprime(gsFichierLOG,frLectureSeule)
      	fSupprime(gsFichierSOL,frLectureSeule)
      FIN
      DéchargeDLL(nInstanceDLL)
      
      
      RENVOYER Vrai
      
      
      //FIN:
      //
      ////Suppression des fichiers temporaires
      //SI nLP <> 0 ALORS
      //	API(DLL_NOM, "set_outputfile", nLP, "") //Ferme le fichier de sortie pour pouvoir le supprimer
      //	fSupprime(gsFichierLP,frLectureSeule)
      //	fSupprime(gsFichierLOG,frLectureSeule)
      //	fSupprime(gsFichierSOL,frLectureSeule)
      //FIN
      //DéchargeDLL(nInstanceDLL)
      
     type : 458752
   -
     name : TriAutrePlus1
     procedure_id : 5612883673282251656
     type_code : 14
     code : |1+
      Procédure TriAutrePlus1()
      TableauQte est un tableau dynamique de 0 par 6 entier
      PositionEncours est un entier
      TableauRejet est un tableau dynamique de 0 par 6 entier
      t est un entier = 0
      r est un entier = 0
      _DimensionBase est un reel = config.DimensionAverifierPrep
      _groupe est un entier = 101
      totqte est un entier = 0
      pour tout Fdetailtempo SUR HAUTEURLARGEURfNoForme
      	si fdetailtempo.fEspaceTri = 9000  et Fdetailtempo.HAUTEUR > _DimensionBase et fdetailtempo.TNoTable = 0 alors
      		t++
      		dimension(TableauQte,t,6)
      		TableauQte[t,1] = Fdetailtempo.tqte
      		TableauQte[t,2] = fdetailtempo.IDFdetailtempo
      		TableauQte[t,3] = 0
      		TableauQte[t,4] = fdetailtempo.HAUTEUR
      		TableauQte[t,5] = fdetailtempo.LARGEUR
      
      	FIN
      fin
      
      pour t = 1 a dimension(TableauQte)/6
      	_positionjauge++
      	si _positionJauge  > 100 alors
      		_positionjauge=1	
      	FIN
      	execute("fenjauge.progression",_positionJauge)
      	si TableauQte[t,3] = 0 alors
      		si t <> dimension(TableauQte)/6 alors
      			si (TableauQte[t,4] < TableauQte[t+1,4] et (TableauQte[t+1,4] - TableauQte[t,4] > EcartToleranceHauteur)) ou (TableauQte[t,5] < TableauQte[t+1,5] et (TableauQte[t+1,5] - TableauQte[t,5] > EcartToleranceHauteur)) alors
      				r++
      				dimension(TableauRejet,r,6)
      				TableauRejet[r,1] = TableauQte[t,1]
      				TableauRejet[r,2] = TableauQte[t,2]
      				TableauRejet[r,3] = TableauQte[t,3]
      				TableauRejet[r,4] = TableauQte[t,4]
      				TableauRejet[r,5] = TableauQte[t,5]
      				TableauRejet[r,6] = TableauQte[t,6]
      
      
      			sinon
      				si hlitrecherche(Fdetailtempo,IDFdetailtempo,TableauQte[t,2]) alors
      					Si totqte+Fdetailtempo.tqte > lMaxQtePlus  alors
      						//verifieRejet(tableauRejet,tableauqte[t-1,4],tableauqte[t-1,5],totqte,_groupe)
      						_groupe+=1
      						PositionEncours = 1
      						totqte=Fdetailtempo.tqte
      						Fdetailtempo.fEspaceTri = 600+_groupe
      						Fdetailtempo.tGroupe = _groupe
      						Fdetailtempo.Tposition = PositionEncours
      						hmodifie(Fdetailtempo,hNumEnrEnCours)
      
      					sinon
      					    PositionEncours++
      						Fdetailtempo.fEspaceTri = 600+_groupe
      						Fdetailtempo.tGroupe = _groupe				
      						Fdetailtempo.Tposition = PositionEncours
      						totqte+=Fdetailtempo.tqte
      
      						hmodifie(Fdetailtempo,hNumEnrEnCours)
      					fin			  	
      
      				fin
      
      
      			FIN
      		sinon
      			si hlitrecherche(Fdetailtempo,IDFdetailtempo,TableauQte[t,2]) alors
      				Si totqte+Fdetailtempo.tqte > lMaxQtePlus  alors
      				//	verifieRejet(tableauRejet,tableauqte[t-1,4],tableauqte[t-1,5],totqte,_groupe)
      					_groupe+=1
      					PositionEncours = 1
      					totqte=Fdetailtempo.tqte
      					Fdetailtempo.fEspaceTri = 600+_groupe
      					Fdetailtempo.tGroupe = _groupe
      					Fdetailtempo.Tposition = PositionEncours
      					hmodifie(Fdetailtempo,hNumEnrEnCours)
      
      				sinon
      					PositionEncours++
      					Fdetailtempo.fEspaceTri = 600+_groupe
      					Fdetailtempo.tGroupe = _groupe
      					Fdetailtempo.Tposition = PositionEncours				
      					totqte+=Fdetailtempo.tqte
      
      					hmodifie(Fdetailtempo,hNumEnrEnCours)
      				fin			  	
      
      			fin
      		FIN
      
      	FIN
      
      fin
      
      //verifieRejetplus(tableauRejet)
      
      
     type : 458752
   -
     name : VerifieRejetPlusx
     procedure_id : 5612908085927069695
     type_code : 14
     code : |1+
      Procédure VerifieRejetPlusx(_tableauRejet)
      i est un entier
      _totqte est un entier
      _groupe est un entier
      _hauteur est un reel
      _largeur est un reel
      _dimensionRejet est un entier = config.DimensionThermosTop
      DernierePosition est un entier
      
      RequeteFdetailTempoPlus.pQteMaxPlus = config.DimensionThermosTop
      hexecuterequete(RequeteFdetailTempoPlus)
      
      
      pour tout RequeteFdetailTempoPlus
      	_totqte = RequeteFdetailTempoPlus.la_somme_tqte
      	RequeteFdetailTempoGroupe.pNoTri = RequeteFdetailTempoPlus.fEspaceTri
      	HExécuteRequête(RequeteFdetailTempoGroupe)
      	hlitdernier(RequeteFdetailTempoGroupe)
      	_groupe = RequeteFdetailTempoPlus.fEspaceTri-600
      	_largeur = RequeteFdetailTempoGroupe.LARGEUR
      	_hauteur = RequeteFdetailTempoGroupe.hauteur
      	DernierePosition = RequeteFdetailTempoGroupe.Tposition
      
      	pour i = 1 a dimension(_tableauRejet)/6
      		si pas _tableauRejet[i,3] alors
      
      			si (abs(_tableauRejet[i,4]- _hauteur) < EcartToleranceHauteur et _tableauRejet[i,5] < _dimensionRejet) ou (abs(_tableauRejet[i,5]- _largeur) < EcartToleranceHauteur et _tableauRejet[i,4] < _dimensionRejet) alors
      				si hlitrecherche(Fdetailtempo,IDFdetailtempo,_tableauRejet[i,2]) alors
      					Si _totqte+Fdetailtempo.tqte <= lMaxQtePlus  alors
      						DernierePosition++
      						_totqte=Fdetailtempo.tqte
      						Fdetailtempo.fEspaceTri = 600+_groupe
      						Fdetailtempo.tGroupe = _groupe
      						fdetailtempo.Tposition = DernierePosition
      						_tableauRejet[i,3] = vrai
      						hmodifie(Fdetailtempo,hNumEnrEnCours)
      					fin
      				fin
      			FIN
      		fin
      	FIN
      
      
      FIN
     type : 458752
   -
     name : TriAutreMoins
     procedure_id : 5612946835308246239
     type_code : 14
     code : |1+
      Procédure TriAutreMoins(_tri=9000)
      TableauQte est un tableau dynamique de 0 par 6 entier
      PositionEncours est un entier
      TableauRejet est un tableau dynamique de 0 par 6 entier
      t est un entier = 0
      r est un entier = 0
      HauteurAVerifier est un reel
      LargeurAverifier est un reel
      idtri est un entier = fcree("tri.txt")
      idtriex est un entier = fcree("triex.txt")
      _nbligneatraiter est un entier = 0
      _ldebut est un booleen = vrai
      
      
      _DimensionBase est un reel = config.DimensionAverifierPrep
      _DimensionRejet est un reel = config.DimensionThermosTop
      
      totqte est un entier = 0
      pour tout Fdetailtempo SUR HAUTEURLARGEURfNoForme
      	si fdetailtempo.fEspaceTri = _tri  et Fdetailtempo.HAUTEUR <= _DimensionBase et fdetailtempo.TNoTable = 0 alors
      		t++
      		dimension(TableauQte,t,6)
      		TableauQte[t,1] = Fdetailtempo.tqte
      		TableauQte[t,2] = fdetailtempo.IDFdetailtempo
      		TableauQte[t,3] = 0
      		TableauQte[t,4] = fdetailtempo.HAUTEUR
      		TableauQte[t,5] = fdetailtempo.LARGEUR
      
      
      	FIN
      fin
      
      pour t = 1 a dimension(TableauQte)/6
      	_positionjauge++
      	si _positionJauge  > 100 alors
      		_positionjauge=1	
      	FIN
      	execute("fenjauge.progression",_positionJauge)
      	si TableauQte[t,3] = 0 alors
      		_nbligneatraiter++
      		//		si t <> dimension(tableauqte)/6 alors
      
      
      		si _ldebut ou ((TableauQte[t,4] <= HauteurAVerifier et (HauteurAVerifier - TableauQte[t,4] < EcartToleranceHauteur)) et ...
      			(TableauQte[t,5] <= LargeurAverifier et (LargeurAverifier - TableauQte[t,5] < EcartToleranceLARGEUR))) alors
      			si hlitrecherche(Fdetailtempo,IDFdetailtempo,TableauQte[t,2]) alors
      				HauteurAVerifier = TableauQte[t,4]
      				LargeurAverifier = TableauQte[t,5]
      				TableauQte[t,3]=vrai
      				_ldebut = faux
      				Si totqte+Fdetailtempo.tqte > lMaxQtemoins alors
      
      					//verifieRejet(tableauRejet,tableauqte[t-1,4],tableauqte[t-1,5],totqte,_groupe)
      				//	_groupe+=1
      				//	renvoyer vrai
      					//					positionencours = 1
      					//					totqte=Fdetailtempo.tqte
      					//					Fdetailtempo.fEspaceTri = 700+_groupe
      					//					Fdetailtempo.tGroupe = _groupe
      					//					Fdetailtempo.Tposition = positionencours
      					//					hmodifie(Fdetailtempo,hNumEnrEnCours)
      
      
      				sinon
      
      					PositionEncours++
      					Fdetailtempo.fEspaceTri = 500+_groupe
      					Fdetailtempo.tGroupe = _groupe				
      					Fdetailtempo.Tposition = PositionEncours
      					totqte+=Fdetailtempo.tqte
      
      
      					hmodifie(Fdetailtempo,hNumEnrEnCours)
      
      				fin			  	
      
      			fin
      
      			//		SINON SI (tableauqte[t,4] <= Hauteuraverifier et (hauteuraverifier - tableauqte[t,4] < EcartToleranceHauteur)) ET tableauqte[t,5] <= _Dimensionrejet alors
      		SINON SI abs(HauteurAVerifier - TableauQte[t,4] < EcartToleranceHauteur) ET TableauQte[t,5] <= _DimensionRejet alors
      			r++
      			dimension(TableauRejet,r,6)
      			TableauRejet[r,1] = TableauQte[t,1]
      			TableauRejet[r,2] = TableauQte[t,2]
      			TableauRejet[r,3] = TableauQte[t,3]
      			TableauRejet[r,4] = TableauQte[t,4]
      			TableauRejet[r,5] = TableauQte[t,5]
      			TableauRejet[r,6] = TableauQte[t,6]
      
      
      
      
      		FIN
      
      	FIN
      
      fin
      _groupe++
      
      //pour t = 1 a dimension(TableauRejet)/6
      //	si tableaurejet[t,4] <= Hauteuraverifier et (hauteuraverifier - tableaurejet[t,4] < EcartToleranceHauteurTriFinal)  alors
      //		si hlitrecherche(Fdetailtempo,IDFdetailtempo,Tableaurejet[t,2]) alors
      //			Si totqte+Fdetailtempo.tqte <= lMaxQtemoins alors
      //				//verifieRejet(tableauRejet,tableauqte[t-1,4],tableauqte[t-1,5],totqte,_groupe)
      //				positionencours++
      //				totqte=Fdetailtempo.tqte
      //				Fdetailtempo.fEspaceTri = 500+_groupe
      //				Fdetailtempo.tGroupe = _groupe
      //				Fdetailtempo.Tposition = positionencours
      //				hmodifie(Fdetailtempo,hNumEnrEnCours)
      //			fin
      //		fin
      //	fin
      //FIN
      
      
      //verifieRejetMoins(tableauRejet)
      renvoyer _nbligneatraiter
      
      
     type : 458752
   -
     name : VerifieRejetMoinsx
     procedure_id : 5612947186015975093
     type_code : 14
     code : |1+
      Procédure VerifieRejetMoinsx(_tableauRejet)
      i est un entier
      _totqte est un entier
      _groupe est un entier
      _hauteur est un reel
      _largeur est un reel
      DernierePosition est un entier
      
      RequeteFdetailTempoMoins.pQteMaxMoins = lMaxQtemoins
      hexecuterequete(RequeteFdetailTempoMoins)
      
      pour tout RequeteFdetailTempoMoins
      	_totqte = RequeteFdetailTempoMoins.la_somme_tqte
      	RequeteFdetailTempoGroupe.pNoTri = RequeteFdetailTempoMoins.fEspaceTri
      	HExécuteRequête(RequeteFdetailTempoGroupe)
      	hlitdernier(RequeteFdetailTempoGroupe)
      	_groupe = RequeteFdetailTempoMoins.fEspaceTri-600
      	_largeur = RequeteFdetailTempoGroupe.LARGEUR
      	_hauteur = RequeteFdetailTempoGroupe.hauteur
      	DernierePosition = RequeteFdetailTempoGroupe.Tposition
      
      	pour i = 1 a dimension(_tableauRejet)/6
      		si pas _tableauRejet[i,3] alors
      
      			si (abs(_tableauRejet[i,4]- _hauteur) < EcartToleranceHauteur et _tableauRejet[i,5] < 250) ou (abs(_tableauRejet[i,5]- _largeur) < EcartToleranceLargeur et _tableauRejet[i,4] < 250) alors
      				si hlitrecherche(Fdetailtempo,IDFdetailtempo,_tableauRejet[i,2]) alors
      					Si _totqte+Fdetailtempo.tqte <= lMaxQtePlus  alors
      						DernierePosition++
      						_totqte=Fdetailtempo.tqte
      						Fdetailtempo.fEspaceTri = 600+_groupe
      						Fdetailtempo.tGroupe = _groupe
      						fdetailtempo.Tposition = DernierePosition
      						_tableauRejet[i,3] = vrai
      						hmodifie(Fdetailtempo,hNumEnrEnCours)
      					fin
      				fin
      			sinon si abs(_tableauRejet[i,4]- _hauteur) < EcartToleranceHauteur et abs(_tableauRejet[i,5]- _largeur) < EcartToleranceLargeur alors
      				si hlitrecherche(Fdetailtempo,IDFdetailtempo,_tableauRejet[i,2]) alors
      					Si _totqte+Fdetailtempo.tqte <= lMaxQtePlus  alors
      						DernierePosition++
      						_totqte=Fdetailtempo.tqte
      						Fdetailtempo.fEspaceTri = 600+_groupe
      						Fdetailtempo.tGroupe = _groupe
      						fdetailtempo.Tposition = DernierePosition
      						_tableauRejet[i,3] = vrai
      						hmodifie(Fdetailtempo,hNumEnrEnCours)
      					fin
      				fin
      			FIN
      		fin
      	FIN
      
      
      FIN
     type : 458752
   -
     name : TriAutrePlus
     procedure_id : 5613257475829883307
     type_code : 14
     code : |1+
      Procédure TriAutrePlus(_tri=9000,_constanteaajouter=0)
      TableauQte est un tableau dynamique de 0 par 6 entier
      PositionEncours est un entier
      TableauRejet est un tableau dynamique de 0 par 6 entier
      t est un entier = 0
      r est un entier = 0
      HauteurAVerifier est un reel
      LargeurAverifier est un reel
      idtri est un entier = fcree("tri.txt")
      idtriex est un entier = fcree("triex.txt")
      _nbligneatraiter est un entier = 0
      _ldebut est un booleen = vrai
      
      
      _DimensionBase est un reel = config.DimensionAverifierPrep
      _DimensionRejet est un reel = config.DimensionThermosTop
      
      totqte est un entier = 0
      pour tout Fdetailtempo SUR HAUTEURLARGEURfNoForme
      	si fdetailtempo.fEspaceTri = _tri  et Fdetailtempo.HAUTEUR > _DimensionBase et fdetailtempo.TNoTable = 0 alors
      		t++
      		dimension(TableauQte,t,6)
      		TableauQte[t,1] = Fdetailtempo.tqte
      		TableauQte[t,2] = fdetailtempo.IDFdetailtempo
      		TableauQte[t,3] = 0
      		TableauQte[t,4] = fdetailtempo.HAUTEUR
      		TableauQte[t,5] = fdetailtempo.LARGEUR
      
      
      	FIN
      fin
      
      pour t = 1 a dimension(TableauQte)/6
      	_positionjauge++
      	si _positionJauge  > 100 alors
      		_positionjauge=1	
      	FIN
      	execute("fenjauge.progression",_positionJauge)
      	si TableauQte[t,3] = 0 alors
             _nbligneatraiter++
      		//		si t <> dimension(tableauqte)/6 alors
      
      		si _ldebut ou ((TableauQte[t,4] <= HauteurAVerifier et (HauteurAVerifier - TableauQte[t,4] < EcartToleranceHauteur)) et abs(LargeurAverifier - TableauQte[t,5]) <= EcartToleranceLargeur) alors
      
      			si hlitrecherche(Fdetailtempo,IDFdetailtempo,TableauQte[t,2]) alors
      				HauteurAVerifier = TableauQte[t,4]
      				LargeurAverifier = TableauQte[t,5]
      				TableauQte[t,3]=vrai
      				_ldebut = faux
      				Si totqte+Fdetailtempo.tqte > lMaxQteplus alors
      					//verifieRejet(tableauRejet,tableauqte[t-1,4],tableauqte[t-1,5],totqte,_groupe)
      					_groupe+=1
      //					renvoyer vrai
      					PositionEncours = 1
      					totqte=Fdetailtempo.tqte
      					Fdetailtempo.fEspaceTri = 700+_groupe
      					Fdetailtempo.tGroupe = _groupe
      					Fdetailtempo.Tposition = PositionEncours
      					hmodifie(Fdetailtempo,hNumEnrEnCours)
      					renvoyer vrai
      
      				sinon
      
      					PositionEncours++
      					Fdetailtempo.fEspaceTri = 500+_groupe
      					Fdetailtempo.tGroupe = _groupe				
      					Fdetailtempo.Tposition = PositionEncours
      					totqte+=Fdetailtempo.tqte
      
      
      					hmodifie(Fdetailtempo,hNumEnrEnCours)
      
      				fin			  	
      
      			fin
      
      //		SINON SI (tableauqte[t,4] <= Hauteuraverifier et (hauteuraverifier - tableauqte[t,4] < EcartToleranceHauteur)) ET tableauqte[t,5] <= _Dimensionrejet alors
      		SINON SI abs(HauteurAVerifier - TableauQte[t,4]) < EcartToleranceHauteur ET TableauQte[t,5] <= _DimensionRejet alors
      			r++
      			dimension(TableauRejet,r,6)
      			TableauRejet[r,1] = TableauQte[t,1]
      			TableauRejet[r,2] = TableauQte[t,2]
      			TableauRejet[r,3] = TableauQte[t,3]
      			TableauRejet[r,4] = TableauQte[t,4]
      			TableauRejet[r,5] = TableauQte[t,5]
      			TableauRejet[r,6] = TableauQte[t,6]
      		FIN
      
      	FIN
      
      fin
      
      pour t = 1 a dimension(TableauRejet)/6
      	si TableauRejet[t,4] <= HauteurAVerifier et (HauteurAVerifier - TableauRejet[t,4] < EcartToleranceHauteurTriFinal)  alors
      		si hlitrecherche(Fdetailtempo,IDFdetailtempo,TableauRejet[t,2]) alors
      			Si totqte+Fdetailtempo.tqte <= lMaxQtemoins alors
      				//verifieRejet(tableauRejet,tableauqte[t-1,4],tableauqte[t-1,5],totqte,_groupe)
      				PositionEncours++
      				totqte=Fdetailtempo.tqte
      				Fdetailtempo.fEspaceTri = 500+_groupe
      				Fdetailtempo.tGroupe = _groupe
      				Fdetailtempo.Tposition = PositionEncours
      				hmodifie(Fdetailtempo,hNumEnrEnCours)
      			fin
      		fin
      	fin
      FIN
      
      _groupe++
      //verifieRejetMoins(tableauRejet)
      renvoyer _nbligneatraiter
      
      
     type : 458752
   -
     name : VerifieRejetPlus
     procedure_id : 5613265073842839835
     type_code : 14
     code : |1-
      Procédure VerifieRejetPlus()
      i est un entier
      _totqte est un entier
      _groupe est un entier
      _hauteur est un reel
      _largeur est un reel
      _dimensionRejet est un entier = config.DimensionThermosTop
      DernierePosition est un entier
      
      
      RequeteFdetailTempoPlusRejet.pDimensionRejet = config.DimensionThermosTop
      hexecuterequete(RequeteFdetailTempoPlusRejet)
      RequeteFdetailTempoplus.pQteMaxPlus = lMaxQteplus
      hexecuterequete(RequeteFdetailTempoPlus)
      
      pour tout RequeteFdetailTempoPlusRejet 
      
      	pour tout RequeteFdetailTempoPlus
      		RequeteFdetailTempoGroupe.pNoTri = RequeteFdetailTempoPlusrejet.fEspaceTri
      		HExécuteRequête(RequeteFdetailTempoGroupe)
      		si RequeteFdetailTempoPlus.fEspaceTri = RequeteFdetailTempoPlusRejet.fEspaceTri ou hnbenr(RequeteFdetailTempoGroupe) <> 1 alors
      			continuer
      		fin	
      
      	
      		_totqte = RequeteFdetailTempoPlus.la_somme_tqte
      		RequeteFdetailTempoGroupe.pNoTri = RequeteFdetailTempoPlus.fEspaceTri
      		HExécuteRequête(RequeteFdetailTempoGroupe)
      		hlitdernier(RequeteFdetailTempoGroupe)
      		_groupe = RequeteFdetailTempoPlus.fEspaceTri-500
      		_largeur = RequeteFdetailTempoGroupe.LARGEUR
      		_hauteur = RequeteFdetailTempoGroupe.hauteur
      		DernierePosition = RequeteFdetailTempoGroupe.Tposition
      
      		si abs(RequeteFdetailTempoPlusRejet.HAUTEUR - _hauteur) < EcartToleranceHauteur alors
      			si hlitrecherche(Fdetailtempo,IDFdetailtempo,RequeteFdetailTempoPlusRejet.IDFdetailtempo) alors
      				Si _totqte+Fdetailtempo.tqte <= lMaxQtePlus  alors
      					DernierePosition++
      					_totqte=Fdetailtempo.tqte
      					Fdetailtempo.fEspaceTri = 500+_groupe
      					Fdetailtempo.tGroupe = _groupe
      					fdetailtempo.Tposition = DernierePosition
      					hmodifie(Fdetailtempo,hNumEnrEnCours)
      				fin
      			fin
      		FIN
      
      
      	FIN
      fin
     type : 458752
   -
     name : VerifieRejetMoins
     procedure_id : 5613274591990068438
     type_code : 14
     code : |1+
      Procédure VerifieRejetMoins(Top = faux)
      i est un entier
      _totqte est un entier
      _groupe est un entier
      _hauteur est un reel
      _largeur est un reel
      _hauteurrejet est un reel
      _largeurrejet est un reel
      _idfdetailtempo est un entier
      _dimensionRejet est un entier = config.DimensionThermosTop
      DernierePosition est un entier
      tableauRejet est un tableau dynamique de 0  par 4 reel
      cpt est un entier
      _ListeTableUtilisée est une chaine 
      
      
      
      
      hexecuterequete(RequetefdetailUniqueMoins)
      pour tout RequetefdetailUniqueMoins
      	si RequetefdetailUniqueMoins.Comptage_1 = 1 alors
      		RequeteFdetailTempoGroupe.pNoTri = RequetefdetailUniqueMoins.fEspaceTri
      		HExécuteRequête(RequeteFdetailTempoGroupe)
      		hlitpremier(RequeteFdetailTempoGroupe)
      		si Top alors
      			si RequeteFdetailTempoGroupe.LARGEUR < config.DimensionThermosTop alors
      				cpt++
      				dimension(tableauRejet,cpt,4)
      				tableauRejet[cpt,1] = RequeteFdetailTempoGroupe.IDFdetailtempo	
      				tableauRejet[cpt,2] = RequeteFdetailTempoGroupe.HAUTEUR
      				tableauRejet[cpt,3] = RequeteFdetailTempoGroupe.largeur
      				tableauRejet[cpt,4] = val(RequeteFdetailTempoGroupe.fEspaceTri)
      				_ListeTableUtilisée += "_"+RequeteFdetailTempoGroupe.fEspaceTri
      			fin
      
      		sinon
      			si RequeteFdetailTempoGroupe.LARGEUR > config.DimensionThermosTop alors
      				cpt++
      				dimension(tableauRejet,cpt,4)
      				tableauRejet[cpt,1] = RequeteFdetailTempoGroupe.IDFdetailtempo	
      				tableauRejet[cpt,2] = RequeteFdetailTempoGroupe.HAUTEUR
      				tableauRejet[cpt,3] = RequeteFdetailTempoGroupe.largeur
      				tableauRejet[cpt,4] = val(RequeteFdetailTempoGroupe.fEspaceTri)
      				_ListeTableUtilisée += "_"+RequeteFdetailTempoGroupe.fEspaceTri
      			fin
      
      		fin
      	fin
      FIN
      //info(dimension(tableaurejet)/4)
      
      
      RequeteFdetailTempomoins.pQteMaxMoins = lMaxQtemoins
      hexecuterequete(RequeteFdetailTempomoins)
      
      pour cpt = 1 a dimension(tableauRejet)/4
      
      	//pour tout RequetefdetailUniqueMoins
      	//	si RequetefdetailUniqueMoins.Comptage_1 = 1 alors
      
      	pour tout RequeteFdetailTempomoins
      		si ChaîneOccurrence(_ListeTableUtilisée,RequeteFdetailTempomoins.fEspaceTri) <> 0 alors
      			continuer
      		fin	
      		RequeteFdetailTempoGroupe.pNoTri = RequeteFdetailTempoMoins.fEspaceTri
      		HExécuteRequête(RequeteFdetailTempoGroupe)
      		si hnbenr(RequeteFdetailTempoGroupe) <> 0 alors
      			_totqte = RequeteFdetailTempomoins.la_somme_tqte
      			hlitdernier(RequeteFdetailTempoGroupe)
      			_groupe = RequeteFdetailTempomoins.fEspaceTri-500
      			_largeur = RequeteFdetailTempoGroupe.LARGEUR
      			_hauteur = RequeteFdetailTempoGroupe.hauteur
      			DernierePosition = RequeteFdetailTempoGroupe.Tposition
      
      
      			si abs(tableauRejet[cpt,2] - _hauteur) < EcartToleranceHauteurTriFinal et (abs(tableauRejet[cpt,3]-_largeur) < EcartToleranceLargeurTriFinal ou Top) alors
      				si hlitrecherche(Fdetailtempo,IDFdetailtempo,tableauRejet[cpt,1]) alors
      					Si _totqte+Fdetailtempo.tqte <= lMaxQtemoins  alors
      						DernierePosition++
      						_totqte=Fdetailtempo.tqte
      						Fdetailtempo.fEspaceTri = 500+_groupe
      						Fdetailtempo.tGroupe = _groupe
      						fdetailtempo.Tposition = DernierePosition
      						hmodifie(Fdetailtempo,hNumEnrEnCours)
      						_ListeTableUtilisée+= "_"+fdetailtempo.fEspaceTri
      						sortir
      					fin
      				fin
      			FIN
      
      		fin
      	fin
      FIN
      
      
      
     type : 458752
   -
     name : VerifieRejetMoinsEntreEux
     procedure_id : 5614088539733879345
     type_code : 14
     code : |1+
      Procédure VerifieRejetMoinsEntreEux()
      i est un entier
      _totqte est un entier
      _groupe est un entier
      _hauteur est un reel
      _largeur est un reel
      _hauteurrejet est un reel
      _largeurrejet est un reel
      _idfdetailtempo est un entier
      _dimensionRejet est un entier = config.DimensionThermosTop
      DernierePosition est un entier
      tableauRejet est un tableau dynamique de 0  par 4 reel
      cpt est un entier
      _ListeTableUtilisée est une chaine 
      
      
      
      
      hexecuterequete(RequetefdetailUniqueMoins)
      pour tout RequetefdetailUniqueMoins
      	si RequetefdetailUniqueMoins.Comptage_1 = 1 alors
      		RequeteFdetailTempoGroupe.pNoTri = RequetefdetailUniqueMoins.fEspaceTri
      		HExécuteRequête(RequeteFdetailTempoGroupe)
      		hlitpremier(RequeteFdetailTempoGroupe)
      				cpt++
      				dimension(tableauRejet,cpt,4)
      				tableauRejet[cpt,1] = RequeteFdetailTempoGroupe.IDFdetailtempo	
      				tableauRejet[cpt,2] = RequeteFdetailTempoGroupe.HAUTEUR
      				tableauRejet[cpt,3] = RequeteFdetailTempoGroupe.largeur
      				tableauRejet[cpt,4] = val(RequeteFdetailTempoGroupe.fEspaceTri)
      				_ListeTableUtilisée += "_"+RequeteFdetailTempoGroupe.fEspaceTri
      
      	fin
      FIN
      //info(dimension(tableaurejet)/4)
      
      
      
      RequeteFdetailTempomoins.pQteMaxMoins = lMaxQtemoins
      hexecuterequete(RequeteFdetailTempomoins)
      
      pour cpt = 1 a dimension(tableauRejet)/4
      
      	//pour tout RequetefdetailUniqueMoins
      	//	si RequetefdetailUniqueMoins.Comptage_1 = 1 alors
      
      	pour tout RequeteFdetailTempomoins
      		si ChaîneOccurrence(_ListeTableUtilisée,RequeteFdetailTempomoins.fEspaceTri) = 0 ou RequeteFdetailTempomoins.fEspaceTri = numeriqueverschaine(tableauRejet[cpt,4]) alors
      			continuer
      		fin	
      		RequeteFdetailTempoGroupe.pNoTri = RequeteFdetailTempoMoins.fEspaceTri
      		HExécuteRequête(RequeteFdetailTempoGroupe)
      		si hnbenr(RequeteFdetailTempoGroupe) <> 0 alors
      			_totqte = RequeteFdetailTempomoins.la_somme_tqte
      			hlitdernier(RequeteFdetailTempoGroupe)
      			_groupe = RequeteFdetailTempomoins.fEspaceTri-500
      			_largeur = RequeteFdetailTempoGroupe.LARGEUR
      			_hauteur = RequeteFdetailTempoGroupe.hauteur
      			DernierePosition = RequeteFdetailTempoGroupe.Tposition
      
      
      			si abs(tableauRejet[cpt,2] - _hauteur) < EcartToleranceHauteurTriFinal et abs(tableauRejet[cpt,3]-_largeur) < EcartToleranceLargeurTriFinal  alors
      				si hlitrecherche(Fdetailtempo,IDFdetailtempo,tableauRejet[cpt,1]) alors
      					Si _totqte+Fdetailtempo.tqte <= lMaxQtemoins  alors
      						DernierePosition++
      						_totqte=Fdetailtempo.tqte
      						Fdetailtempo.fEspaceTri = 500+_groupe
      						Fdetailtempo.tGroupe = _groupe
      						fdetailtempo.Tposition = DernierePosition
      						hmodifie(Fdetailtempo,hNumEnrEnCours)
      						_ListeTableUtilisée+= "_"+fdetailtempo.fEspaceTri
      						sortir
      					fin
      				fin
      			FIN
      
      		fin
      	fin
      FIN
      
      
      
