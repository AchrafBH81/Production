 message_bar :
  internal_properties : CQAAAAkAAAA+dmjLt0g+H/DlBWsvVTFL0EQceehGi6PBiij4GBL/rFeYe5jvl/nrqCbcfqkK1eAIA+WaaBEF0h2ileJoWSO+FNo9cWUME7uB4Aefu9ngCyrfsbtoUn4TLlFieQ==
  controls :
   -
     name : Case1
     identifier : 0x228969cd6a47420f
     internal_properties : CQAAAAkAAAAKixJp8P7fG7jCKtRownHFI3V73wyifhE8OQ8QVjB0mW7u3FnJlwsVR/WSGEK/MvoRjnb6tgsmUiGyjrYRwj6FUm7PHtonq1TyZfMepz9SMmpBuzq/52v6
     type : 62
     code_elements :
