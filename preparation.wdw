  -
    name : BTN_IMPRIME
    identifier : 0x3e9d90b664e251f8
    internal_properties : 
    properties :
     x : 383
     y : 2
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         //iimprimeetat("LISTE PRIX SPéCIAUX",client.numero,client.numero)
         anciennecommande est un entier = 0
         ancienneligne est un entier = 0
         j est un entier
         restaure_bouton()
         iconfigure(sansespace(imprimanterapport),vrai)
         iImprimeEtat(EQtePrep,prochainnumeroprep)
         iconfigure(sansespace(imprimanterapport),vrai)
         iImprimeEtat(FichierTransfertThermosTRN)
         
         MEMCREE("transfertspecial")
         //prep_tempo()
         
         iconfigure(sansespace(imprimanterapport),vrai)
         //Début du code généré par l'assistant de code de la fonction iParamètre
         
         
         //iParamètre("DEFAUT=NON")
         //iParamètre("FORMATPAPIER=DEFINIUTILISATEUR")
         //iParamètre("HAUTEURPAGE=2794")
         //iParamètre("LARGEURPAGE=2159")
         //iParamètre("QUALITE=MOYENNE")
         //Début du code généré par l'assistant de code de la fonction iParamètre
         
         
         //Ne sauvegarde pas les paramètres spécifiés
         iParamètre("DEFAUT=NON")
         //Format de papier prédéfini
         iParamètre("FORMATPAPIER=LETTRE")
         iParamètre("QUALITE=HAUTE")
         //Fin du code généré par l'assistant de code de la fonction iParamètre
         //Fin du code généré par l'assistant de code de la fonction iParamètre
         
         selon gFormatFacture
         	cas 1
         		iimprimeetat("fichier de transfert ordre")
         	cas 2
         		iimprimeetat(FichierTransfertTRN)
         
         FIN
         
         
         hlitpremier("tempo","clecommandeligne")
         //anciennecommande = tempo.tcomm
         //ancienneligne = tempo.tlignedecommande
         //Code WinDev 5.5 remplacé par la migration :
         //tantque pas h.endehors
         tantque pas HEnDehors()
         	si tempo.ttransfertspecial alors
         	  si pas (tempo.tcomm = anciennecommande et tempo.tlignedecommande = ancienneligne) alors	
         		memajoute("transfertspecial",h.numenr,h.numenr)
                    anciennecommande = tempo.tcomm
                    ancienneligne = tempo.tlignedecommande
         	  
               fin
               FIN
         		hlitsuivant("tempo","clecommandeligne")
         FIN
         
         si pas memoccurrence("transfertspecial") = 0 alors
         	iParamètre("QUALITE=HAUTE")
         	iimprimeetat("FICHIER DE TRANSFERT SPECIAL","transfertspecial")
         FIN
         
        type : 18
      -
        type : 161
        enabled : false
