      		VarInter1=IntercalaireCouleurDimensions.VarInter1A
      		VarInter2=IntercalaireCouleurDimensions.VarInter2A
      		VarInter3=IntercalaireCouleurDimensions.VarInter3A
      		VarInter4=IntercalaireCouleurDimensions.VarInter4A
      		VarInter5=IntercalaireCouleurDimensions.VarInter5A
      	sinon
      		VarInter1=IntercalaireCouleurDimensions.VarInter1
      		VarInter2=IntercalaireCouleurDimensions.VarInter2
      		VarInter3=IntercalaireCouleurDimensions.VarInter3
      		VarInter4=IntercalaireCouleurDimensions.VarInter4
      		VarInter5=IntercalaireCouleurDimensions.VarInter5
      	fin
