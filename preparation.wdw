   -
     name : prep_remplir
     procedure_id : 4511921514761900796
     type_code : 14
     code : |1+
      Procédure prep_remplir(NoSecteur est une chaine = "")
      conditionfiltre est un chaine = "fasecteur = preparation.psecteur"
      clefiltre est un chaine
      lTotalThermos est un entier
      lNocase est un entier
      lresultat est une chaine
      
      hlitpremier("Facture","fanumero")
      
      tantque pas HEnDehors() 
      //	SI SansEspace(Facture.fasecteur) = preparation.PSECTEUR ET SansEspace(Facture.FPREPARATION) = "" ET Facture.fatypedocument = 1 ALORS
      		SI SansEspace(Facture.fasecteur) = NoSecteur ET SansEspace(Facture.FPREPARATION) = "" ET Facture.fatypedocument = 1 ALORS
      			lresultat = CalculRackUneLigne(facture.fanumero)
      		
      		si gFormatFacture = 2 alors
      			tableajoute("TABLE1",faux+tab+facture.fadate+tab+facture.fanumero+tab+...
      			facture.faclient+tab+facture.nom+tab+h.numenr+TAB+...
      			complete(numeriqueverschaine(facture.fasecteur),2)+tab+val(extraitchaine(lresultat,1,";"))+tab+FactureEstHER(facture.fanumero)+tab+val(extraitchaine(lresultat,2,";")))
      		sinon
      			tableajoute("TABLE1",vrai+tab+facture.fadate+tab+facture.fanumero+tab+...
      			facture.faclient+tab+trouve_client(Facture.faclient,faux)+tab+h.numenr+TAB+...
      			complete(numeriqueverschaine(facture.fasecteur),2)+tab+val(extraitchaine(lresultat,1,";"))+tab+FactureEstHER(facture.fanumero))
      
      		fin
      		
      
      	fin
      
      	hlitsuivant("Facture","fanumero")
      fin
      
      tableaffiche("TABLE1",taCourantPremier)
      
     type : 458752
   -
     name : prep_tempo
     procedure_id : 4511921513280066320
     type_code : 14
     code : |1+
      Procédure prep_tempo()         
      si gFormatFacture = 2 alors
      	prep_tempo_trn_new_tri()
      	renvoyer vrai
      FIN
      j est un entier
      numerodecommande est un entier
      nombre est un entier = tableoccurrence("TABLE1")
      
      
      hbloquefichier("tempo")
      si HErreurBlocage() alors
      	acso_message("Erreur","Information déjà en utilisation","Erreur")
      	renvoyer vrai
      FIN
      supprimetempo()
      //htransactiondebut("transaction.fac","FACTURE")
      
      ouvrefille("FENJAUGE","Préparation du fichier de transfert")
      
      pour j = 1 a tableoccurrence("TABLE1")
      	execute("fenjauge.progression",j/nombre * 100)
      	facture.FPREPARATION = ""
      
      	si crochet[j] alors
      		hlitrecherche("Facture","fanumero",commande[j])
      		si HErreurBlocage() alors
      			erreur("la commande "+commande[j])
      		FIN
      		numerodecommande = facture.fanumero
      		wligne = 1
      		
      		hlitrecherche(fdetail,fdnocommfdligne,hconstruitvalcle( fdetail,fdnocommfdligne,numerodecommande,1))
      		si HErreurBlocage() alors
      			erreur("la commande "+commande[j]+ " ne peut pas etre traitée")
      			ferme("FENJAUGE")
      			renvoyer faux
      		FIN
      
      		tantque fdetail.fdnocomm = numerodecommande et pas HEnDehors()
      
      			valide_composant()
      //			si cptdepart > config.MaxCase alors
      //				info(cptdepart)
      //				acso_message("Erreur","Vous dépassez le nombre maximum de case","Erreur")
      //				hexecuterequete(RequeteSecteurPrepare,hModifieFichier)
      //                pour tout RequeteSecteurPrepare
      //                    RequeteSecteurPrepare.FPREPARATION = ""
      //                    hModifie(RequeteSecteurPrepare,hNumEnrEnCours)
      //                fin
      //         	
      //				ferme(fenjauge)
      //				renvoyer faux
      //			FIN
      
      			si fdetail.fdlien = 0 alors
      				AjouterTableau(1,fdetail.fdnumprod,fdetail.fdlargeura,fdetail.fdhauteura,"",fdetail.fddesc,facture.facalcul,fdetail.fdqteafacturer)
      			sinon si fdetail.fdlien = fdetail.fdligne alors
      				AjouterTableau(1,fdetail.fdnumprod,fdetail.fdlargeura,fdetail.fdhauteura,"",fdetail.fddesc,facture.facalcul,fdetail.fdqteafacturer)
      			sinon
      				AjouterTableau(2,fdetail.fdnumprod,fdetail.fdcarreauv,fdetail.fdcarreauh,fdetail.fdtypecalcul,fdetail.fddesc,facture.facalcul,fdetail.fdqteafacturer)
      			fin
      
      
      			hlitsuivant(fdetail,fdnocommfdligne)
      			si HErreurBlocage() alors
      			FIN
      
      		FIN
      		facture.fpreparation = "T"
      //		facture.livrepartiel = " "
      
      		hmodifie("Facture",hnumenrencours)
      		si HErreurBlocage() alors
      			info(tablenumenr("TABLE1"))
      		FIN
      	fin
      	multitache(10)
      FIN
      hdebloquefichier("tempo")
      ferme("FENJAUGE")
      si gFormatFacture = 2 alors
      	TriTempo()
      fin
      renvoyer vrai
     type : 458752
   -
     name : remplir_tempo
     internal_properties : CQAAAAkAAAAUIG7ZbGorWCz7Smp0F7jnb+JGi6ul3qwCsA6ADonu7rbQN9N0Kygw8LHNGHe7sB5b/vaXUiNwao4F3UNml1xXaxKzl95sXfZkPDkJ63wMXt+cC85znn6IPtvqpiTxKAMhdo3l7ENhCLWkRFZB5MZWvOUcCxJXEn11ChpoFoH0Ta7f5I+r
     procedure_id : 4511921514939241413
     type_code : 14
     code : |1-
      // Traitement automatique des exceptions :   exécuter le bloc de code CAS EXCEPTION:
      //
      // Traitement automatique des erreurs :   exécuter le bloc de code CAS ERREUR
      //
      
      Procédure remplir_tempo(composant,tempoqte,forme = "",doubletriple="",rang=0,aucunpdebase=faux,unenergiverre=faux,unsurface=faux,produiteng=faux,wargon=faux,lcpt=0,lincrement=2)
      local
      	k est un entier 
      	GazArgon est un booleen
      	clederecherche est une chaine
      	qteresiduelle est un entier = fdetail.fdqte
      	i est un entier
      	j est un entier
      	l est un entier = 1
      	nLpas est un entier
      	ldescspacer est une chaine
      	ldesccarrelage est une chaine
      	lPasRack est un entier //= TrouvePasRack()  // nombre de thermos par case
      	lordretraitement est un entier
      	lresultat est une chaine = TrouveOrdreNbRack()
      	lPasRack = val(ExtraitChaîne(lresultat,2,","))
      	si lPasRack = 0  alors
      		lPasRack = 1
      	FIN
      	lordretraitement = val(ExtraitChaîne(lresultat,1,","))
      	si lordretraitement = 0 alors
      		lordretraitement = 999
      	FIN
      	
      	cpt est un entier = lcpt
      	ListeCpt est une chaine
      hraz(tempo)
      nRecordcourant est un entier
      
      selon gFormatFacture
      	cas 1
      		si sansespace(composant) <> "" alors
      			//			pour k = 1 a fdetail.fdqte pas 2
      			pour k = 1 a arrondi(fdetail.fdqte/lPasRack)
      				tempo.targon = faux
      				si forme = "" alors
      
      					//Code WinDev 5.5 remplacé par la migration :
      					//		hlitrecherchesansbloquer("invent","INUM",composant)
      					hlitrecherche("invent","INUM",composant)
      					//Code WinDev 5.5 remplacé par la migration :
      					//		si hdejabloque() alors
      					si HErreurBlocage() alors
      						acso_message("Erreur","Information déjà en utilisation","Erreur")
      
      					FIN
      					//Code WinDev 5.5 remplacé par la migration :
      					//		si pas h.endehors et h.trouve alors
      					si pas HEnDehors() et HTrouve() alors
      						tempo.timprimeetiq = invent.iimprimeetiq
      						tempo.tproduitdebase = invent.ibase
      						tempo.tpriorite   = invent.ipriorite
      						tempo.tsurfaceinterieure = faux
      
      						si produiteng alors
      
      							tempo.tsurfaceinterieure = vrai
      							si wargon alors
      								tempo.targon = vrai
      								GazArgon = "1"
      							sinon
      								GazArgon = "0"
      							FIN
      						sinon	
      							si pas unenergiverre et unsurface alors
      								si invent.ibase alors
      									tempo.tsurfaceinterieure = vrai
      
      								FIN
      							FIN
      						FIN
      
      						tempo.tienergiverre = (invent.ienergieverre OU invent.ienergieverreESC)
      					sinon
      						tempo.tproduitdebase = invent.ibase
      						tempo.timprimeetiq = faux
      						tempo.tpriorite = 99
      					FIN
      					si aucunpdebase alors
      						tempo.timprimeetiq = vrai
      					FIN
      					tempo.tlignedecommande = fdetail.fdligne
      					tempo.tclient = facture.faclient
      					tempo.tnomclient = trouve_client(facture.faclient, faux)
      					tempo.tnomcourt = trouve_client(facture.faclient, vrai)
      					tempo.ttransfertspecial = client.ctransfertspecial 
      
      					si sansespace(client.videojet) = "" alors
      						tempo.tnumeroformule = 1	
      					sinon
      						tempo.tnumeroformule = val(client.videojet)
      					fin
      					tempo.tordre = facture.fanocommande
      					tempo.tcomm = facture.fanumero
      					tempo.tjob = facture.fanojob
      					tempo.tsecteur = facture.fasecteur
      					tempo.tcap = fdetail.fdcap
      					tempo.tproduit = fdetail.fdnumprod
      					tempo.tcomposant1 = fdetail.fdcomposant1
      					tempo.tcomposant2 = fdetail.fdcomposant2
      					tempo.tcomposant3 = fdetail.fdcomposant3
      
      
      					clederecherche = hconstruitvalcle(OrdreTrtXopt,Composant1Composant2Composant3Argon,...
      					sansespace(fdetail.fdcomposant1),...
      					sansespace(fdetail.fdcomposant2),...
      					sansespace(fdetail.fdcomposant3),...
      					wargon)
           	
      					tempo.TordreXopt = lordretraitement
      					
      					tempo.ttype = facture.facalcul
      					tempo.tdate = facture.fadate
      					tempo.tbase = composant
      					tempo.tqtebase  = tempoqte
      					tempo.tqteoriginale = fdetail.fdqte
      					tempo.tqte = min(qteresiduelle,lPasRack)
      					qteresiduelle -= lPasRack
      
      					tempo.tnumligne = l
      					tempo.tcapgaztube = fdetail.fcapgaztube
      					tempo.tenergiverre = fdetail.fdenergiverre
      
      					si valide_trtspec1(composant,rang)
      						//    si traitementspecial alors
      						tempo.ttraitementspecial = "O"
      						tempo.trngtrtspe         = rangtrtspe
      						si GAUCHE(composant,2) = "CL" ALORS
      							tempo.tprodtrtspe        = noprodtrtspe
      						SINON
      							tempo.tprodtrtspe        = ""
      						FIN	
      
      					sinon
      						tempo.ttraitementspecial = "A"  // Jean hamelin
      						tempo.trngtrtspe = "  " // Jean hamelin
      						tempo.tprodtrtspe        = ""
      					fin
      
      
      					SI facture.facalcul = 1 alors
      						tempo.tlargeur = numeriqueverschaine(val(fdetail.fdlargeur)/12 * 0.3048 * 1000,"7.2f")
      						tempo.thauteur = numeriqueverschaine(val(fdetail.fdhauteur)/12 * 0.3048 * 1000,"7.2f")
      					sinon
      						tempo.tlargeur = NumeriqueVersChaine(val(fdetail.fdlargeur) * 1000)
      						tempo.thauteur = NumeriqueVersChaine(val(fdetail.fdhauteur) * 1000)
      					fin
      
      					tempo.tlargeura = fdetail.fdlargeura
      					tempo.thauteura = fdetail.fdhauteura
      					tempo.TtypeSpacer = fdetail.ftypespacer
      					tempo.tespace = fdetail.fdespace
      					tempo.tespace2 = fdetail.fdespace2
      					tempo.tligne  = wligne
      					tempo.tprixuni  = fdetail.fdprixu
      					tempo.tprixupied = fdetail.fdprixupied
      					tempo.tdescription = fdetail.fddesc
      					tempo.tnumeroprep = prochainnumeroprep
      					tempo.tcarrelage = fdetail.fdcarrelage
      					tempo.TJOBLIGNE  = fdetail.FDJOBLIGNE 
      					tempo.tdoubletriple = doubletriple
      					tempo.tfini = fdetail.ffini
      					si pas fdetail.fdforme =  "" alors 
      						tempo.tnoforme = fdetail.fdforme
      						tempo.tw       = transformevaleur(fdetail.fdw)
      						tempo.tw1      = transformevaleur(fdetail.fdw1)
      						tempo.tw2      = transformevaleur(fdetail.fdw2)
      						tempo.th       = transformevaleur(fdetail.fdh)
      						tempo.th1      = transformevaleur(fdetail.fdh1)
      						tempo.th2      = transformevaleur(fdetail.fdh2)
      						tempo.td       = transformevaleur(fdetail.fdd)
      						tempo.tr       = transformevaleur(fdetail.fdr)
      						tempo.tr1       = transformevaleur(fdetail.fdr1)
      						tempo.tr2       = transformevaleur(fdetail.fdr2)
      						tempo.ts       = transformevaleur(fdetail.fds)
      						tempo.tf       = transformevaleur(fdetail.fdf)
      						tempo.tt1      = transformevaleurvf(fdetail.fdt1)
      						tempo.tt2      = transformevaleurvf(fdetail.fdt2)
      						tempo.tt3      = transformevaleurvf(fdetail.fdt3)
      						tempo.tt4      = transformevaleurvf(fdetail.fdt4)
      						tempo.tcapw    = fdetail.fdcapw
      						tempo.tcapw1   = fdetail.fdcapw1
      						tempo.tcapw2   = fdetail.fdcapw2
      						tempo.tcaph    = fdetail.fdcaph
      						tempo.tcaph1   = fdetail.fdcaph1
      						tempo.tcaph2   = fdetail.fdcaph2
      						tempo.tcapd    = fdetail.fdcapd
      						tempo.tcapr    = fdetail.fdcapr
      						tempo.tcapr1    = fdetail.fdcapr1
      						tempo.tcapr2    = fdetail.fdcapr2
      						tempo.tcaps    = fdetail.fdcaps
      						tempo.tcapf    = fdetail.fdcapf
      						tempo.tnombre  = fdetail.fnombre
      						tempo.tcarreauh = fdetail.fdcarreauh
      						tempo.tcarreauv = fdetail.fdcarreauv
      						tempo.tnumcarr = fdetail.fdnumcarr
      						tempo.tnotes = fdetail.fnotes 
      						tempo.tnote2 = fdetail.fnotes1
      						tempo.TtypeCalcul = fdetail.fdtypecalcul
      						hlitrecherche("forme","fnumero",fdetail.fdforme)
      						//Code WinDev 5.5 remplacé par la migration :
      						//	si pas h.endehors et h.trouve alors
      						si pas HEnDehors() et HTrouve() alors
      							tempo.twordre = forme.wordre
      							tempo.tw1ordre = forme.w1ordre
      							tempo.tw2ordre = forme.w2ordre
      							tempo.thordre = forme.hordre
      							tempo.th1ordre = forme.h1ordre
      							tempo.th2ordre = forme.h2ordre
      							tempo.tt1ordre = forme.t1ordre
      							tempo.tt2ordre = forme.t2ordre
      							tempo.tt3ordre = forme.t3ordre
      							tempo.tt4ordre = forme.t4ordre
      							tempo.trordre = forme.rordre
      							tempo.tr1ordre = forme.r1ordre
      							tempo.tr2ordre = forme.r2ordre
      							tempo.tdordre = forme.dordre
      							tempo.tsordre = forme.sordre
      							tempo.tfordre = forme.fordre
      						FIN
      
      					FIN
      					pour i = 1 a 10
      						{"tempo.tnbmorceau"+i} = fdetail.FDnbmorceau[i]
      						{"tempo.tnbdimension"+i} = fdetail.fddimension[i]
      					FIN
      					tempo.Tvx = fdetail.fdvariablex
      					tempo.Tvx1 = fdetail.fdvariablex1
      					tempo.TMatch = 0
      					tempo.tddv = fdetail.fdddv
      					tempo.tddh = fdetail.fdddh
      					tempo.tdt = fdetail.fdt
      					tempo.TDemiCarrelage = fdetail.TDemiCarrelage
      
      					si fdetail.fdNoteSpeciale et k = 1 alors
      						si hlitrecherche(typespac,tnumero,fdetail.ftypespacer) alors
      							ldescspacer = sansespace(typespac.tdescription)
      						sinon
      							ldescspacer = ""
      						fin
      						si hlitrecherche(invent,INUM,tempo.tnumcarr) alors
      							ldesccarrelage = sansespace(invent.idesc)
      						sinon
      							ldesccarrelage=""
      						fin
      						tempo.tnoteSpeciale= sansespace(fdetail.fnotes)+","+sansespace(fdetail.fnotes1)+","+ldescspacer...
      						+"," + sansespace(fdetail.fdespace)+","+ sansespace(fdetail.fdespace2)+","+sansespace(tempo.Tnumcarr)+","+ldesccarrelage+","+sansespace(Fdetail.fdcommentaireVideojet)
      					sinon
      						tempo.tnoteSpeciale=""
      					fin
      
      
      					hajoute("tempo")
      
      					si HErreurBlocage() alors
      						acso_message("Erreur","Information déjà en utilisation","Erreur")
      					fin   
      				FIN
      				wligne++
      				l++
      			fin
      
      		fin
      
      		// Pour Thermos Rive-Nord
      
      	cas 2
      		//cpt=CptDepart
      					
      		cpt = lcpt
      		si sansespace(composant) <> "" alors
      			//			pour k = 1 a fdetail.fdqte pas 2 
      			tempo.targon = faux
      			si forme = "" alors
      
      				//Code WinDev 5.5 remplacé par la migration :
      				//		hlitrecherchesansbloquer("invent","INUM",composant)
      				hlitrecherche("invent","INUM",composant)
      				//Code WinDev 5.5 remplacé par la migration :
      				//		si hdejabloque() alors
      				si HErreurBlocage() alors
      					acso_message("Erreur","Information déjà en utilisation","Erreur")
      				FIN
      				//Code WinDev 5.5 remplacé par la migration :
      				//		si pas h.endehors et h.trouve alors
      				si pas HEnDehors() et HTrouve() alors
      					tempo.timprimeetiq = invent.iimprimeetiq
      					tempo.tproduitdebase = invent.ibase
      					tempo.tpriorite   = invent.ipriorite
      					tempo.tsurfaceinterieure = faux
      
      					si produiteng alors
      
      						tempo.tsurfaceinterieure = vrai
      						si wargon alors
      							tempo.targon = vrai
      							GazArgon = "1"
      						sinon
      							GazArgon = "0"
      						FIN
      					sinon	
      						si pas unenergiverre et unsurface alors
      							si invent.ibase alors
      								tempo.tsurfaceinterieure = vrai
      
      							FIN
      						FIN
      					FIN
      
      					tempo.tienergiverre = (invent.ienergieverre OU invent.ienergieverreESC)
      				sinon
      					tempo.tproduitdebase = invent.ibase
      					tempo.timprimeetiq = faux
      					tempo.tpriorite = 99
      				FIN
      				si aucunpdebase alors
      					tempo.timprimeetiq = vrai
      				FIN
      				tempo.tlignedecommande = fdetail.fdligne
      				tempo.tclient = facture.faclient
      				tempo.tnomclient = facture.nom
      				si facture.faclient = config.NoClientComptant alors
      					tempo.tnomcourt = facture.nom
      				sinon
      					tempo.tnomcourt = trouve_client(facture.faclient, vrai)
      				fin
      				tempo.tnomLivraison = tempo.tnomclient
      				si hlitrecherche(ClientLivraison,idclient,sansespace(facture.faclient),hIdentique) alors
      					si facture.idLivraison <> 0 alors
      						si hlitrecherche(ClientLivraison,IDClientLivraison,facture.idLivraison) alors
      							tempo.tnomLivraison = ClientLivraison.lNom
      						sinon
      							tempo.tnomLivraison = tempo.tnomclient
      						fin
      
      					sinon
      						si trouvedefautlivraison(facture.faclient) alors
      							tempo.tnomLivraison = ClientLivraison.lnom
      						sinon
      							tempo.tnomLivraison = tempo.tnomclient
      						fin
      					FIN
      				sinon
      					tempo.tnomLivraison = tempo.tnomclient
      				FIN
      				
      				tempo.ttransfertspecial = client.ctransfertspecial 
      				Tempo.tscellant = CLIENT.Cscellant
      				si sansespace(client.videojet) = "" alors
      					tempo.tnumeroformule = 1	
      				sinon
      					tempo.tnumeroformule = val(client.videojet)
      				fin
      
      				// Pour cover qui commande du carrelage seulement et veut avoir une description différente sur la videojet par client
      
      				si client.livraisonpourvideojet alors
      					si hlitrecherche(facture,fanumero,fdetail.fdnocomm) alors
      						si facture.idLivraison <> 0 alors
      							si hlitrecherche(ClientLivraison,IDClientLivraison,facture.idLivraison) alors
      								si sansespace(ClientLivraison.lNumeroVideojet) = "" alors
      									tempo.tnumeroformule = 1	
      								sinon
      									tempo.tnumeroformule = val(ClientLivraison.lNumeroVideojet)	
      								fin
      
      							fin
      
      						fin
      
      					fin
      					//	tempo.
      				fin
      
      
      
      				//A FAIRE :Ajuster le numero de videojet
      
      
      				tempo.tordre = facture.fanocommande
      				tempo.tcomm = facture.fanumero
      				tempo.tjob = facture.fanojob
      				tempo.tsecteur = facture.fasecteur
      				tempo.tcap = fdetail.fdcap
      				tempo.tproduit = fdetail.fdnumprod
      				tempo.tcomposant1 = fdetail.fdcomposant1
      				tempo.tcomposant2 = fdetail.fdcomposant2
      				tempo.tcomposant3 = fdetail.fdcomposant3
                      si hlitrecherche(camions,IDCamions,facture.IDCamions) alors
                      	tempo.camion = camions.Abreviation
                      fin
                      	
      
      				//            clederecherche = hconstruitvalcle(OrdreTrtXopt,Composant1Composant2Composant3Argon,...
      				//                                                           sansespace(fdetail.fdcomposant1),...
      				//                                                           sansespace(fdetail.fdcomposant2),...
      				//                                                           sansespace(fdetail.fdcomposant3),...
      				//                                                           gazargon)
      				clederecherche = hconstruitvalcle(OrdreTrtXopt,Composant1Composant2Composant3Argon,...
      				sansespace(fdetail.fdcomposant1),...
      				sansespace(fdetail.fdcomposant2),...
      				sansespace(fdetail.fdcomposant3),...
      				wargon)
      
      				si hlitrecherche(OrdreTrtXopt,Composant1Composant2Composant3Argon,clederecherche) alors
      					tempo.TordreXopt = OrdreTrtXopt.NoOrdre
      				sinon
      					tempo.TordreXopt = 999
      				fin            	
      				tempo.ttype = facture.facalcul
      				tempo.tdate = facture.fadate
      				tempo.tdaterequise = facture.FDATEREQUISE
      				tempo.tbase = composant
      				tempo.tqtebase  = tempoqte
      //				tempo.tqteoriginale = fdetail.fdqte
      //				tempo.tqte = fdetail.fdqte
      				tempo.tqteoriginale = fdetail.fdqteafacturer
      				tempo.tqte = fdetail.fdqteafacturer
      				//qteresiduelle -= 2
      				//			tempo.tnumligne = fdetail.fdligne
      				tempo.tnumligne = l
      				tempo.tcapgaztube = fdetail.fcapgaztube
      //				tempo.tenergiverre = invent.ienergieverre
      				tempo.tenergiverre = fdetail.fdenergiverre
      				//				si valide_trtspec(composant,rang)
      				//					//    si traitementspecial alors
      				//					tempo.ttraitementspecial = "O"
      				//				sinon
      				//					tempo.ttraitementspecial = "A"  // Jean hamelin
      				//				fin
      
      				si valide_trtspec1(composant,rang)
      					//    si traitementspecial alors
      					tempo.ttraitementspecial = "O"
      					tempo.trngtrtspe         = rangtrtspe
      					si GAUCHE(composant,2) = "CL" ALORS
      						tempo.tprodtrtspe        = noprodtrtspe
      					SINON
      						tempo.tprodtrtspe        = ""
      					FIN	
      
      				sinon
      					tempo.ttraitementspecial = "A"  // Jean hamelin
      					tempo.trngtrtspe = "  " // Jean hamelin
      					tempo.tprodtrtspe        = ""
      				fin
      
      
      				SI facture.facalcul = 1 alors 
      					//				tempo.tlargeur = numeriqueverschaine(val(fdetail.fdlargeur)/12 * 0.3048 * 1000,"d")
      					//				tempo.thauteur = numeriqueverschaine(val(fdetail.fdhauteur)/12 * 0.3048 * 1000,"d")
      					tempo.tlargeur = numeriqueverschaine(val(fdetail.fdlargeur)/12 * 0.3048 * 1000,"7.2f")
      					tempo.thauteur = numeriqueverschaine(val(fdetail.fdhauteur)/12 * 0.3048 * 1000,"7.2f")
      				sinon
      					//Code WinDev 5.5 remplacé par la migration :
      					//	tempo.tlargeur = verschaine(val(fdetail.fdlargeur) * 1000)
      					tempo.tlargeur = NumeriqueVersChaine(val(fdetail.fdlargeur) * 1000)
      					//Code WinDev 5.5 remplacé par la migration :
      					//	tempo.thauteur = verschaine(val(fdetail.fdhauteur) * 1000)
      					tempo.thauteur = NumeriqueVersChaine(val(fdetail.fdhauteur) * 1000)
      				fin
      				tempo.tlargeura = fdetail.fdlargeura
      				tempo.thauteura = fdetail.fdhauteura
      
      
      				tempo.TtypeSpacer = fdetail.ftypespacer
      				si hlitrecherche(typespac,tnumero,fdetail.ftypespacer) alors
      					tempo.tcouleurfond = typespac.icOuleur
      					tempo.tcouleurtexte = typespac.icOuleurtexte
      					tempo.tgras = typespac.Itextegras
      					tempo.Titalique = typespac.Itexteitalique
      					si typespac.ttype =   1 alors
      						tempo.ttypeintercalaire = "I"
      					sinon si typespac.ttype = 2
      						tempo.ttypeintercalaire = "A"
      					sinon si typespac.ttype = 3
      						tempo.ttypeintercalaire = "T"	
      					fin
      
      				fin
      
      				tempo.tespace = fdetail.fdespace
      				tempo.tespace2 = fdetail.fdespace2
      				tempo.tligne  = wligne
      				tempo.tprixuni  = fdetail.fdprixu
      				tempo.tprixupied = fdetail.fdprixupied
      				tempo.tdescription = fdetail.fddesc
      				tempo.tnumeroprep = prochainnumeroprep
      				tempo.tcarrelage = fdetail.fdcarrelage
      				tempo.TJOBLIGNE  = fdetail.FDJOBLIGNE 
      				tempo.tdoubletriple = doubletriple
      				tempo.tfini = fdetail.ffini
      				tempo.Tfabrication = fdetail.FDfabrication
      				tempo.tnoRecFdetail = HNumEnr(fdetail)
      				tempo.TIntercalaireSeulement = fdetail.fdintercalaire
      
      				tempo.tcouleurcarr = sansespace(fdetail.fNoPeintureExtTout)+" "+fdetail.fdescpeintureExtTout
      				tempo.tcouleurcarr2 = sansespace(fdetail.FnopeintureInterieure)+" "+fdetail.fDescPeintureInterieure
      				si pas fdetail.fdforme =  "" alors 
      
      					tempo.tnoforme = fdetail.fdforme
      					tempo.tw       = transformevaleur(fdetail.fdw)
      					tempo.tw1      = transformevaleur(fdetail.fdw1)
      					tempo.tw2      = transformevaleur(fdetail.fdw2)
      					tempo.th       = transformevaleur(fdetail.fdh)
      					tempo.th1      = transformevaleur(fdetail.fdh1)
      					tempo.th2      = transformevaleur(fdetail.fdh2)
      					tempo.td       = transformevaleur(fdetail.fdd)
      					tempo.tr       = transformevaleur(fdetail.fdr)
      					tempo.tr1       = transformevaleur(fdetail.fdr1)
      					tempo.tr2       = transformevaleur(fdetail.fdr2)
      					tempo.ts       = transformevaleur(fdetail.fds)
      					tempo.tf       = transformevaleur(fdetail.fdf)
      					tempo.tt1      = transformevaleurvf(fdetail.fdt1)
      					tempo.tt2      = transformevaleurvf(fdetail.fdt2)
      					tempo.tt3      = transformevaleurvf(fdetail.fdt3)
      					tempo.tt4      = transformevaleurvf(fdetail.fdt4)
      					tempo.tcapw    = fdetail.fdcapw
      					tempo.tcapw1   = fdetail.fdcapw1
      					tempo.tcapw2   = fdetail.fdcapw2
      					tempo.tcaph    = fdetail.fdcaph
      					tempo.tcaph1   = fdetail.fdcaph1
      					tempo.tcaph2   = fdetail.fdcaph2
      					tempo.tcapd    = fdetail.fdcapd
      					tempo.tcapr    = fdetail.fdcapr
      					tempo.tcapr1    = fdetail.fdcapr1
      					tempo.tcapr2    = fdetail.fdcapr2
      					tempo.tcaps    = fdetail.fdcaps
      					tempo.tcapf    = fdetail.fdcapf
      					tempo.tnombre  = fdetail.fnombre
      					tempo.tcarreauh = fdetail.fdcarreauh
      					tempo.tcarreauv = fdetail.fdcarreauv
      					tempo.tnumcarr = fdetail.fdnumcarr
      					tempo.TDescCarr = fdetail.fddesccarr
      					
      					tempo.tnotes = fdetail.fnotes 
      					tempo.tnote2 = fdetail.fnotes1
      					tempo.TtypeCalcul = fdetail.fdtypecalcul
      					hlitrecherche("forme","fnumero",fdetail.fdforme)
      					//Code WinDev 5.5 remplacé par la migration :
      					//	si pas h.endehors et h.trouve alors
      					si pas HEnDehors() et HTrouve() alors
      						tempo.twordre = forme.wordre
      						tempo.tw1ordre = forme.w1ordre
      						tempo.tw2ordre = forme.w2ordre
      						tempo.thordre = forme.hordre
      						tempo.th1ordre = forme.h1ordre
      						tempo.th2ordre = forme.h2ordre
      						tempo.tt1ordre = forme.t1ordre
      						tempo.tt2ordre = forme.t2ordre
      						tempo.tt3ordre = forme.t3ordre
      						tempo.tt4ordre = forme.t4ordre
      						tempo.trordre = forme.rordre
      						tempo.tr1ordre = forme.r1ordre
      						tempo.tr2ordre = forme.r2ordre
      						tempo.tdordre = forme.dordre
      						tempo.tsordre = forme.sordre
      						tempo.tfordre = forme.fordre
      					FIN
      
      				FIN
      				pour i = 1 a 10
      					{"tempo.tnbmorceau"+i} = fdetail.FDnbmorceau[i]
      					{"tempo.tnbdimension"+i} = fdetail.fddimension[i]
      				FIN
      				tempo.Tvx = fdetail.fdvariablex
      				tempo.Tvx1 = fdetail.fdvariablex1
      				tempo.TMatch = 0
      				tempo.tddv = fdetail.fdddv
      				tempo.tddh = fdetail.fdddh
      				tempo.tdt = fdetail.fdt
      				tempo.TDemiCarrelage = fdetail.TDemiCarrelage
      				tempo.tposition = Fdetailtempo.Tposition
      				tempo.tQteTotal = Fdetailtempo.fQteTotal
      				tempo.PoidsUnitaire = Fdetailtempo.PoidsUnitaire
      				
      				hajoute("tempo")
      				//Code WinDev 5.5 remplacé par la migration :
      				//si hdejabloque() alors
      				si HErreurBlocage() alors
      					acso_message("Erreur","Information déjà en utilisation","Erreur")
      				fin   
      			FIN
      			wligne++
      			l++
      			//			fin
      
      		fin
      
      fin
      
      
      si sansespace(composant) <> "" alors
      	ListeCpt=""
      	pour i = 1 a tempo.tqte
      		//		pour j = 1 a tempo.tqtebase //pas 2
      		//		listecpt=""
      		//		listecpt+=tempo.TECLEUNIK+"/"//+cpt+"-"
      
      		si tempo.tdoubletriple = "Triple" alors 
      			//			si j=1 alors
      			selon tempo.tqtebase
      				cas 1
      					
      					ListeCpt+=NumériqueVersChaîne(cpt,"03d")+"-"
      					cptdepart = cpt+1
      					cpt+=3
      					//CptDepart=cpt+3
      					//                        cpt+=1
      				cas 2
      					ListeCpt+=NumériqueVersChaîne(cpt,"03d")+"-"+NumériqueVersChaîne((cpt+1),"03d")+"-"
      					cptdepart = cpt+2
      					cpt+=3
      					//CptDepart=cpt+3
      				cas 3
      					ListeCpt+=NumériqueVersChaîne(cpt,"03d")+"-"+NumériqueVersChaîne((cpt+1),"03d")+"-"+NumériqueVersChaîne((cpt+2),"03d")+"-"
      					cptdepart = cpt+3
      					cpt+=3
      					//CptDepart=cpt+3
      					//					cpt+=1
      			fin
      
      //			fecrit(lid,composant+","+listecpt+rc)
      
      		sinon si Tempo.tdoubletriple = "Double"
      			selon tempo.tqtebase
      				cas 1
      					ListeCpt+=NumériqueVersChaîne(cpt,"03d")+"-"
      					cptdepart = cpt+1
      					cpt+=2
      					//CptDepart=cpt+2
      					//					cpt+=2
      				cas 2
      					ListeCpt+=NumériqueVersChaîne(cpt,"03d")+"-"+NumériqueVersChaîne((cpt+1),"03d")+"-"
      					cptdepart = cpt+2
      					cpt+=2
      					//CptDepart=cpt+2
      					//					cpt+=1
      			fin
      
      			//			listecpt+="1,"
      //			fecrit(lid,composant+","+listecpt+rc)
      		sinon si Tempo.tdoubletriple = "Simple"
      
      			
      			ListeCpt+=NumériqueVersChaîne(cpt,"03d")+"-"
      			CptDepart = cpt+1
      			cpt+=1
      		FIN
      
      		tempo.tnoRack = ListeCpt
      
      		tempo.TdimensionTri = arrondi(fdetailtempo.HAUTEUR)
      		tempo.idfdetailtempo = Fdetailtempo.IDFdetailtempo
      
      		//        tempo.tdea = " De " + lcpt +" A " + (CptDepart-1)
      		HModifie(tempo,hNumEnrEnCours)
      		//cpt+=lincrement
      		//cpt=CptDepart
      		
      		//		FIN
      		//		selon tempo.tdoubletriple
      		//			cas "Double"
      		//				si tempo.tqtebase = 1 alors
      		//					cpt++
      		//				fin
      		//			cas "Triple"
      		//				si tempo.tqtebase = 1 alors
      		//					cpt++
      		//				sinon si tempo.tqtebase = 2 alors
      		//					cpt++	
      		//				fin
      		//
      		//		fin
      		//
      
      FIN
      
      
      fin
      
      
      
      renvoyer vrai
      CAS EXCEPTION:
      	info("")
      CAS ERREUR:
      	info("")
     type : 458752
   -
     name : transformevaleur
     procedure_id : 4511921513423524995
     type_code : 14
     code : |1+
      Procédure transformevaleur(valeuratransformer)
      valeuraretourner est une chaine
      si facture.facalcul = 1 alors
        valeuraretourner  = numeriqueverschaine(val(valeuratransformer) / 12 * 0.3048 * 1000,"5d")
      //	tempo.tlargeur = numeriqueverschaine(val(fdetail.fdlargeur)/12 * 0.3048 * 1000,"d")
      sinon
        valeuraretourner  = numeriqueverschaine(val(valeuratransformer) * 1000,"5d")
      //  tempo.tlargeur = verschaine(val(fdetail.fdlargeur) * 1000)
      fin
      
      renvoyer remplir_zero(valeuraretourner , 5)
      
     type : 458752
   -
     name : transformevaleurvf
     procedure_id : 4511921514619819149
     type_code : 14
     code : |1+
      Procédure transformevaleurvf(valeuratransformer)
      
      si valeuratransformer = "O" alors
      	renvoyer "00001"
      sinon
      	renvoyer "00000"	
      FIN
      
     type : 458752
   -
     name : trouvesecteur
     procedure_id : 4511921513639007373
     type_code : 14
     code : |1+
      Procédure trouvesecteur(numero)
      valeuraretourner est une chaine = ""
      
      //Code WinDev 5.5 remplacé par la migration :
      //hlitrecherchesansbloquer("secteur","secteur",numero)
      hlitrecherche("secteur","secteur",numero)
      //Code WinDev 5.5 remplacé par la migration :
      //si pas h.endehors alors
      si pas HEnDehors() alors
      //Code WinDev 5.5 remplacé par la migration :
      //	si h.trouve alors
      	si HTrouve() alors
      		valeuraretourner = secteur.sdescription
      	FIN
      FIN
      
      
      renvoyer valeuraretourner
      
     type : 458752
   -
     name : valide_composant
     procedure_id : 4511921514132952215
     type_code : 14
     code : |1+
      Procédure valide_composant(ligne = 0)
      nTempoqte		est un entier
      doubletriple	est une chaine
      aucunpdebase	est un booleen	= faux
      aucunpdebase1	est un booleen	= faux
      aucunpdebase2	est un booleen	= faux
      aucunpdebase3	est un booleen	= faux
      unenergiverre	est un booleen			// pour savoir si un composant est un énérgiverre
      unsurface		est un booleen			// pour savoir si un composant imprime surface intérieure
      produit1eng		est un booleen	= faux	//  vrai si produit est energiverre
      produit2eng		est un booleen	= faux	//             "
      produit3eng		est un booleen	= faux	//             "
      argon			est un booleen	= faux 
      lPdeBase		est une chaine
      lCptDepart		est un entier	= cptdepart
      si pas position(fdetail.fcapgaztube,"Z") = 0 aLORS
      	argon = vrai
      sinon
      	argon = faux
      FIN
      
      traitementspecial	= faux
      forme				= ""
      si fdetail.fdverreunite alors
      	//info("verre a l'unite")
      	si hlitrecherche("invent","INUM",fdetail.fdnumprod) alors
      		si invent.ipbase <> "" alors
      			lPdeBase = invent.ipbase
      			si hlitrecherche(invent,INUM,lPdeBase) alors
      				si pas invent.iBASE alors
      					aucunpdebase1 = vrai
      				fin			  
      				si (invent.ienergieverre OU invent.ienergieverreESC) alors
      					produit1eng		= vrai
      					unenergiverre	= vrai
      				sinon
      					si invent.isurfaceinterieure alors
      						unsurface = vrai
      					FIN
      				FIN
      				
      			FIN
      			remplir_tempo(lPdeBase,1,forme,doubletriple,1,aucunpdebase,unenergiverre,unsurface,produit1eng,faux,lCptDepart)
      			
      		FIN
      	FIN
      	
      	
      	
      FIN
      hlitrecherche("invent","INUM",fdetail.fdcomposant1)
      //Code WinDev 5.5 remplacé par la migration :
      //si pas h.endehors et h.trouve alors
      si pas HEnDehors() et HTrouve() alors
      	si pas invent.iBASE alors
      		aucunpdebase1 = vrai
      	fin			  
      	si (invent.ienergieverre OU invent.ienergieverreESC) alors
      		produit1eng		= vrai
      		unenergiverre	= vrai
      	sinon
      		si invent.isurfaceinterieure alors
      			unsurface = vrai
      		FIN
      	FIN
      FIN
      hlitrecherche("invent","INUM",fdetail.fdcomposant2)
      //Code WinDev 5.5 remplacé par la migration :
      //si pas h.endehors et h.trouve alors
      si pas HEnDehors() et HTrouve() alors
      	si pas invent.IBASE alors
      		aucunpdebase2 = vrai
      	fin			  
      	si (invent.ienergieverre OU invent.ienergieverreESC) alors
      		produit2eng		= vrai
      		unenergiverre	= vrai
      	sinon
      		si invent.isurfaceinterieure alors
      			unsurface = vrai
      		FIN
      	FIN
      FIN
      si sansespace(fdetail.fdcomposant3) = "" alors
      	aucunpdebase3 = vrai
      sinon
      	hlitrecherche("invent","INUM",fdetail.fdcomposant3)
      	//Code WinDev 5.5 remplacé par la migration :
      	//si pas h.endehors et h.trouve alors
      	si pas HEnDehors() et HTrouve() alors
      		si pas invent.IBASE alors
      			aucunpdebase3 = vrai
      		fin			  
      		si (invent.ienergieverre OU invent.ienergieverreESC) alors
      			produit3eng		= vrai
      			unenergiverre	= vrai
      		sinon
      			si invent.isurfaceinterieure alors
      				unsurface = vrai
      			FIN
      		FIN
      	FIN
      fin
      si  aucunpdebase1 et aucunpdebase2 et aucunpdebase3 alors
      	aucunpdebase = vrai
      fin	 
      //info(aucunpdebase)
      //hlitrecherche("invent","INUM",fdetail.fdnumprod)
      //si pas h.endehors et  h.trouve ET PAS fdetail.fdnumprod = ""  alors
      
      //		renvoyer faux
      //sinon
      //traitementspecial = valide_traitement_special()
      
      //hlitrecherche("ENSEMBLE","ennumero",fdetail.fdnumprod)
      //  si (pas h.endehors et  h.trouve) OU fdetail.fdnumprod = "" alors 
      SI pas fdetail.fdcomposant1 = "" et pas fdetail.fdcomposant2 = "" et pas fdetail.fdcomposant3 = "" alors      
      	si sansespace(fdetail.fdcomposant3) = "" alors
      		
      		doubletriple = "Double" 
      	sinon
      		doubletriple = "Triple" 
      		
      	FIN
      	doubletriple =  thermostype[CalculNombreVerre(Fdetail.fdcomposant1,Fdetail.fdcomposant2,Fdetail.fdcomposant3)]
      	
      	////////////////////////////////////////////////////////////
      	// Pour garder la position des verres
      	// Selon gclConfig.m_bComponentPositionForPrep dans le fichier Config.ComponentPositionForPrep 
      	// si vrai alors optimise selon la position des verres dans le thermos
      	si gclConfig.m_bComponentPositionForPrep alors	
      //		remplir_tempo(Fdetail.fdcomposant1,1,forme,doubletriple,1,aucunpdebase,unenergiverre,unsurface,produit1eng,argon,lCptDepart,3)
      //		remplir_tempo(Fdetail.fdcomposant2,1,forme,doubletriple,2,aucunpdebase,unenergiverre,unsurface,produit2eng,argon,lCptDepart+1,3)
      //		remplir_tempo(Fdetail.fdcomposant3,1,forme,doubletriple,3,aucunpdebase,unenergiverre,unsurface,produit3eng,argon,lCptDepart+2,3)
      		
      		SI Fdetail.fdcomposant1 = Fdetail.fdcomposant2 ET Fdetail.fdcomposant2 <> Fdetail.fdcomposant3 ALORS
      			remplir_tempo_new(Fdetail.fdcomposant1,2,forme,doubletriple,"12",aucunpdebase,unenergiverre,unsurface,produit1eng,argon,lCptDepart)
      			remplir_tempo_new(Fdetail.fdcomposant3,1,forme,doubletriple,"3",aucunpdebase,unenergiverre,unsurface,produit3eng,argon,lCptDepart)
      		SINON
      			SI Fdetail.fdcomposant1<> Fdetail.fdcomposant2 ET Fdetail.fdcomposant1 = Fdetail.fdcomposant3 ALORS
      				remplir_tempo_new(Fdetail.fdcomposant1,2,forme,doubletriple,"13",aucunpdebase,unenergiverre,unsurface,produit1eng,argon,lCptDepart)
      				remplir_tempo_new(Fdetail.fdcomposant2,1,forme,doubletriple,"2",aucunpdebase,unenergiverre,unsurface,produit2eng,argon,lCptDepart)
      			SINON
      				SI Fdetail.fdcomposant1 = Fdetail.fdcomposant3 ET Fdetail.fdcomposant2 <> Fdetail.fdcomposant3 ALORS
      					remplir_tempo_new(Fdetail.fdcomposant1,2,forme,doubletriple,"13",aucunpdebase,unenergiverre,unsurface,produit1eng,argon,lCptDepart)
      					remplir_tempo_new(Fdetail.fdcomposant2,1,forme,doubletriple,"2",aucunpdebase,unenergiverre,unsurface,produit1eng,argon,lCptDepart+1)
      					
      				SINON	
      					SI Fdetail.fdcomposant1 = Fdetail.fdcomposant3 ET Fdetail.fdcomposant2 = Fdetail.fdcomposant3 ALORS
      						remplir_tempo_new(Fdetail.fdcomposant1,3,forme,doubletriple,"123",aucunpdebase,unenergiverre,unsurface,produit1eng,argon,lCptDepart)
      					SINON
      						SI Fdetail.fdcomposant1 <> Fdetail.fdcomposant3 ET Fdetail.fdcomposant2 <> Fdetail.fdcomposant3 ALORS
      							SI SansEspace(Fdetail.fdcomposant3) <> "" ALORS
      								remplir_tempo_new(Fdetail.fdcomposant1,1,forme,doubletriple,"1",aucunpdebase,unenergiverre,unsurface,produit1eng,argon,lCptDepart,3)
      								remplir_tempo_new(Fdetail.fdcomposant2,1,forme,doubletriple,"2",aucunpdebase,unenergiverre,unsurface,produit2eng,argon,lCptDepart,3)
      								remplir_tempo_new(Fdetail.fdcomposant3,1,forme,doubletriple,"3",aucunpdebase,unenergiverre,unsurface,produit3eng,argon,lCptDepart,3)
      							SINON
      								remplir_tempo_new(Fdetail.fdcomposant1,1,forme,doubletriple,"1",aucunpdebase,unenergiverre,unsurface,produit1eng,argon,lCptDepart)
      								remplir_tempo_new(Fdetail.fdcomposant2,1,forme,doubletriple,"2",aucunpdebase,unenergiverre,unsurface,produit2eng,argon,lCptDepart)
      							FIN
      							
      						SINON
      							SI Fdetail.fdcomposant1 <> Fdetail.fdcomposant2 ET Fdetail.fdcomposant2 = Fdetail.fdcomposant3 ALORS
      								remplir_tempo_new(Fdetail.fdcomposant1,1,forme,doubletriple,"1",aucunpdebase,unenergiverre,unsurface,produit1eng,argon,lCptDepart)
      								remplir_tempo_new(Fdetail.fdcomposant2,2,forme,doubletriple,"23",aucunpdebase,unenergiverre,unsurface,produit2eng,argon,lCptDepart)
      							FIN	
      						FIN
      					FIN	   
      				FIN
      			FIN	
      			
      			
      			
      			
      			//remplir_tempo(fdetail.fdcomposant1,tempoqte)
      		FIN
      		
      		
      		
      		
      		
      		
      		//////////////////////////////////////////////////////////////
      	sinon	
      		
      		// ici on integre le remplissage de videojet
      		
      		si fdetail.fdcomposant1 = fdetail.fdcomposant2 et fdetail.fdcomposant2 <> fdetail.fdcomposant3 alors
      			remplir_tempo(fdetail.fdcomposant1,2,forme,doubletriple,1,aucunpdebase,unenergiverre,unsurface,produit1eng,argon,lCptDepart)
      			remplir_tempo(fdetail.fdcomposant3,1,forme,doubletriple,3,aucunpdebase,unenergiverre,unsurface,produit3eng,argon,lCptDepart+2)
      		sinon
      			si fdetail.fdcomposant1<> fdetail.fdcomposant2 et fdetail.fdcomposant1 = fdetail.fdcomposant3 alors
      				remplir_tempo(fdetail.fdcomposant1,2,forme,doubletriple,1,aucunpdebase,unenergiverre,unsurface,produit1eng,argon,lCptDepart)
      				remplir_tempo(fdetail.fdcomposant2,1,forme,doubletriple,2,aucunpdebase,unenergiverre,unsurface,produit2eng,argon,lCptDepart+2)
      			sinon
      				si fdetail.fdcomposant1 = fdetail.fdcomposant3 et fdetail.fdcomposant2 <> fdetail.fdcomposant3 alors
      					remplir_tempo(fdetail.fdcomposant1,2,forme,doubletriple,1,aucunpdebase,unenergiverre,unsurface,produit1eng,argon,lCptDepart)
      					remplir_tempo(fdetail.fdcomposant2,1,forme,doubletriple,2,aucunpdebase,unenergiverre,unsurface,produit1eng,argon,lCptDepart+2)
      					
      				sinon	
      					si fdetail.fdcomposant1 = fdetail.fdcomposant3 et fdetail.fdcomposant2 = fdetail.fdcomposant3 alors
      						remplir_tempo(fdetail.fdcomposant1,3,forme,doubletriple,2,aucunpdebase,unenergiverre,unsurface,produit1eng,argon,lCptDepart)
      					sinon
      						si fdetail.fdcomposant1 <> fdetail.fdcomposant3 et fdetail.fdcomposant2 <> fdetail.fdcomposant3 alors
      							si SansEspace(fdetail.fdcomposant3) <> "" alors
      								remplir_tempo(fdetail.fdcomposant1,1,forme,doubletriple,1,aucunpdebase,unenergiverre,unsurface,produit1eng,argon,lCptDepart,3)
      								remplir_tempo(fdetail.fdcomposant2,1,forme,doubletriple,2,aucunpdebase,unenergiverre,unsurface,produit2eng,argon,lCptDepart+1,3)
      								remplir_tempo(fdetail.fdcomposant3,1,forme,doubletriple,3,aucunpdebase,unenergiverre,unsurface,produit3eng,argon,lCptDepart+2,3)
      							sinon
      								remplir_tempo(fdetail.fdcomposant1,1,forme,doubletriple,1,aucunpdebase,unenergiverre,unsurface,produit1eng,argon,lCptDepart)
      								remplir_tempo(fdetail.fdcomposant2,1,forme,doubletriple,2,aucunpdebase,unenergiverre,unsurface,produit2eng,argon,lCptDepart+1)
      							fin
      							
      						sinon
      							si fdetail.fdcomposant1 <> fdetail.fdcomposant2 et fdetail.fdcomposant2 = fdetail.fdcomposant3 alors
      								remplir_tempo(fdetail.fdcomposant1,1,forme,doubletriple,1,aucunpdebase,unenergiverre,unsurface,produit1eng,argon,lCptDepart)
      								remplir_tempo(fdetail.fdcomposant2,2,forme,doubletriple,2,aucunpdebase,unenergiverre,unsurface,produit2eng,argon,lCptDepart+1)
      							fin	
      						fin
      					fin	   
      				FIN
      			fin	
      			
      			
      			
      			
      			//remplir_tempo(fdetail.fdcomposant1,tempoqte)
      		FIN
      	FIN
      	
      fin
      
      //FIN
      
     type : 458752
   -
     name : valide_traitement_special
     procedure_id : 4511921517827020097
     type_code : 14
     code : |1+
      Procédure valide_traitement_special()
      valeuraretourner est un booleen = faux
      
      si pas sansespace(fdetail.fdcomposant1) = "" alors
      	hlitrecherche("invent","INUM",fdetail.fdcomposant1)
      //Code WinDev 5.5 remplacé par la migration :
      //	si pas h.endehors et h.trouve alors
      	si pas HEnDehors() et HTrouve() alors
      		si invent.itraitementspecial alors
      			si fdetail.fdcomposant2 = invent.inumerotraitementspec ou ...
      			fdetail.fdcomposant3 = invent.inumerotraitementspec  alors
      			valeuraretourner = vrai
      	    fin   
      	FIN
      FIN
      fin
      
      si pas valeuraretourner alors
      	si pas sansespace(fdetail.fdcomposant2) = "" alors
      		
      		hlitrecherche("invent","INUM",fdetail.fdcomposant2)
      //Code WinDev 5.5 remplacé par la migration :
      //		si pas h.endehors et h.trouve alors
      		si pas HEnDehors() et HTrouve() alors
      			si invent.itraitementspecial alors
      				si fdetail.fdcomposant1 = invent.inumerotraitementspec ou ...
      				fdetail.fdcomposant3 = invent.inumerotraitementspec  alors
      				valeuraretourner = vrai
      			fin   
      		FIN
      	FIN
      fin
      fin
      
      si pas valeuraretourner alors
      	si pas sansespace(fdetail.fdcomposant3) = "" alors
      		
      		hlitrecherche("invent","INUM",fdetail.fdcomposant3)
      //Code WinDev 5.5 remplacé par la migration :
      //		si pas h.endehors et h.trouve alors
      		si pas HEnDehors() et HTrouve() alors
      			si invent.itraitementspecial alors
      				si fdetail.fdcomposant1 = invent.inumerotraitementspec ou ...
      				fdetail.fdcomposant2 = invent.inumerotraitementspec  alors
      				valeuraretourner = vrai
      			fin   
      		FIN
      	FIN
      fin
      fin
      
      renvoyer valeuraretourner
      
     type : 458752
   -
     name : valide_trtspec
     procedure_id : 4511921518126978399
     type_code : 14
     code : |1+
      Procédure valide_trtspec(composant,rang)
      
      valeuraretourner est un booleen = faux
      
      hlitrecherche("invent","INUM",composant)
      
      si pas invent.itraitementspecial alors
      	renvoyer valeuraretourner
      FIN
      
      si rang = 1 alors
      	si fdetail.fdcomposant2 = invent.inumerotraitementspec ou 	fdetail.fdcomposant3 = invent.inumerotraitementspec  alors
      	valeuraretourner = vrai
      	fin
      fin         
      
      si rang = 2 alors
      	si fdetail.fdcomposant1 = invent.inumerotraitementspec ou 	fdetail.fdcomposant3 = invent.inumerotraitementspec  alors
      	valeuraretourner = vrai
      fin
      fin         
      si rang = 3 alors
      	si fdetail.fdcomposant1 = invent.inumerotraitementspec ou 	fdetail.fdcomposant2 = invent.inumerotraitementspec  alors
      	valeuraretourner = vrai
      fin
      fin  
      
      renvoyer valeuraretourner
      
     type : 458752
   -
     name : verif
     procedure_id : 4511921519389398387
     type_code : 14
     code : |1+
      Procédure verif()
      dndcurseur(dnddefaut)
      
     type : 458752
   -
     name : valide_composant_OPTIMA
     procedure_id : 4573494920423658184
     type_code : 14
     code : |1+
      Procédure valide_composant_OPTIMA(ligne = 0)
      tempoqte est un entier
      doubletriple est une chaine
      aucunpdebase est un booleen = faux
      aucunpdebase1 est un booleen = faux
      aucunpdebase2 est un booleen = faux
      aucunpdebase3 est un booleen = faux
      unenergiverre est un booleen  // pour savoir si un composant est un énérgiverre
      unsurface est un booleen   // pour savoir si un composant imprime surface intérieure
      produit1eng est un booleen = faux //  vrai si produit est energiverre
      produit2eng est un booleen  = faux //             "
      produit3eng est un booleen = faux //             "
      argon est un booleen = faux 
      qteresuduelle est un entier
           
      si pas position(fdetail.fcapgaztube,"Z") = 0 aLORS
      		argon = vrai
      sinon
              argon = faux
      FIN
      	 
      traitementspecial = faux
      si fdetail.fdforme99 alors
      	forme = "99"
      	si fdetail.ftype = 1 alors
      		remplir_tempo99(fdetail.fdcomposant1,1)  
      	fin
      sinon
      	forme = ""
      FIN
      hlitrecherche("invent","INUM",fdetail.fdcomposant1)
      //Code WinDev 5.5 remplacé par la migration :
      //si pas h.endehors et h.trouve alors
      si pas HEnDehors() et HTrouve() alors
         si pas invent.iBASE alors
            aucunpdebase1 = vrai
         fin			  
      si (invent.ienergieverre OU invent.ienergieverreESC) alors
          produit1eng = vrai
      	unenergiverre = vrai
      sinon
      	si invent.isurfaceinterieure alors
      		unsurface = vrai
      	FIN
      FIN
      FIN
      hlitrecherche("invent","INUM",fdetail.fdcomposant2)
      //Code WinDev 5.5 remplacé par la migration :
      //si pas h.endehors et h.trouve alors
      si pas HEnDehors() et HTrouve() alors
         si pas invent.IBASE alors
            aucunpdebase2 = vrai
         fin			  
      si (invent.ienergieverre OU invent.ienergieverreESC) alors
          produit2eng = vrai
      	unenergiverre = vrai
      sinon
      	si invent.isurfaceinterieure alors
      		unsurface = vrai
      	FIN
      FIN
      FIN
      si sansespace(fdetail.fdcomposant3) = "" alors
            aucunpdebase3 = vrai
      sinon
      hlitrecherche("invent","INUM",fdetail.fdcomposant3)
      //Code WinDev 5.5 remplacé par la migration :
      //si pas h.endehors et h.trouve alors
      si pas HEnDehors() et HTrouve() alors
         si pas invent.IBASE alors
            aucunpdebase3 = vrai
         fin			  
      si (invent.ienergieverre OU invent.ienergieverreESC) alors
          produit3eng = vrai
      	unenergiverre = vrai
      sinon
      	si invent.isurfaceinterieure alors
      		unsurface = vrai
      	FIN
      FIN
      FIN
      fin
      si  aucunpdebase1 et aucunpdebase2 et aucunpdebase3 alors
        aucunpdebase = vrai
      fin	 
      //info(aucunpdebase)
      //hlitrecherche("invent","INUM",fdetail.fdnumprod)
      //si pas h.endehors et  h.trouve ET PAS fdetail.fdnumprod = ""  alors
      
      //		renvoyer faux
      //sinon
      //traitementspecial = valide_traitement_special()
      
      //hlitrecherche("ENSEMBLE","ennumero",fdetail.fdnumprod)
      //  si (pas h.endehors et  h.trouve) OU fdetail.fdnumprod = "" alors 
      SI pas fdetail.fdcomposant1 = "" et pas fdetail.fdcomposant2 = "" et pas fdetail.fdcomposant3 = "" alors      
      	si sansespace(fdetail.fdcomposant3) = "" alors
      		
      		doubletriple = "Double" 
      	sinon
      		doubletriple = "Triple" 
      		
      	FIN
      	
      		doubletriple =  thermostype[CalculNombreVerre(Fdetail.fdcomposant1,Fdetail.fdcomposant2,Fdetail.fdcomposant3)]
      	
      	// ici on integre le remplissage de videojet
      	
      	si fdetail.fdcomposant1 = fdetail.fdcomposant2 et fdetail.fdcomposant2 <> fdetail.fdcomposant3 alors
      		remplir_tempo(fdetail.fdcomposant1,2,forme,doubletriple,1,aucunpdebase,unenergiverre,unsurface,produit1eng,argon)
      		remplir_tempo(fdetail.fdcomposant3,1,forme,doubletriple,3,aucunpdebase,unenergiverre,unsurface,produit3eng,argon)
      	sinon
      		si fdetail.fdcomposant1<> fdetail.fdcomposant2 et fdetail.fdcomposant1 = fdetail.fdcomposant3 alors
      		    remplir_tempo(fdetail.fdcomposant1,2,forme,doubletriple,1,aucunpdebase,unenergiverre,unsurface,produit1eng,argon)
      			remplir_tempo(fdetail.fdcomposant2,1,forme,doubletriple,2,aucunpdebase,unenergiverre,unsurface,produit2eng,argon)
      		sinon
                  si fdetail.fdcomposant1 = fdetail.fdcomposant3 et fdetail.fdcomposant2 <> fdetail.fdcomposant3 alors
                   	remplir_tempo(fdetail.fdcomposant1,2,forme,doubletriple,1,aucunpdebase,unenergiverre,unsurface,produit1eng,argon)
       	            remplir_tempo(fdetail.fdcomposant2,1,forme,doubletriple,2,aucunpdebase,unenergiverre,unsurface,produit1eng,argon)
      				
      		    sinon	
                      si fdetail.fdcomposant1 = fdetail.fdcomposant3 et fdetail.fdcomposant2 = fdetail.fdcomposant3 alors
      					remplir_tempo(fdetail.fdcomposant1,3,forme,doubletriple,2,aucunpdebase,unenergiverre,unsurface,produit1eng,argon)
      		    	sinon
      					si fdetail.fdcomposant1 <> fdetail.fdcomposant3 et fdetail.fdcomposant2 <> fdetail.fdcomposant3 alors
      						remplir_tempo(fdetail.fdcomposant1,1,forme,doubletriple,1,aucunpdebase,unenergiverre,unsurface,produit1eng,argon)
      						remplir_tempo(fdetail.fdcomposant2,1,forme,doubletriple,2,aucunpdebase,unenergiverre,unsurface,produit2eng,argon)
      						remplir_tempo(fdetail.fdcomposant3,1,forme,doubletriple,3,aucunpdebase,unenergiverre,unsurface,produit3eng,argon)
      					sinon
      						si fdetail.fdcomposant1 <> fdetail.fdcomposant2 et fdetail.fdcomposant2 = fdetail.fdcomposant3 alors
      							remplir_tempo(fdetail.fdcomposant1,1,forme,doubletriple,1,aucunpdebase,unenergiverre,unsurface,produit1eng,argon)
      							remplir_tempo(fdetail.fdcomposant2,2,forme,doubletriple,2,aucunpdebase,unenergiverre,unsurface,produit2eng,argon)
      						fin	
      					fin
      				fin	   
      		    FIN
      		fin	
      		
      		
      		
      		
      		//remplir_tempo(fdetail.fdcomposant1,tempoqte)
      	FIN
      fin
      
      //FIN
      
     type : 458752
   -
     name : AjouterTableau
     procedure_id : 5051820695776232294
     type_code : 14
     code : |1+
      Procédure AjouterTableau(ltype,lproduit,largeur,lhauteur,ltypecalcul="",ldesc="",lAnglaismetrique=1,lqte=1)
      ldimension est un reel
      ltrouve est un entier
      i est un entier
      
      
      
      
      selon ltype
      	cas 1	
      		selon lAnglaismetrique
      			cas 1
      				ldimension = arrondi(val(largeur) * val(lhauteur) / 144,2)
      			cas 2
      				ldimension = arrondi(val(largeur) * val(lhauteur) / 1000000 * gclconfig.m_rConversionam,2)
      		fin
      		
      		si sansespace(lproduit) <> "" alors
      			si hlitrecherche(TQtePrep,TNoProdTtypeCalcul,HConstruitValClé(TQtePrep,TNoProdTtypeCalcul,lproduit,"")) alors
      				TQtePrep.TDimension+=(ldimension * lqte)
      				TQtePrep.tqte+=lqte
      				hmodifie(TQtePrep,hNumEnrEnCours)
      			sinon
      				TQtePrep.tdesc = ldesc
      				TQtePrep.TNoProd = lproduit
      				TQtePrep.TDimension = (ldimension * lqte)
      				TQtePrep.tType = ltype
      				TQtePrep.TtypeCalcul = ""
      				TQtePrep.tqte=lqte
      				tqteprep.TNoLot = prochainnumeroprep
      				hajoute(TQtePrep)
      			fin
      		sinon
      			SI HLitRecherche(TQtePrep,tdescTtypeCalcul,HConstruitValClé(TQtePrep,tdescTtypeCalcul,ldesc,"")) ALORS
      				TQtePrep.TDimension+=(ldimension * lqte)
      				TQtePrep.tqte+=lqte
      				HModifie(TQtePrep,hNumEnrEnCours)
      			SINON
      				TQtePrep.tdesc = ldesc
      				TQtePrep.TNoProd = lproduit
      				TQtePrep.TDimension = (ldimension * lqte)
      				TQtePrep.tType = ltype
      				TQtePrep.TtypeCalcul = ""
      				TQtePrep.tqte=lqte
      				TQtePrep.TNoLot = prochainnumeroprep
      				HAjoute(TQtePrep)
      			FIN
      			
      		fin
      	cas 2	
      		si hlitrecherche(TQtePrep,TNoProdTtypeCalcul,HConstruitValClé(TQtePrep,TNoProdTtypeCalcul,lproduit,ltypecalcul)) alors
      			TQtePrep.TDimension+= calcul_nb_carreau(lproduit,largeur,lhauteur,ltypecalcul) * lqte
      			TQtePrep.tqte+=lqte
      			hmodifie(TQtePrep,hNumEnrEnCours)
      		sinon
      			TQtePrep.tdesc = ldesc
      			TQtePrep.TNoProd = lproduit
      			TQtePrep.TDimension = calcul_nb_carreau(lproduit,largeur,lhauteur,ltypecalcul) * lqte
      			TQtePrep.tType = ltype
      			TQtePrep.TtypeCalcul = ltypecalcul
      			TQtePrep.tqte=lqte
      			tqteprep.TNoLot = prochainnumeroprep
      			hajoute(TQtePrep)
      		fin
      		
      FIN
      
      
      
      
      
      
      
     type : 458752
   -
     name : remplir_tempo_unite
     procedure_id : 5051839511425997920
     type_code : 14
     code : |1+
      Procédure remplir_tempo_unite(composant,tempoqte,forme = "",doubletriple="",rang=0,aucunpdebase=faux,unenergiverre=faux,unsurface=faux,produiteng=faux,wargon=faux)
      GazArgon est un booleen
      clederecherche est une chaine
      qteresiduelle est un entier = fdetail.fdqte
      i est un entier
      k est un entier
      j est un entier
      l est un entier = 1
      recordcourant est un entier
      si sansespace(composant) <> "" alors
      	pour k = 1 a fdetail.fdqte pas 2 
      		tempo.targon = faux
      		si forme = "" alors
      
      			si pas HEnDehors() et HTrouve() alors
      				tempo.timprimeetiq = invent.iimprimeetiq
      				tempo.tproduitdebase = invent.ibase
      				tempo.tpriorite   = invent.ipriorite
      				tempo.tsurfaceinterieure = faux
      
      				si produiteng alors
      
      					tempo.tsurfaceinterieure = vrai
      					si wargon alors
      						tempo.targon = vrai
      						GazArgon = "1"
      					sinon
      						GazArgon = "0"
      					FIN
      				sinon	
      					si pas unenergiverre et unsurface alors
      						si invent.ibase alors
      							tempo.tsurfaceinterieure = vrai
      
      						FIN
      					FIN
      				FIN
      
      				tempo.tienergiverre = (invent.ienergieverre OU invent.ienergieverreESC)
      			sinon
      				tempo.tproduitdebase = invent.ibase
      				tempo.timprimeetiq = faux
      				tempo.tpriorite = 99
      			FIN
      
      
      			si aucunpdebase alors
      				tempo.timprimeetiq = vrai
      			FIN
      			tempo.tlignedecommande = fdetail.fdligne
      			tempo.tclient = facture.faclient
      			tempo.tnomclient = trouve_client(facture.faclient, faux)
      			tempo.tnomcourt = trouve_client(facture.faclient, vrai)
      			tempo.ttransfertspecial = client.ctransfertspecial 
      			si sansespace(client.videojet) = "" alors
      				tempo.tnumeroformule = 1	
      			sinon
      				tempo.tnumeroformule = val(client.videojet)
      			fin
      			tempo.tordre = facture.fanocommande
      			tempo.tcomm = facture.fanumero
      			tempo.tjob = facture.fanojob
      			tempo.tsecteur = facture.fasecteur
      			tempo.tcap = fdetail.fdcap
      			tempo.tproduit = fdetail.fdnumprod
      			tempo.tcomposant1 = fdetail.fdcomposant1
      			tempo.tcomposant2 = fdetail.fdcomposant2
      			tempo.tcomposant3 = fdetail.fdcomposant3
      
      
      			//            clederecherche = hconstruitvalcle(OrdreTrtXopt,Composant1Composant2Composant3Argon,...
      			//                                                           sansespace(fdetail.fdcomposant1),...
      			//                                                           sansespace(fdetail.fdcomposant2),...
      			//                                                           sansespace(fdetail.fdcomposant3),...
      			//                                                           gazargon)
      			clederecherche = hconstruitvalcle(OrdreTrtXopt,Composant1Composant2Composant3Argon,...
      			sansespace(fdetail.fdcomposant1),...
      			sansespace(fdetail.fdcomposant2),...
      			sansespace(fdetail.fdcomposant3),...
      			wargon)
      
      			si hlitrecherche(OrdreTrtXopt,Composant1Composant2Composant3Argon,clederecherche) alors
      				tempo.TordreXopt = OrdreTrtXopt.NoOrdre
      			sinon
      				tempo.TordreXopt = 999
      			fin            	
      			tempo.ttype = facture.facalcul
      			tempo.tdate = facture.fadate
      			tempo.tbase = composant
      			tempo.tqtebase  = tempoqte
      			tempo.tqteoriginale = fdetail.fdqte
      			tempo.tqte = min(qteresiduelle,2)
      			qteresiduelle -= 2
      			//			tempo.tnumligne = fdetail.fdligne
      			tempo.tnumligne = l
      			tempo.tcapgaztube = fdetail.fcapgaztube
      			tempo.tenergiverre = fdetail.fdenergiverre
      			si valide_trtspec(composant,rang)
      				//    si traitementspecial alors
      				tempo.ttraitementspecial = "O"
      			sinon
      				tempo.ttraitementspecial = "A"  // Jean hamelin
      			fin
      			SI facture.facalcul = 1 alors 
      				//				tempo.tlargeur = numeriqueverschaine(val(fdetail.fdlargeur)/12 * 0.3048 * 1000,"d")
      				//				tempo.thauteur = numeriqueverschaine(val(fdetail.fdhauteur)/12 * 0.3048 * 1000,"d")
      				tempo.tlargeur = numeriqueverschaine(val(fdetail.fdlargeur)/12 * 0.3048 * 1000,"7.2f")
      				tempo.thauteur = numeriqueverschaine(val(fdetail.fdhauteur)/12 * 0.3048 * 1000,"7.2f")
      			sinon
      				//Code WinDev 5.5 remplacé par la migration :
      				//	tempo.tlargeur = verschaine(val(fdetail.fdlargeur) * 1000)
      				tempo.tlargeur = NumeriqueVersChaine(val(fdetail.fdlargeur) * 1000)
      				//Code WinDev 5.5 remplacé par la migration :
      				//	tempo.thauteur = verschaine(val(fdetail.fdhauteur) * 1000)
      				tempo.thauteur = NumeriqueVersChaine(val(fdetail.fdhauteur) * 1000)
      			fin
      			tempo.tlargeura = fdetail.fdlargeura
      			tempo.thauteura = fdetail.fdhauteura
      			tempo.TtypeSpacer = fdetail.ftypespacer
      			tempo.tespace = fdetail.fdespace
      			tempo.tespace2 = fdetail.fdespace2
      			tempo.tligne  = wligne
      			tempo.tprixuni  = fdetail.fdprixu
      			tempo.tprixupied = fdetail.fdprixupied
      			tempo.tdescription = fdetail.fddesc
      			tempo.tnumeroprep = prochainnumeroprep
      			tempo.tcarrelage = fdetail.fdcarrelage
      			tempo.TJOBLIGNE  = fdetail.FDJOBLIGNE 
      			tempo.tdoubletriple = doubletriple
      			tempo.tfini = fdetail.ffini
      			si pas fdetail.fdforme =  "" alors 
      
      				tempo.tnoforme = fdetail.fdforme
      				tempo.tw       = transformevaleur(fdetail.fdw)
      				tempo.tw1      = transformevaleur(fdetail.fdw1)
      				tempo.tw2      = transformevaleur(fdetail.fdw2)
      				tempo.th       = transformevaleur(fdetail.fdh)
      				tempo.th1      = transformevaleur(fdetail.fdh1)
      				tempo.th2      = transformevaleur(fdetail.fdh2)
      				tempo.td       = transformevaleur(fdetail.fdd)
      				tempo.tr       = transformevaleur(fdetail.fdr)
      				tempo.tr1       = transformevaleur(fdetail.fdr1)
      				tempo.tr2       = transformevaleur(fdetail.fdr2)
      				tempo.ts       = transformevaleur(fdetail.fds)
      				tempo.tf       = transformevaleur(fdetail.fdf)
      				tempo.tt1      = transformevaleurvf(fdetail.fdt1)
      				tempo.tt2      = transformevaleurvf(fdetail.fdt2)
      				tempo.tt3      = transformevaleurvf(fdetail.fdt3)
      				tempo.tt4      = transformevaleurvf(fdetail.fdt4)
      				tempo.tcapw    = fdetail.fdcapw
      				tempo.tcapw1   = fdetail.fdcapw1
      				tempo.tcapw2   = fdetail.fdcapw2
      				tempo.tcaph    = fdetail.fdcaph
      				tempo.tcaph1   = fdetail.fdcaph1
      				tempo.tcaph2   = fdetail.fdcaph2
      				tempo.tcapd    = fdetail.fdcapd
      				tempo.tcapr    = fdetail.fdcapr
      				tempo.tcapr1    = fdetail.fdcapr1
      				tempo.tcapr2    = fdetail.fdcapr2
      				tempo.tcaps    = fdetail.fdcaps
      				tempo.tcapf    = fdetail.fdcapf
      				tempo.tnombre  = fdetail.fnombre
      				tempo.tcarreauh = fdetail.fdcarreauh
      				tempo.tcarreauv = fdetail.fdcarreauv
      				tempo.tnumcarr = fdetail.fdnumcarr
      				tempo.tnotes = fdetail.fnotes 
      				tempo.TtypeCalcul = fdetail.fdtypecalcul
      				hlitrecherche("forme","fnumero",fdetail.fdforme)
      				//Code WinDev 5.5 remplacé par la migration :
      				//	si pas h.endehors et h.trouve alors
      				si pas HEnDehors() et HTrouve() alors
      					tempo.twordre = forme.wordre
      					tempo.tw1ordre = forme.w1ordre
      					tempo.tw2ordre = forme.w2ordre
      					tempo.thordre = forme.hordre
      					tempo.th1ordre = forme.h1ordre
      					tempo.th2ordre = forme.h2ordre
      					tempo.tt1ordre = forme.t1ordre
      					tempo.tt2ordre = forme.t2ordre
      					tempo.tt3ordre = forme.t3ordre
      					tempo.tt4ordre = forme.t4ordre
      					tempo.trordre = forme.rordre
      					tempo.tr1ordre = forme.r1ordre
      					tempo.tr2ordre = forme.r2ordre
      					tempo.tdordre = forme.dordre
      					tempo.tsordre = forme.sordre
      					tempo.tfordre = forme.fordre
      				FIN
      
      			FIN
      			pour i = 1 a 10
      				{"tempo.tnbmorceau"+i} = fdetail.FDnbmorceau[i]
      				{"tempo.tnbdimension"+i} = fdetail.fddimension[i]
      			FIN
      			tempo.Tvx = fdetail.fdvariablex
      			tempo.Tvx1 = fdetail.fdvariablex1
      			tempo.TMatch = 0
      			tempo.tddv = fdetail.fdddv
      			tempo.tddh = fdetail.fdddh
      			
      			//AjouterTableau(tempo.tproduit,tempo.tlargeur,tempo.thauteur)
      			
      			
      
      
      			hajoute("tempo")
      			//Code WinDev 5.5 remplacé par la migration :
      			//si hdejabloque() alors
      			si HErreurBlocage() alors
      				acso_message("Erreur","Information déjà en utilisation","Erreur")
      			fin   
      		FIN
      		wligne++
      		l++
      	fin
      
      fin
      
     type : 458752
   -
     name : calcul_nb_carreau
     procedure_id : 5062774102859416875
     type_code : 14
     code : |1+
      // méthode  1 = normal
      //          2 = contour
      //          3 = semi-contour 
      
      Procédure calcul_nb_carreau(lproduit,nbcarreauv,nbcarreauh,ltypecalcul,methode=1)
      
      //global
      //LA est un entier = commande.cdcarreauv
      //HA est un entier = commande.cdcarreauh
      local
      	res est une chaine
      	nbcarreau est un entier
      	met1 est une chaine = config.formulecontour
      	met2 est une chaine = config.formulesemicontour
      	formule1 est une chaine 
      	formule2 est une chaine = "y est un reel"+RC+"y="+met2+RC+"renvoyer(y)"
      	//res est une chaine
      
      	si hlitrecherche(typecarr,tcdescription,ltypecalcul) alors
      		si typecarr.Typedessin = 2 alors
      			si client.cQteSpecialeContour alors
      				si sansespace(typecarr.TcalculQteContour) <> "" alors
      					nbl = nbcarreauv
      					nbh = nbcarreauh
      					formule1 = "y est un reel"+RC+"y="+typecarr.TcalculQteContour+RC+"renvoyer(y)"
      					methode = 2
      				fin	
      			fin
      		FIN
      
      	FIN
      
      
      
      selon methode
      
      	cas 1
      		nbcarreau = nbcarreauv * nbcarreauh
      	cas 2
      		res = compile("formulec1",formule1)
      		si res = "" alors
      			//		nbcarreau = formulec1() 
      			nbcarreau = executetraitement("formulec1",trtProcédure) 
      		FIN
      	cas 3
      		res = compile("formulec2",formule2)
      		si res = "" alors
      			nbcarreau = executetraitement("formulec2",trtProcédure) 
      		FIN
      fin
      renvoyer nbcarreau
      
     type : 458752
   -
     name : verifiesilotexiste
     procedure_id : 5068553556856748599
     type_code : 14
     code : |1+
      Procédure verifiesilotexiste(lNoLot = 0)
      si hlitrecherche(ArchivePrep,TNoLot,lNoLot) alors
      	renvoyer vrai
      sinon
      	renvoyer faux
      fin
      
      
     type : 458752
   -
     name : trouvedefautlivraison
     procedure_id : 5182488415237406244
     type_code : 14
     code : |1+
      Procédure trouvedefautlivraison(lnoclient)
      
      hlitrecherche(ClientLivraison,idclient,sansespace(lnoclient))
      tantque pas hendehors(ClientLivraison) et sansespace(ClientLivraison.idclient) = sansespace(lnoclient)
      	si ClientLivraison.lDefaut alors
      		renvoyer vrai
      	FIN
      	hlitsuivant(ClientLivraison,idclient)
      FIN
      
      renvoyer faux
      
      
      
     type : 458752
   -
     name : valide_trtspec1
     procedure_id : 5207680511098038514
     type_code : 14
     code : |1+
      Procédure valide_trtspec1(composant,rang)
      
      valeuraretourner est un booleen = faux
      rangtrtspe = ""
      hlitrecherche("invent","INUM",composant)
      
      si pas invent.itraitementspecial alors
      	renvoyer valeuraretourner
      FIN
      
      
      si rang = 1 alors
      	boucle
      
      		si fdetail.fdcomposant2 = invent.inumerotraitementspec alors
      			rangtrtspe = invent.iRangTrtSpe1
      			NoProdTrtSpe = invent.inumerotraitementspec
      			valeuraretourner = vrai
      			sortir
      		FIN
      		si fdetail.fdcomposant2 = invent.inumerotraitementspecial2 alors
      			rangtrtspe = invent.iRangTrtSpe2
      			NoProdTrtSpe = invent.inumerotraitementspecial2
      			valeuraretourner = vrai
      			sortir
      		FIN
      
      		si fdetail.fdcomposant2 = invent.inumerotraitementspecial3 alors
      			rangtrtspe = invent.iRangTrtSpe3
      			NoProdTrtSpe = invent.inumerotraitementspecial3
      			valeuraretourner = vrai
      			sortir
      		FIN
      		si pas sansespace(fdetail.fdcomposant3) = "" alors
      			si fdetail.fdcomposant3 = invent.inumerotraitementspec alors
      				rangtrtspe = invent.iRangTrtSpe1
      				NoProdTrtSpe = invent.inumerotraitementspec
      				valeuraretourner = vrai
      				sortir
      			FIN
      			si fdetail.fdcomposant3 = invent.inumerotraitementspecial2 alors
      				NoProdTrtSpe = invent.inumerotraitementspecial2
      				rangtrtspe = invent.iRangTrtSpe2
      				valeuraretourner = vrai
      				sortir
      			FIN
      			si fdetail.fdcomposant3 = invent.inumerotraitementspecial3 alors
      				rangtrtspe = invent.iRangTrtSpe3
      				NoProdTrtSpe = invent.inumerotraitementspecial3
      
      				valeuraretourner = vrai
      				sortir
      			FIN
      		fin
      		sortir
      	fin
      fin         
      
      si rang = 2 alors
      	boucle
      		si fdetail.fdcomposant1 = invent.inumerotraitementspec alors
      			rangtrtspe = invent.iRangTrtSpe1
      			NoProdTrtSpe = invent.inumerotraitementspec
      
      			valeuraretourner = vrai
      			sortir
      		FIN
      		si fdetail.fdcomposant1 = invent.inumerotraitementspecial2 alors
      			rangtrtspe = invent.iRangTrtSpe2
      			NoProdTrtSpe = invent.inumerotraitementspecial2
      
      			valeuraretourner = vrai
      			sortir
      		FIN
      		si fdetail.fdcomposant1 = invent.inumerotraitementspecial3 alors
      			rangtrtspe = invent.iRangTrtSpe3
      			NoProdTrtSpe = invent.inumerotraitementspecial3
      			valeuraretourner = vrai
      			sortir
      		FIN
      		si pas sansespace(fdetail.fdcomposant3) = "" alors
      			si fdetail.fdcomposant3 = invent.inumerotraitementspec alors
      				rangtrtspe = invent.iRangTrtSpe1
      				NoProdTrtSpe = invent.inumerotraitementspec
      				valeuraretourner = vrai
      				sortir
      			FIN
      			si fdetail.fdcomposant3 = invent.inumerotraitementspecial2 alors
      				rangtrtspe = invent.iRangTrtSpe2
      				NoProdTrtSpe = invent.inumerotraitementspecial2
      				valeuraretourner = vrai
      				sortir
      			FIN
      			si fdetail.fdcomposant3 = invent.inumerotraitementspecial3 alors
      				rangtrtspe = invent.iRangTrtSpe3
      				NoProdTrtSpe = invent.inumerotraitementspecial3
      				valeuraretourner = vrai
      				sortir
      			FIN
      		fin
      		sortir
      	fin
      
      fin         
      si rang = 3 alors
      	boucle
      		si fdetail.fdcomposant1 = invent.inumerotraitementspec alors
      			rangtrtspe = invent.iRangTrtSpe1
      			NoProdTrtSpe = invent.inumerotraitementspec
      			valeuraretourner = vrai
      			sortir
      		FIN
      		si fdetail.fdcomposant1 = invent.inumerotraitementspecial2 alors
      			rangtrtspe = invent.iRangTrtSpe2
      			NoProdTrtSpe = invent.inumerotraitementspecial2
      			valeuraretourner = vrai
      			sortir
      		FIN
      		si fdetail.fdcomposant1 = invent.inumerotraitementspecial3 alors
      			rangtrtspe = invent.iRangTrtSpe3
      			NoProdTrtSpe = invent.inumerotraitementspecial3
      			valeuraretourner = vrai
      			sortir
      		FIN
      		si fdetail.fdcomposant2 = invent.inumerotraitementspec alors
      			rangtrtspe = invent.iRangTrtSpe1
      			NoProdTrtSpe = invent.inumerotraitementspec
      
      			valeuraretourner = vrai
      			sortir
      		FIN
      		si fdetail.fdcomposant2 = invent.inumerotraitementspecial2 alors
      			rangtrtspe = invent.iRangTrtSpe2
      			NoProdTrtSpe = invent.inumerotraitementspecial2
      			valeuraretourner = vrai
      			sortir
      		FIN
      		si fdetail.fdcomposant2 = invent.inumerotraitementspecial3 alors
      			NoProdTrtSpe = invent.inumerotraitementspecial3
      			rangtrtspe =invent.iRangTrtSpe3
      			valeuraretourner = vrai
      			sortir
      		FIN
      	fin
      fin  
      
      renvoyer valeuraretourner
      
     type : 458752
   -
     name : TrouvePasRack
     procedure_id : 5262570622831345923
     type_code : 14
     code : |1+
      Procédure TrouvePasRack()
      
      //Procédure pour trouver le nombre de thermos a mettre dans un rackl
      // Aller voir dans le fichier ordretrtxopt si on trouve le thermos.Si oui , si case a cocher qteunprep est vrai la quantité est  1
      // Si trouve et pas de coche ou trouve pas la quantité est 2
      
      valeuraretourner est un entier = 2
      
      
      si hlitrecherche(OrdreTrtXopt,Composant1Composant2Composant3Argon,...
      	hconstruitvalcle(OrdreTrtXopt,Composant1Composant2Composant3Argon,sansespace(fdetail.fdcomposant1),sansespace(fdetail.fdcomposant2),sansespace(fdetail.fdcomposant3)))
      	 si OrdreTrtXopt.QteUnPrep alors
      	 	valeuraretourner=1
      	 FIN
      FIN
      
      renvoyer valeuraretourner
     type : 458752
   -
     name : TriTempo
     procedure_id : 5365809163982809680
     type_code : 14
     code : |1+
      Procédure TriTempo(lJauge est un champ = null)
      sdTempoVue est une source de données
      lDeLigne est une chaine
      lAligne est une chaine
      bValeurEnerginerreEnCours est un booleen
      sValeurProduitDeBaseEnCours est une chaine
      nValeurDimensionEnCours est un entier
      nMaximumQteEnergiverreSiPareil est un entier = 10
      nQteGroupe est un entier
      
      
      //OuvreSoeur(FenAttentePetite,RC+RC+"Tri des numéro de Rack"+rc)
      nNbOrder est un entier = hnbenr(tempo)
      nCpt est un entier
      
      pour tout tempo
      	_positionJauge++
      	SI _positionJauge  > 100 ALORS
      		_positionJauge=1	
      	FIN
      	requetenorack.pComm = tempo.tcomm
      	RequeteNoRack.PligneComm = tempo.tlignedecommande
      	requetenorack.pNumLigne = tempo.Tnumligne
      	HExécuteRequête(RequeteNoRack)
      	hlitpremier(RequeteNoRack)
      	lDeLigne = ExtraitChaîne(RequeteNoRack.tNoRack,1,"-")
      	tantque pas HEnDehors(RequeteNoRack)
      		lAligne = max(lAligne,ExtraitChaîne(RequeteNoRack.tNoRack,ChaîneOccurrence(RequeteNoRack.tnoRack,"-"),"-"))
      		
      		HLitSuivant(RequeteNoRack)
      	fin
      	tempo.tdea = lDeLigne +" A " + lAligne
      	tempo.tposition = val(lDeLigne)
      	HModifie(tempo,hNumEnrEnCours)
      	HLit(Fdetail,Tempo.tnoRecFdetail)
      	Fdetail.TDeA = Tempo.TDeA
      	Fdetail.fNoLot = ""
      	HModifie(Fdetail,hNumEnrEnCours)
      
      	si hlitrecherche(Fdetailtempo,IDFdetailtempo,tempo.idfdetailtempo) alors
      		Fdetailtempo.tnorack = tempo.tdea
      		hmodifie(Fdetailtempo,hNumEnrEnCours)
      	FIN
      
      FIN
      
      
      
      multitache(200)
      //ferme(FenAttentePetite)
      sablier(faux)
     type : 458752
   -
     name : CalculRack
     procedure_id : 5366175773040321204
     type_code : 14
     code : |1+
      Procédure CalculRack(lNoCommande=0,lOperateur="Plus")
      ReqSql est une source de donnees
      TxtSql est une chaine = [
      	select Fdetail.ftype,Fdetail.fdcomposant1,Fdetail.fdcomposant2,Fdetail.fdcomposant3,Fdetail.fdqteafacturer
      	from fdetail
      	where fdetail.fdnocomm = %1
      ]
      si gFormatFacture <> 2 alors
      	renvoyer faux
      FIN
      lTotalVerre est un entier=0
      lmultiplicateur est un entier = 1
      si lOperateur <> "Plus" alors
      	lmultiplicateur = -1
      FIN
      si hlitrecherche(facture,fanumero,lNoCommande) alors
      	si HExécuteRequêteSQL(ReqSql,hRequêteDéfaut,ChaîneConstruit(TxtSql,lNoCommande))	_et_ hnbenr(ReqSql) > 0 alors
      	//	pour tout fdetail avec "fdnocomm = "+lNoCommande
              pour tout ReqSql
      			si ReqSql.ftype = 1 alors
      				lTotalVerre=0
      				si pas  sansespace(ReqSql.fdcomposant1) = "" alors lTotalVerre++
      				si pas  sansespace(ReqSql.fdcomposant2) = "" alors lTotalVerre++
      				si pas  sansespace(ReqSql.fdcomposant3) = "" alors lTotalVerre++
      				csnCase += (ReqSql.fdqteafacturer * lTotalVerre * lmultiplicateur)
      				
      			fin 
      		fin
      	fin
      	
      FIN
      
      si csnCase > config.MaxCase alors
      	csncase..Couleur = iJauneClair
      	csnCase..CouleurFond = iRougeClair
      	//	BTN_PREPARe..etat=grise
      sinon
      	csnCase..Couleur = inoir
      	csnCase..CouleurFond = igrisclair
      	//	BTN_PREPARe..etat=actif
      FIN
      
     type : 458752
   -
     name : CalculRackUneLigne
     procedure_id : 5366209059067749537
     type_code : 14
     code : |1+
      Procédure CalculRackUneLigne(lNoCommande=0,lOperateur="Plus")
      lNbCase est un entier
      si gFormatFacture <> 2 alors
      	renvoyer "0;0"
      FIN
      lTotalVerre est un entier=0
      lTotalThermos est un entier = 0
      rTotalPi2 est un reel
      
      lmultiplicateur est un entier = 1
      si hlitrecherche(facture,fanumero,lNoCommande) alors
      	pour tout fdetail avec "fdnocomm = "+lNoCommande
      		si fdetail.ftype = 1 alors
      			lTotalVerre=0
      			lTotalThermos+=fdetail.fdqte
      			si pas  sansespace(fdetail.fdcomposant1) = "" alors lTotalVerre++
      			si pas  sansespace(fdetail.fdcomposant2) = "" alors lTotalVerre++
      			si pas  sansespace(fdetail.fdcomposant3) = "" alors lTotalVerre++
      			lNbCase += (fdetail.fdqteafacturer * lTotalVerre * lmultiplicateur)
                  rTotalPi2+=fdetail.fdpiedcarre  * ltotalverre * fdetail.fdqteafacturer
      
      		fin 
      	fin
      
      FIN
      
      renvoyer sansespace(NumériqueVersChaine(lNbCase))+";"+sansespace(NumériqueVersChaine(lTotalThermos))+";"+SansEspace(NumériqueVersChaîne(rTotalPi2))
      
      
     type : 458752
   -
     name : RemplirFdetailTempo
     procedure_id : 5377672150611245851
     type_code : 14
     code : |1-
      Procédure RemplirFdetailTempo(Carrelage est un booleen = faux,lscellant est un entier = 0)
      
      
      j est un entier
      i est un entier
      Dimensiontempo est un reel
      PositionEnCours est un entier
      TotQte est un entier = 0
      b_debut est un booleen = vrai
      b_energiverre est un booleen 
      _DimensionBase est un reel = config.DimensionAverifierPrep
      //Carrelage est un booleen= faux
      
      ConstanteAAjouter = 10000
      _TypeDeDimensionEnCours est une chaine 
      _DimensionEnCours est un entier
      _QteDimensionEnCours est un entier
      _scellant est un entier = 0
      _structScellant est un scellant = [1,2]
      
      
      ouvrefille("FENJAUGE","Préparation des tables")
      
      
      
      pour j = 1 a tableoccurrence("TABLE1")
      	_positionjauge++
      	si _positionJauge  > 100 alors
      		_positionjauge=1	
      	FIN
      	execute("fenjauge.progression",_positionJauge)
      	si crochet[j] alors
      		hlitrecherche("Facture","fanumero",commande[j])
      		si HErreurBlocage() alors
      			erreur("la commande "+commande[j])
      		FIN
      		si hlitrecherche(facture,fanumero,TABLE1.COMMANDE[j]) alors
      		   si hlitrecherche(client,numero,facture.faclient) alors
      		      _scellant = client.Cscellant
      		   sinon
      		  	 _scellant = _structScellant.hotmelt   
      		   fin
      	
      		   	
      			//info(facture.fanumero)
      		fin
              si lscellant <> 0 _et_ _scellant <> lscellant alors continuer  // on traite le scellant 1 ou 2
              
      
      		hlitrecherche(fdetail,fdnocommfdligne,hconstruitvalcle(fdetail,fdnocommfdligne,facture.fanumero,1))
      		//		hlitrecherche(fdetail,fdcle,hconstruitvalcle(fdetail,fdcle,facture.fanumero))
              
      		si HErreurBlocage() alors
      			erreur("la commande "+commande[j]+ " ne peut pas etre traitée")
      			ferme("FENJAUGE")
      			renvoyer faux
      		FIN
      
      		tantque fdetail.fdnocomm = facture.fanumero et pas HEnDehors()
      			SI sansespace(fdetail.fdcomposant1) = "" et sansespace(fdetail.fdcomposant2) = "" et sansespace(fdetail.fdcomposant3) = "" alors  	
      			sinon
      			si fdetail.fdcarrelage <> Carrelage alors goto LireRecordSuivant
      			 
      				hraz(fdetailtempo)
                      Fdetailtempo.tscellant = _scellant
                      
      				Fdetailtempo.fdnocomm = fdetail.fdnocomm
      				Fdetailtempo.fdligne = fdetail.fdligne
      				Fdetailtempo.fEspace = fdetail.fdespace
      				Fdetailtempo.tqte = Fdetail.fdqteafacturer+fdetail.fdqtedejafacture
      				FdetailTempo.tenergiverre = fdetail.fdenergiverre
      				fdetailtempo.tnothermos = fdetail.fdnumprod
      				fdetailtempo.fQteTotal = total[j]
      
      //				si sansespace(fdetail.fdforme) <> "" alors
      //					Fdetailtempo.fEspaceTri = 9999
      //					fdetailtempo.fNoForme = "X"
      //				sinon
      //					fdetailtempo.fNoForme = " "
      //				FIN
      
      				SI facture.facalcul = 1 alors 
      					fdetailtempo.HAUTEUR = numeriqueverschaine(val(fdetail.fdhauteur)/12 * 0.3048 * 1000,"7.2f")
      					fdetailtempo.LARGEUR = numeriqueverschaine(val(fdetail.fdlargeur)/12 * 0.3048 * 1000,"7.2f")
      					fdetailtempo.tHAUTEURreelle = numeriqueverschaine(val(fdetail.fdhauteur)/12 * 0.3048 * 1000,"7.2f")
      					fdetailtempo.tLARGEURreelle = numeriqueverschaine(val(fdetail.fdlargeur)/12 * 0.3048 * 1000,"7.2f")
      				sinon
      					fdetailtempo.HAUTEUR = NumeriqueVersChaine(val(fdetail.fdhauteur) * 1000)
      					fdetailtempo.LARGEUR = NumeriqueVersChaine(val(fdetail.fdlargeur) * 1000)
      					fdetailtempo.tHAUTEURreelle = NumeriqueVersChaine(val(fdetail.fdhauteur) * 1000)
      					fdetailtempo.tLARGEURreelle = NumeriqueVersChaine(val(fdetail.fdlargeur) * 1000)
      				fin
      				si Fdetailtempo.largeur > Fdetailtempo.hauteur alors
      					Dimensiontempo = Fdetailtempo.hauteur
      					Fdetailtempo.HAUTEUR = Fdetailtempo.LARGEUR
      					Fdetailtempo.LARGEUR = Dimensiontempo
      				FIN
      				si Fdetailtempo.Largeur < _DimensionBase alors
      					si Fdetailtempo.tqte < config.MaxQteClair1300moins alors
      						fdetailtempo.fespacetri = 9000
      					FIN
      				sinon
      					si Fdetailtempo.tqte < config.MaxQteClair1300plus alors
      						fdetailtempo.fespacetri = 9000
      					FIN
      
      		
      				fin
      
      				si (sansespace(fdetail.fdespace) = "750" ou val(fdetail.fdespace <= 375)) et ...
      					(  Fdetailtempo.Largeur < _DimensionBase et pas Fdetailtempo.tqte < config.MaxQteClair1300moins)  et...
      					( Fdetailtempo.Largeur > _DimensionBase et pas  Fdetailtempo.tqte < config.MaxQteClair1300plus) alors
      					
      					Fdetailtempo.fEspaceTri = 9998
      				sinon
      					//						si fdetail.fdqte < config.MaxQteClair1300Plus alors
      					//					fdetailtempo.fespacetri = 9000
      				fin
      				si sansespace(fdetail.fdforme) <> "" alors
      					Fdetailtempo.fEspaceTri = 9999
      					fdetailtempo.fNoForme = "X"
      				FIN
      				
      				hajoute(Fdetailtempo)
      				si pas lher alors
      					si fdetail.fdenergiverre alors
      						lher = vrai
      					fin	
      				fin
      			fin
      		LireRecordSuivant:
      			
      			hlitsuivant(fdetail,fdnocommfdligne)
      		fin
      		facture.fpreparation = "T"
      		//	facture.livrepartiel = " "
      		facture.FImprimeFeuille = vrai
      		hmodifie("Facture")
      	fin
      
      fin
      
      
      
      
      
      TriIdentique()
      _groupe = 101
      
      boucle
      	si TriAutrePlus() = 0 alors sortir
      fin
      
      
      VerifieRejetPlus()
      
      //TriAutrePlus1()
      _groupe = 201
      
      boucle
      	si triautremoins() = 0 alors sortir
      fin
      //VerifieRejetMoins()
      
      VerifieRejetMoins()
      
      Verifierejetmoins(Vrai)
      
      VerifieRejetMoinsEntreEux()
      _groupe = 301
      
      boucle
      	si TriAutrePlus(9998) = 0 alors sortir
      fin
      _groupe = 401
      
      boucle
      	si triautremoins(9998) = 0 alors sortir
      fin
      
      VerifieRejetMoins9998()
      
      
      VerifieRejetMoins9998EntreEux()
      oldgroupe est une chaine
      
      Hlitpremier(Fdetailtempo,fEspaceTriTposition)
      _DimensionEnCours =  Fdetailtempo.HAUTEUR
      _QteDimensionEnCours = 0
      
      tantque pas hendehors(Fdetailtempo)
      	si Fdetailtempo.tqte < 10 et fdetailtempo.tgroupe = 0 et pas Fdetailtempo.fEspaceTri = 9999 alors
      		si Fdetailtempo.HAUTEUR <= _DimensionBase alors
      			si _TypeDeDimensionEnCours = "" alors 
      				_TypeDeDimensionEnCours ="Petit"
      			fin
      			//			si Fdetailtempo.HAUTEUR = _DimensionEnCours et _maxTableHERPlusPetitSiPareil <> 0 alors
      			si (_TypeDeDimensionEnCours = "Grand" et TotQte+Fdetailtempo.tqte > lMaxQtePlus) ou TotQte+Fdetailtempo.tqte > lMaxQteMoins  alors
      				//				si totqte+Fdetailtempo.tqte > _maximummoins ou _TypeDeDimensionEnCours = "Grand" alors
      				TotQte=Fdetailtempo.tqte
      				cpt++
      				PositionEnCours = 1
      				fdetailtempo.tnotable = cpt
      				fdetailtempo.tposition = PositionEnCours
      				hmodifie(Fdetailtempo,hNumEnrEnCours)
      				si _TypeDeDimensionEnCours = "Grand" alors
      					_TypeDeDimensionEnCours = "Petit"
      				FIN	
      
      			sinon
      				PositionEnCours++
      				fdetailtempo.tposition = PositionEnCours
      				TotQte+=Fdetailtempo.tqte
      				fdetailtempo.tnotable = cpt
      				hmodifie(Fdetailtempo,hNumEnrEnCours)
      			fin
      
      		sinon
      			si _TypeDeDimensionEnCours = "" alors 
      				_TypeDeDimensionEnCours ="Grand"
      			fin
      
      			Si TotQte+Fdetailtempo.tqte > lMaxQtePlus ou _TypeDeDimensionEnCours = "Petit" alors
      				cpt++
      				PositionEnCours=1
      				TotQte=Fdetailtempo.tqte
      				fdetailtempo.tnotable = cpt
      				fdetailtempo.tposition = PositionEnCours
      				hmodifie(Fdetailtempo,hNumEnrEnCours)
      				si _TypeDeDimensionEnCours = "Petit" alors
      					_TypeDeDimensionEnCours = "Grand"
      				FIN
      			sinon
      				PositionEnCours++
      				TotQte+=Fdetailtempo.tqte
      				fdetailtempo.tnotable = cpt
      				fdetailtempo.tposition = PositionEnCours
      				hmodifie(Fdetailtempo,hNumEnrEnCours)
      			fin			  	
      		fin
      		hlitsuivant(Fdetailtempo,fEspaceTriTposition)
      	sinon si fdetailtempo.tgroupe <> 0
      		oldgroupe =  fdetailtempo.tgroupe 
      
      		tantque fdetailtempo.tgroupe = oldgroupe et pas hendehors(fdetailtempo)
      			PositionEnCours++
      			Fdetailtempo.tnotable = cpt
      			hmodifie(Fdetailtempo,hNumEnrEnCours)
      			hlitsuivant(Fdetailtempo,fEspaceTriTposition)
      
      		fin
      		cpt++
      	sinon
      		Fdetailtempo.tnotable = cpt
      		fdetailtempo.Tposition = 1
      		hmodifie(Fdetailtempo,hNumEnrEnCours)
      		cpt++
      		hlitsuivant(Fdetailtempo,fEspaceTriTposition)
      	fin
      
      
      FIN
      
      pour tout Fdetailtempo sur IDFdetailtempo
      	Fdetailtempo.fEspaceTri= fdetailtempo.fespacetri +ConstanteAAjouter
      	hmodifie(Fdetailtempo,hNumEnrEnCours)
      	
      FIN
      
      
      ferme(fenjauge)
      
      //ExécuteTraitement(Bouton15,trtClic)
     type : 458752
   -
     name : prep_tempo_trn
     procedure_id : 5377684517095189053
     type_code : 14
     code : |1+
      Procédure prep_tempo_trn()         
      
      j est un entier
      numerodecommande est un entier
      nombre est un entier 
      
      
      hbloquefichier("tempo")
      si HErreurBlocage() alors
      	acso_message("Erreur","Information déjà en utilisation","Erreur")
      	renvoyer vrai
      FIN
      supprimetempo()
      
      //htransactiondebut("transaction.fac","FACTURE")
      cpt = 1
      // Code original
      //RemplirFdetailTempo(Vrai)
      //MergeFdetailTempoc("C")
      //RemplirFdetailTempo()
      //
      
      
      RemplirFdetailTempo(Vrai,1)
      MergeFdetailTempoC("C1")
      RemplirFdetailTempo(Vrai,2)
      MergeFdetailTempoC("C2")
      RemplirFdetailTempo(faux,1)
      MergeFdetailTempoC("1")
      RemplirFdetailTempo(faux,2)
      MergeFdetailTempoC("2")
      
      
      
      
      
      
      
      //ouvrefille("FENJAUGE","Préparation du fichier de transfert")
      //hlitpremier(Fdetailtempo,Tposition)
      
      //hlitpremier(Fdetailtempo,fEspaceTriTposition)
      //
      //tantque pas HEnDehors(Fdetailtempo)
      //	j++
      //	execute("fenjauge.progression",j/nombre * 100)
      //
      //	hlitrecherche(Fdetail,fdnocommfdligne,HConstruitValClé(Fdetail,fdnocommfdligne,Fdetailtempo.fdnocomm,Fdetailtempo.fdligne))
      //	hlitrecherche(facture,fanumero,fdetail.fdnocomm)
      //	valide_composant()
      //	//			si cptdepart > config.MaxCase alors
      //	//				info(cptdepart)
      //	//				acso_message("Erreur","Vous dépassez le nombre maximum de case","Erreur")
      //	//				hexecuterequete(RequeteSecteurPrepare,hModifieFichier)
      //	//                pour tout RequeteSecteurPrepare
      //	//                    RequeteSecteurPrepare.FPREPARATION = ""
      //	//                    hModifie(RequeteSecteurPrepare,hNumEnrEnCours)
      //	//                fin
      //	//         	
      //	//				ferme(fenjauge)
      //	//				renvoyer faux
      //	//			FIN
      //
      //	si fdetail.fdlien = 0 alors
      //		AjouterTableau(1,fdetail.fdnumprod,fdetail.fdlargeura,fdetail.fdhauteura,"",fdetail.fddesc,facture.facalcul,fdetail.fdqteafacturer)
      //	sinon si fdetail.fdlien = fdetail.fdligne alors
      //		AjouterTableau(1,fdetail.fdnumprod,fdetail.fdlargeura,fdetail.fdhauteura,"",fdetail.fddesc,facture.facalcul,fdetail.fdqteafacturer)
      //	sinon
      //		AjouterTableau(2,fdetail.fdnumprod,fdetail.fdcarreauv,fdetail.fdcarreauh,fdetail.fdtypecalcul,fdetail.fddesc,facture.facalcul,fdetail.fdqteafacturer)
      //	fin
      //
      //
      ////	hlitsuivant(Fdetailtempo,Tposition)
      //	hlitsuivant(Fdetailtempo,fEspaceTriTposition)
      ////	hlitsuivant(Fdetailtempo,fEspaceTri)
      //	si HErreurBlocage() alors
      //	FIN
      //
      //FIN
      
      //trifdetailtempoc()
      //MergeFdetailTempo("C")
      
      // On ramène le tout dans un seul fichier
      
      MergeFdetailTempo("C1")  //"carrelage HotMelt"
      MergeFdetailTempo("C2")  //"carrelage uréthane"
      MergeFdetailTempo("1")   //"HotMelt" 
      MergeFdetailTempo("2")  // "Uréthane"
      
      // on le trie
      
      trifdetailtempo()
      multitache(10)
      hdebloquefichier("tempo")
      ferme("FENJAUGE")
      si gFormatFacture = 2 alors
      	TriTempo()
