     code : |1+
      Procédure MergeFdetailTempoC(_fichier est une chaine = "")
      lNomFichier est une chaine = "fdetailtempo" +_fichier
      
      hlitpremier(Fdetailtempo,"IDFdetailtempo")
      tantque pas HEnDehors(fdetailtempo)
      	hraz(lNomFichier)
      	HCopieEnreg(lNomFichier,fdetailtempo)
      	hajoute(lNomFichier)
      	hlitsuivant(Fdetailtempo,"IDFdetailtempo")
      FIN
      hcreation(Fdetailtempo)
      
     type : 458752
   -
     name : prep_tempo_trn_new_tri
     procedure_id : 1640367281624348773
     type_code : 14
     code : |1+
      Procédure prep_tempo_trn_new_tri()         
      
      j est un entier
      numerodecommande est un entier
      nombre est un entier 
      
      
      hbloquefichier("tempo")
      si HErreurBlocage() alors
      	acso_message("Erreur","Information déjà en utilisation","Erreur")
      	renvoyer vrai
      FIN
      supprimetempo()
      
      //htransactiondebut("transaction.fac","FACTURE") 
      cpt = 1
      // Code original
      //RemplirFdetailTempo(Vrai)
      //MergeFdetailTempoc("C")
      //RemplirFdetailTempo()
      //
      
      RemplirFdetailTempoNewtri(Faux,Faux,JaugePrep,"S")
      MergeFdetailTempoC("0")
      RemplirFdetailTempoNewtri(Vrai,Faux,JaugePrep)
      MergeFdetailTempoC("C1")
      RemplirFdetailTempoNewtri(faux,Faux,jaugeprep,"D")
      MergeFdetailTempoC("1")
      RemplirFdetailTempoNewtri(Faux,Vrai,JaugePrep)
      MergeFdetailTempoC("F")
      RemplirFdetailTempoNewtri(Faux,faux,JaugePrep,"T")
      MergeFdetailTempoC("2")
      
      
      
      
      
      
      
      
      
      //ouvrefille("FENJAUGE","Préparation du fichier de transfert")
      
      
      
      // On ramène le tout dans un seul fichier
      MergeFdetailTempoNewtri("0",JaugePrep)  //"Verre simple"
      MergeFdetailTemponewtri("C1",jaugeprep)  //"carrelage HotMelt"
      //MergeFdetailTempo("C2")  //"carrelage uréthane"
      MergeFdetailTempoNewtri("1",jaugeprep)   //"HotMelt" 
      MergeFdetailTempoNewtri("F",JaugePrep)   //"HotMelt" 
      MergeFdetailTempoNewtri("2",JaugePrep)   //"HotMelt" 
      
      //MergeFdetailTempo("2")  // "Uréthane"
      
      // on le trie
      
      trifdetailtempo(JaugePrep)
      multitache(10)
      hdebloquefichier("tempo")
      //ferme("FENJAUGE")
      si gFormatFacture = 2 alors
      	TriTempo(JaugePrep)
      fin
      renvoyer vrai
     type : 458752
   -
     name : RemplirFdetailTempoNewtri
     procedure_id : 1640376301055738367
     type_code : 14
     code : |1-
      Procédure RemplirFdetailTempoNewtri(Carrelage est un booleen = faux,lForme est un booleen = faux,ljauge est un champ = null,lDoubleTriple est une chaine = "")
      
      j est un entier
      i est un entier
      Dimensiontempo est un reel
      PositionEnCours est un entier
      TotQte est un entier = 0
      b_debut est un booleen = vrai
      b_energiverre est un booleen 
      _DimensionBase est un reel = gclconfig.m_nDimensionAverifierPrep
      //Carrelage est un booleen= faux
      
      ConstanteAAjouter = 10000
      _TypeDeDimensionEnCours est une chaine 
      _DimensionEnCours est un entier
      _QteDimensionEnCours est un entier
      _scellant est un entier = 0
      _structScellant est un scellant = [1,2]
      
      
      //ouvrefille("FENJAUGE","Préparation des tables")
      
      
      
      
      
      pour j = 1 _a_ tableoccurrence("TABLE1")
      	_positionjauge++
      	si _positionJauge  > 100 alors
      		_positionjauge=1	
      	FIN
      	ljauge..valeur = _positionjauge
      //	execute("fenjauge.progression",_positionJauge)
      	si crochet[j] alors
      		hlitrecherche("Facture","fanumero",commande[j])
      		si HErreurBlocage() alors
      			erreur("la commande "+commande[j])
      		FIN
      		si hlitrecherche(facture,fanumero,TABLE1.COMMANDE[j]) alors
      			si hlitrecherche(client,numero,facture.faclient) alors
      				_scellant = client.Cscellant
      			sinon
      				_scellant = _structScellant.hotmelt   
      			fin
      			
      			
      			//info(facture.fanumero)
      		fin
      		
      		
      		
      		hlitrecherche(fdetail,fdnocommfdligne,hconstruitvalcle(fdetail,fdnocommfdligne,facture.fanumero,1))
      		//		hlitrecherche(fdetail,fdcle,hconstruitvalcle(fdetail,fdcle,facture.fanumero))
      		
      		si HErreurBlocage() alors
      			erreur("la commande "+commande[j]+ " ne peut pas etre traitée")
      //			ferme("FENJAUGE")
      			renvoyer faux
      		FIN
      		
      		tantque fdetail.fdnocomm = facture.fanumero et pas HEnDehors()
      			SI sansespace(fdetail.fdcomposant1) = "" et sansespace(fdetail.fdcomposant2) = "" et sansespace(fdetail.fdcomposant3) = "" alors  	
      			sinon
      				
      //				SI HLitRecherche(persoens,ActifComposant,...
      //					HConstruitValClé(persoens,ActifComposant,Vrai,fdetail.fDCOMPOSANT1,Fdetail.fDCOMPOSANT2,Fdetail.fDCOMPOSANT3)) alors
      ////					si sansespace(persoens.epbase) <> "CL03" alors  goto LireRecordSuivant
      //				sinon
      //					goto lirerecordsuivant	
      //				fin
      				SI lDoubleTriple <> "" _ET_ pas contient(lDoubleTriple,Fdetail.ThermosType ) ALORS GOTO LireRecordSuivant	
      //				si lDoubleTriple <> "" _et_ fdetail.ThermosType <> lDoubleTriple alors goto LireRecordSuivant	
      				SI lForme ET SansEspace(Fdetail.fdforme) <> "" ALORS GOTO Traitement
      				si lForme et sansespace(fdetail.fdforme) = "" ALORS GOTO LireRecordSuivant
      				si pas lForme et SansEspace(Fdetail.fdforme) <> "" ALORS GOTO LireRecordSuivant
      				si fdetail.fdcarrelage <> Carrelage _ou_ lForme alors goto LireRecordSuivant
      				
      				Traitement:
      				hraz(fdetailtempo)
      				Fdetailtempo.tscellant = _scellant
      				fdetailtempo.Tposition = fdetail.ftypespacer
      				Fdetailtempo.fdnocomm = fdetail.fdnocomm
      				Fdetailtempo.fdligne = fdetail.fdligne
      				Fdetailtempo.fEspace = fdetail.fdespace
      				Fdetailtempo.tqte = Fdetail.fdqteafacturer+fdetail.fdqtedejafacture
      				FdetailTempo.tenergiverre = fdetail.fdenergiverre
      				fdetailtempo.tnothermos = fdetail.fdnumprod
      				fdetailtempo.fQteTotal = total[j]
      				
      				//				si sansespace(fdetail.fdforme) <> "" alors
      				//					Fdetailtempo.fEspaceTri = 9999
      				//					fdetailtempo.fNoForme = "X"
      				//				sinon
      				//					fdetailtempo.fNoForme = " "
      				//				FIN
      				
      				SI facture.facalcul = 1 alors 
      					fdetailtempo.HAUTEUR = numeriqueverschaine(val(fdetail.fdhauteur)/12 * 0.3048 * 1000,"7.2f")
      					fdetailtempo.LARGEUR = numeriqueverschaine(val(fdetail.fdlargeur)/12 * 0.3048 * 1000,"7.2f")
      					fdetailtempo.tHAUTEURreelle = numeriqueverschaine(val(fdetail.fdhauteur)/12 * 0.3048 * 1000,"7.2f")
      					fdetailtempo.tLARGEURreelle = numeriqueverschaine(val(fdetail.fdlargeur)/12 * 0.3048 * 1000,"7.2f")
      				sinon
      					fdetailtempo.HAUTEUR = NumeriqueVersChaine(val(fdetail.fdhauteur) * 1000)
      					fdetailtempo.LARGEUR = NumeriqueVersChaine(val(fdetail.fdlargeur) * 1000)
      					fdetailtempo.tHAUTEURreelle = NumeriqueVersChaine(val(fdetail.fdhauteur) * 1000)
      					fdetailtempo.tLARGEURreelle = NumeriqueVersChaine(val(fdetail.fdlargeur) * 1000)
      				fin
      				si Fdetailtempo.largeur > Fdetailtempo.hauteur alors
      					Dimensiontempo = Fdetailtempo.hauteur
      					Fdetailtempo.HAUTEUR = Fdetailtempo.LARGEUR
      					Fdetailtempo.LARGEUR = Dimensiontempo
      				FIN
      				
      				
      				
      				si sansespace(fdetail.fdforme) <> "" alors
      					Fdetailtempo.fEspaceTri = 9999
      					fdetailtempo.fNoForme = "X"
      				FIN
      				fdetailtempo.PoidsUnitaire = fdetail.PoidsUnitaire
      				hajoute(Fdetailtempo)
      				si pas lher alors
      					si fdetail.fdenergiverre alors
      						lher = vrai
      					fin	
      				fin
      			fin
      			LireRecordSuivant:
      			
      			hlitsuivant(fdetail,fdnocommfdligne)
      		fin
      		facture.fpreparation = "T"
      		//	facture.livrepartiel = " "
      		facture.FImprimeFeuille = vrai
      		hmodifie("Facture")
      	fin
      	
      fin
      
      
      
      
      
      
      pour tout Fdetailtempo sur IDFdetailtempo
      	Fdetailtempo.fEspaceTri= fdetailtempo.fespacetri +ConstanteAAjouter
      	hmodifie(Fdetailtempo,hNumEnrEnCours)
      	
      FIN
      
      
      //ferme(fenjauge)
      
      //ExécuteTraitement(Bouton15,trtClic)
     type : 458752
   -
     name : MergeFdetailTempoNewtri
     procedure_id : 1640401018592645219
     type_code : 14
     code : |1+
      Procédure MergeFdetailTempoNewtri(_fichier est une chaine = "",lJauge est un champ = null)
      lnomfichier est une chaine = "fdetailtempo"+_fichier
      txtreq est une chaine = [
      select * from %1
      order by tposition,fespace desc , hauteur  desc , largeur desc
      ]
      
      //txtreq est une chaine = [
      //select * from %1
      //order by fespace desc , hauteur  desc , largeur desc
      //]
      
      txtreq = chaineconstruit(txtreq,lnomfichier)
      reqsql est un source de donnees
      si HExécuteRequêteSQL(reqsql,hRequêteDéfaut,txtreq) alors
      sinon
      	info(herreurinfo(hErrComplet))	
      FIN
      pour tout reqsql
      //hlitpremier(lnomfichier,"IDFdetailtempo")
      ////tantque pas HEnDehors(lnomfichier)
      	_positionJauge++
      	SI _positionJauge  > 100 ALORS
      		_positionJauge=1	
      	FIN
      	lJauge..Valeur = _positionJauge
      	hraz(fdetailtempo)
      	HCopieEnreg(fdetailtempo,reqsql)
      	Fdetailtempo.Tcarrelage = left(_fichier,1) = "C" ? "C" sinon ""
      //	Fdetailtempo.tscellant = val(droite(_fichier,1))
      	hajoute(Fdetailtempo)
      //	hlitsuivant(lnomfichier,"IDFdetailtempo")
      FIN
      
      
      
     type : 458752
   -
     name : CalculQteSelectionnee
     procedure_id : 2137209532320179986
     type_code : 14
     code : |1+
      Procédure CalculQteSelectionnee()
      si gFormatFacture <> 2 alors
      	renvoyer faux
      FIN
      lTotalVerre est un entier=0
      TotalSelectionne est un entier
      lmultiplicateur est un entier = 1
      nbSelectionne est un entier = TableSelectOccurrence(TABLE1)
      lNoCommande est une chaine 
      
      POUR i = 1 a nbSelectionne 
      	
      	lNoCommande = TABLE1.COMMANDE[TableSelect(TABLE1, i)]
      	
      	si hlitrecherche(facture,fanumero,lNoCommande) alors
      		pour tout fdetail avec "fdnocomm = "+lNoCommande
      			si fdetail.ftype = 1 alors
      				lTotalVerre=0
      				si pas  sansespace(fdetail.fdcomposant1) = "" alors lTotalVerre++
      				si pas  sansespace(fdetail.fdcomposant2) = "" alors lTotalVerre++
      				si pas  sansespace(fdetail.fdcomposant3) = "" alors lTotalVerre++
      				TotalSelectionne += (fdetail.fdqteafacturer * lTotalVerre * lmultiplicateur)
      				//			si fdetail.fdcomposant1 <> fdetail.fdcomposant2 et fdetail.fdcomposant1 <> fdetail.fdcomposant3 et fdetail.fdcomposant2 <> fdetail.fdcomposant3 ...
      				//				et pas  sansespace(fdetail.fdcomposant1) = "" et pas  sansespace(fdetail.fdcomposant2) = "" et pas  sansespace(fdetail.fdcomposant3) = "" alors
      				////				csnCase += (fdetail.fdqte * 3 * lmultiplicateur)
      				//				csnCase += (fdetail.fdqteafacturer * 3 * lmultiplicateur)
      				//			sinon
      				////				csnCase += (fdetail.fdqte * 2 * lmultiplicateur)
      				//				csnCase += (fdetail.fdqteafacturer * 2 * lmultiplicateur)
      				//			FIN
      			fin 
      		fin
      		
      	FIN
      fin
      renvoyer TotalSelectionne
     type : 458752
   -
     name : checkIfSingleGlass
     procedure_id : 2150094623469016184
     type_code : 14
     code : |1-
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] checkIfSingleGlass (<NoCommande> est entier)
      //
      // Paramètres :
      //	NoCommande (entier) : <indiquez ici le rôle de NoCommande>
      // Valeur de retour :
      // 	booléen : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE checkIfSingleGlass(NoCommande est un entier)
      IsSingle est un booleen = faux
      si hlitrecherche(Facture,fanumero,NoCommande) alors
      	POUR TOUT Fdetail AVEC "fdnocomm = "+NoCommande +"et fdetail.ftype = 1"
      		
      //	hlitrecherche(Fdetail,fdnocomm,NoCommande)
      //	tantque fdetail.fdnocomm = facture.fanumero _et_ pas hendehors(fdetail) 
      	si fdetail.ThermosType = "S" alors renvoyer vrai
      //	HLitSuivant(Fdetail,fdnocomm)
      	fin
      	
      FIN
      
      renvoyer faux
     type : 458752
   -
     name : OPTIMARack
     procedure_id : 2295728091271768365
     type_code : 14
     code : |1+
      // préparation du fichier pour l'optimisation
      Procédure OPTIMARack(nlot = "200",lfabrication=faux,Jauge est un champ = null)
      
      i						est un entier
      z						est un entier
      li						est un entier
      sli						est un entier
      compteur				est un entier
      CptRack					est un entier
      j						est un  entier
      k						est un entier
      ligneaecrire			est une chaine
      ligneSpacer				est une chaine
      //wlargeur est un entier  // variable de travail pour largeur - cap
      //whauteur est un entier  // variable de travail pour hauteur - cap
      wlargeur				est un reel		// variable de travail pour largeur - cap
      whauteur				est un reel		// variable de travail pour hauteur - cap
      nombre					est un entier	= tableoccurrence("TABLE_SEPARE")
      nQterésiduelle			est un entier
      sDimcarr				est une chaine	//   pour trouver le nombre de carreau . blanc si 0 X 0
      lnoidentifiant			est un entier
      aumoinsuneligne			est un entier 
      lThermosDoubleTriple	est un entier	= faux
      sTruckRack				est une chaîne	// Truck et rack sur étiquette
      nTruckNumber			est un entier	// numéro de camion
      
      gtaRealNumberOfSlot		est un tableau associatif d'entiers
      
      POUR i = 1 À 41 
      	gtaRealNumberOfSlot[i] = i
      FIN
      gtaRealNumberOfSlot[42]	= 42
      gtaRealNumberOfSlot[43]	= 42
      gtaRealNumberOfSlot[44]	= 43
      gtaRealNumberOfSlot[45]	= 43
      gtaRealNumberOfSlot[46]	= 44
      gtaRealNumberOfSlot[47]	= 44
      
      
      nCustomerOrderLength	est un entier
      nLineTagOrderLength		est un entier
      
      pour j = 1 _a_ tableoccurrence("TABLE_SEPARE")
      	aumoinsuneligne			= 0
      	lThermosDoubleTriple	= faux
      	lnoidentifiant			= sansespace(numeriqueverschaine(DonneIdentifiant()))
      	fhandle est un entier = fcree(reppourxopt+"\"+nlot+"-"+lnoidentifiant+"-"+TABLE_SEPARE.PBASe[j]+TABLE_SEPARE.tprodtrtspec[j]+".asc")
      	si fhandle = -1 alors
      		ACSO_message("Erreur","Impossible de créer le fichier pour l'optimisation","Erreur")
      	FIN
      	multitache(50)
      	//	execute("fenjauge.progression",j/nombre * 100)
      	Jauge..valeur = j/nombre * 100
      	
      	ligneaecrire+=complete("Lot numéro "+nlot,32," ")
      	ligneaecrire+=DATEVERSCHAINE(datesys(),"JJMMAAAA")
      	ligneaecrire+=repete(" ",8)
      	ligneaecrire+=numeriqueverschaine(qtetotal[j],"8d")
      	ligneaecrire+="V2"
      	
      	FECRITLIGNE(fhandle,ligneaecrire) 
      	
      	ligneaecrire = ""	   
      	ligneaecrire+=numeriqueverschaine(Qtetotal[j],"8d")
      	FECRITLIGNE(fhandle,ligneaecrire)
      	
      	ligneaecrire	= ""	   
      	li				= 1
      	sli				= 1
      	compteur		= 0
      	
      	hlitrecherche(tempo,cletrait_base_esp_comm_ligne,...
      	HConstruitValClé(tempo,cletrait_base_esp_comm_ligne,Traitement[j],pbase[j],trang[j]))
      	
      	tantque pas HEnDehors() et sansespace(tempo.tbase) = sansespace(pbase[j]) ET SANSESPACE(TEMPO.Trngtrtspe) = SANSESPACE(TRANG[j])
      		//		si Tempo.timprimeetiq _et_ HLitRecherchePremier(racking,OrderNumberOrderDetailLineAlreadyOnTag,[tempo.tcomm,tempo.tlignedecommande,faux]) alors
      		//			racking.PrepNumber = prochainnumeroprep
      		//			racking.AlreadyOnTag = Vrai
      		//			hmodifie(racking,hNumEnrEnCours)
      		//			si racking.RackAuMur alors
      		//			sTruckRack = "R"+racking.RackNumber
      		//			sinon	
      		//			sTruckRack =  "R"+racking.RackNumber +"/" + racking.LineNumber
      		//		fin
      		////			trace(Racking.IDRacking,racking.ordernumber,Racking.Width,struckrack)
      		//		sinon
      		//			sTruckRack = ""	 
      		//		FIN
      		
      		si pas tempo.Tfabrication = lfabrication alors
      			hlitsuivant("tempo","cletrait_base_esp_comm_ligne")
      			continuer
      		fin
      		si tempo.TIntercalaireSeulement alors
      			si MemRecherche("MemEtiquette",tempo.tnoRecFdetail) ="" alors
      				memajoute("MemEtiquette",tempo.tnoRecFdetail,tempo.tnoRecFdetail)
      			fin
      			hlitsuivant("tempo","cletrait_base_esp_comm_ligne")
      			continuer
      		fin
      		aumoinsuneligne++
      		
      		si tempo.ttraitementspecial = Traitement[j] 
      			ligneaecrire += complete(sansespace(pbase[j]),16)    // 1-16
      			//			ligneaecrire+=Complète(SansEspace(ExtraitChaîne(Tempo.TDeA,2,"A")),5)  // 17-21
      			ligneaecrire += numeriqueverschaine(compteur,"5d")    // 17-21
      			ligneaecrire += gauche(tempo.tnomcourt,12)           // 22-33
      			ligneaecrire += complete(numeriqueverschaine(tempo.tcomm),12," ")  // 34-45
      			ligneaecrire += repete(" ",13)  // 46-58
      			ligneaecrire += complete("0.0",3," ")  // 59-61
      			ligneaecrire += numeriqueverschaine(tempo.tqteoriginale,"3d")  // 62-64
      			ligneaecrire += "Y"   // 65
      			ligneaecrire += numeriqueverschaine(1,"8d")  // 66-73
      			ligneaecrire += repete(" ",8)   // 74-81
      			
      			//			si position(tempo.tcapgaztube,"C") <> 0  alors
      			//				si config.calculcapactif alors
      			//					wlargeur = val(tempo.tlargeur) - config.Cnbmilcap
      			//					whauteur = val(tempo.thauteur) - config.Cnbmilcap
      			//				sinon
      			//					wlargeur = val(tempo.tlargeur) 
      			//					whauteur = val(tempo.thauteur) 
      			//				finc
      			//			SINON
      			//				wlargeur = val(tempo.tlargeur) 
      			//				whauteur = val(tempo.thauteur) 
      			//			FIN
      			si position(tempo.tcapgaztube,"C") <> 0  alors
      				si config.calculcapactif alors
      					wlargeur	= Arrondi(Val(Tempo.tlargeur),1) - config.Cnbmilcap
      					whauteur	= Arrondi(Val(Tempo.thauteur),1) - config.Cnbmilcap
      				sinon
      					wlargeur	= Arrondi(Val(Tempo.tlargeur),1)
      					whauteur	= Arrondi(Val(Tempo.thauteur),1) 
      				fin
      			SINON
      				wlargeur	= Arrondi(Val(Tempo.tlargeur),1) 
      				whauteur	= Arrondi(Val(Tempo.thauteur),1) 
      			FIN
      			
      			si sansespace(tempo.tnoforme) <> "" ALORS
      				ligneaecrire += "   11111"
      				ligneaecrire += "   11111"
      			sinon
      				//				ligneaecrire += NumériqueVersChaîne(wlargeur,"8d")
      				//				ligneaecrire += NumériqueVersChaîne(whauteur,"8d")
      				ligneaecrire += NumériqueVersChaîne(wlargeur,"8.1f")
      				ligneaecrire += NumériqueVersChaîne(whauteur,"8.1f")
      			FIN   // 82-97
      			
      			ligneaecrire+=complete(sansespace(gauche(tempo.tespace,8)),8) // 98-105
      			ligneaecrire += complete(sansespace(tempo.tlargeura)+...
      			" X "+sansespace(tempo.thauteura)...
      			,32," ")  // 106-137
      			
      			si tempo.timprimeetiq alors
      				ligneaecrire += numeriqueverschaine(1,"5d")  // 138-142
      			sinon
      				ligneaecrire += "    0"  // 138-142
      			fin
      			
      			ligneaecrire += "    0"  // 143-147
      			ligneaecrire += "    0"   // 148-152
      			//153-158
      			
      			ligneaecrire += complete(extraitchaine(tempo.tnoRack,1,"-"),6)
      			//159-166
      			si DateValide(tempo.tdaterequise)  alors
      				ligneaecrire+=DATEVERSCHAINE(tempo.tdaterequise,"JJMMAAAA")
      			sinon
      				ligneaecrire+="JJMMAAAA"
      			fin
      			
      			// 167-177
      			ligneaecrire+=Répète(" ",11)
      			//178-209
      			//ligneaecrire+=Répète(" ",32)
      			ligneaecrire+=Complète(sansespace(numeriqueverschaine(tempo.PoidsUnitaire,"7.2")),32)
      			
      			// 210-241
      			si sansespace(tempo.TDescCarr) = "" alors
      				si hlitrecherche(invent,INUM,tempo.Tnumcarr) alors
      					ligneaecrire+=gauche(invent.IDESC,32)
      				sinon
      					ligneaecrire+=repete(" ",32)
      				fin
      			sinon
      				si tempo.Tnumcarr <> "" alors
      					ligneaecrire+=Gauche(remplace(Tempo.TDescCarr,RC," "),32)
      				sinon
      					ligneaecrire+=Répète(" ",32)
      				fin
      				
      			fin
      			
      			
      			
      			
      			// 242-273
      			HLITRECHERCHE(IntercalaireCouleurs,IDIntercalaireCouleurs,TEMPO.TtypeSpacer)
      			ligneSpacer = ""
      			ligneSpacer+=sansespace(IntercalaireCouleurs.Description)+" "+sansespace(tempo.tespace)+" "+SansEspace(Tempo.Tespace2)
      			ligneaecrire += complete(gauche(ligneSpacer,32),32)
      			
      			// 274-305
      			ligneaecrire+=complete("FINI:"+sansespace(tempo.tfini),32)
      			// position 306-337
      			si sansespace(tempo.tnumcarr) <> "" alors
      				ligneaecrire+=complete("Carreaux LARGEUR:" + numeriqueverschaine(tempo.tcarreauv,"2d") + " HAUTEUR:" + NumériqueVersChaine(tempo.tcarreauh,"2d"),32," ")
      			sinon
      				ligneaecrire+=repete(" ",32)
      			fin
      			
      			//position 338-369
      			ligneaecrire+=complete(tempo.tcouleurcarr,32)
      			//position 370-401
      			ligneaecrire+=complete(tempo.tcouleurcarr2,32)
      			//position 402-433
      			ligneaecrire+=complete(tempo.tnotes,32)
      			//position 434-465
      			ligneaecrire+=complete(tempo.tnote2,32)
      			//position 466-497
      			ligneaecrire+=complete(sansespace(ExtraitChaîne(tempo.tdea,2,"A")),32)
      			
      			// ancien code
      			//position 498-633
      			//			ligneaecrire+=repete(" ",136)
      			//
      			// fin ancien code
      			
      			// nouveau code
      			// position 498-537
      			ligneaecrire+=repete(" ",40)
      			
      			// position 538-569 (type de scellant)
      			//			ligneaecrire+=(tempo.tscellant = 1 ? "H" sinon "U")+repete(" ",31)
      			ligneaecrire+=Complète(Tempo.camion,32)
      			// position 570-601
      			//			ligneaecrire+=Répète(" ",32)
      			ligneaecrire+=Complète(SansEspace(Tempo.tjob),32)
      			// position 602-633
      			ligneaecrire+=Répète(" ",32)
      			//			ligneaecrire+=Complète(SansEspace(sTruckRack),32)
      			
      			// fin nouveau code			
      			//position 634-665
      			si tempo.tlargeur <> tempo.tlargeura et tempo.thauteur <> tempo.thauteura alors
      				ligneaecrire += complete(sansespace(tempo.tlargeura)+...
      				" X "+sansespace(tempo.thauteura)...
      				,32," ")
      			sinon
      				ligneaecrire+=repete(" ",32)
      			FIN
      			
      			//position 666-697
      			ligneaecrire+=gauche(tempo.tnomLivraison,32)
      			//position 698-729
      			SI SansEspace(Tempo.tclient) = "462" ALORS
      				nCustomerOrderLength	= 13
      				nLineTagOrderLength		= 18
      			sinon SI SansEspace(Tempo.tclient) = "027"
      				nCustomerOrderLength	= 12
      				nLineTagOrderLength		= 20
      			SINON
      				nCustomerOrderLength	= 15
      				nLineTagOrderLength		= 16
      			FIN
      			
      			//			ligneaecrire+=sansespace(gauche(tempo.tordre,14))+"/"+sansespace(gauche(tempo.tjobligne,14))
      			//			ligneaecrire+=repete(" ",32-taille(sansespace(gauche(tempo.tordre,14))+"/"+sansespace(gauche(tempo.tjobligne,14))))
      			ligneaecrire+=SansEspace(Gauche(Tempo.tordre,nCustomerOrderLength))+"/"+SansEspace(Gauche(Tempo.TJOBLIGNE,nLineTagOrderLength))
      			ligneaecrire+=Répète(" ",32-Taille(SansEspace(Gauche(Tempo.tordre,nCustomerOrderLength))+"/"+SansEspace(Gauche(Tempo.TJOBLIGNE,nLineTagOrderLength))))
      			//position 730-761
      			ligneaecrire+=complete(tempo.tdescription,32)
      			//position 762-793
      			//			ligneaecrire += complete(sansespace(numeriqueverschaine(tempo.tqte ,"8d")),32) // pour imprimer la quantité sur étiquette
      			ligneaecrire += complete(sansespace(numeriqueverschaine(tempo.tqte ,"8d"))+"/"+sansespace(numeriqueverschaine(tempo.tQteTotal,"8d")),32) // pour imprimer la quantité sur étiquette
      			//position 795-825
      			ligneaecrire += complete(sansespace(NumériqueVersChaine(arrondi(val(tempo.tlargeur))))+...
      			" X "+sansespace(NumériqueVersChaine(arrondi(val(tempo.thauteur))))...
      			,32," ")
      			//position 826-857
      //			ligneaecrire+=complete(nlot+"-"+lnoidentifiant+"-"+TABLE_SEPARE.PBASe[j]+".asc",32)
      
      // Modification pour le code barre sur l'étiquette REF: Application externe de scan de MSM
      			ligneaecrire+=complete(NumériqueVersChaîne(Tempo.tcomm,"010d")+"-"+NumériqueVersChaîne(Tempo.tlignedecommande,"03d")+"-"+NumériqueVersChaîne(Tempo.tqte,"03d"),32)
      //////////////////			
      			// position 858-905
      			//ligneaecrire+=Complète(Tempo.camion,48)
      			
      			
      			CptRack=0
      			si hlitrecherche(Camions,Abreviation,sansespace(tempo.camion)) alors
      				nTruckNumber = camions.NoCamion
      			FIN
      			pour i = 1 a tempo.tqtebase 
      				si tempo.tdoubletriple = "Triple" alors
      					//	cptrack = 0
      				fin
      				
      				pour z = 1 a tempo.tqte
      					compteur++
      					CptRack++
      					ligneaecrire[[66 a 73]]						= numeriqueverschaine(1,"8d")  // 66-73
      					ligneaecrire[[17 a 21]]						= numeriqueverschaine(compteur,"5d")    // 17-21
      					ligneaecrire[[153 a 158]]					= complete(ExtraitChaîne(tempo.tnoRack,CptRack,"-"),6)    // 153-158
      					gstCurrentTransferReport					= allouer un STTransferreport()
      					gstCurrentTransferReport.nOrderNumber		= tempo.tcomm
      					gstCurrentTransferReport.slargeur			= tempo.tlargeur
      					gstCurrentTransferReport.shauteur			= tempo.thauteur
      					gstCurrentTransferReport.sSlotNumber		=  Complète(ExtraitChaîne(Tempo.tnoRack,CptRack,"-"),6)
      					gstCurrentTransferReport.sGlassCode			= tempo.tbase
      					gstCurrentTransferReport.sShape				= tempo.tnoforme
      					gstCurrentTransferReport.sGrill				= tempo.tnumcarr
      					gstCurrentTransferReport.sSpacerDimension	= tempo.tespace
      					si hlitrecherche(IntercalaireCouleurs,IDIntercalaireCouleurs,tempo.TtypeSpacer) alors
      						gstCurrentTransferReport.sSpacerType = IntercalaireCouleurs.Description
      					FIN
      					gstCurrentTransferReport.bExternalCommande = CheckIfExterne(tempo.tbase,tempo.tcomm)
      					gtabTransferReport.ajoute(gstCurrentTransferReport)
      					
      					
      					
      					
      					//					ligneaecrire[[858 a 905]]= complete(numériqueverschaine(z)+"/"+numeriqueverschaine(tempo.tqte),48)    // 858-905
      					
      					
      					
      					
      					//					SI  Tempo.timprimeetiq _ET_  HLitRecherchePremier(Racking,TruckNumberOrderNumberOrderDetailLineAlreadyOnTag,[nTruckNumber,Tempo.tcomm,Tempo.tlignedecommande,z]) ALORS
      					SI  HLitRecherchePremier(Racking,TruckNumberOrderNumberOrderDetailLineAlreadyOnTag,[tempo.tdaterequise,nTruckNumber,Tempo.tcomm,Tempo.tlignedecommande,z]) ALORS
      						Racking.PrepNumber		= prochainnumeroprep
      						Racking.AlreadyOnTag	= Vrai
      						HModifie(Racking,hNumEnrEnCours)
      						SI Racking.RackAuMur ALORS
      							sTruckRack = "R"+Racking.RackNumber
      						SINON	
      							sTruckRack =  "R"+Racking.RackNumber +"/" + gtaRealNumberOfSlot[Racking.LineNumber]
      						FIN
      						//			trace(Racking.IDRacking,racking.ordernumber,Racking.Width,struckrack)
      					SINON
      						sTruckRack = ""	 
      					FIN
      					ligneaecrire[[602 À 633]]=  Complète(SansEspace(sTruckRack),32)
      					
      					si  i = 1  alors
      						si tempo.timprimeetiq alors
      							ligneaecrire[[138 a 142]] = "    1"
      						sinon
      							ligneaecrire[[138 a 142]] = "    0"
      						fin
      					sinon
      						ligneaecrire[[138 a 142]] = "    0"
      					FIN
      					
      					fecritligne(fhandle,ligneaecrire)
      				fin
      			fin
      			ligneaecrire = ""
      		FIN
      		hlitsuivant("tempo","cletrait_base_esp_comm_ligne")
      	fin
      	compteur = 0
      	fferme(fhandle)
      	si aumoinsuneligne =0 alors
      		fsupprime(reppourxopt+"\"+nlot+"-"+lnoidentifiant+"-"+TABLE_SEPARE.PBASe[j]+TABLE_SEPARE.tprodtrtspec[j]+".asc")
      	sinon
      		FileCreatedArray.ajoute(reppourxopt+"\"+nlot+"-"+lnoidentifiant+"-"+TABLE_SEPARE.PBASE[j]+TABLE_SEPARE.tprodtrtspec[j]+".asc")
      	fin
      fin
      
      //si pas lfabrication alors
      //	iConfigure(imprimanteetiquette)
      //	iimprimeetat(EEtiquetteIntercalaire,"MemEtiquette")
      //fin
      
     type : 458752
   -
     name : remplir_table_separe
     procedure_id : 2295728559423247327
     type_code : 14
     code : |1+
      Procédure remplir_table_separe()
      produitdebase est un  chaine
      special est une chaine  // pout traitement spécial
      ancienspecial est une chaine
      qtebase est un entier
      wqtetotal est un entier = 0
      wqteligne est un entier=0
      wqtelignev1 est un entier = 0
      rang est une chaine
      ancienrang est une chaine
      noprodtrtspec est une chaine
      tablesupprimetout("TABLE_SEPARE")
      
      
      //hlitpremier("tempo","traitement_base")
      hlitpremier(tempo,CleRang)
      
      produitdebase = tempo.tbase
      ancienspecial = tempo.ttraitementspecial
      rang = tempo.Trngtrtspe
      ancienrang = tempo.Trngtrtspe
      noprodtrtspec = tempo.tprodtrtspe
      //Code WinDev 5.5 remplacé par la migration :
      //tantque pas h.endehors 
      tantque pas HEnDehors() 
      	//Code WinDev 5.5 remplacé par la migration :
      	//	tantque tempo.tbase = produitdebase  et tempo.ttraitementspecial=ancienspecial et pas h.endehors
      	tantque tempo.tbase = produitdebase  et tempo.ttraitementspecial=ancienspecial et tempo.Trngtrtspe = ancienrang et pas HEnDehors()
      		si pas tempo.TIntercalaireSeulement alors 		 
      			qtebase++  
      			wqtetotal += (tempo.tqtebase * tempo.tqte)
      			wqteligne += tempo.tqtebase
      			special = tempo.ttraitementspecial
      			rang = tempo.Trngtrtspe
      			si tempo.tqtebase = 1 alors
      				wqtelignev1 += tempo.tqte
      			sinon
      				wqtelignev1 += (tempo.tqte * 2)
      
      			FIN
      		fin
      		hlitsuivant(tempo,CleRang)
      	fin
      
      
      	tableajouteligne(TABLE_SEPARE,produitdebase,qtebase,qtebase,special,wqtetotal,wqteligne,rang,noprodtrtspec,wqtelignev1)
      	produitdebase = tempo.tbase	 
      	ancienspecial = tempo.ttraitementspecial
      	ancienrang = tempo.Trngtrtspe
      	noprodtrtspec = tempo.tprodtrtspe
      	qtebase = 0
      	wqtetotal = 0
      FIN
      
      //Code WinDev 5.5 remplacé par la migration :
      //tableaffiche("TABLE_SEPARE","*")
      tableaffiche("TABLE_SEPARE",taCourantPremier)
      
     type : 458752
   -
     name : TransfertVideojet1
     procedure_id : 2295939484880251436
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] TransfertVideojet1 (<NoBatch> est chaîne)
      //
      // Paramètres :
      //	NoBatch (chaîne ANSI) : <indiquez ici le rôle de NoBatch>
      // Valeur de retour :
      // 	booléen : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE TransfertVideojet1(NoBatch est un chaine)
      
      nRecordcourant est un entier
      lcpt est un entier = 0
      HGèreREP(Faux)
      HSurErreur("*",hErrDoublon,"")
      j est un entier
      k est une entier
      fichiertrsf est une chaine
      fichiertrsfTiger est une chaine
      nUmprep est un entier
      sVariable est une chaine
      clederecherche est une chaine
      CREERFICHIER EST UN BOOLEEN = VRAI
      nbFeuilleImprimee est une entier
      NbFeuilleImprimee2 est un entier
      
      OldOrder est une chaine = ""
      //hlitpremier(tempo,clecommandeligne)
      chemintempo est une chaine = ".\"+NetAdresseIP()
      //chemintempo est une chaine = completerep(sysrep(srAppDataLocal))+"temp"
      txtreq est une chaine = [
      	select count(facture.fanumero) as NumberOfOrder from facture where facture.FImprimeFeuille = 1
      ]
      reqsql est une source de donnees
      
      NumberOfOrder est un entier = 0
      
      si HExécuteRequêteSQL(reqsql,hRequêteDéfaut,txtreq) alors
      	hlit(reqsql,1)
      	NumberOfOrder = reqsql.numberoforder
      FIN
      
      
      SI CleUsb ALORS chemintempo = ComplèteRep(repencours)+"tempo\"
      
      
      HLitPremier(Tempo,tposition)
      
      fichiertrsf = "VJ_"+NumériqueVersChaîne(NoBatch+"-"+Tempo.tnumeroprep)
      fichiertrsfTiger = "TS_"+NumériqueVersChaîne(NoBatch+"-"+Tempo.tnumeroprep)
      HCréation(impvideo)
      HCréation(TigerCarrelage)
      
      POUR k = 1 À 10
      	SI SansEspace(config.CheminTrsfCarrelage[k]) <> "" ALORS
      		SI fRep(ComplèteRep(config.CheminTrsfCarrelage[k])) = "" ALORS
      			fRepCrée(ComplèteRep(config.CheminTrsfCarrelage[k]))
      		FIN
      	FIN
      	
      	
      	SI SansEspace(config.CheminTrsfVidéojet[k]) <> "" ALORS
      		
      		SI fRep(ComplèteRep(config.CheminTrsfVidéojet[k])) = "" ALORS
      			fRepCrée(ComplèteRep(config.CheminTrsfVidéojet[k]))
      		FIN
      	FIN
      	
      FIN
      
      
      
      //SI PAS Tempo.tnumeroprep = 0 ALORS
      //	SI PAS(fRep(ComplèteRep(config.CheminTrsfVidéojet[1])+fichiertrsf+".fic")) ~= ""  ALORS
      //		SI ACSO_message("Question","Le lot # "+fichiertrsf+" à déjà été transféré."+RC+" Voulez-vous le transférér à nouveau","OuiNon",2) = IDNO ALORS
      //			CREERFICHIER = Faux
      //		FIN
      //	FIN
      //FIN
      
      
      
      SI CREERFICHIER ALORS
      	nbFeuilleImprimee=0
      	//	OuvreSoeur(FenAttentePetite,"Préparation des feuilles de travail en cours")
      	iConfigure(SansEspace(imprimanteconfirmation),Vrai)
      	//
      	//	iParamètre("DEFAUT=NON")
      	//	iParamètre("FORMATPAPIER=LETTRE")
      	//	iParamètre("QUALITE=MOYENNE")
      	//	iParamètre(iOrientation, iOrientation_Portrait)
      	iDestination(iPDFGénérique,ComplèteRep(CheminPdfDocument)+NoBatch)
      	POUR TOUT Facture AVEC "FImprimeFeuille = "+Vrai
      		//Multitâche(130) //il y avait un crash quand les feuilles de travail étaient imprimées trop vite...
      		requeteDétailCommandeTous.pNoComm = Facture.fanumero
      		requeteDétailCommandeTous.pFdType = 1
      		requeteDétailCommandeTous.pNoLigne = Null
      		requeteDétailCommandeTous.pQte = 0
      		requeteDétailCommandeTous.pTypePeinture = 1
      		HExécuteRequête(requeteDétailCommandeTous)
      		
      		Multitâche(10)
      		
      		SI OldOrder <> requeteDétailCommandeTous.fdnocomm ALORS
      			OldOrder = requeteDétailCommandeTous.fdnocomm
      			HExécuteRequête(RequetefeuilleLivraison,hRequêteDéfaut,requeteDétailCommandeTous.fdnocomm)
      			iEnchaînementAjoute(ConfirmationTRNmat,Faux,0,Faux)
      		FIN
      		
      		iEnchaînementAjoute(EfeuilleTravail,"TrsfVideojet",NoBatch)
      //		facture.FImprimeFeuille = 0
      		hmodifie(facture,hNumEnrEnCours)
      		
      		nbFeuilleImprimee++
      		JaugePDF..valeur = nbFeuilleImprimee/NumberOfOrder * 100
      	FIN
      
      	
      	
      	SI nbFeuilleImprimee <> 0 ALORS
      		ifenetreabandon(faux)
      		iEnchaînementImprime()
      		FileCreatedArray.Ajoute(ComplèteRep(CheminPdfDocument)+NoBatch+".pdf")
      	SINON
      		Erreur("Il semble y avoir eu un problème lors de l'impression des feuilles de travail")
      		RENVOYER Vrai
      	FIN
      
      ///////////////////////////////////////////////////////
      // Préparer un fichier PDF Seulement pour les feuilles
      ///////////////////////////////////////////////////////
      	iDestination(iPDFGénérique,ComplèteRep(CheminPdfDocument)+NoBatch+"Feuilles")
      	NbFeuilleImprimee2 = 0
      	POUR TOUT Facture AVEC "FImprimeFeuille = "+Vrai
      		requeteDétailCommandeTous.pNoComm = Facture.fanumero
      		requeteDétailCommandeTous.pFdType = 1
      		requeteDétailCommandeTous.pNoLigne = Null
      		requeteDétailCommandeTous.pQte = 0
      		requeteDétailCommandeTous.pTypePeinture = 1
      		HExécuteRequête(requeteDétailCommandeTous)
      		
      		Multitâche(10)
      		
      		
      		
      		iEnchaînementAjoute(EfeuilleTravail,"TrsfVideojet",NoBatch)
      		Facture.FImprimeFeuille = 0
      		HModifie(Facture,hNumEnrEnCours)
      		
      		NbFeuilleImprimee2++
      		JaugePDF..Valeur = NbFeuilleImprimee2/NumberOfOrder * 100
      		
      	FIN
      	
      	SI NbFeuilleImprimee2 <> 0 ALORS
      		iFenêtreAbandon(Faux)
      		iEnchaînementImprime()
      		FileCreatedArray.Ajoute(ComplèteRep(CheminPdfDocument)+NoBatch+"Feuilles"+".pdf")
      	SINON
      		Erreur("Il semble y avoir eu un problème lors de l'impression des feuilles de travail")
      		RENVOYER Vrai
      	FIN
      	
      	Multitâche(100)
      	
      	
      	//	POUR TOUT Facture AVEC "FImprimeFeuille = "+Vrai
      	//		Facture.FImprimeFeuille=Faux
      	//		HModifie(Facture,hNumEnrEnCours)
      	//	FIN
      	
      	
      	//Ferme(FenAttentePetite)
      	
      	
      	//	OuvreSoeur(FenAttente,"Transfert en cours, Patientez..........")
      	HLitPremier(Tempo,tposition)
      	TANTQUE PAS HEnDehors(Tempo)
      		HLit(Fdetail,Tempo.tnoRecFdetail)
      		Fdetail.TDeA = Tempo.TDeA
      		Fdetail.fNoLot = NoBatch
      		HModifie(Fdetail,hNumEnrEnCours)
      		lcpt++
      		JaugeVideojet..valeur = lcpt / hnbenr(tempo) * 100
      		//		Message(lcpt)
      		//		FenAttente.Libellé1 = "Transfert de la commande # "+Tempo.tcomm
      		//		MultitâcheRepeint(FenAttente)
      		clederecherche = HConstruitValClé(impvideo,clecommandelignefdetail,Tempo.tnumeroprep,Tempo.tcomm,...
      		Tempo.tlignedecommande,Tempo.Tnumligne)
      		//	recordcourant = hsauveposition(impvideo)
      		SI PAS HLitRecherche(impvideo,clecommandelignefdetail,clederecherche) ALORS
      			HRAZ(impvideo)
      			// si pas tempo.tienergiverre alors  // ajouté pour ne pas doubler les ligne dans vidéojet
      			SI SansEspace(Tempo.tnoforme) = "" ALORS
      				impvideo.vforme = Faux
      			SINON
      				impvideo.VNoForme = Tempo.tnoforme
      				impvideo.vforme = Vrai
      			FIN
      			impvideo.vimprime= 0
      			impvideo.VMarqueTigerstop2 = 0
      			impvideo.VmarqueTigerStop1 = 0
      			impvideo.vnoligne = Tempo.tligne
      			impvideo.vnoprep= Tempo.tnumeroprep
      			impvideo.vcommande = Tempo.tcomm
      			impvideo.VNoetiq = Tempo.Tnumligne
      			//	impvideo.vlignecommande"} = tempo.tligne
      			impvideo.vlignecommande = Tempo.tlignedecommande
      			//	impvideo.vclientnom"}= gauche(tempo.tnomclient,config.vjclient)
      			//			impvideo.vclientnom= gauche(tempo.tnomcourt,5)
      			impvideo.vclientnom= Tempo.tnomcourt
      			impvideo.vdate = Tempo.tdate
      			
      			// Modification nécessaire pour TRN.
      			// TRN fonctionne avec le numéro de lot de OPTIMA
      			// c'est ce numéro de lot qui apparait à l'écran de videojet
      			// ce numéro est sauvegardé dans le champ vespace du fichier impvideo
      			// ce champ de sera jamais de plus de 2 caractere.
      			
      			
      			
      			impvideo.vespace  = SansEspace(Tempo.tespace)+"-"+SansEspace(NoBatch)
      			impvideo.vcommandeclient = Tempo.tcommclient
      			impvideo.vcapgazlowe = Tempo.tcapgaztube
      			impvideo.vtraitementspecial = Tempo.ttraitementspecial
      			impvideo.vpbase = Tempo.tbase
      			impvideo.vlargeur = Tempo.tlargeur
      			impvideo.vhauteur = Tempo.thauteur
      			impvideo.vcode    = Tempo.tproduit
      			impvideo.vcarreauh    = Tempo.tcarreauh
      			impvideo.vcarreauv    = Tempo.tcarreauv
      			impvideo.Vnumcarr    = Tempo.Tnumcarr
      			impvideo.vespace2    = Tempo.Tespace2
      			impvideo.VNote       = Tempo.Tnotes
      			impvideo.Vnote2      = Tempo.tnote2 
      			impvideo.Vcouleurfond = Tempo.tcouleurfond
      			impvideo.Vcouleurtexte = Tempo.tcouleurtexte
      			impvideo.vgras = Tempo.tgras
      			impvideo.vitalique = Tempo.Titalique
      			
      			//			SI HLITRECHERCHE(typespac,tnumero,TEMPO.TtypeSpacer) ALORS
      			//				//impvideo.vtypespacer"}    = tempo.TtypeSpacer
      			//				impvideo.vtypespacer    = GAUCHE(typespac.tdesccourte,5)
      			//				impvideo.vesptype = typespac.tdesccourte
      			//
      			//			FIN
      			IG = SansEspace(config.texteigma)
      			SI HLitRecherche(IntercalaireCouleurs,IDIntercalaireCouleurs,Tempo.TtypeSpacer) ALORS
      				//impvideo.vtypespacer"}    = tempo.TtypeSpacer
      				impvideo.vTypeSpacer    = Gauche(IntercalaireCouleurs.DescriptionCourte,5)
      				impvideo.vesptype = IntercalaireCouleurs.DescriptionCourte
      				SI HLitRecherche(Intercalaires,IDIntercalaires,IntercalaireCouleurs.idIntercalaires) ALORS
      					SI PAS Intercalaires.ImpressionIgmacVideojet ALORS IG = ""  
      				FIN
      			FIN
      			
      			SI PAS Position(Tempo.tcapgaztube,"C") = 0 ALORS
      				impvideo.vcap = "Cap"
      				CP = "CAP"
      			SINON
      				impvideo.vcap = ""
      				CP = ""
      			FIN
      			
      			SI PAS Position(Tempo.tcapgaztube,"Z") = 0 ALORS
      				SI  HLitRecherche(IntercalaireCouleurDimensions,IDIntercalaireCouleursnumero,...
      					HConstruitValClé(IntercalaireCouleurDimensions,IDIntercalaireCouleursnumero,SansEspace(Tempo.TtypeSpacer),SansEspace(Tempo.tespace))) ALORS
      					//
      					
      					//				si hlitrecherche(Intercalaires,IDIntercalaires,IntercalaireCouleurs.idIntercalaires) alors
      					//					impvideo.VAenlever = Intercalaires.AenleverVideojetArgon
      					impvideo.vAenlever = IntercalaireCouleurDimensions.AenleverVideojetArgon
      				FIN
      				
      				
      				impvideo.vargon = "ARG"
      				Z  = SansEspace(config.vjz)
      			SINON
      				SI  HLitRecherche(IntercalaireCouleurDimensions,IDIntercalaireCouleursnumero,...
      					HConstruitValClé(IntercalaireCouleurDimensions,IDIntercalaireCouleursnumero,SansEspace(Tempo.TtypeSpacer),SansEspace(Tempo.tespace))) ALORS
      					//				si hlitrecherche(Intercalaires,IDIntercalaires,IntercalaireCouleurs.idIntercalaires) alors
      					//				impvideo.VAenlever = Intercalaires.AenleverVideojet
      					impvideo.vAenlever = IntercalaireCouleurDimensions.AenleverVideojet
      				FIN
      				impvideo.vargon = ""
      				Z  = ""
      			FIN
      			
      			
      			SI Tempo.tenergiverre ALORS
      				impvideo.vlowe = "ENG"
      				LW = SansEspace(config.vjlw)
      				FL = "V"
      			SINON
      				impvideo.vlowe = ""
      				LW = ""
      				FL = ""
      			FIN
      			
      			impvideo.vqte= Tempo.tqte
      			impvideo.vdescription = Gauche(Tempo.tdescription,25)
      			impvideo.vcarrelage = Tempo.tcarrelage
      			impvideo.vdoubletriple = Tempo.tdoubletriple
      			POUR j = 1 À 10
      				{"impvideo.vnbdimension"+j  } = {"tempo.Tnbdimension"+j}
      				{"impvideo.vnbmorceau"+j  } = {"tempo.Tnbmorceau"+j}
      				
      			FIN
      			SI PAS SansEspace(Tempo.Tnumcarr) = "" ET HLitRecherche(invent,INUM,Tempo.Tnumcarr) ALORS
      				//			  si pas tempo.TDemiCarrelage alors
      				MajCarrelageTRN()
      				//			 fin   
      				
      				impvideo.vDescCarr = invent.IDESC
      				impvideo.VdescCourteCarr = invent.idesccourte
      				//				si hlitrecherche(typecarr,tcdescription,invent.itypecarr) alors
      				SI HLitRecherche(typecarr,tcdescription,Tempo.TtypeCalcul) ALORS
      					impvideo.vHauteurContour = typecarr.variableutil1
      					impvideo.vLargeurContour = typecarr.VariableUtil
      					impvideo.vTypeDessin = typecarr.Typedessin
      					impvideo.vCaseHaut   = typecarr.TcInterrupteurHaut
      					impvideo.VCaseGauche   = typecarr.TcInterrupteurGauche
      					impvideo.vCaseDroite   = typecarr.TcInterrupteurDroit
      					impvideo.vCaseBas   = typecarr.TcInterrupteurBas
      					impvideo.vAjustementCarhauteur = typecarr.AjustNbCarHauteur
      					impvideo.vAjustementCarLargeur = typecarr.AjustNbCarLargeur
      					
      				FIN
      			FIN
      			SI Tempo.TDemiCarrelage ALORS
      				impvideo.vTypeDessin = 3
      			FIN
      			impvideo.vTypeCalcul = Tempo.TtypeCalcul
      			impvideo.vVariableX = Tempo.Tvx
      			impvideo.vVariablex1 = Tempo.Tvx1
      			impvideo.vMatch = Tempo.TMatch
      			impvideo.VordreXopt = Tempo.TordreXopt
      			impvideo.vtypeintercalaire = Tempo.ttypeintercalaire
      			//			CAlculCarrelage()
      			
      			//			DT  = sansespace(DATEVERSCHAINE(tempo.tdate,config.cformatdedate))
      			DT  = SansEspace(DateVersChaîne(DateSys(),config.cformatdedate))
      			CL = SansEspace(Gauche(Tempo.tnomcourt,config.vjclient))
      			VCO = SansEspace(Tempo.tordre)
      			CT  = SansEspace(NumériqueVersChaîne(Tempo.tcomm))
      			//Code WinDev 5.5 remplacé par la migration :
      			//IN = sansespace(tempo.tespace)
      			SPA = SansEspace(Tempo.tespace)
      			CD = SansEspace(Tempo.tcomposant1)+SansEspace(Tempo.tcomposant2)+SansEspace(Tempo.tcomposant3)
      			DI = SansEspace(Tempo.tlargeur)+"X"+SansEspace(Tempo.thauteur)
      			//			LI = sansespace(NumériqueVersChaine(tempo.tnoetiq,"12d"))
      			LI = SansEspace(NumériqueVersChaîne(Tempo.tlignedecommande,"12d"))
      			NU = SansEspace(NumériqueVersChaîne(Tempo.tcomm))+"-"+SansEspace(NumériqueVersChaîne(Tempo.tlignedecommande))
      			BA = SansEspace(NoBatch)
      			NJ = SansEspace(Tempo.tJobligne)
      			
      			formule = "y est une chaine"+RC+"y="+lesformules[Tempo.tnumeroformule]+RC+"renvoyer(y)"
      			_resultat est une chaine = compile("reponse",formule)
      			
      			SI _resultat = "" ALORS
      				impvideo.vligneaimprimer = reponse()  
      			SINON
      				impvideo.vligneaimprimer = ""
      			FIN
      			
      			HAjoute(impvideo)
      			
      			SI HErreurDoublon() ALORS
      			FIN
      		FIN
      		
      		HLitSuivant(Tempo,tposition)
      		
      	FIN
      	
      	
      	HAlias(impvideo,fichiertrsf)
      	
      	HChangeRep({fichiertrsf},chemintempo)
      	
      	
      	HCréation({fichiertrsf})
      	HLitPremier(impvideo,IMCLEUNIK)
      	
      	TANTQUE PAS HEnDehors(impvideo)
      		HCopieEnreg({fichiertrsf},impvideo,hValDéfaut)
      		HAjoute({fichiertrsf})
      		SI HErreurDoublon() ALORS
      			
      		FIN
      		HLitSuivant(impvideo,IMCLEUNIK)
      	FIN
      	
      	POUR k = 1 À 10
      		SI SansEspace(config.CheminTrsfVidéojet[k]) <> "" ALORS
      			SI CleUsb ALORS
      				fCopieFichier(chemintempo+"\"+fichiertrsf+".fic",SansEspace(config.CheminTrsfVidéojet[k])+"\"+fichiertrsf+".fic")
      				fCopieFichier(chemintempo+"\"+fichiertrsf+".ndx",SansEspace(config.CheminTrsfVidéojet[k])+"\"+fichiertrsf+".ndx")
      				
      			SINON	
      				SI PAS HCopieFichier("",SansEspace(config.CheminTrsfVidéojet[k])+"\"+fichiertrsf+".fic",gConnexionHF,".\"+NetAdresseIP()+"\"+fichiertrsf+".fic",hCopieIndex) ALORS
      					
      				sinon	
      					FileCreatedArray.Ajoute(SansEspace(config.CheminTrsfVidéojet[k])+"\"+fichiertrsf+".fic")
      					FileCreatedArray.Ajoute(SansEspace(config.CheminTrsfVidéojet[k])+"\"+fichiertrsf+".ndx")
      					
      				fin
      			FIN
      		FIN
      		
      	FIN
      	HAnnuleAlias(fichiertrsf)
      	HSupprimeFichier(gConnexionHF,".\"+NetAdresseIP()+"\"+fichiertrsf+".fic")
      	
      	SI PAS HNbEnr(TigerCarrelage) = 0 ALORS
      		HAlias(TigerCarrelage,fichiertrsfTiger)
      		//	hchangerep({fichiertrsftiger},completerep(config.CheminTrsfCarrelage[1]))
      		HChangeRep({fichiertrsfTiger},chemintempo)
      		//			HChangeConnexion({fichiertrsfTiger},"ConnexionLocaleTemp")
      		HCréation({fichiertrsfTiger})
      		HLitPremier(TigerCarrelage,IMCLEUNIK)
      		TANTQUE PAS HEnDehors(TigerCarrelage)
      			HCopieEnreg({fichiertrsfTiger},TigerCarrelage,hValDéfaut)
      			HAjoute({fichiertrsfTiger})
      			SI HErreurDoublon() ALORS
      				
      			FIN
      			HLitSuivant(TigerCarrelage,IMCLEUNIK)
      		FIN
      		POUR k = 1 À 10
      			SI SansEspace(config.CheminTrsfCarrelage[k]) <> "" ALORS
      				SI CleUsb ALORS
      					fCopieFichier(chemintempo+"\"+fichiertrsf+".fic",SansEspace(config.CheminTrsfCarrelage[k])+"\"+fichiertrsf+".fic")
      					fCopieFichier(chemintempo+"\"+fichiertrsf+".ndx",SansEspace(config.CheminTrsfCarrelage[k])+"\"+fichiertrsf+".ndx")
      				SINON
      					SI PAS HCopieFichier("",SansEspace(config.CheminTrsfCarrelage[k])+"\"+fichiertrsfTiger+".fic",gConnexionHF,".\"+NetAdresseIP()+"\"+fichiertrsfTiger+".fic",hCopieIndex) ALORS
      						Info(HErreurInfo(hErrComplet))
      					sinon
      						
      						FileCreatedArray.Ajoute(SansEspace(config.CheminTrsfCarrelage[k])+"\"+fichiertrsfTiger+".fic")
      						FileCreatedArray.Ajoute(SansEspace(config.CheminTrsfCarrelage[k])+"\"+fichiertrsfTiger+".ndx")
      						
      					FIN
      				fin
      			FIN
      			
      		FIN
      		
      		HAnnuleAlias(fichiertrsfTiger)
      		HSupprimeFichier(gConnexionHF,".\"+NetAdresseIP()+"\"+fichiertrsfTiger+".fic")
      	FIN
      	
      	
      	//Ferme(FenAttente)
      FIN
      
      HSurErreur("*",hErrDoublon)
      
      
      HGèreREP(Vrai)
      
      
      
      
     type : 458752
   -
     name : MajCarrelageTRN
     procedure_id : 2295940322398938600
     type_code : 14
     code : |1+
      Procédure MajCarrelageTRN()
      HRAZ(TigerCarrelage)
      TigerCarrelage.vimprime = " "
      TigerCarrelage.vnoligne = tempo.tlignedecommande
      TigerCarrelage.vnoprep = tempo.tnumeroprep
      TigerCarrelage.vcommande = tempo.tcomm
      TigerCarrelage.vlignecommande = tempo.tnoetiq
      TigerCarrelage.vclientnom = gauche(tempo.tnomclient,config.vjclient)
      TigerCarrelage.vdate = tempo.tdate
      // Modification nécessaire pour TRN.
      // TRN fonctionne avec le numéro de lot de OPTIMA
      // c'est ce numéro de lot qui apparait à l'écran de Tigerstop 
      // ce numéro est sauvegardé dans le champ vespace du fichier tiger
      // ce champ de sera jamais de plus de 2 caractere.
      TigerCarrelage.vespace  = sansespace(tempo.tespace)+"-"+sansespace(sainolot)
      TigerCarrelage.vcommandeclient = tempo.tcommclient
      TigerCarrelage.vcapgazlowe = tempo.tcapgaztube
      TigerCarrelage.vtraitementspecial = tempo.ttraitementspecial
      TigerCarrelage.vpbase = tempo.tbase
      TigerCarrelage.vlargeur = tempo.tlargeur
      TigerCarrelage.vhauteur = tempo.thauteur
      TigerCarrelage.vcode   = tempo.TNumCarr
      tigercarrelage.vNbCarreauH = tempo.TCarreauH
      tigercarrelage.vNbCarreaul = tempo.TCarreauv
      tigercarrelage.vhauteurcontour = tempo.THauteurContour
      tigercarrelage.vlargeurcontour = tempo.TlargeurContour
      tigercarrelage.vhauteurtete = tempo.THauteurtete
      TigerCarrelage.vNumCarrBarrepos = 1   // pour empecher les doublons quand carrelage de tete avec
      										// barre du bas différente
      
      
      //si pas position(tempo.tcapgaztube,"I") = 0 alors
      //	TigerCarrelage.vesptype = "Inex"
      //sinon
      //	TigerCarrelage.vesptype = "Alu."
      //FIN
      //A FAIRE : Ajuster la ligne suivante
      SI HLITRECHERCHE(typespac,tnumero,TEMPO.TtypeSpacer) ALORS
      	//impvideo.vtypespacer"}    = tempo.TtypeSpacer
      	TigerCarrelage.vesptype  = GAUCHE(typespac.tdesccourte,5)
      FIN
      
      
      TigerCarrelage.vqte = tempo.tqte
      si hlitrecherche(invent,INUM,tempo.TNumCarr) alors
      	TigerCarrelage.vdescriptionCarr = invent.idesc
      fin
      
      
      TigerCarrelage.vcarrelage = tempo.tcarrelage
      
      si sansespace(Tempo.tcouleurcarr) <> ""  ou sansespace(tempo.tcouleurcarr2) <> "" alors
      	TigerCarrelage.vpeinture = vrai
      sinon
      	TigerCarrelage.vpeinture = faux
      FIN
      tigercarrelage.VNoForme = tempo.tnoforme
      CAlculCarrelage()
      hajoute(TigerCarrelage)
      si herreurdoublon() alors
      FIN
      
      
     type : 458752
   -
     name : CAlculCarrelage
     procedure_id : 2295940459837924212
     type_code : 14
     code : |1+
      Procédure CAlculCarrelage(BarreDifferente = faux)
      
      i est un entier
      formule est une chaine
      nAEnlever est un entier = 0 
      nAenlevertete est un entier = 0
      sFvtcv est une chaine
      sFvtch est une chaine
      nPositionInvent est un entier
      resultatcondition est un booleen = faux
      clederecherche est une chaine
      
      si pas hlitrecherche(invent,INUM,tempo.TNumCarr) alors
      	retour
      FIN
      
      
      //C    = invent.tccadre
      NBH  = tempo.tcarreauh
      NBL  = tempo.TCarreauv
      H1   =  tempo.thauteur
      L1   = tempo.tlargeur
      //ETH  = invent.tctigehor
      //ETL  = invent.tctigevert
      //lcc = val(tempo.tLargeurcontour) * 25.4
      //HCC = val(tempo.THauteurContour) * 25.4
      //HTE = arrondi(val(tempo.THauteurTete) * 25.4)
      lcc = tempo.tvx
      HCC = tempo.Tvx1
      HTE = tempo.Tvx
      DDV = tempo.tddv
      DDh = tempo.tddh
      vx = tempo.tvx
      vx1 = tempo.tvx1
      DTH = tempo.tdt
      //hlitrecherche(typecarr,tcdescription,invent.itypecarr)
      hlitrecherche(typecarr,tcdescription,tempo.TtypeCalcul)
      
      //c = typecarr.EpaisseurCadre
      etl = typecarr.EpaisseurTigeLargeur
      eth = typecarr.EpaisseurTigeHauteur
      si tempo.TDemiCarrelage alors
      	TigerCarrelage.VTypeDessin = 3
      sinon
      
      	TigerCarrelage.VTypeDessin = typecarr.Typedessin
      FIN
      //tigercarrelage.Vhauteurtete = typecarr.VariableUtil
      tigercarrelage.vhauteurcontour = typecarr.VariableUtil1
      tigercarrelage.vlargeurcontour = typecarr.VariableUtil
      
      //si hlitrecherche(typespac,tnumero,tempo.TtypeSpacer) alors
      //	selon typespac.ttype
      //		cas 1
      //			c= typecarr.EpaisseurCadreAluminium
      //		cas 2
      //			c= typecarr.EpaisseurCadreinex
      //		cas 3
      //			c= typecarr.EpaisseurCadreGlassEdge
      //		cas 4
      //			c= typecarr.EpaisseurCadreSuperSpacer
      //	fin	
      //FIN
      
      
      si  hlitrecherche(IntercalaireCouleurDimensions,IDIntercalaireCouleursnumero,...
      	hconstruitvalcle(IntercalaireCouleurDimensions,IDIntercalaireCouleursnumero,sansespace(tempo.ttypespacer),sansespace(tempo.tespace))) alors
      //fin
      
      
      //si hlitrecherche(IntercalaireCouleurs,IDIntercalaireCouleurs,tempo.TtypeSpacer) alors
