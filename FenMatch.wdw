  -
    name : Bouton2
    identifier : 0x42af1111659eaf58
    internal_properties : 
    properties :
     x : 541
     y : 96
     width : 32
     height : 32
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         clederecherche est une chaine
         si Combo_Match..ValeurAffichée <> "<Nouveau>" alors
         	si ACSO_message("Question","Voulez-vous annuler le match de la ligne "+Combo_Match..ValeurAffichée,"OuiNon") = idyes alors
         		pour tout match avec "match.mNoCommande ='"+ trdetail.fdnocomm +"'et match.MnoLignereference = '" + Combo_Match..ValeurAffichée+"'"
         			clederecherche = hconstruitvalcle(fdetail,fdcle,trdetail.fdnocomm,match.mNoLigne)
         			
         			si hlitrecherche(fdetail,fdcle,clederecherche)
         			   fdetail.fdddh = 0
         			   fdetail.fdddv = 0
         			   fdetail.fdmatchvh = 0
         			   fdetail.fdmatch = 0
         			   hmodifie(fdetail,hNumEnrEnCours)
         			fin
         	
         			hsupprime(Match)
         		FIN
         		//	ListeSupprimeTout(Combo_Match)
         		HExécuteRequête(RequeteMatch,hRequêteDéfaut,trdetail.fdnocomm)
         		ListeAffiche(Combo_Match,taDébut)
         		Combo_Match = 1
         		ExécuteTraitement(Combo_Match,trtSélection)
         	fin
         fin
        type : 18
      -
        type : 161
        enabled : false
