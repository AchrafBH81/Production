      -
        code : |1-
         i est un entier
         pour i = 1 a dimension(TableauLigneSelectionne)
         	TableauLigneSelectionne[i] = faux
         FIN
         tableselectmoins(Table1)
         nbchoix = 0
         fenmatch..plan = 1
         resultat est un entier
         pour tout match avec "match.mNoCommande ='"+ trdetail.fdnocomm +"'et match.MnoLignereference = '" + moimeme..ValeurAffichée+"'"
         	resultat = TableCherche(Tligne,match.mNoLigne) 
         	si resultat <> -1 alors
                tableselectplus(Table1,resultat)
                TableauLigneSelectionne[resultat] = vrai
                nbchoix++
         	fin
         Sélecteurmatch = match.mTypeMatch
         ExécuteTraitement(Sélecteurmatch,trtModification)
         FIN
         
         nbchoix = nbchoix/2
         choixreferenceancien = moimeme..ValeurAffichée
