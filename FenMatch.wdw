 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1+
      TableauLigneSelectionne est un tableau dynamique de 0 booleen
      TableauLigneSelectionne2 est un tableau dynamique de 0 booleen
      nbchoix est un entier
      ChoixReference est un entier
      ChoixReferenceAncien est un entier
      hexecuterequete(RequeteMatch,hRequêteDéfaut,trdetail.fdnocomm)
      nbchoix = 0
      remplir_table()
      si table1..vide alors
      	ACSO_message("Info","Aucun carrelage sur cette commande","Info")
      	ferme(FenMatch)
      FIN
      
   -
     code : |1-
      Combo_Match = 1
      executetraitement(Combo_Match,trtSélection)
      moimeme..plan = 1
     type : 34
   -
     type : 180
     enabled : false
   -
     type : 230
     enabled : false
   -
     type : 11
   -
     type : 12
   -
     type : 17
   -
     type : 13
  procedures :
   -
     name : Remplir_table
     procedure_id : 4804656459916346071
     type_code : 14
     code : |1+
      Procédure Remplir_table()
      
      hlitpremier(trdetail,fdcle)
      tantque pas hendehors(trdetail)
      
      	si trdetail.fdlien <> 0 alors	
      		si trdetail.ftype = 4 alors
      			TableAjouteLigne(Table1,"",trdetail.fdligne,trdetail.fdnumprod,trdetail.fdqte,"",...
      			"","",trdetail.fddesc,trdetail.fdlargeura,...
      			trdetail.fdhauteura,TRDETAIL.fdcarreauv,...
      			"X",trdetail.fdcarreauh,trdetail.fdlien,trdetail.ftype)
      		sinon
      			TableAjouteLigne(Table1,"",trdetail.fdligne,trdetail.fdnumprod,trdetail.fdqte,trdetail.fdcomposant1,...
      			trdetail.fdcomposant2,trdetail.fdcomposant3,trdetail.fddesc,trdetail.fdlargeura,...
      			trdetail.fdhauteura,"",...
      			"","",trdetail.fdlien,trdetail.ftype)
      		fin
      	FIN
      	hlitsuivant(trdetail,fdcle)
      fin
      dimension(tableauLigneSelectionne,tableoccurrence(table1))
     type : 458752
   -
     name : remplir_table2
     procedure_id : 4804678832793845345
     type_code : 14
     code : |1+
      Procédure remplir_table2(ligneselect = 0)
      tablesupprimetout(Table2)
      j est un entier
      I EST UN ENTIER
      resultat est un entier
      pour j = 1 a TableSelectOccurrence(Table1)
      	I = tableselect(table1,j) 
      	tableajouteligne(TABLE2,GRAPH[I],TLIGNE[I],TNUMPROD[I],TQTE[I],TCOMPOSANT1[I],TCOMPOSANT2[I],...
      	TCOMPOSANT3[I],TDESC[I],TLARGEUR[I],THAUTEUR[I],TCARREAUV[I],TX[I],TCARREAUH[I],...
      	TLIEN[I],TTYPE[I])
      
      FIN
      
      dimension(tableauLigneSelectionne2,tableoccurrence(table2))
      tableselectmoins(table2)
      si ligneselect <> "<Nouveau>" alors
      	resultat = tablecherche(tligne2,ligneselect)
      	si resultat <> -1 alors
      		tableselectplus(table2,resultat)
      		tableselectplus(table2,resultat-1)
      		ChoixReference = resultat
      
      	fin	
      	si choixreference <> 0 alors
      		calcul_ddvddh()
      	fin   
      FIN
     type : 458752
   -
     name : calcul_ddvddh
     procedure_id : 4804994229545844294
     type_code : 14
     code : |1+
      Procédure calcul_ddvddh()
      i est un entier
      pour i = 1 a tableoccurrence(Table2)
      //	si ttype2[i] = "4" et i <> choixreference alors
      		si i <> choixreference alors
      			selon Sélecteurmatch
      			cas 1
      	           tDDH[i] = val(thauteur2[ChoixReference]) - val(Thauteur2[i])
      	
      			cas 2
      				tDDv[i] = val(tlargeur2[ChoixReference]) - val(Tlargeur2[i])
      
      		FIN
      	FIN
      
      FIN
      
      tableaffiche(Table2)
     type : 458752
   -
     name : Sauvegarder
     procedure_id : 4805016490056274960
     type_code : 14
     code : |1+
      Procédure Sauvegarder()
      i est un entier
      clederecherche est une chaine
      si ChoixReferenceAncien <> "" alors
      	pour tout match avec "match.mNoCommande ='"+ trdetail.fdnocomm +"'et match.MnoLignereference = '" + ChoixReferenceancien+"'"
      		clederecherche = hconstruitvalcle(fdetail,fdcle,trdetail.fdnocomm,match.mNoLigne)
      		si hlitrecherche(fdetail,fdcle,clederecherche)
      			fdetail.fdddh = 0
      			fdetail.fdddv = 0
      			fdetail.fdmatchvh = 0
      			fdetail.fdmatch = 0
      			hmodifie(fdetail,hNumEnrEnCours)
      		fin
      		hsupprime(Match)
      
      	FIN
      fin
      
      pour i = 1 a tableoccurrence(table2)
      
      	match.mNoCommande = trdetail.fdnocomm
      	match.mNoLigne = table2.tligne2[i]
      	match.MnoLignereference = table2.tligne2[ChoixReference]
      	match.mTypeMatch = Sélecteurmatch
      	hajoute(Match)
      	si herreurdoublon() ALORS
      		 retour
      	FIN
      	clederecherche = hconstruitvalcle(fdetail,fdcle,trdetail.fdnocomm,table2.tligne2[i])
      	si hlitrecherche(fdetail,fdcle,clederecherche) ALORS
      		fdetail.fdDDV = table2.tddv[i]
      		fdetail.fdDDh = table2.tddh[i]
      		fdetail.fdmatchvh = selecteurmatch+1
      		fdetail.fdmatch = table2.tligne2[ChoixReference]
      		hmodifie(fdetail,hnumenrencours)
      	fin	
      FIN
      
      hexecuterequete(requetematch,hRequêteDéfaut,trdetail.fdnocomm)
      listeaffiche(Combo_Match,taDébut)
      ListeSelectPlus(combo_match,ListeCherche(Combo_Match,table2.tligne2[ChoixReference]))
      
     type : 458752
  procedure_templates : []
  property_templates : []
