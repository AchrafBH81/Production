        code : |1+
         i est un entier
         tableselectmoins(Table2)
         pour i = 1 a tableoccurrence(Table2)
         
         	tableauligneselectionne2[i] = faux
         	tddh[i] = 0
         	tddv[i] = 0
         
         fin	
         si ttype2[table2] = "4" alors
         	tableauligneselectionne2[table2] = vrai
         	tableauligneselectionne2[table2-1] = vrai
         sinon
         	si tlien2[table2] = tlien2[table2+1] alors
         		tableauligneselectionne2[table2] = vrai
         		tableauligneselectionne2[table2+1] = vrai
         	sinon
         		tableauligneselectionne2[table2] = faux
         
         	FIN
         fin	
         BtnSuivant..CouleurFond = itransparent
         btnsuivant..Couleur = inoir
         BtnSuivant..libelle = "Calculer"
         pour i = 1 a dimension(tableauligneselectionne2)
         	si tableauligneselectionne2[i] alors
         		tableselectplus(table2,i)
         		choixreference = i
         	sinon
         		tableselectmoins(table2,i)
         
         	FIN
         FIN
         
         
        type : 33
