  -
    name : BtnSuivant
    identifier : 0x42ada0fc6279a259
    internal_properties : 
    properties :
     x : 654
     y : 536
     width : 80
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         
         selon fenmatch..plan
         	cas 1 
         		si NbChoix > 1 alors
         			fenmatch..plan = 2
         			BtnPrécédent..libelle = "<< Précédent"
         			BtnSuivant..CouleurFond = itransparent
         			btnsuivant..Couleur = inoir
         			moimeme..Libellé = "Calculer"
         			remplir_table2(Combo_Match..ValeurAffichée)
         		sinon
         			acso_message("Erreur","Vous devez choisir au moins deux thermos pour le match","Erreur")
         		fin
         
         	cas 2
         		selon moimeme..libelle
         		cas  "Calculer" 
         			si ChoixReference = 0 alors 
         				acso_message("Erreur","Vous devez choisir le thermos qui servira de base de calcul","Erreur")
         			sinon
         				calcul_ddvddh()
         				moimeme..CouleurFond = irougeclair
         				moimeme..Couleur = inoir
         				moimeme..Libellé = "Sauvegarder"
         			fin
         		cas "Sauvegarder"
         			moimeme..CouleurFond = iTransparent
         			moimeme..Couleur = inoir
         			moimeme..Libellé = "Quitter"
         			sauvegarder()
         		cas "Quitter"
         			ferme(FenMatch)
         		fin
         
         FIN
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BtnPrécédent
    identifier : 0x42ada12511ea40ef
    internal_properties : 
    properties :
     x : 557
     y : 536
     width : 80
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         selon fenmatch..plan
             cas 1
             	ferme(FenMatch)
         	cas 2
         		fenmatch..plan = 1
                 moimeme..libelle = "Annuler"
         		BtnSuivant..CouleurFond = itransparent
         		btnsuivant..Couleur = inoir
         		BtnSuivant..libelle = "Suivant >>"
                 si Combo_Match..ValeurAffichée <> "<Nouveau>" alors
                  ExécuteTraitement(Combo_Match,trtSélection)
         	    fin
         	cas 3
         		fenmatch..plan = 2
         		BtnSuivant..CouleurFond = itransparent
         		btnsuivant..Couleur = inoir
         		BtnSuivant..libelle = "Calculer"
         
         fin
        type : 18
      -
        type : 161
        enabled : false
