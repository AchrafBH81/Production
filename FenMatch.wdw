    type : 9
    controls : []
    code_elements :
     type_code : 9
     p_codes :
      -
        code : |1-
         
        type : 14
      -
        type : 35
        enabled : false
      -
        code : |1+
         si Tlien <>  0 alors
         
         	si Tlien = tligne alors
         		graph = "/"
         	sinon
         		graph = "\"
         	fin		
         
         
         FIN
         
        type : 21
      -
        type : 22
        enabled : false
      -
        type : 24
        enabled : false
      -
        type : 23
        enabled : false
      -
        type : 25
        enabled : false
      -
        code : |1+
         i est un entier
         // pour i = 1 a TableSelectOccurrence(Table1)
         //    si ttype[tableselect(table1,i)] = "4" alors
         //	tableselectplus(table1,tableselect(table1,i)-1)
         //    sinon
         //	si tlien[tableselect(table1,i)] = tlien[tableselect(table1,i)+1] alors
         //		tableselectplus(table1,tableselect(table1,i)+1)
         //
         //	FIN
         //    fin	
         //	 
         // fin
         ////FIN
         si hlitrecherche(Match,mNoCommandemNoLigne,...
         	hconstruitvalcle(match,mNoCommandemNoLigne,trdetail.fdnocomm,table1.Tligne[table1])) et ...
         	pas Combo_Match..valeuraffichée = match.MnoLignereference 	ALORS
         
         	tableselectmoins(Table1,table1)
         	NBchoix = 0
         	pour i = 1 a dimension(TableauLigneSelectionne)
         		si TableauLigneSelectionne[i] alors
         			tableselectplus(table1,i)
         			nbchoix++
         		sinon
         			tableselectmoins(table1,i)
         
         		FIN
         	FIN
         
         	nbchoix = nbchoix/2
         	ACSO_message("Erreur","Cette ligne fait partie d'un autre match","Erreur")
         	retour
         
         FIN
         si TableauLigneSelectionne[table1] alors
         	TableauLigneSelectionne[table1] = faux
         	si ttype[table1] = "4" alors
         		TableauLigneSelectionne[table1-1] = faux
         	sinon
         		si tlien[table1] = tlien[table1+1] alors
         			TableauLigneSelectionne[table1+1] = faux
         		sinon
         			TableauLigneSelectionne[table1] = faux
         		FIN
         	fin	
         sinon
         	TableauLigneSelectionne[table1] = vrai
         	si ttype[table1] = "4" alors
         		TableauLigneSelectionne[table1-1] = vrai
         	sinon
         		si tlien[table1] = tlien[table1+1] alors
         			TableauLigneSelectionne[table1+1] = vrai
         		sinon
         			TableauLigneSelectionne[table1] = faux
         
         		FIN
         	fin	
         FIN
         NBchoix = 0
         pour i = 1 a dimension(TableauLigneSelectionne)
         	si TableauLigneSelectionne[i] alors
         		tableselectplus(table1,i)
         		nbchoix++
         	sinon
         		tableselectmoins(table1,i)
         
         	FIN
         FIN
         
         nbchoix = nbchoix/2
        type : 33
