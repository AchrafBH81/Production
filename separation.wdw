  procedures :
   -
     name : ajuste_dimension
     procedure_id : 4511921556248492881
     type_code : 14
     code : |1+
      Procédure ajuste_dimension(dimensionaajuster)
      valeuraretourner est un entier = val(dimensionaajuster)
      
      si position(tempo.tcapgaztube,"C")	 <> 0 alors
      	valeuraretourner = valeuraretourner  - 4
      	valeuraretourner = NumériqueVersChaine(1234.567,"12d")
      	valeuraretourner = sansespace(valeuraretourner)
      sinon
      	valeuraretourner = sansespace(dimensionaajuster)
      FIN
      
      
      renvoyer valeuraretourner
      
     type : 458752
   -
     name : remplirordre
     procedure_id : 4511921557713091419
     type_code : 14
     code : |1+
      Procédure remplirordre()
      j est un entier
      valeuraretourner est une chaine = ""
      memcree("ordrexopt")
      
      si tempo.twordre <> 0 alors
      	memajoute("ordrexopt",tempo.twordre,tempo.tw)
      FIN
      si tempo.tw1ordre <> 0 alors
      	memajoute("ordrexopt",tempo.tw1ordre,tempo.tw1)
      FIN
      si tempo.tw2ordre <> 0 alors
      	memajoute("ordrexopt",tempo.tw2ordre,tempo.tw2)
      FIN
      si tempo.thordre <> 0 alors
      	memajoute("ordrexopt",tempo.thordre,tempo.th)
      FIN
      si tempo.th1ordre <> 0 alors
      	memajoute("ordrexopt",tempo.th1ordre,tempo.th1)
      FIN
      si tempo.th2ordre <> 0 alors
      	memajoute("ordrexopt",tempo.th2ordre,tempo.th2)
      FIN
      si tempo.trordre <> 0 alors
      	memajoute("ordrexopt",tempo.trordre,tempo.tr)
      FIN
      si tempo.tr1ordre <> 0 alors
      	memajoute("ordrexopt",tempo.tr1ordre,tempo.tr1)
      FIN
      si tempo.tr2ordre <> 0 alors
      	memajoute("ordrexopt",tempo.tr2ordre,tempo.tr2)
      FIN
      si tempo.tdordre <> 0 alors
      	memajoute("ordrexopt",tempo.tdordre,tempo.td)
      FIN
      si tempo.tsordre <> 0 alors
      	memajoute("ordrexopt",tempo.tsordre,tempo.ts)
      FIN
      si tempo.tfordre <> 0 alors
      	memajoute("ordrexopt",tempo.tfordre,tempo.tf)
      FIN
      si tempo.tt1ordre <> 0 alors
      	memajoute("ordrexopt",tempo.tt1ordre,tempo.tt1)
      FIN
      si tempo.tt2ordre <> 0 alors
      	memajoute("ordrexopt",tempo.tt2ordre,tempo.tt2)
      FIN
      si tempo.tt3ordre <> 0 alors
      	memajoute("ordrexopt",tempo.tt3ordre,tempo.tt3)
      FIN
      si tempo.tt4ordre <> 0 alors
      	memajoute("ordrexopt",tempo.tt4ordre,tempo.tt4)
      FIN
      
      //Code WinDev 5.5 remplacé par la migration :
      //memtri("ordrexopt")
      MemTrie("ordrexopt")
      pour j = 1 a memoccurrence("ordrexopt")
      	valeuraretourner += gauche(memrecupere("ordrexopt",j),5)
      FIN
      
      
      renvoyer valeuraretourner
      
     type : 458752
   -
     name : remplir_table_separe
     procedure_id : 4511921556503231373
     type_code : 14
     code : |1+
      Procédure remplir_table_separe()
      produitdebase est un  chaine
      special est une chaine  // pout traitement spécial
      ancienspecial est une chaine
      qtebase est un entier
      wqtetotal est un entier = 0
      wqteligne est un entier=0
      wqtelignev1 est un entier = 0
      rang est une chaine
      ancienrang est une chaine
      noprodtrtspec est une chaine
      tablesupprimetout("TABLE_SEPARE")
      
      
      //hlitpremier("tempo","traitement_base")
      hlitpremier(tempo,CleRang)
      
      produitdebase = tempo.tbase
      ancienspecial = tempo.ttraitementspecial
      rang = tempo.Trngtrtspe
      ancienrang = tempo.Trngtrtspe
      noprodtrtspec = tempo.tprodtrtspe
      //Code WinDev 5.5 remplacé par la migration :
      //tantque pas h.endehors 
      tantque pas HEnDehors() 
      	//Code WinDev 5.5 remplacé par la migration :
      	//	tantque tempo.tbase = produitdebase  et tempo.ttraitementspecial=ancienspecial et pas h.endehors
      	tantque tempo.tbase = produitdebase  et tempo.ttraitementspecial=ancienspecial et tempo.Trngtrtspe = ancienrang et pas HEnDehors()
      		si pas tempo.TIntercalaireSeulement alors 		 
      			qtebase++  
      			wqtetotal += (tempo.tqtebase * tempo.tqte)
      			wqteligne += tempo.tqtebase
      			special = tempo.ttraitementspecial
      			rang = tempo.Trngtrtspe
      			si tempo.tqtebase = 1 alors
      				wqtelignev1 += tempo.tqte
      			sinon
      				wqtelignev1 += (tempo.tqte * 2)
      
      			FIN
      		fin
      		hlitsuivant(tempo,CleRang)
      	fin
      
      
      	tableajouteligne(TABLE_SEPARE,produitdebase,qtebase,qtebase,special,wqtetotal,wqteligne,rang,noprodtrtspec,wqtelignev1)
      	produitdebase = tempo.tbase	 
      	ancienspecial = tempo.ttraitementspecial
      	ancienrang = tempo.Trngtrtspe
      	noprodtrtspec = tempo.tprodtrtspe
      	qtebase = 0
      	wqtetotal = 0
      FIN
      
      //Code WinDev 5.5 remplacé par la migration :
      //tableaffiche("TABLE_SEPARE","*")
      tableaffiche("TABLE_SEPARE",taCourantPremier)
      
     type : 458752
   -
     name : xhostinp
     procedure_id : 4511921557341043627
     type_code : 14
     code : |1+
      // préparation du fichier pour l'optimisation
      Procédure xhostinp(NLOT = 0)
      li est un entier
      sli est un entier
      compteur est un entier
      j est un  entier
      ligneaecrire est une chaine
      //fhandle est un entier = fcree(completerep(reppourxopt1)+"xhostinp.asc")
      fhandle est un entier = fcree(completerep(reppourxopt1)+sansespace(NLOT)+".asc")
      //complete(sansespace(NLOT)
      wlargeur est un entier  // variable de travail pour largeur - cap
      whauteur est un entier  // variable de travail pour hauteur - cap
      nombre est un entier = tableoccurrence("TABLE_SEPARE")
      // Test de l'existence du répertoire 
      SI fRep(reppourxopt1, frRépertoire)~="" ALORS
      	frepcree(reppourxopt1)
      FIN
      multitache()
      si fhandle = -1 alors
      	ACSO_message("Erreur","Impossible de créer le fichier pour l'optimisation","Erreur")
      	retour
      FIN
      
      
      pour j = 1 a tableoccurrence("TABLE_SEPARE")
      	multitache(50)
      	execute("fenjauge.progression",j/nombre * 100)
      	ligneaecrire ="H"
      	ligneaecrire+=remplir_zero(numeriqueverschaine(qteinitial[j]),4)+"0001"
      	hlitrecherche("invent","INUM",pbase[j])
      	//Code WinDev 5.5 remplacé par la migration :
      	// si pas h.endehors et h.trouve alors
      	si pas HEnDehors() et HTrouve() alors
      		ligneaecrire+=gauche(invent.idesc,20)
      	sinon
      		ligneaecrire+=repete(" ",20)
      	FIN
      	//	si taille(pbase[j]) > 7 alors
      	//		ligneaecrire+=gauche(pbase[j],8)+gauche(pbase[j],8)
      	//	sinon
      	//		ligneaecrire+=complete(sansespace(pbase[j]),8)+complete(sansespace(pbase[j]),8)
      	//	fin
      	ligneaecrire+=complete(sansespace(pbase[j]),8)+complete(sansespace(NLOT)+"-"+NUMERIQUEVERSCHAINE(j),8)
      	ligneaecrire+="00000000"
      	ligneaecrire+=complete(sansespace(pbase[j]),20)
      	ligneaecrire+=repete(" ",6)
      	ligneaecrire+="060001"
      	ligneaecrire+=repete(" ",5)
      	ligneaecrire+="X"
      
      	FECRITLIGNE(fhandle,ligneaecrire) 
      
      	ligneaecrire = ""	   
      	li=1
      	sli=1
      	compteur = 0
      
      	// hlitrecherche("tempo","tbase",pbase[j])
      	// hlitrecherche("tempo","cletrait_base_esp_comm_ligne",pbase[j])
      	hlitrecherche("tempo","cletrait_base_esp_comm_ligne",...
      	traitement[j]+pbase[j]+repete(" ",8))
      	//Code WinDev 5.5 remplacé par la migration :
      	// tantque pas h.endehors et sansespace(tempo.tbase) = sansespace(pbase[j])
      	tantque pas HEnDehors() et sansespace(tempo.tbase) = sansespace(pbase[j])
      		si tempo.ttraitementspecial = traitement[j] 
      			ligneaecrire += "P"+remplir_zero(numeriqueverschaine(sli),2)                 // 1-3
      			ligneaecrire += remplir_zero(numeriqueverschaine(li),4)                     // 4-7
      			ligneaecrire += remplir_zero(numeriqueverschaine(tempo.tqte),4)             // 8-11
      			ligneaecrire += remplir_zero(numeriqueverschaine(tempo.tqtebase),1)         // 12-12
      			si position(tempo.tcapgaztube,"C") <> 0  alors    
      				wlargeur = val(tempo.tlargeur) - config.Cnbmilcap
      				whauteur = val(tempo.thauteur) - config.Cnbmilcap
      			sinon
      				wlargeur = val(tempo.tlargeur) 
      				whauteur = val(tempo.thauteur) 
      			FIN
      			ligneaecrire += remplir_zero(numeriqueverschaine(wlargeur),5)               // 13-17
      			ligneaecrire += remplir_zero(numeriqueverschaine(whauteur),5)               // 18-22
      			ligneaecrire += "00"															// 23-24
      			ligneaecrire += complete(sansespace(tempo.tespace),4)						// 25-28
      			ligneaecrire += gauche(tempo.tjob,6)           								//29-34
      			ligneaecrire += remplir_zero(numeriqueverschaine(tempo.tlignedecommande),3)	//35-37
      			//	ligneaecrire += complete(sansespace(tempo.tcomposant1),9)
      			//	ligneaecrire += complete(sansespace(tempo.tcomposant2),9)
      			//	ligneaecrire += complete(sansespace(tempo.tcomposant3),9)
      			ligneaecrire += complete(sansespace(tempo.tnomclient),27)					// 38-64
      			//ligneaecrire += gauche(tempo.tproduit,10)
      			//ligneaecrire += GAUCHE(Tempo.tdescription,17)
      
      			//    ligneaecrire += NumériqueVersChaine(tempo.tligne,"3d")
      			ligneaecrire += gauche(tempo.tORDRE,16)										// 65-80
      			//	ligneaecrire += remplir_zero(numeriqueverschaine(tempo.tlignedecommande),3)
      			//	ligneaecrire += "   "
      			//	ligneaecrire += tempo.tclient
      			//	si tempo.tienergiverre alors
      			//		ligneaecrire += "L"
      			//	sinon
      			//		ligneaecrire += " "
      			//    FIN
      			//	si pas position(tempo.tcapgaztube,"Z") = 0 aLORS
      			//    si tempo.targon
      			//		ligneaecrire += "A"
      			//	sinon
      			//		ligneaecrire += " "
      			//    FIN
      			//	si tempo.tsurfaceinterieure alors
      			//		ligneaecrire += "S"
      			//	sinon
      			//		ligneaecrire += " "
      			//    FIN
      
      			//	ligneaecrire += "   "   // c'est ici que je met les flags
      			ligneaecrire += "1"																// 81-81	
      			ligneaecrire += gauche(tempo.tjobligne,16)										// 82-97
      			//	ligneaecrire += remplir_zero(numeriqueverschaine(tempo.tcomm),6)
      			//	si pas sansespace(tempo.tnoforme) = "" alors
      			//	ligneaecrire += "F"
      			//    sinon	
      			//	ligneaecrire += " "
      			///	fin
      			//	ligneaecrire += gauche(tempo.tjob,9)
      			//	ligneaecrire += " "
      			//	ligneaecrire += "0099"
      
      			ligneaecrire += remplir_zero(tempo.tnoforme,4)									// 98-101
      			//	ligneaecrire += repete(" ",32)
      			ligneaecrire += complete(sansespace(gauche(tempo.tnomclient,32)),32," ")			// 102-133
      
      			//	ligneaecrire += "0000"
      			ligneaecrire += "0000"															// 134-137
      			li++
      
      			fecritligne(fhandle,ligneaecrire)
      			ligneaecrire = ""
      			ligneaecrire +="T"                   // 1-1
      			ligneaecrire +=REPETE(" ",42)        // 2-43
      			ligneaecrire+=gauche(tempo.tfini,10) // 44-53
      			si tempo.ttype = 1 alors
      				ligneaecrire+=gauche(tempo.tlargeura,8)   // 54-61
      				ligneaecrire+=gauche(tempo.thauteura,8)   // 62-69
      				ligneaecrire +=REPETE(" ",4)               // 70-73
      			sinon
      				ligneaecrire +=REPETE(" ",20)
      			fin
      
      //			ligneaecrire += gauche(tempo.tcomposant1,6)
      //			ligneaecrire += " "
      //			ligneaecrire += gauche(tempo.tespace,4)
      //			ligneaecrire += " "
      //			ligneaecrire += gauche(tempo.tcomposant2,6)
      //			ligneaecrire += " "
      //			ligneaecrire += gauche(tempo.tespace2,4)
      //			ligneaecrire += " "
      //			ligneaecrire += gauche(tempo.tcomposant3,6)
      
      
      			ligneaecrire += COMPLETE(tempo.tdescription,24," ")+" "    // 74-97 
      			si hlitrecherche(typespac,tnumero,tempo.TtypeSpacer) alors   // 98-102
      				ligneaecrire+=gauche(typespac.tdesccourte,5)
      			sinon
      				ligneaecrire+= repete(" ",5)	
      			fin
      
      			ligneaecrire+=GAUCHE(TEMPO.TNUMCARR,10)  //103-112
      					ligneaecrire+=" "
      			SI TEMPO.tcarreauh <> 0 ALORS
      				ligneaecrire+=gauche(numeriqueverschaine(tempo.tcarreauv),2) //114-115
      				ligneaecrire+="X"                                             // 116-116 
      				ligneaecrire+=gauche(numeriqueverschaine(tempo.tcarreauh),2)  //117-118
      				ligneaecrire+=" "                                               //119-119
      			SINON
      				ligneaecrire += REPETE(" ",6)
      			FIN
      			ligneaecrire+=gauche(tempo.Tnotes,13)
      
      			FECRITLIGNE(fhandle,ligneaecrire)
      
      			ligneaecrire = ""
      
      		fin
      		//    hlitsuivant("tempo","tbase")
      		si pas sansespace(tempo.tnoforme) = "" alors
      			ligneaecrire += "S"+remplir_zero(numeriqueverschaine(tempo.tnombre),2)
      			ligneaecrire += remplirordre()
      			fecritligne(fhandle,ligneaecrire)
      			ligneaecrire = ""
      		FIN
      		hlitsuivant("tempo","cletrait_base_esp_comm_ligne")
      		compteur++
      		si compteur = quantite[j] alors
      			compteur = 0
      			sli++
      		FIN
      	FIN
      	ligneaecrire += "E"
      	fecritligne(fhandle,ligneaecrire)
      	ligneaecrire = ""
      
      fin
      fferme(fhandle)
      
     type : 458752
   -
     name : OPTIMA
     procedure_id : 4572381018018495732
     type_code : 14
     code : |1+
      // préparation du fichier pour l'optimisation
      Procédure OPTIMA(nlot = "200",lfabrication=faux)
      i est un entier
      li est un entier
      sli est un entier
      compteur est un entier
      j est un  entier
      k est un entier
      ligneaecrire est une chaine
      wlargeur est un entier  // variable de travail pour largeur - cap
      whauteur est un entier  // variable de travail pour hauteur - cap
      nombre est un entier = tableoccurrence("TABLE_SEPARE")
      qterésiduelle est un entier
      dimcarr est une chaine  //   pour trouver le nombre de carreau . blanc si 0 X 0
      lnoidentifiant est un entier
      aumoinsuneligne est un entier 
      
      pour j = 1 a tableoccurrence("TABLE_SEPARE")
      	aumoinsuneligne= 0
      	lnoidentifiant = sansespace(numeriqueverschaine(DonneIdentifiant()))
      	fhandle est un entier = fcree(reppourxopt+"\"+nlot+"-"+lnoidentifiant+"-"+TABLE_SEPARE.PBASe[j]+TABLE_SEPARE.tprodtrtspec[j]+".asc")
      	//	fhandle est un entier = fcree(reppourxopt+"\"+nlot+"-"+separation.NUMEROOPT+"-"+lnoidentifiant+"-"+TABLE_SEPARE.PBASe[j]+TABLE_SEPARE.tprodtrtspec[j]+".asc")
      	si fhandle = -1 alors
      		ACSO_message("Erreur","Impossible de créer le fichier pour l'optimisation","Erreur")
      	FIN
      	multitache(50)
      	execute("fenjauge.progression",j/nombre * 100)
      
      
      	ligneaecrire+=complete("Lot numéro "+nlot,32," ")
      	ligneaecrire+=DATEVERSCHAINE(datesys(),"JJMMAAAA")
      	ligneaecrire+=repete(" ",8)
      	ligneaecrire+=numeriqueverschaine(qtetotal[j],"8d")
      	ligneaecrire+="V2"
      
      	FECRITLIGNE(fhandle,ligneaecrire) 
      
      	ligneaecrire = ""	   
      	//	ligneaecrire+=numeriqueverschaine(qteinitial[j],"8d")
      	ligneaecrire+=numeriqueverschaine(qteligne[j],"8d")
      	FECRITLIGNE(fhandle,ligneaecrire)
      
      	ligneaecrire = ""	   
      	li=1
      	sli=1
      	compteur = 1
      
      	// hlitrecherche("tempo","tbase",pbase[j])
      	// hlitrecherche("tempo","cletrait_base_esp_comm_ligne",pbase[j])
      	//	hlitrecherche("tempo","cletrait_base_esp_comm_ligne",...
      	//	traitement[j]+pbase[j]+trang[j]+repete(" ",8))
      	hlitrecherche(tempo,cletrait_base_esp_comm_ligne,...
      	HConstruitValClé(tempo,cletrait_base_esp_comm_ligne,traitement[j],pbase[j],trang[j]))
      
      
      	//Code WinDev 5.5 remplacé par la migration :
      	// tantque pas h.endehors et sansespace(tempo.tbase) = sansespace(pbase[j])
      	tantque pas HEnDehors() et sansespace(tempo.tbase) = sansespace(pbase[j]) ET SANSESPACE(TEMPO.Trngtrtspe) = SANSESPACE(TRANG[j])
      		si pas tempo.Tfabrication = lfabrication alors
      			hlitsuivant("tempo","cletrait_base_esp_comm_ligne")
      			continuer
      		fin
      		si tempo.TIntercalaireSeulement alors
      			si MemRecherche("MemEtiquette",tempo.tnoRecFdetail) ="" alors
      				memajoute("MemEtiquette",tempo.tnoRecFdetail,tempo.tnoRecFdetail)
      			fin
      			hlitsuivant("tempo","cletrait_base_esp_comm_ligne")
      			continuer
      		fin
      		aumoinsuneligne++
      
      		si tempo.ttraitementspecial = traitement[j] 
      
      			//		qterésiduelle = tempo.tqte
      
      			//		pour k = 1 a tempo.tqte pas 2
      
      			ligneaecrire += complete(sansespace(pbase[j]),16)    // 1-16
      			ligneaecrire += numeriqueverschaine(compteur,"5d")    // 17-21
      			ligneaecrire += gauche(tempo.tnomcourt,12)           // 22-33
      			//			ligneaecrire += complete(gauche(sansespace(Tempo.tjobligne)+"/"+sansespace(tempo.tordre),12),12," ")
      			ligneaecrire += complete(numeriqueverschaine(tempo.tcomm),12," ")  // 34-45
      			ligneaecrire += repete(" ",13)  // 46-58
      			ligneaecrire += complete("0.0",3," ")  // 59-61
      			ligneaecrire += numeriqueverschaine(tempo.tqteoriginale,"3d")  // 62-64
      			ligneaecrire += "Y"   // 65
      			//			ligneaecrire += numeriqueverschaine(tempo.tqte * tempo.tqtebase,"8d")  // 66-73
      			ligneaecrire += numeriqueverschaine(tempo.tqte,"8d")  // 66-73
      			ligneaecrire += repete(" ",8)   // 74-81
      
      			si position(tempo.tcapgaztube,"C") <> 0  alors
      				si config.calculcapactif alors
      					wlargeur = val(tempo.tlargeur) - config.Cnbmilcap
      					whauteur = val(tempo.thauteur) - config.Cnbmilcap
      				sinon
      					wlargeur = val(tempo.tlargeur) 
      					whauteur = val(tempo.thauteur) 
      				fin
      			SINON
      				wlargeur = val(tempo.tlargeur) 
      				whauteur = val(tempo.thauteur) 
      			FIN
      			//				ligneaecrire += numeriqueverschaine(wlargeur,"6d")+",0"
      			//				ligneaecrire += numeriqueverschaine(whauteur,"6d")+",0"
      			si sansespace(tempo.tnoforme) <> "" ALORS
      				ligneaecrire += "   11111"
      				ligneaecrire += "   11111"
      
      			sinon
      				ligneaecrire += numeriqueverschaine(wlargeur,"8d")
      				ligneaecrire += numeriqueverschaine(whauteur,"8d")
      
      			FIN   // 82-97
      			//ligneaecrire += "     0,0"
      			ligneaecrire+=complete(sansespace(gauche(tempo.tespace,8)),8) // 98-105
      			//				ligneaecrire += repete(" ",32)
      			//			si pas sansespace(tempo.tnumcarr) = "" alors
      			//				//                	hlitrecherche(typecarr,TCCLEUNIK,tempo.TtypeCalcul)
      			//				dimcarr = sansespace(tempo.tnumcarr)+" "+	sansespace(tempo.tcarreauv)+"X"+...
      			//				sansespace(tempo.tcarreauh)+" "+sansespace(tempo.ttypecalcul)
      			//			sinon
      			//				dimcarr = ""
      			//			FIN
      			//			hlitrecherche(typespac,tnumero,tempo.TtypeSpacer)
      			//			ligneaecrire += complete(sansespace(typespac.tdesccourte)+...
      			//			" "+dimcarr+ " " + tempo.tnotes...
      			//			,32," ")
      
      			ligneaecrire += complete(sansespace(tempo.tlargeura)+...
      			" X "+sansespace(tempo.thauteura)...
      			,32," ")  // 106-137
      
      
      			//			ligneaecrire += numeriqueverschaine(tempo.tqte * tempo.tqtebase,"5d")  // 138-142
      			si tempo.timprimeetiq alors
      				ligneaecrire += numeriqueverschaine(tempo.tqte,"5d")  // 138-142
      			sinon
      				ligneaecrire += "    0"  // 138-142
      			fin
      			//ligneaecrire += numeriqueverschaine(tempo.tqte,"5d")
      			ligneaecrire += "    0"   //143-147
      			ligneaecrire += "    0"   //148-152 
      			ligneaecrire += gauche(tempo.tjob,6)   //153-158
      			//			ligneaecrire+=DATEVERSCHAINE(datesys(),"JJMMAAAA")
      			si DateValide(tempo.tdaterequise)  alors  //159-166
      				ligneaecrire+=DATEVERSCHAINE(tempo.tdaterequise,"JJMMAAAA")
      			fin
      			ligneaecrire+=repete(" ",43) //167-209
      			si hlitrecherche(invent,INUM,tempo.Tnumcarr) alors     // 210-241
      				ligneaecrire+=gauche(invent.IDESC,32)
      			sinon
      				ligneaecrire+=repete(" ",32)
      			fin
      			HLITRECHERCHE(typespac,tnumero,TEMPO.TtypeSpacer)
      			si gauche(typespac.tdescription,4) = ("Inex") alors                // 242-273
      				hlitrecherche(spacer,stypeSnumero,HConstruitValClé(spacer,stypesnumero,"I",tempo.tespace))
      				ligneaecrire+=complete(gauche(sansespace(typespac.tdescription)+" "+sansespace(tempo.tespace)+" "+sansespace(spacer.sdescription),32),32)
      
      
      			sinon
      				hlitrecherche(spacer,stypeSnumero,HConstruitValClé(spacer,stypeSnumero,"A",sansespace(tempo.tespace)))
      				ligneaecrire+=complete(gauche(sansespace(typespac.tdescription)+" "+sansespace(tempo.tespace)+" "+sansespace(spacer.sdescription),32),32)
      			FIN
      			//			ligneaecrire+=repete(" ",32)
      			ligneaecrire+=complete("FINI:"+sansespace(tempo.tfini),32) // 274-305
      			// position 306-336
      			si sansespace(tempo.tnumcarr) <> "" alors   //306-337
      				ligneaecrire+="Carreaux LARGEUR:" + numeriqueverschaine(tempo.tcarreauv,"2d") + " HAUTEUR:" + NumériqueVersChaine(tempo.tcarreauh,"2d")+"  "
      			sinon
      				ligneaecrire+=repete(" ",32)
      			fin
      			//position 338-369
      			ligneaecrire+=complete(tempo.tcouleurcarr,32)
      			//position 370-401
      			ligneaecrire+=complete(tempo.tcouleurcarr2,32)
      			//position 402-433
      			ligneaecrire+=complete(tempo.tnotes,32)
      			//position 434-465
      			ligneaecrire+=complete(tempo.tnote2,32)
      			//position 466-497
      			ligneaecrire += complete(tempo.tjob,32)   
      
      			//position 498-665
      			ligneaecrire+=repete(" ",168)
      			//			ligneaecrire+=gauche(tempo.tnomclient,32)
      			//position 666-697
      			ligneaecrire+=gauche(tempo.tnomLivraison,32)
      
      			//			ligneaecrire+=sansespace(gauche(tempo.tjob,14))+"/"+sansespace(gauche(tempo.tjobligne,14))
      			// position 698-729
      			ligneaecrire+=sansespace(gauche(tempo.tordre,15))+"/"+sansespace(gauche(tempo.tjobligne,15))
      			// position 730-761
      			ligneaecrire+=repete(" ",32-taille(sansespace(gauche(tempo.tordre,14))+"/"+sansespace(gauche(tempo.tjobligne,14))))
      			// position 762-793
      			ligneaecrire+=complete(tempo.tdescription,32)
      			//ligneaecrire += complete(sansespace(numeriqueverschaine(tempo.tqte * tempo.tqtebase,"8d")),32)
      			// position 794-825
      			ligneaecrire += complete(sansespace(numeriqueverschaine(tempo.tqte ,"8d")),32) // pour imprimer la quantité sur étiquette
      			// position 826-857
      			ligneaecrire += complete(sansespace(tempo.tlargeura)+...
      			" X "+sansespace(tempo.thauteura)...
      			,32," ")
      			// position 858-889
      			ligneaecrire+=complete(nlot+"-"+lnoidentifiant+"-"+TABLE_SEPARE.PBASe[j]+".asc",32)
      
      			fecritligne(fhandle,ligneaecrire)
      			pour i = 2 a tempo.tqtebase
      //				si i = 3 alors
      //					compteur++
      //					ligneaecrire[[17 a 21]]= numeriqueverschaine(compteur,"5d")    // 17-21
      //				fin
      				ligneaecrire[[138 a 142]] = "    0"
      				fecritligne(fhandle,ligneaecrire)
      			fin
      			ligneaecrire = ""
      			//				qterésiduelle -= 2
      			compteur++
      			//			FIN
      		FIN
      		hlitsuivant("tempo","cletrait_base_esp_comm_ligne")
      	fin
      	compteur = 0
      	fferme(fhandle)
      	si aumoinsuneligne =0 alors
      		fsupprime(reppourxopt+"\"+nlot+"-"+lnoidentifiant+"-"+TABLE_SEPARE.PBASe[j]+TABLE_SEPARE.tprodtrtspec[j]+".asc")
      	fin
      fin
      
      si pas lfabrication alors
      	iConfigure(imprimanteetiquette)
      	iimprimeetat(EEtiquetteIntercalaire,"MemEtiquette")
      fin
      
     type : 458752
   -
     name : Xopt
     procedure_id : 4654108509969414074
     type_code : 14
     code : |1+
      // préparation du fichier pour l'optimisation
      Procédure Xopt(nlot = "200")
      li est un entier
      sli est un entier
      compteur est un entier
      j est un  entier
      k est un entier
      ligneaecrire est une chaine
      wlargeur est un entier  // variable de travail pour largeur - cap
      whauteur est un entier  // variable de travail pour hauteur - cap
      nombre est un entier = tableoccurrence("TABLE_SEPARE")
      qterésiduelle est un entier
      dimcarr est une chaine  //   pour trouver le nombre de carreau . blanc si 0 X 0
      
      
      pour j = 1 a tableoccurrence("TABLE_SEPARE")
      	fhandle est un entier = fcree(reppourxopt1+"\xhostinp.asc")
      	si fhandle = -1 alors
      		ACSO_message("Erreur","Impossible de créer le fichier pour l'optimisation","Erreur")
      	FIN
      	multitache(50)
      	execute("fenjauge.progression",j/nombre * 100)
      
      
      	ligneaecrire+=complete("Lot numéro "+nlot,32," ")
      	ligneaecrire+=DATEVERSCHAINE(datesys(),"JJMMAAAA")
      	ligneaecrire+=repete(" ",8)
      	ligneaecrire+=numeriqueverschaine(qtetotal[j],"8d")
      	ligneaecrire+="V3"
      
      	FECRITLIGNE(fhandle,ligneaecrire) 
      
      	ligneaecrire = ""	   
      	ligneaecrire+=numeriqueverschaine(qteinitial[j],"8d")
      	FECRITLIGNE(fhandle,ligneaecrire)
      
      	ligneaecrire = ""	   
      	li=1
      	sli=1
      	compteur = 1
      
      	// hlitrecherche("tempo","tbase",pbase[j])
      	// hlitrecherche("tempo","cletrait_base_esp_comm_ligne",pbase[j])
      	hlitrecherche("tempo","cletrait_base_esp_comm_ligne",...
      	traitement[j]+pbase[j]+repete(" ",8))
      	//Code WinDev 5.5 remplacé par la migration :
      	// tantque pas h.endehors et sansespace(tempo.tbase) = sansespace(pbase[j])
      	tantque pas HEnDehors() et sansespace(tempo.tbase) = sansespace(pbase[j])
      		si tempo.ttraitementspecial = traitement[j] 
      	//		qterésiduelle = tempo.tqte
      
      	//		pour k = 1 a tempo.tqte pas 2
      
      				ligneaecrire += complete(sansespace(pbase[j]),16)
      				ligneaecrire += numeriqueverschaine(compteur,"5d")
      				ligneaecrire += gauche(tempo.tnomcourt,12)
      				ligneaecrire += complete(gauche(sansespace(Tempo.tjobligne)+"/"+sansespace(tempo.tordre),12),12," ")
      				ligneaecrire += repete(" ",8)
      				ligneaecrire += complete("0,0",8," ")
      				ligneaecrire += numeriqueverschaine(tempo.tqteoriginale,"3d")
      				ligneaecrire += "Y"
      				ligneaecrire += numeriqueverschaine(tempo.tqte * tempo.tqtebase,"8d")
      				ligneaecrire += repete(" ",8)
      
      				si position(tempo.tcapgaztube,"C") <> 0  alors
      					si config.calculcapactif alors
      						wlargeur = val(tempo.tlargeur) - config.Cnbmilcap
      						whauteur = val(tempo.thauteur) - config.Cnbmilcap
      					sinon
      						wlargeur = val(tempo.tlargeur) 
      						whauteur = val(tempo.thauteur) 
      					fin
      				SINON
      					wlargeur = val(tempo.tlargeur) 
      					whauteur = val(tempo.thauteur) 
      				FIN
      				ligneaecrire += numeriqueverschaine(wlargeur,"6d")+",0"
      				ligneaecrire += numeriqueverschaine(whauteur,"6d")+",0"
      				ligneaecrire += "     0,0"
      //				ligneaecrire += repete(" ",32)
                      si pas sansespace(tempo.tnumcarr) = "" alors
      //                	hlitrecherche(typecarr,TCCLEUNIK,tempo.TtypeCalcul)
                          dimcarr = sansespace(tempo.tnumcarr)+" "+	sansespace(tempo.tcarreauv)+"X"+...
                          sansespace(tempo.tcarreauh)+" "+sansespace(tempo.ttypecalcul)
                      sinon
                      dimcarr = ""
                      FIN
                      hlitrecherche(typespac,tnumero,tempo.TtypeSpacer)
      				ligneaecrire += complete(sansespace(typespac.tdesccourte)+...
      				" "+dimcarr+ " " + tempo.tnotes...
        			,32," ")
      				
      							
      				ligneaecrire += numeriqueverschaine(tempo.tqte,"5d")
      				ligneaecrire += "    0"
      				ligneaecrire += "    0"
      				ligneaecrire += gauche(tempo.tjob,6)
      				ligneaecrire+=DATEVERSCHAINE(datesys(),"JJMMAAAA")
      
      				fecritligne(fhandle,ligneaecrire)
      				ligneaecrire = ""
      
      //				qterésiduelle -= 2
      				compteur++
      //			FIN
      		FIN
      
      
      		hlitsuivant("tempo","cletrait_base_esp_comm_ligne")
      	fin
      	compteur = 0
      	fferme(fhandle)
      
      fin
      
      
      
     type : 458752
   -
     name : convert_anglais1
     procedure_id : 4655454128655571390
     type_code : 14
     code : |1+
      Procédure convert_anglais1(variable)
      //variable est une chaine = moimeme
      hlitpremier("config","COCLEUNIK")
      longueur est un entier = taille(variable)
      position_espace est un entier = position(variable," ")
      //position_espace1 est un entier = position(variable," ",position_espace+1)
      resultat_gauche est une chaine  
      resultat_droit est une chaine        
      valeuraretourner est un reel
      
      si position_espace = 0 alors
      	si position(variable,"/") = 0 alors
      		resultat_gauche = ""
      	sinon
      		resultat_gauche = "0"
      	fin	
      sinon	
      
      	resultat_gauche = gauche(variable,position_espace-1)
      
      FIN
      
      si position_espace = 0 alors
      
      	resultat_droit = variable
      
      sinon	
      
      	resultat_droit = milieu(variable,position_espace +1, longueur - position_espace)
      
      FIN
      
      
      si pas position(resultat_droit,"/") = 0 alors
      	resultat_droit = memrecherche("tableau_metrique",resultat_droit)
      FIN
      
      
      
      
      
      	valeuraretourner = resultat_gauche+resultat_droit
      
      
      
      
      
      
      renvoyer valeuraretourner
      
     type : 458752
   -
     name : xhostinpprod
     procedure_id : 4675958492261543053
     type_code : 14
     code : |1+
      // préparation du fichier pour l'optimisation
      Procédure xhostinpprod(NLOT = 0)
      clederecherche est une chaine
      qtetotale est un entier
      li est un entier
      sli est un entier
      compteur est un entier
      j est un  entier
      ligneaecrire est une chaine
      //fhandle est un entier = fcree(completerep(reppourxopt1)+"xhostinp.asc")
      fhandle est un entier = fcree(completerep(reppourxopt1)+"P-"+sansespace(NLOT)+".asc")
      //complete(sansespace(NLOT)
      wlargeur est un entier  // variable de travail pour largeur - cap
      whauteur est un entier  // variable de travail pour hauteur - cap
      nombre est un entier = tableoccurrence("TABLE_SEPARE")
      // Test de l'existence du répertoire 
      SI fRep(reppourxopt1, frRépertoire)~="" ALORS
      	frepcree(reppourxopt1)
      FIN
      multitache()
      si fhandle = -1 alors
      	ACSO_message("Erreur","Impossible de créer le fichier pour l'optimisation","Erreur")
      FIN
      
      
      //pour j = 1 a tableoccurrence("TABLE_SEPARE")
      multitache(50)
      execute("fenjauge.progression",j/nombre * 100)
      ligneaecrire ="H"
      //	ligneaecrire+=remplir_zero(numeriqueverschaine(qteinitial[j]),4)+"0001"    //2-9
      ligneaecrire+="0001"+"0001"    //2-9
      //	hlitrecherche("invent","INUM",pbase[j])
      //Code WinDev 5.5 remplacé par la migration :
      // si pas h.endehors et h.trouve alors
      //	si pas HEnDehors() et HTrouve() alors
      //		ligneaecrire+=gauche(invent.idesc,20)   //10-29
      //	sinon
      ligneaecrire+=repete(" ",20)   //10-29
      //	FIN
      //	si taille(pbase[j]) > 7 alors
      //		ligneaecrire+=gauche(pbase[j],8)+gauche(pbase[j],8)
      //	sinon
      //		ligneaecrire+=complete(sansespace(pbase[j]),8)+complete(sansespace(pbase[j]),8)
      //	fin
      ligneaecrire+="        "+complete(sansespace(NLOT),8)  // 30-45
      ligneaecrire+="00000000"                                //46-53
      ligneaecrire+=repete(" ",20)       ///54-73 
      ligneaecrire+=repete(" ",5)                            //74-78
      ligneaecrire+="P"                                   //79-79
      ligneaecrire+="060001"                                 //80-85
      ligneaecrire+=repete(" ",5)                            //86-90
      ligneaecrire+="X"                                     //91-91
      
      FECRITLIGNE(fhandle,ligneaecrire) 
      
      ligneaecrire = ""	   
      li=1
      sli=1
      compteur = 0
      hexecuterequete(RequeteTempo)
      //hlitpremier(RequeteTempo)
      //tantque pas hendehors(RequeteTempo)
      //	clederecherche = HConstruitValClé(tempo,clecommandeligne,requetetempo.tcomm,RequeteTempo.tlignedecommande)
      //	hlitrecherche(tempo,clecommandeligne,clederecherche)
      //	info(hnumenr(tempo))
      //	hlitsuivant(RequeteTempo)
      //FIN
      // hlitrecherche("tempo","tbase",pbase[j])
      // hlitrecherche("tempo","cletrait_base_esp_comm_ligne",pbase[j])
      //hlitpremier(tempo,base_comm)
      //hlitpremier(tempo,Ordre_comm_ligne)
      
      //Code WinDev 5.5 remplacé par la migration :
      // tantque pas h.endehors et sansespace(tempo.tbase) = sansespace(pbase[j])
      //RequeteTempo.tcomm = 1234
      //requetetempo.tlignedecommande = 1
      //requetetempo.Tnumligne = 1
      //requetetempo.TordreXopt = 999
      //hajoute(RequeteTempo)
      hlitpremier(RequeteTempo)
      tantque pas hendehors(RequeteTempo)
      	//	tantque pas HEnDehors(tempo)
      	clederecherche = HConstruitValClé(tempo,clecommandeligne,requetetempo.tcomm,requetetempo.tlignedecommande,RequeteTempo.tnumligne)
      
      	si	hlitrecherche(tempo,tcommTnumligne,clederecherche,hIdentique)
      
      		//	si tempo.tproduitdebase <> 0 alors
      		ligneaecrire += "P"+remplir_zero(numeriqueverschaine(sli),2)                 // 1-3
      		ligneaecrire += remplir_zero(numeriqueverschaine(li),4)                     // 4-7
      		ligneaecrire += remplir_zero(numeriqueverschaine(tempo.tqte),4)             // 8-11
      		//			ligneaecrire += remplir_zero(numeriqueverschaine(tempo.tqtebase),1)         // 12-12
      		ligneaecrire += remplir_zero("1")         // 12-12
      		si position(tempo.tcapgaztube,"C") <> 0  alors    
      			wlargeur = val(tempo.tlargeur) - config.Cnbmilcap
      			whauteur = val(tempo.thauteur) - config.Cnbmilcap
      		sinon
      			wlargeur = val(tempo.tlargeur) 
      			whauteur = val(tempo.thauteur) 
      		FIN
      		ligneaecrire += remplir_zero(numeriqueverschaine(wlargeur),5)               // 13-17
      		ligneaecrire += remplir_zero(numeriqueverschaine(whauteur),5)               // 18-22
      		ligneaecrire += "00"															// 23-24
      		ligneaecrire += complete(sansespace(tempo.tespace),4)						// 25-28
      		ligneaecrire += gauche(tempo.tjob,6)           								//29-34
      		ligneaecrire += remplir_zero(numeriqueverschaine(tempo.tlignedecommande),3)	//35-37
      		//	ligneaecrire += complete(sansespace(tempo.tcomposant1),9)
      		//	ligneaecrire += complete(sansespace(tempo.tcomposant2),9)
      		//	ligneaecrire += complete(sansespace(tempo.tcomposant3),9)
      		ligneaecrire += complete(sansespace(tempo.tnomclient),27)					// 38-64
      		//ligneaecrire += gauche(tempo.tproduit,10)
      		//ligneaecrire += GAUCHE(Tempo.tdescription,17)
      
      		//    ligneaecrire += NumériqueVersChaine(tempo.tligne,"3d")
      		ligneaecrire += gauche(tempo.tORDRE,16)										// 65-80
      		//	ligneaecrire += remplir_zero(numeriqueverschaine(tempo.tlignedecommande),3)
      		//	ligneaecrire += "   "
      		//	ligneaecrire += tempo.tclient
      		//	si tempo.tienergiverre alors
      		//		ligneaecrire += "L"
      		//	sinon
      		//		ligneaecrire += " "
      		//    FIN
      		//	si pas position(tempo.tcapgaztube,"Z") = 0 aLORS
      		//    si tempo.targon
      		//		ligneaecrire += "A"
      		//	sinon
      		//		ligneaecrire += " "
      		//    FIN
      		//	si tempo.tsurfaceinterieure alors
      		//		ligneaecrire += "S"
      		//	sinon
      		//		ligneaecrire += " "
      		//    FIN
      
      		//	ligneaecrire += "   "   // c'est ici que je met les flags
      		ligneaecrire += "1"																// 81-81	
      		ligneaecrire += gauche(tempo.tjobligne,16)										// 82-97
      		//	ligneaecrire += remplir_zero(numeriqueverschaine(tempo.tcomm),6)
      		//	si pas sansespace(tempo.tnoforme) = "" alors
      		//	ligneaecrire += "F"
      		//    sinon	
      		//	ligneaecrire += " "
      		///	fin
      		//	ligneaecrire += gauche(tempo.tjob,9)
      		//	ligneaecrire += " "
      		//	ligneaecrire += "0099"
      
      		ligneaecrire += remplir_zero(tempo.tnoforme,4)									// 98-101
      		//	ligneaecrire += repete(" ",32)
      		ligneaecrire += complete(sansespace(gauche(tempo.tnomclient,32)),32," ")			// 102-133
      
      		//	ligneaecrire += "0000"
      		ligneaecrire += "0000"															// 134-137
      		li++
      
      		fecritligne(fhandle,ligneaecrire)
      		ligneaecrire = ""
      		ligneaecrire +="T"                   // 1-1
      		//			LIGNEAECRIRE +=REPETE(" ",42)        // 2-43
      		si sansespace(tempo.tcomposant1) <> "" alors
      			ligneaecrire+=complete(sansespace(tempo.tcomposant1),8)+"0     "
      		sinon
      			ligneaecrire+=complete(sansespace(tempo.tcomposant1),8)+"      "
      		fin
      		si sansespace(tempo.tcomposant2) <> "" alors
      			ligneaecrire+=complete(sansespace(tempo.tcomposant2),8)+"0     "
      		sinon
      			ligneaecrire+=complete(sansespace(tempo.tcomposant2),8)+"      "
      		fin
      		si sansespace(tempo.tcomposant3) <> "" alors
      			ligneaecrire+=complete(sansespace(tempo.tcomposant3),8)+"0     "
      		sinon
      			ligneaecrire+=complete(sansespace(tempo.tcomposant3),8)+"      "
      		fin
      
      
      		ligneaecrire+=gauche(tempo.tfini,8) // 44-51
      		si tempo.ttype = 1 alors
      			ligneaecrire+=gauche(tempo.tlargeura,8)   // 52-59
      			ligneaecrire+=gauche(tempo.thauteura,8)   // 60-67
      			//		LIGNEAECRIRE +=REPETE(" ",4)               // 68-73
      		sinon
      			ligneaecrire +=REPETE(" ",16)
      		fin
      		si hlitrecherche(typespac,tnumero,tempo.TtypeSpacer) alors   // 68-73
      		ligneaecrire+=gauche(typespac.tdesccourte,6)
      	sinon
      		ligneaecrire+= repete(" ",6)	
      
      	fin
      
      	//			ligneaecrire += gauche(tempo.tcomposant1,6)
      	//			ligneaecrire += " "
      	//			ligneaecrire += gauche(tempo.tespace,4)
      	//			ligneaecrire += " "
      	//			ligneaecrire += gauche(tempo.tcomposant2,6)
      	//			ligneaecrire += " "
      	//			ligneaecrire += gauche(tempo.tespace2,4)
      	//			ligneaecrire += " "
      	//			ligneaecrire += gauche(tempo.tcomposant3,6)
      
      
      	ligneaecrire += COMPLETE(tempo.tdescription,30," ")    // 74-103 
      
      
      	ligneaecrire+=GAUCHE(TEMPO.TNUMCARR,10)  //104-113
      	//ligneaecrire+=" "                         //113/113
      	SI TEMPO.tcarreauh <> 0 ALORS
      		ligneaecrire+=complete(gauche(numeriqueverschaine(tempo.tcarreauv),2),2) //114-115
      		ligneaecrire+="X"                                             // 116-116 
      		ligneaecrire+=complete(gauche(numeriqueverschaine(tempo.tcarreauh),2),2)  //117-118
      		ligneaecrire+=" "                                               //119-119
      	SINON
      		ligneaecrire += REPETE(" ",6)
      	FIN
      	//	ligneaecrire+=gauche(tempo.Tnotes,14)     // 120-132
      	ligneaecrire+=gauche(tempo.Tnotes,20)     // 120-138   30-10-2008 avec Maurice
      	//	ligneaecrire+=tempo.Tnote2     // 133-152  ARTXT4
      	ligneaecrire+=gauche(tempo.Tnote2,20)     // 139-158  ARTXT4    30-10-2008 avec Maurice
      	//	ligneaecrire+=repete(" ",63)                 //133-195
      	si position(tempo.tcapgaztube,"C") <> 0  alors    
      		//		ligneaecrire+="CAP"                     // 153-155 artxt5
      		ligneaecrire+="CAP"                     // 159-161 artxt5  30-10-2008 avec Maurice
      	sinon
      		ligneaecrire+=repete(" ",3)
      
      	fin
      	//ligneaecrire+=repete(" ",23)                 //173-195
      	//ligneaecrire+=repete(" ",37)                 //156-192
      	ligneaecrire+=repete(" ",31)                 //162-192  30-10-2008 avec Maurice
      	ligneaecrire+= sansespace(numeriqueverschaine(tempo.tnumeroprep)) // 193-200
      	FECRITLIGNE(fhandle,ligneaecrire)
      
      	ligneaecrire = ""
      
      	//    hlitsuivant("tempo","tbase")
      	si pas sansespace(tempo.tnoforme) = "" alors
      		ligneaecrire += "S"+remplir_zero(numeriqueverschaine(tempo.tnombre),2)
      		ligneaecrire += remplirordre()
      		fecritligne(fhandle,ligneaecrire)
      		ligneaecrire = ""
      	FIN
      	//hlitsuivant(tempo,base_comm)
      	//hlitsuivant(tempo,base_comm)
      sinon
      	info("pas trouve")
      fin
      //hlitsuivant(tempo,Ordre_comm_ligne)
      hlitsuivant(RequeteTempo)
      compteur++
      FIN
      ligneaecrire += "E"
      fecritligne(fhandle,ligneaecrire)
      ligneaecrire = ""
      
      //fin
      fferme(fhandle)
      
     type : 458752
   -
     name : OPTIMATest
     procedure_id : 5342782966962375967
     type_code : 14
     code : |1+
      // préparation du fichier pour l'optimisation
      Procédure OPTIMATest(nlot = "200",lfabrication=faux)
      i est un entier
      z est un entier
      li est un entier
      sli est un entier
      compteur est un entier
      j est un  entier
      k est un entier
      ligneaecrire est une chaine
      wlargeur est un entier  // variable de travail pour largeur - cap
      whauteur est un entier  // variable de travail pour hauteur - cap
      nombre est un entier = tableoccurrence("TABLE_SEPARE")
      qterésiduelle est un entier
      dimcarr est une chaine  //   pour trouver le nombre de carreau . blanc si 0 X 0
      lnoidentifiant est un entier
      aumoinsuneligne est un entier 
      
      pour j = 1 a tableoccurrence("TABLE_SEPARE")
      	aumoinsuneligne= 0
      	lnoidentifiant = sansespace(numeriqueverschaine(DonneIdentifiant()))
      	fhandle est un entier = fcree(reppourxopt+"\"+nlot+"-"+lnoidentifiant+"-"+TABLE_SEPARE.PBASe[j]+TABLE_SEPARE.tprodtrtspec[j]+".asc")
      	//	fhandle est un entier = fcree(reppourxopt+"\"+nlot+"-"+separation.NUMEROOPT+"-"+lnoidentifiant+"-"+TABLE_SEPARE.PBASe[j]+TABLE_SEPARE.tprodtrtspec[j]+".asc")
      	si fhandle = -1 alors
      		ACSO_message("Erreur","Impossible de créer le fichier pour l'optimisation","Erreur")
      	FIN
      	multitache(50)
      	execute("fenjauge.progression",j/nombre * 100)
      
      
      	ligneaecrire+=complete("Lot numéro "+nlot,32," ")
      	ligneaecrire+=DATEVERSCHAINE(datesys(),"JJMMAAAA")
      	ligneaecrire+=repete(" ",8)
      	ligneaecrire+=numeriqueverschaine(qtetotal[j],"8d")
      	ligneaecrire+="V2"
      
      	FECRITLIGNE(fhandle,ligneaecrire) 
      
      	ligneaecrire = ""	   
      	//	ligneaecrire+=numeriqueverschaine(qteinitial[j],"8d")
      	ligneaecrire+=numeriqueverschaine(QteLigneV1[j],"8d")
      	FECRITLIGNE(fhandle,ligneaecrire)
      
      	ligneaecrire = ""	   
      	li=1
      	sli=1
      	compteur = 0
      
      	// hlitrecherche("tempo","tbase",pbase[j])
      	// hlitrecherche("tempo","cletrait_base_esp_comm_ligne",pbase[j])
      	//	hlitrecherche("tempo","cletrait_base_esp_comm_ligne",...
      	//	traitement[j]+pbase[j]+trang[j]+repete(" ",8))
      	hlitrecherche(tempo,cletrait_base_esp_comm_ligne,...
      	HConstruitValClé(tempo,cletrait_base_esp_comm_ligne,traitement[j],pbase[j],trang[j]))
      
      
      	//Code WinDev 5.5 remplacé par la migration :
      	// tantque pas h.endehors et sansespace(tempo.tbase) = sansespace(pbase[j])
      	tantque pas HEnDehors() et sansespace(tempo.tbase) = sansespace(pbase[j]) ET SANSESPACE(TEMPO.Trngtrtspe) = SANSESPACE(TRANG[j])
      		si pas tempo.Tfabrication = lfabrication alors
      			hlitsuivant("tempo","cletrait_base_esp_comm_ligne")
      			continuer
      		fin
      		si tempo.TIntercalaireSeulement alors
      			si MemRecherche("MemEtiquette",tempo.tnoRecFdetail) ="" alors
      				memajoute("MemEtiquette",tempo.tnoRecFdetail,tempo.tnoRecFdetail)
      			fin
      			hlitsuivant("tempo","cletrait_base_esp_comm_ligne")
      			continuer
      		fin
      		aumoinsuneligne++
      
      		si tempo.ttraitementspecial = traitement[j] 
      
      			//		qterésiduelle = tempo.tqte
      
      			//		pour k = 1 a tempo.tqte pas 2
      
      			ligneaecrire += complete(sansespace(pbase[j]),16)    // 1-16
      			ligneaecrire += numeriqueverschaine(compteur,"5d")    // 17-21
      			ligneaecrire += gauche(tempo.tnomcourt,12)           // 22-33
      			//			ligneaecrire += complete(gauche(sansespace(Tempo.tjobligne)+"/"+sansespace(tempo.tordre),12),12," ")
      			ligneaecrire += complete(numeriqueverschaine(tempo.tcomm),12," ")  // 34-45
      			ligneaecrire += repete(" ",13)  // 46-58
      			ligneaecrire += complete("0.0",3," ")  // 59-61
      			ligneaecrire += numeriqueverschaine(tempo.tqteoriginale,"3d")  // 62-64
      			ligneaecrire += "Y"   // 65
      			//			ligneaecrire += numeriqueverschaine(tempo.tqte * tempo.tqtebase,"8d")  // 66-73
      			ligneaecrire += numeriqueverschaine(1,"8d")  // 66-73
      			ligneaecrire += repete(" ",8)   // 74-81
      
      			si position(tempo.tcapgaztube,"C") <> 0  alors
      				si config.calculcapactif alors
      					wlargeur = val(tempo.tlargeur) - config.Cnbmilcap
      					whauteur = val(tempo.thauteur) - config.Cnbmilcap
      				sinon
      					wlargeur = val(tempo.tlargeur) 
      					whauteur = val(tempo.thauteur) 
      				fin
      			SINON
      				wlargeur = val(tempo.tlargeur) 
      				whauteur = val(tempo.thauteur) 
      			FIN
      			//				ligneaecrire += numeriqueverschaine(wlargeur,"6d")+",0"
      			//				ligneaecrire += numeriqueverschaine(whauteur,"6d")+",0"
      			si sansespace(tempo.tnoforme) <> "" ALORS
      				ligneaecrire += "   11111"
      				ligneaecrire += "   11111"
      
      			sinon
      				ligneaecrire += numeriqueverschaine(wlargeur,"8d")
      				ligneaecrire += numeriqueverschaine(whauteur,"8d")
      
      			FIN   // 82-97
      			//ligneaecrire += "     0,0"
      			ligneaecrire+=complete(sansespace(gauche(tempo.tespace,8)),8) // 98-105
      			//				ligneaecrire += repete(" ",32)
      			//			si pas sansespace(tempo.tnumcarr) = "" alors
      			//				//                	hlitrecherche(typecarr,TCCLEUNIK,tempo.TtypeCalcul)
      			//				dimcarr = sansespace(tempo.tnumcarr)+" "+	sansespace(tempo.tcarreauv)+"X"+...
      			//				sansespace(tempo.tcarreauh)+" "+sansespace(tempo.ttypecalcul)
      			//			sinon
      			//				dimcarr = ""
      			//			FIN
      			//			hlitrecherche(typespac,tnumero,tempo.TtypeSpacer)
      			//			ligneaecrire += complete(sansespace(typespac.tdesccourte)+...
      			//			" "+dimcarr+ " " + tempo.tnotes...
      			//			,32," ")
      
      			ligneaecrire += complete(sansespace(tempo.tlargeura)+...
      			" X "+sansespace(tempo.thauteura)...
      			,32," ")  // 106-137
      
      
      			//			ligneaecrire += numeriqueverschaine(tempo.tqte * tempo.tqtebase,"5d")  // 138-142
      			si tempo.timprimeetiq alors
      				ligneaecrire += numeriqueverschaine(tempo.tqte,"5d")  // 138-142
      			sinon
      				ligneaecrire += "    0"  // 138-142
      			fin
      			//ligneaecrire += numeriqueverschaine(tempo.tqte,"5d")
      			ligneaecrire += "    0"
      			ligneaecrire += "    0"
      			ligneaecrire += gauche(tempo.tjob,6)
      			//			ligneaecrire+=DATEVERSCHAINE(datesys(),"JJMMAAAA")
      			si DateValide(tempo.tdaterequise)  alors
      				ligneaecrire+=DATEVERSCHAINE(tempo.tdaterequise,"JJMMAAAA")
      			fin
      			ligneaecrire+=repete(" ",43)
      			si hlitrecherche(invent,INUM,tempo.Tnumcarr) alors
      				ligneaecrire+=gauche(invent.IDESC,32)
      			sinon
      				ligneaecrire+=repete(" ",32)
      			fin
      			HLITRECHERCHE(typespac,tnumero,TEMPO.TtypeSpacer)
      			si gauche(typespac.tdescription,4) = ("Inex") alors
      				hlitrecherche(spacer,stypeSnumero,HConstruitValClé(spacer,stypesnumero,"I",tempo.tespace))
      				ligneaecrire+=complete(gauche(sansespace(typespac.tdescription)+" "+sansespace(tempo.tespace)+" "+sansespace(spacer.sdescription),32),32)
      
      
      			sinon
      				hlitrecherche(spacer,stypeSnumero,HConstruitValClé(spacer,stypeSnumero,"A",sansespace(tempo.tespace)))
      				ligneaecrire+=complete(gauche(sansespace(typespac.tdescription)+" "+sansespace(tempo.tespace)+" "+sansespace(spacer.sdescription),32),32)
      			FIN
      			//			ligneaecrire+=repete(" ",32)
      			ligneaecrire+=complete("FINI:"+sansespace(tempo.tfini),32)
      			// position 306-336
      			si sansespace(tempo.tnumcarr) <> "" alors
      				ligneaecrire+="Carreaux LARGEUR:" + numeriqueverschaine(tempo.tcarreauv,"2d") + " HAUTEUR:" + NumériqueVersChaine(tempo.tcarreauh,"2d")+" "
      			sinon
      				ligneaecrire+=repete(" ",31)
      			fin
      			//position 337-368
      			ligneaecrire+=complete(tempo.tcouleurcarr,32)
      			//position 369-400
      			ligneaecrire+=complete(tempo.tcouleurcarr2,32)
      			//position 401-432
      			ligneaecrire+=complete(tempo.tnotes,32)
      			//position 433-464
      			ligneaecrire+=complete(tempo.tnote2,32)
      
      			ligneaecrire+=repete(" ",201)
      			//			ligneaecrire+=gauche(tempo.tnomclient,32)
      			ligneaecrire+=gauche(tempo.tnomLivraison,32)
      
      			//			ligneaecrire+=sansespace(gauche(tempo.tjob,14))+"/"+sansespace(gauche(tempo.tjobligne,14))
      			ligneaecrire+=sansespace(gauche(tempo.tordre,14))+"/"+sansespace(gauche(tempo.tjobligne,14))
      			ligneaecrire+=repete(" ",32-taille(sansespace(gauche(tempo.tordre,14))+"/"+sansespace(gauche(tempo.tjobligne,14))))
      			ligneaecrire+=complete(tempo.tdescription,32)
      			//ligneaecrire += complete(sansespace(numeriqueverschaine(tempo.tqte * tempo.tqtebase,"8d")),32)
      			ligneaecrire += complete(sansespace(numeriqueverschaine(tempo.tqte ,"8d")),32) // pour imprimer la quantité sur étiquette
      			ligneaecrire += complete(sansespace(tempo.tlargeura)+...
      			" X "+sansespace(tempo.thauteura)...
      			,32," ")
      			ligneaecrire+=complete(nlot+"-"+lnoidentifiant+"-"+TABLE_SEPARE.PBASe[j]+".asc",32)
      
      			//			fecritligne(fhandle,ligneaecrire)
      			pour z = 1 a tempo.tqte
      				pour i = 1 a tempo.tqtebase 
      					compteur++
      					si i = 2 alors
      						//						compteur++
      						si tempo.tqtebase = 3 alors
      							ligneaecrire[[66 a 73]] = numeriqueverschaine(2,"8d")  // 66-73
      							i = 3
      						FIN
      					sinon
      						ligneaecrire[[66 a 73]] = numeriqueverschaine(1,"8d")  // 66-73
      					fin
      					ligneaecrire[[17 a 21]]= numeriqueverschaine(compteur,"5d")    // 17-21
      					ligneaecrire[[153 a 158]]= numeriqueverschaine(compteur,"6d")    // 17-21
      					si z = 1 et i = 1  alors
      					sinon	
      						ligneaecrire[[138 a 142]] = "    0"
      					FIN
      					fecritligne(fhandle,ligneaecrire)
      				fin
      			fin
      			ligneaecrire = ""
      			//				qterésiduelle -= 2
      			//compteur++
      			//			FIN
      		FIN
      		hlitsuivant("tempo","cletrait_base_esp_comm_ligne")
      	fin
      	compteur = 0
      	fferme(fhandle)
      	si aumoinsuneligne =0 alors
      		fsupprime(reppourxopt+"\"+nlot+"-"+lnoidentifiant+"-"+TABLE_SEPARE.PBASe[j]+TABLE_SEPARE.tprodtrtspec[j]+".asc")
      	fin
      fin
      
      si pas lfabrication alors
      	iConfigure(imprimanteetiquette)
      	iimprimeetat(EEtiquetteIntercalaire,"MemEtiquette")
      fin
      
     type : 458752
   -
     name : OPTIMA08062009
     procedure_id : 5345044636415969925
     type_code : 14
     code : |1+
      // préparation du fichier pour l'optimisation
      Procédure OPTIMA08062009(nlot = "200",lfabrication=faux)
      i est un entier
      li est un entier
      sli est un entier
      compteur est un entier
      j est un  entier
      k est un entier
      ligneaecrire est une chaine
      wlargeur est un entier  // variable de travail pour largeur - cap
      whauteur est un entier  // variable de travail pour hauteur - cap
      nombre est un entier = tableoccurrence("TABLE_SEPARE")
      qterésiduelle est un entier
      dimcarr est une chaine  //   pour trouver le nombre de carreau . blanc si 0 X 0
      lnoidentifiant est un entier
      aumoinsuneligne est un entier 
      
      pour j = 1 a tableoccurrence("TABLE_SEPARE")
      	aumoinsuneligne= 0
      	lnoidentifiant = sansespace(numeriqueverschaine(DonneIdentifiant()))
      	fhandle est un entier = fcree(reppourxopt+"\"+nlot+"-"+lnoidentifiant+"-"+TABLE_SEPARE.PBASe[j]+TABLE_SEPARE.tprodtrtspec[j]+".asc")
      	//	fhandle est un entier = fcree(reppourxopt+"\"+nlot+"-"+separation.NUMEROOPT+"-"+lnoidentifiant+"-"+TABLE_SEPARE.PBASe[j]+TABLE_SEPARE.tprodtrtspec[j]+".asc")
      	si fhandle = -1 alors
      		ACSO_message("Erreur","Impossible de créer le fichier pour l'optimisation","Erreur")
      	FIN
      	multitache(50)
      	execute("fenjauge.progression",j/nombre * 100)
      
      
      	ligneaecrire+=complete("Lot numéro "+nlot,32," ")
      	ligneaecrire+=DATEVERSCHAINE(datesys(),"JJMMAAAA")
      	ligneaecrire+=repete(" ",8)
      	ligneaecrire+=numeriqueverschaine(qtetotal[j],"8d")
      	ligneaecrire+="V2"
      
      	FECRITLIGNE(fhandle,ligneaecrire) 
      
      	ligneaecrire = ""	   
      	//	ligneaecrire+=numeriqueverschaine(qteinitial[j],"8d")
      	ligneaecrire+=numeriqueverschaine(qteligne[j],"8d")
      	FECRITLIGNE(fhandle,ligneaecrire)
      
      	ligneaecrire = ""	   
      	li=1
      	sli=1
      	compteur = 1
      
      	// hlitrecherche("tempo","tbase",pbase[j])
      	// hlitrecherche("tempo","cletrait_base_esp_comm_ligne",pbase[j])
      	//	hlitrecherche("tempo","cletrait_base_esp_comm_ligne",...
      	//	traitement[j]+pbase[j]+trang[j]+repete(" ",8))
      	hlitrecherche(tempo,cletrait_base_esp_comm_ligne,...
      	HConstruitValClé(tempo,cletrait_base_esp_comm_ligne,traitement[j],pbase[j],trang[j]))
      
      
      	//Code WinDev 5.5 remplacé par la migration :
      	// tantque pas h.endehors et sansespace(tempo.tbase) = sansespace(pbase[j])
      	tantque pas HEnDehors() et sansespace(tempo.tbase) = sansespace(pbase[j]) ET SANSESPACE(TEMPO.Trngtrtspe) = SANSESPACE(TRANG[j])
      		si pas tempo.Tfabrication = lfabrication alors
      			hlitsuivant("tempo","cletrait_base_esp_comm_ligne")
      			continuer
      		fin
      		si tempo.TIntercalaireSeulement alors
      			si MemRecherche("MemEtiquette",tempo.tnoRecFdetail) ="" alors
      				memajoute("MemEtiquette",tempo.tnoRecFdetail,tempo.tnoRecFdetail)
      			fin
      			hlitsuivant("tempo","cletrait_base_esp_comm_ligne")
      			continuer
      		fin
      		aumoinsuneligne++
      
      		si tempo.ttraitementspecial = traitement[j] 
      
      			//		qterésiduelle = tempo.tqte
      
      			//		pour k = 1 a tempo.tqte pas 2
      
      			ligneaecrire += complete(sansespace(pbase[j]),16)    // 1-16
      			ligneaecrire += numeriqueverschaine(compteur,"5d")    // 17-21
      			ligneaecrire += gauche(tempo.tnomcourt,12)           // 22-33
      			//			ligneaecrire += complete(gauche(sansespace(Tempo.tjobligne)+"/"+sansespace(tempo.tordre),12),12," ")
      			ligneaecrire += complete(numeriqueverschaine(tempo.tcomm),12," ")  // 34-45
      			ligneaecrire += repete(" ",13)  // 46-58
      			ligneaecrire += complete("0.0",3," ")  // 59-61
      			ligneaecrire += numeriqueverschaine(tempo.tqteoriginale,"3d")  // 62-64
      			ligneaecrire += "Y"   // 65
      			//			ligneaecrire += numeriqueverschaine(tempo.tqte * tempo.tqtebase,"8d")  // 66-73
      			ligneaecrire += numeriqueverschaine(tempo.tqte,"8d")  // 66-73
      			ligneaecrire += repete(" ",8)   // 74-81
      
      			si position(tempo.tcapgaztube,"C") <> 0  alors
      				si config.calculcapactif alors
      					wlargeur = val(tempo.tlargeur) - config.Cnbmilcap
      					whauteur = val(tempo.thauteur) - config.Cnbmilcap
      				sinon
      					wlargeur = val(tempo.tlargeur) 
      					whauteur = val(tempo.thauteur) 
      				fin
      			SINON
      				wlargeur = val(tempo.tlargeur) 
      				whauteur = val(tempo.thauteur) 
      			FIN
      			//				ligneaecrire += numeriqueverschaine(wlargeur,"6d")+",0"
      			//				ligneaecrire += numeriqueverschaine(whauteur,"6d")+",0"
      			si sansespace(tempo.tnoforme) <> "" ALORS
      				ligneaecrire += "   11111"
      				ligneaecrire += "   11111"
      
      			sinon
      				ligneaecrire += numeriqueverschaine(wlargeur,"8d")
      				ligneaecrire += numeriqueverschaine(whauteur,"8d")
      
      			FIN   // 82-97
      			//ligneaecrire += "     0,0"
      			ligneaecrire+=complete(sansespace(gauche(tempo.tespace,8)),8) // 98-105
      			//				ligneaecrire += repete(" ",32)
      			//			si pas sansespace(tempo.tnumcarr) = "" alors
      			//				//                	hlitrecherche(typecarr,TCCLEUNIK,tempo.TtypeCalcul)
      			//				dimcarr = sansespace(tempo.tnumcarr)+" "+	sansespace(tempo.tcarreauv)+"X"+...
      			//				sansespace(tempo.tcarreauh)+" "+sansespace(tempo.ttypecalcul)
      			//			sinon
      			//				dimcarr = ""
      			//			FIN
      			//			hlitrecherche(typespac,tnumero,tempo.TtypeSpacer)
      			//			ligneaecrire += complete(sansespace(typespac.tdesccourte)+...
      			//			" "+dimcarr+ " " + tempo.tnotes...
      			//			,32," ")
      
      			ligneaecrire += complete(sansespace(tempo.tlargeura)+...
      			" X "+sansespace(tempo.thauteura)...
      			,32," ")  // 106-137
      
      
      			//			ligneaecrire += numeriqueverschaine(tempo.tqte * tempo.tqtebase,"5d")  // 138-142
      			si tempo.timprimeetiq alors
      				ligneaecrire += numeriqueverschaine(tempo.tqte,"5d")  // 138-142
      			sinon
      				ligneaecrire += "    0"  // 138-142
      			fin
      			//ligneaecrire += numeriqueverschaine(tempo.tqte,"5d")
      			ligneaecrire += "    0"   //143-147
      			ligneaecrire += "    0"   //148-152 
      			ligneaecrire += gauche(tempo.tjob,6)   //153-158
      			//			ligneaecrire+=DATEVERSCHAINE(datesys(),"JJMMAAAA")
      			si DateValide(tempo.tdaterequise)  alors  //159-166
      				ligneaecrire+=DATEVERSCHAINE(tempo.tdaterequise,"JJMMAAAA")
      			fin
      			ligneaecrire+=repete(" ",43) //167-209
      			si hlitrecherche(invent,INUM,tempo.Tnumcarr) alors     // 210-241
      				ligneaecrire+=gauche(invent.IDESC,32)
      			sinon
      				ligneaecrire+=repete(" ",32)
      			fin
      			HLITRECHERCHE(typespac,tnumero,TEMPO.TtypeSpacer)
      			si gauche(typespac.tdescription,4) = ("Inex") alors                // 242-273
      				hlitrecherche(spacer,stypeSnumero,HConstruitValClé(spacer,stypesnumero,"I",tempo.tespace))
      				ligneaecrire+=complete(gauche(sansespace(typespac.tdescription)+" "+sansespace(tempo.tespace)+" "+sansespace(spacer.sdescription),32),32)
      
      
      			sinon
      				hlitrecherche(spacer,stypeSnumero,HConstruitValClé(spacer,stypeSnumero,"A",sansespace(tempo.tespace)))
      				ligneaecrire+=complete(gauche(sansespace(typespac.tdescription)+" "+sansespace(tempo.tespace)+" "+sansespace(spacer.sdescription),32),32)
      			FIN
      			//			ligneaecrire+=repete(" ",32)
      			ligneaecrire+=complete("FINI:"+sansespace(tempo.tfini),32) // 274-305
      			// position 306-336
      			si sansespace(tempo.tnumcarr) <> "" alors   //306-337
      				ligneaecrire+="Carreaux LARGEUR:" + numeriqueverschaine(tempo.tcarreauv,"2d") + " HAUTEUR:" + NumériqueVersChaine(tempo.tcarreauh,"2d")+" "
      			sinon
      				ligneaecrire+=repete(" ",31)
      			fin
      			//position 337-368
      			ligneaecrire+=complete(tempo.tcouleurcarr,32)
      			//position 369-400
      			ligneaecrire+=complete(tempo.tcouleurcarr2,32)
      			//position 401-432
      			ligneaecrire+=complete(tempo.tnotes,32)
      			//position 433-464
      			ligneaecrire+=complete(tempo.tnote2,32)
      
      			ligneaecrire+=repete(" ",201)
      			//			ligneaecrire+=gauche(tempo.tnomclient,32)
      			ligneaecrire+=gauche(tempo.tnomLivraison,32)
      
      			//			ligneaecrire+=sansespace(gauche(tempo.tjob,14))+"/"+sansespace(gauche(tempo.tjobligne,14))
      			ligneaecrire+=sansespace(gauche(tempo.tordre,14))+"/"+sansespace(gauche(tempo.tjobligne,14))
      			ligneaecrire+=repete(" ",32-taille(sansespace(gauche(tempo.tordre,14))+"/"+sansespace(gauche(tempo.tjobligne,14))))
      			ligneaecrire+=complete(tempo.tdescription,32)
      			//ligneaecrire += complete(sansespace(numeriqueverschaine(tempo.tqte * tempo.tqtebase,"8d")),32)
      			ligneaecrire += complete(sansespace(numeriqueverschaine(tempo.tqte ,"8d")),32) // pour imprimer la quantité sur étiquette
      			ligneaecrire += complete(sansespace(tempo.tlargeura)+...
      			" X "+sansespace(tempo.thauteura)...
      			,32," ")
      			ligneaecrire+=complete(nlot+"-"+lnoidentifiant+"-"+TABLE_SEPARE.PBASe[j]+".asc",32)
      
      			fecritligne(fhandle,ligneaecrire)
      			pour i = 2 a tempo.tqtebase
      //				si i = 3 alors
      //					compteur++
      //					ligneaecrire[[17 a 21]]= numeriqueverschaine(compteur,"5d")    // 17-21
      //				fin
      				ligneaecrire[[138 a 142]] = "    0"
      				fecritligne(fhandle,ligneaecrire)
      			fin
      			ligneaecrire = ""
      			//				qterésiduelle -= 2
      			compteur++
      			//			FIN
      		FIN
      		hlitsuivant("tempo","cletrait_base_esp_comm_ligne")
      	fin
      	compteur = 0
      	fferme(fhandle)
      	si aumoinsuneligne =0 alors
      		fsupprime(reppourxopt+"\"+nlot+"-"+lnoidentifiant+"-"+TABLE_SEPARE.PBASe[j]+TABLE_SEPARE.tprodtrtspec[j]+".asc")
      	fin
      fin
      
      si pas lfabrication alors
      	iConfigure(imprimanteetiquette)
      	iimprimeetat(EEtiquetteIntercalaire,"MemEtiquette")
      fin
      
