 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1+
      procedure separation(dest = "Optima")
      // Pour compatibilité 5.5
      MoiMême..Visible=Vrai
      
      
      GLOBAL
      reppourxopt est une chaine = sansespace(config.DossierOptimisation)
      reppourxopt1 est une chaine = completerep(config.DossierOptimisation)+"xopt"
      
      remplir_table_separe()
      si TABLE_SEPARE..occurrence <> 0 alors
      	bouton..etat = actif
      	BTN_MODIFIE..etat = actif
       //   numeroopt..etat = actif
      FIN
   -
     code : |1+
      si MemExiste("MemEtiquette") alors
      	MemSupprimeTout("MemEtiquette")	
      FIN
      memcree("MemEtiquette")
      
      
