  -
    name : BTN_OK
    identifier : 0x3e9d90c060457b0b
    internal_properties : 
    properties :
     x : 344
     y : 47
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         ouvrefille(FENJAUGE,"Préparation des fichiers "+rc+"d'optimisation")
         hlitpremier(tempo,TECLEUNIK)
         
         selon dest
         	cas "Optima"
         		optimarack(sansespace(NumériqueVersChaine(tempo.tnumeroprep)),faux)  // premiere passe pour thermos a optimiser
         		optimaRack(sansespace(NumériqueVersChaine(tempo.tnumeroprep))+"FAB",vrai) // deuxieme passe pour fabrication seulement
         	cas "Xopt"
         		xhostinp(sansespace(NumériqueVersChaine(tempo.tnumeroprep)))
         	autres cas
         		xhostinpprod(sansespace(NumériqueVersChaine(tempo.tnumeroprep)))
         fin
         
         ferme(FENJAUGE)
         bouton..etat = grisé; bouton..Visible=Vrai
         btn_modifie..etat = actif; btn_modifie..Visible=Vrai
         table_separe..etat = AffichageSeulement; table_separe..Visible=Vrai
         
        type : 18
      -
        type : 161
        enabled : false
