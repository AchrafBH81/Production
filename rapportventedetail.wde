    code_elements :
     type_code : 30
     p_codes : []
  -
    name : BLOC_CORPS
    identifier : 0x3e9d90f970965979
    internal_properties : CQAAAAkAAAB9qXUIDw1PfoKyDagiT8E4zyAj/E+uUGYnffK5SRIzD6SLXOWxg4REDHjG+bui96TI0Oa2DizLGMNQsjP3i1ISMehM7pUHVVDoi0sT+yiKPgoCuqM5q9UfdekoGiUoEZckzMnNm98j2wHGG3+nRYnxpti5CsWy0K2f3DIZnEpw0Ru7ls3d01szYWPYlhqy068NMKv+7FwtzhG10CJTvXaXqGJzz+jXWiyQB22LOFbqME+2MJt2jCCFb+JGfOmDtag9Aoh3Rja6RjdaFqb+uQ==
    properties :
     y : 56.7
     width : 335.6
     height : 1.25
    code_elements :
     type_code : 30
     p_codes :
      -
        code : |1+
         hlitrecherche(hfacture,HFCLEUNIK,hfdetail.HFCLEUNIK)
         hlitrecherche(BonLivraison,Bnumero,hfacture.Bnumero)
         //Code WinDev 5.5 remplacé par la migration :
         //si pas h.endehors et h.trouve alors
         si pas HEnDehors() et HTrouve() alors
         si pas hfdetail.ftype = 0 alors
         
          si hfdetail.ftype = 4 alors
             si bonlivraison.bdatefacture >= _pparam1[1] alors
         	  totalproduit+= hfdetail.fdcarrprixtotal
               totalqte += hfdetail.fdqteafacturer
         	  surchargeper+=hfdetail.surchargeenergie
             fin
             si bonlivraison.bdatefacture >= _pparam1[3] alors
               totalqteannee += hfdetail.fdqteafacturer
         	  totalproduitannee+= hfdetail.fdcarrprixtotal
         	  surchargeannee+=hfdetail.surchargeenergie
         	fin
             si bonlivraison.bdatefacture >= _pparam1[7] et bonlivraison.bdatefacture <= _pparam1[8]alors
         		
         	FIN
             si bonlivraison.bdatefacture >= _pparam1[5] et bonlivraison.bdatefacture <= _pparam1[6]alors
         		
         	FIN
         	  
         sinon
             si bonlivraison.bdatefacture >= _pparam1[1] alors
              totalproduit += hfdetail.fdqteafacturer * (hfdetail.fdprixu  + hfdetail.fdextraforme)
              totalqte += hfdetail.fdqteafacturer
         	 surchargeper+=hfdetail.surchargeenergie
             fin
             si bonlivraison.bdatefacture >= _pparam1[3] alors
              totalqteannee += hfdetail.fdqteafacturer
              totalproduitannee += hfdetail.fdqteafacturer * (hfdetail.fdprixu + hfdetail.fdextraforme)
         	 surchargeannee+=hfdetail.surchargeenergie
             fin
             si bonlivraison.bdatefacture >= _pparam1[7] et bonlivraison.bdatefacture <= _pparam1[8]alors
         		
         	FIN
             si bonlivraison.bdatefacture >= _pparam1[5] et bonlivraison.bdatefacture <= _pparam1[6]alors
         		
         	FIN
         fin
         fin
         fin
         
        type : 327692
      -
        type : 327697
        enabled : false
