 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1+
      si frep(completerep(repdonnees)+"Erreur") = "" alors
           
      	fRepCrée(completerep(repdonnees)+"Erreur")
      
      FIN
      hlit(config,1)
      EtatDeLenvoi est un entier   // 0=pas envoyé,1 = envoyé par email ou imprimé
      ProchainErreur est un entier = config.prochainerreur
      NomFichierErreur est une chaine = completerep(repdonnees)+"Erreur\Erreur"+numeriqueverschaine(ProchainErreur)+".txt"
      config.prochainerreur += 1
      hmodifie(config,hnumenrencours)
      FhANDLE est un entier= fcree(completerep(repdonnees)+"Erreur\Erreur"+numeriqueverschaine(ProchainErreur)+".txt")
      
      Libellé2 += " "+completerep(repdonnees)+"Erreur\Erreur"+numeriqueverschaine(ProchainErreur)+".txt"
      
      
      
      FECRIT(FHANDLE,NetAdresseIP()+RC)
      FECRIT(fHANDLE,NETNOMMACHINE()+RC)
      FECRIT(FHANDLE,RC)
      FECRIT(FHANDLE,ExceptionInfo(errComplet))
      
      
      
      
      
      
   -
     code : |1+
       
      
      
      
      
      
     type : 34
   -
     type : 180
     enabled : false
   -
     type : 230
     enabled : false
   -
     code : |1-
      
      si EtatDeLenvoi = 0 alors
      	si ACSO_message("Info","L'erreur n'a pas été imprimée ou envoyé par courriel"+rc+rc+"Voulez-vous quitter sans effectuer une de ces opérations ?","OuiNon") = idno alors
            reprisesaisie(GestionErreur.BtnVoirFichier)
         fin
      fin
     type : 2
   -
     type : 11
   -
     type : 12
   -
     type : 17
   -
     type : 13
  procedures :
   -
     name : EnvoiEmail
     procedure_id : 4782501988506926653
     type_code : 14
     code : |1+
      Procédure EnvoiEmail()
      quand exception dans
      si pas EmailOuvreSessionSMTP("InfoErreur",sansespace(config.ServeurSMTP)) alors
      	acso_message("Erreur","Impossible de se connecter au serveur de courrier sortant","Erreur")
      
      	renvoyer faux
      sinon
      
      
      
      	email.NbDestinataire = 1
      	email.destinataire[1] = config.EmailGestionErreur
      	Email.sujet = "Erreur"
      	email.message = NetAdresseIP()+rc+NetNomMachine()+rc+rc+exceptioninfo(errComplet)
      	email.expediteur = sansespace(config.EmailCompagnie)
      
      	si  pas EmailEnvoieMessage("InfoErreur") alors
      		acso_message("Erreur","Impossible d'envoyer le message pour les raisons suivantes"+rc+erreurinfo(errmessage),"Erreur")
      		//fo(erreurinfo(errMessage))
      		renvoyer faux
      	FIN
      
      fin
      
      
      
      renvoyer vrai
      
      faire
       acso_message("Erreur","Une erreur est survenue lors de l'envoi du courriel","Erreur")
       info(ExceptionInfo(errComplet))
      fin
      
     type : 458752
