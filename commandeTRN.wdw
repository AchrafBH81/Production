           x : 4
           y : -3
           width : 106
           height : 31
          type : 4
          code_elements :
           type_code : 4
           p_codes :
            -
              code : |1-
               commandetrn.cdnumcarr=Ouvre("Recherche de produit","","carrelage",cdnumcarr)
               commandetrn.cdnumcarr..modifie = vrai
               si champencours() = "CDNUMCARR" alors
               	envoietouche("{entree}")
               sinon
               	executetraitement(commandetrn.cdnumcarr,trtModification)
               FIN
              type : 18
