               moimeme = commandetrn.fdhauteura
               ValeurHauteur = moimeme
               
               si typedeproduit = "Verreunite" alors
               //	piedaenlever()
               FIN
               
              type : 15
            -
              code : |1-
               
               //SI PAS moimeme = ValeurHauteur ALORS
               	commandetrn.fdhauteura = moimeme	
               	
               	selon commandetrn.facalcul
               		cas 1
               			SI PAS CONVERTirANGLAIS(MOIMEME) ALORS
               				REPRISESAISIE
               			FIN
               			commandetrn.fdhauteuranglais = commandetrn.fdhauteura
               			verifiemaximum(val(commandetrn.cdlargeur),val(commandetrn.cdHauteur))
               		cas 2
               //			commandetrn.fdhauteuranglais = calcul_anglais(moimeme)
               						commandeTRN.fdhauteuranglais = MillimiterToInchFraction(MoiMême)
               			SI PAS CONVERT_metrique() ALORS
               				REPRISESAISIE
               			FIN
               			verifieMaximum(Val( commandeTRN.fdlargeura)/25.4,Val( commandeTRN.fdhauteura)/25.4)
               	fin	
               
               	calcul_prixu(commandetrn.facalcul,escompteqte,pourcescompteqte,dmodif)
               	calculenergieligneencours()
               //FIN
               
               RepriseSaisie(CDHAUTEUR1)
