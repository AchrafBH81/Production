              code : |1-
               commandetrn.cdprixtot = commandetrn.cdqte * ( commandetrn.cdprixu  + commandetrn.fdextraforme)
               calculenergieligneencours()
               //	commandetrn.surchargeenergie += (commandetrn.cdqte * commandetrn.fdextraforme) * surchargebase / 100
               //	commandetrn.surchargeenergie += commandetrn.cdcarrprixtotal * surchargebase / 100
               //si commandetrn.casesurchargeenergie alors
               //	si commandetrn.CDVERREUNITE alors
               //		commandetrn.surchargeenergieextraforme = (commandetrn.cdqte * commandetrn.fdextraforme) * surchargeverreunite / 100
               //
               //	sinon	
               //		commandetrn.surchargeenergieextraforme = (commandetrn.cdqte * commandetrn.fdextraforme) * surchargebase / 100
               //	fin
               //	commandetrn.surchargeenergiecarrelage = commandetrn.cdcarrprixtotal * surchargebase / 100
               //sinon
               //	commandetrn.surchargeenergie = 0
               //fin
               si moimeme..Modifié alors
               	intPrixExtraFormeModifie = vrai
               	ExécuteTraitement(intPrixExtraFormeModifie,trtModification)
               FIN
