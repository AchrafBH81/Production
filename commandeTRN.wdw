     type : 458752
   -
     name : affichePeinture
     procedure_id : 5859041163898701633
     type_code : 14
     code : |1+
      Procédure affichePeinture(lAffichageseulement = faux)
      
      GrpComposant..visible = faux
      cddesc..y = cdcomposant1..y
      grpPeinture..visible = btn_vert..visible
      si pas lAffichageseulement alors
         grpPeinture..etat = actif
      fin
      
      cssTypePeinture2..x = btn_composant2..x
      csstypepeinture2..y = btn_composant2..y+3
      fNoPeinture..x = btn_composant2..x+csstypepeinture2..largeur+2
      fNoPeinture..y = btn_composant2..y+3
      btnRecherchePeinture..x = fnopeinture..x+fNoPeinture..Largeur+2
      btnRecherchePeinture..y = btn_composant2..y+4
      fdescpeinture..x = btnRecherchePeinture..x+btnRecherchePeinture..largeur+2
      fdescPeinture..y = btn_composant2..y+3
      fdescpeinture..etat = AffichageSeulement
      cssTypePeinture3..x = btn_composant2..x
      csstypepeinture3..y = csstypepeinture2..y+cssTypePeinture2..hauteur+3
      fNoPeinture1..x = btn_composant2..x+csstypepeinture2..largeur+2
      fNoPeinture1..y = csstypepeinture3..y +1
      btnRecherchePeinture1..x = fnopeinture1..x+fNoPeinture1..Largeur+2
      btnRecherchePeinture1..y = fNoPeinture1..y+2
      fdescpeinture1..x = btnRecherchePeinture1..x+btnRecherchePeinture1..largeur+2
      fdescPeinture1..y = fNoPeinture1..y
      fdescpeinture1..etat = AffichageSeulement
      selon invent.iUniteMesure
      	cas 3
      		commandetrn.cdlargeur = 1
      		commandetrn.fdlargeura = 1
      		commandetrn.cdlargeur..etat = AffichageSeulement
      FIN
      
      
     type : 458752
   -
     name : TrouveExtraPeinture
     procedure_id : 5859041162517858113
     type_code : 14
     code : |1+
      Procédure TrouveExtraPeinture(lNoClient,lNoPeinture)
      valeuraretourner est un reel = 0 
      si hlitrecherche(FCouleurClient,noClientNoCouleur,HConstruitValClé(FCouleurClient,noClientNoCouleur,lNoClient,lNoPeinture)) alors
        si FCouleurClient.fcextraCarreau <> 0 alors
           valeuraretourner = FCouleurClient.fcextraCarreau
        fin
      sinon 
      	si hlitrecherche(fcouleur,noCouleur,lNoPeinture) alors
      		valeuraretourner = FCouleur.cExtracarreau
      	FIN
        	
        		
      	
      FIN
      
      renvoyer valeuraretourner
     type : 458752
   -
     name : remplirComboLivraison
     procedure_id : 5859041163980359489
     type_code : 14
     code : |1+
      Procédure remplirComboLivraison(lNoClient)
      i est un entier
      cpt est un entier
      ldefaut est un entier = 0
      //ListeSupprimeTout(Combo_Livraison)
      //listeajoute(Combo_Livraison,"M Ê M E")
      HExécuteRequête(RequeteLivraison,hRequêteDéfaut,sansespace(lNoClient))
      
      HLitPremier(RequeteLivraison)
      tantque pas hendehors(RequeteLivraison)
      	cpt++
      	
      //	Combo_Livraison.lNom[cpt] = RequeteLivraison.lNom
      //	Combo_Livraison.lRue[cpt] = RequeteLivraison.lrue
      //	Combo_Livraison.lVille[cpt] = RequeteLivraison.lville
      //	Combo_Livraison.lIdClientLivraison[cpt] = RequeteLivraison.IDClientLivraison
      	
      //	listeajoute(Combo_Livraison,RequeteLivraison.lNom+tab+requeteLivraison.lrue+tab+RequeteLivraison.lVille+...
      //	tab+RequeteLivraison.IDClientLivraison)
      	i++
      	si requetelivraison.lDefaut alors
      		ldefaut = i
      	fin
      	
      	HLitSuivant(RequeteLivraison)
      FIN
          
      	ListeAffiche(Combo_Livraison1,tainit)
      	//ListeSelectPlus(Combo_Livraison1,ldefaut)
          listeselectplus(Combo_Livraison1,ldefaut)
      	si pas commandetrn.CaseAdresseManuelle alors ExécuteTraitement(Combo_Livraison1,trtSélection)
     type : 458752
   -
     name : calcul_espace_tableau
     procedure_id : 5859041162870966081
     type_code : 14
     code : |1+
      Procédure calcul_espace_tableau(variable,messageErreur = vrai)
      x est un entier
      different est un booleen = faux   // si dans le fichier kit pas de lien intercallaire = faux
      continuerrecherche est un booleen = faux // si pas trouve avec le numero de produit aller voir le lien
      doubleexiste est un booleen = faux
      lelien est une chaine
      lelien1 est une chaine
      lefini est un reel
      lespace est un reel 
      lespacetotale est un reel 
      clederecherche EST UNE CHAINE
      ldoublescellant est un reel =0
      linexblanc est un booléen = faux
      linexnoir est un booléen = faux
      linexgris est un booléen = faux
      lIndex est une chaine
      ltolerance est une chaine
      ltolerancemoins est une chaine
      lmultiplicateur est un entier = 1
      epaisseurThermos est un reel = epaisseur
      
      lelien = complete(commandetrn.cdcomposant1,10)+complete(commandetrn.cdcomposant2,10)+complete(commandetrn.cdcomposant3,10)
      lelien1 = complete(produitdebase1,10)+complete(produitdebase2,10)+complete(produitdebase3,10)
      clederecherche = HConstruitValClé(inter,cleclientproduit,cl.numero,...
      complete(commandetrn.cdcomposant1,10),complete(commandetrn.cdcomposant2,10),...
      complete(commandetrn.cdcomposant3,10),complete(commandetrn.dfini,10))
      hlitrecherche("inter","cleclientproduit",clederecherche)
      si cdenergiverre alors
      //	ldoublescellant = Arrondi(config.cDoubleScellant,3)
      	ldoublescellant = Arrondi(gclconfig.m_rCDoubleScellant,3)
      sinon
      	pour i = 1 a 3
      
      		si pas sansespace({"produitdebase"+numeriqueverschaine(i)}) = "" alors
      
      			si  pas droite(sansespace({"produitdebase"+numeriqueverschaine(i)}),1) = "3" alors
      //				ldoublescellant = arrondi(config.cDoubleScellant,3)
      				ldoublescellant = Arrondi(gclConfig.m_rCDoubleScellant,3)
      				sortir
      			FIN
      		fin
      
      	fin
      FIN
      
      
      
      
      si pas HEnDehors() et HTrouve() alors
      	si type_intercallaire = "Inex" alors
      		si inter.iinex alors
      			commandetrn.cdespace	= inter.iespaceinex
      			commandetrn.cdespace2  = inter.Iespaceinex2
      			commandetrn.cdespaceinex = intercal.idescinex
      
      		sinon
      
      			continuerrecherche = vrai
      		fin	
      	sinon
      		si inter.ialuminium alors
      			commandetrn.cdespace	= inter.iespace
      			commandetrn.cdespace2	= inter.iespace2
      			commandetrn.cdespaceinex = intercal.idescinex
      		sinon
      			continuerrecherche = vrai
      
      		fin	
      	fin	
      sinon
      	clederecherche = HConstruitValClé(inter,cleclientproduit,cl.numero,...
      	complete(produitdebase1,10),complete(produitdebase2,10),...
      	complete(produitdebase3,10),complete(commandetrn.dfini,10))
      	hlitrecherche("inter","cleclientproduit",clederecherche)
      
      	//Code WinDev 5.5 remplacé par la migration :
      	//    si pas h.endehors et h.trouve alors
      	si pas HEnDehors() et HTrouve() alors
      		si type_intercallaire = "Inex" alors
      			si inter.iinex alors
      				commandetrn.cdespace	= inter.iespaceinex
      				commandetrn.cdespace2	= inter.iespaceinex2
      				commandetrn.cdespaceinex = intercal.idescinex
      			sinon
      
      				continuerrecherche = vrai
      			fin	
      		sinon
      			si inter.ialuminium alors
      				commandetrn.cdespace	= inter.iespace
      				commandetrn.cdespace2	= inter.iespace2
      				commandetrn.cdespaceinex = intercal.idescinex
      			sinon
      				continuerrecherche = vrai
      
      			fin	
      		fin	
      
      	sinon
      
      		continuerrecherche = vrai		
      	fin
      FIN
      
      //fin
      
      selon sansespace(Minuscule(typespac.tdescription))
      	cas "inex blanc"
      		lIndex = "stypeSinexblancSdimension"
      		ltolerance = "StoleranceB"
      		ltolerancemoins = "StoleranceBmoins"
      	cas "inex noir"
      		lIndex = "stypeSinexnoirSdimension"
      		ltolerance = "StoleranceN"
      		ltolerancemoins = "StoleranceNmoins"
      	cas "inex gris"
      		lIndex = "stypeSinexgrisSdimension"
      		ltolerance = "StoleranceG"
      		ltolerancemoins = "StoleranceGmoins"
      FIN
      
      
      
      si continuerrecherche alors
      
      	si pas position(variable,".") = 0 alors
      		lefini = arrondi(val(variable) * 25.4,3)
      	sinon
      		si pas position(variable,"/") = 0 alors
      			lefini =numeriqueverschaine( convertiranglais(variable,"fini") * 25.4,"6.3f")
      
      		sinon
      			si val(variable) < 6 alors
      				lefini =numeriqueverschaine( convertiranglais(variable,"fini") * 25.4,"6.3f")
      
      
      			FIN
      		FIN
      FIN
      
      epaisseurThermos+=ldoublescellant
      
      
      selon nbverre
      
      	cas "double" 
      		lespace = arrondi((lefini - epaisseurThermos) ,3)
      		lespacetotale = arrondi((lefini - epaisseurThermos) ,3)
      		lmultiplicateur = 1
      	cas "triple" 
      		lespace = arrondi((lefini - epaisseurThermos) / 2 ,3)
      		lespacetotale = arrondi((lefini - epaisseurThermos) ,3)
      		lmultiplicateur = 2
      
      fin	
      
      lespace = arrondi(lespace/25.4,3)
      lespacetotale = arrondi(lespacetotale/25.4,3)
      
      
      
      si type_intercallaire = "Inex" alors
      
      	hlitrecherche(spacer,lIndex,HConstruitValClé(spacer,lIndex,"I",vrai,lespace))
      
      	//		hlitrecherche(spacer,stypeSdimension,HConstruitValClé(spacer,stypeSdimension,"I",lespace))
      	si pas hendehors(spacer) alors
      		si pas lespace > spacer.sdimension-{"spacer."+ltolerancemoins} alors
      			HLitPrécédent(spacer,lIndex)
      			si pas lespace < spacer.sdimension+{"spacer."+ltolerance} alors
      				si messageErreur alors
      					acso_message("Erreur","Aucun intercalaire ne correspond à votre demande"+rc+"SVP l'inscrire manuellement","Erreur")
      					reprisesaisie(CDESPACE)
      				fin
      			fin
      		FIN
      	sinon
      		HLitDernier(spacer,lIndex)
      		//		si pas lespace > spacer.sdimension-{"spacer."+ltolerancemoins} alors
      		//			HLitPrécédent(spacer,lindex)
      		si pas lespace < spacer.sdimension+{"spacer."+ltolerance} alors
      			si messageErreur alors
      				acso_message("Erreur","Aucun intercalaire ne correspond à votre demande"+rc+"SVP l'inscrire manuellement","Erreur")
      				reprisesaisie(CDESPACE)
      			fin
      		fin
      fin
      
      cdespace = spacer.snumero
      si nbverre = "triple" alors
      	cdespace2 = spacer.snumero
      fin
      sinon
      
      	hlitrecherche(spacer,stypeSaluminiumSdimension,HConstruitValClé(spacer,stypeSaluminiumSdimension,"A",vrai,lespace))
      	si pas hendehors(spacer) alors
      		//		si pas lespacetotale >= (spacer.sdimension*lmultiplicateur)-spacer.StoleranceB alors
      		si pas lespace >= arrondi(spacer.sdimension-spacer.StoleranceBmoins,3) alors
      			HLitPrécédent(spacer,stypeSaluminiumSdimension)
      			//		si pas lespacetotale < (spacer.sdimension*lmultiplicateur)+spacer.stolerancebmoins alors
      			si pas lespacetotale < arrondi(spacer.sdimension+spacer.stoleranceb,3) alors
      				si messageErreur alors
      					acso_message("Erreur","Aucun intercalaire ne correspond à votre demande"+rc+"SVP l'inscrire manuellement","Erreur")
      					reprisesaisie(CDESPACE)
      				fin
      			fin
      		FIN
      	sinon
      		HLitDernier(spacer,stypeSaluminiumSdimension)
      		//		si pas lespace > spacer.sdimension-{"spacer."+ltolerancemoins} alors
      		//			HLitPrécédent(spacer,lindex)
      		si pas lespacetotale < arrondo(spacer.sdimension+spacer.StoleranceB,3) alors
      			si messageErreur alors
      				acso_message("Erreur","Aucun intercalaire ne correspond à votre demande"+rc+"SVP l'inscrire manuellement","Erreur")
      				reprisesaisie(CDESPACE)
      			fin
      		fin
      //		si messageErreur alors
      //			acso_message("Erreur","Aucun intercalaire ne correspond à votre demande"+rc+"SVP l'inscrire manuellement","Erreur")
      //			reprisesaisie(CDESPACE)
      //		fin
      fin
      
      cdespace = spacer.snumero
      si nbverre = "triple" alors
      
      	cdespace2 = spacer.snumero
      fin
      
      fin
      
      
      fin
      //
      
     type : 458752
   -
     name : calculTotalCommande
     procedure_id : 5859041162359916353
     type_code : 14
     code : |1+
      Procédure calculTotalCommande()
      XPOSITION EST UN ENTIER = HSAUVEPOSITION("trdetail")
      TotalCommande est un reel
      TotalEnergie est un reel
      TotalSurchTaux est un reel
      //SurchargeTaux est un reel = config.SurChargeTauxBase
      //SuchargeTauxBaseActive est un booleen = config.SUrchargeTauxActive
      //SurchargeSurEnergie est un booleen = config.calculTauxSurSurcharge
      SuchargeTauxBaseActive est un booleen = gclconfig.m_bSUrchargeTauxActive
      SurchargeSurEnergie est un booleen = gclconfig.m_bcalculTauxSurSurcharge
      NbComposant est un entier
      NbVerresCommande = 0
      
      //SI MODIF ALORS
      
      
      hlitpremier("trdetail","fdnocomm")
      //Code WinDev 5.5 remplacé par la migration :
      //tantque pas h.endehors
      tantque pas HEnDehors()
      si pas trdetail.traye alors
      	NbComposant = 0
      	selon trdetail.ftype
      		cas 1
      			TotalCommande+=arrondi(trdetail.fdprixtotal,2)+...
      			((trdetail.FDextra10X+trdetail.FDextra5x)*trdetail.fdqte)
      
      		cas 2
      			TotalCommande+=arrondi(trdetail.fdprixtotal,2)
      
      		cas 3
      			TotalCommande+=arrondi(trdetail.fdprixtotal,2)
      
      		cas 4
      			TotalCommande+=arrondi(trdetail.fdprixtotal,2)
      			si trdetail.fpeinture alors
      				TotalCommande+=arrondi(trdetail.fTotalPeinture*trdetail.fdqte,2)
      			fin
      		cas 5
      			TotalCommande+=arrondi(trdetail.fdprixtotal,2)
      	FIN
      
                  TotalEnergie+=Arrondi(trdetail.surchargeenergie,2) 
      //            TotalSurchTaux+=arrondi(trdetail.SUrchargeTaux,2)
                  
      fin
      	//hmodifie("trdetail")
      	SI sansespace(trdetail.fdcomposant1) <> "" ALORS NbComposant++
      	SI sansespace(trdetail.fdcomposant2) <> "" ALORS NbComposant++
      	SI sansespace(trdetail.fdcomposant3) <> "" ALORS NbComposant++
      	
      	NbVerresCommande += (trdetail.fdqte * NbComposant)
      	HLITSUIVANT("trdetail","fdnocomm")
      
      
      fin		 
      //FIN
      HRETOURPOSITION(XPOSITION)
      //Code WinDev 5.5 remplacé par la migration :
      //tableaffiche("TABLE_1","I")
      SI SuchargeTauxBaseActive ALORS
      	TotalSurchTaux = Arrondi(TotalCommande+( SurchargeSurEnergie ? TotalEnergie sinon 0 ),2) * SurchargeTauxclient / 100
      sinon
      TotalSurchTaux = 0
      FIN
      
      LibelléPrixAnglais = NumériqueVersChaine(arrondi(TotalCommande+TotalEnergie+TotalSurchTaux,2),"8,2f")
      //commandetrn.surchargeTauxChange = totalsurchtaux
      
      //tableaffiche("TABLE_1",taDebut)
      //Code WinDev 5.5 remplacé par la migration :
      //execute("table_1..lentree")
      //ExecuteTraitement("table_1",trtENTREELIGNE)
      
     type : 458752
   -
     name : existe_produit
     procedure_id : 5859041163593893697
     type_code : 14
     code : |1+
      Procédure existe_produit(produit,videpermis=vrai,type = "")
      retourne est un booléen = faux
      si sansespace(produit) = "" alors
      	si videpermis alors
      		retourne = vrai
      	sinon
      		retourne = faux
      	fin	
      
      sinon
      
      	hlitrecherche("invent","INUM",complete(produit,10))
          si invent.iactif = 0  alors
          ACSO_message("Erreur","Produit inactif","Erreur")
          renvoyer faux
          fin
          	
      	//Code WinDev 5.5 remplacé par la migration :
      	//	si pas h.endehors alors
      	si pas HEnDehors() alors
      
      		//Code WinDev 5.5 remplacé par la migration :
      		//		si h.trouve alors
      		si HTrouve() alors
      
      			selon type
      				cas "Verre"
      					si invent.itype = 1 alors
      
      						retourne = faux
      						cdnumprod = ""
      						acso_message("Erreur","Inscrire ce type de produit dans les composantes","Erreur")
      					sinon
      						retourne = vrai
      					fin
      				cas ""
      					si pas invent.itype = 1 alors
      
      						retourne = faux
      						acso_message("Erreur","Ce type de produit ne peut pas être une composante","Erreur")
      					sinon
      						si pas invent.iactif alors
      							retourne = Faux
      							ACSO_message("Erreur","Ce produit est inactif","Erreur")
      						sinon
      						
      						retourne = vrai
      						Fin
      					fin
      				cas "carrelage"
      					si pas invent.itype = 4 alors
      
      						retourne = faux
      						acso_message("Erreur","Ce produit n'est pas un carrelage","Erreur")
      					sinon
      						retourne = vrai
      					fin
      				autre cas
      			fin	
      		sinon
      			retourne = faux
      			acso_message("Erreur","Produit inexistant","Erreur")
      			commandetrn.cdnumprod..curseur = 1
      			commandetrn.cdnumprod..fincurseur = taille(commandetrn.cdnumprod)+1 
      		FIN
      	FIN
      fin
      
      renvoyer retourne
      
     type : 458752
   -
     name : existe_produit_kit
     procedure_id : 5859041162952623937
     type_code : 14
     code : |1+
      Procédure existe_produit_kit(produit,videpermis=vrai)
      retourne est un booléen = faux
      si pas ensemblepersoactif alors
      	renvoyer retourne
      FIN
      si sansespace(produit) = "" alors
         si videpermis alors
      	retourne = vrai
         sinon
      	retoune = faux
         fin	
      sinon
        
      	hlitrecherche("persoens","ennumero",complete(produit,20),hIdentique)
      //Code WinDev 5.5 remplacé par la migration :
      //	si pas h.endehors alors
      	si pas HEnDehors() alors
      //Code WinDev 5.5 remplacé par la migration :
      //		si h.trouve alors
      		si HTrouve() alors
      			retourne = vrai
      			commandetrn.cdcomposant1 = persoens.encomposant1
      			commandetrn.cdcomposant2 = persoens.encomposant2
      			commandetrn.cdcomposant3 = persoens.encomposant3
      			
              FIN
      	FIN
      fin
      
      
      renvoyer retourne
      
     type : 458752
   -
     name : AjouteZ
     procedure_id : 5859041163163518785
     type_code : 14
     code : |1-
      Procédure AjouteZ()
      
      si  position(CDCAPGAZTUBE,"Z") = 0 alors
      	CDCAPGAZTUBE+="Z"
      FIN
     type : 458752
   -
     name : convertiranglais
     procedure_id : 5859041163516168001
     type_code : 14
     code : |1+
      Procédure convertiranglais(variable,provenance = "")
      //variable est une chaine = moimeme
      //hlitpremier("config","COCLEUNIK")
      longueur est un entier = taille(variable)
      position_espace est un entier = position(variable," ")
      position_point est un entier = Position(variable,".")
      //position_espace1 est un entier = position(variable," ",position_espace+1)
      resultat_gauche est une chaine  
      resultat_droit est une chaine        
      valeuraretourner est un reel
      variableAnglais est une chaine
      o_calculator est un Calculator
      
      si position_point <> 0 alors
      	//info("salut")
      FIN
      si position_espace = 0 alors
      	si position(variable,"/") = 0 alors
      		resultat_gauche = ""
      	sinon
      		resultat_gauche = "0"
      	fin	
      sinon	
      
      	resultat_gauche = gauche(variable,position_espace-1)
          variableAnglais+= resultat_gauche+" "
      FIN
      
      si position_espace = 0 alors
      
      	resultat_droit = variable
      
      sinon	
          tantque variable[[position_espace+1]] = " "
             position_espace++
          fin
          	
      	resultat_droit = milieu(variable,position_espace +1, longueur - position_espace)
      
      FIN
      
      resultat_droit = remplace(resultat_droit," ","")
      variableAnglais+= resultat_droit
      
      si pas position(resultat_droit,"/") = 0 alors
       
      	partie_droit est une chaine = memrecherche("tableau_metrique",resultat_droit)
      	SI partie_droit <> "" ALORS resultat_droit = partie_droit
      FIN
      
      
      
      
      
      si provenance = "fini" alors
      	valeuraretourner = val(resultat_gauche)+val(arrondi(o_calculator.compute(resultat_droit),3))
       
      sinon
      	moimeme = resultat_gauche+resultat_droit
      	selon majuscule(moimeme..Nom)
      		CAS "CDLARGEUR"
      			commandeTRN.fdlargeura = variableAnglais
      		CAS "CDHAUTEUR"
      			commandeTRN.fdhauteura = variableAnglais
      			
      		AUTRE CAS
      			
      	FIN
      	valeuraretourner = vrai
      
      FIN
      
      
      si val(moimeme) > gclConfig.m_rDimensionmaxanglais et pas moimeme = "" alors
      	erreur("Donnée incorrecte")
      	valeuraretourner = faux
      FIN
      SI ChaîneOccurrence(MoiMême,".") > 1 ALORS
      	Erreur("Donnée incorrecte")
      	valeuraretourner = Faux
      FIN
      si ChaîneOccurrence(moimeme,"/") > 1 alors
      	erreur("Donnée incorrecte")
      	valeuraretourner = faux
      FIN
      si ChaîneOccurrence(moimeme,",") > 0 alors
      	erreur("Donnée incorrecte")
      	valeuraretourner = faux
      FIN
       
      
      renvoyer valeuraretourner
      
     type : 458752
