        -
          name : CDCOMPOSANT2
          identifier : 0x514f7ee53f21c7a5
          internal_properties : 
          properties :
           x : 79
           y : 42
           width : 63
           height : 23
          type : 2
          code_elements :
           type_code : 3
           p_codes :
            -
              code : |1-
               commandetrn.btn_composant2..etat = actif
               si moimeme..modifie ou dmodif ou sansespace(cdnumprod) = "" alors
               	si pas existe_produit(moimeme) alors
               		reprisesaisie()
               	SINON
               		SI  ForbiddenComponent(MoiMême) ALORS
               			Erreur("Cette composante n'est pas autorisée pour ce client")
               			MoiMême			= ""
               			RepriseSaisie(MoiMême)
               		FIN
               		SI PAS MOIMEME = "" ALORS 
               			selon langueclient
               				cas 0,1
               					composant2_nom  = invent.idesc
               				cas 2
               					composant2_nom  = invent.idescA
               			FIN
               			produitdebase2 = invent.ipbase
               			descriptioncourte2 = sansespace(invent.idesccourte)
               		FIN
               		si pas cdenergiverre alors
               			cdenergiverre  = (invent.ienergieverre OU invent.ienergieverreESC)
               			si CDENERGIVERRE alors
               				ajoutez()
               			fin
               		fin
               	FIN
               	
