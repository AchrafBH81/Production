   -
     name : IsvalidQuotation
     procedure_id : 1180928634199447711
     type_code : 14
     code : |1-
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] IsvalidQuotation ()
      //
      // Paramètres :
      //	Aucun
      // Valeur de retour :
      // 	booléen : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE IsvalidQuotation()
      IsVAlid est une booleen = Vrai
      
      
      POUR TOUT Fdetail AVEC "fdnocomm = " +Facture.fanumero
      	
      	si Fdetail.ftype = 1 alors
      		si fdetail.thermostype <> "S" alors
      			si sansespace(fdetail.ffini) = "" alors
      				IsVAlid = faux
      				sortir
      			fin
      			si fdetail.ftypespacer = 0 alors
      				IsVAlid = faux
      				sortir
      			FIN
      		fin
      	fin	
      FIN
      renvoyer IsVAlid
     type : 458752
   -
     name : GetArgonExtraPrice
     procedure_id : 1358561528147525337
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //GetArgonExtraPrice (<CustomerNumber> est chaîne)
      //
      // Paramètres :
      //	CustomerNumber (chaîne ANSI) : <indiquez ici le rôle de CustomerNumber>
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE GetArgonExtraPrice(CustomerNumber est une chaine)
      clederecherche est une chaine = HConstruitValClé(ProduitClient,IdClientIdproruit,CustomerNumber,gsExtraArgon)
      
      SI HLitRecherche(ProduitClient,IdClientIdproruit,clederecherche) ET ProduitClient.IPprixSpecial ALORS
      		grextraargonprice = ProduitClient.IPrixa
      sinon
      	si hlitrecherche(invent,INUM,gsExtraArgon) ALORS
      		grExtraArgonPrice = invent.iprixunite
      	FIN
      FIN
      
     type : 458752
   -
     name : valideSpacerColorAndDimension
     procedure_id : 1408713543323772924
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] valideSpacerColorAndDimension ()
      //
      // Paramètres :
      //	Aucun
      // Valeur de retour :
      // 	booléen : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE valideSpacerColorAndDimension()
      nOldSpacerColor est un entier = 0
      sOldSpacerDimension est une chaîne = ""
      
      
      pour TOUT trdetail 
      	si trdetail.ftype = 1 alors
      		si  trdetail.ftypespacer <> 0 et pas trdetail.fdverreunite alors
      			si nOldSpacerColor = 0 alors
      				nOldSpacerColor = val(trdetail.ftypespacer)
      			SINON
      				SI val(trdetail.ftypespacer) <> nOldSpacerColor ALORS RENVOYER Faux
      			FIN
      			SI sOldSpacerDimension = "" ALORS
      				sOldSpacerDimension  = sansespace(trdetail.fdespace)+SansEspace(trdetail.fdespace2)
      			SINON
      				SI  SansEspace(trdetail.fdespace)+SansEspace(trdetail.FDespace2) <> sOldSpacerDimension ALORS RENVOYER Faux
      			FIN
      			
      		fin
      	fin
      	
      FIN
      
      
      
      
      
      renvoyer Vrai
     type : 458752
   -
     name : CheckButtonStatus
     procedure_id : 1433374571822358927
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //CheckButtonStatus (<NomFenetre> est chaîne)
      //
      // Paramètres :
      //	NomFenetre (chaîne ANSI) : <indiquez ici le rôle de Param1>
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure CheckButtonStatus(NomFenetre est une chaine)
      
      pour chaque stBouton de gtaFloatingButton[nomfenetre].tabButtonSecurity
      	{stBouton.sButtonName,indChamp}..visible = stbouton.bActiveButton
      FIN
      
      si BTN_ETATBARRE..visible = faux alors BTN_ETATBARRE..x = 1500
      si BTN_ETATdeBARRE..visible = faux alors BTN_ETATdeBARRE..x = 1500
      
      
     type : 458752
   -
     name : suppressActiveTempoOrder
     procedure_id : 1439594521385193223
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //suppressActiveTempoOrder (<sFanocommande> est chaîne)
      //
      // Paramètres :
      //	sFanocommande (chaîne ANSI) : <indiquez ici le rôle de fanocommande>
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure suppressActiveTempoOrder(sFanocommande est une chaine)
      
      //si hlitrecherche(TempoOrderNumber,OrderNumber,sFanocommande) alors
      //	si sansespace(TempoOrderNumber.Username) = sansespace(gsUsername) alors
      //		hsupprime(TempoOrderNumber,hNumEnrEnCours)
      //	FIN
      //FIN
      
      sdReqsql est une source de donnees
      HExécuteRequêtesql(sdReqsql,hRequêteDéfaut,chaineconstruit("delete from TempoOrderNumber where TempoOrderNumber.Username = '%1'",remplace(gsUsername,"'","\'")))
     type : 458752
   -
     name : FillTabShape
     procedure_id : 1482971307725641505
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] FillTabShape ()
      //
      // Paramètres :
      //	Aucun
      // Valeur de retour :
      // 	tableau (cShape) : <indiquez ici le rôle de la valeur de retour>
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure FillTabShape()
      
      tabShape	est un tableau de cshape
      clShape		est un cshape
      
      pour TOUT RequetefeuilleLivraison 
      	si sansespace(RequetefeuilleLivraison.fdforme) <> "" alors
      		clshape					= allouer un cshape()
      		clshape.m_sShapeNumber	= RequetefeuilleLivraison.fdforme
      		si hlitrecherche(forme,fnumero,RequetefeuilleLivraison.fdforme) alors
      			clShape.m_sShapeDescription	= forme.fdescription
      			clshape.m_sChemin			= forme.fchemin
      		fin
      		clShape.w	= RequetefeuilleLivraison.fdw
      		clShape.w1	= RequetefeuilleLivraison.fdw1
      		clShape.w2	= RequetefeuilleLivraison.fdw2
      		clShape.h	= RequetefeuilleLivraison.fdh
      		clShape.h1	= RequetefeuilleLivraison.fdh1
      		clShape.h2	= RequetefeuilleLivraison.fdh2
      		clShape.d	= RequetefeuilleLivraison.fdd
      		clShape.r	= RequetefeuilleLivraison.fdr
      		clShape.r1	= RequetefeuilleLivraison.fdr1
      		clShape.r2	= RequetefeuilleLivraison.fdr2
      		clShape.m_nQty = RequetefeuilleLivraison.fdqteafacturer
      		tabShape.ajoute(clshape)
      		
      	FIN
      FIN
      
      renvoyer tabShape
     type : 458752
   -
     name : TrouveExtraBarrotin
     procedure_id : 1519661821395522641
     type_code : 14
     code : |1-
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] TrouveExtraBarrotin (<noclient>)
      //
      // Paramètres :
      //	noclient : <indiquez ici le rôle de noclient>
      
      // Valeur de retour :
      // 	réel : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE TrouveExtraBarrotin(noclient)
      valeuraretourner est un reel = 0
      
      si hlitrecherche(ProduitClient,IdClientIdproruit,HConstruitValClé(ProduitClient,IdClientIdproruit,noclient,gNoExtraDemi)) _et_ PRODUITCLIENT.IPprixSpecial alors
      	valeuraretourner =  produitclient.IPrixa
      sinon si hlitrecherche(invent,inum,gNoExtraDemi) alors
      	si hlitrecherche(invent,INUM,gNoExtraDemi) alors
      		valeuraretourner = invent.iprixcarreau
      	fin
      	
      FIN
      
      renvoyer valeuraretourner
     type : 458752
   -
     name : ForbiddenComponent
     procedure_id : 1701889025090390143
     type_code : 14
     code : |1-
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] ForbiddenComponent ()
      //
      // Paramètres :
      //	Aucun
      
      // Valeur de retour :
      // 	booléen : <indiquez ici le rôle de la valeur de retour>
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure ForbiddenComponent()
      
      si sansespace(persoens.encomposant1) <> "" alors
      	si hlitrecherche(ClientComposanteInterdite,CustomerIDProductNumber,[client.IDClient,sansespace(persoens.encomposant1)]) alors
      		renvoyer vrai
      	FIN
      	
      FIN
      si sansespace(persoens.encomposant2) <> "" alors
      	si hlitrecherche(ClientComposanteInterdite,CustomerIDProductNumber,[client.IDClient,sansespace(persoens.encomposant2)]) alors
      		renvoyer vrai
      	FIN
      	
      FIN
      si sansespace(persoens.encomposant3) <> "" alors
      	si hlitrecherche(ClientComposanteInterdite,CustomerIDProductNumber,[client.IDClient,sansespace(persoens.encomposant3)]) alors
      		renvoyer vrai
      	FIN
      	
      FIN
      renvoyer faux
     type : 458752
   -
     name : ForbiddenComponent
     procedure_id : 1701889025090390143
     type_code : 14
     code : |1-
      procédure ForbiddenComponent(sProductNumber est une chaine)
      
      
      SI SansEspace(sProductNumber) <> "" ALORS
      	SI HLitRecherche(ClientComposanteInterdite,CustomerIDProductNumber,[Client.IDClient,SansEspace(sProductNumber)]) ALORS
      		RENVOYER Vrai
      	FIN
      	
      FIN
      
      RENVOYER faux
