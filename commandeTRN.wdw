               //    fin	
               	Ouvre(saisieformeTRN,MoiMême,commandeTRN.FCLIENT,fdforme..modifié)
               	
               	reprisesaisie(commandetrn.DFINI)
               sinon
               	bTN_ShowShapedata..Visible = faux
                   commandetrn.fdextraforme = 0
