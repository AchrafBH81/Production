   -
     name : recuperer_répétitif_persistant_cond
     procedure_id : 5859041162714859329
     type_code : 14
     code : |1+
      Procédure recuperer_répétitif_persistant_cond(nomduchamp)
      
      i est un entier
      
      pour i = 1 a dimension(ChampRépétitif)/7
      	si champrépétitif[i,2] alors
      		si sansespace(champrépétitif[i,4]) = sansespace(nomduchamp) alors
      			{champrépétitif[i,1]}=	champrépétitif[i,3] 
      			si champrépétitif[i,7] <> "" alors
      				compile("codecompile",champrépétitif[i,7])
      				executetraitement("codecompile",trtProcédure)
      			FIN
      		FIN
      	fin
      FIN
      //recuperer_répétitif()
      
      	
      //originepersistant = vrai
      
      
      
      
     type : 458752
   -
     name : Maz_répétitif
