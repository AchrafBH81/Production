  -
    name : fanocommande
    identifier : 0x514f7ee5088ac7a5
    internal_properties : 
    properties :
     x : 542
     y : 133
     width : 209
     height : 23
    type : 2
    code_elements :
     type_code : 3
     p_codes :
      -
        code : |1+
         si moimeme <> "" et ajout ALORS
         	suppressActiveTempoOrder(moimeme)
         FIN
        type : 15
      -
        code : |1+
         lnumenr			est un entier	= hsauveposition(Facture)
         sListeCommande	est une chaine
         respopUp		est un booleen
         sOrderToCheck	est une chaine
         ReqSql			est une source de données
         moimeme	= Replace(commandeTRN.fanocommande,","," ")
         moimeme	= sansespace(moimeme)
         si moimeme="" alors renvoyer vrai
         si pas ajout et PAS MoiMême..Modifié alors renvoyer vrai
         si ajout alors
         	si hlitrecherche( TempoOrderNumber,OrderNumber,moimeme,hIdentique) alors
         		si ouinon(chaineconstruit("Cette commande est en cours de saisie pas l'utilisateur %1 "+rc+ "Voulez-vous continuer ?",TempoOrderNumber.Username)) = non alors
         			moimeme = ""
         			RepriseSaisie()
         		FIN
         	sinon
         		TempoOrderNumber.OrderNumber	= moimeme
         		TempoOrderNumber.Username		= gsUsername
         		hajoute(TempoOrderNumber)
         	FIN
         FIN
         si ajout et mafenetre..plan <> 1 et pas moimeme..modifie alors renvoyer vrai
         
         moimeme..modifie = faux
         
         txtSql est une chaine = [
         	select top 30 * from (
         	select Facture.fanumero as commande,Facture.fadate as datecommande,facture.fpreparation as Prep,'' as NoFacture,facture.fatypedocument as typededocument  from Facture WHERE Facture.faclient = '%1' AND Facture.fanocommande = '%2'
         	union select hfacture.fanumero as commande,bonlivraison.bdatefacture as dateCommande,'X' as prep,BonLivraison.Bfacture as NoFacture,'4' as typededocument from hfacture inner join BonLivraison on BonLivraison.BnoCommande = hfacture.fanumero WHERE 
         	bonlivraison.bfacture <> 0 and hfacture.faclient = '%1' AND hfacture.fanocommande = '%2' 
         	) order by datecommande desc
         ]
         
         sOrderToCheck	= Replace(commandeTRN.fanocommande,"'","''")
         txtSql			= ChaîneConstruit(txtSql,commandeTRN.FCLIENT,sOrderToCheck)
         //SI pas sansespace(commandeTRN.fanocommande) = "" _ET_ HExécuteRequêteSQL(ReqSql,hRequêteDéfaut,txtSql) _et_ hnbenr(ReqSql) > 0 ALORS
         //	respopUp = ouvre(PopDoublonCommande,commandetrn.nom,commandetrn.fanocommande,ReqSql)
         //	si pas respopUp
         //		//	SI OuiNon(0,"Attention commande en double"+RC+RC+"Une ou plusieurs commandes de ce client portant ce numéro existe déjà."+RC+RC+ListeCommande+RC+"Continuer avec ce numéro ?") = Non ALORS
         //		moimeme=""
         //		RepriseSaisie()
         //	SINON
         //		RepriseSaisie(fanojob)
         //	FIN
         //fin
         
         SI pas sansespace(commandeTRN.fanocommande) = "" alors
         	si  HExécuteRequêteSQL(ReqSql,hRequêteDéfaut,txtSql) alors
         		si  hnbenr(ReqSql) > 0 ALORS
         			
         			respopUp = ouvre(PopDoublonCommande,commandetrn.nom,commandetrn.fanocommande,ReqSql)
         			si pas respopUp
         				//	SI OuiNon(0,"Attention commande en double"+RC+RC+"Une ou plusieurs commandes de ce client portant ce numéro existe déjà."+RC+RC+ListeCommande+RC+"Continuer avec ce numéro ?") = Non ALORS
         				suppressActiveTempoOrder(commandeTRN.fanocommande)
         				moimeme=""
         				RepriseSaisie()
         			SINON
         				hraz(LogDuplicateOrderNumber)
         				LogDuplicateOrderNumber.CustomerNumber		= commandetrn.fclient
         				LogDuplicateOrderNumber.OrderNumber			= commandeTRN.fanocommande
         				LogDuplicateOrderNumber.Username			= gsUsername
         				LogDuplicateOrderNumber.DuplicateDateTime	= dateHeuresys()
         				hajoute(LogDuplicateOrderNumber)
         				
         				RepriseSaisie(fanojob)
         			FIN
         		fin
         	sinon
         		erreur(HErreurInfo(hErrMessage))
         	FIN
         fin
         
         
         
         
         
         HRetourPosition(lnumenr)
         
         //fin
         
        type : 16
      -
        type : 276
        enabled : false
      -
        type : 277
        enabled : false
      -
        type : 278
        enabled : false
