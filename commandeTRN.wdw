   -
     name : GetThermosType
     procedure_id : 1786577082600223779
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] GetThermosType (<comp1>, <comp2>, <comp3>)
      //
      // Paramètres :
      //	comp1 : <indiquez ici le rôle de comp1>
      //	comp2 : <indiquez ici le rôle de comp2>
      //	comp3 : <indiquez ici le rôle de comp3>
      // Valeur de retour :
      // 	entier : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE GetThermosType(comp1,comp2,comp3)
      tag est une chaine
      tag1 est une chaine = ""
      tag2 est une chaine = ""
      tag3 est une chaine = ""
      tabCombine est un tableau associatif de chaines
      tabCombine[11] = "11"
      tabCombine[111] = "111"
      tabCombine[12] = "12,21"
      tabCombine[121] = "123,132,213"
      tabCombine[112] = "123,132,312"
      tabCombine[122] = "123,213,231"
      tabCombine[123] = "123,132,213,231,321,312"
      //tabCombine est un tableau de chaines
      
      //sdReqsql est une source de donnees
      //sTxtsql est une chaine
      
      
      bThermosTrouve est un booleen = faux
      
      si sansespace(comp1) <> "" alors
      	tag1 ="1"
      FIN
      SI SansEspace(comp2) <> "" ALORS
      	si sansespace(comp1) = sansespace(comp2) alors
      		tag2 ="1"
      	sinon
      		tag2 ="2"
      	FIN
      FIN
      
      //
      SI SansEspace(comp3) <> "" ALORS
      	//	
      	SI SansEspace(comp3) = SansEspace(comp2) ALORS
      		tag3 = tag2
      	SINON si SansEspace(comp3) = SansEspace(comp1) alors
      		tag3 = tag1
      	sinon si tag1 = tag2 alors
      		tag3 = 2
      	sinon 
      		tag3 = 3		
      	fin
      	//	
      FIN
      
      tag = tag1+tag2+tag3
      si tabCombine[tag] = "" alors
      	Erreur("Mauvaise combinaison de verre !!!")
      	Reprisesaisie(CDCOMPOSANT1)
      FIN
      IdThermos est un entier = getallthermostype(tabCombine[tag],comp1,comp2,comp3)
      
      renvoyer IdThermos
      
      
      
      
      
     type : 458752
   -
     name : getallthermostype
     procedure_id : 1787153385291089283
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] getallthermostype (<ltabcombine> est chaîne, <comp1>, <comp2>, <comp3>)
      //
      // Paramètres :
      //	ltabcombine (chaîne) : <indiquez ici le rôle de Param1>
      //	comp1 : <indiquez ici le rôle de comp1>
      //	comp2 : <indiquez ici le rôle de comp2>
      //	comp3 : <indiquez ici le rôle de comp3>
      // Valeur de retour :
      // 	Type indéterminé : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      //	reqsql (source de données) : <indiquez ici le rôle de reqsql>
      PROCEDURE getallthermostype(ltabcombine est une chaine,comp1,comp2,comp3)
      cb1,cb2,cb3 sont des chaines
      lcombine est un tableau de chaines 
      ChaîneVersTableau(ltabcombine,lcombine,",")
      reqsql est une source de données
      txtsqltmp est une chaine
      txtsql est une chaine = [
      select pecleunik,ennumero,endescription from persoens where persoens.encomposant1 = '%1' and
      persoens.encomposant2 = '%2' and
      persoens.encomposant3 = '%3' and
      persoens.enactif = 1 and 
      persoens.enfabrication = 0
      and persoens.enverreunite = 0
      Order by enPrior desc
      ]
      //
      
      pour chaque _combine de lcombine
      	cb1 = {"comp"+_combine[[1]]}
      	cb2 = {"comp"+_combine[[2]]}
      	si taille(_combine) = 3 alors
      		cb3 = {"comp"+_combine[[3]]}
          sinon 
          	cb3 = ""
      	FIN
      	
      	txtsqltmp = ChaîneConstruit(txtsql,cb1,cb2,cb3)
      	si HExécuteRequêteSQL(reqsql,hRequêteDéfaut,txtsqltmp) alors
      		selon hnbenr(reqsql)
      		cas 0
      		cas 1
      			hlit(reqsql,1)
      			renvoyer reqsql.pecleunik
      		autre cas
      			hlitpremier(reqsql)
      			renvoyer reqsql.pecleunik
      			//renvoyer ouvre(selectThermos,reqsql)
      		FIN
      	sinon
      		erreur("pas bon")	
      	FIN
      	
      FIN
      
      renvoyer 0
      
      
     type : 458752
   -
     name : calculTotalCommandeAvecTaxe
     internal_properties : CQAAAAkAAAB050bnkauTKC15b9XWiWLhdJkuT+KnjabmHBYXqMDAVhADpuWToG3emxvAEHfhA2/mAxOOxzvdGRYc4/HMiGEekHj2
     procedure_id : 1797610264854609850
     type_code : 14
     code : |1+
      Procédure calculTotalCommandeAvecTaxe(NoCommande est un entier)
      totalquantite est un reel = 0
      _totalcommande est un reel = 0
      lbonlivraison est un booleen
      _mult est un entier 
      tottps est un reel
      tottvq est un reel
      totalLigne est un reel
      lQteAjuste est un reel
      //SI MODIF ALORS
      
      
      RequeteCommandePourLimite.PIdClient = Null
      RequeteCommandePourLimite.pNoComm = NoCommande
      si pas HExécuteRequête(RequeteCommandePourLimite)  ALORS
      	erreur("Erreur lors de l'exécution de la requete")
      	renvoyer 0
      FIN
      
      
      
      
      
      Pour TOUT RequeteCommandePourLimite 
      	totalLigne = 0
      	lbonlivraison = (RequeteCommandePourLimite.FPREPARATION = "B" )
      	lQteAjuste = lbonlivraison ? 1 sinon requetecommandepourlimite.fdqteafacturer / requetecommandepourlimite.fdqte
      	_mult = requetecommandepourlimite.fatypedocument = 2 ? -1 sinon 1
      	selon requetecommandepourlimite.ftype
      		cas 1
      			totalLigne+=((arrondi(requetecommandepourlimite.fdprixtotal,2)+arrondi(requetecommandepourlimite.surchargeenergie,2)) ) + ((requetecommandepourlimite.FDextra10X+requetecommandepourlimite.FDextra5x))
      		cas 2
      			totalLigne+=((arrondi(requetecommandepourlimite.fdprixtotal,2)+arrondi(requetecommandepourlimite.surchargeenergie,2)) ) + ((requetecommandepourlimite.FDextra10X+requetecommandepourlimite.FDextra5x))
      		cas 3
      			totalLigne+=(arrondi(requetecommandepourlimite.fdprixtotal,2)) 
      		cas 4
      			totalLigne+=(arrondi(requetecommandepourlimite.fdprixtotal,2)) 
      			si requetecommandepourlimite.fpeinture alors
      				totalLigne+=(arrondi(requetecommandepourlimite.fTotalPeinture,2)) * requetecommandepourlimite.fdqteafacturer
      			fin
      		cas 5
      			totalLigne+=(arrondi(requetecommandepourlimite.fdprixtotal,2)) 
      
      	FIN
      	tottps = Arrondi(totalLigne * RequeteCommandePourLimite.fatps / 100 ,2)
      	tottvq = Arrondi(totalLigne * RequeteCommandePourLimite.fatvq / 100 ,2)
      	
         _totalcommande+= (( totalLigne + tottps + tottvq ) * _mult) 
      fin		 
      
      
      renvoyer _totalcommande
      
      
      
      
     type : 458752
