    name : BTN_CALCULENERGIE
    identifier : 0x514f7ee56871c7af
    internal_properties : 
    properties :
     x : 737
     y : 14
     width : 24
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         nombre est un entier
         j est un entier = 1
         b_bonlivraison est un booleen = faux
         dDemarcationSoumission est une date
         
         fposition est un entier = hsauveposition("Facture")
         si acso_message("Question","Recalculer la surcharge d'énergie de toutes les commandes","OuiNon") = idyes alors
         	saisie("Recalculer les soumissions dont la date est supérieure à ",dDemarcationSoumission)
         	
         	//hinfogene("Facture")
         	nombre = hnbenr(facture)
         	ouvrefille("FENJAUGE","Recalcul de la surcharge d'énergie")
         	hlitpremier("Facture","fanumero")
         	tantque pas HEnDehors()
         		si facture.fatypedocument <> 3 _ou_ (Facture.fatypedocument = 3 et facture.fadate > dDemarcationSoumission)  alors 
         			multitache(50)
         			execute("fenjauge.progression",j/nombre * 100)
         			message(facture.fanumero)
         			recalculenergie(Facture.fanumero)
         		fin
         			hlitsuivant("Facture","fanumero")
         			j++
         	FIN
         	ferme("FENJAUGE")
         	hretourposition(fposition)
         sinon	
         	
         	recalculenergie(facture.fanumero)
         fin
         
        type : 18
      -
        type : 161
        enabled : false
