        -
          name : CDPRIXUPIED
          identifier : 0x514f7ee555d8c7af
          internal_properties : 
          properties :
           x : 455
           y : 131
           width : 124
           height : 23
          type : 2
          code_elements :
           type_code : 3
           p_codes :
            -
              code : |1-
               
               //si commandetrn.fdspecdim alors
               // calculprixdim()
               //fin
               SELON gclconfig.m_nAffichageCoutantOuTotal
               	//selon config.AffichageCoutantOuTotal
               	cas 0,1
               		si commandetrn.facalcul = 1 alors
               			LibelléPrixAnglais = NumériqueVersChaine(commandetrn.CDPRIXUPIED, "9,2f")
               		sinon
               			//			LibelléPrixAnglais = NumériqueVersChaîne(commandeTRN.CDPRIXUPIED / config.conversionam, "9,2f")
               			LibelléPrixAnglais = NumériqueVersChaîne(commandeTRN.CDPRIXUPIED / gclconfig.m_rConversionam, "9,2f")
               			
               		FIN
               	autres cas
               		
               fin
               
               ValeurPrixUnitaire = MoiMême
              type : 15
            -
              code : |1-
               
               //SI PAS MoiMême = ValeurPrixUnitaire ALORS
               lasurface est un reel
               ladimension est un reel
               ecranversfichier("commandetrn","fdetail")
               si  pas (sansespace(cdcomposant1) = "" et ...
               	sansespace(cdcomposant2) = "" et ...
               	sansespace(cdcomposant3) = "")	alors
               	
               	si commandetrn.CdSurfaceFacture <> 0 alors
               		lasurface = commandetrn.CdSurfaceFacture
               	sinon	
               		lasurface = calcul_surface(commandetrn.facalcul)
               		si lasurface < surface_minimum alors
               			lasurface = surface_minimum
               		FIN
               	fin 
               	si pas commandetrn.FDIntercalaire alors
               		SELON client.CImpressionAngMet
               			CAS 0,1
               				SI commandetrn.FACALCUL = 1 ALORS
               					commandetrn.cdprixu = commandetrn.cdprixupied * lasurface 
               					commandetrn.cdprixtot = (commandetrn.cdprixu)  * commandetrn.cdqte
               					trdetail.fdprixupiedfacture = arrondi(commandetrn.CDPRIXUPIED,2)
               					
               				SINON
               //					commandeTRN.CdPRIXU = Arrondi(commandeTRN.CDPRIXUPIED  / config.conversionam,2) * lasurface
               					commandeTRN.CdPRIXU = Arrondi(commandeTRN.CDPRIXUPIED  / gclconfig.m_rconversionam,2) * lasurface
               					commandetrn.cdprixtot =(commandetrn.cdprixu)  * commandetrn.cdqte
               					trdetail.fdprixupiedfacture = Arrondi(commandeTRN.CDPRIXUPIED/gclconfig.m_rconversionam,2)
               //					trdetail.fdprixupiedfacture = Arrondi(commandeTRN.CDPRIXUPIED/config.conversionam,2)
               				FIN
               			CAS 2	
               				SI commandetrn.FACALCUL = 2 ALORS
               					commandetrn.cdprixu = commandetrn.cdprixupied * lasurface 
               					commandetrn.cdprixtot = (commandetrn.cdprixu)  * commandetrn.cdqte
               					trdetail.fdprixupiedfacture = arrondi(commandetrn.CDPRIXUPIED,2)
               				SINON
               					
               //					commandeTRN.CdPRIXU = Arrondi(commandeTRN.CDPRIXUPIED  * config.conversionam,2) * lasurface
               					commandeTRN.CdPRIXU = Arrondi(commandeTRN.CDPRIXUPIED  * gclconfig.m_rconversionam,2) * lasurface
               					commandetrn.cdprixtot = (commandetrn.cdprixu)* commandetrn.cdqte
               					trdetail.fdprixupiedfacture = Arrondi(commandeTRN.CDPRIXUPIED*gclconfig.m_rconversionam,2)
               //					trdetail.fdprixupiedfacture = Arrondi(commandeTRN.CDPRIXUPIED*config.conversionam,2)
               				FIN
               				
               			CAS 3              // SELON LA COMMANDE
               				commandetrn.cdprixu = commandetrn.cdprixupied * lasurface 
               				commandetrn.cdprixtot = (commandetrn.cdprixu) * commandetrn.cdqte
               		FIN
               	sinon
               		ladimension = calcul_dimension(commandetrn.facalcul,lasurfaceanglais,lasurfacemetrique,2)
               		commandetrn.cdprixu = commandetrn.cdprixupied * arrondi(ladimension,2) 
               		commandetrn.cdprixtot = arrondi(commandetrn.cdprixu,2)  * commandetrn.cdqte
               		trdetail.fdprixupiedfacture = commandetrn.CDPRIXUPIED
               	fin
               	
               	si commandetrn.casesurchargeenergie alors
               		si pas commandetrn.FDIntercalaire alors
               			commandetrn.surchargeenergie = arrondi(commandetrn.cdqte*(commandetrn.cdprixu+commandetrn.FDextra10X+commandetrn.FDextra5x),2)...
               			* surchargebase / 100 //+ ...
               		sinon
               			commandetrn.surchargeenergie = 0
               		fin
               		
               	sinon
               		commandetrn.surchargeenergie = 0
               	fin
               	
               sinon
               	si commandetrn.cdverreunite alors
               		si commandetrn.CdSurfaceFacture <> 0 alors
               			lasurface = commandetrn.CdSurfaceFacture
               		sinon
               			lasurface = calcul_surface(commandetrn.facalcul)
               			si lasurface < surface_minimum alors
               				lasurface = surface_minimum
               			FIN
               		fin
               		
               		lasurface = arrondi(lasurface,2)
               		SELON client.CImpressionAngMet
               			CAS 0
               				SI commandetrn.FACALCUL = 1 ALORS
               					commandetrn.cdprixu = commandetrn.cdprixupied * lasurface 
               					commandetrn.cdprixtot = commandetrn.cdprixu  * commandetrn.cdqte
               				SINON
               //					commandeTRN.CdPRIXU = Arrondi(commandeTRN.CDPRIXUPIED  / config.conversionam,2) * Max(lasurfaceanglais,surface_minimuminverse) 
               					commandeTRN.CdPRIXU = Arrondi(commandeTRN.CDPRIXUPIED  / gclconfig.m_rconversionam,2) * Max(lasurfaceanglais,surface_minimuminverse) 
               					commandetrn.cdprixtot = commandetrn.cdprixu  * commandetrn.cdqte
               				FIN
               			CAS 1
               				SI commandetrn.FACALCUL = 1 ALORS
               					commandetrn.cdprixu = commandetrn.cdprixupied * lasurface 
               					commandetrn.cdprixtot = commandetrn.cdprixu  * commandetrn.cdqte
               					trdetail.fdprixupiedfacture = arrondi(commandetrn.CDPRIXUPIED,2)
               				SINON
               					
               //					commandeTRN.CdPRIXU = Arrondi(commandeTRN.CDPRIXUPIED  / config.conversionam,2) * Max(lasurfaceanglais,surface_minimuminverse) 
               					commandeTRN.CdPRIXU = Arrondi(commandeTRN.CDPRIXUPIED  / gclconfig.m_rconversionam,2) * Max(lasurfaceanglais,surface_minimuminverse) 
               					commandetrn.cdprixtot = commandetrn.cdprixu  * commandetrn.cdqte
               //					trdetail.fdprixupiedfacture = Arrondi(commandeTRN.CDPRIXUPIED/config.conversionam,2)
               					trdetail.fdprixupiedfacture = Arrondi(commandeTRN.CDPRIXUPIED/gclconfig.m_rconversionam,2)
               				FIN
               			CAS 2	
               				SI commandetrn.FACALCUL = 2 ALORS
               					commandetrn.cdprixu = commandetrn.cdprixupied * lasurface 
               					commandetrn.cdprixtot = commandetrn.cdprixu  * commandetrn.cdqte
               					trdetail.fdprixupiedfacture = arrondi(commandetrn.CDPRIXUPIED,2)
               				SINON
               //					commandeTRN.CdPRIXU = Arrondi(commandeTRN.CDPRIXUPIED  * config.conversionam,2) * Max(lasurfacemetrique,surface_minimuminverse) 
               					commandeTRN.CdPRIXU = Arrondi(commandeTRN.CDPRIXUPIED  * gclconfig.m_rconversionam,2) * Max(lasurfacemetrique,surface_minimuminverse) 
               					commandetrn.cdprixtot = commandetrn.cdprixu  * commandetrn.cdqte
               //					trdetail.fdprixupiedfacture = Arrondi(commandeTRN.CDPRIXUPIED*config.conversionam,2)
               					trdetail.fdprixupiedfacture = Arrondi(commandeTRN.CDPRIXUPIED*gclconfig.m_rconversionam,2)
               				FIN
               				
               			CAS 3
               				commandetrn.cdprixu = commandetrn.cdprixupied * lasurface 
               				commandetrn.cdprixtot = commandetrn.cdprixu  * commandetrn.cdqte
               		FIN
               		
               		si commandetrn.casesurchargeenergie alors
               			si pas commandetrn.FDIntercalaire alors
               				commandetrn.surchargeenergie = commandetrn.cdqte*commandetrn.cdprixu  * surchargeverreunite / 100
               			sinon
               				commandetrn.surchargeenergie = 0
               			fin
               			
               		sinon
               			commandetrn.surchargeenergie = 0
               		fin
               	sinon
               		si pas commandetrn.typedeproduit = "Peinture" alors
               			commandetrn.cdprixu = commandetrn.cdprixupied  
               		sinon
               			
               			//ladimension = calcul_dimension(commandetrn.facalcul,lasurfaceanglais,lasurfacemetrique,invent.iUniteMesure) 
               			ladimension = commandetrn.CdSurfaceFacture
               			selon invent.iUniteMesure
               				cas 2
               					commandetrn.cdprixu = commandetrn.cdprixupied  * ladimension
               				cas 3
               					commandetrn.cdprixu = commandetrn.cdprixupied  * ladimension
               					
               			FIN
               		fin		
               	fin
               	
               	commandetrn.cdprixtot = commandetrn.cdqte * commandetrn.cdprixu
               	
               FIN
               ExécuteTraitement(fdextraforme,trtSortie)
               calculenergieligneencours()
               si moimeme..Modifié alors
               	intPrixmodifie = vrai
               	ExécuteTraitement(intPrixmodifie,trtModification)
               FIN
               selon gclConfig.m_nAffichageCoutantOuTotal 
               	//	selon config.AffichageCoutantOuTotal
               	cas 0,1
               		si commandetrn.facalcul = 1 alors
               			LibelléPrixAnglais = NumériqueVersChaine(commandetrn.CDPRIXUPIED, "9,2f")
               		sinon
               //			LibelléPrixAnglais = NumériqueVersChaîne(commandeTRN.CDPRIXUPIED / config.conversionam, "9,2f")
               			LibelléPrixAnglais = NumériqueVersChaîne(commandeTRN.CDPRIXUPIED / gclconfig.m_rconversionam, "9,2f")
               		FIN
               	autre cas
               fin
               //FIN
               
               ////////////////////////////////////////////////////////////////////////////////////////////////
               commandeTRN.FDextra5x = 0
               commandeTRN.FDextra10X = 0
               SI lexception10 ALORS
               	//			commandeTRN.FDextra10X = Arrondi(commandeTRN.CdPRIXU * config.Exception10 / 100,2)
               	commandeTRN.FDextra10X = Arrondi(commandeTRN.CdPRIXU * gclConfig.m_rException10 / 100,2)
               	commandeTRN.FDextra5x = 0
               FIN
               SI lexception5 ALORS
               	//			commandeTRN.FDextra5x = Arrondi(commandeTRN.CdPRIXU * config.Exception5 / 100,2)
               	commandeTRN.FDextra5x = Arrondi(commandeTRN.CdPRIXU * gclConfig.m_rException5 / 100,2)
               	commandeTRN.FDextra10X = 0
               FIN
               /////////////////////////////////////////////////////////////////////////////////////////////////
               
               
               
               si cdcarrelage = vrai et ChampEnCours() = "CDPRIXUPIED" alors
               	commande_carrelage..etat = actif; commande_carrelage..Visible=Vrai
               	si pas dmodif alors ExécuteTraitement(commandetrn.fddemicarrelage,trtModification)
               	reprisesaisie("cdnumcarr")
               fin
              type : 16
            -
              type : 276
              enabled : false
            -
              type : 277
              enabled : false
            -
              type : 278
              enabled : false
            -
              type : 338
              enabled : false
            -
              type : 339
              enabled : false
            -
              code : |1-
               bPrixUnitaireThermos=vrai
               si cdcarrelage = vrai et ChampEnCours() = "CDPRIXUPIED" alors
               	//calcul_prix_carr()
               fin
