     type : 458752
   -
     name : miseajourfacture
     procedure_id : 5859041162685761345
     type_code : 14
     code : |1+
      Procédure miseajourfacture()
      bEnregraye est un booleen 
      bEnregactif est un booleen
      sNumcommande est une chaine
      sLigcommande est une chaine
      clederecherche est une chaine
      i est un entier = 0
      //totaldelacommande est un reel double = 0
      //hassigne("aliasdt",frepencours())
      fsurchargepeinture = 0
      aumoinsunelignepeinture = faux
      gCarrelagePeinture = faux
      hdesactivefiltre("trdetail")
      
      hlitdernier("trdetail","fdcle")
      
      //Code WinDev 5.5 remplacé par la migration :
      //tantque pas h.endehors
      tantque pas HEnDehors()
      	si trdetail.trancienneligne <> 0 alors
      		//hconvertl(numcommande,trdetail.fdnocomm)
      		//hconvertl(ligcommande,trdetail.trancienneligne)
      		clederecherche = hconstruitvalcle(fdetail,fdcle,trdetail.fdnocomm,trdetail.trancienneligne)
      		//Code WinDev 5.5 remplacé par la migration :
      		//		hlitrecherchebloque("fdetail","fdcle",numcommande+ligcommande)	
      		//		HLitRecherchePremier("fdetail","fdcle",numcommande+ligcommande,HBlocageEcriture+hGénérique)	
      		hlitrecherche(fdetail,fdcle,clederecherche)
      		//Code WinDev 5.5 remplacé par la migration :
      		//		si pas h.endehors et h.trouve alors
      		si pas HEnDehors() et HTrouve() alors
      			//Code WinDev 5.5 remplacé par la migration :
      			//			si pas hdejabloque() alors
      			si pas HErreurBlocage() alors
      				si pas trdetail.traye alors	
      					remplir_fdetail()
      					si gImpressionFeuilleTravail = 2 alors
      						CAlculCarrelage()
      					fin
      					hmodifie(fdetail)
      					si chargetrsp alors
      						totaldelacommande+=calcultotal(trdetail.ftype)	   
      					fin		   
      					//Code WinDev 5.5 remplacé par la migration :
      					//					si hdoublon() alors
      					si HErreurDoublon() alors
      						info("doublon")
      					FIN
      				sinon
      					hsupprime("fdetail")
      				fin		
      			FIN
      
      		fin
      	sinon
      
      		si pas trdetail.traye alors
      			hraz(fdetail)
      			remplir_fdetail()
      			si gImpressionFeuilleTravail = 2 alors
      				CAlculCarrelage()
      			fin
      			hajoute(fdetail)
      			si chargetrsp alors
      				totaldelacommande+=calcultotal(trdetail.ftype)	   
      			fin		   
      		fin
      
      	fin
      	hlitprecedent("trdetail","fdcle")	
      FIN
      hactivefiltre("trdetail")
      
      //activefiltre()
      
      si aumoinsunelignepeinture  alors
      	facture.fpeinture = 1
      sinon si gCarrelagePeinture
      	facture.fpeinture = 2
      
      sinon
      	facture.fpeinture = 0
      FIN
      
      si CaseSurchargePeinture  alors
      	si fsurchargepeinture < client.cminimumPeinture et aumoinsunelignepeinture alors
      //		Facture.NoGlSurchargePeinture = config.NoGlPeinture
      		Facture.NoGlSurchargePeinture = gclconfig.m_sNoGlPeinture
      		facture.fsurchargepeinture = client.cminimumPeinture - fsurchargepeinture
      	sinon
      		facture.fsurchargepeinture = 0		
      	FIN
      sinon
      	facture.fsurchargepeinture = 0		
      fin
     type : 458752
   -
     name : page2_commande
     procedure_id : 5859041163203430209
     type_code : 14
     code : |1+
      Procédure page2_commande()
      XPOSITION EST UN ENTIER 
      //SI (ajout _ET_ gmessageajout) _OU_ (modif _ET_ gmessagemodification) ALORS
      //	Ouvre(FenMessageClient)
      //	
      //FIN
      MaFenetre..Plan=2
      VerifieAffichage()
      
      entete..etat = grisé; entete..Visible=Vrai
      EnteteModifiable..etat = actif;EnteteModifiable..visible = vrai
      commandetrn.reference..etat = grisé
      si commandetrn.commandecredit = 2 alors
      	commandetrn.fanocommande..visible = faux
      	commandetrn.fanojob..visible = faux
      	
      sinon
      	commandetrn.reference..visible = faux
      FIN
      commandetrn.fclient..etat = grisé
      commandetrn.commandecredit..etat = grisé
      modeaffichage = "Fiche"
      commandeTRN..Titre = "Commande # "+commandeTRN.fanumero
      si modif alors
      
          hinfogene("Facture")
          hlit("facture",h.numenr)	
      	ecranversfichier("commandetrn","facture")
      	facture.fasecteur = commandetrn.combo_secteur[commandetrn.combo_secteur]
      	hmodifie("Facture")
      	si herreurdoublon() alors
      		
      	FIN
          activefiltre()
      	tableaffiche("TABLE_1",taDebut)
      	reprisesaisie("table_1")
      sinon	
          facture.fasecteur = commandetrn.combo_secteur[commandetrn.combo_secteur]
          activefiltre()
          tableaffiche("TABLE_1",taDebut)
          ExecuteTraitement("commandetrn.btn_ajout_det",TRTclic)
      FIN
      
