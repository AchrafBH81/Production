          type : 6
          controls : []
          code_elements :
           type_code : 6
           p_codes :
            -
              code : |1+
               si dmodif ou ajout alors
               	si moimeme = 1 alors
               		fNoPeintureIntérieur..etat = actif
               		cssTypePeinture1..etat = actif
               	sinon
               		libelleNbcarreauinterieur = ""
               		fNoPeintureIntérieur = ""
               		fDescPeintureInterieure = ""
               		fNoPeintureIntérieur..etat = grise
               		cssTypePeinture1..etat = grise
               
               	FIN
               	ExécuteTraitement(fNoPeintureExtTout,trtEntrée)
               	ExécuteTraitement(fNoPeintureExtTout,trtSortie)
               	fin
               
               
              type : 17
        -
          name : fNoPeintureExtTout
          identifier : 0x514f7ee5039fc755
          internal_properties : 
          properties :
           x : 113
           y : 13
           width : 119
           height : 24
          type : 2
          code_elements :
           type_code : 3
           p_codes :
            -
              code : |1+
               lNoPeintureOriginale = moimeme
              type : 15
            -
              code : |1+
               lextracouleur est un reel = 0
               si sansespace(moimeme) <> "" alors
               
               	si hlitrecherche(fcouleur,noCouleur,moimeme) alors
               		si client.CLangue=1 alors fdescpeintureExtTout=fcouleur.DescriptionCouleur sinon fdescpeintureExtTout=fcouleur.DescriptionCouleura
               	sinon
               		ACSO_message("Erreur","Couleur inexistante","Erreur") 
               		moimeme = ""
               		reprisesaisie()
               	fin
               
               	si (pas dmodif ou (lNoPeintureOriginale <> moimeme)) _et_ pas bprixcarreau1peinture ALORS
               		fPrixCarreauPeinture= fPrixCarreauPeintureoriginal+trouveExtraPeinture(commandetrn.fclient,moimeme)
               	
               		
               	fin
               	
               	selon cssTypePeinture
               		cas 1
               			libelleNbCarreauExtTlt = "1 X "+NOMBRE_DE_CARREAU+" carreaux"
               			Ftotalcarreaupeinture=NOMBRE_DE_CARREAU
               			fTotalPeinture1 = Ftotalcarreaupeinture * fPrixCarreauPeinture
               			si pas sansespace(fNoPeintureIntérieur) = "" alors
               				fTotalPeinture2 = Ftotalcarreaupeinture1 * fPrixCarreauPeinture1
               			fin
               
               
               		cas 2
               			libelleNbCarreauExtTlt = "2 X "+NOMBRE_DE_CARREAU+" carreaux"
               			Ftotalcarreaupeinture=NOMBRE_DE_CARREAU*2
               			fTotalPeinture1 = Ftotalcarreaupeinture * fPrixCarreauPeinture
               			fTotalPeinture2 = 0
               			Ftotalcarreaupeinture1 = 0
               			fPrixCarreauPeinture1 = 0
               	FIN
               sinon
               	Ftotalcarreaupeinture=0
               	//	si pas sansespace(fNoPeintureIntérieur) = "" alors
               	//		Ftotalcarreaupeinture=NOMBRE_DE_CARREAU
               	//	FIN
               	fTotalPeinture1 = 0
               	fdescpeintureExtTout = ""
               	libelleNbCarreauExtTlt = ""
               FIN
               ftotalpeinture = ftotalpeinture1+ftotalpeinture2
               
              type : 16
