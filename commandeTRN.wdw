           width : 95
           height : 24
          type : 2
          code_elements :
           type_code : 3
           p_codes :
            -
              code : |1+
               
               
              type : 15
            -
              code : |1+
               sLindex est un chaine
               //selon gFormatFacture
               //	cas 0,1
               //		hlitrecherche(intercal,ispacerinex,val(MOIMEME))
               //		si HEnDehors() ou pas HTrouve() alors
               //			HLITRECHERCHE(intercal,idescalu,MOIMEME)
               //			si HEnDehors() ou pas HTrouve() alors
               //				commandetrn.fdcommentaire = ""
               //				Erreur("Intercalaire inexistant,effectuez un autre choix")			
               //				reprisesaisie()
               //			sinon
               //				commandetrn.fdcommentaire = intercal.icommentaire	
               //			FIN  
               //		sinon
               //			commandetrn.fdcommentaire = intercal.icommentaire	
               //			
               //		FIN
               //	cas 2
               		si commandeTRN.COMMANDECREDIT <> 3 _ou_	(commandetrn.COMMANDECREDIT = 3 _et_ sansespace(commandetrn.dfini) <> "") alors
               			
               			si pas hlitrecherche(IntercalaireCouleurDimensions,IDIntercalaireCouleursnumero,...
               				hconstruitvalcle(IntercalaireCouleurDimensions,IDIntercalaireCouleursnumero,Combo_typespac,moimeme)) alors
               				Erreur("Intercalaire inexistant,effectuez un autre choix")			
               				reprisesaisie()
               				
               			fin
               		fin
               //FIN
               
               si pas commandetrn.fdintercalaire alors
               	si pas sansespace(moimeme) = "" alors
               		hlitrecherche(surchint,cleclientinter,HConstruitValClé(surchint,cleclientinter,commandetrn.fclient,commandetrn.cdespace))
               		
               		si pas HEnDehors() et HTrouve() alors
               			si commandetrn.facalcul = 1 alors
               				extraintercallaired	= surchint.smontant
               				extraintercallairet	= surchint.smontantt
               				
               			sinon
               				extraintercallaired	= surchint.smontantm
               				extraintercallairet	= surchint.smontantmt
               				
               			FIN
               		sinon
               			extraintercallaired	= 0
               			extraintercallairet	= 0
               			
               		FIN
               	sinon
               		extraintercallaired	= 0
               		extraintercallairet	= 0
               	fin
               sinon
               	extraintercallaired	= 0
               	extraintercallairet	= 0
               	CalculPrixUintercalaire(calcul_dimension(commandetrn.facalcul,lasurfaceanglais,lasurfacemetrique,2) )
               	
               fin
               epaisseurintercalaire1 = IntercalaireCouleurDimensions.DimensionI
               
               reprisesaisie(cdespace2)
