  -
    name : BTN_ANNULE
    identifier : 0x514f7ee55895c787
    internal_properties : 
    properties :
     x : 90
     y : 6
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         lemessage est une chaine
         restaure_bouton()
         si ajoutdebut alors
         	lemessage = "Voulez-vous quitter la prise de commande"
         sinon
         	lemessage = "Annuler les modifications"
         fin		
         OngletCarrelage = 1
         si acso_message("Question",lemessage,"OuiNon") = idyes alors
         
         	
         	CalendrierLivraison..X = MaFenêtre..Largeur +10
         	CalendrierLivraison..Etat =Inactif
         	
         //	htransactionannule
         //	HINFOGENE("Facture")
         	si modif alors
         		hlit("Facture",numenramodifier)
         		facture.futilise = faux
         		hmodifie(Facture,hNumEnrEnCours)
            //sinon
         //	    EcranVersFichier(commandetrn,Facture)
         //    	facture.faclient = "9999999999"
         //    	hajoute(facture)
         	sinon
         			suppressActiveTempoOrder(commandeTRN.fanocommande)
         	fin
         	
         	taille_originale_table1()
         	fiche..etat = actif; fiche..Visible=Vrai
         	si modeaffichage = "Fiche" alors
         		navigation..etat = actif; navigation..Visible=Vrai
         	sinon
         		navigation..etat = grisé; navigation..Visible=Vrai
         	fin	
         	decko..Visible=Faux
         	validation..etat = grisé; validation..Visible=Vrai
         	fleche..etat = actif
         	commandetrn.facalcul..etat = AffichageSeulement
         	commandetrn.fclient..etat = AffichageSeulement
         	commandetrn.commandecredit..etat = AffichageSeulement
         	commandetrn.reference..visible  = faux
         	fiche_det..etat = grisé
         	commandetrn.entete..etat = grisé
            GrpLivraison..etat = AffichageSeulement
         	SI PAS HNBENR(facture) = 0 ALORS
         		commandetrn.table..etat = AffichageSeulement
         	FIN
         	modif = faux
         	ajout = faux
         	commande_statut..largeur = 85
         	commande_statut..x = COMMANDE_STATUT..XInitial
         	commande_statut..libelle = "Lecture"
         	ladate = ""
         //	recherche..etat = actif; recherche..Visible=Vrai
         	hretourposition(position_fichier)
         	si modeaffichage = "Fiche" alors
         		//activefiltre()
         
         		tableaffiche("TABLE_1",taDebut)
         	FIN
         //	ExecuteTraitement("table",trtEntréeligne)
         	
         	TABLE..ETAT = AffichageSeulement; TABLE..Visible=Vrai
         	TABLE1..ETAT = AffichageSeulement; TABLE1..Visible=Vrai
         
         	//BtnChangeMesure..ETAT = INACTIF
         	GrpClientComptant..etat = inactif
         
         	MaFenetre..Plan=1
         //	onglet1[1]..etat = actif
         //	Onglet1[2]..etat = actif
         	VerifieAffichage()
         	modeaffichage = "Tableau"
         	ExécuteTraitement(TABLE,trtSélection)
           
         fin
         
        type : 18
      -
        type : 161
        enabled : false
