         // Initialisation de la requête RequeteLivraison
         //HExécuteRequête(RequeteLivraison, hRequêteDéfaut, "")
          
        type : 14
      -
        code : |1-
         //LibelléLivraison = Combo_Livraison1.lrue+" "+Combo_Livraison1.lVille
         
         si pas CaseAdresseManuelle alors
         	commandetrn.lnom = Combo_Livraison1.lNom
         	commandetrn.lRue = Combo_Livraison1.lRue
         	commandetrn.lVille = Combo_Livraison1.lVille + " " +sansespace(Combo_Livraison1.lprovince)
         	commandetrn.lCodePostal = Combo_Livraison1.lcodepostal
         	si ajout alors commandetrn.sai_note_livraison = Combo_Livraison1.lNote
         //	BTN_Note..Bulle = Combo_Livraison1.lNote
         	BTN_Note..Bulle = sai_note_livraison
         sinon
         	si ajout alors commandeTRN.sai_note_livraison = ""
         	//BTN_Note..Bulle = ""
         	BTN_Note..Bulle = sai_note_livraison
         	
         fin
          si champencours() = "Combo_Livraison1" alors Fdaterequise = ""
