   -
     name : fraistrsp
     procedure_id : 5859041163566696257
     type_code : 14
     code : |1+
      Procédure fraistrsp(totalcommande)
      valeuraretourner est un reel = 0
      	hlitrecherche("categclt","categorie",client.categorie)
      //Code WinDev 5.5 remplacé par la migration :
      //	si pas h.endehors et h.trouve alors
      	si pas HEnDehors() et HTrouve() alors
      		si categclt.catchargetransport alors
      		   	si totalcommande > categclt.catminmontant alors
      				valeuraretourner = 0
      		    sinon
      				hlitrecherche("intkilo","ikclecatnum",client.categorie+caract(0))
      //Code WinDev 5.5 remplacé par la migration :
      //                tantque client.categorie = intkilo.ikcategorie et pas h.endehors 
                      tantque client.categorie = intkilo.ikcategorie et pas HEnDehors() 
                          si client.ckilomatre >= intkilo.ikborneinferieure et client.ckilomatre <= intkilo.ikbornesuperieure alors
      					  valeuraretourner = intkilo.ikfraistransport
      					  sortir
      				    fin
      					hlitsuivant("intkilo","ikclecatnum")
      				FIN
      		    FIN
      
      	    FIN
      	FIN
      	
      
      
      renvoyer valeuraretourner
      
     type : 458752
   -
     name : griser_saisie
     procedure_id : 5859041163730536257
     type_code : 14
     code : |1+
      Procédure griser_saisie(type = 4)
      
      cdcomposant1..etat = grise; cdcomposant1..Visible=Vrai
      cdcomposant2..etat = grise; cdcomposant2..Visible=Vrai
      cdcomposant3..etat = grise; cdcomposant3..Visible=Vrai
      cdcapgaztube..etat = grise; cdcapgaztube..Visible=Vrai
      cdcarrelage..etat = grisé; cdcarrelage..Visible=Vrai
      dfini..etat = grisé; dfini..Visible=Vrai
      cdespace..etat = grisé; cdespace..Visible=Vrai
      cdespace2..etat = grisé; cdespace2..Visible=Vrai
      cdforme99..etat = grisé; cdforme99..Visible=Vrai
      cdnumcarr..etat = grisé; cdnumcarr..Visible=Vrai
      cdcarrprixuc..etat = grisé; cdcarrprixuc..Visible=Vrai
      cdprixdebasecarrelage..etat = grise; cdprixdebasecarrelage..Visible=Vrai
      //surchargeenergie..etat = grise;surchargeenergie..Visible=vrai
      Combo_typespac..etat = inactif
      BTN_FORME..etat = inactif
      fdforme..etat = grise
      
      selon type
      	cas 4
      		cdcarreauv..etat = actif; cdcarreauv..Visible=Vrai
      		si invent.isaisietotalcarreau = vrai alors
      			cdcarreauh = 1
      			cdcarreauh..etat = grisé; cdcarreauh..Visible=Vrai
      		sinon 
      			cdcarreauh..etat = actif; cdcarreauh..Visible=Vrai
      
      		fin
      		si invent.isaisiedimension = faux alors
      			cdhauteur..etat = grisé; cdhauteur..Visible=Vrai
      			cdhauteur1..etat = grisé; cdhauteur1..Visible=Vrai
      			cdlargeur..etat = grisé; cdlargeur..Visible=Vrai
      
      		fin	
      
      		cdcarrprixuc..etat = actif; cdcarrprixuc..Visible=Vrai
      		si invent.imprimecarr alors
      			fdimprimecarr..etat = actif; fdimprimecarr..Visible=Vrai
      		fin
      		cdforme99..etat = actif; cdforme99..Visible=Vrai
      		nombre_de_carreau..etat = AffichageSeulement; nombre_de_carreau..Visible=Vrai
      		cdnumcarr..etat = grisé; cdnumcarr..Visible=Vrai
      		cdprixu..etat = grisé; cdprixu..Visible=Vrai
      		btn_composant1..etat = grisé; btn_composant1..Visible=Vrai	
      		btn_composant2..etat = grisé; btn_composant2..Visible=Vrai	
      		btn_composant3..etat = grisé; btn_composant3..Visible=Vrai	
      		btn_carrelage..etat = grisé; btn_carrelage..Visible=Vrai
      
      	cas 24     // Peinture a la surface
      		
      	cas 2
      		cdcarreauv..etat = grisé; cdcarreauv..Visible=Vrai
      		cdcarreauh..etat = grisé; cdcarreauh..Visible=Vrai
      		nombre_de_carreau..etat = AffichageSeulement; nombre_de_carreau..Visible=Vrai
      		btn_composant1..etat = grisé; btn_composant1..Visible=Vrai	
      		btn_composant2..etat = grisé; btn_composant2..Visible=Vrai	
      		btn_composant3..etat = grisé; btn_composant3..Visible=Vrai	
      
      		commandetrn.fdlargeura..visible = faux
      		commandetrn.fdhauteura..visible =faux
      		cdhauteur..etat = grisé; cdhauteur..Visible=Vrai
      		cdhauteur1..etat = grisé; cdhauteur1..Visible=Vrai
      		cdlargeur..etat = grisé; cdlargeur..Visible=Vrai
      	cas 21   // unité avec dimension
      		cdcarreauv..etat = grisé; cdcarreauv..Visible=Vrai
      		cdcarreauh..etat = grisé; cdcarreauh..Visible=Vrai
      		nombre_de_carreau..etat = AffichageSeulement; nombre_de_carreau..Visible=Vrai
      		btn_composant1..Visible=Faux	
      		btn_composant2..Visible=Faux	
      		btn_composant3..Visible=Faux	
      		composant1_nom..Visible=Faux	
      		composant2_nom..Visible=Faux	
      		composant3_nom..Visible=Faux	
      		cdcomposant1..Visible=Faux	
      		cdcomposant2..Visible=Faux	
      		cdcomposant3..Visible=Faux	
      		commandetrn.fdlargeuru..etat = actif
      		commandetrn.fdhauteuru..etat = actif
      		cdhauteur..etat = grisé; cdhauteur..Visible=Vrai
      		cdhauteur1..etat = grisé; cdhauteur1..Visible=Vrai
      		cdlargeur..etat = grisé; cdlargeur..Visible=Vrai
      	cas 1
      		cdcarreauv..etat = grisé; cdcarreauv..Visible=Vrai
      		cdcarreauh..etat = grisé; cdcarreauh..Visible=Vrai
      		nombre_de_carreau..etat = AffichageSeulement; nombre_de_carreau..Visible=Vrai
      		btn_composant1..etat = grisé; btn_composant1..Visible=Vrai	
      		btn_composant2..etat = grisé; btn_composant2..Visible=Vrai	
      		btn_composant3..etat = grisé; btn_composant3..Visible=Vrai	
      
      // verre a l'unite
      	cas 11
      		cdcarreauv..etat = grisé; cdcarreauv..Visible=Vrai
      		cdcarreauh..etat = grisé; cdcarreauh..Visible=Vrai
      		nombre_de_carreau..etat = AffichageSeulement; nombre_de_carreau..Visible=Vrai
      		btn_composant1..etat = grisé; btn_composant1..Visible=Vrai	
      		btn_composant2..etat = grisé; btn_composant2..Visible=Vrai	
      		btn_composant3..etat = grisé; btn_composant3..Visible=Vrai	
      		//BtnSurface..etat=grisé; BtnSurface..Visible=vrai
      		//CdSurfaceFacture..etat=grisé; CdSurfaceFacture..Visible=vrai
      		//commandetrn.fdlargeura..visible = faux
      //		commandetrn.fdhauteura..visible =faux
      //		cdhauteur..etat = grisé; cdhauteur..Visible=Vrai
      //		cdhauteur1..etat = grisé; cdhauteur1..Visible=Vrai
      //		cdlargeur..etat = grisé; cdlargeur..Visible=Vrai
      		Combo_typespac..etat=grisé
      		Combo_typespac=""
      	cas 3
      		btn_composant1..etat = grisé; btn_composant1..Visible=Vrai
      		dfini = ""
      		CDESPACE = ""
      		CDESPACE2 = ""
      		Combo_typespac = 0
      FIN
      
     type : 458752
   -
     name : maj_forme
     procedure_id : 5859041162554754881
     type_code : 14
     code : |1+
      Procédure maj_forme(action)
      
      //si action alors
      //	trdetail.fdw		= ""
      //	trdetail.fdw1		= ""
      //	trdetail.fdw2		= ""
      //	trdetail.fdh		= ""
      //	trdetail.fdh1		= ""
      //	trdetail.fdh2		= ""
