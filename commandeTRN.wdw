  -
    name : BTN_PREMIER
    identifier : 0x514f7ee52a0cc769
    internal_properties : 
    properties :
     x : 308
     y : 6
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         restaure_bouton()
         selon onglet1
         	cas 1
         		hlitpremier(Requetetablefacture,table..RubriqueParcourue)
         		executetraitement(table,trtSélection)
         		tableaffiche(table,taCourantPremier)
         		hlitrecherche("client","numero",commandetrn.fclient)
         		fichierversecran("commandetrn","client")
         		activefiltre()
         		tableaffiche("TABLE_1",taDebut)
         		commandeTRN..Titre = " Commande # "+commandeTRN.fanumero
         	cas 2
         		hlitpremier(RequeteTableSoumission,table1..RubriqueParcourue)
         		executetraitement(table1,trtSélection)
         		tableaffiche(table1,taCourantPremier)
         		hlitrecherche("client","numero",commandetrn.fclient)
         		fichierversecran("commandetrn","client")
         		//		activefiltre()
         		tableaffiche("TABLE_1",taDebut)
         		commandeTRN..Titre = " Commande # "+commandeTRN.fanumero
         FIN
         
        type : 18
      -
        type : 161
        enabled : false
