            -
              code : |1+
               commandetrn..titre = "Gestion des commandes"
               FermerNote()
               hlitrecherche(Facture,fanumero,RequeteTablefacture.fanumero)
               //FICHIERVERSECRAN(commande,facture)
               
               Combo_Vendeur = facture.cvendeur
               Combo_Livraison1 = facture.idLivraison
               Combo_camion = facture.idcamions
               remplirComboLivraison(RequeteTablefacture.faclient)
               Affiche_facture()
               activefiltre()   
               calculTotalCommande()
               remplir_escompte(vrai)
               
               si hlitrecherche(client,numero,RequeteTablefacture.faclient) alors
               	fichierversecran(Commandetrn,client)
               	langueclient = client.CLangue
               fin	
               selon commandetrn.COMMANDECREDIT
               	cas 1
               		commandetrn.fanocommande..visible = vrai
               		commandetrn.fanojob..visible = vrai
               		commandetrn.reference..visible = faux
               		commandetrn.libelle3..visible = vrai
               		commandetrn.libellecredit..visible = faux
               		commandetrn.libelle4..visible = faux
