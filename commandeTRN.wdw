   -
     name : ProduitEstEnergiverre
     procedure_id : 1886265511465601654
     type_code : 14
     code : |1-
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] ProduitEstEnergiverre (<NumProd> est chaîne)
      //
      // Paramètres :
      //	NumProd (chaîne) : <indiquez ici le rôle de NumProd>
      // Valeur de retour :
      // 	booléen : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE ProduitEstEnergiverre(NumProd est une chaine)
      
      si hlitrecherche(persoens,ennumero,NumProd) alors
      	si persoens.encomposant1 <> "" alors
      		si hlitrecherche(invent,INUM,persoens.encomposant1) ALORS
      			si (invent.ienergieverre ou invent.ienergieverreESC) alors renvoyer vrai
      		FIN
      	FIN
      	
      	SI persoens.encomposant2 <> "" ALORS
      		SI HLitRecherche(invent,INUM,persoens.encomposant2) ALORS
      			SI (invent.ienergieverre OU invent.ienergieverreESC) ALORS RENVOYER Vrai
      		FIN
      	FIN
      	
      	SI persoens.encomposant3 <> "" ALORS
      		SI HLitRecherche(invent,INUM,persoens.encomposant3) ALORS
      			SI (invent.ienergieverre OU invent.ienergieverreESC) ALORS RENVOYER Vrai
      		FIN
      	FIN
      	
      FIN
      
      renvoyer faux
     type : 458752
