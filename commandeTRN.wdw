   -
     name : ValideCredit
     procedure_id : 2079733927911924009
     type_code : 14
     code : |1-
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      // ValideCredit ()
      //
      // Paramètres :
      //	Aucun
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE ValideCredit()
      
      SI commandeTRN.COMMANDECREDIT = 1  _ET_ ajout _ET_ Client.limiteCredit > 0 ALORS
      	SI Client.SoldeDisponible < 0 ET Client.TYpeQuestionCredit > 1 ALORS
      		Ouvre(FenMessageLimite,Client.TYpeQuestionCredit)
      		SI Client.TYpeQuestionCredit = 3 ALORS
      			SI Client.dateLimite < commandeTRN.fadate ALORS
      				RepriseSaisie(FCLIENT)
      			FIN
      		SINON SI Client.TYpeQuestionCredit = 4 ALORS
      			RepriseSaisie(FCLIENT)	
      		FIN
      	FIN
      FIN
     type : 458752
   -
     name : GetJoursLivraison
     procedure_id : 2087139567976092278
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      // GetJoursLivraison ()
      //
      // Paramètres :
      //	Aucun
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE GetJoursLivraison()
      
      ValeurJourLivraisonClient  = 0
      valeurjourlivraison   = 0
      
      SI HLitRecherche(SaisonLivraison,IDSaisonLivraison,gPeriodeLivraison) ALORS
      	valeurjourlivraison = SaisonLivraison.JoursLivraison
      FIN
      SI HLitRecherche(JourLivraisonClient,IDClientIDSaisonLivraison,[Client.IDClient,gPeriodeLivraison]) ALORS
      	ValeurJourLivraisonClient = JourLivraisonClient.JourLivraison
      FIN
      POUR i = 1 À 7
      	gJoursLivraison[i] = 0
      FIN
      
      i est entier
      si valeurjourlivraison <> 0 alors
      	POUR i = 1 À 7
      		SI valeurjourlivraison & Puissance(2,i-1) = 0 ALORS
      			gJoursLivraison[i]  = 2
      		SINON	
      			gJoursLivraison[i] = 0
      		FIN
      	FIN
      fin
      
      
      
      
      
      
      //si hlitrecherche(JourLivraisonClient,IDClientIDSaisonLivraison,[client.idclient,gPeriodeLivraison]) alors
      //jliv = JourLivraisonClient.JourLivraison
      SI ValeurJourLivraisonClient <> 0 ALORS
      	POUR i = 1 À 7
      		SI ValeurJourLivraisonClient & Puissance(2,i-1) > 0 ALORS
      			gJoursLivraison[i] = gJoursLivraison[i] <> 2 ? 1 SINON 2
      		SINON
      			gJoursLivraison[i] = gJoursLivraison[i] <> 2 ? 0 SINON 2
      		FIN
      	FIN
      	
      fin
     type : 458752
   -
     name : AfficherJourLivraisonPourUnMois
     procedure_id : 2086414367039432132
     type_code : 14
     code : |1-
      PROCEDURE AfficherJourLivraisonPourUnMois()
      
      UneDate est une date = CalendrierPosition(CalendrierLivraison)
      
      UneDate..Jour = 31
      
      LeNombreDeJour est un entier = UneDate..jour
      
      UneDate..Jour = 1
      
      //	POUR i = 1 A LeNombreDeJour
      //		UneDate..Jour = i
      //		
      //		SI gJoursLivraison[DateVersJour(UneDate)] = 1 ALORS
      //			CalendrierLivraison[UneDate]..CouleurFond = VertClair
      //		SINON si gJoursLivraison[DateVersJour(UneDate)] = 0
      //			CalendrierLivraison[UneDate]..CouleurFond = iTransparent
      //		sinon
      //			CalendrierLivraison[UneDate]..CouleurFond = igrisclair
      //			
      //		FIN
      //		
      //		
      //	FIN
      //FIN
      
      
      IdEnCours est un entier = 0
      
      POUR i = 1 A LeNombreDeJour
      	
      	
      	UneDate..Jour = i
      	IdEnCours = GetIdSaison(UneDate,GtabSaison)
      	si idencours = 0 alors continuer
      	SI EstJourFerie(UneDate) ALORS
      		CalendrierLivraison[UneDate]..CouleurFond = iRougeClair
      		CalendrierLivraison[UneDate]..Couleur = iBlanc
      		CONTINUER
      	FIN		
      	SI gJoursLivraisonClient[GtabSaison[IdEnCours].IdSaison][DateVersJour(UneDate)].jourlivraison = 2 ALORS
      		CalendrierLivraison[UneDate]..CouleurFond = iGrisClair
      		CONTINUER
      	FIN
      	SI tafrequence[GtabSaison[IdEnCours].IdSaison].Frequence > 1 ALORS
      		SI modulo(DateDifférence(PremierJourDeLaSemaine(tafrequence[GtabSaison[IdEnCours].IdSaison].DateDeReference),PremierJourDeLaSemaine(UneDate)),tafrequence[GtabSaison[IdEnCours].IdSaison].Frequence*7) <> 0
      			
      			//		si modulo(NoSemaine,Frequence) <> NoRefLocal alors
      			CalendrierLivraison[UneDate]..CouleurFond = iTransparent
      			CONTINUER
      			
      		FIN
      	FIN
      	
      	
      	
      	si pas UneDate < datesys() alors
      		SI IdEnCours <> 0 _et_ pas gJoursLivraisonClient[GtabSaison[IdEnCours].IdSaison]..vide ALORS
      			SI gJoursLivraisonClient[GtabSaison[IdEnCours].IdSaison][DateVersJour(UneDate)].jourlivraison = 1 ALORS
      				CalendrierLivraison[UneDate]..CouleurFond = VertClair
      			SINON SI gJoursLivraisonClient[GtabSaison[IdEnCours].IdSaison][DateVersJour(UneDate)].jourlivraison = 0
      				CalendrierLivraison[UneDate]..CouleurFond = iTransparent
      			SINON
      				CalendrierLivraison[UneDate]..CouleurFond = iGrisClair
      				
      			FIN
      		SINON
      			//		CalendrierLivraison[UneDate]..CouleurFond = iTransparent
      			si IdEnCours <> 0 alors
      				si GtabSaison[IdEnCours].JourLivraison[DateVersJour(UneDate)] = 0 alors
      					CalendrierLivraison[UneDate]..CouleurFond = iTransparent
      				sinon
      					CalendrierLivraison[UneDate]..CouleurFond = iGrisClair
      					
      				FIN
      			fin
      			
      		FIN
      	sinon
      		CalendrierLivraison[UneDate]..CouleurFond = iGrisClair
      	fin
      	
      	
      	
      	
      FIN
     type : 458752
