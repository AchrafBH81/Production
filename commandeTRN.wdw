               		listefichier+=lnomfichier+";"
               		
               		Sablier(Faux)
               		Ferme(FenAttentePetite)
               		//				lignedecommande  = "C:\Program Files\Adobe\Reader 8.0\Reader\acrord32.exe "+
               		
