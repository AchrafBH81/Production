      //	trdetail.fdr2		= ""
      //	trdetail.fds		= ""
      //	trdetail.fdf		= ""
      //	trdetail.fdt1		= ""
      //	trdetail.fdt2		= ""
      //	trdetail.fdt3		= ""
      //	trdetail.fdt4		= ""
