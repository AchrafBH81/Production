               oldspacer = moimeme
              type : 15
            -
              code : |1-
               //selon Combo_typespac.Stype
               //	cas 1
               //		type_intercallaire = "Inex"
               //		CDCAPGAZTUBE=remplace(remplace(CDCAPGAZTUBE,"I",""),"T","")
               //		CDCAPGAZTUBE+="I"
               //	cas 2
