    name : PAGESUIVANTE
    identifier : 0x514f7ee5723ac79b
    internal_properties : 
    properties :
     x : 716
     y : 172
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         _continuer est un booleen = faux
         nNextOrderNumber est un entier
         
         si ajout alors
         	boucle
         		nNextOrderNumber	= GetNextOrderNumber()
         		si nNextOrderNumber = 0 alors 
         			SI ACSO_message("Question","Impossible d'assigner un numéro de commande"+RC+"Essayer de nouveau","OuiNon")=IDNO ALORS 
         				reprisesaisie(fclient)
         			fin
         		sinon
         			sortir
         		fin
         	fin
         	commandetrn.fanumero = nNextOrderNumber
         	//FIN
         	//boucle
         	//	hlitpremier(config,COCLEUNIK,hBlocageLectureEcriture)
         	//	si HErreurBlocage() alors
         	//		si acso_message("Question","Impossible d'assigner un numéro de commande"+rc+"Essayer de nouveau","OuiNon")=idno alors 
         	//			_continuer = faux
         	//			sortir
         	//		fin
         	//	sinon
         	//		_continuer = vrai
         	//		sortir
         	//	fin
         	//fin
         	//
         	//si _continuer alors
         	//	boucle 
         	//		
         	//		commandetrn.fanumero = config.numcomm
         	//		config.numcomm = commandetrn.fanumero + 1
         	//		hmodifie(config,hNumEnrEnCours)
         	//		HForceEcriture(config)
         	//		si pas hlitrecherche(Facture,fanumero,commandetrn.fanumero) alors
         	//			sortir
         	//		fin
         	//	fin
         	//	hdebloquefichier(config)
         	//sinon
         	//	reprisesaisie(fclient)
         	//	
         	//fin
         fin
         si ajout ou modif alors
         	si cidclient = 0 alors 
         		erreur("vous devez sélectionner un client")
         		reprisesaisie(fclient)
         	fin
         	
         	BtnTypeSaisie..Libellé = (facalcul = 1 ? "A" SINON "M")
         	page2_commande()
         FIN
         
        type : 18
      -
        type : 161
        enabled : false
