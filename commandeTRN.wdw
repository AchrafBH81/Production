      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE ValideFini(_valeur )
      
      SI ChaîneOccurrence(_valeur,".") > 1 ALORS
      	Erreur("Donnée incorrecte")
      	reprisesaisie(commandetrn.DFINI)
      FIN
      SI ChaîneOccurrence(_valeur,"/") > 1 ALORS
      	Erreur("Donnée incorrecte")
      		RepriseSaisie(commandeTRN.DFINI)
      FIN
      
      
