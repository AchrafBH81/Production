     type : 458752
   -
     name : CAlculCarrelage
     procedure_id : 5859041163840112449
     type_code : 14
     code : |1-
      
      Procédure CAlculCarrelage(BarreDifferente = faux)
      
      i est un entier
      formule est une chaine
      rAEnlever est un reel = 0 
      nAenlevertete est un entier = 0
      sFvtcv est une chaine
      sFvtch est une chaine
      nPositionInvent est un entier
      resultatcondition est un booleen = faux
      sClederecherche est une chaine
      lTotalCarrLineaire est un entier
      EstArgon est un booleen = (position(fdetail.fcapgaztube,"Z") <> 0) 
      
      
      si sansespace(fdetail.fdnumcarr) = "" ou pas hlitrecherche(invent,INUM,fdetail.fdNumCarr) alors
      	dFinDessin(ImageCarrelage)
      	fdetail.Imagecarrelage = ImageCarrelage
      	//	HModifie(fdetail,hNumEnrEnCours)
      	pour i = 1 a 10
      		fdetail.vMarquageHC[i]=0
      		fdetail.vMarquagelC[i]=0
      		fdetail.vMarquageHs[i]=0
      		fdetail.vMarquagels[i]=0
      
      	FIN
      	retour
      FIN
      
      //C    = invent.tccadre
      NBH  = fdetail.fdcarreauh
      NBL  = fdetail.fdCarreauv
      si hlitrecherche(facture,fanumero,fdetail.fdnocomm) alors
      	si facture.facalcul = 1
      		H1   =  val(fdetail.fdhauteur) * 25.4
      		L1   = val(fdetail.fdlargeur) * 25.4
      	sinon
      		H1   =  val(fdetail.fdhauteur) * 1000
      		L1   = val(fdetail.fdlargeur) * 1000
      	fin
      
      FIN
      //ETH  = invent.tctigehor
      //ETL  = invent.tctigevert
      //lcc = val(tempo.tLargeurcontour) * 25.4
      //HCC = val(tempo.THauteurContour) * 25.4
      //HTE = arrondi(val(tempo.THauteurTete) * 25.4)
      lcc = fdetail.fdvariablex
      HCC = fdetail.fdvariablex
      HTE = fdetail.fdvariablex
      DDV = fdetail.fdddv
      DDh = fdetail.fdDDH
      dth=fdetail.fdt
      vx = fdetail.fdvariablex
      vx1 = fdetail.fdvariablex1
      
      si Position(fdetail.fcapgaztube,"T") <> 0 alors
      	ALUM = 0
      //	ICN = config.vAleurICN
      sinon si Position(fdetail.fcapgaztube,"I") = 0 et Position(fdetail.fcapgaztube,"T") = 0 alors
      //	alum = config.ValeurAlum
      	ICN = 0
      sinon
      	alum = 0	
      	ICN = 0
      FIN
      
      //ARGON = config.ValeurArgon
      ARGON = gclconfig.m_nValeurArgon
      
      //hlitrecherche(typecarr,tcdescription,invent.itypecarr)
