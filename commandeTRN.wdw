  -
    name : CDCAPGAZTUBE
    identifier : 0x514f7ee56f88c7d7
    internal_properties : 
    properties :
     x : 1167
     y : 416
     width : 50
     height : 23
    type : 2
    code_elements :
     type_code : 3
     p_codes :
      -
        code : |1+
         nbcolonne est un entier = 2
         aveccap = faux
         gazgeon = faux
         si premierefois alors
          si typedeproduit = "Verre" alors
            SI pas cdnumprod = "" alors
         //	si persoens.encap alors
         //     moimeme += "C"
         //	 nbcolonne ++
         //	FIN
         //	si persoens.engaz alors
         //	  moimeme += "Z"	
         //	  nbcolonne ++
         //	FIN
            fin
         FIN
         si nouvelleFacture alors
         // si pas commandetrn.inexalu alors
         //   moimeme += ""
         ////   alum = config.ValeurAlum
         // sinon
         //   moimeme += "I"	
         ////   alum = 0
         //fin
         nouvellefacture = faux
         fin
         
         
          moimeme..curseur = nbcolonne
          premierefois = faux
         fin
         type_intercallaire = "Aluminium"
         capillaire = faux
         
         
        type : 15
      -
        code : |1+
         j est un entier
         texteaajouter est une chaine = ""
         pour j = 1 a taille(moimeme)
         	si position("ICTZ",milieu(moimeme,j,1)) = 0 alors
         //Code WinDev 5.5 remplacé par la migration :
         //		erreur(MessTraduit(2009))		   //2009:Vous avez introduit un code incorr...
         		erreur(<§$0009§>)		   //2009:Vous avez introduit un code incorr...
                 moimeme..curseur = j
         		moimeme..fincurseur = j+1
         		reprisesaisie
            FIN
         	
         FIN
         
         pour j = 1 a taille(moimeme)
         	selon milieu(moimeme,j,1)
         	 
         	   cas "I"
                    si sansespace(commandetrn.cdnumprod) = "" alors
         //				texteaajouter = texteaajouter+ " " + SansEspace(config.texteinex) 
         				texteaajouter = texteaajouter+ " " + SansEspace(gclconfig.m_stexteinex) 
         			fin
         		   type_intercallaire = "Inex"
                cas "T"
                    si sansespace(commandetrn.cdnumprod) = "" alors
         //				texteaajouter = texteaajouter + " " + SansEspace(config.textecapillaire) 
         				texteaajouter = texteaajouter + " " + SansEspace(gclconfig.m_stextecapillaire) 
         			fin
                    capillaire = vrai
                cas "Z"
         //           si sansespace(commandetrn.cdnumprod) = "" alors
         //			texteaajouter = texteaajouter + " " + SansEspace(config.textegaz) 
         			texteaajouter = texteaajouter + " " + SansEspace(gclconfig.m_stextegaz) 
         			//	       fin
         	       gazgeon = vrai
                cas "C"
                    si sansespace(commandetrn.cdnumprod) = "" alors
         //				texteaajouter = texteaajouter + " " + SansEspace(config.textecap) 
         				texteaajouter = texteaajouter + " " + SansEspace(gclconfig.m_stextecap) 
         			fin
         		   aveccap = vrai
         	   autres cas
               FIN
         FIN
         
         commandetrn.cddesc = sansespace(descriptionoriginale) + texteaajouter
        type : 16
      -
        type : 276
        enabled : false
      -
        type : 277
        enabled : false
      -
        type : 278
        enabled : false
      -
        type : 338
        enabled : false
      -
        type : 339
        enabled : false
