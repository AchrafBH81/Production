     type_code : 14
     code : |1-
      Procédure activefiltre()
      nLavue est un entier  
      sLegraph est une chaine
      positiontable est une chaine = TableSauvePositionEtSélection(TABLE_1)
      
      
      hconvertl(cledebut,commandetrn.fanumero)
      hconvertl(clefin,commandetrn.fanumero)
      cledebut = cledebut+caract(0)
      clefin = clefin+caract(255)
      reponse=HFiltre(NomFicTab,"fdcle",cledebut,clefin)
      //   hlitpremier("trdetail","fdcle")
      //   tantque pas HEnDehors()
      //      hsupprime("trdetail")
      //	  hlitsuivant("trdetail","fdcle")	  
      //   FIN
      
      HCréationSiInexistant("trdetail")
      hsupprimetout(trdetail)
      
      hlitpremier("fdetail","fdcle")
      
      //Code WinDev 5.5 remplacé par la migration :
      //   tantque pas h.endehors
      tantque pas HEnDehors()
      	remplir_trdetail()
      	hajoute("trdetail")
      	si HErreurdoublon() alors
      		
      	FIN
      	hlitsuivant("fdetail","fdcle")	 
      FIN
      hfiltre("trdetail","fdcle",cledebut,clefin,"trdetail.traye = 0")
      tableaffiche(TABLE_1,taDebut)
      
      hdesactivefiltre(nomfictab)
      
      si Facture.futilise alors
      	btn_etatbarre..etat = actif; btn_etatbarre..Visible=Vrai
      	BTN_ETATBARRE..x = BTN_ETATBARRE..XInitial
      	btn_etatdebarre..Visible=Faux
          
      sinon
      	btn_etatbarre..Visible=Faux
      	btn_etatdebarre..etat = actif; btn_etatdebarre..Visible=Vrai	
      	BTN_ETATdeBARRE..X = BTN_ETATdeBARRE..XInitial 
      
      FIN
      
      TableRestaurePositionEtSélection(TABLE_1,positiontable)
      ExécuteTraitement(table_1,trtSélection)
     type : 458752
   -
     name : affiche_nom
     procedure_id : 5859041162806937409
     type_code : 14
     code : |1+
      Procédure affiche_nom()
      bLTypeThermos est un booleen = faux
      epaisseur = 0
      si cdcomposant1 <> "" alors
      	hlitrecherche("invent","INUM",cdcomposant1)
      	si HTrouve() alors
      		
      		selon langueclient
      			cas 0,1
      				composant1_nom  = invent.idesc
      			cas 2
      				composant1_nom  = invent.idescA
      		FIN
      		epaisseur+=invent.iepaisseur
      		produitdebase1 = invent.ipbase
      		si pas cdenergiverre alors
      			cdenergiverre  = (invent.ienergieverre OU invent.ienergieverreESC)
      		fin
      	sinon
      		composant1_nom  = <§$0002§>   //2002:Produit inexistant dans le fich...
      	FIN 
      SINON
      	composant1_nom = ""
      FIN
      si cdcomposant2 <> "" alors
      	hlitrecherche("invent","INUM",cdcomposant2)
      	si HTrouve() alors
      		selon langueclient
      			cas 0,1
      				composant2_nom  = invent.idesc
      			cas 2
      				composant2_nom  = invent.idescA
      		FIN
      		epaisseur+=invent.iepaisseur
      		produitdebase2 = invent.ipbase
      		si pas cdenergiverre alors
      			cdenergiverre  = (invent.ienergieverre OU invent.ienergieverreESC)
      		fin
      	sinon
      		composant2_nom  = <§$0002§>   //2002:Produit inexistant dans le fich...
      	FIN
      SINON
      	composant2_nom = ""
      FIN
      si cdcomposant3 <> "" alors
      	hlitrecherche("invent","INUM",cdcomposant3)
      	
      	si HTrouve() alors
      		selon langueclient
      			cas 0,1
      				composant3_nom  = invent.idesc
      			cas 2
      				composant3_nom  = invent.idescA
      		FIN
      		epaisseur+=invent.iepaisseur
      		produitdebase3 = invent.ipbase
      		si pas cdenergiverre alors
      			cdenergiverre  = (invent.ienergieverre ou invent.ienergieverreESC)
      			
      		fin
      	sinon
      		composant3_nom  = <§$0002§>   //2002:Produit inexistant dans le fich...
      	FIN
      SINON
      	composant3_nom = ""
      FIN
      
      si CDENERGIVERRE alors
      	AjouteZ()
      	
      FIN
      si position(CDCAPGAZTUBE,"Z") > 0 alors IntForceArgon = vrai sinon IntForceArgon = faux
      IntForceArgon..Etat = CDENERGIVERRE ? Grisé SINON Actif
      
      si cdnumcarr <> "" alors
      	
      	
      	si sansespace(trdetail.FDdesccarr) = "" alors
      		hlitrecherche("invent","INUM",cdnumcarr)
      		si HTrouve() alors
      			selon langueclient
      				cas 0,1
      					carrelage_nom  = invent.idesc
      				cas 2
      					carrelage_nom  = invent.idescA
      			FIN
      		sinon
      
      			CARRELAGE_NOM  = <§$0002§>
      		fin
      		
      	sinon
      		CARRELAGE_NOM = trdetail.FDdesccarr   //2002:Produit inexistant dans le fich...
      	FIN
      SINON	
      	NOMBRE_DE_CARREAU = 0
      	carrelage_nom = ""
      FIN
      
      si trdetail.FDextra10X <> 0 alors
      	commandetrn.FDextra10X..visible= vrai
      sinon
      	commandetrn.FDextra10X..visible= faux
      	
      FIN
      
      si trdetail.FDextra5X <> 0 alors
      	commandetrn.FDextra5X..visible= vrai
      sinon
      	commandetrn.FDextra5X..visible= faux
      FIN
      
      si hlitrecherche(invent,INUM,trdetail.fdnumprod) alors
      	si invent.itype = 5 alors
      		affichePeinture(vrai)
      	sinon
      		GrpComposant..visible = (BTN_VERT..Visible)
      		grpPeinture..visible = faux
      		CDDESC..Y = COMPOSANT1_nom..Y+63
      		
      	FIN
      sinon
      	si hlitrecherche(persoens,ennumero,trdetail.fdnumprod) alors
      		GrpComposant..visible = (BTN_VERT..Visible)
      		grpPeinture..visible = faux
      		CDDESC..Y = COMPOSANT1_NOM..Y+63
      		
      	FIN
      FIN
      
      commandetrn.wfw = trdetail.fdw
      commandetrn.wfw1 = trdetail.fdw1
      commandetrn.wfw2 = trdetail.fdw2
      commandetrn.wfh = trdetail.fdh
      commandetrn.wfh1 = trdetail.fdh1
      commandetrn.wfh2 = trdetail.fdh2
      commandetrn.wfr = trdetail.fdr
      commandetrn.wfr1 = trdetail.fdr1
      commandetrn.wfr2 = trdetail.fdr2
      commandetrn.wfd = trdetail.fdd
      
      
      
      //ExécuteTraitement(fddemicarrelage,trtModification)
      
     type : 458752
   -
     name : calculenergie
     procedure_id : 5859041163241899841
     type_code : 14
     code : |1+
      Procédure calculenergie()
      XPOSITION EST UN ENTIER = HSAUVEPOSITION("trdetail")
      //SI MODIF ALORS
      
      hlitpremier("trdetail","fdnocomm")
      //Code WinDev 5.5 remplacé par la migration :
      //tantque pas h.endehors
      tantque pas HEnDehors()
      
      	si casesurchargeenergie alors
      		si  pas (sansespace(trdetail.fdcomposant1) = "" et ...
      			sansespace(trdetail.fdcomposant2) = "" et ...
      			sansespace(trdetail.fdcomposant3) = "")	alors
      			si pas trdetail.fdintercalaire alors
      				trdetail.surchargeenergie = trdetail.fdprixu * trdetail.fdqte * commandetrn.surchargebase / 100 //+ ...
      			sinon
      				trdetail.surchargeenergie = 0
      			fin
      
      		fin
      		si trdetail.fdverreunite alors
      			trdetail.surchargeenergie = trdetail.fdprixu * trdetail.fdqte  * commandetrn.surchargeverreunite / 100
      		fin
              si trdetail.ftype = 4 alors
      	       trdetail.surchargeenergie += trdetail.fdcarrprixtotal * trdetail.fdqte  * commandetrn.surchargecarrelage / 100
      
              fin
              	
      	sinon
      
      
      		trdetail.surchargeenergie = 0
      	FIN
      	hmodifie("trdetail")
      	HLITSUIVANT("trdetail","fdnocomm")
      
      fin		 
      //FIN
      HRETOURPOSITION(XPOSITION)
      //Code WinDev 5.5 remplacé par la migration :
      //tableaffiche("TABLE_1","I")
      tableaffiche("TABLE_1",taDebut)
      //Code WinDev 5.5 remplacé par la migration :
      //execute("table_1..lentree")
      ExecuteTraitement("table_1",trtENTREELIGNE)
      
      
      
      
     type : 458752
   -
     name : calcultotal
     procedure_id : 5859041163301537601
     type_code : 14
     code : |1+
      Procédure calcultotal(ltypedeproduit)
      //Code WinDev 5.5 remplacé par la migration :
      //valeuraretourner est un reel double = 0
      valeuraretourner est un réel = 0
      selon ltypedeproduit
      
      cas 1 
      	   valeuraretourner = trdetail.fdqteafacturer * trdetail.fdprixu	
      cas 2 
      	   valeuraretourner = trdetail.fdqteafacturer * trdetail.fdprixu	
      cas 4
         valeuraretourner = trdetail.fdcarrprixtotal	
      	
      FIN
      valeuraretourner += trdetail.surchargeenergie
      renvoyer valeuraretourner
      
     type : 458752
   -
     name : calcul_espace
     procedure_id : 5859041162827843393
     type_code : 14
     code : |1+
      Procédure calcul_espace(variable)
      x est un entier
      different est un booleen = faux   // si dans le fichier kit pas de lien intercallaire = faux
      continuerrecherche est un booleen = faux // si pas trouve avec le numero de produit aller voir le lien
      doubleexiste est un booleen = faux
      lelien est une chaine
      lelien1 est une chaine
      lefini est un reel
      lespace est un reel 
      clederecherche EST UNE CHAINE
      lelien = complete(commandetrn.cdcomposant1,10)+complete(commandetrn.cdcomposant2,10)+complete(commandetrn.cdcomposant3,10)
      //lelien = DROITE(commandetrn.cdcomposant1,1)+DROITE(commandetrn.cdcomposant2,1)+DROITE(commandetrn.cdcomposant3,1)
      lelien1 = complete(produitdebase1,10)+complete(produitdebase2,10)+complete(produitdebase3,10)
      clederecherche = HConstruitValClé(inter,cleclientproduit,cl.numero,...
      complete(commandetrn.cdcomposant1,10),complete(commandetrn.cdcomposant2,10),...
      complete(commandetrn.cdcomposant3,10),complete(commandetrn.dfini,10))
      hlitrecherche("inter","cleclientproduit",clederecherche)
      
      
      //Code WinDev 5.5 remplacé par la migration :
      //    si pas h.endehors et h.trouve alors
      si pas HEnDehors() et HTrouve() alors
      	si type_intercallaire = "Inex" alors
      		si inter.iinex alors
      			commandetrn.cdespace	= inter.iespaceinex
      			commandetrn.cdespace2  = inter.Iespaceinex2
      			commandetrn.cdespaceinex = intercal.idescinex
      
      		sinon
      
      			continuerrecherche = vrai
      		fin	
      	sinon
      		si inter.ialuminium alors
      			commandetrn.cdespace	= inter.iespace
      			commandetrn.cdespace2	= inter.iespace2
      			commandetrn.cdespaceinex = intercal.idescinex
      		sinon
      			continuerrecherche = vrai
      
      		fin	
      	fin	
      sinon
      	clederecherche = HConstruitValClé(inter,cleclientproduit,cl.numero,...
      	complete(produitdebase1,10),complete(produitdebase2,10),...
      	complete(produitdebase3,10),complete(commandetrn.dfini,10))
      	hlitrecherche("inter","cleclientproduit",clederecherche)
      
      	//Code WinDev 5.5 remplacé par la migration :
      	//    si pas h.endehors et h.trouve alors
      	si pas HEnDehors() et HTrouve() alors
      		si type_intercallaire = "Inex" alors
      			si inter.iinex alors
      				commandetrn.cdespace	= inter.iespaceinex
      				commandetrn.cdespace2	= inter.iespaceinex2
      				commandetrn.cdespaceinex = intercal.idescinex
      			sinon
      
      				continuerrecherche = vrai
      			fin	
      		sinon
      			si inter.ialuminium alors
      				commandetrn.cdespace	= inter.iespace
      				commandetrn.cdespace2	= inter.iespace2
      				commandetrn.cdespaceinex = intercal.idescinex
      			sinon
      				continuerrecherche = vrai
      
      			fin	
      		fin	
      
      	sinon
      
      		continuerrecherche = vrai		
      	fin
      FIN
      
      //fin	
      
      si continuerrecherche alors
      
      	si pas position(variable,".") = 0 alors
      		lefini = numeriqueverschaine(val(variable) * 25.4,"6.3f")
      	sinon
      		si pas position(variable,"/") = 0 alors
      			lefini =numeriqueverschaine( convert_anglais(variable,"fini") * 25.4,"6.3f")
      
      		sinon
      			si val(variable) < 6 alors
      				lefini =numeriqueverschaine( convert_anglais(variable,"fini") * 25.4,"6.3f")
      
      
      			FIN
      		FIN
      	FIN
      
      
      
      	selon nbverre
      
      		cas "double" 
      			lespace = arrondi((lefini - epaisseur) ,3)
      
      		cas "triple" 
      			lespace = arrondi((lefini - epaisseur) / 2 ,3)
      
      	fin	
      
      	hlitrecherche("intercal","ialumetrique",lespace)
      
      	//Code WinDev 5.5 remplacé par la migration :
      	//si pas h.endehors alors
      	si pas HEnDehors() alors
      		si type_intercallaire = "Inex" alors
      
      			cdespace = intercal.idescalu
      			si nbverre = "triple" alors
      
      				cdespace2 = intercal.idescalu
      			fin
      			cdespaceinex = intercal.idescinex
      
      		sinon
      			cdespace = intercal.idescalu
      			si nbverre = "triple" alors
      				cdespace2 = intercal.idescalu
      			fin
      			cdespaceinex = intercal.idescinex		
      	fin		
      	//  commandetrn.fdcommentaire = intercal.icommentaire
      
      
      
      FIN
      fin
      
     type : 458752
   -
     name : calcul_nb_carreau
     procedure_id : 5859041163399841601
     type_code : 14
     code : |1+
      // méthode  1 = normal
      //          2 = contour
      //          3 = semi-contour 
      
      Procédure calcul_nb_carreau(methode=1)
      local
      
      	nbcarreau est un entier
      //	met1 est une chaine = config.formulecontour
      //	met2 est une chaine = config.formulesemicontour
      	sMet1 est une chaine = gclconfig.m_sformulecontour
      	met2 est une chaine = gclconfig.m_sformulesemicontour
      	
      	formule1 est une chaine 
      	formule2 est une chaine = "y est un reel"+RC+"y="+met2+RC+"renvoyer(y)"
      
      		si client.cQteSpecialeContour alors
      		si sansespace(typecarr.TcalculQteContour) <> "" alors
      			nbl = commandetrn.cdcarreauv
      			nbh = commandetrn.cdcarreauh
      			formule1 = "y est un reel"+RC+"y="+typecarr.TcalculQteContour+RC+"renvoyer(y)"
                  methode = 2
      		fin	
      	sinon
            methode = 1
      	fin
      
      
      selon methode
      	cas 1
      		nbcarreau = commandetrn.cdcarreauv * commandetrn.cdcarreauh
      	cas 2
      		res = compile("formulec1",formule1)
      		si res = "" alors
      			nbcarreau = executetraitement("formulec1",trtProcédure) 
      		FIN
      
      		nombre_de_carreau..etat = actif; nombre_de_carreau..Visible=Vrai
      	cas 3
      		res = compile("formulec2",formule2)
      		si res = "" alors
      			nbcarreau = executetraitement("formulec2",trtProcédure) 
      		FIN
      		
      		nombre_de_carreau..etat = actif; nombre_de_carreau..Visible=Vrai
      fin
      renvoyer nbcarreau
      
     type : 458752
   -
     name : calcul_prix_carr
     procedure_id : 5859041164062148417
     type_code : 14
     code : |1+
      Procédure calcul_prix_carr()
      // Carrelage
      clederecherche est une chaine
      escompte_carrelage est un reel
      numerodecarrelage est une chaine
      prixcarrpied est un reel 
      
      escompteqte = faux
      //prixdebasecarrelage est un reel
      si commandetrn.cdcarrelage alors
      	numerodecarrelage = commandetrn.cdnumcarr
      sinon
      	numerodecarrelage = commandetrn.cdnumprod
      fin	   
      //calcul carrelage au pied carré
      
      si client.CalculCarrPied alors   
      
      	clederecherche = HConstruitValClé(ProduitClient,IdClientIdproruit,commandetrn.fclient,numerodecarrelage)
      	si hlitrecherche(ProduitClient,IdClientIdproruit,clederecherche,hIdentique) ALORS
      
      		si client.cimpressionangmet = 1 alors
      			prixcarrpied = produitclient.IPrixCarrPiedCarre
      		sinon
      			prixcarrpied = produitclient.IPrixCarrPiedCarre
      		fin
      
      		commandetrn.cdcarrprixuc = prixcarrpied
      		commandetrn.cdcarrprixu =  trdetail.fdpiedcarrefacture * commandetrn.cdcarrprixuc 
      		commandetrn.cdcarrprixtotal = (commandetrn.cdcarrprixu * commandetrn.cdqte) //+ (commandetrn.cdprixdebasecarrelage * commandetrn.cdqte)
      
      
      	fin
      
      
      
      sinon
      
      	si pas commandetrn.nombre_de_carreau = 0  alors
      
      
      		si 	hlitrecherche("invent","INUM",numerodecarrelage) alors
      			//Code WinDev 5.5 remplacé par la migration :
      			//	si pas h.endehors alors
      			//Code WinDev 5.5 remplacé par la migration :
      			//		si h.trouve alors
      			validedate("carrelage")
      			//			escompte_carrelage = trouve_escompte(commandetrn.fclient+invent.inum,...
      			//			                     commandetrn.fclient+repete(" ",10)+invent.icategorie)
      
      			commandetrn.cdcarrprixu = invent.iprixm
      
      			//			si pas escompte_carrelage = 0 alors
      
      			//			  commandetrn.cdcarrprixuc = invent.iprixcarreau * (100 - escompte_carrelage) /100
      			//			  commandetrn.cdcarrprixuc = {prixcarreau}* (100 - escompte_carrelage) /100
      			//              si commandetrn.trcalculescbasecarr alors
      			//       			commandetrn.cdprixdebasecarrelage = {prixbasecarrelage} * (100 - escompte_carrelage) /100 
      			//              sinon
      			//       			commandetrn.cdprixdebasecarrelage = {prixbasecarrelage} 
      			//			  fin	
      			//		    sinon
      			 si pas intPrixCarreauModifie alors commandetrn.cdcarrprixuc = {prixcarreau}
      			 si pas intPrixBaseModifie alors commandetrn.cdprixdebasecarrelage = {prixbasecarrelage}  
      
      			//			FIN
      		FIN
      		//  commandetrn.prix_carreau = 3.25
      		clederecherche = HConstruitValClé(ProduitClient,IdClientIdproruit,commandetrn.fclient,numerodecarrelage)
      		si hlitrecherche(ProduitClient,IdClientIdproruit,clederecherche,hIdentique) ALORS
      			si produitclient.IPprixSpecial alors
      				SI PAS intPrixCarreauModifie commandetrn.cdcarrprixuc = produitclient.iprixa
      				SI PAS intPrixBaseModifie commandetrn.CDPRIXDEBASECARRELAGE = produitclient.iprixm
      			fin
      		fin
      		si fddemicarrelage  alors
      	//		commandetrn.CDCARRPRIXUC+=client.Cextracarrelagedemi
      			//commandetrn.cdextracarrelagedemi = client.Cextracarrelagedemi
      				si pas intPrixExtraDemiModifie alors commandeTRN.cDextraCarrelagedemi=TrouveExtraDemi(SansEspace(Client.numero))
      		sinon
      			commandetrn.cdextracarrelagedemi = 0
      
      		fin
      		si commandetrn.cdcarrelage alors
      
      			commandetrn.cdcarrprixu = commandetrn.nombre_de_carreau * (commandetrn.cdcarrprixuc + commandetrn.cDextraCarrelagedemi )
      			commandetrn.cdcarrprixtotal = (commandetrn.cdcarrprixu * commandetrn.cdqte) + (commandetrn.cdprixdebasecarrelage * commandetrn.cdqte)
      		sinon
      			commandetrn.cdcarrprixu = commandetrn.nombre_de_carreau * commandetrn.cdcarrprixuc 
      			commandetrn.cdcarrprixtotal = (commandetrn.cdcarrprixu * commandetrn.cdqte) + (commandetrn.cdprixdebasecarrelage  * commandetrn.cdqte)
      			commandetrn.cdprixu = commandetrn.nombre_de_carreau * commandetrn.cdcarrprixuc 
      			commandetrn.cdprixtot = (commandetrn.cdcarrprixu * commandetrn.cdqte) + (commandetrn.cdprixdebasecarrelage * commandetrn.cdqte)
      		fin
      	fin
      fin
      
      
      DessineCarrelage()
      
      ///////////////////////////
      // PRIX PEINTURE
      //////////////////////////
      
      si pas commandetrn.nombre_de_carreau = 0  alors
      	si 	hlitrecherche("invent","INUM",numerodecarrelage) alors
      		validedate("carrelage")
      		si pas dmodif ALORS
      			SI PAS bprixcarreau1peinture ALORS commandeTRN.fPrixCarreauPeinture = invent.iprixcarreauPeinture
      			SI PAS bprixcarreau2peinture ALORS commandeTRN.fPrixCarreauPeinture1 = invent.iprixcarreauPeinture
      			//commandetrn.fPrixCarreauPeinture1 = invent.iprixcarreauPeinture
      		fin
      		commandetrn.fPrixCarreauPeintureoriginal = invent.iprixcarreauPeinture
      	FIN
      
      
      	si client.CPrixSpecialPeintureCarrelage <> 0 alors
      		si pas dmodif alors
      			SI PAS bprixcarreau1peinture ALORS commandetrn.fPrixCarreauPeinture = client.CPrixSpecialPeintureCarrelage
      			SI PAS bprixcarreau2peinture alors commandetrn.fPrixCarreauPeinture1 = client.CPrixSpecialPeintureCarrelage
      		fin
      		commandetrn.fPrixCarreauPeintureoriginal = client.CPrixSpecialPeintureCarrelage
      	fin
      fin
      
      
      
     type : 458752
   -
     name : calcul_surface
     procedure_id : 5859041162963109697
     type_code : 14
     code : |1+
      Procédure calcul_surface(lunitedemesure,surfaceanglais=0,surfacemetrique=0)
      surface_entier_largeur est un reel
      surface_fraction_largeur est un reel
      surface_entier_hauteur est un reel
      surface_fraction_hauteur est un reel
      largeur_calcul est un reel 
      hauteur_calcul est un reel 
      
      selon lunitedemesure
      	cas 1 
      		si pas client.Calculsurfacereelle alors
      			surface_entier_largeur = partieentiere(val(commandetrn.cdlargeur))
      			surface_fraction_largeur = partiedecimale(val(commandetrn.cdlargeur))
      			surface_entier_hauteur = partieentiere(val(commandetrn.cdhauteur))
      			surface_fraction_hauteur = partiedecimale(val(commandetrn.cdhauteur))
      
      			si modulo(surface_entier_largeur,2) = 0 alors
      				si pas surface_fraction_largeur = 0  alors
      					largeur_calcul = surface_entier_largeur + 2
      				sinon
      					largeur_calcul = surface_entier_largeur 
      				fin	
      			sinon
      				largeur_calcul = surface_entier_largeur + 1
      			fin	
      
      			si modulo(surface_entier_hauteur,2) = 0 alors
      				si pas surface_fraction_hauteur = 0  alors
      					hauteur_calcul = surface_entier_hauteur + 2
      				sinon
      					hauteur_calcul = surface_entier_hauteur 
      				fin	
      			sinon
      				hauteur_calcul = surface_entier_hauteur + 1
      			fin	
      		sinon
      			largeur_calcul  =val(commandetrn.cdlargeur)
      			hauteur_calcul  =val(commandetrn.cdhauteur)
      		fin
      		surfaceanglais = arrondi(hauteur_calcul * largeur_calcul / 144,2)
      		surfacemetrique = arrondi(calcul_surface_metrique(val(commandetrn.cdlargeur)*25.4/1000,val(commandetrn.cdhauteur)*25.4/1000,client.Calculsurfacereelle),4)
      
      		renvoyer arrondi(hauteur_calcul * largeur_calcul / 144,2)
      	cas 2
      		largeur_calcul = val(commandetrn.cdlargeur) * 1000
      		hauteur_calcul = val(commandetrn.cdhauteur) * 1000
      		si pas client.Calculsurfacereelle alors
      			si pas modulo(largeur_calcul,20) = 0 alors
      				largeur_calcul = largeur_calcul + (20 - modulo(largeur_calcul,20))
      			fin
      			largeur_calcul = largeur_calcul / 1000
      
      			si pas modulo(hauteur_calcul,20) = 0 alors
      				hauteur_calcul = hauteur_calcul + (20 - modulo(hauteur_calcul,20))
      			fin
      
      			hauteur_calcul = hauteur_calcul / 1000
      		sinon
      			largeur_calcul = largeur_calcul / 1000
      			hauteur_calcul = hauteur_calcul / 1000
      		fin
      
      		surfaceanglais = arrondi(calcul_surface_anglais(val(commandetrn.cdlargeur) * 1000 / 25.4,val(commandetrn.cdhauteur) * 1000 / 25.4,client.Calculsurfacereelle),2)
      		surfacemetrique =arrondi(hauteur_calcul * largeur_calcul ,4)
      
      
      		renvoyer arrondi(hauteur_calcul * largeur_calcul,4)
      fin	
      
      
     type : 458752
   -
     name : calcul_surface_verreunite
     procedure_id : 5859041164225005377
     type_code : 14
     code : |1+
      Procédure calcul_surface_verreunite(lunitedemesure)
      surface_entier_largeur est un reel
      surface_fraction_largeur est un reel
      surface_entier_hauteur est un reel
      surface_fraction_hauteur est un reel
      largeur_calcul est un reel  = 0
      hauteur_calcul est un reel  = 0
      
      
      selon lunitedemesure
      
      cas 1 
      
      surface_entier_largeur = partieentiere(val(trdetail.fdlargeura))
      surface_fraction_largeur = partiedecimale(val(trdetail.fdlargeura))
      surface_entier_hauteur = partieentiere(val(trdetail.fdhauteura))
      surface_fraction_hauteur = partiedecimale(val(trdetail.fdhauteura))
      
      si modulo(surface_entier_largeur,2) = 0 alors
         si pas surface_fraction_largeur = 0  alors
            largeur_calcul = surface_entier_largeur + 2
         sinon
            largeur_calcul = surface_entier_largeur 
         fin	
      sinon
              largeur_calcul = surface_entier_largeur + 1
      fin	
      
      si modulo(surface_entier_hauteur,2) = 0 alors
         si pas surface_fraction_hauteur = 0  alors
            hauteur_calcul = surface_entier_hauteur + 2
         sinon
            hauteur_calcul = surface_entier_hauteur 
         fin	
      sinon
              hauteur_calcul = surface_entier_hauteur + 1
      fin	
      
      renvoyer hauteur_calcul * largeur_calcul / 144
      
      
      cas 2
      
      largeur_calcul = val(trdetail.fdlargeur) * 1000
      si pas modulo(largeur_calcul,20) = 0 alors
      
        largeur_calcul = largeur_calcul + (20 - modulo(largeur_calcul,20))
      
      fin
      
      largeur_calcul = largeur_calcul / 1000
      
      hauteur_calcul = val(trdetail.fdhauteur) * 1000
      si pas modulo(hauteur_calcul,20) = 0 alors
      
        hauteur_calcul = hauteur_calcul + (20 - modulo(hauteur_calcul,20))
      
      fin
      
      hauteur_calcul = hauteur_calcul / 1000
      
      renvoyer hauteur_calcul * largeur_calcul
      
      
      fin	
      
     type : 458752
   -
     name : cherchecarrdim
     procedure_id : 5859041162827319105
     type_code : 14
     code : |1+
      Procédure cherchecarrdim(numcarr)
      
      si commandetrn.facalcul = 1 alors
      
      hlitrecherche("carrdim","carrclea",numcarr)
      
      //Code WinDev 5.5 remplacé par la migration :
      //si pas h.endehors et sansespace(gauche(numcarr,10)) = sansespace(carrdim.carrnumero) alors
      si pas HEnDehors() et sansespace(gauche(numcarr,10)) = sansespace(carrdim.carrnumero) alors
       
      	tantque (val(sansespace(commandetrn.cdhauteur)) > val(sansespace(carrdim.carrhautaconvert))) et ...
      //Code WinDev 5.5 remplacé par la migration :
      //	 pas h.endehors	
      	 pas HEnDehors()	
             hlitsuivant("carrdim","carrclea")
            FIN
      FIN
      //Code WinDev 5.5 remplacé par la migration :
      //si pas h.endehors alors
      si pas HEnDehors() alors
      //Code WinDev 5.5 remplacé par la migration :
      //si  (sansespace(gauche(numcarr,10)) = sansespace(carrdim.carrnumero)) et pas h.endehors alors
      si  (sansespace(gauche(numcarr,10)) = sansespace(carrdim.carrnumero)) et pas HEnDehors() alors
      	commandetrn.cdcarreauv = carrdim.carrnbcarlarg
      	commandetrn.cdcarreauh = carrdim.carrnbcarhaut
      	
      FIN
      fin
      sinon
      hlitrecherche("carrdim","carrclem",numcarr)
      //Code WinDev 5.5 remplacé par la migration :
      //si pas h.endehors et sansespace(gauche(numcarr,10)) = sansespace(carrdim.carrnumero) alors
      si pas HEnDehors() et sansespace(gauche(numcarr,10)) = sansespace(carrdim.carrnumero) alors
      	tantque (val(sansespace(commandetrn.fdhauteura)) > val(sansespace(carrdim.carrhautm))) et ...
      //Code WinDev 5.5 remplacé par la migration :
      //	(sansespace(gauche(numcarr,10)) = sansespace(carrdim.carrnumero)) et  pas h.endehors	
      	(sansespace(gauche(numcarr,10)) = sansespace(carrdim.carrnumero)) et  pas HEnDehors()	
             hlitsuivant("carrdim","carrclem")
          FIN
      FIN
      //Code WinDev 5.5 remplacé par la migration :
      //si pas h.endehors alors
      si pas HEnDehors() alors
      //Code WinDev 5.5 remplacé par la migration :
      //si  (sansespace(gauche(numcarr,10)) = sansespace(carrdim.carrnumero)) et pas h.endehors alors
      si  (sansespace(gauche(numcarr,10)) = sansespace(carrdim.carrnumero)) et pas HEnDehors() alors
      	commandetrn.cdcarreauv = carrdim.carrnbcarlarg
      	commandetrn.cdcarreauh = carrdim.carrnbcarhaut
      	
      FIN
      fin
      fin
      
     type : 458752
   -
     name : convert_anglais
     procedure_id : 5859041163762714433
     type_code : 14
     code : |1+
      Procédure convert_anglais(variable,provenance = "")
      //variable est une chaine = moimeme
      //hlitpremier("config","COCLEUNIK")
      longueur est un entier = taille(variable)
      position_espace est un entier = position(variable," ")
      //position_espace1 est un entier = position(variable," ",position_espace+1)
      resultat_gauche est une chaine  
      resultat_droit est une chaine        
      valeuraretourner est un reel
      si position_espace = 0 alors
      	si position(variable,"/") = 0 alors
      		resultat_gauche = ""
      	sinon
      		resultat_gauche = "0"
      	fin	
      sinon	
      
      	resultat_gauche = gauche(variable,position_espace-1)
      
      FIN
      
      si position_espace = 0 alors
      
      	resultat_droit = variable
      
      sinon	
      
      	resultat_droit = milieu(variable,position_espace +1, longueur - position_espace)
      
      FIN
      
      
      si pas position(resultat_droit,"/") = 0 alors
      	resultat_droit = memrecherche("tableau_metrique",resultat_droit)
      FIN
      
      
      
      
      
      si provenance = "fini" alors
      	valeuraretourner = resultat_gauche+resultat_droit
      
      sinon
      	moimeme = resultat_gauche+resultat_droit
      	valeuraretourner = vrai
      
      FIN
      
      //SI Val(MoiMême) > config.dimensionmaxanglais ET PAS MoiMême = "" ALORS
      	SI Val(MoiMême) > gclconfig.m_rdimensionmaxanglais ET PAS MoiMême = "" ALORS
      		erreur("Donnée incorrecte")
      	valeuraretourner = faux
      FIN
      
      
      
      renvoyer valeuraretourner
      
     type : 458752
   -
     name : convert_metrique
     procedure_id : 5859041164046944065
     type_code : 14
     code : |1+
      Procédure convert_metrique(videpermis = faux)
      //hlitpremier("config","COCLEUNIK")
      valeurderetour est un booleen = vrai
      variable est une chaine = moimeme
      longueur est un entier = taille(variable)
      partie_decimale est une chaine
      partie_entier est une chaine
      si longueur <> 0 alors
      si position(variable,".") = 0 alors
       si longueur <= 3 alors
      	variable = "."+repete("0",3-longueur)+variable
       sinon
      	partie_decimale = droite(variable,3)
      	partie_entier   = gauche(variable,longueur-3)
      	variable = partie_entier+"."+partie_decimale
       FIN
      fin
      
      moimeme = variable
      sinon
        si videpermis alors
           valeurderetour = vrai
        sinon	 
           valeurderetour = faux
        fin
      fin 	
      si val(moimeme) < gclconfig.m_rDimensionmaximetrique et pas moimeme = "" alors
      	erreur("Donnée incorrecte")
      	valeurderetour = faux
      FIN
      
      renvoyer valeurderetour
      
     type : 458752
   -
     name : decale_ligne
     procedure_id : 5859041162981263169
     type_code : 14
     code : |1+
      Procédure decale_ligne(numligne,nombredeligne)
        laligne est un entier = numligne
        dernierenreglu  est un entier
        x est un entier
        hpos est un entier = hsauveposition("trdetail")
        hlitdernier("trdetail","fdcle")
        boucle
      	 si trdetail.fdligne <= laligne ou dernierenreglu = h.numenr alors
      		sortir
      	 fin
            trdetail.fdligne = trdetail.fdligne + 1
            si pas trdetail.fdlien = 0 alors
      		 trdetail.fdlien = trdetail.fdlien+1
      	  FIN
      	  hmodifie("trdetail")
            dernierenreglu = h.numenr
            hlitprecedent("trdetail","fdcle")
      
      fin
      
      hretourposition(hpos)
      //hchangecle("trdetail","fdcle")
      
     type : 458752
