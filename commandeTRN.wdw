          type : 9
          controls : []
          code_elements :
           type_code : 9
           p_codes :
            -
              code : |1+
               HExécuteRequête(RequeteTablefacture,hModifieFichier,"B")
               
              type : 14
            -
              code : |1+
               SI table..VIDE ALORS
               	BTN_MODIFIE..ETAT = GRISE; BTN_MODIFIE..Visible=Vrai
               
               SINON
               	SI PAS AJOUT ET PAS MODIF ALORS
               		si pas modeexpert alors
               			si BTN_MODIFIE..visible = vrai alors BTN_MODIFIE..ETAT = ACTIF; BTN_MODIFIE..Visible=Vrai	
               		fin
               	FIN
               FIN
               
               
              type : 15
            -
              code : |1+
               
               FICHIERVERSECRAN(commandetrn,facture)
               
               activefiltre()   
               remplir_escompte(vrai)
               
               hlitrecherche(client,numero,faclienttable)
               
               si HTrouve() alors
               	si pas HEnDehors() alors
               		
               		fichierversecran(Commandetrn,client)
               	fin
               	
               fin	
               si commandetrn.commandecredit = 2 alors
               	commandetrn.fanocommande..VISIBLE = FAUX
               	commandetrn.fanojob..visible = faux
               	commandetrn.reference..etat = AffichageSeulement
               	commandetrn.libelle3..visible = faux
               	commandetrn.libellecredit..etat = actif
               	
               sinon
               	commandetrn.fanocommande..etat = AffichageSeulement
               	commandetrn.fanojob..etat = AffichageSeulement
               	commandetrn.reference..visible = faux
               	commandetrn.libelle3..etat = actif
               	commandetrn.libellecredit..visible = faux
               	
               FIN
               si pas ajout et pas modif alors
               //	si commandetrn.fatransportouinon alors
               //		btn_trsp..etat = grisé; btn_trsp..Visible=Vrai
               ////		btn_trspx..Visible=Faux
               //		chargetrsp = vrai
               //	sinon	
               ////		btn_trspx..etat = grisé; btn_trspx..Visible=Vrai
               //		btn_trsp..Visible=Faux
               //	    chargetrsp = faux
               //     FIN
               fin
               
              type : 19
            -
              code : |1-
               
               si sansespace(RequeteTablefacture.FPREPARATION) = "T" alors
               	table.tetat[table] = 1
               sinon
               	table.tetat[table] = 0
               FIN
               
               si sansespace(RequeteTablefacture.FPREPARATION) = "B" alors
               	table.tetat2[table] = 1
               sinon
               	table.tetat2[table] = 0
               FIN
               si sansespace(RequeteTablefacture.FPREPARATION) = "F" alors
               	table.tetat1[table] = 1
               	si sansespace(RequeteTablefacture.livrepartiel) = "P"  alors
               		//table.tetat[table] = 2
               	FIN
               sinon
               	table.tetat1[table] = 0
               FIN
               
               si sansespace(RequeteTablefacture.FPREPARATION) = "" alors
               	si sansespace(RequeteTablefacture.livrepartiel) = "P"  alors
               	//	table.tetat[table] = 2
               	FIN
               FIN
               si sansespace(RequeteTablefacture.livrepartiel) = "P"  alors
               	table.tetatpartiel[table] = 1
               FIN
               
               
               table.tetat3[table] = RequeteTablefacture.fpeinture
               si RequeteTablefacture.OnHold alors
               	TABLE[TABLE]..CouleurFond = iRougeClair
               	TABLE[TABLE]..Couleur = iblanc
               	table[table]..PoliceGras = vrai
               	
               FIN
              type : 21
            -
              type : 22
              enabled : false
            -
              type : 24
              enabled : false
