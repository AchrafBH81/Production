               si moimeme = gsCurrentShapeNumber alors moimeme..modifie = faux
               
               si sansespace(moimeme) <> "" alors
                   commandetrn.fdextraforme..etat = actif
                   BTN_ShowShapedata..visible = vrai
               	moimeme = remplir_zero(moimeme,3)
               //    si modif alors
