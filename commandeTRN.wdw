      fdetail.SUrchargeTaux				= trdetail.SUrchargeTaux
      Fdetail.surchargeTauxafacturer		= trdetail.surchargeTauxafacturer
      Fdetail.surchargeTauxdejafacture	= trdetail.surchargeTauxdejafacture
      
      fdetail.CalculArgon					= trdetail.CalculArgon
      fdetail.PietageArgon				= trdetail.PietageArgon
      Fdetail.ExtraArgonPrice				= trdetail.ExtraArgonPrice
      
      
      si fdetail.ftype = 5  alors
      	fsurchargepeinture += arrondi(fdetail.fdprixtotal,2)
      	si hlitrecherche(invent,INUM,fdetail.fdnumprod) et invent.icategorie = "CAP" alors
      		
      	sinon
      		aumoinsunelignepeinture = vrai
      	fin
      FIN
      
      si fdetail.fpeinture  alors
      	gCarrelagePeinture = vrai
      FIN
      
      lcoutthermos=fdetail.fdprixtotal+(fdetail.fdprixtotal*commandetrn.surchargebase/100)
      
      SI Fdetail.fdcarrelage ALORS
      	Aveccarrelage = Vrai
      FIN
      SI fdetail.ftype = 1 alors 
         gnNumberOfThermos+= Fdetail.fdqte
      	si SansEspace(Fdetail.fdforme) <> "" ALORS
      		AvecForme = Vrai
      	FIN
      	
      FIN
      si epaisseurverre = 0 alors EpaisseurVerre = Val(Droite(SansEspace(Fdetail.fdbase),2))
      nbcomposant			est un entier	= 0
      nbComposantSpeciaux	est un entier	= 0
      
      
      POUR i = 1 À 3
      	si sansespace({"fdetail.fdcomposant"+i,indRubrique}) <> "" alors 
      		nbcomposant++
      	FIN
      	SI HLitRecherche(invent,INUM,{"fdetail.fdcomposant"+i,indRubrique}) ALORS
      		SI invent.IproduitSpecial ALORS
      			nbComposantSpeciaux++
      			AvecProduitSpeciauxPartiel = vrai
      		FIN
      		si invent.IPinede alors
      			avecpinede = vrai
      		fin
      		SI invent.Isatine ALORS
      			AvecSatine = Vrai
      		FIN
      		SI invent.IsUltraClair ALORS
      			AvecUltraclair = Vrai
      		FIN
      		SI invent.IsTempered ALORS
      			gbAvecTrempe = Vrai
      		FIN
      		SI invent.ienergieverre ALORS
      			gbAvecEnergiverre = Vrai
      		FIN
      		SI invent.ienergieverreESC ALORS
      			gbAvecEnergiverreESC = Vrai
      		FIN
      		
      	FIN
      FIN
      selon nbcomposant 
      	cas 1
      		fdetail.ThermosType = "S"
      	CAS 2
      		Fdetail.ThermosType = "D"
      	CAS 3
      		Fdetail.ThermosType	= "T"
      		avectriple			= vrai
      	AUTRE CAS
      		
      FIN
      si nbcomposant <> 0 _et_ nbComposantSpeciaux = nbcomposant alors AvecProduitSpeciaux = vrai
      
      fdetail.PoidsUnitaire = CalculPoidsThermos(fdetail.fdpiedcarrereel,fdetail.ThermosType,fdetail.fdbase,facture.facalcul)
      
      //selon fdetail.ftype
      //	cas 1
      //        
      //        
      //		CalculCoutantVerre(lcoutthermos)
      //	cas 4
      //		CalculCoutantcarrelage(fdetail.fdnumcarr,lcoutthermos)
      //
      //FIN
      
      
     type : 458752
