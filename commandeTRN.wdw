  -
    name : FCLIENT
    identifier : 0x514f7ee56281c7a5
    internal_properties : 
    properties :
     x : 7
     y : 104
     width : 81
     height : 23
    type : 2
    code_elements :
     type_code : 3
     p_codes :
      -
        code : |1+
         valeurinitialec = moimeme
         vendeurfiche  = vrai// indique que le vendeur de la commande est celui de la fiche client
         SI HLitRecherche(Client,numero,Complète(MoiMême,10),hIdentique) ALORS
         	si Combo_Vendeur <> client.cvendeur alors
         		vendeurfiche = faux
         	FIN
         FIN
         
         
         
        type : 15
      -
        code : |1+
         
         //hlitrecherche(client,numero,"6905822",hIdentique)
         //hlitrecherche(client,numero,sansespace(moimeme),hIdentique)
         //hlitrecherche(client,numero,complete(moimeme,10),hIdentique)
         
         si moimeme <> valeurinitialec et sansespace(valeurinitialec) <> "" alors
         	suppressActiveTempoOrder(commandetrn.fanocommande)
         	commandetrn.fanocommande = ""
         	info("N'oubliez pas de repasser sur chaque ligne de détail afin de recalculer les prix pour ce nouveau client","","N'oubliez pas de réinscrire le numéro de commande client")
         	
         FIN
         //si HTrouve(client) alors
         //	si pas HEnDehors(client) alors
         si hlitrecherche(client,numero,complete(moimeme,10),hIdentique) alors
         	si client.cetat = 2 alors
         		acso_message("Erreur","Ce client est inactif","Erreur")
         		RepriseSaisie(fclient)
         	FIN
         	
         	
         	//getTauxTaxes() 
         	
         	langueclient = client.CLangue
         	cidclient = client.IDClient
         	
         	si sansespace(moimeme) <> sansespace(lNoClientComptant) alors
         		nom = client.nom
         		adresse = client.crue
         		villeProv = client.cville
         		CodePostal = client.ccodepostal
         		NoTelephone = client.ctelephone
         		NoTelephone2 = client.ctelephone
         		GrpClientComptant..etat = inactif
         	sinon
         		GrpClientComptant..etat = actif
         		
         	fin
         	
         	fichierversecran(Commandetrn,client)
         	
         	TrouvePourcSurcharge()
         	si client.cminimumPeinture <> 0 alors
         		lPrixMinimumPeinture = client.cminimumPeinture
         	FIN
         	
         	
         	si ajout alors
         		//	envoietouche("{entree}")
         	fin
         	
         	si client.cactivationchampspecuaix alors
         		decko..etat = actif; decko..Visible=Vrai
         	sinon
         		decko..Visible=Faux
         	FIN
         	si client.cimprimecarrelagenon alors
         		pascarrelagedefaut = vrai 
         	FIN
         	si client.cforme99defaut alors
         		forme99defaut = vrai
         	fin	 
         	si ajout alors
         		commandetrn.facalcul = client.cmesure
         		
         //		si client.cintercallaire = 1 alors
         //			commandetrn.inexalu = vrai
         //		sinon
         //			commandetrn.inexalu = faux
         //			
         //		FIN
         		SI commandetrn.commandecredit = 2 alors
         			commandetrn.combo_secteur = CLIENT.SECTEUR	
         		sinon
         			commandetrn.combo_secteur = client.secteur
         		fin
         		si client.cactivationchampspecuaix alors
         			decko..Visible=Vrai
         		sinon
         			decko..Visible=Faux
         		FIN
         	fin
         	SI modif = vrai OU ajout = VRAI ALORS
         		si client.cactivationchampspecuaix alors
         			decko..Visible=Vrai
         		sinon
         			decko..Visible=Faux
         		FIN
         		
         		ENTETE..Visible=Vrai
         		entete..etat = actif
         //		SI ModifieCommandedejatraitee ALORS
         //			fadate..Etat = Grisé
         //			Fdaterequise..Etat = Grisé
         //		FIN
         		si commandetrn.commandecrédit = 2 alors
         			commandetrn.fanocommande..VISIBLE = FAUX
         			commandetrn.fanojob..VISIBLE = FAUX
         			commandetrn.fdaterequise..VISIBLE = FAUX
         		FIN
         	sinon
         		si client.cactivationchampspecuaix alors
         			decko..Visible=Vrai
         		sinon
         			decko..Visible=Faux
         		FIN
         		
         	FIN
         	
         	SI PAS MODIF alors
         		commandetrn.Combo_Vendeur = client.cvendeur
         //		SI config.surchargeactive ALORS
         			SI gclconfig.m_nsurchargeactive ALORS
         				//				si client.surcharge alors	
         			commandetrn.casesurchargeenergie = vrai
         			//				sinon
         			//					commandetrn.casesurchargeenergie = faux
         			//				FIN
         		sinon
         			commandetrn.casesurchargeenergie = faux
         			
         		fin
         		hlitrecherche("categclt","categorie",client.categorie)
         		si pas HEnDehors() et HTrouve() alors
         			si categclt.catchargetransport alors
         				chargetrsp = vrai
         //				btn_trsp..Visible=Vrai
         //				btn_trspx..Visible=Faux
         				trspachatmin = 0.00
         			sinon
         				chargetrsp = faux
         //				btn_trspx..Visible=Vrai
         //				btn_trsp..Visible=Faux
         				trspachatmin = categclt.catminmontant
         			fin	
         		FIN
         	sinon
         		si pas vendeurfiche et commandeTRN.Combo_Vendeur <> Client.cvendeur alors
         			SI ouinon("Le vendeur à été inscrit manuellement , voulez vous le conserver ?") = faux ALORS
         					commandeTRN.Combo_Vendeur = Client.cvendeur
         			
         			FIN
         		sinon
         			commandeTRN.Combo_Vendeur = Client.cvendeur
         		fin
         		
         	FIN
         
         sinon
         	moimeme=""
         	erreur("Client inexistant")
         	commandetrn.fclient = valeurinitialec
         	reprisesaisie("fclient")
         	
         FIN
         
         remplirComboLivraison(moimeme)
         si modif alors 
         	commandetrn.Combo_Livraison1 = facture.idLivraison
         	ExécuteTraitement(Combo_Livraison1,trtSélection)
         FIN
         SI (ajout _ET_ gmessageajout) _OU_ (modif _ET_ gmessagemodification) ALORS
         	Ouvre(FenMessageClient)
         	
         FIN
         si sansespace(moimeme) = sansespace(lNoClientComptant) alors
         	si ajout alors
         		nom = "Nom"
         		adresse = "Adresse (rue)"
         		villeProv = "Ville/Province"
         		codepostal = "Z9Z 9Z9"
         		NoTelephone = "999-999-9999"
         	fin
         	reprisesaisie(nom)
         fin
         //GetJoursLivraison()
         GetJoursLivraisonClient(Client.IDClient,Combo_Livraison1)
         
        type : 16
