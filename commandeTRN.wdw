     name : Commandeasupprimer
     procedure_id : 5859041163407247169
     type_code : 14
     code : |1+
      Procédure Commandeasupprimer(lnocommande)
      valeuraretourner est un booleen = vrai
      
      si hlitrecherche(BonLivraison,BnoCommande,lnocommande) alors
      	tantque BonLivraison.BnoCommande = lnocommande
      		si sansespace(BonLivraison.Bfacture) = 0 alors
      			valeuraretourner = faux
                  sortir
      		FIN
      	HLitSuivant(BonLivraison,BnoCommande)
      	FIN
      FIN
      
      renvoyer valeuraretourner
      
      
      
     type : 458752
