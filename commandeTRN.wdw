    name : BtnVisuConfirmation
    identifier : 0x2ddd6eee9c0d1b7e
    internal_properties : 
    properties :
     x : 440
     y : 6
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         
         
         iFenêtreAbandon(faux)
         ouvresoeur(FenAttentePetite,"Impression de la confirmation "+RequeteTablefacture.fanumero+" en cours...")
         iConfigure(imprimanteconfirmation)
         iParamètre("DEFAUT=NON")
         iParamètre("ORIENTATION=PAYSAGE")
         //iParamètre("COPIES="+config.NbCopieConfirmation)
         iParamètre("COPIES="+gclConfig.m_nNbCopieConfirmation)
         iParamètreAperçu(iVoletMiniatures,faux)
         iapercu(100)
         
         HExécuteRequête(RequetefeuilleLivraison,hRequêteDéfaut,onglet1 = 1 ? RequeteTablefacture.fanumero sinon RequeteTableSoumission.fanumero)
         
         iImprimeEtat(ConfirmationTRN)
         ferme(FenAttentePetite)
         multitacherepeint(commandeTRN)
         
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_MODE
    identifier : 0x514f7ee54f9bc773
    internal_properties : 
    properties :
     x : 262
     y : 6
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         restaure_bouton()
         modeaffichage = "Fiche"
         //Code WinDev 5.5 remplacé par la migration :
         //execute("table..LEntree")
         selon onglet1
         cas 1	
         	ExecuteTraitement(table,trtSélection)
         cas 2
         	ExecuteTraitement(table1,trtSélection)
         
         FIN
         //Code WinDev 5.5 remplacé par la migration :
         //_onglet2..etat = actif
         
         MaFenêtre..Plan=2
         VerifieAffichage()
         multitacherepeint
         commandeTRN..Titre = (commandetrn.COMMANDECREDIT = 3 ? "Soumission # " sinon " Commande # ")+commandeTRN.fanumero
         //Code WinDev 5.5 remplacé par la migration :
         //TableAffiche("Table_1","Init")
         TableAffiche("Table_1",taDebut)
         //Code WinDev 5.5 remplacé par la migration :
         //navigation..etat = actif
         navigation..etat = actif; navigation..Visible=Vrai
         taille_originale_table1()
         //Code WinDev 5.5 remplacé par la migration :
         //si commande_detail..VISIBLE = FAUX alors
         si commande_detail..Visible=Faux alors
         //Code WinDev 5.5 remplacé par la migration :
         //	commande_detail..etat = grisé
         	commande_detail..etat = grisé; commande_detail..Visible=Vrai
         FIN
         
         
         tableselectplus("TABLE_1",1)
         executetraitement(table_1,trtSélection)
         executetraitement(table_1,trtEntréeLigne)
         
         //recupere_donnee()
        type : 18
      -
        type : 161
        enabled : false
