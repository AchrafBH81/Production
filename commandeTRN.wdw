      pour z = 1 a 10
      	fdetail.FDnbmorceau[z]			= trdetail.FDnbmorceau[z]
      	fdetail.fddimension[z]			= trdetail.fddimension[z]
      fin
      Fdetail.fdhauteuranglais			= trdetail.fdhauteuranglais
