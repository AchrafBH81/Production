           p_codes :
            -
              code : |1+
               si moimeme = 0 alors
               //	acso_message("Erreur","Attention, le prix du carrelage est à zéro","Erreur")
               FIN
               
               ValeurPrixCarreau = moimeme
              type : 15
            -
              code : |1+
               SI PAS moimeme = ValeurPrixCarreau ALORS
               	si pas client.CalculCarrPied alors
               		cdcarrprixu = (moimeme+commandetrn.cDextraCarrelagedemi) * nombre_de_carreau 
               		cdcarrprixtotal = (cdcarrprixu * cdqte) + (cdprixdebasecarrelage * commandetrn.cdqte)
               		si pas commandetrn.cdcarrelage alors
               			cdprixu = (moimeme+commandetrn.cDextraCarrelagedemi) * nombre_de_carreau
               			cdprixtot = (cdcarrprixu * cdqte) + (cdprixdebasecarrelage * commandetrn.cdqte)	  
               		FIN
               		si moimeme..Modifié alors
               			intPrixCarreauModifie = vrai
               			ExécuteTraitement(intPrixCarreauModifie,trtModification)
               		FIN
               	sinon
               		cdcarrprixu =(moimeme+commandetrn.cDextraCarrelagedemi) * trdetail.fdpiedcarrefacture 
               		cdcarrprixtotal = (cdcarrprixu * cdqte) //+ (cdprixdebasecarrelage * commandetrn.cdqte)
               		si moimeme..Modifié alors
               			intPrixCarreauModifie = vrai
               			ExécuteTraitement(intPrixCarreauModifie,trtModification)
               		FIN
               		reprisesaisie(fdextraforme)
               	
               	fin
               FIN
