      //	trdetail.fdcapr2	= faux
      //	trdetail.fdcaps		= faux
      //	trdetail.fdcapf		= faux
      //	trdetail.fnombre	=  0
      //sinon
      	trdetail.fdw		= wfw
      	trdetail.fdw1		= wfw1
      	trdetail.fdw2		= wfw2
      	trdetail.fdh		= wfh
      	trdetail.fdh1		= wfh1
      	trdetail.fdh2		= wfh2
      	trdetail.fdd		= wfd
      	trdetail.fdr		= wfr
      	trdetail.fdr1		= wfr1
      	trdetail.fdr2		= wfr2
      	trdetail.fds		= wfs
      	trdetail.fdf		= wff
      //	trdetail.fdt1		= wft1
      //	trdetail.fdt2		= wft2
