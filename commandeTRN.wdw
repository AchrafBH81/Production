   -
     name : supprime_ligne
     procedure_id : 5859041164216944449
     type_code : 14
     code : |1+
      Procédure supprime_ligne(suppression)
      indiceligne est un entier = table_1  		
      postable est un entier
      qtecourante est un entier
      selon suppression
      
      cas "carrelage"   // supprime seulement le carrelage
      	tableselectplus("TABLE_1",indiceligne - 1)
      	trdetail.fdlien = 0
      	trdetail.fdnumcarr = ""
      	trdetail.fdcarrelage = faux
      	trdetail.fdcarreauh = 0
      	trdetail.fdcarreauv = 0
      	HMODIFIE("trdetail")
      	tableselectplus("TABLE_1",indiceligne )
      	hlit("trdetail",tablenumenr("TABLE_1"))
          trdetail.traye = vrai
          hmodifie("trdetail")
      //	tablesupprime("TABLE_1",indiceligne)
      
      cas "principal"   // supprime le produit principal et le carrelage
      	tableselectplus("TABLE_1",indiceligne )
      	hlit("trdetail",tablenumenr("TABLE_1"))
          trdetail.traye = vrai
          hmodifie("trdetail")
      //    hraye("trdetail")
      	tableselectplus("TABLE_1",indiceligne+1 )
      	hlit("trdetail",tablenumenr("TABLE_1"))
          trdetail.traye = vrai
          hmodifie("trdetail")
      //    hraye("trdetail")
      //	tablesupprime("TABLE_1",indiceligne)
      //	tablesupprime("TABLE_1",indiceligne)
      	
      cas "unique"
          hlit("trdetail",tablenumenr("TABLE_1"))
          trdetail.traye = vrai
          hmodifie("trdetail")
      fin
      
      //si trdetail.fregroupement <> ""  alors
      //
      // 	postable = tablecherche("no_produit",sansespace(trdetail.fregroupement),faux)
      //qtecourante = 0  
      //	si postable <> -1 alors
      //	   total_qte[postable] = total_qte[postable] - trdetail.fdqte 
      //     qtecourante = total_qte[postable]
      //
      //    FIN
      //fin
      //
      //
      //    changeprix(sansespace(trdetail.fregroupement),qtecourante)
      ////        hraye("trdetail")
      //    
      ////	tablesupprime("TABLE_1",indiceligne)
      //FIN
      
      //Code WinDev 5.5 remplacé par la migration :
      //tableaffiche("TABLE_1","I")
      tableaffiche("TABLE_1",taDebut)
      
      
     type : 458752
   -
     name : taille_originale_table1
     procedure_id : 5859041162503178049
     type_code : 14
     code : |1+
      Procédure taille_originale_table1()
      
      table_1..hauteur = hauteur_table
      //Code WinDev 5.5 remplacé par la migration :
      btn_rouge..etat = inactif;btn_rouge..VISIBLE = FAUX
      //btn_rouge..Visible=Faux
      //Code WinDev 5.5 remplacé par la migration :
      //btn_vert..etat = actif
      btn_vert..etat = actif; btn_vert..Visible=Vrai
      //Code WinDev 5.5 remplacé par la migration :
