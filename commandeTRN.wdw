   -
     name : checkIfPrintSpecialReport
     internal_properties : CQAAAAkAAAD3VeNQ54qxa/l1CRHx2/4mDGoCOQwOQBBFWuJVoLbFOViOyZOqZlWQ9O0OW+3wXLXWHuFKD+9UPchgxctbGtYduCmXnkkibreQ+Zr6XZrrtyVq/zfBl+A=
     procedure_id : 1795737827174789147
     type_code : 14
     code : |1-
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] checkIfPrintSpecialReport (<nOrderNumber> est entier)
      //
      // Paramètres :
      //	nOrderNumber (entier) : <indiquez ici le rôle de nOrderNumber>
      // Valeur de retour :
      // 	booléen : <indiquez ici le rôle de la valeur de retour>
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //// Traitement automatique des exceptions :   exécuter le bloc de code CAS EXCEPTION:
      //
      
      procédure checkIfPrintSpecialReport(nOrderNumber est un entier)
      bValeurarenvoyer est un booleen = faux
      
      sdReqsql est une source de donnees
      sTxtsql est une chaine = [
      select * from fdetail where fdetail.fdnocomm = %1 AND fdetail.ftype = 1 and trim(fdetail.fdforme) <> ''
      ]
      sdReqsql1 est une source de donnees
      sTxtsql1 est une chaine = [
      select fdetail.fdcomposant1,fdetail.fdcomposant2,fdetail.fdcomposant3 from fdetail 
      where fdetail.fdnocomm = %1 and fdetail.ftype =1
      ]
      
      
      
      
      si facture.fpeinture > 0 alors bValeurarenvoyer = vrai
      
      si hexecuterequetesql(sdReqsql,hRequêteDéfaut,ChaîneConstruit(sTxtsql,nOrderNumber)) alors
      	si hnbenr(sdReqsql) > 0 alors bValeurarenvoyer = Vrai
      	
      FIN
      
      si HExécuteRequêteSQL(sdReqsql1,hRequêteDéfaut,ChaîneConstruit(sTxtsql1,nOrderNumber)) alors
      	pour TOUT sdReqsql1 
      		si sansespace(sdReqsql1.fdcomposant1) <> "" alors
      			si hlitrecherche(invent,INUM,sdReqsql1.fdcomposant1) alors
      				si invent.IproduitSpecial alors
      					bValeurarenvoyer = vrai
      					sortir
      				FIN
      			FIN
      		FIN
      		si sansespace(sdReqsql1.fdcomposant2) <> "" alors
      			si hlitrecherche(invent,INUM,sdReqsql1.fdcomposant2) alors
      				si invent.IproduitSpecial alors
      					bValeurarenvoyer = vrai
      					sortir
      				FIN
      			FIN
      		FIN
      		si sansespace(sdReqsql1.fdcomposant3) <> "" alors
      			si hlitrecherche(invent,INUM,sdReqsql1.fdcomposant3) alors
      				si invent.IproduitSpecial alors
      					bValeurarenvoyer = vrai
      					sortir
      				FIN
      			FIN
      		FIN
      	FIN
      FIN
      
      renvoyer bValeurarenvoyer
      
      CAS EXCEPTION:
      	
      	info(ExceptionInfo())
