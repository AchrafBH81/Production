        -
          name : CDNUMCARR
          identifier : 0x514f7ee50e3ac74b
          internal_properties : 
          properties :
           x : 108
           y : 5
           width : 87
           height : 24
          type : 2
          code_elements :
           type_code : 3
           p_codes :
            -
              code : |1+
               lchaineoriginale = moimeme
               
               
              type : 15
            -
              code : |1-
               //commandetrn.btn_carrelage..VISIBLE = FAUX
               sValeurcombo est une chaine 
               commandetrn.btn_carrelage..etat = actif
               
               //si moimeme..modifie alors
               SI SANSESPACE(MOIMEME) = "" ALORS
               	carrelage_NOM = ""
               SINON		
               	si pas existe_produit(moimeme,"","carrelage") alors
               		
               		reprisesaisie()
               	SINON
               		//		si ValideEpaisseurSpacerPourCarrelage() alors
               		si moimeme..modifie alors
               			moimeme..modifie = faux
               			intPrixBaseModifie=Faux
               			intPrixCarreauModifie=Faux
               			calcul_prix_carr()
               			
               //			Combo_Barrotin = invent.DefaultBarrotin
               		FIN
               		si cdnumcarr <> lChaineOriginale  ou sansespace(carrelage_nom) = "" alors
               			
               			
               			selon langueclient
               				cas 0,1
               					CARRELAGE_NOM  = invent.idesc
               				cas 2
               					CARRELAGE_NOM  = invent.idescA
               			FIN
               		fin
               		
               		cdcodeglcarr  = invent.icodegl
               		methodecalculcarr = invent.itypecalculcarr
               		
               		si pas pascarrelagedefaut alors
               			commandetrn.fdimprimecarr = invent.imprimecarr
               		sinon
               			commandetrn.fdimprimecarr	= faux
               		fin 
               		commandetrn.trcalculescbasecarr = invent.iescbasecarr
               		//			si pas invent.isaisiedimension alors
               		si invent.isaisietotalcarreau alors
               			si commandetrn.facalcul = 1 alors
               				cherchecarrdim(complete(moimeme,10)+complete(commandetrn.cdlargeur,20)+caract(0))
               			sinon	
               				cherchecarrdim(complete(moimeme,10)+complete(commandetrn.fdlargeura,20)+caract(0))
               			FIN
               			//				cdcarreauv = invent.inbcarreaudefaut
               			//				cdcarreauh = 1
               			//Code WinDev 5.5 remplacé par la migration :
               			//				cdcarreauh..etat = actif
               			si champencours() = "CDNUMCARR" alors
               				cdcarreauh..etat = actif; cdcarreauh..Visible=Vrai
               			FIN
               		sinon
               			//Code WinDev 5.5 remplacé par la migration :
               			//				cdcarreauh..etat = actif
               			SI ChampEnCours() = "CDNUMCARR" ALORS
               				CDCARREAUH..Etat = Actif; CDCARREAUH..Visible=Vrai
               			FIN
               			
               		FIN
               		//	sinon
               		//		info("Carrelage invalide")
               		//	fin
               		
               	FIN
               	
               	
               FIN
               //FIN
               si client.CalculCarrPied alors
               	commandetrn.CDPRIXDEBASECARRELAGE..visible = faux
               sinon
               	commandetrn.CDPRIXDEBASECARRELAGE..visible = vrai
               	
               FIN
               
               SI PAS MODIF ALORS
               	si typecalcul = "" OU cdnumcarr <> lChaineOriginale ou OriginePersistant alors //MOIMEME..MODIFIE ALORS
               		
               		hlitrecherche(typecarr,tcdescription,remplir_combo_type(moimeme,fddemicarrelage))
               		commandetrn.fdvariablex = typecarr.VariableUtil
               		commandetrn.fdvariablex1= typecarr.VariableUtil1
               		
               		
               	fin
               	ExécuteTraitement(typecalcul,trtSélection)
               sinon
               	
               	si  MoiMême <> lChaineOriginale ou ChampEnCours() = "fddemicarrelage" alors
               		
               		hlitrecherche(typecarr,tcdescription,remplir_combo_type(moimeme,commandetrn.fddemicarrelage))
               		commandetrn.fdvariablex = typecarr.VariableUtil
               		commandetrn.fdvariablex1 = typecarr.VariableUtil1
               		commandeTRN.Combo_Barrotin = typecarr.TBarrotin
               	fin	
               	ExécuteTraitement(typecalcul,trtSélection)
               	
               FIN
               
               //commandetrn.typecalcul = valeurcombo
               //commandetrn.typecalcul = typecarr.tcdescription
               hlitrecherche(typecarr,tcdescription,typecalcul..ValeurAffichée)
