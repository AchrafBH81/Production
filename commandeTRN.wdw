          name : BTN_PRODUIT1
          identifier : 0x2afae3673d1361f2
          internal_properties : 
          properties :
           x : 110
           y : 129
           width : 26
           height : 22
          type : 4
          code_elements :
           type_code : 4
           p_codes :
            -
              code : |1-
               i est un entier
               nRes1 est un entier
               recNumber est un entier = HSauvePosition(trdetail)
               tabArgon est un tableau de chaînes
               tabCurrentArgon est un tableau de chaine
               ValeurdeRetour est une chaine = Ouvre(Liste_des_Thermos)
               chaineverstableau(ValeurdeRetour,tabArgon,",")
               cdqte = val(tabArgon[1])
               GetArgonExtraPrice(fclient)
               
               pour i = 2 _a_ tabArgon..Occurrence
               	ChaîneVersTableau(tabArgon[i],tabCurrentArgon,";")
               	si val(tabCurrentArgon[2]) = 1 alors
               		pour j = 1 a table_1..Occurrence
               			si table_1[j].tnorec = val(tabCurrentArgon[1]) alors
               				si hlitrecherche(trdetail,TRCLEUNIK,TABLE_1[j].Tnorec) alors
               					trdetail.CalculArgon = Vrai
               					trdetail.PietageArgon = Val(tabCurrentArgon[3]) //* trdetail.fdqteafacturer
               					trdetail.ExtraArgonPrice = grExtraArgonPrice
               					hmodifie(trdetail,hNumEnrEnCours)
               					
               					sortir
               				fin
               			fin
               			
               		fin
               	sinon
               		POUR j = 1 a table_1..Occurrence
               			SI TABLE_1[j].Tnorec = Val(tabCurrentArgon[1]) ALORS
               				SI HLitRecherche(trdetail,TRCLEUNIK,TABLE_1[j].Tnorec) ALORS
               					trdetail.CalculArgon = faux
               					trdetail.PietageArgon = 0 //* trdetail.fdqteafacturer
               					trdetail.ExtraArgonPrice = 0
               					HModifie(trdetail,hNumEnrEnCours)
               					
               					SORTIR
               				FIN
               			FIN
               			
               		FIN
               		
               	FIN
               FIN
               HRetourPosition(recNumber)
               
               //cdqte = ouvre(Liste_des_Thermos)
