  -
    name : BTN_AJOUT
    identifier : 0x514f7ee5783ec773
    internal_properties : 
    properties :
     x : 139
     y : 6
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         entete..etat = actif
         //VALIDATION..ETAT = ACTIF
         //Code WinDev 5.5 remplacé par la migration :
         //btn_annule..etat = actif
         btn_annule..etat = actif; btn_annule..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         //btn_trsp..VISIBLE = FAUX
         //btn_trsp..Visible=Faux
         //Code WinDev 5.5 remplacé par la migration :
         //btn_trspx..VISIBLE = FAUX
         //btn_trspx..Visible=Faux
         restaure_bouton()
         //Code WinDev 5.5 remplacé par la migration :
         //TABLE..ETAT = GRISé
         table..ETAT = GRISé; table..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         //FICHE..ETAT = GRISé
         FICHE..ETAT = GRISé; FICHE..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         //navigation..etat = grisé
         navigation..etat = grisé; navigation..Visible=Vrai
         fleche..etat = grise
         //BtnChangeMesure..ETAT = ACTIF
         GrpClientComptant..etat = inactif
         
         //Code WinDev 5.5 remplacé par la migration :
         //recherche..etat = inactif
         //recherche..etat = AffichageSeulement; recherche..Visible=Vrai
         ajout = vrai
         dmodif = faux
         NbVerresCommande = 0
         facalcul..Etat = actif
         commande_statut..largeur = 65
         //Code WinDev 5.5 remplacé par la migration :
         //commande_statut..colonne = 710
         //commande_statut..x = 710
         prochain_no_ligne = 0
         position_fichier = hsauveposition("Facture")
         //hlitdernier(facture,FACLEUNIK)
         //HModifie(facture,hNumEnrEnCours, hFixeIdAuto)
         //HRetourPosition(position_fichier)
         //position_fichier = hsauveposition("Facture")
         TotalCommandeAvantModif = 0
         pascarrelagedefaut = faux
         forme99defaut = faux
         raz(vrai)
         hraz("Facture")
         //hcreation("trdetail")
         hraz("trdetail")
         hsupprimetout(trdetail)
         
         TableauSupprimeTout(MessageTraiteLigne)
         
         
         raz_nom(vrai)
         LibelléPrixAnglais = ""
         commandetrn.image1 = ""
         commandetrn.fanumero = 0
         activefiltre()
         commandetrn.fadate = ladate
         //commandetrn.fclient = leclient
         commandetrn.commande_statut..libelle = "Ajout"
         commandetrn.fsurchargepeinture = 0
         commandetrn.CaseSurchargePeinture = faux
         //commandetrn.fanuméro = config.numcomm
         //config.numcomm = commandetrn.fanumero + 1
         //hmodifie("config")
         taille_originale_table1()
         //info(numeriqueverschaine(tableoccurrence("table_1")))
         
         ajout = vrai
         commandetrn.fclient..ETAT = ACTIF
         commandetrn.commandecredit..etat = actif
         
         execute("commandetrn.commandecredit..mod")
         //htransactiondebut("transaction.fac","FACTURE,FDETAIL")
         si ladate = "" alors
         	commandetrn.FADATE = DATESYS()
         fin	
         //Code WinDev 5.5 remplacé par la migration :
         //_onglet1..etat = actif
         
         MaFenetre..Plan=1
         VerifieAffichage()
         //remplir_escompte(vrai)
         	tablesupprimetout("TABLEQTE")
             tablesupprimetout("TABLE_PIED")
         
         ajoutdebut = vrai
         nouvellefacture = vrai
         messagelignedejaaffiche = faux
         TableauSupprimeTout(messagetraite)
         messagetotaldejaaffiche = faux
         MessageAAfficher = ""
         Maz_répétitif()
         BOUTONCOULEUR..etat = actif
         Mafenetre..titre = "Facture #0"
         reprisesaisie(fclient)
         
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_MODIFIE
    identifier : 0x514f7ee56328c773
    internal_properties : 
    properties :
     x : 176
     y : 6
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         
         si btn_modifie..visible = faux alors renvoyer Faux
         
         facalcul..etat = grise
         pascarrelagedefaut = faux
         forme99defaut = faux
         ModifieCommandedejatraitee = faux
         
         selon onglet1
         	cas 1
         		hlitrecherche(facture,fanumero,RequeteTablefacture.fanumero)
         		
         	cas 2
         		hlitrecherche(facture,fanumero,RequeteTableSoumission.fanumero)
         		
         fin
         //GetJoursLivraison()
         GetJoursLivraisonClient(client.idclient)
         messagetotaldejaaffiche = facture.messagedejaafiche
         TableauSupprimeTout(MessageTraite)
         SI PAS HEnDehors(facture) ALORS
         	//Code WinDev 5.5 remplacé par la migration :
         	//	si facture.futilise ou hdejabloque() alors
         	si facture.futilise ou HErreurBlocage() alors
         		acso_message("Information","Information déjà en utilisation sur un autre poste","Info")
         		
         	sinon
         		
         		FICHE..Etat = Grisé; FICHE..Visible=Vrai
         		si pas sansespace(facture.fpreparation) = "" alors
         			si sansespace(facture.fpreparation) = "B" alors
         				acso_message("Erreur","Cette commande fait partie d'un bon de livraison en attente d'être facturé"+rc+"Impossible de le modifier","Erreur")
         				renvoyer vrai
         			sinon si sansespace(facture.fpreparation) = "F" et SansEspace(facture.livrepartiel)= "P" 
         				ACSO_message("Erreur","Commande partiellement livrée"+rc+"Aucune modification permise","Erreur")
         				renvoyer vrai
         			sinon	
         				si acso_message("Question","Commande déja traitée, voulez-vous quand même la modifier","OuiNon") = idno alors
         					
         					renvoyer vrai
         				sinon
         					ModifieCommandedejatraitee = vrai
         				fin 
         			fin
         		fin
         		
         		selon onglet1
         			cas 1
         				ExécuteTraitement(table,trtSélection)
         				
         				table..etat = grise
         			cas 2
         				ExécuteTraitement(table1,trtSélection)
         				table1..etat = grise
         		fin
         		commande_statut..largeur = 65
         		//Code WinDev 5.5 remplacé par la migration :
         		//		commande_statut..colonne = 650
         		commande_statut..x = commande_statut..XInitial
         		commande_statut..libelle = "Modif"
         		//Code WinDev 5.5 remplacé par la migration :
         		//		navigation..etat = grisé
         		fleche..etat = grise
         		navigation..etat = grisé; navigation..Visible=Vrai
         		//Code WinDev 5.5 remplacé par la migration :
         		//		validation..etat = actif
         		validation..etat = actif; validation..Visible=Vrai
         		//Code WinDev 5.5 remplacé par la migration :
         		//		si btn_trsp..etat = grisé alors
         		//		si (btn_trsp..etat = grisé ET btn_trsp..Visible=Vrai) alors
         		//			//Code WinDev 5.5 remplacé par la migration :
         		//			//			btn_trsp..etat = actif
         		//			btn_trsp..etat = actif; btn_trsp..Visible=Vrai
         		//			
         		//		FIN
         		//Code WinDev 5.5 remplacé par la migration :
         		//		si btn_trspx..etat = grisé alors
         		//		si (btn_trspx..etat = grisé ET btn_trspx..Visible=Vrai) alors
         		//			//Code WinDev 5.5 remplacé par la migration :
         		//			//			btn_trspx..etat = actif
         		//			btn_trspx..etat = actif; btn_trspx..Visible=Vrai
         		//		FIN
         		//Code WinDev 5.5 remplacé par la migration :
         		//		fiche..etat = grisé
         		//BtnChangeMesure..ETAT = ACTIF
         		
         		modif = vrai
         		selon onglet1
         			cas 1
         				numenramodifier = hnumenr(facture)
         				
         			cas 2
         				numenramodifier = hnumenr(facture)
         				
         				
         		fin
         		
         		position_fichier=hsauveposition("Facture")
         		//Code WinDev 5.5 remplacé par la migration :
         		//        hlitbloque("Facture",numenramodifier)
         		hlit("Facture",numenramodifier,HBlocageEcriture)
         		facture.futilise = vrai
         		hmodifie("facture")
         		hdebloquenumenr("Facture",numenramodifier)
         		
         		//		htransactiondebut("transaction.fac","FACTURE,FDETAIL")
         		
         		
         		//remplir_escompte(vrai)
         		
         		HLITRECHERCHE("client","numero",commandetrn.fclient)
         		//Code WinDev 5.5 remplacé par la migration :
         		//        si h.trouve alors
         		si HTrouve() alors
         			si client.cactivationchampspecuaix alors
         				//Code WinDev 5.5 remplacé par la migration :
         				//			  decko..etat = actif	
         				decko..etat = actif; decko..Visible=Vrai	
         			FIN
         			TrouvePourcSurcharge()
         			si client.limiteCredit <> 0 alors TotalCommandeAvantModif = calculTotalCommandeAvecTaxe(RequeteTablefacture.fanumero)
         		FIN
         		
         		
         		si modeaffichage = "Tableau" alors
         			//Code WinDev 5.5 remplacé par la migration :
         			//			entete..etat = actif
         			entete..etat = actif; entete..Visible=Vrai
         			facalcul..etat = grise
         			commandetrn.fclient..etat = actif
         			//Code WinDev 5.5 remplacé par la migration :
         			//			fiche_det..etat = actif
         			fiche_det..etat = actif; fiche_det..Visible=Vrai
         			//			SI ModifieCommandedejatraitee ALORS
         			//				fadate..Etat = Grisé
         			//				Fdaterequise..Etat = Grisé
         			//			FIN
         			SI commandeTRN.CaseAdresseManuelle ALORS
         				GrpLivraison..Etat = Actif
         				Combo_Livraison1..Etat = Inactif 
         			SINON 
         				GrpLivraison..Etat = AffichageSeulement
         				Combo_Livraison1..Etat = Actif 
         			FIN
         			reprisesaisie("fclient")
         			
         			
         		sinon
         			//Code WinDev 5.5 remplacé par la migration :
         			//			fiche_det..etat = actif
         			fiche_det..etat = actif; fiche_det..Visible=Vrai
         			EnteteModifiable..etat = actif;EnteteModifiable..visible = vrai
         			//Code WinDev 5.5 remplacé par la migration :
         			//			_onglet2..etat = actif
         			MaFenetre..Plan=2
         			taille_originale_table1()
         //			VerifieAffichage()
         			//Code WinDev 5.5 remplacé par la migration :
         			//			table_1..etat = inactif
         			table_1..etat = AffichageSeulement; table_1..Visible=Vrai
         			//Code WinDev 5.5 remplacé par la migration :
         			//			TableAffiche("Table_1","I")
         			//			TableAffiche("Table_1",taDebut)
         			langueclient = client.CLangue
         			
         			//			SI ModifieCommandedejatraitee ALORS
         			//				fadate..Etat = Grisé
         			//				Fdaterequise..Etat = Grisé
         			//			FIN
         		FIN
         		
         		
         	fin
         FIN
         
         //	erreur(MessTraduit(2011))   //2011:Cette commande à été traitée , impossible de la modif...
         //fin
         
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_DETRUIRE
    identifier : 0x514f7ee50c78c773
    internal_properties : 
    properties :
     x : 216
     y : 6
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         restaure_bouton()
         totalcommandepourlimite est une reel
         
         selon onglet1
         	cas 1	
         		si facture.futilise alors
         			acso_message("Information","Information déjà en utilisation sur un autre poste","Info")
         		sinon
         			si Commandeasupprimer(RequeteTablefacture.fanumero) alors
         				si acso_message("Question","Voulez-vous supprimer cette commande","OuiNon") = idyes aLORS
         					
         					
         					
         					si hlitrecherche(Facture,fanumero,RequeteTablefacture.fanumero) alors
         						
         						SI facture.fatypedocument <> 3 _ET_ Client.limiteCredit > 0 ALORS
         							totalcommandepourlimite = calculTotalCommandeAvecTaxe(facture.fanumero) 
         							Client.TotalCommande -= totalcommandepourlimite
         							Client.SoldeDisponible += totalcommandepourlimite
         							HModifie(Client,hNumEnrEnCours)
         						FIN
         						
         						
         						
         						
         						
         						HLITRECHERCHE("fdetail","fdnocomm",facture.fanumero)
         						//Code WinDev 5.5 remplacé par la migration :
         						//	tantque h.trouve 
         						tantque HTrouve() 
         							hsupprime("fdetail")
         							hlitsuivant
         						FIN
         						
         						si hlitrecherche(tracking,InvoiceNumber,sansespace(facture.fanumero)) alors
         							hsupprime(tracking,hNumEnrEnCours)
         						FIN
         						hsupprime(facture)
         						
         						RemplirTableFacture()
         					fin
         					
         					tableaffiche("TABLE",taCourantBandeau)
         					ExecuteTraitement("table",trtENTREELIGNE)
         					si table..vide  alors
         						raz(vrai)
         						
         					FIN
         				FIN
         			sinon
         				ACSO_message("Erreur","Cette commande à encore un ou plusieurs bon(s) de livraison non facturé","Erreur")
         			fin
         		fin		
         	cas 2
         		si acso_message("Question","Voulez-vous supprimer les soumissions sélectionnées ?","OuiNon") = idyes aLORS
         
         
         			i est un entier
         
         			POUR i = 1 _À_ TableSelectOccurrence(TABLE1)
         				SI HLitRecherche(Facture,fanumero,TABLE1.FANUMERO_11[TableSelect(TABLE1, i)]) ALORS
         					HLitRecherche("fdetail","fdnocomm",Facture.fanumero)
         
         
         					TANTQUE HTrouve() 
         						HSupprime("fdetail")
         						HLitSuivant
         					FIN
         				
         					hsupprime(Facture,hNumEnrEnCours)
         
         				fin
         			FIN
         						TableSupprime(TABLE1)		
         			
         
         			ExecuteTraitement("table1",trtENTREELIGNE)
         			si table1..vide  alors
         				raz(vrai)
         				
         			FIN
         			
         		FIN
         fin	
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_AJOUT_DET
    identifier : 0x514f7ee50e19c773
    internal_properties : 
    properties :
     x : 739
     y : 135
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         SI PAS BTN_VERT..Visible ALORS ExécuteTraitement(BTN_ROUGE,trtClic)
         numeroenregistrement est un entier
         produitdebase1 = ""
         produitdebase2 = ""
         produitdebase3 = ""
         
         restaure_bouton()
         //Code WinDev 5.5 remplacé par la migration :
         //commande_detail..etat = actif
         commande_detail..etat = actif; commande_detail..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         //commande_carrelage..etat = grisé
         commande_carrelage..etat = grisé; commande_carrelage..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         //fiche_det..etat = grisé
         fiche_det..etat = grisé; fiche_det..Visible=Vrai
         //Code WinDev 5.5 remplacé par la migration :
         //validation..etat = grisé
         validation..etat = grisé; validation..Visible=Vrai
         premierefois = vrai
         originepersistant = Faux
         
         //Code WinDev 5.5 remplacé par la migration :
         //boutoncouleur..etat = grisé
         //boutoncouleur..etat = grisé; boutoncouleur..Visible=Vrai
         //position_fichier = hsauveposition("fdetail")
         //Code WinDev 5.5 remplacé par la migration :
         //hlitderniersansbloquer("trdetail","fdcle")
         hlitdernier("trdetail","fdcle")
         //Code WinDev 5.5 remplacé par la migration :
         //si hdejabloque() alors
         si HErreurBlocage() alors
         	//info(h.niveau)
         fin	 
         //numeroenregistrement = h.numenr
         //si numeroenregistrement > 0 alors
         //	si pas hdebloquenumenr("trdetail",numeroenregistrement) alors
         //	fin
         	
         //fin
         
         //tableaffiche("TABLE_1","P")
         si trdetail.fdnocomm = Facture.fanumero alors
         	prochain_no_ligne = trdetail.fdligne
         fin
         
         //hretourposition(position_fichier)
         //Code WinDev 5.5 remplacé par la migration :
         //table_1..etat = grisé
         table_1..etat = grisé; table_1..Visible=Vrai
         DMODIF = FAUX
         taille_originale_table1()
         //BOUTONCOULEUR..etat = actif
         escompteqte = faux
         fraismontage = 0
         hraz("trdetail")
         fichierversecran("commandetrn","trdetail")
         
         
         raz_nom()
         si pas ensemblepersoactif alors
         	//Code WinDev 5.5 remplacé par la migration :
         	//  btn_ensemble..etat = grisé	
         	btn_ensemble..etat = grisé; btn_ensemble..Visible=Vrai	
         FIN
         descriptionoriginale = ""
         typeunite = 0
         messagelignedejaaffiche = faux
         TableauSupprimeTout(MessageTraite)
         reprisesaisie("cdnumprod")
         
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_MODIFIE_DET
    identifier : 0x514f7ee56c98c773
    internal_properties : 
    properties :
     x : 739
     y : 173
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         si pas btn_vert..visible alors ExécuteTraitement(btn_rouge,trtclic)
         gTablePosition = TableSauvePositionEtSélection(TABLE_1)
         ltypededocument est un entier
         si ttype = 0 alors
         	si hlitrecherche(invent,INUM,table_1.FDNUMPROD[table_1]) alors
         		ltypededocument = invent.itype
         	FIN
         sinon
         	ltypededocument = ttype	
         FIN
         si ltypededocument = 0 alors
         	acso_message("Erreur","Impossible de récupérer le type de produit à modifier","Erreur")
         	renvoyer vrai
         FIN
         
         restaure_bouton()
         dmodif					= vrai
         commande_detail..etat	= actif; commande_detail..Visible=Vrai
         fiche_det..etat			= grisé; fiche_det..Visible=Vrai
         validation..etat		= grisé; validation..Visible=Vrai
         premierefois			= faux
         taille_originale_table1()
         hlit("trdetail",tablenumenr("TABLE_1"))
         messagelignedejaaffiche = trdetail.FDmessageAffiche
         si HErreurBlocage() alors
         	acso_message("Erreur","Information déjà en utilisation","Erreur")
         	
         FIN
         
         TABLE_1..ETAT = GRISé; TABLE_1..Visible=Vrai
         si pas trdetail.fdlien = 0 alors
         	si table_1 = tableoccurrence("table_1") et trdetail.fdlien = tligne alors  
         		ExecuteTraitement("table_1",TRTlectureSuivant)
         		tableaffiche("TABLE_1",taCourantBandeau)
         		ExecuteTraitement("table_1",TRTlectureprecedent)
         		tableaffiche("TABLE_1",taCourantBandeau)
         	fin
         	fichierversecran("commandetrn","trdetail")
         	wfw			= trdetail.fdw
         	wfw1		= trdetail.fdw1
         	wfw2		= trdetail.fdw2
         	wfh			= trdetail.fdh
         	wfh1		= trdetail.fdh1
         	wfh2		= trdetail.fdh2
         	wfd			= trdetail.fdd
         	wfr			= trdetail.fdr
         	wfr1		= trdetail.fdr1
         	wfr2		= trdetail.fdr2
         	wfs			= trdetail.fds
         	wff			= trdetail.fdf
         	
         	recupere_donnee()
         	
         sinon
         	
         	fichierversecran("commandetrn","trdetail")
         	wfw			= trdetail.fdw
         	wfw1		= trdetail.fdw1
         	wfw2		= trdetail.fdw2
         	wfh			= trdetail.fdh
         	wfh1		= trdetail.fdh1
         	wfh2		= trdetail.fdh2
         	wfd			= trdetail.fdd
         	wfr			= trdetail.fdr
         	wfr1		= trdetail.fdr1
         	wfr2		= trdetail.fdr2
         	wfs			= trdetail.fds
         	wff			= trdetail.fdf
         		remplir_combo_type(commandetrn.CDNUMCARR,commandetrn.fddemicarrelage)
         	si Combo_typespac = 0 alors
         		listeselectplus(Combo_typespac,1)
         	FIN
         	//si commandetrn.facalcul = 2 alors
         	cdlargeur		= trdetail.fdlargeur
         	cdhauteur		= trdetail.fdhauteur
         	cdhauteur1		= trdetail.fdhauteur1
         	
         fin
         cdnumprod..modifie = faux
         BTN_ShowShapedata..Visible = (fdforme <> "")  
         si ttype = 0 alors
         	si hlitrecherche(invent,INUM,table_1.FDNUMPROD[table_1]) alors
         		ltypededocument = invent.itype
         	FIN
         sinon
         	ltypededocument = ttype	
         FIN
         si ltypededocument = 0 alors
         	acso_message("Erreur","Impossible de récupérer le type de produit à modifier","Erreur")
         	renvoyer vrai
         FIN
         
         clicbouton = faux
         //execute("cdnumprod..Sor")
         execute("cdcarrelage..mod")
         si pas trdetail.fdverreunite alors
         	si hlitrecherche(invent,INUM,table_1.FDNUMPROD[table_1]) alors
         		typeunite = invent.iunitetype
         	FIN
         sinon
         	typeunite = 2
         fin
         
         selon ltypededocument
         	cas 1
         		typedeproduit = "Verre"
         		si CDVERREUNITE alors griser_saisie(3)
         	cas 2
         		si typeunite = 2 alors
         			//					si invent.iunitetype = 2 alors
         			griser_saisie(11)
         			typedeproduit	= "Verreunite"   // a verifier
         			cdverreunite	= vrai
         		sinon
         			
         			griser_saisie(2)
         			typedeproduit = "Unite"
         		fin
         	cas 3
         		griser_saisie(2)	
         	cas 4
         		griser_saisie(4)
         		typedeproduit = "Carrelage"
         	cas 5
         		commandetrn.typedeproduit = "Peinture"
         		hlitrecherche(invent,INUM,fdnumprod)
         		selon invent.iUniteMesure
         			cas 1
         				griser_saisie(2)
         			cas 2,3
         				griser_saisie(1)
         			cas 4
         				griser_saisie(24)
         		fin
         		affichePeinture()
         	autres cas		
         		
         fin
         si pas ensemblepersoactif alors
         	//Code WinDev 5.5 remplacé par la migration :
         	//  btn_ensemble..etat = grisé	
         	btn_ensemble..etat = grisé; btn_ensemble..Visible=Vrai	
         FIN
         si trdetail.FDextra10X <> 0 alors
         	commandetrn.fdextra10x..visible = vrai
         sinon
         	commandetrn.fdextra10x..visible = faux
         FIN
         si trdetail.FDextra5X <> 0 alors
         	commandetrn.fdextra5x..visible = vrai
         sinon
         	commandetrn.fdextra5x..visible = faux
         FIN
         commandetrn.pdebase = trdetail.fdbase
         
         DefenirTypeVerre()
         
         REPRISESAISIE("cdnumprod")
         
         
         //info("Modification")
         
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_DETRUIRE_DET
    identifier : 0x514f7ee54b57c773
    internal_properties : 
    properties :
     x : 739
     y : 216
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         SI PAS BTN_VERT..Visible ALORS ExécuteTraitement(BTN_ROUGE,trtClic)
         restaure_bouton()
         
         si pas lien = 0  alors
         
         	si pas lien = tligne alors
         		si acso_message("Suppression","Voulez-vous supprimer cette ligne ?","OuiNon") = idyes
         			supprime_ligne("carrelage")
         		fin
         
         	sinon
         		si acso_message("Suppression","Voulez-vous supprimer cette ligne ainsi que le carrelage correspondant ?","OuiNon") = idyes
         			supprime_ligne("principal")
         			fin
         		FIN
         
         	sinon
         		si acso_message("Suppression","Voulez-vous supprimer cette ligne ?","OuiNon") = idyes
         			supprime_ligne("unique")
         		fin
         	fin		
         
         	calculTotalCommande()
        type : 18
      -
        type : 161
        enabled : false
