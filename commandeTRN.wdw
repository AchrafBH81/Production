      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] getdefaultcamion (<IdLivraison> est entier)
      //
      // Paramètres :
      //	IdLivraison (entier) : <indiquez ici le rôle de Combo_Livraison1>
      // Valeur de retour :
      // 	Type indéterminé : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE getdefaultcamion(IdLivraison est un entier)
      
      si IdLivraison = -1 alors
      	si hlitrecherche(Client,numero,fclient) alors
      		renvoyer client.IdDefaultCamion
      	FIN
      sinon
      	si hlitrecherche(ClientLivraison,IDClientLivraison,IdLivraison) alors
      		si ClientLivraison.lJourCamionMaster alors
      			SI HLitRecherche(Client,numero,FCLIENT) ALORS
      				RENVOYER Client.IdDefaultCamion
      			FIN
      		sinon
      			renvoyer clientlivraison.IdDefaultCamion	
      		fin
      	FIN
      FIN
      
      renvoyer -1
     type : 458752
   -
     name : checkIfTermos
     procedure_id : 2150135056318249588
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] checkIfTermos (<NoCommande> est entier)
      //
      // Paramètres :
      //	NoCommande (entier) : <indiquez ici le rôle de NoCommande>
      // Valeur de retour :
      // 	booléen : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE checkIfTermos(NoCommande est un entier)
      
      
      SI HLitRecherche(Facture,fanumero,NoCommande) ALORS
      	HLitRecherche(Fdetail,fdnocomm,Facture.fanumero)
      	TANTQUE Fdetail.fdnocomm = Facture.fanumero _ET_ PAS HEnDehors(Fdetail) 
      		SI Fdetail.ftype = 1 ALORS RENVOYER Vrai
      		HLitSuivant(Fdetail,fdnocomm)
      	FIN
      	
      FIN
      
      RENVOYER Faux
     type : 458752
   -
     name : SendOrderToShippingBill
     procedure_id : 2150139742221131648
     type_code : 14
     code : |1-
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] SendOrderToShippingBill (<NoCommande> est entier)
      //
      // Paramètres :
      //	NoCommande (entier) : <indiquez ici le rôle de NoCommande>
      // Valeur de retour :
      // 	Type indéterminé : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE SendOrderToShippingBill(local NoCommande est une entier)
      lNumEnr est un entier
      nUmerofacture est un entier
      nNextOrderNumber est un entier
      si hlitrecherche(facture,fanumero,NoCommande) alors
      	
      	BOUCLE
      		nNextOrderNumber	= GetNextShippingBillNumber()
      		SI nNextOrderNumber = 0 ALORS 
      			SI ACSO_message("Question","Impossible d'assigner un numéro de Bon de livraison"+RC+"Essayer de nouveau","OuiNon")=IDNO ALORS 
      				renvoyer faux
      			FIN
      		SINON
      			SORTIR
      		FIN
      	FIN
      //	lNumEnr = hnumenr(facture)
      //	HLit(config,1)
      //	numerofacture = config.NumBL
      //	config.NumBL++
      //	HModifie(config,1)
      	HRAZ(BonLivraison)
      	OrderToShippingBill()
      	BonLivraison.BnoCommande =hfacture.fanumero
      	BonLivraison.Bclient = hfacture.faclient
      	BonLivraison.bdate = hfacture.fadatecommande
      	BonLivraison.Bnumero = nNextOrderNumber
      	BonLivraison.bstotal = hfacture.fatotal
      	BonLivraison.BCommandeClient = hfacture.fanocommande
      	//		bonlivraison.btvh = hfacture.fatps
      	//		bonlivraison.bTauxTvh = config.tauxtps
      	//		bonlivraison.bTauxTvq = config.tauxtvq
      	
      	BonLivraison.btvh = hfacture.fatps
      	BonLivraison.bTauxTvh = hfacture.fatps
      	BonLivraison.bTauxTvq = hfacture.fatvq
      	BonLivraison.bTauxTaxe1 = hfacture.fatps
      	BonLivraison.bTauxTaxe2 = hfacture.fatvq		
      	
      	
      	BonLivraison.brien = NumériqueVersChaîne(hfacture.fatypedocument)
      	BonLivraison.cvendeur = hfacture.cvendeur
      	HAjoute(BonLivraison)
          facture.ConfirmationSended = Vrai
          hmodifie(Facture,hNumEnrEnCours)
      	RENVOYER(BonLivraison.Bnumero)
      SINON
          RENVOYER 0 
      fin
      
      	procedure interne OrderToShippingBill()
      
      	MajHistoriqueBL()
      
      	HLit("Facture",lNumEnr)
      	Facture.FPREPARATION = "B"
      	HModifie("facture")	
      	
      	
      		Procedure interne MajHistoriqueBL()
      		
      		HGèreIntégrité(Faux)
      		
      		multiplicateur est un entier
      		HLit("Facture",lNumEnr)
      		SI Facture.fatypedocument  = 2 ALORS
      			multiplicateur = -1
      		SINON
      			multiplicateur = 1	
      		FIN
      		hfacture.ftransfere      = Faux
      		hfacture.fanumero        = Facture.fanumero
      		hfacture.fadate          = Facture.fadatefacture
      		hfacture.fadatecommande  = Facture.fadate
      		hfacture.fatype          = Facture.fatype
      		hfacture.faclient        = Facture.faclient
      		hfacture.Bnumero         = nNextOrderNumber
      		hfacture.fanofacture     = nNextOrderNumber
      		hfacture.fanojob         = Facture.fanojob
      		hfacture.fanocommande    = Facture.fanocommande
      		hfacture.fasecteur       = Facture.fasecteur
      		hfacture.facalcul        = Facture.facalcul
      		hfacture.fasurcharge     = Facture.fasurcharge 
      		hfacture.fatotal         = Facture.fatotal     
      		hfacture.fatps           = Facture.fatps       
      		hfacture.fatvq           = Facture.fatvq       
      		hfacture.fatypedocument  = Facture.fatypedocument
      		hfacture.fareference     = Facture.fareference
      		hfacture.fabonlivraison  = Facture.fabonlivraison
      		hfacture.fafraistransport= Facture.fafraistransport * multiplicateur
      		hfacture.nom 			 = Facture.nom
      		hfacture.Adresse 		 = Facture.adresse
      		hfacture.Ville 			 = Facture.ville
      		hfacture.CodePostal		 = Facture.CodePostal
      		hfacture.noTelephone	 = Facture.noTelephone
      		hfacture.ftypecredit     = Facture.Ftypecredit
      		hfacture.cvendeur        = Facture.cvendeur
      		hfacture.lNom 			 = Facture.lNom
      		hfacture.lRue 			 = Facture.lRue
      		hfacture.lVille 		 = Facture.lVille
      		hfacture.lCodePostal 	 = Facture.lCodePostal
      		hfacture.lAdresseManuelle=Facture.lAdresseManuelle
      		hfacture.lNote            = Facture.lNote
      		hfacture.IdPurchaseOrderEdi = Facture.IdPurchaseOrderEdi
      		hfacture.IdEdiKey           = Facture.IdEdiKey
      		hfacture.IDCamions    = Facture.IDCamions
      		
      		//hfacture.surchargeTauxPourc = facture.surchargeTauxPourc
      		//SI config.SUrchargeTauxActive ALORS
      			SI gclconfig.m_bSUrchargeTauxActive ALORS
      				SI HLitRecherche(Client,numero,hfacture.faclient) _ET_ Client.SUrchargeTaux ALORS
      				SI Client.CSurchargeTauxBase <> 0 ALORS
      					hfacture.surchargeTauxPourc = Client.CSurchargeTauxBase
      				SINON
      		//			hfacture.surchargeTauxPourc = config.SurChargeTauxBase
      					hfacture.surchargeTauxPourc = gclconfig.m_rSurChargeTauxBase
      				FIN	
      			SINON
      				hfacture.surchargeTauxPourc = 0
      			FIN
      		FIN
      		
      		HAjoute("hfacture")
      		//Code WinDev 5.5 remplacé par la migration :
      		//si hdoublon() alors
      		SI HErreurDoublon() ALORS
      			Erreur("Impossible d'ajouter la facture "+NumériqueVersChaîne(Facture.fanofacture,"10d"))
      			RENVOYER Vrai
      		FIN
      		
      		
      		HLitRecherche("fdetail","fdnocomm",Facture.fanumero)
      		
      		//Code WinDev 5.5 remplacé par la migration :
      		//tantque fdetail.fdnocomm = facture.fanumero et pas h.endehors
      		TANTQUE Fdetail.fdnocomm = Facture.fanumero ET PAS HEnDehors()
      			
      			SI Fdetail.fdqteafacturer <> 0 ALORS  
      			
      				
      				hfdetail.fdnocomm       = Facture.fanumero
      				hfdetail.fdligne        = Fdetail.fdligne
      				hfdetail.fdnumprod      = Fdetail.fdnumprod
      				hfdetail.fddesc         = Fdetail.fddesc
      				hfdetail.fdqte          = Fdetail.fdqte
      				hfdetail.fdqteafacturer = Fdetail.fdqteafacturer  * multiplicateur
      		//		hfdetail.fdqtedejafacture = Fdetail.fdqtedejafacture  * multiplicateur
      				hfdetail.fdqtedejafacture = Fdetail.fdqtedejafacture  * multiplicateur
      				hfdetail.fdespace       = Fdetail.fdespace
      				hfdetail.fdlargeur      = Fdetail.fdlargeur
      				hfdetail.fdhauteur      = Fdetail.fdhauteur
      				hfdetail.fdhauteur1     = Fdetail.fdhauteur1
      				hfdetail.fdlargeura     = Fdetail.fdlargeura
      				hfdetail.fdhauteura     = Fdetail.fdhauteura
      				hfdetail.fdhauteur1a    = Fdetail.fdhauteur1a
      				hfdetail.fdprixu        = Fdetail.fdprixu
      				hfdetail.fdcarrelage    = Fdetail.fdcarrelage
      				hfdetail.fdcarreauh     = Fdetail.fdcarreauh
      				hfdetail.fdcarreauv     = Fdetail.fdcarreauv
      				hfdetail.fdnumcarr      = Fdetail.fdnumcarr
      				hfdetail.ftype          = Fdetail.ftype
      				hfdetail.fdprixtotal    = Fdetail.fdprixtotal
      				hfdetail.fdcarrpruxuc   = Fdetail.fdcarrpruxuc
      				hfdetail.frcarrprixu    = Fdetail.frcarrprixu * multiplicateur
      				hfdetail.fdcarrprixtotal= Fdetail.fdcarrprixtotal * multiplicateur
      				hfdetail.fdprixupied    = Fdetail.fdprixupied
      				hfdetail.fdcodegl       = Fdetail.fdcodegl
      				hfdetail.fcapgaztube    = Fdetail.fcapgaztube 
      				hfdetail.fdverreunite   = Fdetail.fdverreunite
      				hfdetail.fdnofact       = nNextOrderNumber
      				hfdetail.FDJOBLIGNE      = Fdetail.FDJOBLIGNE
      				hfdetail.fdcomposant1    =Fdetail.fdcomposant1
      				hfdetail.fdcomposant2    =Fdetail.fdcomposant2
      				hfdetail.fdcomposant3    =Fdetail.fdcomposant3
      				hfdetail.fdcarrprixdebase=Fdetail.fdcarrprixdebase * multiplicateur
      				hfdetail.surchargeenergie=Fdetail.surchargeenergie  * multiplicateur
      				hfdetail.fdcommentaire   = Fdetail.fdcommentaire
      				hfdetail.fdlargeuru      = Fdetail.fdlargeuru
      				hfdetail.fdhauteuru      = Fdetail.fdhauteuru
      				hfdetail.fdforme         = Fdetail.fdforme
      				hfdetail.fdextraforme    = Fdetail.fdextraforme //* MULTIPLICATEUR
      				hfdetail.HFCLEUNIK       = hfacture.HFCLEUNIK
      				hfdetail.ffini           = Fdetail.ffini 
      				hfdetail.fdhauteuranglais=Fdetail.fdhauteuranglais
      				hfdetail.fdhauteuranglais1=Fdetail.fdhauteuranglais1
      				
      				hfdetail.fdlargeuranglais=Fdetail.fdlargeuranglais
      				hfdetail.fdpiedcarre     = Fdetail.fdpiedcarre
      				hfdetail.fdpiedcarrefacture=Fdetail.fdpiedcarrefacture
      				hfdetail.ftypespacer       = Fdetail.ftypespacer
      				hfdetail.FDespace2         = Fdetail.FDespace2
      				hfdetail.fdprixupiedfacture=Fdetail.fdprixupiedfacture
      				hfdetail.FDExtraCap       = Fdetail.FDEXTRACAP //* MULTIPLICATEUR 
      				hfdetail.Fnotes           = Fdetail.fnotes
      				hfdetail.fdnbcarreau      = Fdetail.fdnbcarreau
      				
      				/////////////////////////////////////////
      				
      				hfdetail.fTypePeinture         = Fdetail.fTypePeinture
      				hfdetail.fNoPeintureExtTout     = Fdetail.fNoPeintureExtTout
      				hfdetail.FnopeintureInterieure     = Fdetail.FnopeintureInterieure
      				hfdetail.fdescpeintureExtTout    = Fdetail.fdescpeintureExtTout
      				hfdetail.fDescPeintureInterieure    = Fdetail.fDescPeintureInterieure
      				hfdetail.fTotalPeinture             = Fdetail.fTotalPeinture
      				hfdetail.fPrixCarreauPeinture      = Fdetail.fPrixCarreauPeinture
      				hfdetail.Ftotalcarreaupeinture     = Fdetail.Ftotalcarreaupeinture
      				hfdetail.fpeinture                  = Fdetail.fpeinture
      				hfdetail.libelleNbCarreauExtTlt     = Fdetail.libelleNbCarreauExtTlt
      				hfdetail.libelleNbcarreauinterieur     = Fdetail.libelleNbcarreauinterieur
      				hfdetail.FtotalbarrePeinture     = Fdetail.FtotalbarrePeinture
      				hfdetail.fnopeinture = Fdetail.fnopeinture
      				hfdetail.fdescpeinture = Fdetail.fdescpeinture
      				hfdetail.fextrapeinture = Fdetail.fextrapeinture
      				hfdetail.FDescpeinture1 = Fdetail.FDescpeinture1
      				hfdetail.ftypepeinture1     = Fdetail.ftypepeinture1
      				hfdetail.fnopeinture1 = Fdetail.fnopeinture1
      				hfdetail.FDnbcarreauPeinture1 = Fdetail.FDnbcarreauPeinture1
      				hfdetail.fdprixcarreaupeinture1 = Fdetail.fdprixcarreaupeinture1
      				hfdetail.fdfabrication = Fdetail.FDfabrication
      				hfdetail.SUrchargeafacturer = Fdetail.SUrchargeafacturer
      				hfdetail.surchargeenergie = Fdetail.SUrchargeafacturer
      				hfdetail.SUrchargedejafacture = Fdetail.SUrchargedejafacture
      				hfdetail.FDextra10X=Fdetail.FDextra10X
      				hfdetail.FDextra5x=Fdetail.FDextra5x
      				hfdetail.TDemiCarrelage = Fdetail.TDemiCarrelage
      				hfdetail.FDextraCarrelagedemi = Fdetail.FDextraCarrelagedemi
      				hfdetail.fdpiedcarrefacture = Fdetail.fdpiedcarrefacture
      				hfdetail.fdsurfacemodifie = Fdetail.fdsurfacemodifie
      				hfdetail.FDprixmodifie = Fdetail.FDprixmodifie
      				hfdetail.ExtraArgonPrice = Fdetail.ExtraArgonPrice
      				hfdetail.CalculArgon = Fdetail.CalculArgon
      				hfdetail.PietageArgon = Fdetail.PietageArgon
      				hfdetail.fdbase = fdetail.fdbase
      				hfdetail.fnolot = fdetail.fnolot
      				///////////////////////////////////////////////////////////////////////////////////
      				
      				HAjoute("hfdetail")
      				
      				Fdetail.fdqtedejafacture =  Fdetail.fdqtedejafacture + Fdetail.fdqteafacturer
      				Fdetail.fdqteafacturer = Fdetail.fdqte - Fdetail.fdqtedejafacture
      				HModifie(Fdetail,hNumEnrEnCours)
      				
      				
      			FIN
      			HLitSuivant("fdetail","fdnocomm")
      			
      		FIN
      		
      		HGèreIntégrité(Vrai)
      		
      		
      		FIN
      	FIN
     type : 458752
   -
     name : miseajour_fdetail
     procedure_id : 5859041164133779265
     type_code : 14
     code : |1+
      Procédure miseajour_fdetail(selontypedeproduit)
      lignecourante est un entier
      lignenouvelle est un entier
      lignelien  est un entier
      //ladate est une chaine = commandetrn.fadate	
      trdetail.traye = 0
      trdetail.ftype = selontypedeproduit
      _fdlargeur est une chaine = ""
      _fdhauteur est une chaine = ""
      _fdhauteur1 est une chaine = ""
      _fdlargeura est une chaine = ""
      _fdhauteura est une chaine = ""
      _fdhauteur1a est une chaine = ""
      
      SI DMODIF = VRAI  alors
      	
      	ecranversfichier("commandetrn","trdetail")
      	maj_forme(faux)
      	trdetail.fdqteafacturer = commandetrn.cdqte
      	trdetail.fdvariablex1 = commandetrn.fdvariablex1
      	si sansespace(trdetail.fNoPeintureExtTout) <> "" ou sansespace(trdetail.FnopeintureInterieure) <> "" alors
      		trdetail.fpeinture = vrai
      	sinon
      		trdetail.fpeinture = faux   	
      	FIN
      	trdetail.SUrchargeafacturer=commandetrn.surchargeenergie
      	Hmodifie("trdetail")
      	_fdlargeur = trdetail.fdlargeur
      	_fdhauteur = trdetail.fdhauteur
      	_fdhauteur1 = trdetail.fdhauteur1
      	_fdlargeura = trdetail.fdlargeura
      	_fdhauteura = trdetail.fdhauteura
      	_fdhauteur1a = trdetail.fdhauteur1a
      	
      	si trdetail.fdcarrelage  alors
      		
      		
      		si pas trdetail.fdlien = 0 alors   
      			hlit("trdetail",numeroenr)
      			trdetail.fdcarrprixtotal = commandetrn.cdcarrprixtotal
      			trdetail.fdligne = numeroligne
      			trdetail.fdnumprod = commandetrn.cdnumcarr
      			trdetail.fdcodegl  = commandetrn.cdcodeglcarr
      			trdetail.fddesc  = commandetrn.carrelage_nom
      			trdetail.ftype   = 4
      			trdetail.fdqte   = commandetrn.cdqte
      			trdetail.fdimprimecarr =  commandetrn.fdimprimecarr
      			si commandetrn.facalcul = 1 alors
      				trdetail.fdlargeur = _fdlargeur
      				trdetail.fdhauteur = _fdhauteur
      				trdetail.fdhauteur1 = _fdhauteur1
      				trdetail.fdlargeura = _fdlargeura
      				trdetail.fdhauteura = _fdhauteura
      				trdetail.fdhauteur1a = _fdhauteur1a
      				//				fdetail.fdlargeura = fdetail.fdlargeur
      				//				fdetail.fdhauteura = fdetail.fdhauteur
      				//				fdetail.fdhauteur1a = fdetail.fdhauteur1
      			sinon
      				//				trdetail.fdlargeur = trdetail.fdlargeur
      				//				trdetail.fdhauteur = trdetail.fdhauteur
      				//				trdetail.fdhauteur1 = trdetail.fdhauteur1
      				trdetail.fdlargeur = _fdlargeur
      				trdetail.fdhauteur = _fdhauteur
      				trdetail.fdhauteur1 = _fdhauteur1
      				trdetail.fdlargeura = _fdlargeura
      				trdetail.fdhauteura = _fdhauteura
      				trdetail.fdhauteur1a = _fdhauteur1a
      			fin	
      			
      			trdetail.fdcomposant1 = ""
      			trdetail.fdcomposant2 = ""
      			trdetail.fdcomposant3 = ""
      			trdetail.surchargeenergie = 0
      			trdetail.fdprixu = commandetrn.cdcarrprixu
      			trdetail.fdprixtotal = commandetrn.cdcarrprixtotal
      			trdetail.fdcodegl    = commandetrn.cdcodeglcarr
      			trdetail.fdbase = commandetrn.pdebase
      			//			trdetail.fdprixupied  = commandetrn.cdcarrprixtotal  // 2002/03/19
      			trdetail.fdqteafacturer = commandetrn.cdqte
      			trdetail.fdcarrpruxuc = commandetrn.CDCARRPRIXUC
      			trdetail.frcarrprixu = commandetrn.CDCARRPRIXU
      			trdetail.fdcarreauh = commandetrn.CDCARREAUH
      			trdetail.fdcarreauv = commandetrn.CDCARREAUv
      			trdetail.fdtypecalcul = commandetrn.typecalcul
      			trdetail.fdcarrprixdebase = commandetrn.CDPRIXDEBASECARRELAGE
      			trdetail.fdnumcarr = commandetrn.cdnumcarr
      			trdetail.FDdesccarr = commandetrn.CARRELAGE_NOM
      			trdetail.fdvariablex = commandetrn.fdvariablex
      			trdetail.fdvariablex1 = commandetrn.fdvariablex1
      			trdetail.fdDDH   = commandetrn.fdDDH
      			trdetail.fdDDv   = commandetrn.fdDDv
      			trdetail.fdnbcarreau   = commandetrn.NOMBRE_DE_CARREAU
      			trdetail.Ftotalcarreaupeinture   = commandetrn.Ftotalcarreaupeinture
      			trdetail.fPrixCarreauPeinture   = commandetrn.fPrixCarreauPeinture
      			trdetail.FDnbcarreauPeinture1   = commandetrn.Ftotalcarreaupeinture1
      			trdetail.fdPrixCarreauPeinture1   = commandetrn.fPrixCarreauPeinture1
      			trdetail.FnopeintureInterieure = commandetrn.fNoPeintureIntérieur
      			trdetail.fDescPeintureInterieure = commandetrn.fDescPeintureInterieure
      			trdetail.fNoPeintureExtTout = commandetrn.fNoPeintureExtTout
      			trdetail.fdescpeintureExtTout = commandetrn.fdescpeintureExtTout
      			trdetail.fTotalPeinture = commandetrn.fTotalPeinture
      			trdetail.TDemiCarrelage = commandetrn.fddemicarrelage
      			trdetail.FDextraCarrelagedemi = commandetrn.cDextraCarrelagedemi
      			trdetail.fdbarrotin = commandetrn.Combo_Barrotin
      			trdetail.fdnbcarreau   = commandetrn.NOMBRE_DE_CARREAU
      			trdetail.libelleNbCarreauExtTlt = commandetrn.libelleNbCarreauExtTlt
      			trdetail.libelleNbcarreauinterieur = commandetrn.libelleNbcarreauinterieur
      			trdetail.SUrchargeafacturer=commandetrn.surchargeenergie
      			trdetail.fTypePeinture = commandetrn.cssTypePeinture
      			trdetail.fTypePeinture1 = commandetrn.cssTypePeinture1
      			
      			si sansespace(trdetail.fNoPeintureExtTout) <> "" ou sansespace(trdetail.FnopeintureInterieure) <> "" alors
      				trdetail.fpeinture = vrai
      			sinon
      				trdetail.fpeinture = faux   	
      			FIN
      			
      			//Code WinDev 5.5 remplacé par la migration :
      			//			hecrit("trdetail",numeroenr)
      			
      			hecrit("trdetail",numeroenr,hForceIdAuto)
      		sinon
      			lignecourante = table_1
      			lignenouvelle = trdetail.fdligne + 1
      			lignelien     = trdetail.fdligne
      			decale_ligne(trdetail.fdligne,tableoccurrence("TABLE_1"))
      			
      			tableselectplus("TABLE_1",lignecourante)
      			trdetail.fdlien = trdetail.fdligne
      			hmodifie("trdetail")
      			trdetail.trancienneligne = 0
      			trdetail.fdligne = lignenouvelle
      			trdetail.fdnumprod = commandetrn.cdnumcarr
      			trdetail.fdlien = lignelien
      			trdetail.fdcodegl  = commandetrn.cdcodeglcarr
      			trdetail.fdcomposant1 = ""
      			trdetail.fdcomposant2 = ""
      			trdetail.fdcomposant3 = ""
      			trdetail.surchargeenergie = 0
      			trdetail.fdprixu = commandetrn.cdcarrprixu
      			trdetail.fdprixtotal = commandetrn.cdcarrprixtotal
      			trdetail.fddesc  = commandetrn.carrelage_nom
      			//			trdetail.fdprixupied  = commandetrn.cdcarrprixtotal  // 2002/03/19
      			trdetail.ftype   = 4
      			trdetail.fdimprimecarr =  commandetrn.fdimprimecarr
      			
      			si Facture.facalcul = 1 alors
      				//				trdetail.fdlargeura = trdetail.fdlargeur
      				//				trdetail.fdhauteura = trdetail.fdhauteur
      				//				trdetail.fdhauteur1a = trdetail.fdhauteur1
      			sinon
      				trdetail.fdlargeur = trdetail.fdlargeur
      				trdetail.fdhauteur = trdetail.fdhauteur
      				trdetail.fdhauteur1 = trdetail.fdhauteur1
      			fin	
      			trdetail.fdqteafacturer = commandetrn.cdqte	
      			trdetail.fdtypecalcul = commandetrn.typecalcul
      			trdetail.fdcarrprixdebase = commandetrn.CDPRIXDEBASECARRELAGE
      			
      			trdetail.fdnumcarr = commandetrn.cdnumcarr
      			trdetail.FDdesccarr = commandeTRN.CARRELAGE_NOM
      			trdetail.fdcarrpruxuc = commandetrn.CDCARRPRIXUC
      			trdetail.frcarrprixu = commandetrn.CDCARRPRIXU
      			trdetail.fdnbcarreau   = commandetrn.NOMBRE_DE_CARREAU
      			trdetail.Ftotalcarreaupeinture   = commandetrn.Ftotalcarreaupeinture
      			trdetail.fPrixCarreauPeinture   = commandetrn.fPrixCarreauPeinture
      			trdetail.FDnbcarreauPeinture1   = commandetrn.Ftotalcarreaupeinture1
      			trdetail.fdPrixCarreauPeinture1   = commandetrn.fPrixCarreauPeinture1
      			trdetail.FnopeintureInterieure = commandetrn.fNoPeintureIntérieur
      			trdetail.fDescPeintureInterieure = commandetrn.fDescPeintureInterieure
      			trdetail.fNoPeintureExtTout = commandetrn.fNoPeintureExtTout
      			trdetail.fdescpeintureExtTout = commandetrn.fdescpeintureExtTout
      			trdetail.libelleNbCarreauExtTlt = commandetrn.libelleNbCarreauExtTlt
      			trdetail.libelleNbcarreauinterieur = commandetrn.libelleNbcarreauinterieur
      			trdetail.fTotalPeinture = commandetrn.fTotalPeinture
      			trdetail.fdbarrotin = commandeTRN.Combo_Barrotin
      			trdetail.TDemiCarrelage = commandetrn.fddemicarrelage
      			trdetail.FDextraCarrelagedemi = commandetrn.cDextraCarrelagedemi
      			trdetail.SUrchargeafacturer=commandetrn.surchargeenergie
      			trdetail.FDmessageAffiche = messagelignedejaaffiche
                  trdetail.CalculArgon = Faux
                  trdetail.PietageArgon = 0
                  
      			maj_forme(vrai)
      			hajoute("trdetail")
      			//	activefiltre()
      			// ajout d'une ligne	
      		fin	
      		//sinon   
      		
      		
      	FIN
      	
      	PositionTable est une chaine = TableSauvePositionEtSélection(TABLE_1)
      	TableAffiche(TABLE_1,taCourantEnreg)
      	TableRestaurePositionEtSélection(TABLE_1,PositionTable)
      	//		dmodif = Faux
      	
      	
      	//	dmodif = faux
      	//Code WinDev 5.5 remplacé par la migration :
      	//	tableaffiche("TABLE_1","P")
      	//TableRestaurePositionEtSélection(TABLE_1,gTablePosition)
      	//	tableaffiche(TABLE_1,taCourantbandeau)
      	
      SINON 
      	
      	
      	HExécuteRequête(RequeteDernierNoLigne,hRequêteDéfaut,commandetrn.fanumero)
      	hlitdernier(RequeteDernierNoLigne,RequeteDernierNoLigne.fdligne)
      	//	info(RequeteDernierNoLigne.fdligne)
      	prochain_no_ligne = RequeteDernierNoLigne.fdligne
      	ecranversfichier("commandetrn","trdetail")
      	maj_forme(faux)
      	prochain_no_ligne = prochain_no_ligne + 1
      	
      	trdetail.fdligne = prochain_no_ligne 
      	si trdetail.fdcarrelage alors
      		trdetail.fdlien  = prochain_no_ligne
      	sinon
      		trdetail.fdlien  = 0
      	fin		
      	
      	trdetail.fdnocomm = commandetrn.fanumero
      	si Facture.facalcul = 1 alors
      		//		trdetail.fdlargeura = trdetail.fdlargeur
      		//		trdetail.fdhauteura = trdetail.fdhauteur
      		//		trdetail.fdhauteur1a = trdetail.fdhauteur1
      	sinon
      		trdetail.fdlargeur = trdetail.fdlargeur
      		trdetail.fdhauteur = trdetail.fdhauteur
      		trdetail.fdhauteur1 = trdetail.fdhauteur1
      		
      	fin	
      	trdetail.trancienneligne = 0
      	trdetail.fdqtedejafacture = 0
      	trdetail.fdqteafacturer = commandetrn.cdqte
      	si sansespace(trdetail.fNoPeintureExtTout) <> "" ou sansespace(trdetail.FnopeintureInterieure) <> "" alors
      		trdetail.fpeinture = vrai
      	sinon
      		trdetail.fpeinture = faux   	
      	FIN
      	trdetail.SUrchargeafacturer=commandetrn.surchargeenergie
      	trdetail.CalculArgon = faux
      	trdetail.PietageArgon = 0
      	hajoute(trdetail)
      	si trdetail.fdcarrelage alors
      		trdetail.fdlien = prochain_no_ligne
      		prochain_no_ligne = prochain_no_ligne + 1
      		trdetail.fddesc  = commandetrn.carrelage_nom
      		trdetail.fdligne = prochain_no_ligne 
      		trdetail.fdnumprod = commandetrn.cdnumcarr
      		trdetail.fdcomposant1 = ""
      		trdetail.fdcomposant2 = ""
      		trdetail.fdcomposant3 = ""
      		trdetail.surchargeenergie = 0
      		//		trdetail.fdprixupied  = commandetrn.cdcarrprixtotal  // 2002/03/19
      		trdetail.fdprixu = commandetrn.cdcarrprixu
      		trdetail.fdprixtotal = commandetrn.cdcarrprixtotal
      		trdetail.fdcodegl    = commandetrn.cdcodeglcarr
      		trdetail.ftype   = 4
      		trdetail.fdimprimecarr =  commandetrn.fdimprimecarr
      		trdetail.trancienneligne = 0
      		trdetail.fdtypecalcul = commandetrn.typecalcul
      		trdetail.fdcarrprixdebase = commandetrn.CDPRIXDEBASECARRELAGE
      		trdetail.fdnumcarr = commandetrn.cdnumcarr
      		trdetail.FDdesccarr = commandeTRN.CARRELAGE_NOM
      		trdetail.fdcarrpruxuc = commandetrn.CDCARRPRIXUC
      		trdetail.frcarrprixu = commandetrn.CDCARRPRIXU
      		trdetail.fdDDH   = commandetrn.fdDDH
      		trdetail.fdDDv   = commandetrn.fdDDv
      		trdetail.Ftotalcarreaupeinture   = commandetrn.Ftotalcarreaupeinture
      		trdetail.fPrixCarreauPeinture   = commandetrn.fPrixCarreauPeinture
      		trdetail.FDnbcarreauPeinture1   = commandetrn.Ftotalcarreaupeinture1
      		trdetail.fdPrixCarreauPeinture1   = commandetrn.fPrixCarreauPeinture1
      		trdetail.FnopeintureInterieure = commandetrn.fNoPeintureIntérieur
      		trdetail.fDescPeintureInterieure = commandetrn.fDescPeintureInterieure
      		trdetail.fNoPeintureExtTout = commandetrn.fNoPeintureExtTout
      		trdetail.fdescpeintureExtTout = commandetrn.fdescpeintureExtTout
      		trdetail.libelleNbCarreauExtTlt = commandetrn.libelleNbCarreauExtTlt
      		trdetail.libelleNbcarreauinterieur = commandetrn.libelleNbcarreauinterieur
      		trdetail.fTotalPeinture = commandetrn.fTotalPeinture
      		trdetail.FDextraCarrelagedemi = commandetrn.cDextraCarrelagedemi
      		trdetail.TDemiCarrelage = commandetrn.fddemicarrelage
      		trdetail.fdbarrotin = commandeTRN.Combo_Barrotin
      		si sansespace(trdetail.fNoPeintureExtTout) <> "" ou sansespace(trdetail.FnopeintureInterieure) <> "" alors
      			trdetail.fpeinture = vrai
      		sinon
      			trdetail.fpeinture = faux   	
      		FIN
      		trdetail.CalculArgon = Faux
      		trdetail.pietageArgon = 0
      		
      		maj_forme(vrai)
      		hajoute("trdetail")
      	FIN
      	TableAffiche(TABLE_1,taCourantEnreg)
      	TableSelectPlus(TABLE_1,TABLE_1..Occurrence)
      	ExécuteTraitement(TABLE_1,trtSélection)
      	//		dmodif = Faux
      FIN
      si pas ajout ou dmodif alors
      	
      	
      	//Code WinDev 5.5 remplacé par la migration :
      	//	commande_detail..etat = grisé
      	
      	si gauche(typedeproduit,8) = "Peinture"
      		grppeinture..etat=grise;grpPeinture..visible=VRAI
      	SINON
      		commande_detail..etat = grisé; commande_detail..Visible=Vrai
      	FIN
      	//Code WinDev 5.5 remplacé par la migration :
      	//	commande_carrelage..etat = grisé
      	commande_carrelage..etat = grisé; commande_carrelage..Visible=Vrai
      	//Code WinDev 5.5 remplacé par la migration :
      	//	fiche_det..etat = actif
      	fiche_det..etat = actif; fiche_det..Visible=Vrai
      	//Code WinDev 5.5 remplacé par la migration :
      	//	validation..etat = actif
      	validation..etat = actif; validation..Visible=Vrai
      	//Code WinDev 5.5 remplacé par la migration :
      	//	table_1..etat = inactif
      	table_1..etat = AffichageSeulement; table_1..Visible=Vrai
      	SI gclconfig.m_nAffichageCoutantOuTotal = 2 ALORS
      		
      		//	si config.AffichageCoutantOuTotal = 2 alors
      		calculTotalCommande()
      	FIN
      	dmodif = faux
      	// reprisesaisie("table_1")
      sinon
      	degriser_saisie()
      	sauver_répétitif()
      	SI gclConfig.m_nAffichageCoutantOuTotal = 2 ALORS
      		//	si config.AffichageCoutantOuTotal = 2 alors
      		calculTotalCommande()
      	FIN
      	hraz(trdetail)
      	fichierversecran("commandetrn","trdetail")
      	raz_nom()
      	
      	récuperer_répétitif()
      	recuperer_répétitif_persistant_cond("CDCARRELAGE")
      	si Combo_typespac = 0 alors
      		listeselectplus(Combo_typespac,1)
      	fin
      	
      	commandetrn.cdnumcarr..modifie = faux
      	multitache()
      	//	commandetrn.fadate = ladate
      	typeunite = 0
      	messagelignedejaaffiche = faux
      	TableauSupprimeTout(MessageTraite)
      	reprisesaisie("cdnumprod")
      fin
      
     type : 458752
   -
     name : VerifieAffichage
     procedure_id : 5859041163979179841
     type_code : 14
     code : |1-
      Procédure VerifieAffichage()
      
      selon commandetrn..plan
      	cas 1
      		libelle3..hauteur = libelle3..HauteurInitiale
      		libelle4..hauteur = libelle4..HauteurInitiale
      		LIBELLECREDIT..hauteur = 	LIBELLECREDIT..HauteurInitiale
      //		Combo_Livraison1..visible = vrai
      		FCLIENT..Y= FCLIENT..YInitial
      		BTN_RECHERCHEClient..Y = BTN_RECHERCHEClient..YInitial
      		Combo_Vendeur..Y=Combo_Vendeur..YInitial
              nom..Y=nom..YInitial
      		Combo_Livraison1..Y=Combo_Livraison1..YInitial
      		lNom..Y=lNom..YInitial
      		fadate..Y = fadate..YInitial
      		fadate..X = fadate..XInitial
      		Fdaterequise..y = Fdaterequise..YInitial
      		Fdaterequise..X = Fdaterequise..XInitial
      		BtnCalendrierLivraison..X = BtnCalendrierLivraison..XInitial
      		BtnCalendrierLivraison..y = BtnCalendrierLivraison..yInitial
      		fanocommande..Y = fanocommande..YInitial
      		BTN_RECHERCHE..Y = BTN_RECHERCHE..YInitial
      		fanojob..Y = fanojob..YInitial
      		REFERENCE..X = REFERENCE..XInitial
      		REFERENCE..y = REFERENCE..yInitial
      		notelephone..y = NoTelephone..YInitial
      //		NoTelephone..x = notelephone..XInitial
      		//		LibelléLivraison..visible = vrai
      
      	cas 2
      		
      		libelle3..hauteur = 72
      		libelle4..hauteur = 72
      		LIBELLECREDIT..hauteur = 72
      //		Combo_Livraison1..Visible = Faux
      		Combo_Livraison1..y-=20
      		lnom..y-=20
      		fclient..y-=20
              BTN_RECHERCHEClient..y-=20
              Combo_Vendeur..y-=20
              nom..y-=20
              Fanocommande..y = fclient..Y
              reference..y = fanocommande..y
              BTN_RECHERCHE..y = fanocommande..Y
              fanojob..y = nom..y
              fadate..x = 251
              fadate..y = 59
      		fdaterequise..X = 251+fadate..Largeur + 5
      		Fdaterequise..Y = 59
      		BtnCalendrierLivraison..y = 59
      		BtnCalendrierLivraison..x = FDATEREQUISE..x + FDATEREQUISE..Largeur + 5
      		NoTelephone..y -= 57
      //		NoTelephone..x = fclient..x
      //		LibelléLivraison..visible = faux
      
      FIN
     type : 458752
   -
     name : calcul_espace_tableau1
     procedure_id : 5859041164066932545
     type_code : 14
     code : |1-
      Procédure calcul_espace_tableau1(variable,messageErreur = vrai)
      x est un entier
      bDifferent est un booleen = faux   // si dans le fichier kit pas de lien intercallaire = faux
      continuerrecherche est un booleen = vrai // si pas trouve avec le numero de produit aller voir le lien
      bDoubleexiste est un booleen = faux
      lelien est une chaine
      lelien1 est une chaine
      lefini est un reel
      lespace est un reel 
      lespacetotale est un reel 
      clederecherche EST UNE CHAINE
      ldoublescellant est un reel =0
      bLinexblanc est un booléen = faux
      bLinexnoir est un booléen = faux
      bLinexgris est un booléen = faux
      sLIndex est une chaine
      sLtolerance est une chaine
      sLtolerancemoins est une chaine
      lmultiplicateur est un entier = 1
      sLFiniAlias est une chaine
      tabdimensionChoix est un tableau de 0 par 2 chaine
      lretourrechercheintercalaire est un chaine
      epaisseurThermos est un reel = epaisseur
      txtreq est une chaine = [
      	select numero as NoIntercalaire, DimensionI+TolerancePlus as bornehaut,dimensioni-ToleranceMoins as bornebas from IntercalaireCouleurDimensions
      	where IntercalaireCouleurDimensions.IDIntercalaireCouleurs = %1 and %2 between bornebas and bornehaut
      ]
      Reqsql est une source de donnees
      txtreqNonTrouve est une chaine = [
      	select top 2 numero as NoIntercalaire, ABS(%2-DimensionI) Borne,%2-DimensionI as ecart from IntercalaireCouleurDimensions
      	where IntercalaireCouleurDimensions.IDIntercalaireCouleurs = %1 order by borne asc
      ]
      
      
      
      
      RequeteDimensionAlias.pDimensionAlias= "<"+sansespace(commandeTRN.dfini)+">"
      HExécuteRequête(RequeteDimensionAlias)
      si HNbEnr(RequeteDimensionAlias) >= 1 alors
      	HLitPremier(RequeteDimensionAlias)
      	commandeTRN.dfini = sansespace(RequeteDimensionAlias.DImensionMaitre)
      FIN
      
      lelien = complete(commandetrn.cdcomposant1,10)+complete(commandetrn.cdcomposant2,10)+complete(commandetrn.cdcomposant3,10)
      //lelien = DROITE(commandetrn.cdcomposant1,1)+DROITE(commandetrn.cdcomposant2,1)+DROITE(commandetrn.cdcomposant3,1)
      lelien1 = complete(produitdebase1,10)+complete(produitdebase2,10)+complete(produitdebase3,10)
      clederecherche = HConstruitValClé(inter,cleclientproduit,cl.numero,...
      complete(commandetrn.cdcomposant1,10),complete(commandetrn.cdcomposant2,10),...
      complete(commandetrn.cdcomposant3,10),complete(commandetrn.dfini,10))
      hlitrecherche("inter","cleclientproduit",clederecherche)
      
      
      RequeteClientFiniIntercalaire.pIdClient = client.IDClient
      RequeteClientFiniIntercalaire.pcomposant1 = complete(commandetrn.CDCOMPOSANT1,10)
      RequeteClientFiniIntercalaire.pcomposant2 = complete(commandetrn.CDCOMPOSANT2,10)
      RequeteClientFiniIntercalaire.pcomposant3 = complete(commandetrn.CDCOMPOSANT3,10)
      RequeteClientFiniIntercalaire.pFini = complete(commandetrn.dfini,15)
      RequeteClientFiniIntercalaire.pIdIntercalaireCouleur = Combo_typespac
      hexecuterequete(RequeteClientFiniIntercalaire)
      
      
      //SI CDENERGIVERRE OU config.cDoubleScellantTous ALORS
      	SI CDENERGIVERRE OU gclconfig.m_bcDoubleScellantTous ALORS
      		ldoublescellant = arrondi(RequeteClientFiniIntercalaire.dimdoublescellantM)
      	
      sinon
      	pour i = 1 a 3
      		
      		si pas sansespace({"produitdebase"+numeriqueverschaine(i)}) = "" alors
      			
      			si  pas droite(sansespace({"produitdebase"+numeriqueverschaine(i)}),1) = "3" alors
      				ldoublescellant = arrondi(RequeteClientFiniIntercalaire.dimdoublescellantM)
      				sortir
      			FIN
      		fin
      		
      	fin
      FIN
      
      
      
      
      //si pas HEnDehors() et HTrouve() alors
      si HNbEnr(RequeteClientFiniIntercalaire) = 1 alors
      	HLitPremier(RequeteClientFiniIntercalaire)
      	commandetrn.cdespace	= RequeteClientFiniIntercalaire.Spacer1
      	commandetrn.cdespace2  = RequeteClientFiniIntercalaire.spacer2
      	//	commandetrn.cdespaceinex = intercal.idescinex
      	continuerrecherche = faux
      	
      sinon
      	
      	
      	RequeteClientFiniIntercalaire.pIdClient = client.IDClient
      	RequeteClientFiniIntercalaire.pcomposant1 = complete(produitdebase1,10)
      	RequeteClientFiniIntercalaire.pcomposant2 = complete(produitdebase2,10)
      	RequeteClientFiniIntercalaire.pcomposant3 = complete(produitdebase3,10)
      	RequeteClientFiniIntercalaire.pFini = complete(commandetrn.dfini,15)
      	RequeteClientFiniIntercalaire.pIdIntercalaireCouleur = Combo_typespac
      	hexecuterequete(RequeteClientFiniIntercalaire)
      	
      	//Code WinDev 5.5 remplacé par la migration :
      	//    si pas h.endehors et h.trouve alors
      	si HNbEnr(RequeteClientFiniIntercalaire) = 1 alors
      		HLitPremier(RequeteClientFiniIntercalaire)
      		commandetrn.cdespace	= RequeteClientFiniIntercalaire.Spacer1
      		commandetrn.cdespace2  = RequeteClientFiniIntercalaire.spacer2
      		//	commandetrn.cdespaceinex = intercal.idescinex
      		continuerrecherche = faux
      	fin
      FIN
      
      
      //fin
      
      
      si Combo_typespac = -1   alors
      	CDESPACE = ""
      	cdespace2=""
      	acso_message("Erreur","Veuillez choisir un type d'intercalaire","Erreur")
      	reprisesaisie(Combo_typespac)
      FIN
      
      
      
      
      
      
      si continuerrecherche alors
      	si hlitrecherche(IntercalaireCouleurs,IDIntercalaireCouleurs,Combo_typespac) alors
      		si hlitrecherche(intercalaires,IDIntercalaires,IntercalaireCouleurs.idIntercalaires) alors
      			ldoublescellant = intercalaires.dimdoublescellantM
      		fin
      	fin
      	
      	si pas position(variable,".") = 0 alors
      		lefini = arrondi(val(variable) * 25.4,3)
      	sinon
      		si pas position(variable,"/") = 0 alors
      			lefini =numeriqueverschaine( convertiranglais(variable,"fini") * 25.4,"6.3f")
      			
      		sinon
      			si val(variable) < 6 alors
      				lefini =numeriqueverschaine( convertiranglais(variable,"fini") * 25.4,"6.3f")
      			sinon
      				lefini = arrondi(val(variable)/1000 * 25.4,3)
      			FIN
      		FIN
      	FIN
      	
      	lefini = InchFractionToMillimeter(variable)
      	epaisseurThermos+=ldoublescellant 
      	
      	selon nbverre
      	
      		cas "double" 
      			lespace = arrondi((lefini - epaisseurThermos) ,3)
      			lespacetotale = arrondi((lefini - epaisseurThermos) ,3)
      			lmultiplicateur = 1
      		cas "triple" 
      			epaisseurThermos+=ldoublescellant
      			lespace = arrondi((lefini - epaisseurThermos) / 2 ,3)
      			lespacetotale = arrondi((lefini - epaisseurThermos) ,3)
      			lmultiplicateur = 2
      			
      	fin	
      	
      	lespace = arrondi(lespace/25.4,3)
      	lespacetotale = arrondi(lespacetotale/25.4,3)
      	si lespacetotale < 0 alors renvoyer faux
      	// Jean Hamelin 18-10-2014
      	// décommenter pour calculer les spacers dans le cas d'un thermos triple
      	// pour touver une combinaison le plus pres possible de l,espace disponible
      	// il faut calculer avec l,espace totale et non l,espace divisée par 2
      	
      	selon nbverre
      		cas "triple"
      			
      			lretourrechercheintercalaire = remplirTableauIntercalaire(Combo_typespac,lespacetotale)
      			si lretourrechercheintercalaire = "" alors
      				//ACSO_message("Erreur","Aucun intercalaire ne correspond à votre demande"+RC+"SVP l'inscrire manuellement","Erreur")
      				renvoyer faux
      				//				RepriseSaisie(CDESPACE)
      			fin
      			//			CDESPACE = sansespace(cdespace = "") ? ExtraitChaîne(lretourrechercheintercalaire,1,",") sinon cdespace
      			//			CDESPACE2 = SansEspace(CDESPACE2 = "") ? ExtraitChaîne(lretourrechercheintercalaire,2,",") sinon cdespace2
      			CDESPACE =  ExtraitChaîne(lretourrechercheintercalaire,1,",") 
      			CDESPACE2 =  ExtraitChaîne(lretourrechercheintercalaire,2,",") 
      			
      			
      		cas "double"
      			si HExécuteRequêteSQL(Reqsql,hModifieFichier,chaineconstruit(txtreq,Combo_typespac,lespace)) et hnbenr(Reqsql) > 0 alors
      				hlitpremier(Reqsql)
      				CDESPACE = Reqsql.nointercalaire
      			sinon
      				SI HExécuteRequêteSQL(Reqsql,hModifieFichier,ChaîneConstruit(txtreqNonTrouve,Combo_typespac,lespace)) ET HNbEnr(Reqsql) > 0 ALORS
      					pour TOUT Reqsql 
      						si Reqsql.ecart < 0.055 alors
      							tableauajouteligne(tabdimensionChoix,Reqsql.nointercalaire,Reqsql.ecart * -1)
      						fin
      					FIN
      					si pas tabdimensionChoix..occurrence = 0 alors
      						CDESPACE = ouvre(ChoixDimensionIntercalaire,tabdimensionChoix,lespace,faux)
      					sinon
      						SI messageErreur ALORS
      							RENVOYER Faux
      						FIN
      					fin
      
      					
      				sinon
      					
      					
      					SI messageErreur ALORS
      						renvoyer faux
      					FIN
      				fin
      			fin
      			
      	fin
      	
      fin
      
      //
      
      renvoyer vrai
     type : 458752
   -
     name : remplirTableauIntercalaire
     procedure_id : 1500431032464760870
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] remplirTableauIntercalaire (<Combo_typespac>, <lespacetotale>)
      //
      // Paramètres :
      //	Combo_typespac : <indiquez ici le rôle de Combo_typespac>
      //	lespacetotale : <indiquez ici le rôle de lespacetotale>
      // Valeur de retour :
      // 	chaîne : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE remplirTableauIntercalaire(Combo_typespac,lespacetotale)
      
      
      reqsql est un source de donnees
      txtsql est une chaine = "select * from IntercalaireCouleurDimensions where IDIntercalaireCouleurs = %1 order by dimensioni"
      txtsql = ChaîneConstruit(txtsql,Combo_typespac)
      tabDimensioncroise est un tableau de 0 par 5 chaines
      tabdimension est un tableau de 0 par 4 chaine
      tabdimensionChoix est un tableau de 0 par 2 chaine
      Dimensionatrairer est une chaine = ""
      lchaine est une chaine 
      lmin est un reel
      lmax est un reel
      ldifferenceajoute est un reel = 0
      ldebut est un booleen = vrai
      
      cpt est un entier = 1
      cpt1 est un entier = 1
      si HExécuteRequêteSQL(reqsql,hRequêteDéfaut,txtsql) alors
      	pour TOUT reqsql 
      		dimension(tabdimension,cpt,4)
      		tabdimension[cpt,1] = reqsql.numero
      		tabdimension[cpt,2] = NumériqueVersChaîne(Arrondi(reqsql.dimensioni,3))
      		tabdimension[cpt,3] = NumériqueVersChaîne(Arrondi(reqsql.toleranceplus,3))
      		tabdimension[cpt,4] = NumériqueVersChaîne(Arrondi(reqsql.tolerancemoins,3))
      		cpt++
      	FIN
      sinon
      	info(herreurinfo(hErrComplet))
      FIN
      
      
      pour cpt = 1 _a_ dimension(tabdimension)/4
      	pour cpt1 = cpt _a_ Dimension(tabdimension)/4
      //		tableauajouteligne(tabDimensioncroise,tabdimension[cpt,1]+","+tabdimension[cpt1,1] , numeriqueverschaine(val(tabdimension[cpt,2]) +   Val(tabdimension[cpt1,2])),...
      //		max(tabdimension[cpt,3],tabdimension[cpt1,3]),Max(tabdimension[cpt,4],tabdimension[cpt1,4]),abs(val(lespacetotale)-(Val(tabdimension[cpt,2]) +   Val(tabdimension[cpt1,2]))))
      		TableauAjouteLigne(tabDimensioncroise,tabdimension[cpt,1]+","+tabdimension[cpt1,1] , NumériqueVersChaîne(Val(tabdimension[cpt,2]) +   Val(tabdimension[cpt1,2])),...
      		Min(tabdimension[cpt,3],tabdimension[cpt1,3]),Min(tabdimension[cpt,4],tabdimension[cpt1,4]),Abs(Val(lespacetotale)-(Val(tabdimension[cpt,2]) +   Val(tabdimension[cpt1,2]))))
      		
      		
      		
      		
      		
      	FIN
      FIN
      tableautrie(tabDimensioncroise,ttCroissant,5)
      pour cpt = 1 _a_ dimension(tabDimensioncroise)/5
      	lmin = val(tabDimensioncroise[cpt,2]) - val(tabDimensioncroise[cpt,4])
      	lmax = Val(tabDimensioncroise[cpt,2]) + Val(tabDimensioncroise[cpt,3])
      	
      	
      	
      	si lmin < lespacetotale < lmax ALORS
      //		si Val(tabDimensioncroise[cpt,5]) = ldifferenceajoute ou ldebut alors
      			TableauAjouteLigne(tabdimensionChoix,tabDimensioncroise[cpt,1],tabDimensioncroise[cpt,2])
      //		    ldifferenceajoute = Val(tabDimensioncroise[cpt,5])
      //            ldebut = faux
      //		sinon
      //		   sortir
      //		fin
      		
      	FIN
      	
      FIN
      
      
      si dimension(tabdimensionChoix)/2 > 1 alors
      	lchaine = ouvre(ChoixDimensionIntercalaire,tabdimensionChoix,lespacetotale)
      sinon si dimension(tabdimensionChoix) /2 = 1
      	lchaine = sansespace(tabdimensionChoix[1,1])
      FIN
      
      renvoyer lchaine
      
      
      
      
      
      
      
      
      
      
      
     type : 458752
   -
     name : ValideAlerte
     procedure_id : 1622095966749101702
     type_code : 14
     code : |1-
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] ValideAlerte ( [<ltype> est entier [, <messagedejaaffiche> est booléen]])
      //
      // Paramètres :
      //	ltype (entier - valeur par défaut=1) : <valide pour une ligne>
      //	messagedejaaffiche (booléen - valeur par défaut=0) :
      // Valeur de retour :
      // 	booléen : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      
      PROCEDURE ValideAlerte(ltype est une entier = 1, messagedejaaffiche est un booleen = faux)
      // alerte
      // 1 = type d'intercalaire
      // 2 = total d'une ligne
      // 3 = total de la commande
      // 4 = total pi2 d'une ligne
      // 5 = Épaisseur thermos
      // 6 = Épaisseur Intercalaire
      // 7 = Fini demandé
      // 8 = nombre de verre
      // 9 = Dimension Largeur mm
      //10 = Dimension Haureur mm
      //11 = Composante du thermos
      //12 = Type de spacer
      //13 = Carrelage sur ligende commande
      //14 = La ligne contient une forme
      //15 = Les dimensions du thermos
      //16 = Commande contient des produits spéciayx
      //17 = Épaisseur du verre
      
      
      // lmfocus
      //
      //1 = Aucun
      //2 = Intercalaire
      //3 = Note1
      //4 = Hauteur
      //5 = Largeur
      //6 = Type d'intercalaire
      //7 = Fini
      
      
      lmFocus est un  tableau associatif (*, *, wlEntier) de chaînes
      
      lmFocus[1] = ""
      lmFocus[2] = "cdespace"
      lmFocus[3] = "fnotes"
      lmFocus[4] = "cdhauteur"
      lmFocus[5] = "cdlargeur"
      lmFocus[6] = "combo_typespac"
      lmFocus[7] = "dfini"
      lmFocus[8] = "cdprixupied"
      lmFocus[9] = "fDateRequise"
      
      
      nLprochain_no_ligne est un entier
      
      lidcouleurintercalaire est un entier
      lspacer est une chaine
      rLtotpi2 est un reel
      chaineacompiler est une chaine
      lspacer2Texte est une chaine
      ltotalligne  est un reel 
      ltotalfacture est un reel
      EpaisseurThermos est un entier = val(droite(sansespace(pdebase),1))
      EpaisseurSpacer est un reel 
      EpaisseurFini est une chaine = InchFractionToInch(commandetrn.DFINI)
      //EpaisseurFini est une chaine = commandetrn.DFINI
      
      LargeurThermos est un entier = arrondi(commandeTRN.facalcul = 1 ? val(commandetrn.cdlargeur) * 25.4 sinon val(commandetrn.cdlargeur) * 1000)
      HauteurThermos est un entier = arrondi(commandeTRN.facalcul = 1 ? val(commandetrn.cdhauteur) * 25.4 sinon val(commandetrn.cdhauteur) * 1000)
      TypeIntercalaire est une chaine  = ""
      Carrelagesurligne est un booleen = commandetrn.cDCARRELAGE
      FormeSurLigne est un booleen = (sansespace(commandetrn.fdforme) <> "")
      Produitspeciaux est un booleen = (AvecProduitSpeciaux ou AvecProduitSpeciauxPartiel)
      ComposantThermos est une chaine = sansespace(commandetrn.CDCOMPOSANT1)+";"+SansEspace(commandeTRN.CDCOMPOSANT2)+";"+SansEspace(commandeTRN.CDCOMPOSANT3)
      tabComposantThermos est une tableau de chaînes
      chaineverstableau(ComposantThermos,tabComposantThermos,";")
      tabComposantThermos = tabComposantThermos.filtre(Valeur=>valeur <> "")
      
      nEpaisseurVerre est un entier = val(droite(sansespace(commandetrn.pdebase),1))
      
      si HLitRecherche(IntercalaireCouleurs,IDIntercalaireCouleurs,commandetrn.Combo_typespac) alors
      	si hlitrecherche(Intercalaires,IDIntercalaires,IntercalaireCouleurs.idIntercalaires) alors
      		TypeIntercalaire = sansespace(intercalaires.Description)
      	FIN
      FIN
      
      _NbVerre est un entier  
      selon (minuscule(nbverre) )
      	cas "double" 
      		_NbVerre = 2
      	cas "triple"	
      		_NbVerre =3
      	autres cas
      		_NbVerre = 0
      fin	
      HExécuteRequête(RequeteDernierNoLigne,hRequêteDéfaut,commandeTRN.fanumero)
      HLitDernier(RequeteDernierNoLigne,RequeteDernierNoLigne.fdligne)
      NoLigne est un entier //= RequeteDernierNoLigne.fdligne+1
      sI dmodif = Vrai alors 
      	NoLigne = trdetail.fdligne
      sinon
      	HExécuteRequête(RequeteDernierNoLigne,hRequêteDéfaut,commandeTRN.fanumero)
      	HLitDernier(RequeteDernierNoLigne,RequeteDernierNoLigne.fdligne)
      	NoLigne  = RequeteDernierNoLigne.fdligne+1
      	
      FIN
      
      sDescriptionLigne est une chaine = (ltype = 1 ?  "[Ligne " + NoLigne+"] " sinon "")
      tabalerte = tabalerte.filtre(Valeur=>valeur.estactif = vrai)
      
      
      pour tout calerte de tabalerte
      	chaineacompiler = ""
      	si calerte.estactif et calerte.valideligneoutotal = ltype et pas messagetraite[calerte.idfmessage] alors
      		selon calerte.action1
      			//// intercalaire
      			cas 1
      				si hlitrecherche(IntercalaireCouleurDimensions,IDIntercalaireCouleurDimensions,calerte.cbchoix1) alors
      					lidcouleurintercalaire = IntercalaireCouleurDimensions.IDIntercalaireCouleurs
      					lspacer = sansespace(IntercalaireCouleurDimensions.numero)
      					lspacer2Texte = sansespace(trdetail.FDespace2) <> "" ? " ou "+ trdetail.fdespace + taboperateur[calerte.operateuregalite1] +" "+lspacer sinon ""
      					
      					chaineacompiler = trdetail.ftypespacer+taboperateur[calerte.operateuregalite1]+" "+ lidcouleurintercalaire +" et ( " +sansespace(trdetail.fdespace) + taboperateur[calerte.operateuregalite1] +" "+lspacer +...
      					lspacer2Texte+")"
      				fin
      				
      			//// Total de la ligne
      			cas 2
      				ltotalligne = arrondi(trdetail.fdprixu + fdextraforme,2)
      				si calerte.operateuregalite1 = 7 alors
      					chaineacompiler = val(calerte.schoix1) +" <= " + ltotalligne +" <= " + Val(calerte.schoix1_1) 
      				sinon	
      					chaineacompiler = ltotalligne+taboperateur[calerte.operateuregalite1]+val(calerte.schoix1) 
      				fin
      				
      			//// Total de la commande
      			cas 3
      				ltotalfacture = arrondi(val(commandetrn.LibelléPrixAnglais))
      				SI calerte.operateuregalite1 = 7 ALORS
      					chaineacompiler = Val(calerte.schoix1) +" <= " + ltotalfacture +" <= " + Val(calerte.schoix1_1) 
      				SINON	
      					chaineacompiler = ltotalfacture+taboperateur[calerte.operateuregalite1]+Val(calerte.schoix1)
      				FIN
      				
      			// Total Pied carré réel
      			cas 4
      				SI calerte.operateuregalite1 = 7 ALORS
      					chaineacompiler = Val(calerte.schoix1) +" <= " + (commandeTRN.facalcul = 1 ? trdetail.fdpiedcarrereel SINON trdetail.fdpiedcarrereel * gclconfig.m_rconversionam) +" <= " + Val(calerte.schoix1_1) 
      //					chaineacompiler = Val(calerte.schoix1) +" <= " + (commandeTRN.facalcul = 1 ? trdetail.fdpiedcarrereel SINON trdetail.fdpiedcarrereel * config.conversionam) +" <= " + Val(calerte.schoix1_1) 
      				SINON	
      					chaineacompiler = (commandeTRN.facalcul = 1 ? trdetail.fdpiedcarrereel SINON trdetail.fdpiedcarrereel * gclconfig.m_rconversionam)+taboperateur[calerte.operateuregalite1]+Val(calerte.schoix1)
      //					chaineacompiler = (commandeTRN.facalcul = 1 ? trdetail.fdpiedcarrereel SINON trdetail.fdpiedcarrereel * config.conversionam)+taboperateur[calerte.operateuregalite1]+Val(calerte.schoix1)
      				FIN
      				
      			CAS 5
      				/// Épaisseur Thermos
      				
      				SI calerte.operateuregalite1 = 7 ALORS
      					chaineacompiler = Val(calerte.schoix1) +" <= " + EpaisseurThermos +" <= " + Val(calerte.schoix1_1) 
      				SINON	
      					chaineacompiler = EpaisseurThermos+taboperateur[calerte.operateuregalite1]+Val(calerte.schoix1)
      				FIN
      				
      			cas 6 
      				/// Épaisseur du spacer.
      				si hlitrecherche(IntercalaireCouleurDimensions,IDIntercalaireCouleursnumero,HConstruitValClé(IntercalaireCouleurDimensions,IDIntercalaireCouleursnumero,Combo_typespac,cdespace)) alors
      					EpaisseurSpacer = IntercalaireCouleurDimensions.DimensionI
      					SI calerte.operateuregalite1 = 7 ALORS
      						chaineacompiler = Val(calerte.schoix1) +" <= " + EpaisseurSpacer +" <= " + Val(calerte.schoix1_1) 
      					SINON	
      						chaineacompiler = EpaisseurSpacer+taboperateur[calerte.operateuregalite1]+Val(calerte.schoix1)
      					FIN
      					
      					
      				FIN
      				
      			CAS 7
      				SI calerte.operateuregalite1 = 7 ALORS
      					chaineacompiler += Val(calerte.schoix1) +" <= " + val(EpaisseurFini) +" <= " + Val(calerte.schoix1_1) 
      				SINON	
      					chaineacompiler += val(EpaisseurFini)+taboperateur[calerte.operateuregalite1]+val(calerte.schoix1)
      				FIN	
      			CAS 8
      				SI calerte.operateuregalite1 = 7 ALORS
      					chaineacompiler += Val(calerte.schoix1) +" <= " + _NbVerre +" <= " + Val(calerte.schoix1_1) 
      				SINON	
      					chaineacompiler += _NbVerre+taboperateur[calerte.operateuregalite1]+Val(calerte.schoix1)
      				FIN
      			CAS 9
      				si _NbVerre <> 0 alors
      					SI calerte.operateuregalite1 = 7 ALORS
      						chaineacompiler += Val(calerte.schoix1) +" <= " + LargeurThermos +" <= " + Val(calerte.schoix1_1) 
      					SINON	
      						chaineacompiler += LargeurThermos+taboperateur[calerte.operateuregalite1]+Val(calerte.schoix1)
      					FIN
      				fin	
      			CAS 10
      				SI _NbVerre <> 0 ALORS
      					SI calerte.operateuregalite1 = 7 ALORS
      						chaineacompiler += Val(calerte.schoix1) +" <= " + HauteurThermos +" <= " + Val(calerte.schoix1_1) 
      					SINON	
      						chaineacompiler += HauteurThermos+taboperateur[calerte.operateuregalite1]+Val(calerte.schoix1)
      					FIN	
      				fin			
      			CAS 11
      				SI calerte.operateuregalite1 = 8 ALORS
      					POUR CHAQUE sCurrentComposante de tabComposantThermos
      						chaineacompiler += ChaîneOccurrence(calerte.Liste_composante1,sCurrentComposante) + "> 0" +" OU "
      					FIN
      					chaineacompiler = chaineacompiler[1 À Taille(chaineacompiler) - 4]	
      					
      				SINON
      					chaineacompiler += ChaîneOccurrence(ComposantThermos,calerte.schoix1) + "> 0"
      				FIN	
      				
      			cas 12
      				si calerte.operateuregalite1 = 8 alors
      					chaineacompiler += ChaîneOccurrence(calerte.Liste_intercalaire1,TypeIntercalaire) + "> 0"
      				FIN
      			CAS 13
      				SI calerte.operateuregalite1 = 9 ALORS
      					chaineacompiler += Carrelagesurligne + "=1"
      					
      				FIN
      			CAS 14
      				SI calerte.operateuregalite1 = 9 ALORS
      					chaineacompiler += FormeSurLigne + "=1"
      					
      				FIN
      				
      			CAS 15
      				chaineacompiler += pas ((LargeurThermos < val(calerte.schoix1) et HauteurThermos < val(calerte.schoix1_1)) ou ...
      				(HauteurThermos < val(calerte.schoix1) ET LargeurThermos < val(calerte.schoix1_1)))
      				
      			CAS 16
      				SI calerte.operateuregalite1 = 9 ALORS
      					chaineacompiler += Produitspeciaux + "=1"
      				FIN
      //            cas 17
      //				SI calerte.operateuregalite1 = 7 ALORS
      //					chaineacompiler += Val(calerte.schoix1) +" <= " + nEpaisseurVerre +" <= " + Val(calerte.schoix1_1) 
      //				SINON	
      //					chaineacompiler += nEpaisseurVerre+taboperateur[calerte.operateuregalite1]+Val(calerte.schoix1)
      //				FIN
      		fin
      		
      		si calerte.action2 <> -1 alors
      			chaineacompiler+= " " + (calerte.cboperateur1	=1 ? "ET (" SINON "OU (" )
      			
      			selon calerte.action2
      			
      				//// intercalaire
      				CAS 1
      					SI HLitRecherche(IntercalaireCouleurDimensions,IDIntercalaireCouleurDimensions,calerte.cbchoix2) ALORS
      						lidcouleurintercalaire = IntercalaireCouleurDimensions.IDIntercalaireCouleurs
      						lspacer = SansEspace(IntercalaireCouleurDimensions.numero)
      						lspacer2Texte = SansEspace(trdetail.FDespace2) <> "" ? " ou "+ trdetail.fdespace + taboperateur[calerte.operateuregalite2] +" "+lspacer SINON ""
      						
      						chaineacompiler += trdetail.ftypespacer+taboperateur[calerte.operateuregalite2]+" "+ lidcouleurintercalaire +" et ( " +SansEspace(trdetail.fdespace) + taboperateur[calerte.operateuregalite2] +" "+lspacer +...
      						lspacer2Texte+")"
      					FIN
      					
      				//// Total de la ligne
      				CAS 2
      					ltotalligne = Arrondi(trdetail.fdprixu + fdextraforme,2)
      					SI calerte.operateuregalite2 = 7 ALORS
      						chaineacompiler += Val(calerte.schoix2) +" <= " + ltotalligne +" <= " + Val(calerte.schoix2_1) 
      					SINON	
      						chaineacompiler += ltotalligne+taboperateur[calerte.operateuregalite2]+Val(calerte.schoix2) 
      					FIN
      					
      				//// Total de la commande
      				CAS 3
      					ltotalfacture = Arrondi(Val(commandeTRN.LibelléPrixAnglais))
      					SI calerte.operateuregalite2 = 7 ALORS
      						chaineacompiler += Val(calerte.schoix2) +" <= " + ltotalfacture +" <= " + Val(calerte.schoix2_1) 
      					SINON	
      						chaineacompiler += ltotalfacture+taboperateur[calerte.operateuregalite2]+Val(calerte.schoix2)
      					FIN
      					
      				// Total Pied carré réel
      				CAS 4
      					SI calerte.operateuregalite2 = 7 ALORS
      						chaineacompiler += Val(calerte.schoix2) +" <= " + trdetail.fdpiedcarrereel +" <= " + Val(calerte.schoix2_1) 
      					SINON	
      //						chaineacompiler += (commandeTRN.facalcul = 1 ? trdetail.fdpiedcarrereel SINON trdetail.fdpiedcarrereel * config.conversionam)+taboperateur[calerte.operateuregalite2]+Val(calerte.schoix2)
      						chaineacompiler += (commandeTRN.facalcul = 1 ? trdetail.fdpiedcarrereel SINON trdetail.fdpiedcarrereel * gclconfig.m_rconversionam)+taboperateur[calerte.operateuregalite2]+Val(calerte.schoix2)
      					FIN
      					
      				CAS 5
      					/// Épaisseur Thermos
      					
      					SI calerte.operateuregalite2 = 7 ALORS
      						chaineacompiler += Val(calerte.schoix2) +" <= " + EpaisseurThermos +" <= " + Val(calerte.schoix2_1) 
      					SINON	
      						chaineacompiler += EpaisseurThermos+taboperateur[calerte.operateuregalite2]+Val(calerte.schoix2)
      					FIN
      					
      				CAS 6 
      					/// Épaisseur du spacer.
      					SI HLitRecherche(IntercalaireCouleurDimensions,IDIntercalaireCouleursnumero,HConstruitValClé(IntercalaireCouleurDimensions,IDIntercalaireCouleursnumero,Combo_typespac,CDESPACE)) ALORS
      						EpaisseurSpacer = IntercalaireCouleurDimensions.DimensionI
      						SI calerte.operateuregalite2 = 7 ALORS
      							chaineacompiler += Val(calerte.schoix2) +" <= " + EpaisseurSpacer +" <= " + Val(calerte.schoix2_1) 
      						SINON	
      							chaineacompiler += EpaisseurSpacer+taboperateur[calerte.operateuregalite2]+Val(calerte.schoix2)
      						FIN
      						
      						
      					FIN
      				Cas 7
      					SI calerte.operateuregalite2 = 7 ALORS
      						chaineacompiler += Val(calerte.schoix2) +" <= " + val(EpaisseurFini) +" <= " + Val(calerte.schoix2_1) 
      					SINON	
      						chaineacompiler += val(EpaisseurFini)+taboperateur[calerte.operateuregalite2]+Val(calerte.schoix2)
      					FIN	
      					
      				CAS 8
      					SI calerte.operateuregalite2 = 7 ALORS
      						chaineacompiler += Val(calerte.schoix2) +" <= " + _NbVerre +" <= " + Val(calerte.schoix2_1) 
      					SINON	
      						chaineacompiler += _NbVerre+taboperateur[calerte.operateuregalite2]+Val(calerte.schoix2)
      					FIN
      					
      				CAS 9
      					SI _NbVerre <> 0 ALORS
      						SI calerte.operateuregalite2 = 7 ALORS
      							chaineacompiler += Val(calerte.schoix2) +" <= " + LargeurThermos +" <= " + Val(calerte.schoix2_1) 
      						SINON	
      							chaineacompiler += LargeurThermos+taboperateur[calerte.operateuregalite2]+Val(calerte.schoix2)
      						FIN
      					fin
      				CAS 10
      					si _NbVerre <> 0 alors
      						SI calerte.operateuregalite2 = 7 ALORS
      							chaineacompiler += Val(calerte.schoix2) +" <= " + HauteurThermos +" <= " + Val(calerte.schoix2_1) 
      						SINON	
      							chaineacompiler += HauteurThermos+taboperateur[calerte.operateuregalite2]+Val(calerte.schoix2)
      						FIN	
      					fin
      				CAS 11
      					SI calerte.operateuregalite2 = 8 ALORS
      						POUR CHAQUE sCurrentComposante de tabComposantThermos
      							chaineacompiler += ChaîneOccurrence(calerte.Liste_composante2,sCurrentComposante) + "> 0" +" OU "
      						FIN
      						chaineacompiler = chaineacompiler[1 À Taille(chaineacompiler) - 4]	
      						
      					SINON
      						chaineacompiler += ChaîneOccurrence(ComposantThermos,calerte.schoix2) + "> 0"
      					FIN	
      				CAS 12
      					SI calerte.operateuregalite2 = 8 ALORS
      						chaineacompiler += ChaîneOccurrence(calerte.Liste_intercalaire2,TypeIntercalaire) + "> 0"
      						
      					FIN
      				CAS 13
      					SI calerte.operateuregalite2 = 9 ALORS
      						chaineacompiler += Carrelagesurligne + "=1"
      						
      					FIN
      				CAS 14
      					SI calerte.operateuregalite2 = 9 ALORS
      						chaineacompiler += FormeSurLigne + "=1"
      						
      					FIN
      				CAS 15
      					chaineacompiler += PAS ((LargeurThermos < Val(calerte.schoix2) ET HauteurThermos < Val(calerte.schoix2_1)) OU ...
      					(HauteurThermos < Val(calerte.schoix2) ET LargeurThermos < Val(calerte.schoix2_1)))
      					
      				CAS 16
      					SI calerte.operateuregalite2 = 9 ALORS
      						chaineacompiler += Produitspeciaux + "=1"
      					FIN
      					
      				AUTRE CAS
      					
      			FIN
      			
      			chaineacompiler += ")"
      			
      			
      			
      		FIN
      		
      		
      		SI calerte.action3 <> -1 ALORS
      			chaineacompiler+= " " + (calerte.cboperateur2	=1 ? "ET (" SINON "OU (" )
      			
      			SELON calerte.action3
      			
      				//// intercalaire
      				CAS 1
      					SI HLitRecherche(IntercalaireCouleurDimensions,IDIntercalaireCouleurDimensions,calerte.cbchoix3) ALORS
      						lidcouleurintercalaire = IntercalaireCouleurDimensions.IDIntercalaireCouleurs
      						lspacer = SansEspace(IntercalaireCouleurDimensions.numero)
      						lspacer2Texte = SansEspace(trdetail.FDespace2) <> "" ? " ou "+ trdetail.fdespace + taboperateur[calerte.operateuregalite3] +" "+lspacer SINON ""
      						
      						chaineacompiler += trdetail.ftypespacer+taboperateur[calerte.operateuregalite3]+" "+ lidcouleurintercalaire +" et ( " +SansEspace(trdetail.fdespace) + taboperateur[calerte.operateuregalite3] +" "+lspacer +...
      						lspacer2Texte+")"
      					FIN
      					
      				//// Total de la ligne
      				CAS 2
      					ltotalligne = Arrondi(trdetail.fdprixu + fdextraforme,2)
      					SI calerte.operateuregalite3 = 7 ALORS
      						chaineacompiler += Val(calerte.schoix3) +" <= " + ltotalligne +" <= " + Val(calerte.schoix3_1) 
      					SINON	
      						chaineacompiler += ltotalligne+taboperateur[calerte.operateuregalite3]+Val(calerte.schoix3) 
      					FIN
      					
      				//// Total de la commande
      				CAS 3
      					ltotalfacture = Arrondi(Val(commandeTRN.LibelléPrixAnglais))
      					SI calerte.operateuregalite3 = 7 ALORS
      						chaineacompiler += Val(calerte.schoix3) +" <= " + ltotalfacture +" <= " + Val(calerte.schoix3_1) 
      					SINON	
      						chaineacompiler += ltotalfacture+taboperateur[calerte.operateuregalite3]+Val(calerte.schoix3)
      					FIN
      					
      				// Total Pied carré réel
      				CAS 4
      					SI calerte.operateuregalite3 = 7 ALORS
      						chaineacompiler += Val(calerte.schoix3) +" <= " + trdetail.fdpiedcarrereel +" <= " + Val(calerte.schoix3_1) 
      					SINON	
      //						chaineacompiler += (commandeTRN.facalcul = 1 ? trdetail.fdpiedcarrereel SINON trdetail.fdpiedcarrereel * config.conversionam)+taboperateur[calerte.operateuregalite3]+Val(calerte.schoix3)
      						chaineacompiler += (commandeTRN.facalcul = 1 ? trdetail.fdpiedcarrereel SINON trdetail.fdpiedcarrereel * gclconfig.m_rconversionam)+taboperateur[calerte.operateuregalite3]+Val(calerte.schoix3)
      					FIN
      					
      				CAS 5
      					/// Épaisseur Thermos
      					
      					SI calerte.operateuregalite3 = 7 ALORS
      						chaineacompiler += Val(calerte.schoix3) +" <= " + EpaisseurThermos +" <= " + Val(calerte.schoix3_1) 
      					SINON	
      						chaineacompiler += EpaisseurThermos+taboperateur[calerte.operateuregalite3]+Val(calerte.schoix3)
      					FIN
      					
      				CAS 6 
      					/// Épaisseur du spacer.
      					SI HLitRecherche(IntercalaireCouleurDimensions,IDIntercalaireCouleursnumero,HConstruitValClé(IntercalaireCouleurDimensions,IDIntercalaireCouleursnumero,Combo_typespac,CDESPACE)) ALORS
      						EpaisseurSpacer = IntercalaireCouleurDimensions.DimensionI
      						SI calerte.operateuregalite3 = 7 ALORS
      							chaineacompiler += Val(calerte.schoix3) +" <= " + EpaisseurSpacer +" <= " + Val(calerte.schoix3_1) 
      						SINON	
      							chaineacompiler += EpaisseurSpacer+taboperateur[calerte.operateuregalite3]+Val(calerte.schoix3)
      						FIN
      						
      						
      					FIN
      					
      				CAS 7
      					SI calerte.operateuregalite3 = 7 ALORS
      						chaineacompiler += Val(calerte.schoix3) +" <= " + val(EpaisseurFini) +" <= " + Val(calerte.schoix3_1) 
      					SINON	
      						chaineacompiler += val(EpaisseurFini)+taboperateur[calerte.operateuregalite3]+Val(calerte.schoix3)
      					FIN	
      					
      				CAS 8
      					SI calerte.operateuregalite3 = 7 ALORS
      						chaineacompiler += Val(calerte.schoix3) +" <= " + _NbVerre +" <= " + Val(calerte.schoix3_1) 
      					SINON	
      						chaineacompiler += _NbVerre+taboperateur[calerte.operateuregalite3]+Val(calerte.schoix3)
      					FIN	
      					
      				CAS 9
      					SI _NbVerre <> 0 ALORS
      						SI calerte.operateuregalite3 = 7 ALORS
      							chaineacompiler += Val(calerte.schoix3) +" <= " + LargeurThermos +" <= " + Val(calerte.schoix3_1) 
      						SINON	
      							chaineacompiler += LargeurThermos+taboperateur[calerte.operateuregalite3]+Val(calerte.schoix3)
      						FIN
      					fin
      				CAS 10
      					SI _NbVerre <> 0 ALORS
      						SI calerte.operateuregalite3 = 7 ALORS
      							chaineacompiler += Val(calerte.schoix3) +" <= " + HauteurThermos +" <= " + Val(calerte.schoix3_1) 
      						SINON	
      							chaineacompiler += HauteurThermos+taboperateur[calerte.operateuregalite3]+Val(calerte.schoix3)
      						FIN	
      					fin
      				CAS 11
      					SI calerte.operateuregalite3 = 8 ALORS
      						pour chaque sCurrentComposante de tabComposantThermos
      						   chaineacompiler += ChaîneOccurrence(calerte.Liste_composante3,sCurrentComposante) + "> 0" +" OU "
      						FIN
                              chaineacompiler = chaineacompiler[1 a taille(chaineacompiler) - 4]	
                              		
      					SINON
      					    chaineacompiler += ChaîneOccurrence(ComposantThermos,calerte.schoix3) + "> 0"
      					FIN	
      				CAS 12
      					SI calerte.operateuregalite3 = 8 ALORS
      						chaineacompiler += ChaîneOccurrence(calerte.Liste_intercalaire3,TypeIntercalaire) + "> 0"
      						
      					FIN	
      				CAS 13
      					SI calerte.operateuregalite3 = 9 ALORS
      						chaineacompiler += Carrelagesurligne + "=1"
      						
      					FIN
      				CAS 14
      					SI calerte.operateuregalite3 = 9 ALORS
      						chaineacompiler += FormeSurLigne + "=1"
      						
      					FIN
      				CAS 15
      					chaineacompiler += PAS ((LargeurThermos < Val(calerte.schoix3) ET HauteurThermos < Val(calerte.schoix3_1)) OU ...
      					(HauteurThermos < Val(calerte.schoix3) ET LargeurThermos < Val(calerte.schoix3_1)))
      					
      				CAS 16
      					SI calerte.operateuregalite3 = 9 ALORS
      						chaineacompiler += Produitspeciaux + "=1"
      					FIN
      					
      				AUTRE CAS
      					
      			FIN
      			
      			chaineacompiler += ")"
      			
      			
      			
      		FIN
      		
      		
      		
      		
      		
      		chaineacompiler = "renvoyer ("+ chaineacompiler + ")"
      		
      		
      		sResultat est une booleen 
      		sResultatCompile est une chaîne 
      		sResultatCompile = Compile("Proc_dynamique", chaineacompiler)
      		
      		SELON sResultatCompile
      			CAS "" : sResultat = ExécuteTraitement("Proc_dynamique", trtProcédure)
      			autre cas : sResultat = faux	
      		FIN
      		
      		si sResultat alors
      			
      			si calerte.typeaffichage = 1 alors
      				acso_message("Alerte",calerte.messageaffiche,"Info")
      				MessageTraite[calerte.idfmessage] = vrai
      				messagedejaaffiche = vrai
      				si calerte.mFocus > 1 alors
      					reprisesaisie({lmFocus[calerte.mFocus]})
      				fin
      			sinon
      				si ChaîneOccurrence(MessageAAfficher,calerte.messageaffiche) = 0  alors
      					
      					MessageAAfficher+= calerte.messageaffiche + RC
      					MessageTraite[calerte.idfmessage] = Vrai
      					
      					SI calerte.mFocus > 1 ALORS
      						ChamprepriseSaisie = lmFocus[calerte.mFocus]
      					FIN
      				fin
      				//				HExécuteRequête(RequeteDernierNoLigne)
      				//				lprochain_no_ligne = RequeteDernierNoLigne.fdligne+1
      				//				smessagetraiteligne est un StructMessageTraite
      				//				tableauajoute(smessagetraiteligne.NoLigne,lprochain_no_ligne)
      				//				
      				//				MessageTraiteLigne[calerte.idfmessage] = smessagetraiteligne
      				//				info(MessageTraiteLigne[calerte.idfmessage].noligne[1])
      			FIN
      			//		sinon
      			//			HExécuteRequête(RequeteDernierNoLigne)
      			//			lprochain_no_ligne = RequeteDernierNoLigne.fdligne+1
      			//			sres est un entier = TableauCherche(MessageTraiteLigne[calerte.idfmessage],tcLinéaire,lprochain_no_ligne)
      			//			si  sres <> -1 alors
      			//				info(
      			//				
      			//			FIN
      		FIN
      	FIN
      	
      FIN
      
      
      renvoyer messagedejaaffiche
     type : 458752
   -
     name : PrintDocument
     procedure_id : 2220583786321777888
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      // PrintDocument ()
      //
      // Paramètres :
      //	Aucun
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE PrintDocument()
      
      si facture.NewEdiOrder alors
      	
      	si facture.AvecForme ou facture.AvecCarrelage ou facture.AvecProduitSpeciaux
      		OuvreSoeur(FenAttentePetite,"Impression des documents en cours...")
      		iFenêtreAbandon(Faux)
      		iConfigure(SansEspace(imprimanteconfirmation),Vrai)
      		iParamètre("DEFAUT=NON")
      		iParamètre("FORMATPAPIER=LETTRE")
      		iParamètre("QUALITE=MOYENNE")
      		iParamètre("ORIENTATION=PORTRAIT")
      		
      		//iParamètre("QUALITE=HAUTE")
      		HExécuteRequête(RequetefeuilleLivraison,hRequêteDéfaut,Facture.fanumero)
      		iImprimeEtat(ConfirmationTRNmat,Faux,0,Faux)
      		iParamètre("QUALITE=MOYENNE")
      		
      		
      		iFenêtreAbandon(Faux)
      		//		OuvreSoeur(FenAttentePetite,"Impression de la confirmation "+RequeteTablefacture.fanumero+" en cours...")
      		iConfigure(imprimanteconfirmation)
      		iParamètre("DEFAUT=NON")
      		iParamètre("ORIENTATION=PAYSAGE")
      		
      		HExécuteRequête(RequetefeuilleLivraison,hRequêteDéfaut,Facture.fanumero)
      		iParamètreAperçu(iVoletMiniatures,Faux)
      		iAperçu(100)
      		iImprimeEtat(ConfirmationTRN)
      		Ferme(FenAttentePetite)
      	FIN
      	
      	
      	facture.NewEdiOrder = Faux
      	hmodifie(facture,hNumEnrEnCours)
      FIN
      
     type : 458752
