     code : |1+
      Procédure RecupereFacture(lRecordRecupere)
      lListeRubrique est un chaine = HListeRubrique(facture)
      i est un entier
      
      pour i = 2 a 34
      	{"Facture."+ExtraitChaîne(lListeRubrique,i,rc)} = extraitchaine(lRecordRecupere,i,tab)
      fin
      
      
      renvoyer vrai
      
      
     type : 458752
   -
     name : verifieMaximum
     procedure_id : 5859041163558438721
     type_code : 14
     code : |1-
      Procédure verifieMaximum(ldimension1,ldimension2)
      Largeurdepasse est un booleen
      HauteurDepasse est un booleen
      cpt est un entier = 0
      //si sansespace(commandetrn.CDCOMPOSANT2)  = "" _et_ SansEspace(commandeTRN.CDCOMPOSANT3)  = ""  alors produitfixe = Vrai
      
      si produitfixe ou ldimension1=0 ou ldimension2=0 alors
      	renvoyer vrai
      FIN
      
      pour i = 1 a 3
      	si pas sansespace({"commandetrn.CDCOMPOSANT"+i}) = "" alors
      		cpt++
      		si hlitrecherche(invent,inum,{"commandetrn.CDCOMPOSANT"+i}) alors
      			si invent.ihauteurmax < ldimension1 alors
      				si invent.ilargeurmax < ldimension1 alors
      					Largeurdepasse = vrai
      				sinon
      					si invent.ihauteurmax < ldimension2 alors
      						HauteurDepasse = vrai
      					fin
      				fin
      			sinon
      				si invent.ilargeurmax < ldimension2 alors
      					HauteurDepasse = vrai
      				fin	
      			FIN
      		FIN
      	fin
      FIN
      
      Si Largeurdepasse alors
      	si acso_message("OuiNon","La dimension inscrite dépasse la capacité maximum d'un des verres"+rc+"Voulez-vous continuer avec cette dimension ?","OuiNon") = idno alors
      		reprisesaisie(cdlargeur)
      	FIN
      FIN
      Si HauteurDepasse alors
      	si acso_message("OuiNon","La dimension inscrite dépasse la capacité maximum d'un des verres"+rc+"Voulez-vous continuer avec cette dimension ?","OuiNon") = idno alors
      		reprisesaisie(cdhauteur)
      	FIN
      FIN
     type : 458752
   -
     name : RemplirTableContact
     procedure_id : 5859041163311302465
     type_code : 14
     code : |1+
      Procédure RemplirTableContact(lNumLigne=0,Libcolonne="",ltoucheenfoncee=0,lNoClient="")
      i est un entier
      TableSupprimeTout(TableContact)
      si hlitrecherche(client,numero,sansespace(table.FACLIENTTable[lNumLigne])) alors
      	pour i = 1 a 3
      		si sansespace(client.ccontact[i]) <> "" ou sansespace(client.ccontacttitre[i]) <> "" alors
      			tableajouteligne(TableContact,client.ccontacttitre[i],client.ccontact[i],client.ccontactTel[i] )
      		fin
      	FIn
      FIN
      
      si pas TableContact..vide alors
      	pGestionSurvol.AfficherTable(tablecontact..nom,Const_Centré,0,vrai)
      fin
      
      
      
     type : 458752
   -
