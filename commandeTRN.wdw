               //FIN
               //Couleur_Intercalaire = Combo_typespac.scouleur
               si moimeme <> oldspacer ALORS
               	cdespace = ""
               	cdespace2 = ""
               	oldspacer = moimeme
               FIN
               si commandetrn.COMMANDECREDIT <> 3 alors
               	si moimeme = 0 alors 
               		Erreur("Cet intercalaire n'est pas disponible en mode commande ou crédit")
               		reprisesaisie(moimeme)
