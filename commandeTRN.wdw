               		commandetrn.reference..visible = vrai
               		commandetrn.libelle3..visible = faux
               		commandetrn.libellecredit..visible = vrai
               		commandetrn.libelle4..visible = faux
               
               
               	cas 3
               		commandetrn.fanocommande..etat = AffichageSeulement
               		commandetrn.fanojob..etat = AffichageSeulement
               		commandetrn.reference..visible = faux
               		commandetrn.libelle3..visible = faux
               		commandetrn.libelle4..visible = vrai
               		commandetrn.libellecredit..visible = faux
