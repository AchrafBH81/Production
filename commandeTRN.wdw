  -
    name : BtnConfirmation
    identifier : 0x514f7ee57726c7cd
    internal_properties : 
    properties :
     x : 485
     y : 6
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        internal_properties : CQAAAAkAAAAMKk0bUnppf9n/DdIx+pD12FdjGBpDdPouTXmKpwRX8VSK7s3EyvfwpbA1UoOIDFhQRWUvEtPmaHQL3DqP9EYkvNp92ZaY8pL88p/fEQhlXNEtBTP55g==
        code : |1-
         lAdresseCourriel est une chaine
         sLNumeroClient est une chaine
         ListeFichier est une chaine
         ListeNoFacture est une chaine
         lsujet est une chaine
         lMessage est une chaine 
         nLTailleFichier est un entier = 0
         lnomfichier est une chaine
         nLcptfacture est un entier
         sLignedecommande est une chaine
         i est un entier
         bLPrepareFichier est un booleen = Faux
         
         CurrentLine est une chaine = TableSauvePositionEtSélection(TABLE)
         
         //A FAIRE :Vérifier si on peut mettre les info de la table au lieu de celles de la requete.
         selon Onglet1
         	cas 1
         		si hlitrecherche(client,numero,sansespace(RequeteTablefacture.faclient)) alors
         			selon client.cconfirmation
         				cas 0,1
         					acso_message("Information","Ce client n'est pas configuré pour reçevoir de confirmation de commande","Info")
         				cas 2
         					iFenêtreAbandon(faux)
         					ouvresoeur(FenAttentePetite,"Impression de la confirmation "+RequeteTablefacture.fanumero+" en cours...")
         					iConfigure(imprimanteconfirmation)
         					iParamètre("DEFAUT=NON")
         					iParamètre("ORIENTATION=PAYSAGE")
         					//					iParamètre("COPIES="+config.NbCopieConfirmation)
         					iParamètre("COPIES="+gclconfig.m_nNbCopieConfirmation)
         					HExécuteRequête(RequetefeuilleLivraison,hRequêteDéfaut,RequeteTablefacture.fanumero)
         					
         					iImprimeEtat(ConfirmationTRN)
         					ferme(FenAttentePetite)
         				cas 3
         					
         					
         					//					si gImprimantePdfStatus alors
         					//						pdfc>>cPrinterStop = 1
         					//						si frep(completerep(repdonnees)+"PDF\"+sansespace(client.numero)+"\Confirmation",frRépertoire) = "" alors
         					//							fRepCrée(completerep(repdonnees)+"PDF\"+sansespace(client.numero)+"\Confirmation")
         					//						fin
         					//						pdfc>>cOption("AutosaveDirectory") = completerep(repdonnees)+"PDF\"+sansespace(client.numero)+"\Confirmation"
         					//						pdfc>>cOption("AutosaveFilename")  ="Conf"+RequeteTablefacture.fanumero
         					//						//								pdfc>>cOption("AutosaveFilename")  ="Conf"+RequeteTablefacture.fanumero+".pdf"
         					//						lnomfichier = pdfc>>cOption("AutosaveDirectory")+"\Conf"+RequeteTablefacture.fanumero+".pdf"
         					lnomfichier = ComplèteRep(repdonnees)+"PDF\"+SansEspace(Client.numero)+"\Confirmation\Conf"+RequeteTablefacture.fanumero+".pdf"
         					
         					//					SI HLitRecherche(Facture,fanumero,RequeteTablefacture.fanumero)
         					si hlitrecherche(Facture,FACLEUNIK,table) alors
         						si facture.ConfirmationSended alors
         							si ouinon("Cette confirmation à déjà été envoyée au client. Voulez vous continuer ?") = non alors renvoyer vrai
         						sinon	
         							//							facture.ConfirmationSended = Vrai
         							//							HModifie(facture,hNumEnrEnCours)
         						fin
         					FIN
         					si fFichierExiste(lnomfichier) alors
         						SI PAS fSupprime(lnomfichier) ALORS
         							Erreur("Un problème est survenu avec le fichier " +SansEspace(lnomfichier)+ RC +" Vérifier qu'il n'est pas déjà ouvert par un utilisateur !!")
         							RENVOYER Vrai
         						FIN
         					FIN
         					si client.ediType = 2 et RequeteTablefacture.isedi alors 
         						SendEdiBascoConfirmation(RequeteTablefacture.fanumero)
         						ToastAffiche("Confirmation envoyé sur le serveur FTP du client",toastCourt)
         					FIN
         					//					iConfigure(SansEspace(imprimantefacture),Vrai)
         					si pas fFichierExiste(lnomfichier) alors
         						iParamètre("DEFAUT=NON")
         						iParamètre("FORMATPAPIER=LETTRE")
         						iDestination(iPDFGénérique,ComplèteRep(repdonnees)+"PDF\"+SansEspace(Client.numero)+"\Confirmation\Conf"+RequeteTablefacture.fanumero+".pdf")
         						ouvresoeur(FenAttentePetite,"Impression du fichier conf"+RequeteTablefacture.fanumero+" en cours...")
         						HExécuteRequête(RequetefeuilleLivraison,hRequêteDéfaut,RequeteTablefacture.fanumero)
         						
         						FenAttentePetite.libelle1="Préparation du fichier PDF conf"+RequeteTablefacture.fanumero+" en cours..."
         						iImprimeEtat(ConfirmationTRN)
         						Ferme(FenAttentePetite)
         					fin
         					POUR i = 1 À 4
         						SI SansEspace(Client.ccourrielConfirmation[i]) <> "" ALORS
         							lAdresseCourriel += SansEspace(Client.ccourrielConfirmation[i])+";"
         						FIN
         					FIN
         					si client.CLangue = 1 alors
         						//						lsujet = SANSESPACE(config.SujetFrancais[3])+" "
         						//						lMessage = config.TexteFrancais[3]
         						lsujet = SansEspace(gclconfig.m_tabSujetFrancais[3])+" "
         						lMessage = gclConfig.m_tabTexteFrancais[3]
         					sinon
         						//						lsujet = SansEspace(config.SujetAnglais[3])+" "
         						//						lMessage = config.TexteAnglais[3]
         						lsujet = SansEspace(gclConfig.m_tabSujetAnglais[3])+" "
         						lMessage = gclConfig.m_tabTexteAnglais[3]
         						
         					fin	
         					
         					sablier(vrai)
         					
         					
         					ListeFichier+=lnomfichier+";"
         					ListeNoFacture+=sansespace(RequeteTablefacture.fanocommande)+","
         					sablier(faux)
         					
         					
         					lsujet+=ListeNoFacture[[1 a taille(ListeNoFacture)-1]]
         					si ouvre(FenEmail,lAdresseCourriel,lsujet,lMessage,ListeFichier,RequeteTablefacture.faclient,faux,1) alors
         						
         						HDésactiveTrigger("facture","hajoute,hmodifie,hsupprime,hecrit",hTriggerAprès)
         						SI HLitRecherche(Facture,FACLEUNIK,TABLE) alors
         							
         							Facture.ConfirmationSended = Vrai
         							HModifie(Facture,hNumEnrEnCours)
         							majlogmanuel(facture.fanumero,"","Confirmation")
         						fin
         						HActiveTrigger("facture","hajoute,hmodifie,hsupprime,hecrit",hTriggerAprès)
         					FIN
         					//					sinon
         					//						acso_message("Erreur","Ce client est configuré pour une confirmation par courriel."+rc+"Cependant l'imprimante PDF virtuelle n'est pas disponible.","Erreur")
         					//					fin
         					
         				cas 4	
         				cas 5
         					iFenêtreAbandon(Faux)
         					OuvreSoeur(FenAttentePetite,"Impression de la confirmation "+RequeteTablefacture.fanumero+" en cours...")
         					iConfigure(imprimantefax)
         					iParamètre("DEFAUT=NON")
         					iParamètre("ORIENTATION=PAYSAGE")
         					//					iParamètre("COPIES="+config.NbCopieConfirmation)
         					iParamètre("COPIES="+gclConfig.m_nNbCopieConfirmation)
         					HExécuteRequête(RequetefeuilleLivraison,hRequêteDéfaut,RequeteTablefacture.fanumero)
         					
         					iImprimeEtat(ConfirmationTRN)
         					Ferme(FenAttentePetite)
         					HDésactiveTrigger("facture","hajoute,hmodifie,hsupprime,hecrit",hTriggerAprès)
         					Facture.ConfirmationSended = Vrai
         					HModifie(Facture,hNumEnrEnCours)
         					MajLogManuel(Facture.fanumero,"","Confirmation")
         					HActiveTrigger("facture","hajoute,hmodifie,hsupprime,hecrit",hTriggerAprès)
         					
         					
         			FIN
         		FIN
         		
         		
         	// requete soumission		
         	cas 2
         		
         		SI HLitRecherche(Client,numero,SansEspace(RequeteTableSoumission.faclient)) ALORS
         			SELON Client.cconfirmation
         				CAS 0,1
         					ACSO_message("Information","Ce client n'est pas configuré pour reçevoir de confirmation de soumission","Info")
         				CAS 2
         					iFenêtreAbandon(Faux)
         					OuvreSoeur(FenAttentePetite,"Impression de la soumission "+RequeteTablesoumission.fanumero+" en cours...")
         					iConfigure(imprimanterapport)
         					iParamètre("DEFAUT=NON")
         					iParamètre("ORIENTATION=PAYSAGE")
         					//					iParamètre("COPIES="+config.NbCopieConfirmation)
         					iParamètre("COPIES="+gclconfig.m_nNbCopieConfirmation)
         					
         					HExécuteRequête(RequeteSoumission,hRequêteDéfaut,RequeteTableSoumission.fanumero)
         					
         					//iAperçu(i100, "Aperçu écran", Vrai)
         					iImprimeEtat(SoumissionTRN)
         					Ferme(FenAttentePetite)
         				CAS 3
         					//					SI gimprimantepdfstatus ALORS
         					//						pdfc>>cPrinterStop = 1
         					//						SI fRep(ComplèteRep(repdonnees)+"PDF\"+SansEspace(Client.numero)+"\Soumission",frRépertoire) = "" ALORS
         					//							fRepCrée(ComplèteRep(repdonnees)+"PDF\"+SansEspace(Client.numero)+"\Soumission")
         					//						FIN
         					//						pdfc>>cOption("AutosaveDirectory") = ComplèteRep(repdonnees)+"PDF\"+SansEspace(Client.numero)+"\Soumission"
         					//						pdfc>>cOption("AutosaveFilename")  ="Soum"+RequeteTableSoumission.fanumero
         					//						//								pdfc>>cOption("AutosaveFilename")  ="Conf"+RequeteTablefacture.fanumero+".pdf"
         					//						lnomfichier = pdfc>>cOption("AutosaveDirectory")+"\Soum"+RequeteTablesoumission.fanumero+".pdf"
         					lnomfichier = ComplèteRep(repdonnees)+"PDF\"+SansEspace(Client.numero)+"\Soumission\Soum"+RequeteTablesoumission.fanumero+".pdf"
         					
         					//					SI HLitRecherche(Facture,fanumero,RequeteTableSoumission.fanumero) 
         					SI HLitRecherche(Facture,FACLEUNIK,table1) 
         						SI Facture.ConfirmationSended ALORS
         							SI OuiNon("Cette confirmation à déjà été envoyée au client. Voulez vous continuer ?") = Non ALORS RENVOYER Vrai
         						SINON	
         							//							Facture.ConfirmationSended = Vrai
         							//							HModifie(Facture,hNumEnrEnCours)
         						FIN
         					FIN
         					
         					SI fFichierExiste(lnomfichier) ALORS
         						//						SI ACSO_message("Question","La soumission " +lnomfichier+" existe déjà"+RC+...
         						//							"Voulez-vous l'écraser","OuiNon") = IDYES
         						si pas fSupprime(lnomfichier) alors
         							erreur("Un problème est survenu avec le fichier " +sansespace(lnomfichier)+ rc +" Vérifier qu'il n'est pas déjà ouvert par un utilisateur !!")
         							renvoyer vrai
         						FIN
         						//						SINON
         						//							RENVOYER Vrai	
         						//						FIN
         					FIN
         					SI pas  fFichierExiste(lnomfichier) alors
         						OuvreSoeur(FenAttentePetite,"Impression du fichier Soum"+RequeteTablesoumission.fanumero+" en cours...")
         						
         						HExécuteRequête(RequeteSoumission,hRequêteDéfaut,RequeteTableSoumission.fanumero)
         						Sablier(Vrai)
         						iConfigure(SansEspace(imprimantefacture),Vrai)
         						iParamètre("DEFAUT=NON")
         						iParamètre("FORMATPAPIER=LETTRE")
         						iDestination(iPDFGénérique,lnomfichier)
         						iImprimeEtat(SoumissionTRN)
         						FenAttentePetite.libelle1="Préparation du fichier PDF Soum"+RequeteTableSoumission.fanumero+" en cours..."
         						ferme(FenAttentePetite)
         					fin
         					
         					//iAperçu(i100, "Aperçu écran", Vrai)
         					POUR i = 1 A 4
         						
         						SI SansEspace(Client.ccourrielConfirmation[i]) <> "" ALORS
         							lAdresseCourriel += SansEspace(Client.ccourrielConfirmation[i])+";"
         						FIN
         					FIN
         					
         					SI Client.CLangue = 1 ALORS
         						//						lsujet = SansEspace(config.SujetFrancais[5])+" "
         						//						lMessage = config.TexteFrancais[5]
         						lsujet = SansEspace(gclConfig.m_tabSujetFrancais[5])+" "
         						lMessage = gclConfig.m_tabTexteFrancais[5]
         					SINON
         						//						lsujet = SansEspace(config.SujetAnglais[5])+" "
         						//						lMessage = config.TexteAnglais[5]
         						lsujet = SansEspace(gclConfig.m_tabSujetAnglais[5])+" "
         						lMessage = gclConfig.m_tabTexteAnglais[5]
         						
         					FIN	
         					
         					Sablier(Faux)
         					
         					//						TANTQUE PAS pdfc>>ccountofprintjobs() = 1
         					//							
         					//						FIN
         					//						
         					//						
         					//						Multitâche(100)				
         					//						pdfc>>cPrinterStop = 0
         					//						TANTQUE pdfc>>ccountofprintjobs() >= 1
         					//							i++
         					//						FIN
         					//						
         					//						Multitâche(100)				
         					//						
         					//						
         					//						pdfc>>cPrinterStop = 1
         					
         					ListeFichier+=lnomfichier+";"
         					ListeNoFacture+=SansEspace(RequeteTableSoumission.fanumero)+","
         					
         					
         					
         					lsujet+=ListeNoFacture[[1 A Taille(ListeNoFacture)-1]]
         					si Ouvre(FenEmail,lAdresseCourriel,lsujet,lMessage,ListeFichier,RequeteTablesoumission.faclient,Faux,5) alors
         						HDésactiveTrigger("facture","hajoute,hmodifie,hsupprime,hecrit",hTriggerAprès)
         						SI HLitRecherche(Facture,FACLEUNIK,TABLE1)
         							Facture.ConfirmationSended = Vrai
         							HModifie(Facture,hNumEnrEnCours)
         							MajLogManuel(Facture.fanumero,"","Confirmation")
         							
         						fin
         						HActiveTrigger("facture","hajoute,hmodifie,hsupprime,hecrit",hTriggerAprès)
         					FIN	
         					
         					
         				CAS 4	
         				CAS 5
         					
         					iFenêtreAbandon(Faux)
         					OuvreSoeur(FenAttentePetite,"Impression de la soumission"+RequeteTableSoumission.fanumero+" en cours...")
         					iConfigure(imprimantefax)
         					iParamètre("DEFAUT=NON")
         					iParamètre("ORIENTATION=PAYSAGE")
         					//					iParamètre("COPIES="+config.NbCopieConfirmation)
         					iParamètre("COPIES="+gclConfig.m_nNbCopieConfirmation)
         					HExécuteRequête(RequeteSoumission,hRequêteDéfaut,RequeteTableSoumission.fanumero)
         					iImprimeEtat(SoumissionTRN)
         					Ferme(FenAttentePetite)
         					HDésactiveTrigger("facture","hajoute,hmodifie,hsupprime,hecrit",hTriggerAprès)
         					Facture.ConfirmationSended = Vrai
         					HModifie(Facture,hNumEnrEnCours)
         					MajLogManuel(Facture.fanumero,"","Confirmation")
         					
         					HActiveTrigger("facture","hajoute,hmodifie,hsupprime,hecrit",hTriggerAprès)
         					
         			FIN
         		FIN
         	AUTRE CAS
         		
         FIN
         
         TableRestaurePositionEtSélection(TABLE,CurrentLine)
         
         
         
         
         
         
         
         
         
         CAS EXCEPTION:
         	
         	erreur(erreurinfo(errcomplet))
