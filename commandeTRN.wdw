        -
          name : cdnumprod
          identifier : 0x514f7ee52a1cc7af
          internal_properties : 
          properties :
           x : 35
           y : 2
           width : 103
           height : 23
          type : 2
          code_elements :
           type_code : 3
           p_codes :
            -
              code : |1+
               
               BOUTONCOULEUR..etat = actif
               si pas dmodif _et_ Combo_typespac = 0 _et_ pas commandetrn.COMMANDECREDIT = 3 alors
               	Combo_typespac=client.cspacerdefaut
               FIN
               typeunite = 0
               //commandeTRN.CDDESC..CouleurFond = Transparent
              type : 15
            -
              code : |1-
               lNorecperso est un entier  // pour garder en memoire le # de record du thermos trouvé avent le calcul du prix
               ancientypedeproduit = typedeproduit
               anciennbverre = nbverre
               //SI MoiMême..Modifié OU clicbouton OU SansEspace(MoiMême)="" OU PAS dmodif ALORS
               SI MOIMEME..MODIFIE ou clicbouton ou pas dmodif ALORS
               	SI MoiMême..Modifié ALORS
               		intPrixmodifie = Faux
               		CDPRIXUPIED..couleur = CouleurDéfaut
               		
               	FIN
               	//	moimeme..modifie = faux
               	
               	si dmodif alors
               		dfini =""
               		cdespace = ""
               		cdespace2 = ""
               	fin
               	
               	
               	intsurfacemodifie=faux
               	
               	cdenergiverre = faux
               	CDCAPGAZTUBE=""
               	ExécuteTraitement(Combo_typespac,trtSortie)
               	degriser_saisie()
               	si sansespace(moimeme)="" alors
               	sinon
               		SI existe_produit_kit(moimeme) ALORS
               			si pas(persoens.enactif) alors
               				Erreur("Ce produit est inactif")
               				moimeme = ""
               				reprisesaisie(moimeme)
               			fin	
               			si  ForbiddenComponent() alors
               				erreur("Ce produit contient une composante non autorisée pour ce client")
               				moimeme = ""
               				CDCOMPOSANT1 = ""
               				CDCOMPOSANT2 = ""
               				CDCOMPOSANT3 = ""
               			    RepriseSaisie(MoiMême)
               			FIN
               			
               			lPasCalcul5X10X = persoens.enpas5X10X
               			lien_intercallaire = persoens.elien 
               			typedeproduit = "Verre"
               			pdebase = persoens.epbase
               			
               			commandetrn.FDIntercalaire = persoens.EnIntercalaire
               			commandeTRN.FDfabrication = persoens.enfabrication
               			
               			lNorecperso = HSauvePosition(persoens)
               			affiche_nom()
               			si pas sansespace(CDLARGEUR) = "" et pas SansEspace(cdhauteur)="" et pas dmodif alors
               				ExécuteTraitement(cdqte,trtSortie)
               				ExécuteTraitement(CDPRIXUPIED,trtSortie)
               			sinon
               				calcul_prixu(commandetrn.facalcul,escompteqte,pourcescompteqte)
               			fin
               			HRetourPosition(lNorecperso)
               			si pas sansespace(dfini) = "" alors
               				_epaisseurCourante est un reel = epaisseur
               				//calcul_espace_tableau1(dfini,faux)
               				epaisseur = _epaisseurCourante
               			fin
               			
               			
               			// pour verre unite défini comme thermos
               			SI SANSESPACE(CDCOMPOSANT2) = "" ET SANSESPACE(CDCOMPOSANT3) = "" ALORS
               				griser_saisie(3)
               				Combo_typespac = 0
               				//typedeproduit = "Verreunite"   // a verifier
               				cdverreunite  = vrai
               			sinon
               				si SANSESPACE(CDCOMPOSANT3) = "" alors commandetrn.nbverre="double" sinon commandetrn.nbverre="triple"
               			FIN
               			
               			si pas dmodif alors
               				si pas sansespace(commandetrn.fdforme) = "" alors
               					si hlitrecherche(formeclient,IdClientNoForme,hconstruitvalcle(FormeClient,IdClientNoForme,...
               						commandetrn.FCLIENT,commandetrn.fdforme)) alors
               						si commandetrn.nbverre = "double" alors commandetrn.fdextraforme = formeclient.fPrixdouble sinon commandetrn.fdextraforme  = formeclient.FpRixtriple
               					sinon	
               						si commandetrn.nbverre = "double" alors commandetrn.fdextraforme  = forme.extradouble sinon commandetrn.fdextraforme  = forme.extratriple
               					fin
               				fin
               			fin
               			si nbverre = "double" alors CDESPACE2 = ""
               			si AncienNbVerre <> nbverre alors
               				dfini = ""
               				CDESPACE = ""
               				CDESPACE2 = ""
               			fin
               			
               			selon langueclient
               				cas 0,1	
               					commandetrn.cddesc = persoens.endescription
               					descriptionoriginale = persoens.endescription
               				cas 2	
               					commandetrn.cddesc = persoens.endescriptiona
               					descriptionoriginale = persoens.endescriptiona
               			FIN
               			
               			commandetrn.cdcodegl = persoens.encodegl
               			
               			execute("commandetrn.cdcarrelage..sortie")
               		sinon 
               			si existe_produit(moimeme,"","Verre") alors
               				typeunite = invent.iunitetype
               				selon langueclient
               					cas 0,1
               						commandetrn.cddesc = invent.idesc
               					cas 2 
               						commandetrn.cddesc = invent.idesca
               				fin
               				commandetrn.cdcodegl = invent.icodegl
               				SI SansEspace(commandeTRN.CDCODEGL) = "" ALORS
               					//	commandeTRN.CDCODEGL = config.glventedefaut
               					commandeTRN.CDCODEGL = gclConfig.m_sGlventedefaut
               				FIN
               				commandetrn.cdregroupement = invent.inumerodimensionspeciale
               				cdverreunite  = faux
               				cdcarrelage = faux  
               				ExécuteTraitement(CDCARRELAGE,trtModification) 
               				selon invent.itype
               					cas  4    // carrelage
               						raz_nom()
               						produittableauprix = faux
               						griser_saisie(2)
               						typedeproduit = "Unite"
               						reprisesaisie(CDJOBLIGNE)
               					cas 3
               						griser_saisie(2)
               						typedeproduit = "Spacer"
               						reprisesaisie("cddesc")
               					cas 5
               						raz_nom()
               						Combo_typespac = 0
               						selon invent.iUniteMesure
               							cas 1
               								griser_saisie(2)
               								typedeproduit = "PeintureUnite"
               							cas 2,3
               								griser_saisie(1)
               								typedeproduit = "Peinture"
               							cas 4
               								griser_saisie(24)
               								typedeproduit = "Peinture"
               						fin
               						
               						calcul_prixu(commandetrn.facalcul,escompteqte,pourcescompteqte)
               						affichepeinture()
               						
               						reprisesaisie(fNoPeinture)
               					cas 2
               						si typeunite = 2 alors
               							raz_nom()
               							griser_saisie(11)
               							typedeproduit = "Verreunite"
               							cdverreunite  = vrai
               							calcul_prixu(commandetrn.facalcul,escompteqte,pourcescompteqte)
               							
               						sinon
               							raz_nom()
               							si invent.itableauprix alors
               								produittableauprix = vrai
               								griser_saisie(21)
               							sinon
               								produittableauprix = faux
               								griser_saisie(2)
               							fin
               							typedeproduit = "Unite"
               						fin
               						//						si client.cactivationchampspecuaix alors
               						//							reprisesaisie("cdjobligne")
               						//						sinon	
               						si produittableauprix alors
               							reprisesaisie("commandetrn.fdlargeuru")
               						sinon
               							reprisesaisie(CDJOBLIGNE)
               						fin
               						//						FIN
               						
               					cas  1    // carrelage
               						reprisesaisie("cddesc")
               					autres cas
               						REPRISESAISIE("cdcomposant1")
               				fin   
               			sinon
               				reprisesaisie(CDJOBLIGNE)
               			fin
               			
               		FIN
               	fin
               	MoiMême..Modifié = Faux	
               	
               sinon
               	si moimeme <> "" alors
               		si existe_produit_kit(MoiMême) alors
               			//	si hlitrecherche(persoens,ActifComposant,HConstruitValClé(persoens,ActifComposant,vrai,commandetrn.CDCOMPOSANT1,commandetrn.CDCOMPOSANT2,commandeTRN.CDCOMPOSANT3)) alors  //et  persoens.enactif alors
               			commandetrn.pdebase = persoens.epbase
               			commandetrn.FDfabrication = persoens.enfabrication
               		fin
               	fin
               	si typedeproduit = "Verre" alors
               		si SANSESPACE(CDCOMPOSANT3) = "" alors commandetrn.nbverre="double" sinon commandetrn.nbverre="triple"
               	fin
               fIN
               //reprisesaisie(CDjobligne)
              type : 16
            -
              type : 276
              enabled : false
            -
              type : 277
              enabled : false
            -
              type : 278
              enabled : false
            -
              type : 338
              enabled : false
            -
              type : 339
              enabled : false
        -
          name : BTN_COMPOSANT2
          identifier : 0x514f7ee52805c773
          internal_properties : 
          properties :
           x : 6
           y : 41
           width : 80
           height : 24
          type : 4
          code_elements :
           type_code : 4
           p_codes :
            -
              code : |1-
               
               
               commandetrn.cdcomposant2=Ouvre("Recherche de produit","","verre")
               commandetrn.CDCOMPOSANT2..MODIFIE = VRAI
               
               si champencours() = "CDCOMPOSANT2" alors
               
               	envoietouche("{entree}")
               sinon
               	ExécuteTraitement(commandetrn.cdcomposant2,trtsortie)
               FIN
              type : 18
            -
              type : 161
              enabled : false
        -
          name : CDCOMPOSANT1
          identifier : 0x514f7ee542e8c7a5
          internal_properties : 
          properties :
           x : 78
           y : 23
           width : 64
           height : 23
          type : 2
          code_elements :
           type_code : 3
           p_codes :
            -
              code : |1+
               //commandetrn.btn_composant1..visible = faux
               si moimeme..modifie ou dmodif ou sansespace(cdnumprod) = ""alors
               	SI SANSESPACE(MOIMEME) = "" ALORS
               		COMPOSANT1_NOM = ""
               	SINON		
               		si pas existe_produit(moimeme,Vrai) alors
               			
               			reprisesaisie()
               		SINON
               			SI  ForbiddenComponent(moimeme) ALORS
               				Erreur("Cette composante n'est pas autorisée pour ce client")
               				MoiMême			= ""
               				RepriseSaisie(MoiMême)
               			FIN
               			selon langueclient
               				cas 0,1
               					composant1_nom  = invent.idesc
               				cas 2
               					composant1_nom  = invent.idescA
               			FIN
               			
               			produitdebase1 = invent.ipbase
               			descriptioncourte1 = sansespace(invent.idesccourte)
               			si pas cdenergiverre alors
               				cdenergiverre  = (invent.ienergieverre OU invent.ienergieverreESC)
               				si CDENERGIVERRE alors
               					ajoutez()
               				fin
               			fin
               		FIN
               	FIN
               	calcul_prixu(commandeTRN.facalcul,escompteqte,pourcescompteqte)
               FIN
               si clicbouton alors
               	ecranpremier("CDCOMPOSANT2")
               	clicbouton = faux
               fin
               
              type : 16
            -
              type : 276
              enabled : false
