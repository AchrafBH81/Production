   -
     name : trouveescomptetableau
     procedure_id : 5859041163363010369
     type_code : 14
     code : |1+
      Procédure trouveescomptetableau(numproduit,largeur,hauteur)
      //Code WinDev 5.5 remplacé par la migration :
      //valeuraretourner est un reel double = 0
      valeuraretourner est un réel = 0
      
      si commandetrn.facalcul = 1 alors
      
      hlitrecherche("dimcoul","dclea",complete(numproduit,10)+complete(largeur,10)+caract(0))
      //Code WinDev 5.5 remplacé par la migration :
      //si pas h.endehors et sansespace(numproduit) = sansespace(dimcoul.dnumero) alors
      si pas HEnDehors() et sansespace(numproduit) = sansespace(dimcoul.dnumero) alors
      //	tantque (val(sansespace(commandetrn.fdhauteuru)) > val(sansespace(dimcoul.dhauteuraconv))) et ...
      //	 pas h.endehors	
      	tantque (val(sansespace(hauteur)) > val(sansespace(dimcoul.dhauteuraconv))) et ...
      //Code WinDev 5.5 remplacé par la migration :
      //	 pas h.endehors	
      	 pas HEnDehors()	
             
             hlitsuivant("dimcoul","dclea")
          FIN
      FIN
      
      //Code WinDev 5.5 remplacé par la migration :
      //si  (sansespace(numproduit) = sansespace(dimcoul.dnumero)) et pas h.endehors alors
      si  (sansespace(numproduit) = sansespace(dimcoul.dnumero)) et pas HEnDehors() alors
      	
          valeuraretourner = {prixunitairet}
      	//commandetrn.cdcarreauv = carrdim.carrnbcarlarg
      	//commandetrn.cdcarreauh = carrdim.carrnbcarhaut
      	
      FIN
      
      sinon
       hlitrecherche("dimcoul","dclem",complete(numproduit,10)+largeur)
      //Code WinDev 5.5 remplacé par la migration :
      //si pas h.endehors et sansespace(numproduit) = sansespace(dimcoul.dnumero) alors
      si pas HEnDehors() et sansespace(numproduit) = sansespace(dimcoul.dnumero) alors
      //	tantque (val(sansespace(commandetrn.fdhauteuru)) > val(sansespace(dimcoul.dhauteurm))) et ...
      //	 pas h.endehors	
      	tantque (val(sansespace(hauteur)) > val(sansespace(dimcoul.dhauteurm))) et ...
      //Code WinDev 5.5 remplacé par la migration :
      //	 pas h.endehors	
      	 pas HEnDehors()	
             
             hlitsuivant("dimcoul","dclem")
          FIN
      FIN
      //Code WinDev 5.5 remplacé par la migration :
      //si  (sansespace(numproduit) = sansespace(dimcoul.dnumero)) et pas h.endehors alors
      si  (sansespace(numproduit) = sansespace(dimcoul.dnumero)) et pas HEnDehors() alors
      	
          valeuraretourner = {prixunitairet}
      	//commandetrn.cdcarreauv = carrdim.carrnbcarlarg
      	//commandetrn.cdcarreauh = carrdim.carrnbcarhaut
      	
      FIN
      
      fin
      
      
      renvoyer valeuraretourner
      
     type : 458752
   -
     name : validedate
     procedure_id : 5859041163477043009
     type_code : 14
     code : |1+
      Procédure validedate(provenance="verre")
      dateaverifier est une chaine
      
      SI invent.idateprixfutur <> "        " ALORS
       dateaverifier = entierversdate(dateversentier(invent.idateprixfutur) + client.cdelaidegrace)
      SINON
       dateaverifier = ""
      FIN	 
      //info(dateaverifier)
      
      selon provenance
      
      cas "verre"
         si invent.idateprixfutur <> "        " et dateaverifier <= commandetrn.fadate  alors
      			prixa = "invent.iprixfutur"
         			prixm = "invent.iprixfuturm"
      			prixdouble = "invent.iprixfuturdouble"
      			prixdoublem = "invent.iprixfuturdoublem"
      			prixtriple  = "invent.iprixfuturtriple"
      			prixtriplem  = "invent.iprixfuturtriplem"
      			
         sinon
              	prixa = "invent.iprixa"	
              	prixm = "invent.iprixm"	
      			prixdouble = "invent.iprixdouble"
      			prixdoublem = "invent.iprixdoublem"
      			prixtriple  = "invent.iprixtriple"
      			prixtriplem  = "invent.iprixtriplem"
         FIN
      
      cas "verreunite"
         si invent.idateprixfutur <> "        " et dateaverifier <= commandetrn.fadate  alors
            prixunitaire = "invent.iprixfuturunite"
            prixunitairem = "invent.iprixfuturunitem"
         sinon
      	  prixunitaire = "invent.iprixunitaire"
            prixunitairem = "invent.iprixunitem"
      	  
         fin	
      
      cas "unite"
         si invent.idateprixfutur <> "        " et dateaverifier <= commandetrn.fadate  alors
            prixunitaire = "invent.iprixfuturu"
            prixunitairet = "dimcoul.dprixfutur"
      sinon
      	  prixunitaire = "invent.iprixunite"
            prixunitairet = "dimcoul.dprix"
      	  
         fin	
      	
      cas "carrelage"
         si invent.idateprixfutur <> "        " et dateaverifier <= commandetrn.fadate  alors
            prixbasecarrelage = "invent.iprixfuturbasecarrelage"
            prixcarreau       = "invent.iprixfuturcarreau"
      sinon
            prixbasecarrelage = "invent.iprixbasecarrelage"
            prixcarreau       = "invent.iprixcarreau"
         
         fin		
      
      fin	
      
     type : 458752
   -
     name : verifiesurface
     procedure_id : 5859041162959439681
     type_code : 14
     code : |1+
      Procédure verifiesurface(surfaceaverifier,unitemesure)
      valeuraretourner EST UN BOOLEEN = VRAI
      decision est un entier 
      composantrempl1 est une chaine ="" 
      composantrempl2 est une chaine ="" 
      composantrempl3 est une chaine =""
      saveccap est un booleen = faux
      savecgaz est un booleen = faux
      dimension1 est un réel
      dimension2 est un réel
      cpt est un entier = 0 
      si unitemesure = 2 alors
      	surfaceaverifier = surfaceaverifier * tauxconversionam
      	dimension1=val(commandetrn.fdlargeura)/25.4
      	dimension2=val(commandetrn.fdhauteura)/25.4
      sinon
      	dimension1=val(commandeTRN.CDLARGEUR)
      	dimension2=val(commandetrn.CDHAUTEUR)
      FIN
      
      
      si dimension1 = 0 ou dimension2 = 0 alors renvoyer vrai
      
      POUR i = 1 A 3
      	SI SansEspace({"commandetrn.CDCOMPOSANT"+i}) <> "" ALORS
      		cpt++
      		HLitRecherche(invent,INUM,sansespace({"commandetrn.CDCOMPOSANT"+i}))
      		tantque Min(dimension1, dimension2) > Min(invent.ilargeurmax, invent.ihauteurmax) ou Max(dimension1, dimension2) > Max(invent.ihauteurmax, invent.ilargeurmax) ou (surfaceaverifier > invent.isurfmax ET invent.isurfmax <> 0.00)
      			valeuraretourner=faux
      			si pas HLitRecherche(invent,INUM, complete(invent.ipsuivant, 10), hidentique) alors 
      				sortir
      			FIN
      		FIN
      
      		si htrouve() ALORS
      			{"composantrempl"+i} = sansespace(invent.INUM)
      		FIN
      	FIN
      FIN
      
      hlitrecherche("persoens","ennumero",commandetrn.cdnumprod)
      si pas HEnDehors() et HTrouve() alors
      	saveccap = persoens.encap
      	savecgaz = persoens.engaz
      FIN
      
      si pas valeuraretourner et cpt > 1 alors
      	decision = ouvre(Choixproduittableau,commandetrn.cdnumprod,commandetrn.cdcomposant1,commandetrn.cdcomposant2,...
      	commandetrn.cdcomposant3,"",complete(composantrempl1,10),COMPLETE(composantrempl2,10),COMPLETE(composantrempl3,10),saveccap,savecgaz,"commandetrn")
      
      	selon decision
      	
      	cas 1
           commandetrn.composant1_nom  = ""
           commandetrn.composant2_nom  = ""
           commandetrn.composant3_nom  = ""
      	 clicbouton = vrai
      	 premierefois = vrai
           ExécuteTraitement(commandeTRN.cdnumprod,trtSortie)
           ExécuteTraitement(commandetrn.dfini,trtSortie)
      	cas 2
      		produitfixe = vrai
          cas 3
           commandetrn.cdnumprod = ""
      	 commandetrn.cdcomposant1 = ""
      	 commandetrn.cdcomposant2 = ""
      	 commandetrn.cdcomposant3 = ""
           commandetrn.composant1_nom  = ""
           commandetrn.composant2_nom  = ""
           commandetrn.composant3_nom  = ""
      	 
          reprisesaisie("commandetrn.cdnumprod")
          fin
      				
      FIN
      renvoyer valeuraretourner
      
     type : 458752
   -
     name : sauver_répétitif
     procedure_id : 5859041163871438657
     type_code : 14
     code : |1+
      Procédure sauver_répétitif()
      lCondition est un booleen = faux
      i est un entier
      
      pour i = 1 a dimension(ChampRépétitif)/7
      
      	si champrépétitif[i,2]  alors   
      		si sansespace(ChampRépétitif[i,4]) = ""  alors
      			lCondition = vrai
      		sinon
      			si {champrepetitif[i,4]} alors 
      				lCondition = vrai
      			sinon
      				lCondition = faux	 
      			FIN
      		fin
      		si lCondition
      			si champrépétitif[i,5] alors  
      				si champrépétitif[i,6] = "" alors
      					champrépétitif[i,6] = {champrépétitif[i,1]}
      					champrépétitif[i,3] = {champrépétitif[i,1]}
      				sinon
      					champrépétitif[i,3] = champrépétitif[i,6]
      					
      				FIN
      
      
      			sinon	
      				champrépétitif[i,3] = {champrépétitif[i,1]}
      
      			fin
      		fin
      	FIN
      
      
      FIN
      
     type : 458752
   -
     name : recuperer_répétitif
     procedure_id : 5859041163338041153
     type_code : 14
     code : |1+
      Procédure recuperer_répétitif()
      
      i est un entier
      
      pour i = 1 a dimension(ChampRépétitif)/7
      	si champrépétitif[i,2] et champrépétitif[i,4] = "" alors
      	 {champrépétitif[i,1]}=	champrépétitif[i,3] 
      	{champrépétitif[i,1]}..modifie = faux
      	FIN
      FIN
      
     type : 458752
   -
     name : calcul_carrelage
     procedure_id : 5859041162858841921
     type_code : 14
     code : |1+
      Procédure calcul_carrelage(numdecarr,typedecalcul,matchouinon=faux,numerodeligne=0)
      externe formule1
      i est un entier
      
      hlitrecherche(invent,INUM,numdecarr)
      
      si htrouve(invent) alors
      	si pas invent.itype = 4 alors 
      		acso_message("Erreur","Ce n'est pas du carrelage","Erreur")
      	sinon
      
      				hlitrecherche(typecarr,tcdescription,typedecalcul)
      		//		hlitrecherche(typecarr,TCCLEUNIK,typedecalcul)
      
      		c = typecarr.EpaisseurCadre
      		etl = typecarr.EpaisseurTigeLargeur
      		eth = typecarr.EpaisseurTigeHauteur
      //		vx = typecarr.VariableUtil
      		vx = trdetail.fdvariablex
      		vx1 = trdetail.fdvariablex1
      
      		nbl = trdetail.fdcarreauv
      		nbh = trdetail.fdcarreauh
      
      		si commandetrn.facalcul = 1 alors
      			
      			l1 = val(convert_anglais1(sansespace(trdetail.fdlargeur))) * 25.4
      		sinon
      			l1 = trdetail.fdlargeura
      		fin    
      		si commandetrn.facalcul = 1 alors
      			h1 = val(convert_anglais1(sansespace(trdetail.fdhauteur))) * 25.4
      		sinon
      			h1 = trdetail.fdhauteura
      		fin 
      
      		selon trdetail.fdmatchvh
      			cas 3
      
      
      				DDM = h1 - dimensionmatchhauteur 
      				commandetrn.fdDDh = h1 - dimensionmatchhauteur 
      
      				pour i = 1 a 10
      					formule = "y est un reel"+rc+"y="+typecarr.nbdimensionmhorizontal[i]+rc+"renvoyer(y)"
      					res = compile("formule1",formule)
      					si res = "" alors
      						trdetail.fddimension[i] =trdetail.fdqte * formule1()
      					sinon
      						trdetail.fddimension[i] = 0
      					FIN
      					formule = "y est un reel"+rc+"y="+typecarr.nbmorceaumhorizontal[i]+rc+"renvoyer(y)"
      					res = compile("formule1",formule)
      					si res = "" alors
      						trdetail.FDnbmorceau[i] = trdetail.fdqte *formule1()
      					sinon
      						trdetail.FDnbmorceau[i] = 0
      					fin
      				        trdetail.FDdescriptionmorceau[i] = typecarr.tdescription[i]
      				fin
      			cas 2
      
      
      
      				DDM = L1 - dimensionmatchlargeur
      				commandetrn.fdDDV = l1 - dimensionmatchlargeur
      
      
      
      				pour i = 1 a 10
      					formule = "y est un reel"+rc+"y="+typecarr.nbdimensionmvertical[i]+rc+"renvoyer(y)"
      
      					res = compile("formule1",formule)
      					si res = "" alors
      						trdetail.fddimension[i] = trdetail.fdqte *formule1()
      					sinon
      						trdetail.fddimension[i] = 0
      					FIN
      					formule = "y est un reel"+rc+"y="+typecarr.nbmorceaumvertical[i]+rc+"renvoyer(y)"
      					res = compile("formule1",formule)
      					si res = "" alors
      						trdetail.FDnbmorceau[i] = trdetail.fdqte *formule1()
      					sinon
      						trdetail.FDnbmorceau[i] = 0
      					fin
      					trdetail.FDdescriptionmorceau[i] = typecarr.tdescription[i]
      				fin
      
      			cas 1
      				pour i = 1 a 10
      
      					formule = "y est un reel"+rc+"y="+typecarr.nbdimension[i]+rc+"renvoyer(y)"
                          
      					res = compile("formule1",formule)
      
      					si res = "" alors
      						trdetail.fddimension[i] = formule1()
      					sinon
      						trdetail.fddimension[i] = 0
      					FIN
      					formule = "y est un reel"+rc+"y="+typecarr.nbmorceau[i]+rc+"renvoyer(y)"
      					res = compile("formule1",formule)
      					si res = "" alors
      						trdetail.FDnbmorceau[i] = trdetail.fdqte * formule1()
      					sinon
      						trdetail.FDnbmorceau[i] = 0
      					fin
      					trdetail.FDdescriptionmorceau[i] = typecarr.tdescription[i]
      				fin
      
      		fin
      
      
      fin
      fin
      
      
      
      
      
      
     type : 458752
   -
     name : calcul_anglais
     procedure_id : 5859041162316793665
     type_code : 14
     code : |1-
      Procédure calcul_anglais(dimensionacalculer)
      j est un entier = memoccurrence("tableau_anglais")
      k est un entier = 1
      lapartiedecimaletexte est une chaine = ""
      lapartieentiere est une chaine = sansespace(numeriqueverschaine(partieentiere(val(dimensionacalculer)/25.4)))
      lapartiedecimale est un entier = arrondi(partiedecimale(val(dimensionacalculer)/25.4),3)*1000
      //lapartiedecimale -= config.ToleranceMilli  // tolérance millimetre pour calcul des fractions
      lapartiedecimale -= client.Tolerancei  // tolérance millimetre pour calcul des fractions
      
      si lapartiedecimale > 0 alors
      	mempremier("tableau_anglais")
      
      	tantque memvalcle("tableau_anglais") < lapartiedecimale 
      		si memencours("tableau_anglais") = j alors
      			sortir
      		sinon	
      			memsuivant("tableau_anglais")
      		FIN
      	FIN
      	lapartiedecimaletexte = memrecupere("tableau_anglais",memencours("tableau_anglais"))
      sinon
      	lapartiedecimaletexte = ""
      fin
      
      renvoyer lapartieentiere + " "+lapartiedecimaletexte
     type : 458752
   -
     name : calcul_surface_reelle
     procedure_id : 5859041163396564801
     type_code : 14
     code : |1+
      Procédure calcul_surface_reelle(lunitedemesure,surfaceanglaise,surfacemetrique)
      surface_entier_largeur est un reel
      surface_fraction_largeur est un reel
      surface_entier_hauteur est un reel
      surface_fraction_hauteur est un reel
      largeur_calcul est un reel
      hauteur_calcul est un reel
      
      selon lunitedemesure
      
      cas 1 
      
      surface_entier_largeur = partieentiere(val(commandetrn.cdlargeur))
      surface_fraction_largeur = partiedecimale(val(commandetrn.cdlargeur))
      surface_entier_hauteur = partieentiere(val(commandetrn.cdhauteur))
      surface_fraction_hauteur = partiedecimale(val(commandetrn.cdhauteur))
      
      largeur_calcul = val(commandetrn.cdlargeur)
      
      hauteur_calcul = val(commandetrn.cdhauteur) 
      
      surfaceanglaise = arrondi(hauteur_calcul * largeur_calcul / 144,2)
      surfacemetrique = arrondi(calcul_surface_metrique(val(commandetrn.cdlargeur)*25.4/1000,val(commandetrn.cdhauteur)*25.4/1000,vrai),4)
      
      renvoyer arrondi(hauteur_calcul * largeur_calcul / 144,2)
      
      
      cas 2
      
      //largeur_calcul = val(commandetrn.cdlargeur) * 1000
      largeur_calcul = val(commandetrn.cdlargeur) * 1000
      
      largeur_calcul = largeur_calcul / 1000
      
      hauteur_calcul = val(commandetrn.cdhauteur) * 1000
      
      hauteur_calcul = hauteur_calcul / 1000
      
      //surfaceanglaise = 0
      surfaceanglaise = arrondi(calcul_surface_anglais(val(commandetrn.CDLARGEUR) * 1000/ 25.4,val(commandetrn.CDhauteur)*1000/ 25.4,vrai),2)
      
      
      surfacemetrique = arrondi(hauteur_calcul * largeur_calcul,4)
      
      renvoyer arrondi(hauteur_calcul * largeur_calcul,4)
      
      
      fin	
      
     type : 458752
   -
     name : calcul_surface_anglais
     procedure_id : 5859041162999285569
     type_code : 14
     code : |1+
      Procédure calcul_surface_anglais(largeur,hauteur,reelle=faux)
      surface_entier_largeur est un reel
      surface_fraction_largeur est un reel
      surface_entier_hauteur est un reel
      surface_fraction_hauteur est un reel
      largeur_calcul est un reel
      hauteur_calcul est un reel
      
      si pas reelle alors
      	surface_entier_largeur = partieentiere(val(largeur))
      	//surface_fraction_largeur = partiedecimale(val(largeur))
      	//	surface_fraction_largeur = partiedecimale(val(largeur))-(config.Tolerancemilli/1000)
      		surface_fraction_largeur = partiedecimale(val(largeur))-(client.Tolerancei/1000)
      	surface_entier_hauteur = partieentiere(val(hauteur))
      	//surface_fraction_hauteur = partiedecimale(val(hauteur))
      	//	surface_fraction_hauteur = partiedecimale(val(hauteur))-(config.Tolerancemilli/1000)
      		surface_fraction_hauteur = partiedecimale(val(hauteur))-(client.Tolerancei/1000)
      
      	si surface_fraction_hauteur < 0 alors
      		surface_fraction_hauteur = 0
      	FIN
      	si surface_fraction_largeur < 0 alors
      		surface_fraction_largeur = 0
      	FIN
      
      	si modulo(surface_entier_largeur,2) = 0 alors
      		si pas surface_fraction_largeur = 0  alors
      			largeur_calcul = surface_entier_largeur + 2
      		sinon
      			largeur_calcul = surface_entier_largeur 
      		fin	
      	sinon
      		largeur_calcul = surface_entier_largeur + 1
      	fin	
      
      	si modulo(surface_entier_hauteur,2) = 0 alors
      		si pas surface_fraction_hauteur = 0  alors
      			hauteur_calcul = surface_entier_hauteur + 2
      		sinon
      			hauteur_calcul = surface_entier_hauteur 
      		fin	
      	sinon
      		hauteur_calcul = surface_entier_hauteur + 1
      	fin	
      sinon
      	hauteur_calcul = hauteur
      	largeur_calcul = largeur
      fin
      
      
      renvoyer hauteur_calcul * largeur_calcul / 144
      
      
      
     type : 458752
   -
     name : calcul_surface_metrique
     procedure_id : 5859041163868096321
     type_code : 14
     code : |1+
      Procédure calcul_surface_metrique(largeur,hauteur,reelle=faux)
      surface_entier_largeur est un reel
      surface_fraction_largeur est un reel
      surface_entier_hauteur est un reel
      surface_fraction_hauteur est un reel
      largeur_calcul est un reel
      hauteur_calcul est un reel
      
      
      
      //largeur_calcul = val(commandetrn.cdlargeur) * 1000
      si pas reelle alors
      	largeur_calcul = arrondi(largeur * 1000)
      	hauteur_calcul = arrondi(hauteur * 1000)
      	
      	si pas modulo(largeur_calcul,20) = 0 alors
      
      		largeur_calcul = arrondi(largeur_calcul + (20 - modulo(largeur_calcul,20)),0)
      	
      	fin
      
      	largeur_calcul = largeur_calcul / 1000
      
      	si pas modulo(hauteur_calcul,20) = 0 alors
      
      		hauteur_calcul = arrondi(hauteur_calcul + (20 - modulo(hauteur_calcul,20)),0)
      	
      
      	fin
      	hauteur_calcul = hauteur_calcul / 1000
      
      sinon
      	largeur_calcul = largeur
      	hauteur_calcul = hauteur 
      
      fin
      
      
      renvoyer hauteur_calcul * largeur_calcul
      
      
      
     type : 458752
   -
     name : convert_anglais1
     procedure_id : 5859041162317711169
     type_code : 14
     code : |1+
      Procédure convert_anglais1(variable)
      //variable est une chaine = moimeme
      //hlitpremier("config","COCLEUNIK")
      longueur est un entier = taille(variable)
      position_espace est un entier = position(variable," ")
      //position_espace1 est un entier = position(variable," ",position_espace+1)
      resultat_gauche est une chaine  
      resultat_droit est une chaine        
      valeuraretourner est un reel
      si position_espace = 0 alors
      	si position(variable,"/") = 0 alors
      		resultat_gauche = ""
      	sinon
      		resultat_gauche = "0"
      	fin	
      sinon	
      
      	resultat_gauche = gauche(variable,position_espace-1)
      
      FIN
      
      si position_espace = 0 alors
      
      	resultat_droit = variable
      
      sinon	
      
      	resultat_droit = milieu(variable,position_espace +1, longueur - position_espace)
      
      FIN
      
      
      si pas position(resultat_droit,"/") = 0 alors
      	resultat_droit = memrecherche("tableau_metrique",resultat_droit)
      FIN
      
      
      
      
      
      	valeuraretourner = resultat_gauche+resultat_droit
      
      
      
      
      
      
      renvoyer valeuraretourner
      
     type : 458752
   -
     name : convert_metrique1
     procedure_id : 5859041162466084673
     type_code : 14
     code : |1+
      Procédure convert_metrique1(videpermis = faux)
      //hlitpremier("config","COCLEUNIK")
      valeurderetour est un booleen = vrai
      variable est une chaine = moimeme
      longueur est un entier = taille(variable)
      partie_decimale est une chaine
      partie_entier est une chaine
      si longueur <> 0 alors
      si position(variable,".") = 0 alors
       si longueur <= 3 alors
      	variable = "."+repete("0",3-longueur)+variable
       sinon
      	partie_decimale = droite(variable,3)
      	partie_entier   = gauche(variable,longueur-3)
      	variable = partie_entier+"."+partie_decimale
       FIN
      fin
      
      moimeme = variable
      sinon
        si videpermis alors
           valeurderetour = vrai
        sinon	 
           valeurderetour = faux
        fin
      fin 	
      //SI Val(MoiMême) < config.dimensionmaximetrique ET PAS MoiMême = "" ALORS
      	SI Val(MoiMême) < gclconfig.m_rdimensionmaximetrique ET PAS MoiMême = "" ALORS
      		erreur("Donnée incorrecte")
      	valeurderetour = faux
      FIN
      
      renvoyer valeurderetour
      
     type : 458752
   -
     name : remplir_combo_type
     procedure_id : 5859041163427825473
     type_code : 14
     code : |1+
      Procédure remplir_combo_type(nocarrelage,demithermos est un booleen = vrai)
      norecord est un entier = hsauveposition(invent)
      tabLeautcarr est un tableau dynamique de 0 chaine
      
      hlitrecherche(invent,INUM,nocarrelage)
      //ListeSupprimeTout(typecalcul)
      //hlitpremier(typecarr,tcdescription)
      //tantque pas hendehors(typecarr)
      
      //	si typecarr.tYpecarrelage = invent.tYpecalculDefaut alors
      //		listeajoute(typecalcul,typecarr.tcdescription)
      //	FIN
      //hlitsuivant(typecarr,tcdescription)
      //FIN
      //hfiltre(typecarr,tYpecarrelage,invent.tYpecalculDefaut)
      ListeSupprimeTout(typecalcul)
      hlitpremier(typecarr,tcdescription)
      tantque pas hendehors(typecarr)
      
      	SI typecarr.tYpecarrelage = invent.tYpecalculDefaut _ET_ demithermos = typecarr.TDemiCarrelage  ALORS
      //		SI typecarr.tYpecarrelage = invent.tYpecalculDefaut _ET_ commandeTRN.fddemicarrelage = typecarr.TDemiCarrelage  ALORS
      			listeajoute(typecalcul,gLien(typecarr.tcdescription)+typecarr.tcdescription)
      	fin
      
      	hlitsuivant(typecarr)
      FIN
      
      si pas demithermos alors typecalcul = invent.itypecarr sinon typecalcul = invent.iTypecarrDemi
      //SI PAS demithermos _ET_ typecalcul..Occurrence > 0 ALORS
      	SI  typecalcul..Occurrence > 0 ALORS
      		SI typecalcul = -1 ALORS ListeSelectPlus(typecalcul,1)
      FIN
      //typecalcul = tablecherche(carrdesc,sansespace(invent.itypecarr))
      HRetourPosition(norecord)
      renvoyer typecalcul
      //renvoyer typecarr.tcdescription
     type : 458752
   -
     name : calcul_prixu
     procedure_id : 5859041163635640129
     type_code : 14
     code : |1+
      Procédure calcul_prixu(lunitedemesure,pescompteqte=faux,ppourcescompteqte = 0,lSurfaceSeulement=faux)
      
      resultatCalcul est une chaîne
      ReqSQL est une source de donnees
      TxtSql est un chaine = [
      	SELECT epbase FROM persoens where encomposant1 = '%1' et encomposant2 = '%2' et encomposant3 = '%3' et enactif = 1 et enfabrication = 0 et epbase <> ''
      ]
      
      SI lunitedemesure = 0 ALORS
      	lunitedemesure = 1
      FIN
      
      rCarr_esc est un réel
      
      IndiceNbVerre = 0
      commandeTRN.FDextra10X..Visible=Faux
      commandeTRN.FDextra5x..Visible=Faux
      
      sEXTRARECHERCHE est une chaîne
      sEXTRATRECHERCHE est une chaîne
      resultat est un réel
      tabPextrat est un tableau de 3 réel 
      pextra est un tableau de 3 réel
      tabEscompte est un tableau de 3 réel
      tabEscomptet est un tableau de 3 réel
      net est un tableau de 3 réel
      netpbase est un réel
      escpbase est un réel
      prixdebase est un réel
      extracapgazinex est un réel = 0
      extracap est un réel = 0
      lsurfaceafacturer est un réel = 0
      
      lexception5 = Faux
      lexception10 = Faux
      lepaisseurverre est un entier = 0
      rEscompteverreunite est un réel
      clederecherche est une chaîne
      lasurface est un réel = calcul_surface(lunitedemesure,lasurfaceanglais,lasurfacemetrique)   // 
      lasurfacereelle est un réel = calcul_surface_reelle(lunitedemesure,lasurfaceanglaisreelle,lasurfacemetriquereelle)
      
      
      
      ladimension est un réel = max((invent.iunitemesure = 4 ? lasurface sinon calcul_dimension(lunitedemesure,lasurfaceanglais,lasurfacemetrique,invent.iUniteMesure) ),...
      lunitedemesure = 1 ? arrondi(invent.iDimensionMinimum/12,2) sinon arrondi(invent.iDimensionMinimum *25.4 / 1000,4))
      
      SI commandeTRN.FDIntercalaire ALORS
      	ladimension  = max(calcul_dimension(lunitedemesure,lasurfaceanglais,lasurfacemetrique,2),arrondi(invent.iDimensionMinimum/12,2))
      	CalculPrixUintercalaire(ladimension)
      	RENVOYER 0
      //sinon
      //ladimension = 99999  // pour éviter de déclencher l,alerte numéro 18 sur la dimension du contour quand ce n'est pas un produit contour
      
      FIN
      
      // si pas calcul de la surcharge lpascalcul5X10X = vrai
      SI PAS lPasCalcul5X10X ALORS
      	SI Val(commandeTRN.CDHAUTEUR) <> 0 ET Val(commandeTRN.CDLARGEUR) <> 0 ALORS
      		SI Val(commandeTRN.CDLARGEUR) > Val(commandeTRN.CDHAUTEUR) ALORS
      			SI PartieEntière(Val(commandeTRN.CDLARGEUR)/Val(commandeTRN.CDHAUTEUR)) >= 10 ALORS
      				lexception10 = Vrai
      				commandeTRN.FDextra10X..Visible= Vrai
      			SINON SI PartieEntière(Val(commandeTRN.CDLARGEUR)/Val(commandeTRN.CDHAUTEUR)) >= 5 ALORS
      				lexception5= Vrai
      				commandeTRN.FDextra5x..Visible= Vrai
      			FIN
      		SINON
      			SI PartieEntière(Val(commandeTRN.CDHAUTEUR)/Val(commandeTRN.CDLARGEUR)) >= 10 ALORS
      				lexception10 = Vrai
      				commandeTRN.FDextra10X..Visible= Vrai
      			SINON SI PartieEntière(Val(commandeTRN.CDHAUTEUR)/Val(commandeTRN.CDLARGEUR)) >= 5 ALORS
      				lexception5= Vrai
      				commandeTRN.FDextra5x..Visible= Vrai
      			FIN
      			
      		FIN
      	FIN
      FIN
      SI typedeproduit = "Verre" ALORS
      	SI PAS ProduitFixe ALORS
      		
      		
      		//		verifiesurface((lasurface),lunitedemesure)
      		verifiesurface((lasurfacereelle),lunitedemesure)
      	FIN
      FIN
      
      
      epaisseur = 0
      
      SELON typedeproduit
      	CAS "Verre"
      		isTrempe est un booléen=Faux
      		
      		SI PAS calculprixcoutant ALORS
      			SI PAS commandeTRN.CDCOMPOSANT1 = "" ALORS
      				SI HLitRecherche("invent","INUM",commandeTRN.CDCOMPOSANT1) ALORS
      					lepaisseurverre=Val(Droite(commandeTRN.CDCOMPOSANT1,1))
      					epaisseur+=invent.iepaisseur
      				FIN
      				
      				SI invent.icategorie="VTR" ALORS isTrempe=Vrai
      				
      				IndiceNbVerre = IndiceNbVerre  + 1
      			FIN
      			SI PAS commandeTRN.CDCOMPOSANT2 = "" ALORS
      				IndiceNbVerre = IndiceNbVerre  + 1
      				SI HLitRecherche("invent","INUM",commandeTRN.CDCOMPOSANT2) ALORS
      					SI Val(Droite(commandeTRN.CDCOMPOSANT2,1)) > lepaisseurverre ALORS
      						lepaisseurverre=Val(Droite(commandeTRN.CDCOMPOSANT2,1))
      					FIN
      					
      					SI invent.icategorie="VTR" ALORS isTrempe=Vrai
      					
      					epaisseur+=invent.iepaisseur
      				FIN  
      			FIN
      			SI PAS commandeTRN.CDCOMPOSANT3 = "" ALORS
      				SI HLitRecherche("invent","INUM",commandeTRN.CDCOMPOSANT3) ALORS
      					epaisseur+=invent.iepaisseur
      					SI Val(Droite(commandeTRN.CDCOMPOSANT3,1)) > lepaisseurverre ALORS
      						lepaisseurverre=Val(Droite(commandeTRN.CDCOMPOSANT3,1))
      					FIN
      					
      					SI invent.icategorie="VTR" ALORS isTrempe=Vrai
      				FIN  
      				IndiceNbVerre = IndiceNbVerre + 1
      			FIN
      			
      			clederecherche = HConstruitValClé(ThermosClient,IdClientIdhermos,...
      			Complète(commandeTRN.FCLIENT,10),Complète(commandeTRN.cdnumprod,20))
      			resultatCalcul = CalculPrixThermos(commandeTRN.cdnumprod,client.IDClient,commandeTRN.CDCOMPOSANT1,commandeTRN.CDCOMPOSANT2,commandeTRN.CDCOMPOSANT3,commandeTRN.pdebase)
      			SI commandeTRN.facalcul = 1 ALORS 
      				net[1] = Val(ExtraitChaîne(resultatCalcul,1,","))
      			SINON
      				net[1] = Val(ExtraitChaîne(resultatCalcul,2,","))
      			FIN
      			
      			SI PAS IndiceNbVerre = 0 ALORS
      				HLitRecherche("invent","INUM",pdebase)
      				SI PAS HEnDehors() ALORS
      					SI HTrouve() ALORS
      						validedate()
      						escpbase = trouve_escompte(commandeTRN.FCLIENT+invent.INUM,...
      						commandeTRN.FCLIENT+Répète(" ",10)+invent.icategorie,IndiceNbVerre,"base")
      						SELON IndiceNbVerre
      							CAS 1
      								nbverre = "simple"
      								SI lunitedemesure = 1 ALORS
      									prixdebase = {prixa} 
      								SINON
      									prixdebase = {prixm} 
      								FIN	
      							CAS 2   
      								nbverre = "double"
      								SI lunitedemesure = 1 ALORS
      									prixdebase = {prixdouble}
      								SINON
      									prixdebase = {prixdoublem}
      								FIN	
      								
      								// Options
      								SI  type_intercallaire = "Inex" ALORS
      									//									extracapgazinex += config.intercallaireinexd * (100 - Client.cescompteinex) / 100
      									extracapgazinex += gclconfig.m_rIntercallaireinexd * (100 - Client.cescompteinex) / 100
      								FIN
      								SI aveccap ALORS
      									//									extracap += config.capd * (100 -Client.cescomptecap) / 100
      									//									extracapgazinex += config.capd * (100 -Client.cescomptecap) / 100
      									extracap += GCLconfig.m_rcapd * (100 -Client.cescomptecap) / 100
      									extracapgazinex += gclconfig.m_rcapd * (100 -Client.cescomptecap) / 100
      								FIN
      								SI gazgeon ALORS
      									SELON Droite(SansEspace(pdebase),1)
      										CAS "3"					
      											//											extracapgazinex += config.gazargond * (100 - Client.cgazargon3) / 100
      											extracapgazinex += gclconfig.m_rgazargond * (100 - Client.cgazargon3) / 100
      										CAS "4"					
      											//											extracapgazinex += config.gazargond * (100 - Client.cgazargon4) / 100
      											extracapgazinex += gclConfig.m_rGazargond * (100 - Client.cgazargon4) / 100
      										CAS "5"					
      											//											extracapgazinex += config.gazargond * (100 - client.cgazargon5) / 100
      											extracapgazinex += gclConfig.m_rGazargond * (100 - Client.cgazargon5) / 100
      										CAS "6"					
      											//											extracapgazinex += config.gazargond * (100 - client.cgazargon6) / 100
      											extracapgazinex += gclConfig.m_rGazargond * (100 - Client.cgazargon6) / 100
      										AUTRES CAS
      											//										extracapgazinex += config.gazargond 
      											extracapgazinex +=gclConfig.m_rGazargond
      											
      									FIN
      								FIN
      								SI capillaire ALORS
      									//									extracapgazinex += config.capillaired * (100 - Client.cescomptecapillaire) / 100
      									extracapgazinex += gclconfig.m_rcapillaired * (100 - Client.cescomptecapillaire) / 100
      								FIN
      								
      							CAS 3
      								nbverre = "triple"
      								SI lunitedemesure = 1 ALORS
      									prixdebase = {prixtriple}
      								SINON
      									
      									prixdebase = {prixtriplem}
      								FIN	
      								
      								// Options
      								SI  type_intercallaire = "Inex" ALORS
      									//									extracapgazinex += config.intercallaireinext * (100 - Client.cescompteinex) / 100
      									extracapgazinex += gclconfig.m_rintercallaireinext * (100 - Client.cescompteinex) / 100
      								FIN
      								SI aveccap ALORS
      									//									extracapgazinex += config.capt * (100 - Client.cescomptecap) / 100
      									extracapgazinex += gclconfig.m_rcapt * (100 - Client.cescomptecap) / 100
      								FIN
      								SI gazgeon ALORS
      									SELON Droite(SansEspace(pdebase),1)
      										CAS "3"					
      											//											extracapgazinex += config.gazargont * (100 - Client.cgazargon3) / 100
      											extracapgazinex += gclconfig.m_rgazargont * (100 - Client.cgazargon3) / 100
      										CAS "4"					
      											//											extracapgazinex += config.gazargont * (100 - Client.cgazargon4) / 100
      											extracapgazinex += gclConfig.m_rGazargont * (100 - Client.cgazargon4) / 100
      										CAS "5"					
      											//											extracapgazinex += config.gazargont * (100 - Client.cgazargon5) / 100
      											extracapgazinex += gclConfig.m_rGazargont * (100 - Client.cgazargon5) / 100
      										CAS "6"					
      											//											extracapgazinex += config.gazargont * (100 - Client.cgazargon6) / 100
      											extracapgazinex += gclConfig.m_rGazargont * (100 - Client.cgazargon6) / 100
      										AUTRES CAS
      											//											extracapgazinex += config.gazargont
      											extracapgazinex += gclConfig.m_rGazargont
      									FIN
      								FIN
      								SI capillaire ALORS
      									//									extracapgazinex += config.capillairet * (100 - Client.cescomptecapillaire) / 100
      									extracapgazinex += gclconfig.m_rcapillairet * (100 - Client.cescomptecapillaire) / 100
      								FIN 
      						FIN
      					FIN
      				FIN
      				
      				netpbase = prixdebase * (100 - escpbase) /100
      				
      				SI surfaceminimumdifferentea = 0 ET surfaceminimumdifferentem = 0 ALORS
      					SI lunitedemesure = 1 ALORS
      						surface_minimum = invent.IMINA	
      						surface_minimuminverse = invent.IMINM
      					SINON
      						surface_minimuminverse = invent.IMINA
      						surface_minimum = invent.IMINM	
      					FIN
      				SINON
      					SI lunitedemesure = 1 ALORS
      						surface_minimum = surfaceminimumdifferentea	
      						surface_minimuminverse = surfaceminimumdifferentem
      					SINON
      						surface_minimuminverse = surfaceminimumdifferentea
      						surface_minimum = surfaceminimumdifferentem
      					FIN
      				FIN
      			FIN
      		SINON
      			SI SansEspace(calculprixcoutantpr1) = ""
      				SI PAS commandeTRN.CDCOMPOSANT1 = "" ALORS
      					HLitRecherche("invent","INUM",commandeTRN.CDCOMPOSANT1)
      					SI PAS HEnDehors() ALORS
      						SI HTrouve()  ALORS
      							SI lunitedemesure = 1 ALORS
      								net[1] = invent.icoutanta
      							SINON	
      								net[1] = invent.icoutantm
      							FIN
      						FIN
      					FIN
      				FIN
      			SINON
      				HLitRecherche("invent","INUM",calculprixcoutantpr1)
      				SI PAS HEnDehors() ALORS
      					SI HTrouve()  ALORS
      						SI lunitedemesure = 1 ALORS
      							net[1] = invent.icoutanta
      						SINON	
      							net[1] = invent.icoutantm
      						FIN
      					FIN
      				FIN
      			FIN	
      			
      			SI SansEspace(calculprixcoutantpr2) = ""
      				SI PAS commandeTRN.CDCOMPOSANT2 = "" ALORS
      					HLitRecherche("invent","INUM",commandeTRN.CDCOMPOSANT2)
      					SI PAS HEnDehors() ALORS
      						SI HTrouve()  ALORS
      							SI lunitedemesure = 1 ALORS
      								net[2] = invent.icoutanta
      							SINON	
      								net[2] = invent.icoutantm
      							FIN
      						FIN
      					FIN
      				FIN
      			SINON
      				HLitRecherche("invent","INUM",calculprixcoutantpr2)
      				SI PAS HEnDehors() ALORS
      					SI HTrouve()  ALORS
      						SI lunitedemesure = 1 ALORS
      							net[2] = invent.icoutanta
      						SINON	
      							net[2] = invent.icoutantm
      						FIN
      					FIN
      				FIN
      			FIN	
      			
      			SI SansEspace(calculprixcoutantpr3) = ""
      				SI PAS commandeTRN.CDCOMPOSANT3 = "" ALORS
      					HLitRecherche("invent","INUM",commandeTRN.CDCOMPOSANT3)
      					SI PAS HEnDehors() ALORS
      						SI HTrouve()  ALORS
      							SI lunitedemesure = 1 ALORS
      								net[3] = invent.icoutanta
      							SINON	
      								net[3] = invent.icoutantm
      							FIN
      						FIN
      					FIN
      				FIN
      			SINON
      				HLitRecherche("invent","INUM",calculprixcoutantpr3)
      				SI PAS HEnDehors() ALORS
      					SI HTrouve()  ALORS
      						SI lunitedemesure = 1 ALORS
      							net[3] = invent.icoutanta
      						SINON	
      							net[3] = invent.icoutantm
      						FIN
      					FIN
      				FIN
      			FIN	
      			
      			HLitRecherche("invent","INUM",pdebase)
      			SI PAS HEnDehors() ALORS
      				SI HTrouve() ALORS
      					SI surfaceminimumdifferentea = 0 ET surfaceminimumdifferentem = 0 ALORS
      						SI lunitedemesure = 1 ALORS
      							surface_minimum = invent.IMINA	
      						SINON
      							surface_minimum = invent.IMINM	
      						FIN
      					SINON
      						SI lunitedemesure = 1 ALORS
      							surface_minimum = surfaceminimumdifferentea
      						SINON
      							surface_minimum = surfaceminimumdifferentem
      						FIN
      					FIN
      				FIN
      			FIN
      		FIN	
      		
      		///PATCH BPS (vrai patch)/////////////////////
      		HLitRecherche("invent","INUM",commandeTRN.cdnumprod)
      		SI invent.itype=2 ALORS //verre à l'unité (typedeproduit n'est pas fiable...)
      			si sansespace(commandeTRN.cdnumprod) = "" alors
      				TxtSql = ChaîneConstruit(TxtSql,sansespace(commandetrn.CDCOMPOSANT1),SansEspace(commandeTRN.CDCOMPOSANT3),SansEspace(commandeTRN.CDCOMPOSANT3))
      				si HExécuteRequêteSQL(ReqSQL,hRequêteDéfaut,TxtSql) alors
      					si hnbenr(ReqSQL) > 0 alors
      						hlitpremier(ReqSQL)
      						lepaisseurverre = droite(sansespace(ReqSQL.epbase),1)
      						
      					FIN
      				FIN
      				
      			sinon
      				lepaisseurverre=Val(Droite(SansEspace(commandeTRN.cdnumprod),1)) 
      				
      			FIN
      			//si lepaisseurverre < 3 ou lepaisseurverre > 6 alors lepaisseurverre = 0
      			SI invent.icategorie="VTR" ALORS isTrempe=Vrai
      		FIN
      		si lepaisseurverre < 3 ou lepaisseurverre > 6 alors lepaisseurverre = 0
      		
      		resultat = net[1]+fraismontage
      		/////////////////////////////////
      		
      		SI isTrempe ET (client.cminimumatrempe <> 0 OU client.cminimummtrempe) ALORS //Si le thermos est trempé, on essaie de prendre la surface minimum pour le trempé
      			SI lunitedemesure=1 ALORS surface_minimum=client.cminimumatrempe SINON surface_minimum=client.cminimummtrempe
      			SI lunitedemesure=1 ALORS surface_minimuminverse=client.cminimummtrempe SINON surface_minimuminverse=client.cminimumatrempe
      		SINON SI lepaisseurverre<>0 ALORS
      			SI {"client.cminimuma"+SansEspace(NumériqueVersChaine(lepaisseurverre))} <> 0 OU {"client.cminimumm"+SansEspace(NumériqueVersChaine(lepaisseurverre))} <> 0 ALORS //sinon on essais de prendre la surface minimum pour l'épaisseur du thermos
      				SI lunitedemesure=1 ALORS surface_minimum={"client.cminimuma"+SansEspace(NumériqueVersChaine(lepaisseurverre))} SINON surface_minimum={"client.cminimumm"+SansEspace(NumériqueVersChaine(lepaisseurverre))}
      				SI lunitedemesure=1 ALORS surface_minimuminverse={"client.cminimumm"+SansEspace(NumériqueVersChaine(lepaisseurverre))} SINON surface_minimuminverse={"client.cminimuma"+SansEspace(NumériqueVersChaine(lepaisseurverre))}
      			SINON
      				SI lunitedemesure=1 ALORS surface_minimum=client.cminimuma SINON surface_minimum=client.cminimumm
      				SI lunitedemesure=1 ALORS surface_minimuminverse=client.cminimumm SINON surface_minimuminverse=client.cminimuma
      			FIN
      		SINON //Si il n'y a pas de surface minimum définie pour l'épaisseur du thermos, on prend celle par défaut définie dans "tout"
      			SI lunitedemesure=1 ALORS surface_minimum=client.cminimuma SINON surface_minimum=client.cminimumm
      			SI lunitedemesure=1 ALORS surface_minimuminverse=client.cminimumm SINON surface_minimuminverse=client.cminimuma
      		FIN
      		
      		SELON commandeTRN.facalcul 
      			CAS 1
      				commandeTRN.fdpiedcarreReel = lasurfaceanglaisreelle
      			CAS 2
      				commandeTRN.fdpiedcarreReel = lasurfacemetriquereelle
      		FIN
      		
      		SI lasurface < surface_minimum ALORS
      			lasurface = surface_minimum
      		FIN
      		
      		SI lunitedemesure = 2 ALORS
      			//			extracapgazinex = extracapgazinex * config.conversionam
      			//			extracap = extracap * config.conversionam
      			extracapgazinex = extracapgazinex * gclconfig.m_rconversionam
      			extracap = extracap * gclconfig.m_rconversionam
      		FIN
      		SELON IndiceNbVerre
      			CAS 2
      				extraintercallaire = extraintercallaired
      			CAS 3
      				extraintercallaire = extraintercallairet
      		FIN
      		
      		resultat = resultat +  extracapgazinex + extraintercallaire
      		resultat = Arrondi(resultat,2)
      		commandeTRN.FDExtraCap = extracap
      		
      		// si modif et surface modifie garde la surface inscrite
      		SI dmodif ET PAS commandeTRN.cdnumprod..Modifié ET commandeTRN.intsurfacemodifie ALORS
      			lsurfaceafacturer = commandeTRN.CdSurfaceFacture
      		SINON
      			//
      			SELON client.CImpressionAngMet
      				CAS 0,1
      					SI commandeTRN.facalcul = 1 ALORS
      						lsurfaceafacturer = Arrondi(lasurface,2)
      					SINON
      						lsurfaceafacturer = Max(lasurfaceanglais,surface_minimuminverse)
      					FIN
      				CAS 2
      					SI commandeTRN.facalcul = 2 ALORS
      						lsurfaceafacturer =	Arrondi(lasurface,4)
      					SINON
      						lsurfaceafacturer =	Max(lasurfacemetrique,surface_minimuminverse)
      					FIN
      			FIN
      			commandeTRN.CdSurfaceFacture = lsurfaceafacturer
      		FIN
      		
      		
      		
      		// si modif garde le prix inscrit
      		
      		SI (dmodif ET PAS commandeTRN.cdnumprod..Modifié et pas commandetrn.CDCOMPOSANT1..modifie ET PAS commandeTRN.CDCOMPOSANT2..Modifié ET PAS commandeTRN.CDCOMPOSANT3..Modifié ) _ou_ commandeTRN.intPrixmodifie ALORS
      			resultat = commandeTRN.CDPRIXUPIED
      		SINON
      			commandeTRN.CDPRIXUPIED = resultat  
      		FIN
      		
      		
      		SELON client.CImpressionAngMet
      			CAS 0,1
      				SI commandeTRN.facalcul = 1 ALORS
      					commandeTRN.CdPRIXU = Arrondi(resultat,2) * lsurfaceafacturer 
      					commandeTRN.FDExtraCap = Arrondi(commandeTRN.FDExtraCap,2) * lsurfaceafacturer
      					commandeTRN.CDPRIXTOT = Arrondi(commandeTRN.CdPRIXU,2)  * commandeTRN.cdqte
      					trdetail.fdpiedcarrefacture = lsurfaceafacturer
      					trdetail.fdprixupiedfacture =  Arrondi(resultat,2)
      				SINON
      					//			commandeTRN.CdPRIXU = Arrondi(resultat  / config.conversionam,2) * lsurfaceafacturer 
      					//			commandeTRN.FDExtraCap = Arrondi(commandeTRN.FDExtraCap  / config.conversionam,2) * lsurfaceafacturer 
      					commandeTRN.CdPRIXU = Arrondi(resultat  / gclconfig.m_rconversionam,2) * lsurfaceafacturer 
      					commandeTRN.FDExtraCap = Arrondi(commandeTRN.FDExtraCap  / gclconfig.m_rconversionam,2) * lsurfaceafacturer 
      					commandeTRN.CDPRIXTOT = Arrondi(commandeTRN.CdPRIXU,2)  * commandeTRN.cdqte
      					trdetail.fdpiedcarrefacture = lsurfaceafacturer
      //					trdetail.fdprixupiedfacture =  Arrondi(resultat/config.conversionam,2)
      					trdetail.fdprixupiedfacture =  Arrondi(resultat/gclconfig.m_rconversionam,2)
      				FIN
      				
      				commandeTRN.fdpiedcarre = Min(lasurfaceanglais,trdetail.fdpiedcarrefacture)
      			CAS 2	
      				SI commandeTRN.facalcul = 2 ALORS
      					commandeTRN.CdPRIXU = Arrondi(resultat,2) * lsurfaceafacturer  
      					commandeTRN.FDExtraCap = Arrondi(FDExtraCap,2) * lsurfaceafacturer  
      					commandeTRN.CDPRIXTOT = Arrondi(commandeTRN.CdPRIXU,2)  * commandeTRN.cdqte
      					trdetail.fdpiedcarrefacture = lsurfaceafacturer
      					trdetail.fdprixupiedfacture = Arrondi(resultat,2)
      				SINON
      //					commandeTRN.CdPRIXU = Arrondi(resultat  * config.conversionam,2) * lsurfaceafacturer 
      //					commandeTRN.FDExtraCap = Arrondi(FDExtraCap  * config.conversionam,2) * lsurfaceafacturer 
      					commandeTRN.CdPRIXU = Arrondi(resultat  * gclconfig.m_rconversionam,2) * lsurfaceafacturer 
      					commandeTRN.FDExtraCap = Arrondi(FDExtraCap  * gclconfig.m_rconversionam,2) * lsurfaceafacturer 
      					commandeTRN.CDPRIXTOT = Arrondi(commandeTRN.CdPRIXU,2)  * commandeTRN.cdqte
      					trdetail.fdpiedcarrefacture = lsurfaceafacturer
      //					trdetail.fdprixupiedfacture = Arrondi(resultat* config.conversionam,2)
      					trdetail.fdprixupiedfacture = Arrondi(resultat* gclconfig.m_rconversionam,2)
      				FIN
      				
      				commandeTRN.fdpiedcarre = Min(lasurfacemetrique,trdetail.fdpiedcarrefacture)
      		FIN
      		
      		
      		SI dmodif ET PAS commandeTRN.cdnumprod..Modifié ET commandeTRN.intPrixmodifie ALORS
      			//	//resultat = commandetrn.cdprixupied
      		SINON
      			CdSurfaceFacture = trdetail.fdpiedcarrefacture
      		FIN
      		
      		commandeTRN.FDextra5x = 0
      		commandeTRN.FDextra10X = 0
      		SI lexception10 ALORS
      //			commandeTRN.FDextra10X = Arrondi(commandeTRN.CdPRIXU * config.Exception10 / 100,2)
      			commandeTRN.FDextra10X = Arrondi(commandeTRN.CdPRIXU * gclconfig.m_rException10 / 100,2)
      			commandeTRN.FDextra5x = 0
      		FIN
      		SI lexception5 ALORS
      //			commandeTRN.FDextra5x = Arrondi(commandeTRN.CdPRIXU * config.Exception5 / 100,2)
      			commandeTRN.FDextra5x = Arrondi(commandeTRN.CdPRIXU * gclconfig.m_rException5 / 100,2)
      			commandeTRN.FDextra10X = 0
      		FIN
      		
      		
      		commandeTRN.CDPRIXTOT += Arrondi(commandeTRN.fdextraforme,2)  * commandeTRN.cdqte
      		
      		RENVOYER 0
      		
      		
      	CAS "Verreunite"
      		validedate("verreunite")
      		
      		SI lunitedemesure = 1 ALORS resultat = {prixunitaire} SINON resultat = {prixunitairem}
      		clederecherche = HConstruitValClé(ProduitClient,IdClientIdproruit,commandeTRN.FCLIENT,commandeTRN.cdnumprod)
      		
      		SI HLitRecherche(ProduitClient,IdClientIdproruit,clederecherche) ET ProduitClient.IPprixSpecial ALORS
      			SI commandeTRN.facalcul = 1 ALORS resultat = ProduitClient.IPrixa SINON resultat = ProduitClient.iprixm	 	
      		FIN
      		
      		
      		SELON client.CImpressionAngMet
      			CAS 0,1
      				SI commandeTRN.facalcul = 1 ALORS
      					trdetail.fdpiedcarrefacture = Arrondi(lasurfaceanglais,2)
      					trdetail.fdprixupiedfacture =  Arrondi(resultat,2)
      				SINON
      					trdetail.fdpiedcarrefacture = Arrondi(lasurfaceanglais,2)
      //					trdetail.fdprixupiedfacture =  Arrondi(resultat/config.conversionam,2)
      					trdetail.fdprixupiedfacture =  Arrondi(resultat/gclconfig.m_rconversionam,2)
      				FIN
      				
      				commandeTRN.fdpiedcarre = Min(lasurfaceanglais,trdetail.fdpiedcarrefacture)
      			CAS 2	
      				SI commandeTRN.facalcul = 2 ALORS
      					trdetail.fdpiedcarrefacture = Arrondi(lasurfacemetrique,2)
      					trdetail.fdprixupiedfacture = Arrondi(resultat,2)
      				SINON
      					trdetail.fdpiedcarrefacture = Arrondi(lasurfacemetrique,2)
      //					trdetail.fdprixupiedfacture = Arrondi(resultat* config.conversionam,2)
      					trdetail.fdprixupiedfacture = Arrondi(resultat* gclconfig.m_rconversionam,2)
      				FIN
      				
      				commandeTRN.fdpiedcarre = Min(lasurfacemetrique,trdetail.fdpiedcarrefacture)
      		FIN
      		
      		lasurface = Arrondi(lasurface,2)
      		commandeTRN.CDPRIXUPIED = resultat
      		commandeTRN.CdPRIXU = resultat * lasurface 
      		commandeTRN.CDPRIXTOT = Arrondi(commandeTRN.CdPRIXU,2)  * commandeTRN.cdqte
      		commandeTRN.CdSurfaceFacture = trdetail.fdpiedcarrefacture
      		
      	CAS "Unite"
      		HLitRecherche("invent","INUM",commandeTRN.cdnumprod)
      		SI PAS HEnDehors() ALORS
      			SI HTrouve() ALORS
      				validedate("unite")	
      				SI PAS typeunite = 4 ALORS
      					pextra[1] = {prixunitaire}
      				SINON
      					pextra[1] = {prixunitaire}
      				FIN
      			FIN
      		FIN		  
      		net[1] = pextra[1]
      		
      		clederecherche = HConstruitValClé(ProduitClient,IdClientIdproruit,commandeTRN.FCLIENT,commandeTRN.cdnumprod)
      		
      		SI HLitRecherche(ProduitClient,IdClientIdproruit,clederecherche) ET ProduitClient.IPprixSpecial ALORS
      			SI commandeTRN.facalcul = 1 ALORS
      				net[1] = ProduitClient.IPrixa
      			SINON
      				net[1] = ProduitClient.IPrixa	 	
      			FIN
      		FIN
      		
      		commandeTRN.CdPRIXU = net[1]
      		commandeTRN.CDPRIXUPIED = net[1] 
      		commandeTRN.CDPRIXTOT = commandeTRN.CDPRIXUPIED  * commandeTRN.cdqte
      		
      	CAS "Peinture","PeintureUnite"
      		clederecherche = HConstruitValClé(ProduitClient,IdClientIdproruit,commandeTRN.FCLIENT,commandeTRN.cdnumprod)
      		
      		SI HLitRecherche(ProduitClient,IdClientIdproruit,clederecherche) ET ProduitClient.IPprixSpecial ALORS
      			SI invent.iUniteMesure = 1 ALORS
      				resultat = Arrondi(ProduitClient.IPrixa,2)
      			SINON
      				SI commandeTRN.facalcul = 1 ALORS
      					resultat = Arrondi(ProduitClient.IPrixa,2)
      				SINON
      					resultat = Arrondi(ProduitClient.iprixm,2)
      				FIN
      			FIN
      		SINON
      			SI invent.iUniteMesure = 1 ALORS
      				resultat = Arrondi(invent.iprixPeinture,2) * (100 - client.Cpourescompte) / 100
      			SINON
      				SI commandeTRN.facalcul = 1 ALORS
      					resultat = Arrondi(invent.iprixPeinture,2)* (100 - client.Cpourescompte) / 100
      				SINON
      					resultat = Arrondi(invent.iprixpeintureM,2)* (100 - client.Cpourescompte) / 100
      				FIN
      			FIN
      		FIN
      		
      		//////////////////////////////////////
      		// vérifie couleur
      		//////////////////////////////////////
      		SI SansEspace(commandeTRN.fNoPeinture) <> "" ET SansEspace(commandeTRN.fNoPeinture1) <> "" ALORS
      			resultat = Arrondi(resultat * 2,2)
      		FIN
      		
      		// iunitemesure 1=unité 2 =Pied linéaire
      		SI invent.iUniteMesure = 1 ALORS
      			// recherche extra sur couleur 1
      			clederecherche = HConstruitValClé(FClientProduitCouleur,NoClientNoProduitNoCouleur,...
      			SansEspace(commandeTRN.FCLIENT),SansEspace(commandeTRN.cdnumprod),SansEspace(commandeTRN.fNoPeinture))
      			
      			SI HLitRecherche(FClientProduitCouleur,NoClientNoProduitNoCouleur,clederecherche) ALORS
      				resultat+= Arrondi(FClientProduitCouleur.fcextraunite,2)
      			FIN
      			
      			// recherche extra sur couleur 2
      			clederecherche = HConstruitValClé(FClientProduitCouleur,NoClientNoProduitNoCouleur,...
      			SansEspace(commandeTRN.FCLIENT),SansEspace(commandeTRN.cdnumprod),SansEspace(commandeTRN.fNoPeinture1))
      			
      			SI HLitRecherche(FClientProduitCouleur,NoClientNoProduitNoCouleur,clederecherche) ALORS
      				resultat+= Arrondi(FClientProduitCouleur.fcextraunite,2)
      			FIN
      		SINON // pied linéaire
      			// recherche si extra sur couleur 1
      			SI PAS invent.iCalculSimplePeinture
      				clederecherche = HConstruitValClé(FCouleurClient,noClientNoCouleur,commandeTRN.FCLIENT,commandeTRN.fNoPeinture)
      				SI HLitRecherche(FCouleurClient,noClientNoCouleur,clederecherche) ALORS
      					SI commandeTRN.facalcul = 1 ALORS
      						SI PAS FCouleurClient.fcExtralineaire = 0 ALORS
      							resultat+= Arrondi(FCouleurClient.fcExtralineaire,2)
      						FIN
      					SINON
      						SI PAS FCouleurClient.fcextralineaireM = 0 ALORS
      							resultat+=Arrondi(FCouleurClient.fcextralineaireM,2)
      						FIN
      					FIN
      				SINON
      					SI HLitRecherche(FCouleur,noCouleur,commandeTRN.fNoPeinture) ALORS
      						SI commandeTRN.facalcul = 1 ALORS
      							resultat+= Arrondi(FCouleur.cExtraLineaire,2)* (100 - client.Cpourescompte) / 100
      						SINON
      							resultat+= Arrondi(FCouleur.CExtraLineaireM,2)* (100 - client.Cpourescompte) / 100
      						FIN
      					FIN
      				FIN
      				
      				// recherche si extra sur couleur 2
      				clederecherche = HConstruitValClé(FCouleurClient,noClientNoCouleur,commandeTRN.FCLIENT,commandeTRN.fNoPeinture1)
      				SI HLitRecherche(FCouleurClient,noClientNoCouleur,clederecherche) ALORS
      					SI commandeTRN.facalcul = 1 ALORS
      						SI PAS FCouleurClient.fcExtralineaire = 0 ALORS
      							resultat+= Arrondi(FCouleurClient.fcExtralineaire,2)
      						FIN
      					SINON
      						SI PAS FCouleurClient.fcextralineaireM = 0 ALORS
      							resultat+=Arrondi(FCouleurClient.fcextralineaireM,2)
      						FIN
      					FIN
      				SINON
      					SI HLitRecherche(FCouleur,noCouleur,commandeTRN.fNoPeinture1) ALORS
      						SI commandeTRN.facalcul = 1 ALORS
      							resultat+= Arrondi(FCouleur.cExtraLineaire,2)* (100 - client.Cpourescompte) / 100
      						SINON
      							resultat+= Arrondi(FCouleur.CExtraLineaireM,2)* (100 - client.Cpourescompte) / 100
      						FIN
      					FIN
      				FIN
      			FIN
      		FIN
      		
      		SI commandeTRN.cssTypePeinture2 = 2  ET PAS invent.iCalculSimplePeinture ALORS
      			resultat = resultat * 2
      		FIN
      		SI dmodif ET PAS commandeTRN.cdnumprod..Modifié ET commandeTRN.intsurfacemodifie ALORS
      			ladimension = commandeTRN.CdSurfaceFacture
      		fin
      		
      		SELON client.CImpressionAngMet
      			CAS 0
      				SI Facture.facalcul = 1 ALORS
      					Fdetail.fdprixu = Arrondi(resultat,2) * Arrondi(ladimension,2) 
      					commandeTRN.CDPRIXTOT = Arrondi(commandeTRN.CdPRIXU,2)  * commandeTRN.cdqte
      				SINON
      //					commandeTRN.CdPRIXU = Arrondi(resultat  / config.conversionam,2) * Arrondi(ladimension,2)
      					commandeTRN.CdPRIXU = Arrondi(resultat  / gclconfig.m_rconversionam,2) * Arrondi(ladimension,2)
      					commandeTRN.CDPRIXTOT = Arrondi(commandeTRN.CdPRIXU,2)  * commandeTRN.cdqte
      				FIN
      			CAS 1
      				SI commandeTRN.facalcul = 1 ALORS
      					commandeTRN.CdPRIXU = Arrondi(resultat,2) * Arrondi(ladimension,2) 
      					commandeTRN.CDPRIXTOT = Arrondi(commandeTRN.CdPRIXU,2)  * commandeTRN.cdqte
      				SINON
      //					commandeTRN.CdPRIXU = Arrondi(resultat  / config.conversionam,2) * Arrondi(ladimension,2)
      					commandeTRN.CdPRIXU = Arrondi(resultat  / gclconfig.m_rconversionam,2) * Arrondi(ladimension,2)
      					commandeTRN.CDPRIXTOT = Arrondi(commandeTRN.CdPRIXU,2)  * commandeTRN.cdqte
      				FIN
      			CAS 2
      				SI commandeTRN.facalcul = 2 ALORS
      					commandeTRN.CdPRIXU = Arrondi(resultat,2) * Arrondi(ladimension,2)  
      					commandeTRN.CDPRIXTOT = Arrondi(commandeTRN.CdPRIXU,2)  * commandeTRN.cdqte
      				SINON
      //					commandeTRN.CdPRIXU = Arrondi(resultat  * config.conversionam,2) * Arrondi(ladimension,2)
      					commandeTRN.CdPRIXU = Arrondi(resultat  * gclconfig.m_rconversionam,2) * Arrondi(ladimension,2)
      					commandeTRN.CDPRIXTOT = Arrondi(commandeTRN.CdPRIXU,2)  * commandeTRN.cdqte
      				FIN
      		FIN
      		
      		
      		SELON invent.iUniteMesure
      			CAS 1
      				commandeTRN.CdPRIXU = resultat 
      				commandeTRN.CDPRIXUPIED = resultat
      				CdSurfaceFacture = ladimension
      			CAS 2	
      				commandeTRN.CDPRIXUPIED = resultat
      				commandeTRN.CdPRIXU = resultat * ladimension
      				CdSurfaceFacture = ladimension
      			CAS 3	
      				commandeTRN.CDPRIXUPIED = resultat
      				commandeTRN.CdPRIXU = resultat * ladimension
      				CdSurfaceFacture = ladimension
      			CAS 4	
      				commandeTRN.CDPRIXUPIED = resultat
      				commandeTRN.CdPRIXU = resultat * ladimension
      				CdSurfaceFacture = ladimension
      		FIN
      		
      		commandeTRN.CDPRIXTOT = commandeTRN.CdPRIXU  * commandeTRN.cdqte
      		
      FIN
      
     type : 458752
   -
     name : deplace_ligne
     procedure_id : 5859041162930341697
     type_code : 14
     code : |1+
      Procédure deplace_ligne(sens)
      mult est un entier 
      derniereligne est un entier 
      hpostrdetail est un entier= hsauveposition(trdetail)
      hpostrdetail1 est un entier= hsauveposition(trdetail)
      hpostable est un entier= tableselect(table_1)
      
      hpostempo est un entier
      nbligneadeplacer1 est un entier = 1
      nbligneadeplacer2 est un entier = 1
      NoRecordLigne11 est un entier = 0
      NoRecordLigne12 est un entier = 0
      NoRecordLigne21 est un entier = 0
      NoRecordLigne22 est un entier = 0
      NoRecordfLigne11 est un entier = 0
      NoRecordfLigne12 est un entier = 0
      NoRecordfLigne21 est un entier = 0
      NoRecordfLigne22 est un entier = 0
      numcommande est une chaine
      ligcommande est une chaine
      clederecherche est une chaine
      hgeredoublon(trdetail,fdcle,faux)
      hgeredoublon(fdetail,fdcle,faux)
      hlitdernier(trdetail,fdcle)
      derniereligne = trdetail.fdligne
      hretourposition(hpostrdetail)
      selon sens
      	cas "UP"
      		mult = -1
      	cas "DOWN"
      		mult = 1	
      FIN
      NoRecordLigne11 = hnumenr(trdetail)
      clederecherche = HConstruitValClé(fdetail,fdcle,trdetail.fdnocomm,trdetail.trancienneligne)
      si hlitrecherche(fdetail,fdcle,clederecherche) alors
      	NoRecordfLigne11 = hnumenr(fdetail)
      fin	
      
      si trdetail.fdlien <> 0 alors
      	nbligneadeplacer1 = 2
      	si trdetail.fdlien <> trdetail.fdligne alors
      		hlitprecedent(trdetail,fdcle)
      		NoRecordLigne12 = hnumenr(trdetail)
      		clederecherche = HConstruitValClé(fdetail,fdcle,trdetail.fdnocomm,trdetail.trancienneligne)
      		si hlitrecherche(fdetail,fdcle,clederecherche) alors
      			NoRecordfLigne12 = hnumenr(fdetail)
      		fin	
      
      	sinon
      		hlitsuivant(trdetail,fdcle)
      		NoRecordLigne12 = hnumenr(trdetail)
      		clederecherche = HConstruitValClé(fdetail,fdcle,trdetail.fdnocomm,trdetail.trancienneligne)
      		si hlitrecherche(fdetail,fdcle,clederecherche) alors
      			NoRecordfLigne12 = hnumenr(fdetail)
      		fin	
      
      		hlitprecedent(trdetail,fdcle)
      
      FIN
      FIN
      
      
      selon sens
      
      	cas "UP"
      		hpostempo = hsauveposition(trdetail)
      		hrecule(trdetail,1)
      		si hendehors(trdetail) alors
      			//si trdetail.fdligne + mult = 0 alors
      			acso_message("Erreur","Cette ligne ne peut pas être déplacée","Erreur")
      			hretourposition(hpostempo)
      			renvoyer vrai
      		FIN
      		hretourposition(hpostempo)
      	cas "DOWN"
      		si trdetail.fdligne + nbligneadeplacer1 > derniereligne alors
      			acso_message("Erreur","Cette ligne ne peut pas être déplacée","Erreur")
      			renvoyer vrai
      		FIN
      fin
      
      selon sens
      	cas "UP"
      
      
      		hlitprecedent(trdetail,fdcle)
      		si trdetail.fdlien <> 0 alors
      			si trdetail.fdlien <> trdetail.fdligne alors
      				nbligneadeplacer2 = 2
      				NoRecordLigne22 = hnumenr(trdetail)
      				clederecherche = HConstruitValClé(fdetail,fdcle,trdetail.fdnocomm,trdetail.trancienneligne)
      				si hlitrecherche(fdetail,fdcle,clederecherche) alors
      					NoRecordfLigne22 = hnumenr(fdetail)
      				fin	
      
      				hlitprecedent(trdetail,fdcle)
      				NoRecordLigne21 = hnumenr(trdetail)
      				clederecherche = HConstruitValClé(fdetail,fdcle,trdetail.fdnocomm,trdetail.trancienneligne)
      				si hlitrecherche(fdetail,fdcle,clederecherche) alors
      					NoRecordfLigne21 = hnumenr(fdetail)
      				fin	
      
      			sinon
      				nbligneadeplacer2 = 2
      				NoRecordLigne21 = hnumenr(trdetail)
      				clederecherche = HConstruitValClé(fdetail,fdcle,trdetail.fdnocomm,trdetail.trancienneligne)
      				si hlitrecherche(fdetail,fdcle,clederecherche) alors
      					NoRecordfLigne21 = hnumenr(fdetail)
      				fin	
      
      				hlitsuivant(trdetail,fdcle)
      				NoRecordLigne22 = hnumenr(trdetail)
      				clederecherche = HConstruitValClé(fdetail,fdcle,trdetail.fdnocomm,trdetail.trancienneligne)
      				si hlitrecherche(fdetail,fdcle,clederecherche) alors
      					NoRecordfLigne22 = hnumenr(fdetail)
      				fin	
      
      				hlitprecedent(trdetail,fdcle)
      			FIN
      		sinon
      			NoRecordLigne21 = hnumenr(trdetail)
      			clederecherche = HConstruitValClé(fdetail,fdcle,trdetail.fdnocomm,trdetail.trancienneligne)
      			si hlitrecherche(fdetail,fdcle,clederecherche) alors
      				NoRecordfLigne21 = hnumenr(fdetail)
      			fin	
      
      		FIN
      
      	cas "DOWN"
      
      		havance(trdetail,fdcle,nbligneadeplacer1)
      		si trdetail.fdlien <> 0 alors
      			si trdetail.fdlien <> trdetail.fdligne alors
      				nbligneadeplacer2 = 2
      				NoRecordLigne21 = hnumenr(trdetail)
      				clederecherche = HConstruitValClé(fdetail,fdcle,trdetail.fdnocomm,trdetail.trancienneligne)
      				si hlitrecherche(fdetail,fdcle,clederecherche) alors
      					NoRecordfLigne21 = hnumenr(fdetail)
      				fin	
      
      				hlitsuivant(trdetail,fdcle)
      				NoRecordLigne22 = hnumenr(trdetail)
      				clederecherche = HConstruitValClé(fdetail,fdcle,trdetail.fdnocomm,trdetail.trancienneligne)
      				si hlitrecherche(fdetail,fdcle,clederecherche) alors
      					NoRecordfLigne22 = hnumenr(fdetail)
      				fin	
      
      			sinon
      				nbligneadeplacer2 = 2
      				NoRecordLigne21 = hnumenr(trdetail)
      				clederecherche = HConstruitValClé(fdetail,fdcle,trdetail.fdnocomm,trdetail.trancienneligne)
      				si hlitrecherche(fdetail,fdcle,clederecherche) alors
      					NoRecordfLigne21 = hnumenr(fdetail)
      				fin	
      
      				hlitsuivant(trdetail,fdcle)
      				NoRecordLigne22 = hnumenr(trdetail)
      				clederecherche = HConstruitValClé(fdetail,fdcle,trdetail.fdnocomm,trdetail.trancienneligne)
      				si hlitrecherche(fdetail,fdcle,clederecherche) alors
      					NoRecordfLigne22 = hnumenr(fdetail)
      				fin	
      
      				hlitprecedent(trdetail,fdcle)
      			FIN
      		sinon
      			NoRecordLigne21 = hnumenr(trdetail)
      			clederecherche = HConstruitValClé(fdetail,fdcle,trdetail.fdnocomm,trdetail.trancienneligne)
      			si hlitrecherche(fdetail,fdcle,clederecherche) alors
      				NoRecordfLigne21 = hnumenr(fdetail)
      			fin	
      
      
      		FIN
      
      FIN
      
      
      selon nbligneadeplacer1
      	cas 1
      		selon nbligneadeplacer2
      			cas 1
      				hlit(trdetail,NoRecordLigne11)
      				trdetail.fdligne = trdetail.fdligne + (mult * nbligneadeplacer2)
      				trdetail.trancienneligne = trdetail.fdligne 
      				hmodifie(trdetail,NoRecordLigne11)
      
      				hlit(fdetail,NoRecordfLigne11)
      				fdetail.fdligne = trdetail.fdligne
      				hmodifie(fdetail,hnumenrencours)
      
      				hlit(trdetail,NoRecordLigne21)
      				trdetail.fdligne = trdetail.fdligne + (mult * -1 * nbligneadeplacer1)
      				trdetail.trancienneligne = trdetail.fdligne 
      				hmodifie(trdetail,NoRecordLigne21)
      				hlit(fdetail,NoRecordfLigne21)
      				fdetail.fdligne = trdetail.fdligne
      				hmodifie(fdetail,hnumenrencours)
      			cas 2
      				hlit(trdetail,NoRecordLigne11)
      				trdetail.fdligne = trdetail.fdligne + (mult * nbligneadeplacer2)
      				trdetail.trancienneligne = trdetail.fdligne 
      				si trdetail.fdlien <> 0 alors
      					trdetail.fdlien = trdetail.fdlien + (mult * nbligneadeplacer2)
      				FIN
      				hmodifie(trdetail,NoRecordLigne11)
      
      				hlit(fdetail,NoRecordfLigne11)
      				fdetail.fdligne = trdetail.fdligne
      				si fdetail.fdlien <> 0 alors
      					fdetail.fdlien = trdetail.fdlien 
      				FIN
      				hmodifie(fdetail,hnumenrencours)
      
      				hlit(trdetail,NoRecordLigne21)
      				trdetail.fdligne = trdetail.fdligne + (mult * -1 * nbligneadeplacer1)
      				trdetail.trancienneligne = trdetail.fdligne 
      				si trdetail.fdlien <> 0 alors
      					trdetail.fdlien = trdetail.fdlien + (mult * -1 * nbligneadeplacer1)
      				FIN
      				hmodifie(trdetail,NoRecordLigne21)
      
      				hlit(fdetail,NoRecordfLigne21)
      				fdetail.fdligne = trdetail.fdligne
      				si fdetail.fdlien <> 0 alors
      					fdetail.fdlien = trdetail.fdlien 
      				FIN
      				hmodifie(fdetail,hnumenrencours)
      
      				hlit(trdetail,NoRecordLigne22)
      				trdetail.fdligne = trdetail.fdligne + (mult * -1 * nbligneadeplacer1)
      				trdetail.trancienneligne = trdetail.fdligne 
      				si trdetail.fdlien <> 0 alors
      					trdetail.fdlien = trdetail.fdlien + (mult * -1 * nbligneadeplacer1)
      				FIN
      				hmodifie(trdetail,NoRecordLigne22)
      
      				hlit(fdetail,NoRecordfLigne22)
      				fdetail.fdligne = trdetail.fdligne
      				si fdetail.fdlien <> 0 alors
      					fdetail.fdlien = trdetail.fdlien 
      				FIN
      				hmodifie(fdetail,hnumenrencours)
      
      		FIN
      	cas 2
      		selon nbligneadeplacer2
      			cas 1
      				hlit(trdetail,NoRecordLigne11)
      				trdetail.fdligne = trdetail.fdligne + (mult * nbligneadeplacer2)
      				trdetail.trancienneligne = trdetail.fdligne 
      				si trdetail.fdlien <> 0 alors
      					trdetail.fdlien = trdetail.fdlien + (mult * nbligneadeplacer2)
      				FIN
      				hmodifie(trdetail,NoRecordLigne11)
      
      				hlit(fdetail,NoRecordfLigne11)
      				fdetail.fdligne = trdetail.fdligne
      				si fdetail.fdlien <> 0 alors
      					fdetail.fdlien = trdetail.fdlien 
      				FIN
      				hmodifie(fdetail,hnumenrencours)
      
      				hlit(trdetail,NoRecordLigne12)
      				trdetail.fdligne = trdetail.fdligne + (mult * nbligneadeplacer2)
      				trdetail.trancienneligne = trdetail.fdligne 
      				si trdetail.fdlien <> 0 alors
      					trdetail.fdlien = trdetail.fdlien + (mult * nbligneadeplacer2)
      				FIN
      				hmodifie(trdetail,NoRecordLigne12)
      
      				hlit(fdetail,NoRecordfLigne12)
      				fdetail.fdligne = trdetail.fdligne
      				si fdetail.fdlien <> 0 alors
      					fdetail.fdlien = trdetail.fdlien 
      				FIN
      				hmodifie(fdetail,hnumenrencours)
      
      				hlit(trdetail,NoRecordLigne21)
      				si trdetail.fdlien <> 0 alors
      					trdetail.fdlien = trdetail.fdlien + (mult * -1 * nbligneadeplacer1)
      				FIN
      				trdetail.fdligne = trdetail.fdligne + (mult * -1 * nbligneadeplacer1)
      				trdetail.trancienneligne = trdetail.fdligne 
      				hmodifie(trdetail,NoRecordLigne21)
      
      				hlit(fdetail,NoRecordfLigne21)
      				fdetail.fdligne = trdetail.fdligne
      				si fdetail.fdlien <> 0 alors
      					fdetail.fdlien = trdetail.fdlien 
      				FIN
      				hmodifie(fdetail,hnumenrencours)
      
      			cas 2
      				hlit(trdetail,NoRecordLigne11)
      				trdetail.fdligne = trdetail.fdligne + (mult * nbligneadeplacer2)
      				trdetail.trancienneligne = trdetail.fdligne 
      				si trdetail.fdlien <> 0 alors
      					trdetail.fdlien = trdetail.fdlien + (mult * nbligneadeplacer2)
      				FIN
      				hmodifie(trdetail,NoRecordLigne11)
      
      				hlit(fdetail,NoRecordfLigne11)
      				fdetail.fdligne = trdetail.fdligne
      				si fdetail.fdlien <> 0 alors
      					fdetail.fdlien = trdetail.fdlien 
      				FIN
      				hmodifie(fdetail,hnumenrencours)
      
      				hlit(trdetail,NoRecordLigne12)
      				trdetail.fdligne = trdetail.fdligne + (mult * nbligneadeplacer2)
      				trdetail.trancienneligne = trdetail.fdligne 
      				si trdetail.fdlien <> 0 alors
      					trdetail.fdlien = trdetail.fdlien + (mult * nbligneadeplacer2)
      				FIN
      				hmodifie(trdetail,NoRecordLigne12)
      
      				hlit(fdetail,NoRecordfLigne12)
      				fdetail.fdligne = trdetail.fdligne
      				si fdetail.fdlien <> 0 alors
      					fdetail.fdlien = trdetail.fdlien 
      				FIN
      				hmodifie(fdetail,hnumenrencours)
      
      				hlit(trdetail,NoRecordLigne21)
      				trdetail.fdligne = trdetail.fdligne + (mult * -1 * nbligneadeplacer1)
      				trdetail.trancienneligne = trdetail.fdligne 
      				si trdetail.fdlien <> 0 alors
      					trdetail.fdlien = trdetail.fdlien + (mult * -1 * nbligneadeplacer1)
      				FIN
      				hmodifie(trdetail,NoRecordLigne21)
      
      				hlit(fdetail,NoRecordfLigne21)
      				fdetail.fdligne = trdetail.fdligne
      				si fdetail.fdlien <> 0 alors
      					fdetail.fdlien = trdetail.fdlien 
      				FIN
      				hmodifie(fdetail,hnumenrencours)
      
      				hlit(trdetail,NoRecordLigne22)
      				trdetail.fdligne = trdetail.fdligne + (mult * -1 * nbligneadeplacer1)
      				trdetail.trancienneligne = trdetail.fdligne 
      				si trdetail.fdlien <> 0 alors
      					trdetail.fdlien = trdetail.fdlien + (mult * -1 * nbligneadeplacer1)
      				FIN
      				hmodifie(trdetail,NoRecordLigne22)
      
      				hlit(fdetail,NoRecordfLigne22)
      				fdetail.fdligne = trdetail.fdligne
      				si fdetail.fdlien <> 0 alors
      					fdetail.fdlien = trdetail.fdlien 
      				FIN
      				hmodifie(fdetail,hnumenrencours)
      
      		FIN
      FIN
      
      //TableAffiche(TABLE_1)
      hgeredoublon(trdetail,fdcle,faux)
      hgeredoublon(fdetail,fdcle,vrai)
      //hretourposition(hpostrdetail1)
      
      //tableaffiche(TABLE_1,taDébut)
      
      tableaffiche(table_1,taCourantBandeau)
      hlit(trdetail,hpostrdetail1)
      multitache()
      selon sens
      	cas "DOWN"
      	envoietouche("{BAS}","table_1")
      	//		table_1 = hpostable+1
      	cas "UP"
      		envoietouche("{HAUT}","table_1")
      //		table_1 = hpostable-1
      
      FIN
     type : 458752
