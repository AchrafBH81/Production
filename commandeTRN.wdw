          identifier : 0x514f7ee55765c773
          internal_properties : 
          properties :
           x : 6
           y : 60
           width : 80
           height : 24
          type : 4
          code_elements :
           type_code : 4
           p_codes :
            -
              code : |1+
               commandetrn.cdcomposant3=Ouvre("Recherche de produit","","verre")
               commandetrn.CDCOMPOSANT3..MODIFIE = VRAI
               si champencours() = "CDCOMPOSANT3" alors
               	envoietouche("{entree}")
               sinon
               	ExécuteTraitement(commandetrn.cdcomposant3,trtsortie)
               FIN
               
              type : 18
            -
              type : 161
              enabled : false
        -
          name : CDCOMPOSANT3
          identifier : 0x514f7ee5687ac7a5
          internal_properties : 
          properties :
           x : 79
           y : 61
           width : 63
           height : 23
          type : 2
          code_elements :
           type_code : 3
           p_codes :
            -
              code : |1-
               clederecherche EST UNE CHAINE
               commandetrn.btn_composant3..etat = actif
               surfaceminimumdifferentea = 0
               surfaceminimumdifferentem = 0
               si moimeme..modifie ou dmodif ou sansespace(cdnumprod) = "" alors
               	
               	si pas existe_produit(moimeme) alors
               		reprisesaisie()
               	SINON
               		SI  ForbiddenComponent(MoiMême) ALORS
               			Erreur("Cette composante n'est pas autorisée pour ce client")
               			MoiMême			= ""
               			RepriseSaisie(MoiMême)
               		FIN
               		SI PAS sansespace(MOIMEME) = "" ALORS 
               			selon langueclient
               				cas 0,1
               					composant3_nom  = invent.idesc
               				cas 2
               					composant3_nom  = invent.idescA
               			FIN
               			produitdebase3 = invent.ipbase
               			descriptioncourte3 = sansespace(invent.idesccourte)
               		sinon
               			descriptioncourte3 = ""
               			produitdebase3 = ""
               			COMPOSANT3_NOM = ""
               		FIN
               		si pas cdenergiverre alors
               			cdenergiverre  = (invent.ienergieverre OU invent.ienergieverreESC)
               			si CDENERGIVERRE alors
               				ajoutez()
               			fin
               			
               		fin
               	FIN
               	calcul_prixu(commandeTRN.facalcul,escompteqte,pourcescompteqte)
               FIN
               
               si commandetrn.cdnumprod = "" et commandetrn.cdcomposant1 = "" et ... 
               	commandetrn.cdcomposant2 = "" et commandetrn.cdcomposant3 = ""   alors
               	griser_saisie(2)
               	typedeproduit = "Unite"
               sinon
               	typedeproduit = "Verre"
               	bThermosTrouve est un booleen  = faux// si thermos trouve et bon composant
               	
               	clederecherche = hconstruitvalcle(persoens,clecomposant,sansespace(commandetrn.cdcomposant1), ...
               	sansespace(commandetrn.cdcomposant2),sansespace(commandetrn.cdcomposant3))
               	
               	
               	si sansespace(cdnumprod) = "" alors
               		
               		si sansespace(commandetrn.CDCOMPOSANT2) = ""  et SansEspace(commandeTRN.CDCOMPOSANT3) = "" alors
               			Erreur("Inscrivez au moins 2 composantes")
               			reprisesaisie(commandetrn.CDCOMPOSANT1)
               		FIN
               		idthermos est un entier  = GetThermosType(commandetrn.CDCOMPOSANT1,commandeTRN.CDCOMPOSANT2,commandeTRN.CDCOMPOSANT3)
               		si idthermos <> 0 alors
               			hlitrecherche(persoens,PECLEUNIK,idthermos)
               			//			SI commandeTRN.cdnumprod = "" alors //ET premierefois ALORS
               			SELON langueclient
               				CAS 0,1	
               					commandeTRN.CDDESC = persoens.endescription	
               					descriptionoriginale = persoens.endescription
               				CAS 2
               					commandeTRN.CDDESC = persoens.endescriptiona	
               					descriptionoriginale = persoens.endescriptiona
               			FIN
               			commandeTRN.cdnumprod = persoens.ennumero
               			commandeTRN.CDCODEGL = persoens.encodegl
               			//			sinon
               			//			
               			//			FIN
               			
               			pdebase = persoens.epbase
               			//			SI SansEspace(pdebase) = "" ALORS
               			pdebase =  Ouvre("pdebase",pdebase)
               			//			FIN
               			ExécuteTraitement(commandetrn.cdnumprod,trtSortie)
               		sinon
               			SI SansEspace(commandeTRN.CDCOMPOSANT3)= "" ALORS
               				commandeTRN.CDDESC = "Th. Double "
               			SINON
               				commandeTRN.CDDESC = "Th. Triple "
               			FIN
               			commandeTRN.CDDESC += " "+descriptioncourte1+" "+descriptioncourte2+" "+descriptioncourte3	
               			descriptionoriginale = commandeTRN.CDDESC
               			//			SI SansEspace(pdebase) = "" ALORS
               			pdebase =  Ouvre("pdebase",pdebase)
               			//			FIN
               		FIN
               	
               	sinon
               	//	commandeTRN.CDDESC..CouleurFond = Transparent
               	fin
               fin
               
               
               si sansespace(commandetrn.CDCODEGL) = "" alors
               //	commandeTRN.CDCODEGL = config.glventedefaut
               	commandeTRN.CDCODEGL = gclconfig.m_sglventedefaut
               FIN
