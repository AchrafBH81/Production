     -
       internal_properties : CQAAAAkAAACq3mT2JTW1L6jXyrlf+fO4DWLtGz36u0k4aa7JS+5J+isfBeylWhkm4dCETcoCmexMAQYGGLut1WPUtwq+yoeV05AOhT+01fP3z1LIDqTyzsTYpw125BaGiYaODCNkxEzO5A2zsyCqfSU+yJYMDTat0hCvJ6FsBi4UDsxjzMbUqlSDeJJSaGPi
       controls :
        -
          name : BTN_ENSEMBLE
          identifier : 0x514f7ee577d6c77d
          internal_properties : 
