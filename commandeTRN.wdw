           x : 6
           y : 22
           width : 80
           height : 24
          type : 4
          code_elements :
           type_code : 4
           p_codes :
            -
              code : |1-
               
               commandetrn.cdcomposant1=Ouvre("Recherche de produit","","verre")
               commandetrn.CDCOMPOSANT1..MODIFIÉ = VRAI
               si champencours() = "CDCOMPOSANT1" alors
               	envoietouche("{entree}")
               sinon
               	ExécuteTraitement(commandetrn.cdcomposant1,trtsortie)
