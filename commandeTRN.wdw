    name : BtnExpert1
    identifier : 0x2c2a460e33f2b1e2
    internal_properties : 
    properties :
     x : -87
     y : -24
     width : 80
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         
         si ajout ou modif alors
         	acso_message("Info","Cette commande est en cours d'ajout/modification","Info")
         sinon
         	si ModeExpert alors
         		ModeExpert = faux
         		acso_message("Information","Mode normal","Info")
         		LibelléModeExpert..visible = faux
         		onglet1[2]..etat = actif
         		BTN_AJOUT..etat = actif
         		BTN_MODIFIE..etat = actif
         		table.tetat2..visible = faux
         //		table..x = table..XInitial
         //		table..Largeur = table..Largeur-22
         		RequeteTablefacture.fEtat = "B"
         		hexecuterequete(RequeteTablefacture,hModifieFichier)
         		tableaffiche(table,tadebut)
         	sinon
         		ModeExpert = vrai	
         		acso_message("Information","Mode Expert","Info")
                 LibelléModeExpert..visible = vrai
         		onglet1[2]..etat = grise
         		BTN_AJOUT..etat = grise
         		BTN_MODIFIE..etat = grise
         
                 
                 
                 table.tetat2..visible = vrai
         		
         //        table..x = table..XInitial-11
         //        table..Largeur = table..Largeur+22
         		RequeteTablefacture.fEtat = null
         
         		hexecuterequete(RequeteTablefacture,hModifieFichier)
         		tableaffiche(table,taDébut)
         
         		
         	fin
         fin
         
         
         
         
        type : 18
      -
        type : 161
        enabled : false
  -
    name : BTN_REPRISE
    identifier : 0x2c43a4890842acca
    internal_properties : 
    properties :
     x : -97
     y : 23
     width : 80
     height : 24
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         //si ACSO_message("Question","Remettre cette comande active ?","OuiNon") = idyes alors
         //	HLitRecherchePremier(Facture,fanumero,commandetrn.fanumero,HBlocageEcriture+hGénérique)
         //	si HErreurBlocage() alors
         //		erreur("Impossible de modifier cette facture")
         //	sinon
         //		Facture.FPREPARATION = ""
         //		hmodifie(facture)	
         //        HDébloqueNumEnr(facture,hnumenrencours)
         //	FIN
         //FIN
         
         si sansespace(RequeteTablefacture.FPREPARATION) = "T" alors
         	si ACSO_message("Question","Cette commande fait parti du lot # "+RequeteTablefacture.NoLot+rc+"Voulez-vous la réactiver ?","OuiNon") = idyes alors
         		RequeteTablefacture.FPREPARATION = ""
         		hmodifie(RequeteTablefacture,hnumenrencours)	
         		MajLogManuel(requetetablefacture.fanumero,RequeteTablefacture.FPREPARATION)
         		tableaffiche(table,taCourantBandeau)
         		RepriseSaisie(TABLE)
         	FIN
         	
         FIN
         si sansespace(RequeteTablefacture.FPREPARATION) = "F" alors
         	si ACSO_message("Question","Cette commande fait parti du lot # "+RequeteTablefacture.NoLot+" et à été transférée au Vidéojet"+rc+"Voulez-vous la réactiver ?","OuiNon") = idyes alors
         		RequeteTablefacture.FPREPARATION = ""
         		si pas hmodifie(RequeteTablefacture,hNumEnrEnCours)	alors
         			ACSO_message("Erreur","L'erreur suivante est survenue lors de la réactivation de cette commande ("+herreur()+")","Erreur")
         		fin
         		MajLogManuel(requetetablefacture.fanumero,RequeteTablefacture.FPREPARATION)
         		tableaffiche(table,taCourantBandeau)
         		RepriseSaisie(TABLE)
         	FIN
         FIN
         
         si sansespace(RequeteTablefacture.FPREPARATION) = "B" alors
         	si hlitrecherche(hfacture,fanumero,RequeteTablefacture.fanumero) alors
         		si hlitrecherche(BonLivraison,Bnumero,hfacture.bnumero) alors
         			si BonLivraison.Bfacture = 0 alors
         				si ACSO_message("Question","Cette commande fait parti du bon de livraison "+hfacture.bnumero+" mais n'à pas encore été facturée."+rc+... 
         					"Pour la réactiver il est préférable d'aller dans impression de facture et utiliser le bouton de modification de bon de livraison"+rc+"Voulez-vous quand même la réactiver ?","OuiNon") = idyes alors
         					RequeteTablefacture.FPREPARATION = ""
         					hmodifie(RequeteTablefacture,hNumEnrEnCours)	
         					MajLogManuel(requetetablefacture.fanumero,RequeteTablefacture.FPREPARATION)
         					tableaffiche(table,taCourantBandeau)
         					RepriseSaisie(TABLE)
         				FIN
         			sinon
         				si ACSO_message("Question","Cette commande fait parti du bon de livraison "+BonLivraison.bnumero+" et à été facturée sous le numéro."+bonlivraison.Bfacture+rc+... 
         					"Voulez-vous quand même la réactiver ?","OuiNon") = idyes alors
         					RequeteTablefacture.FPREPARATION = ""
         					hmodifie(RequeteTablefacture,hNumEnrEnCours)	
         					MajLogManuel(requetetablefacture.fanumero,RequeteTablefacture.FPREPARATION)
         					tableaffiche(table,taCourantBandeau)
         					RepriseSaisie(TABLE)
         					
         				FIN
         				
         			fin
         		fin
         	sinon
         		si ACSO_message("Question","Cette commande ne fait partie d'aucun bon de livraison et à été marqué comme tel par erreur"+rc+"Voulez-vous la réactiver ?","OuiNon") = idyes alors
         			RequeteTablefacture.FPREPARATION = ""
         			hmodifie(RequeteTablefacture)	
         			MajLogManuel(requetetablefacture.fanumero,RequeteTablefacture.FPREPARATION)
         			tableaffiche(table,taCourantBandeau)
         			RepriseSaisie(TABLE)
         		FIN
         	fin
         FIN
         
         
         sI SansEspace(RequeteTablefacture.FPREPARATION) = "" _et_ pas checkIfTermos(requetetablefacture.fanumero) ALORS
         	si ouinon("Voulez-vous transférer cette commande en bon de livraison ?") alors
         		NoBlCree est une entier  = SendOrderToShippingBill(RequeteTablefacture.fanumero)
         		si NoBlCree <> 0 alors
         			iNFO("Création du Bon de livraison numéro : " + NoBlCree)
         			sablier(vrai)
         			RemplirTableFacture()
         			tableselectplus(TABLE,1)
         			sablier(faux)
         		sinon
         		    Erreur("La création du bon de livraison ne s'est pas effectuée !!!!!")
         		fin
         		
         	fin
         	
         fin
         
         si modeaffichage = "Tableau" alors
         	reprisesaisie(table)
         FIN
         
        type : 18
      -
        type : 161
        enabled : false
