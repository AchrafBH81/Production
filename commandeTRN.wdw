      fdetail.FDPrixExtraFormeModifie		= trdetail.FDPrixExtraFormeModifie
      fdetail.FDPrixExtraDemiModifie		= trdetail.FDPrixExtraDemiModifie
      fdetail.FDPrixCarreauModifie		= trdetail.FDPrixCarreauModifie
