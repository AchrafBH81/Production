  -
    name : BTN_OK
    identifier : 0x514f7ee50538c7a5
    internal_properties : 
    properties :
     x : 49
     y : 5
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         
         numerodefactureentraitement est un entier = 0
         numerolignedetable est un entier
         b_continuer est un booleen = faux
         OngletCarrelage = 1
         lRecordTexte est un chaine
         lpositionfichier est un entier
         lnoprochainid est un entier
         TotalCommandePourLimite est un reel
         
         aveccarrelage=faux
         AvecForme=faux
         AvecProduitSpeciaux=faux
         AvecProduitSpeciauxpartiel = faux
         AvecPinede = faux
         AvecSatine = faux
         avectriple = faux
         AvecultraClair = faux
         gbAvecEnergiverre = faux
         gbAvecTrempe = faux
         gbAvecEnergiverreESC = faux
         EpaisseurVerre = 0
         GNNumberOfThermos  = 0
         //ChamprepriseSaisie  = ""
         CurrentLine est une chaine = TableSauvePositionEtSélection(TABLE)
         CurrentLine1 est une chaine = TableSauvePositionEtSélection(TABLE1)
         
         
         SI commandetrn.fclient = "" alors
         	erreur(<§$0000§>)   //2000:Le numéro de client est obligato...
         	reprisesaisie(commandetrn.fclient)
         FIN
         
         SI commandetrn.fadate = "" alors
         	erreur(<§$0001§>)   //2001:La date est obligatoire
         	reprisesaisie(commandetrn.fadate)
         FIN
         
         SI PAS valideSpacerColorAndDimension() ALORS
         	si ouinon("Les intercalaires doivent être tous de la même couleur/dimension sur une même commande."+rc+"Certaines différences ont été observées."+rc+rc+"Voulez-vous quand même continuer la sauvegarde de la commande ?") = non alors
         		RENVOYER Faux
         	fin
         FIN
         
         
         TaxeTaux1 = 0
         taxetaux2 = 0
         TaxeCalcul2sur1 = faux
         tableautaxe = trouvetauxtaxe(Client.numero,DateValide(commandeTRN.fadate) ? commandeTRN.fadate SINON DateSys(),Client.CLangue)
         SI Dimension(tableautaxe) >= 4 ALORS
         	taxetaux1 = tableautaxe[1,2]
         	taxedesc1 = tableautaxe[1,1]
         FIN
         SI Dimension(tableautaxe) = 8 ALORS
         	taxetaux2 = tableautaxe[2,2]
         	taxedesc2 = tableautaxe[2,1]
         	TaxeCalcul2sur1 = tableautaxe[2,4]
         FIN
         //si pas sansespace(MessageAAfficher) = "" et pas messagetotaldejaaffiche ALORS
         //	ACSO_message("Message",MessageAAfficher,"info")
         //	messagetotaldejaaffiche = vrai
         //FIN
         SI PAS SansEspace(MessageAAfficher) = "" ET PAS messagetotaldejaaffiche ALORS
         	ACSO_message("Message",MessageAAfficher,"info")
         	messagetotaldejaaffiche = Vrai
         	MessageAAfficher = ""
         	si ChamprepriseSaisie <> "Aucun" et pas ChamprepriseSaisie = "" alors reprisesaisie(ChamprepriseSaisie)
         FIN
         
         si ajout alors
         	hraz(facture)
         	ecranversfichier(commandetrn,facture)
         	
         	facture.futilise = faux
         	si pas commandetrn.fanumero = 0 alors
         		Facture.fatransportouinon = chargetrsp	
         		selon commandetrn.COMMANDECREDIT 
         			cas 2 
         				
         				facture.FPREPARATION = "F"
         			cas 3 
         				facture.commentaire=ouvre(fcommentaire)
         		fin
         		facture.FPREPARATION = ""
         		facture.livrepartiel = ""
         		//		facture.fatps = config.tauxtps
         		//		facture.fatvq = config.tauxtvq
         		Facture.fatps = TaxeTaux1
         		Facture.fatvq = TaxeTaux2
         		Facture.fCombineTaxe = TaxeCalcul2sur1
         		//		si dimension(tableautaxe) >= 4 alors
         		//			facture.fatps = val(tableautaxe[1,2])
         		//		fin
         		//		si dimension(tableautaxe) = 8 alors
         		//			facture.fatvq = val(tableautaxe[2,2])
         		//			facture.fCombineTaxe = val(tableautaxe[2,4])
         		//		fin
         		facture.IDClient = commandetrn.cidclient
         		facture.nom = commandeTRN.nom
         		facture.adresse = commandeTRN.adresse
         		facture.ville = commandeTRN.villeProv
         		facture.CodePostal = commandeTRN.CodePostal
         		facture.noTelephone = commandeTRN.NoTelephone
         		facture.messagedejaafiche = messagetotaldejaaffiche
         		facture.lnote = sai_note_livraison
         		facture.Computername = NetNomMachine()
         		facture.username = gsuser
         		si client.cconfirmation <= 1 alors 
         			Facture.ConfirmationSended = vrai
         			
         		sinon
         			facture.ConfirmationSended = faux
         		FIN
         		Facture.CreatedTime = HeureSys()
         		facture.isedi=Faux
         		facture.NewEdiOrder = faux
         		facture.IdEdiKey = ""
         		
         		hajoute(Facture)
         		
         		
         	sinon
         		//reprisesaisie
         	fin
         	
         	
         	
         	si HErreurDoublon() alors
         		si herreur() = "70010" alors
         			si acso_message("Erreur","Une erreur d'intégrité est survenue lors de l'ajout de cette commande"+RC+"Pour corriger cette erreur , assurez-vous d'être le seul poste actif en prise de commande"+RC+...
         				"avant de continuer"+RC+"Si vous décidez de ne pas continuer avec cette commande, elle sera perdue"+RC+RC+"Continuer (O/N) ?","OuiNon") = idyes alors
         				selon HErreurInfo(hErrRubrique)
         					cas "fanumero"
         						acso_message("Erreur","Erreur sur numéro de commande "+facture.fanumero,"Erreur")
         						goto SortieSurErreur
         						
         					cas "FACLEUNIK"
         						lRecordTexte = HRécupèreEnregistrement(facture)
         						lpositionfichier = hsauveposition("Facture")
         						HlitDernier(facture,FACLEUNIK)
         						lnoprochainid = facture.FACLEUNIK+1
         						HRetourPosition(lpositionfichier)
         						RecupereFacture(lRecordTexte)
         						facture.FACLEUNIK = lnoprochainid
         						Facture.Computername = NetNomMachine()
         						Facture.Username = gsUser
         						Facture.CreatedTime = HeureSys()
         						hajoute(facture,hFixeIdAuto)
         						
         				FIN
         			sinon
         				goto SortieSurErreur
         			fin
         		FIN
         	FIN
         	
         sinon
         	hlit("Facture",numenramodifier,HBlocageEcriture)
         	
         	selon commandetrn.COMMANDECREDIT 
         		cas 2 
         			facture.FPREPARATION = "F"
         		cas 3 
         			facture.commentaire=ouvre(fcommentaire,facture.commentaire)
         	fin
         	ecranversfichier("commandetrn","facture")
         	
         	FACTURE.FASECTEUR = COMBO_SECTEUR[COMBO_SECTEUR]
         	facture.futilise = faux
         	//	facture.fatps = config.tauxtps
         	//	facture.fatvq = config.tauxtvq
         	facture.fatps = TaxeTaux1
         	facture.fatvq = taxetaux2
         	facture.fCombineTaxe = TaxeCalcul2sur1
         	facture.nom = commandeTRN.nom
         	facture.adresse = commandeTRN.adresse
         	facture.ville = commandeTRN.villeProv
         	facture.CodePostal = commandeTRN.CodePostal
         	facture.noTelephone = commandeTRN.NoTelephone
         	Facture.IDClient = commandeTRN.cidclient
         	facture.messagedejaafiche = messagetotaldejaaffiche		
         	facture.lnote = sai_note_livraison
         	hmodifie(Facture,hNumEnrEnCours)	
         	numerodefactureentraitement = commandetrn.fanumero
         	hdebloquenumenr("Facture",numenramodifier)
         FIN
         hdesactivefiltre("trdetail")
         
         si pas commandetrn.fanumero = 0 alors
         	miseajourfacture()
         	facture.AvecCarrelage = AvecCarrelage
         	facture.AvecForme = avecforme
         	facture.AvecProduitSpeciaux = AvecProduitSpeciaux
         	facture.EpaisseurVerre = EpaisseurVerre
         	facture.AvecPinede = AvecPinede
         	facture.AvecSatine = AvecSatine
         	facture.AvecUltraClair = AvecUltraClair
         	facture.AvecEnergiverre = gbAvecEnergiverre
         	facture.AvecEnergiverreESC = gbAvecEnergiverreESC
         
         	facture.Avectrempe = gbAvecTrempe
         	
         	facture.avectriple = avectriple
         	facture.NumberOfThermosToProduce = gnNumberOfThermos
         	HModifie(Facture,hNumEnrEnCours)	
         	
         fin
         
         
         si commandetrn.COMMANDECREDIT <> 3 _et_ client.limiteCredit > 0 alors
         	TotalCommandePourLimite = calculTotalCommandeAvecTaxe(commandetrn.fanumero) - TotalCommandeAvantModif
         	client.TotalCommande += TotalCommandePourLimite
         	client.SoldeDisponible -= TotalCommandePourLimite
         	hmodifie(Client,hNumEnrEnCours)
         FIN
         
         si facture.fatypedocument = 1 alors
         	SI MODIF ALORS
         		//		SI AvecForme _OU_  Aveccarrelage ALORS
         		si acso_message("Question","Voulez-vous réimprimer la confirmation ?","OuiNon") = idyes alors
         			iconfigure(sansespace(imprimanteconfirmation),vrai)
         			iParamètre("DEFAUT=NON")
         			iParamètre("FORMATPAPIER=LETTRE")
         			iParamètre("QUALITE=MOYENNE")
         			iParamètre("ORIENTATION=PORTRAIT")
         			
         			HExécuteRequête(RequetefeuilleLivraison,hRequêteDéfaut,facture.fanumero)
         			
         			gtabShape  = FillTabShape()
         			 
         			
         //			iImprimeEtat(ConfirmationTRNmat,faux,0,faux)
         			iEnchaînementAjoute(ConfirmationTRNmat,faux,0,faux)
         			si gtabShape..occurrence <> 0 alors iEnchaînementAjoute(ConfirmationTRNShape,gtabShape,numeriqueverschaine(facture.fanumero))
         			iEnchaînementImprime()
         		FIN
         		//		fin
         	SINON
         		//		si AvecForme _OU_  Aveccarrelage ou AvecProduitSpeciauxPartiel alors
         		//			iconfigure(sansespace(imprimanteconfirmation),vrai)
         		//			iParamètre("DEFAUT=NON")
         		//			iParamètre("FORMATPAPIER=LETTRE")
         		//			iParamètre("QUALITE=MOYENNE")
         		//			iParamètre("ORIENTATION=PORTRAIT")
         		//			
         		//			//iParamètre("QUALITE=HAUTE")
         		//			HExécuteRequête(RequetefeuilleLivraison,hRequêteDéfaut,facture.fanumero)
         		//			iImprimeEtat(ConfirmationTRNmat,faux,0,faux)
         		//			iParamètre("QUALITE=MOYENNE")
         		//		fin
         		
         		si AvecProduitSpeciauxPartiel ou AvecForme ou facture.fpeinture > 0 alors
         			iconfigure(sansespace(imprimanteconfirmation),vrai)
         			iParamètre("DEFAUT=NON")
         			iParamètre("FORMATPAPIER=LETTRE")
         			iParamètre("QUALITE=MOYENNE")
         			iParamètre("ORIENTATION=PORTRAIT")
         			
         			//iParamètre("QUALITE=HAUTE")
         			HExécuteRequête(RequetefeuilleLivraison,hRequêteDéfaut,facture.fanumero)
         			gtabShape  = FillTabShape()
         			
         			
         			//			iImprimeEtat(ConfirmationTRNmat,faux,0,faux)
         			iEnchaînementAjoute(ConfirmationTRNmat,Faux,0,Faux)
         			SI gtabShape..Occurrence <> 0 ALORS iEnchaînementAjoute(ConfirmationTRNShape,gtabShape,NumériqueVersChaîne(Facture.fanumero))
         			iEnchaînementImprime()
         			
         //			
         //			iImprimeEtat(ConfirmationTRNmat,faux,0,faux)
         //			iapercu()
         //			iImprimeEtat(ConfirmationTRNShape)
         			iParamètre("QUALITE=MOYENNE")
         		fin
         		multitache(50)
         		
         		
         		sablier(vrai)
         		iParamètre("DEFAUT=NON")
         		iParamètre("FORMATPAPIER=LETTRE")
         		iDestination(iPDFGénérique,ComplèteRep(repdonnees)+"PDF\"+SansEspace(Client.numero)+"\Confirmation\Conf"+facture.fanumero+".pdf")
         		OuvreSoeur(FenAttentePetite,"Préparation du fichier conf"+facture.fanumero+" en cours...")
         		HExécuteRequête(RequetefeuilleLivraison,hRequêteDéfaut,facture.fanumero)
         		iImprimeEtat(ConfirmationTRN)
         		ferme(FenAttentePetite)
         		sablier(faux)
         		
         	FIN
         	si gImpressionFeuilleTravail = 2 et facture.fatypedocument = 1 alors
         		si modif alors
         			si acso_message("Question","Voulez-vous réimprimer les feuilles de travail ?","OuiNon") = idyes alors
         				requeteDétailCommandeTous.pNoComm = facture.fanumero
         				requeteDétailCommandeTous.pFdType = 1
         				requetedetailcommandetous.pNoLigne = null
         				requetedetailcommandetous.pQte = 0
         				requeteDétailCommandeTous.pTypePeinture = null
         				HExécuteRequête(requeteDétailCommandeTous)
         				
         				iconfigure(sansespace(imprimanteftravail),vrai)
         				iParamètre("DEFAUT=NON")
         				iParamètre("FORMATPAPIER=LETTRE")
         				iParamètre("QUALITE=MOYENNE")
         				iimprimeetat(EfeuilleTravail,"Tout",requeteDétailCommandeTous.fnolot)
         				
         			fin
         		sinon
         			//			requeteDétailCommandeTous.pNoComm = facture.fanumero
         			//			requeteDétailCommandeTous.pFdType = 1
         			//			requetedetailcommandetous.pNoLigne = null
         			//			requetedetailcommandetous.pQte = 0
         			//			requeteDétailCommandeTous.pTypePeinture = null
         			//			HExécuteRequête(requeteDétailCommandeTous)
         			//			
         			//			iconfigure(sansespace(imprimanteftravail),vrai)
         			//			iParamètre("DEFAUT=NON")
         			//			iParamètre("FORMATPAPIER=LETTRE")
         			//			iParamètre("QUALITE=MOYENNE")
         			
         			//	iParamètre("QUALITE=HAUTE")
         			
         			//			iimprimeetat(EfeuilleTravail,"Commande")
         			
         		fin
         	fin
         fin
         
         si chargetrsp alors
         	
         	Facture.fatransportouinon = vrai
         	Facture.fafraistransport = fraistrsp(totaldelacommande)
         	hmodifie(Facture,hNumEnrEnCours)
         sinon
         	Facture.fatransportouinon = faux
         	Facture.fafraistransport = 0
         	hmodifie(Facture,hNumEnrEnCours)
         	
         fin
         
         hactivefiltre("trdetail")
         //htransactionfin()
         
         majtracking(Facture.fanumero,Facture.Computername,Facture.IsEDI)
         
         si ajout alors
         	//	majtracking(Facture.fanumero,Facture.Computername,faux)
         	
         	messagelignedejaaffiche = ValideAlerte(2,messagelignedejaaffiche)
         	facture.messagedejaafiche = messagelignedejaaffiche
         	si MessageAAfficher <> "" alors 		ACSO_message("Information",MessageAAfficher,"Info")
         	
         	suppressActiveTempoOrder(commandetrn.fanocommande)
         	ouvre(wnumerodefacture,commandetrn.fanumero)
         	
         	//		SI OuiNon("Voulez-vous visualiser la confirmation de commande ?") ALORS
         	nNoFacture est un entier sur 4 octet = facture.fanumero
         	//	iFenêtreAbandon(Faux)
         	//	OuvreSoeur(FenAttentePetite,"Impression de la confirmation "+commandetrn.fanumero+" en cours...")
         	//	iConfigure(imprimanteconfirmation)
         	//	iParamètre("DEFAUT=NON")
         	//	iParamètre("ORIENTATION=PAYSAGE")
         	//	
         	//	HExécuteRequête(RequetefeuilleLivraison,hRequêteDéfaut,Facture.fanumero)
         	//	iParamètreAperçu(iVoletMiniatures,Faux)
         	//	iAperçu(100)
         	//	iImprimeEtat(ConfirmationTRN)
         	//	Ferme(FenAttentePetite)
         	MultitâcheRepeint(commandeTRN)
         	
         	//		FIN
         	
         	
         	selon commandetrn.COMMANDECREDIT
         		cas 2
         			ouvre(TransfertCredit,hnumenr(facture))
         		cas 3		
         			OuvreSoeur(FenAttentePetite,"Préparation du fichier PDF Soum"+RequeteTableSoumission.fanumero+" en cours...")
         			HExécuteRequête(RequeteSoumission,hRequêteDéfaut,commandetrn.fanumero)
         			Sablier(Vrai)
         			iConfigure(SansEspace(imprimantefacture),Vrai)
         			iParamètre("DEFAUT=NON")
         			iParamètre("FORMATPAPIER=LETTRE")
         			iDestination(iPDFGénérique,ComplèteRep(repdonnees)+"PDF\"+SansEspace(Client.numero)+"\Soumission\Soum"+facture.fanumero+".pdf")
         			iImprimeEtat(SoumissionTRN)
         			FenAttentePetite.libelle1="Préparation du fichier PDF Soum"+RequeteTableSoumission.fanumero+" en cours..."
         			Ferme(FenAttentePetite)//			si acso_message("Question","Voulez-vous imprimer cette soumission ?","OuiNon") = idyes alors
         			
         			
         			//			
         			//			
         			//			HExécuteRequête(RequeteSoumission,hRequêteDéfaut,commandetrn.fanumero)
         			//			//				iAperçu(i100, "Aperçu écran", Vrai)
         			//			iconfigure(sansespace(imprimantefacture),vrai)
         			//			iParamètre("DEFAUT=NON")
         			//			iParamètre("ORIENTATION=PAYSAGE")
         			//			iimprimeetat(Soumissiontrn)
         			//		FIN
         			onglet1 = 2
         	fin
         	navigation..etat = grisé; navigation..Visible=Vrai
         	fleche..etat = actif
         	//tableaffiche("TABLE")
         	ladate = commandetrn.fadate
         	leclient = commandetrn.fclient
         	commandetrn.commandecredit = 1
         	
         	execute("commandetrn.commandecredit..mod")
         	commandetrn.btn_ok..etat = grise
         	RemplirTableFacture()
         	numerolignedetable = tablecherche(fanumero_1,commandetrn.fanumero)
         	si numerolignedetable <> -1 alors
         		tableselectplus(table,numerolignedetable)
         	fin
         	RemplirTablesoumission()
         	MessageAAfficher = ""
         	//	TableRestaurePositionEtSélection(TABLE,CurrentLine)
         	//	tableaffiche(table,taCourantpremier)
         	//	HExécuteRequête(RequeteTableSoumission)
         	//	TableRestaurePositionEtSélection(TABLE1,CurrentLine1)
         	//	tableaffiche(table1,taCourantpremier)
         	ExécuteTraitement(BtnVisuConfirmation,trtclic)
         	ExecuteTraitement("btn_ajout",TRTclic)	
         sinon
         	selon commandetrn.COMMANDECREDIT
         		cas 2
         			ouvre(TransfertCredit,hnumenr(facture))
         		cas  3 
         			si acso_message("Question","Voulez-vous transformer cette soumission en commande ?","OuiNon") = idyes alors
         				si pas IsvalidQuotation() alors
         					Erreur("Un ou plusieurs fini/type d'intercalaire ne sont pas inscrit sur cette soumission"+rc+"Faire la correction avant de la transformer en commande")
         					Onglet1 = 2
         					table1..etat = actif
         					
         				sinon
         					CreateNewOrder(facture.fanumero)
         					facture.fatypedocument = 1
         					facture.ConfirmationSended = faux
         					pour tout fdetail avec "fdnocomm = " +facture.fanumero
         						fdetail.FDprixmodifie = Vrai
         						fdetail.FDPrixExtraFormeModifie = vrai
         						fdetail.FDPrixCarreauModifie = Vrai
         						fdetail.FDPrixExtraDemiModifie = Vrai
         						fdetail.FDPrixBaseModifie = Vrai
         						hmodifie(fdetail,hnumenrencours)
         						
         						
         					FIN
         					
         					hmodifie(facture,hnumenrencours)
         					
         					si checkIfPrintSpecialReport(facture.fanumero) alors
         						iConfigure(SansEspace(imprimanteconfirmation),Vrai)
         						iParamètre("DEFAUT=NON")
         						iParamètre("FORMATPAPIER=LETTRE")
         						iParamètre("QUALITE=MOYENNE")
         						iParamètre("ORIENTATION=PORTRAIT")
         						
         						//iParamètre("QUALITE=HAUTE")
         						HExécuteRequête(RequetefeuilleLivraison,hRequêteDéfaut,Facture.fanumero)
         						gtabShape  = FillTabShape()
         						
         						
         						//			iImprimeEtat(ConfirmationTRNmat,faux,0,faux)
         						iEnchaînementAjoute(ConfirmationTRNmat,Faux,0,Faux)
         						SI gtabShape..Occurrence <> 0 ALORS iEnchaînementAjoute(ConfirmationTRNShape,gtabShape,NumériqueVersChaîne(Facture.fanumero))
         						iEnchaînementImprime()
         						
         					FIN
         					
         					
         					
         					
         					majtracking(Facture.fanumero,Facture.Computername,faux)
         					
         					CurrentInvoice est une chaine = facture.fanumero
         					
         					RemplirTableFacture()
         					RemplirTableSoumission()
         					_result est un entier = tablecherche("fanumero_1",CurrentInvoice,rechercheIdentique)
         					
         					si _result <> -1 alors
         						tableselectplus("TABLE",_result)
         						
         					sinon
         						tableaffiche(table,taCourantPremier)
         					    ExécuteTraitement(table,trtselection)
         					fin
         					
         					HExécuteRequête(RequeteTableSoumission,hModifieFichier)
         					
         					//tableaffiche(table1,taCourantPremier)
         					//					TableRestaurePositionEtSélection(TABLE1,CurrentLine1)
         					onglet1 = 1
         					mafenetre..plan = 1
         					TABLE1..Etat = Actif
         					ExécuteTraitement(BtnVisuConfirmation,trtClic)
         				fin
         			sinon
         				si acso_message("Question","Voulez-vous réimprimer cette soumission ?","OuiNon") = idyes alors
         					HExécuteRequête(RequeteSoumission,hRequêteDéfaut,commandetrn.fanumero)
         					iconfigure(sansespace(imprimantefacture),vrai)
         					iParamètre("DEFAUT=NON")
         					iParamètre("ORIENTATION=PAYSAGE")
         					//iAperçu(i100, "Aperçu écran", Vrai)
         					iimprimeetat(Soumissiontrn)
         				FIN
         			fin
         	fin
         	selon onglet1
         		cas 1
         			RemplirTableFacture()
         			si numerodefactureentraitement <> 0 alors
         				numerolignedetable = tablecherche(fanumero_1,numerodefactureentraitement)
         				si numerolignedetable <> -1 alors
         					tableselectplus(table,numerolignedetable)
         				fin
         			fin				
         			table..etat = AffichageSeulement
         		cas 2
         			RemplirTableSoumission()
         			
         			si numerodefactureentraitement <> 0 alors
         				numerolignedetable = tablecherche(table1.FANUMERO_11,numerodefactureentraitement)
         				si numerolignedetable <> -1 alors
         					tableselectplus(table1,numerolignedetable)
         				fin
         				table1..etat = AffichageSeulement
         			fin				
         			
         			
         	FIN
         	SortieSurErreur:
         	si dmodif alors
         		si onglet1=1 alors
         			//tableaffiche(table,taCourantpremier)
         			TableRestaurePositionEtSélection(TABLE,CurrentLine)
         			executetraitement(table,trtSélection)
         			taille_originale_table1()
         		sinon
         			TableRestaurePositionEtSélection(TABLE1,CurrentLine1)
         			//		tableaffiche(table1,taCourantpremier)
         			executetraitement(table1,trtSélection)
         			taille_originale_table1()
         		fin
         	fin
         	decko..etat = AffichageSeulement; decko..Visible=Vrai
         	fiche..etat = actif; fiche..Visible=Vrai
         	navigation..etat = actif; navigation..Visible=Vrai
         	validation..etat = grisé; validation..Visible=Vrai
         	commandetrn.fclient..etat = AffichageSeulement
         	commandetrn.commandecredit..etat = AffichageSeulement
         	commandetrn.reference..VISIBLE = FAUX
         	fiche_det..etat = grisé; fiche_det..Visible=Vrai
         	commandetrn.entete..etat = AffichageSeulement
         	commandetrn.table..etat = AffichageSeulement
         	ajout = faux
         	modif = faux
         	commande_statut..largeur = 85
         	commande_statut..x = COMMANDE_STATUT..XInitial
         	commande_statut..libelle = "Lecture"
         	commandetrn.btn_ok..etat = grise
         	//BtnChangeMesure..ETAT = INACTIF
         	GrpClientComptant..etat = inactif
         	GrpLivraison..Etat = AffichageSeulement
         	MessageAAfficher = ""
             suppressActiveTempoOrder(fanocommande)
         	
         	reprisesaisie(btn_ajout)
         fin
         
        type : 18
      -
        type : 161
        enabled : false
  -
    name : FDATEREQUISE
    identifier : 0x514f7ee57dc3c7b9
    internal_properties : 
    properties :
     x : 545
     y : 90
     width : 172
     height : 24
    calendar :
     internal_properties : 
     properties :
      width : 300
      height : 300
     type : 47
    type : 2
    code_elements :
     type_code : 3
     p_codes :
      -
        code : |1+
         
         //ValideCredit()
         //executetraitement(BtnCalendrierLivraison,trtClic)
        type : 15
      -
        code : |1+
         
         si fdaterequise <> "" alors //_et_ moimeme..modifie alors
         GetJoursLivraisonClient(Client.IDClient,Combo_Livraison1)
         	idencours est un entier
         	ladate est une date  = fdaterequise
         	si commandecredit = 1 ou commandecredit = 3 ALORS
         		SI EstJourFerie(ladate) 
         			Erreur("Cette date est un jour férié !") 
         			FDATEREQUISE = ""
         			Combo_camion = -1
         			RepriseSaisie(FDATEREQUISE)
         			
         		FIN
         		idencours = GetIdSaison(ladate,GtabSaison)
         		si idencours<=0 alors
         			Erreur("Impossible de relier la date requise avec une période de livraison !!!") 
         			FDATEREQUISE = ""
         			Combo_camion = -1
         			RepriseSaisie(FDATEREQUISE)
         			
         		FIN
         		SI gJoursLivraisonClient[GtabSaison[idencours].IdSaison][DateVersJour(FDATEREQUISE)].jourlivraison = 2 ALORS
         			erreur("Cette date n'est pas une journée de livraison autorisée !!!") 
         				FDATEREQUISE = ""
         				Combo_camion = -1
         				RepriseSaisie(FDATEREQUISE)
         
         			
         		FIN	
         		
         		si ValeurJourLivraisonClient<>0 et fdaterequise <> "" alors
         			SI idencours <> 0 _ET_ PAS gJoursLivraisonClient[GtabSaison[idencours].IdSaison]..Vide alors
         
         				SI tafrequence[GtabSaison[idencours].IdSaison].Frequence > 1 ALORS
         					SI modulo(DateDifférence(PremierJourDeLaSemaine(tafrequence[GtabSaison[idencours].IdSaison].DateDeReference),PremierJourDeLaSemaine(ladate)),tafrequence[GtabSaison[idencours].IdSaison].Frequence*7) <> 0
         						SI OuiNon(0,"Cette date n'est pas une journée de livraison pour ce client"+RC+"Continuer avec cette date ?") = Non ALORS
         							FDATEREQUISE = ""
         							Combo_camion = -1
         							RepriseSaisie(FDATEREQUISE)
         						fin
         					FIN
         				FIN
         				
         				
         				
         				
         				
         				si gJoursLivraisonClient[GtabSaison[idencours].IdSaison][DateVersJour(fdaterequise)].jourlivraison = 0 alors
         					si ouinon(0,"Cette date n'est pas une journée de livraison pour ce client"+rc+"Continuer avec cette date ?") = non alors
         						fdaterequise = ""
         						Combo_camion = -1
         						RepriseSaisie(FDATEREQUISE)
         					fin
         					
         				fin	
         			fin
         		fin
         		
         		
         		SI pas gtabsaison..vide _ET_ FDATEREQUISE <> ""  ALORS
         			
         			SI idencours <> 0 ALORS
         				SI GtabSaison[idencours].JourLivraison[DateVersJour(FDATEREQUISE)] = 2 ALORS
         					Erreur("Cette date n'est pas un jour de livraison pour la compagnie")
         					RepriseSaisie(FDATEREQUISE)
         				fin		
         			fin	
         		FIN
         		
         		
         		
         		
         		si pas moimeme = "" alors
         			si moimeme < commandetrn.fadate alors
         				acso_message("Erreur","La date requise ne peut pas être inférieure à la date de la commande","Erreur")
         				
         				fdaterequise = ""
         				reprisesaisie(FDATEREQUISE)
         			FIN
         		FIN
         	fin
         	combo_camion = 	pas gJoursLivraisonClient[GtabSaison[idencours].IdSaison]..vide ? gJoursLivraisonClient[GtabSaison[idencours].IdSaison][DateVersJour(FDATEREQUISE)].camion sinon -1
         	si combo_camion <= 0 alors 
         		combo_camion = getdefaultcamion(Combo_Livraison1)
         	FIN
         	
         	SI  ajout _OU_ modif ALORS RepriseSaisie(Combo_camion)
         fin
         si pas ajout et pas modif alors
         	//	info("En modification hors ligne")
         	facture.FDATEREQUISE = commandetrn.FDATEREQUISE
         	facture.IDCamions = combo_camion
         	HModifie(Facture,hNumEnrEnCours)
         //	PrintDocument()
         	requetetablefacture.FDATEREQUISE = commandeTRN.FDATEREQUISE
         	currentinvoice = table.FANUMERO_1
         	
         	tableaffiche(TABLE,tainit)
         	TableRestaurePositionEtSélection(TABLE)
         	nres est un entier = tablecherche(FANUMERO_1,currentinvoice,rechercheIdentique)
         	si nres <> -1 alors
         		TableSelectPlus(TABLE,nres)
         	FIN
         	executetraitement(TABLE,trtSélection)
         FIN
         
         
