     type : 458752
   -
     name : recalculenergie
     internal_properties : CQAAAAkAAAAETzEdwRNMKZCPH5biRPuGIhjJRSEy3U5JTZLOlnghFVmFZRAIgAj/DndRQNodyJtsm+0/ZceFTWe1eMnQaGiLmgPfLUoNfKg7ZDSdjQfgE4hHDRZHlxXQX2O7phicXMgmI90vZoTwQshKoz41fdqz8xIKS6ylpZC1pX+bK8EWsw4U
     procedure_id : 5859041163697375041
     type_code : 14
     code : |1-
      // Traitement automatique des exceptions :   exécuter le bloc de code CAS EXCEPTION:
      //
      procedure recalculenergie(lnumerodecommande)
      surchbase est un reel
      surchverreunite est un reel
      surchcarrelage est un reel
      surchforme est un reel
      
      
      //XPOSITION EST UN ENTIER = HSAUVEPOSITION("trdetail")
      //SI MODIF ALORS
      //si pas facture.FPREPARATION  ="B"  alors
      //	SI  Facture.FPREPARATION  ="B"  ALORS
      	//	SI Facture.FSURCHARGEENERGIE ET config.surchargeactive ALORS
      	SI Facture.FSURCHARGEENERGIE ET gclconfig.m_nsurchargeactive ALORS
      		si hlitrecherche(client,numero,Facture.faclient) alors
      			si client.surcharge alors
      				si client.csurchargebase <> 0.00 alors
      					surchbase = client.csurchargebase
      				sinon
      					//					surchbase = config.surchargebase
      					surchbase = gclconfig.m_rsurchargebase
      				FIN
      			sinon
      				surchbase = 0
      			fin
      			
      			si client.surchargeverreunite alors
      				si client.csurchargeverreunite <> 0.00 alors
      					surchverreunite = client.csurchargeverreunite
      				sinon
      					//					surchverreunite = config.surchargeverreunite
      					surchverreunite = gclconfig.m_rsurchargeverreunite
      				FIN
      			sinon
      				surchverreunite = 0
      			fin
      			
      			
      			si client.SUrchargecarrelage alors
      				si client.Csurchargecarrelage <> 0.00 alors
      					surchcarrelage = client.Csurchargecarrelage
      				sinon
      					//					surchcarrelage = config.SUrchargecarrelage
      					surchcarrelage = gclconfig.m_rSUrchargecarrelage
      				FIN
      			sinon
      				surchcarrelage = 0
      			fin
      			
      			si client.SUrchargeforme alors
      				si client.Csurchargeforme <> 0.00 alors
      					surchforme = client.Csurchargeforme
      				sinon
      					//					surchforme = config.SUrchargeforme
      					surchforme = gclconfig.m_nSUrchargeforme
      				FIN
      			sinon
      				surchforme = 0
      			fin
      			
      			
      			
      			
      			
      		sinon
      			//				surchbase = config.surchargebase
      			//				surchverreunite = config.surchargeverreunite
      			//				surchcarrelage = config.SUrchargecarrelage
      			//				surchforme = config.SUrchargeforme
      			surchbase = gclconfig.m_rsurchargebase
      			surchverreunite = gclconfig.m_rsurchargeverreunite
      			surchcarrelage = gclconfig.m_rSUrchargecarrelage
      			surchforme = gclconfig.m_nSUrchargeforme
      		fin	
      		
      		
      		hlitrecherche("fdetail","fdnocomm",lnumerodecommande)
      		//Code WinDev 5.5 remplacé par la migration :
      		//	tantque fdetail.fdnocomm = lnumerodecommande  et pas h.endehors
      		fdetail.surchargeenergie = 0
      		tantque fdetail.fdnocomm = lnumerodecommande  et pas HEnDehors()
      			Fdetail.surchargeenergie = 0
      			
      			si Facture.FSURCHARGEENERGIE et pas fdetail.fdintercalaire alors
      				si  fdetail.ftype =1 	alors
      					si pas fdetail.fdverreunite alors
      						fdetail.surchargeenergie = (fdetail.fdprixu+fdetail.FDextra10X+fdetail.FDextra5x) * fdetail.fdqte * surchbase / 100 //+ ...
      						fdetail.surchargeenergie += fdetail.fdextraforme * fdetail.fdqte * surchforme / 100 //+ ...
      						fdetail.surchargeenergie += fdetail.fdcarrprixtotal  * surchcarrelage / 100 //+ ...
      					sinon
      						Fdetail.surchargeenergie += Fdetail.fdprixu * Fdetail.fdqte  * surchverreunite / 100
      					fin
      					
      					//					fdetail.surchargeenergie = fdetail.fdprixtotal * surchbase / 100 //+ ...
      				sinon si fdetail.ftype = 4
      					
      				fin
      				
      				si fdetail.fdverreunite alors
      				fin
      				
      			sinon
      				
      				fdetail.surchargeenergie = 0
      			FIN
      			fdetail.SUrchargeafacturer = fdetail.surchargeenergie
      			hmodifie("fdetail")
      			HLITSUIVANT("fdetail","fdnocomm")
      			
      		fin	
      		
      		si Facture.FPREPARATION  ="F"  alors
      			HLitRecherche(hfdetail,fdnocomm,lnumerodecommande)
      			//Code WinDev 5.5 remplacé par la migration :
      			//	tantque fdetail.fdnocomm = lnumerodecommande  et pas h.endehors
      			hFdetail.surchargeenergie = 0
      			TANTQUE hFdetail.fdnocomm = lnumerodecommande  ET PAS HEnDehors()
      				hFdetail.surchargeenergie = 0
      				
      				SI Facture.FSURCHARGEENERGIE ET PAS Fdetail.fdintercalaire ALORS
      					SI  hFdetail.ftype =1 	ALORS
      						SI PAS hFdetail.fdverreunite ALORS
      							hFdetail.surchargeenergie = (hFdetail.fdprixu+hFdetail.FDextra10X+hFdetail.FDextra5x) * hFdetail.fdqteafacturer * surchbase / 100 //+ ...
      							hFdetail.surchargeenergie += hFdetail.fdextraforme * hFdetail.fdqteafacturer * surchforme / 100 //+ ...
      							hFdetail.surchargeenergie += hFdetail.fdcarrprixtotal  * surchcarrelage / 100 //+ ...
      						SINON
      							hFdetail.surchargeenergie += hFdetail.fdprixu * hFdetail.fdqteafacturer  * surchverreunite / 100
      						FIN
      						
      						//					fdetail.surchargeenergie = fdetail.fdprixtotal * surchbase / 100 //+ ...
      						
      					FIN
      					
      					SI Fdetail.fdverreunite ALORS
      					FIN
      					
      				SINON
      					
      					hFdetail.surchargeenergie = 0
      				FIN
      				hFdetail.SUrchargeafacturer = hFdetail.surchargeenergie
      				HModifie(hfdetail)
      				HLitSuivant(hfdetail,fdnocomm)
      				
      				
      			FIN
      			
      //		sinon
      //			hfdetail.surchargeenergie = 0.00 
      //			hmodifie(hfdetail,hNumEnrEnCours)
      		fin	
      		
      		
      	fin
      //fin
      CAS EXCEPTION:
      	info(exceptioninfo(errComplet))
      	
     type : 458752
   -
     name : recupere_donnee
     procedure_id : 5859041164369577793
     type_code : 14
     code : |1+
      Procédure recupere_donnee()
      
        
        si trdetail.fdlien = tligne alors
      	indice = table_1
        sinon
      	indice = table_1 - 1
        FIN
      tableselectplus("TABLE_1",indice)
      cdnumprod    = fdnumprod
      si hlitrecherche(persoens,ennumero,fdnumprod) alors
      	lPasCalcul5X10X = persoens.enpas5X10X
      sinon
      	lPasCalcul5X10X = faux
      FIN
      cddesc       = fddesc
      cdcomposant1 = fdcomposant1
      cdcomposant2 = fdcomposant2
      cdcomposant3 = fdcomposant3
      cdqte        = fdqte
      cdcapgaztube = trdetail.fcapgaztube
      cdprixu      = fdprixu
      cdforme99    = fdforme99
      fichierversecran("commandetrn","trdetail")
      
      //si commandetrn.facalcul = 2 alors
       cdlargeur    = trdetail.fdlargeur
       cdhauteur    = trdetail.fdhauteur
       cdhauteur1   = trdetail.fdhauteur1
      
      //sinon
      // cdlargeur    = trdetail.fdlargeura
      // cdhauteur    = trdetail.fdhauteura
      // cdhauteur1   = trdetail.fdhauteur1a
      
      //fin
      tableselectplus("TABLE_1",indice+1)
      numeroligne = tligne
      numeroenr = tablenumenr("TABLE_1")
      cdnumcarr    = fdnumprod
      cdcarreauh   = fdcarreauh
      cdcarreauv   = fdcarreauv
      //NOMBRE_DE_CARREAU = CDCARREAUH * CDCARREAUV
      NOMBRE_DE_CARREAU = trdetail.fdnbcarreau
      cdcarrprixu  = trdetail.frcarrprixu
      cdcarrprixtotal = trdetail.fdcarrprixtotal 
      cdcodeglcarr    = trdetail.fdcodegl
      typecalcul     = TRDETAIL.fdtypecalcul
      
      
      si hlitrecherche(persoens,ennumero,fdnumprod) alors
      	lPasCalcul5X10X = persoens.enpas5X10X
      FIN
      
      //FDVARIABLEX   = TRDETAIL.fdvariablex
      table_1 = indice
      //tableselectplus("TABLE_1",indice)
     type : 458752
   -
     name : remplir_escompte
     procedure_id : 5859041162874570561
     type_code : 14
     code : |1+
      Procédure remplir_escompte(escomptenouveau = faux)
      j est un entier
      //hpos est un entier = hsauveposition("fdetail")
      postable est un entier
      surfaceaajouter est un reel
      //si escomptenouveau alors
      	tablesupprimetout("TABLEQTE")
          tablesupprimetout("TABLE_PIED")
      //FIN
      
      hlitpremier("trdetail","fdcle")
      //Code WinDev 5.5 remplacé par la migration :
      //si hdejabloque() alors
      si HErreurBlocage() alors
        
      fin
      
      //Code WinDev 5.5 remplacé par la migration :
      //tantque pas h.endehors
      tantque pas HEnDehors()
      	
      si pas sansespace(trdetail.fregroupement) = "" alors
      	surfaceaajouter = calcul_surface(facture.facalcul)
      	postable = tablecherche("no_produit",sansespace(trdetail.fregroupement),faux)
        
      	si postable <> -1 alors
      	   total_qte[postable] = total_qte[postable] + trdetail.fdqte 
      	sinon
      		tableajoute("TABLEQTE",trdetail.fregroupement+tab+trdetail.fdqte)
          FIN
      FIN
      
      si trdetail.fdverreunite alors
      	commandetrn.cdlargeur = trdetail.fdlargeur
      	commandetrn.cdhauteur = trdetail.fdhauteur
      	
      	surfaceaajouter = calcul_surface(facture.facalcul)
      	surfaceaajouter = surfaceaajouter * trdetail.fdqte
      	
      	postable = tablecherche("produitpied",sansespace(trdetail.fdnumprod),faux)
        
      	si postable <> -1 alors
      	   total_pied[postable] = total_pied[postable] + surfaceaajouter 
      	sinon
      		tableajoute("TABLE_PIED",trdetail.fdnumprod+tab+surfaceaajouter)
          FIN
      FIN
      	
      	
      	
      	
      	
      	
      	
      	
      	
      	hlitsuivant("trdetail","fdcle")
      //Code WinDev 5.5 remplacé par la migration :
      //si hdejabloque() alors
      si HErreurBlocage() alors
      
      fin
      fin
      //hretourposition(hpos)
      //Code WinDev 5.5 remplacé par la migration :
      //si hdejabloque() alors
      si HErreurBlocage() alors
      
      fin
      
     type : 458752
   -
     name : remplir_fdetail
     procedure_id : 5859041163721819969
     type_code : 14
     code : |1+
      Procédure remplir_fdetail()
      z				est un entier
      
      lcoutthermos	est un reel
      //hraz(Fdetail)
