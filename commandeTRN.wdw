          name : cdqte
          identifier : 0x514f7ee53e5ac7b9
          internal_properties : 
          properties :
           x : 7
           y : 129
           width : 105
           height : 24
          type : 2
          code_elements :
           type_code : 3
           p_codes :
            -
              code : |1+
               
               postable est un  entier
               si typedeproduit = "Unite" et typeunite = 4 alors
               	postable = tablecherche("no_produit",sansespace(commandetrn.cdregroupement),faux)
               	si postable <> -1 alors
               		total_qte[postable] = total_qte[postable] - commandetrn.cdqte 
               	FIN
               fin
               
               gnQteOriginale = moimeme
               
              type : 15
            -
              code : |1-
               
               cpt est un entier = 1
               nbComposant est un entier
               qtecourante est un entier 
               postable est un entier
               inventpos est un entier 
               escompteqte = faux
               pourcescompteqte = 0
               calculprixcoutant = faux
               calculprixcoutantpr1 = ""
               calculprixcoutantpr2 = ""
               calculprixcoutantpr3 = ""
               
               SI SansEspace(cdcomposant1) <> "" ALORS nbComposant++
               SI SansEspace(cdcomposant2) <> "" ALORS nbComposant++
               SI SansEspace(cdcomposant3) <> "" ALORS nbComposant++
               
               si commandecredit = 1 _et_ NbVerresCommande - (gnQteOriginale* nbComposant) + (moimeme * nbComposant) > 120 ALORS
               	Erreur("Dépassement du maximum de 120 verres autorisés sur une commande ")
               	reprisesaisie()
               FIN
               
               si moimeme..modifie alors
               	si commandetrn.commandecredit  = 2 alors
               		si moimeme < 0.00 alors
               			acso_message("Erreur","Vous êtes en mode crédit , ne pas inscrire le signe - ","Erreur")
               			reprisesaisie
               		FIN
               	FIN
               FIN
               
               si typedeproduit = "Verre" alors
               	si client.cminimuma  <> 0 ou client.cminimumm  <> 0 alors
               		surfaceminimumdifferentea = client.cminimuma
               		surfaceminimumdifferentem = client.cminimumm
               	FIN
               FIN
               
               si cssTypePeinture2..Modifié ou cssTypePeinture3..modifie  ou pas dmodif alors
               	calcul_prixu(commandetrn.facalcul,escompteqte,pourcescompteqte)
               sinon
               	si moimeme..modifie alors
               		commandetrn.cdprixtot = commandetrn.cdprixu  * commandetrn.cdqte
               	FIN
               fin
               
               calculenergieligneencours()
