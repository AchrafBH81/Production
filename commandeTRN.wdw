      i est un entier
      pour i = 1 a dimension(ChampRépétitif)/7
      	champrépétitif[i,3]= "" 
      	champrépétitif[i,6]= "" 
      FIN
      
     type : 458752
   -
     name : DessineCarrelage
     procedure_id : 5859041163130423105
     type_code : 14
     code : |1+
      Procédure DessineCarrelage()
      // Position du dessin du thermos
      i est un entier
      typedessin est une chaine
      interrupteurhaut est un booléen
      interrupteurbas est un booléen
      interrupteurgauche est un booléen
      interrupteurdroit est un booléen
      ajustementlargeur est un entier
      ajustementhauteur est un entier
      variableutil est un entier 
      variableutil1 est un entier 
      si pas sansespace(commandetrn.fdforme) = "" alors
      	image1=""
      	retour
      FIN
      
      Normaltete est un booleen = faux        // pour aviser qu'on dessine la barre d'un carrelage de tete seulement
      si commandetrn.CDHAUTEUR = 0 ou commandetrn.CDLARGEUR = 0 ou commandetrn.CDCARREAUV = 0 ... 
      	ou commandetrn.cdcarreauh = 0 alors
      	commandetrn.image1 = ""
      	retour
      fin	
      
      
      si HLitRecherche(typecarr,tcdescription,commandetrn.typecalcul..ValeurAffichée) alors
      	selon typecarr.Typedessin
      		cas 1
      			typedessin = "Normal"
      		cas 2
      			typedessin = "Contour"
      		cas 3
      			typedessin = "Tete"
      			//			cas 4
      			//				typedessin = "ContourTete"
      
      	FIN
      	ajustementlargeur = typecarr.AjustNbCarLargeur
      	ajustementhauteur = typecarr.AjustNbCarhauteur
      	interrupteurhaut  = typecarr.TcInterrupteurHaut
      	interrupteurbas  = typecarr.TcInterrupteurbas
      	interrupteurgauche  = typecarr.TcInterrupteurgauche
      	interrupteurdroit  = typecarr.TcInterrupteurdroit
      
      
      sinon
      	retour
      FIN
      
      
      
      
      PositionX1 est un entier     
      PositionY1 est un entier
      PositionX2 est un entier
      PositionY2 est un entier
      PositionX3 est un entier   // position de départ apres le petit carreau largeur  
      PositionY3 est un entier   // position de départ apres le petit carreau hauteur
      positiony4 est un entier    // position de bas pour carrelage de tete
      LargeurDessin est un entier
      Hauteurdessin est un entier
      Hauteurdessin1 est un entier  // hauteur du dessin pour carrelage de tete
      
      LargeurCarreau est un entier
      HauteurCarreau est un entier
      
      // pour contour
      
      LargeurCarreauPetit est un entier 
      HauteurCarreauPetit est un entier   
      LargeurCarreauCentre est un entier 
      hauteurCarreauCentre est un entier
      
      
      // échelle de grandeur , pour ne pas dépasser l'image
      
      Echelle est un entier 
      
      // Nombre de carreau
      
      NbCarreauLargeur est un entier = commandetrn.CDCARREAUV+ ajustementlargeur
      NbCarreauhauteur est un entier = commandetrn.CDCARREAUh+ ajustementhauteur
      variableutil = commandetrn.fdvariablex
      variableutil1 = commandetrn.fdvariablex1
      
      
      // carrelage de tete avec barre inférieure différente.Pour le dessin de la barre seulement
      // il faut changer ces parametres
      
      //si typedessin = "Normal" et fdetail.fdFlagBarreDifferente alors  
      //	NbCarreauHauteur = 1
      //	NbCarreauLargeur = 1
      //	typedessin = "Tete" 
      //    Normaltete = vrai
      //FIN
      //NbCarreauLargeur est un entier =  4
      //NbCarreauHauteur est un entier = 4
      
      LargeurCarrelage est un entier = commandetrn.fdlargeura
      Hauteurcarrelage est un entier = commandetrn.fdhauteura
      si fddemicarrelage alors
      	typedessin = "Tete"
      FIN
      si commandetrn.facalcul = 1 alors
      	LargeurCarrelage = LargeurCarrelage * 25.4
      	Hauteurcarrelage = Hauteurcarrelage * 25.4
      
      FIN
      //LargeurCarrelage = 800
      //Hauteurcarrelage = 800
      
      EchelleLargeur est un entier = LargeurCarrelage / commandetrn.Image1..largeur
      EchelleHauteur est un entier = Hauteurcarrelage / commandetrn.image1..hauteur
      
      Echelle = arrondi(max(EchelleHauteur,EchelleLargeur),0)+1
      si Echelle < 1 alors
      	Echelle = 1
      FIN
      
      	selon typedessin
      	cas "Normal"
      
      		PositionX1 = (commandetrn.image1..largeur - (LargeurCarrelage / Echelle)) / 2
      		PositionX2 = PositionX1 +( LargeurCarrelage / Echelle)
      		PositionY1 = (commandetrn.image1..hauteur - (Hauteurcarrelage / Echelle)) / 2
      		PositionY2 = PositionY1 + ( Hauteurcarrelage / Echelle )
      		LargeurDessin = PositionX2-PositionX1
      		Hauteurdessin = PositionY2-PositionY1
      
      		// calcul de la grandeur des carreaux a dessiner
      
      		LargeurCarreau = arrondi(LargeurDessin / NbCarreauLargeur,0)
      		HauteurCarreau = arrondi(Hauteurdessin / NbCarreauhauteur,0)
      
      		ddebutdessin(commandetrn.image1)
      		dRectangle(PositionX1,PositionY1,PositionX2,PositionY2,iblanc,inoir)
      
      		// tracage des lignes pour dessiner les carreau
      		pour i = 1 a NbCarreauLargeur-1
      
      			dligne(PositionX1+(LargeurCarreau*i),PositionY1,PositionX1+(LargeurCarreau*i),PositionY2,inoir)
      
      	FIN
      
      	pour i = 1 a NbCarreauhauteur-1
      
      		dligne(PositionX1,PositionY1+(HauteurCarreau*i),PositionX2,PositionY1+(HauteurCarreau*i),inoir)
      
      FIN
      
      
      //		imprimecarrelage..plan = 2
      //		info("")
      
      // CarrelageContour
      
      
      cas "Contour"
      
      	PositionX1 = (commandetrn.image1..largeur - (LargeurCarrelage / Echelle)) / 2
      	PositionX2 = PositionX1 +( LargeurCarrelage / Echelle)
      	PositionY1 = (commandetrn.image1..hauteur - (Hauteurcarrelage / Echelle)) / 2
      	PositionY2 = PositionY1 + ( Hauteurcarrelage / Echelle )
      	LargeurDessin = PositionX2-PositionX1
      	Hauteurdessin = PositionY2-PositionY1
      	//		LargeurCarreauPetit = arrondi(75.2 / echelle,0)
      	//		HauteurCarreauPetit = arrondi(101.6/echelle,0)
      	LargeurCarreauPetit = variableutil
      	HauteurCarreauPetit = variableutil1
      	LargeurCarreauPetit = arrondi(LargeurCarreauPetit / Echelle,0)
      	HauteurCarreauPetit = arrondi(HauteurCarreauPetit/Echelle,0)
      
      
      
      
      
      	// calcul de la grandeur des carreaux a dessiner
      
      	LargeurCarreau = arrondi(LargeurDessin / NbCarreauLargeur,0)
      	HauteurCarreau = arrondi(Hauteurdessin / NbCarreauhauteur,0)
      	PositionX3 = PositionX1+LargeurCarreauPetit
      	PositionY3 = PositionY1+HauteurCarreauPetit
      
      	si NbCarreauLargeur > 2 alors
      		LargeurCarreauCentre = (LargeurDessin - (2 * LargeurCarreauPetit)) / (NbCarreauLargeur-2)
      	sinon
      		LargeurCarreauCentre = 0
      fin
      si NbCarreauhauteur > 2 alors
      
      	hauteurCarreauCentre = (Hauteurdessin - (2 * HauteurCarreauPetit)) / (NbCarreauhauteur-2)
      sinon
      	hauteurCarreauCentre = 0
      fin
      ddebutdessin(commandetrn.image1)
      dRectangle(PositionX1,PositionY1,PositionX2,PositionY2,iblanc,inoir)
      
      // tracage des lignes horizontale pour dessiner les  petits carreaux
      
      si interrupteurhaut alors
      	dligne(PositionX1,PositionY1+HauteurCarreauPetit,PositionX2,PositionY1+HauteurCarreauPetit,inoir)
      fin
      si interrupteurbas alors
      	dligne(PositionX1,PositionY2-HauteurCarreauPetit,PositionX2,PositionY2-HauteurCarreauPetit,inoir)
      fin
      // tracage des lignes Verticale pour dessiner les  petits carreaux
      
      si interrupteurgauche alors
      	dligne(PositionX1+LargeurCarreauPetit,PositionY1,PositionX1+LargeurCarreauPetit,PositionY2,inoir)
      fin
      si interrupteurdroit alors
      	dligne(PositionX2-LargeurCarreauPetit,PositionY1,PositionX2-LargeurCarreauPetit,PositionY2,inoir)
      fin
      // tracage des petite lignes sur la largeur
      
      pour i = 1 a NbCarreauLargeur - 3
      	si interrupteurhaut alors
      		dligne(PositionX3+(LargeurCarreauCentre*i),PositionY1,PositionX3+(LargeurCarreauCentre*i),PositionY1+HauteurCarreauPetit,inoir)
      fin
      si interrupteurbas alors
      	dligne(PositionX3+(LargeurCarreauCentre*i),PositionY2-HauteurCarreauPetit,PositionX3+(LargeurCarreauCentre*i),PositionY2,inoir)
      fin
      fin
      
      // tracage des petite lignes sur la largeur
      
      pour i = 1 a NbCarreauhauteur - 3
      	si interrupteurgauche alors
      		dligne(PositionX1,PositionY3+(hauteurCarreauCentre*i),PositionX1+LargeurCarreauPetit,PositionY3+(hauteurCarreauCentre*i),inoir)
      fin
      si interrupteurdroit alors
      	dligne(PositionX2-LargeurCarreauPetit,PositionY3+(hauteurCarreauCentre*i),PositionX2,PositionY3+(hauteurCarreauCentre*i),inoir)
      fin			//			dligne(positionx3+(LargeurCarreaucentre*i),positiony2-HauteurCarreauPetit,positionx3+(LargeurCarreaucentre*i),PositionY2,inoir)
      
      fin
      
      
      
      
      Cas "Tete"
      	PositionX1 = (commandetrn.image1..largeur - (LargeurCarrelage / Echelle)) / 2
      	PositionX2 = PositionX1 +( LargeurCarrelage / Echelle)
      	PositionY1 = (commandetrn.image1..hauteur - (Hauteurcarrelage / Echelle)) / 2
      	PositionY2 = PositionY1 + ( Hauteurcarrelage / Echelle )
      	LargeurDessin = PositionX2-PositionX1
      	Hauteurdessin = (PositionY2-PositionY1)
      	positiony4 = PositionY1 + (Hauteurdessin/2)
      	// calcul de la grandeur des carreaux a dessiner
      	Hauteurdessin1 = positiony4 - PositionY1
      	si NbCarreauLargeur > 0 alors
      		LargeurCarreau = arrondi(LargeurDessin / NbCarreauLargeur,0)
      	sinon
      		LargeurCarreau = 0
      fin
      si NbCarreauhauteur > 0 alors
      	HauteurCarreau = arrondi(Hauteurdessin1 / NbCarreauhauteur,0)
      sinon
      	HauteurCarreau =0
      fin
      
      
      ddebutdessin(commandetrn.image1)
      dRectangle(PositionX1,PositionY1,PositionX2,PositionY2,iblanc,inoir)
      // tracage des lignes pour dessiner les carreau
      pour i = 1 a NbCarreauLargeur-1
      
      	dligne(PositionX1+(LargeurCarreau*i),PositionY1,PositionX1+(LargeurCarreau*i),positiony4,inoir)
      
      FIN
      
      pour i = 1 a NbCarreauhauteur-1
      
      	dligne(PositionX1,PositionY1+(HauteurCarreau*i),PositionX2,PositionY1+(HauteurCarreau*i),inoir)
      
      FIN
      //		si pas fdetail.fdFlagBarreDifferente  ou normaltete alors
      si NbCarreauhauteur > 0 alors
      	dligne(PositionX1,positiony4,PositionX2,positiony4,inoir)
      fin
      //		fin	
      
      
      
      // CarrelageContour
      
      cas "ContourTete"
      
      	PositionX1 = (Image1..largeur - (LargeurCarrelage / Echelle)) / 2
      	PositionX2 = PositionX1 +( LargeurCarrelage / Echelle)
      	PositionY1 = (Image1..hauteur - (Hauteurcarrelage / Echelle)) / 2
      	PositionY2 = PositionY1 + ( Hauteurcarrelage / Echelle )
      	LargeurDessin = PositionX2-PositionX1
      	Hauteurdessin = PositionY2-PositionY1
      	LargeurCarreauPetit = arrondi(75.2 / Echelle,0)
      	HauteurCarreauPetit = arrondi(101.6/Echelle,0)
      
      	positiony4 = PositionY1 + (Hauteurdessin/2)
      	// calcul de la grandeur des carreaux a dessiner
      	Hauteurdessin1 = positiony4 - PositionY1
      
      
      
      
      	// calcul de la grandeur des carreaux a dessiner
      
      	LargeurCarreau = arrondi(LargeurDessin / NbCarreauLargeur,0)
      	HauteurCarreau = arrondi(Hauteurdessin / NbCarreauhauteur,0)
      	PositionX3 = PositionX1+LargeurCarreauPetit
      	PositionY3 = PositionY1+HauteurCarreauPetit
      	LargeurCarreauCentre = (LargeurDessin - (2 * LargeurCarreauPetit)) / (NbCarreauLargeur-2)
      	hauteurCarreauCentre = (Hauteurdessin1 - (2 * HauteurCarreauPetit)) / (NbCarreauhauteur-2)
      	ddebutdessin(Image1)
      	dRectangle(PositionX1,PositionY1,PositionX2,PositionY2,iblanc,inoir)
      
      	// tracage des lignes horizontale pour dessiner les  petits carreaux
      
      	dligne(PositionX1,PositionY1+HauteurCarreauPetit,PositionX2,PositionY1+HauteurCarreauPetit,inoir)
      	dligne(PositionX1,positiony4-HauteurCarreauPetit,PositionX2,positiony4-HauteurCarreauPetit,inoir)
      	dligne(PositionX1,positiony4,PositionX2,positiony4,inoir)
      
      	// tracage des lignes Verticale pour dessiner les  petits carreaux
      
      	dligne(PositionX1+LargeurCarreauPetit,PositionY1,PositionX1+LargeurCarreauPetit,positiony4,inoir)
      	dligne(PositionX2-LargeurCarreauPetit,PositionY1,PositionX2-LargeurCarreauPetit,positiony4,inoir)
      
      	// tracage des petite lignes sur la largeur
      
      	pour i = 1 a NbCarreauLargeur - 3
      		dligne(PositionX3+(LargeurCarreauCentre*i),PositionY1,PositionX3+(LargeurCarreauCentre*i),PositionY1+HauteurCarreauPetit,inoir)
      		dligne(PositionX3+(LargeurCarreauCentre*i),positiony4-HauteurCarreauPetit,PositionX3+(LargeurCarreauCentre*i),positiony4,inoir)
      
      fin
      
      // tracage des petite lignes sur la largeur
      
      pour i = 1 a NbCarreauhauteur - 3
      	dligne(PositionX1,PositionY3+(hauteurCarreauCentre*i),PositionX1+LargeurCarreauPetit,PositionY3+(hauteurCarreauCentre*i),inoir)
      	dligne(PositionX2-LargeurCarreauPetit,PositionY3+(hauteurCarreauCentre*i),PositionX2,PositionY3+(hauteurCarreauCentre*i),inoir)
      	//			dligne(positionx3+(LargeurCarreaucentre*i),positiony2-HauteurCarreauPetit,positionx3+(LargeurCarreaucentre*i),PositionY2,inoir)
      
      fin
      
      
      
      
      
      fin
      
      
      //EcranVersFichier(imprimecarrelage,fdetail)
      ////
      //hmodifie(fdetail,hNumEnrEnCours)
      
      
     type : 458752
   -
     name : Affiche_facture
     procedure_id : 5859041162749790017
     type_code : 14
     code : |1-
      Procédure Affiche_facture()
      commandetrn.facalcul = facture.facalcul
      commandetrn.fadate = facture.fadate
      commandetrn.COMMANDECREDIT = facture.fatypedocument
      commandetrn.fdaterequise = facture.FDATEREQUISE
      commandetrn.fanumero = facture.fanumero
      commandetrn.fclient = facture.faclient
      commandetrn.fanocommande = facture.fanocommande
      commandetrn.reference = facture.fareference
      commandetrn.fanojob = facture.fanojob
      //commandetrn.fatransportouinon = facture.fatransportouinon
      commandetrn.CASESURCHARGEENERGIE = facture.FSURCHARGEENERGIE
      //commandetrn.INEXALU = facture.fainexalu
      commandetrn.Combo_Livraison1 = facture.idLivraison
      commandetrn.CaseSurchargePeinture=facture.SUrchargePeinture
      commandetrn.nom = facture.nom
      commandetrn.adresse = facture.adresse
      commandetrn.villeProv = facture.ville
      commandetrn.CodePostal = facture.CodePostal
      commandetrn.NoTelephone = facture.noTelephone
      commandetrn.NoTelephone2 = facture.noTelephone
      commandetrn.cidclient = facture.idclient
      commandetrn.lnom = facture.lNom
      commandetrn.lrue = facture.lRue
      commandetrn.lville = facture.lVille
      commandetrn.lcodepostal = facture.lCodePostal
      commandetrn.sai_note_livraison = facture.lnote
      commandetrn.CaseAdresseManuelle = facture.lAdresseManuelle
      ExécuteTraitement(Combo_Livraison1,trtSélection)
      si HLitRecherche(secteur,secteur,facture.fasecteur) alors
      	commandetrn.COMBO_SECTEUR = secteur.secteur
      fin
      
      SELON commandeTRN.facalcul
      	// Anglais
      	CAS 1
      
      		BtnTypeSaisie..Libellé = "A"
      	// Métrique
      	CAS 2
      
      		BtnTypeSaisie..Libellé = "M"
      FIN
     type : 458752
   -
     name : CalculCoutant
     procedure_id : 5859041162471262017
     type_code : 14
     code : |1+
      Procédure CalculCoutant()
      hlit(config,1)
      lCoutantTotal est un reel
      lresultat est un reel
      lCoutItem est un reel
      i est un entier
      
      assignevariable()
      
      
      // Cap
      
      si position(commandetrn.CDCAPGAZTUBE,"C") alors
      
      	si hlitrecherche(invent,INUM,config.cProduitAssocieCap) alors
      
      		formule = sansespace(config.CFormulecap)
      		res = compile("formule1","y est un reel"+rc+"y="+formule+rc+"renvoyer y") 
      		si res = "" alors
      			lresultat= ExécuteTraitement("formule1",trtProcédure)
      			selon invent.iUniteMesure 
      				cas 1
      				cas 2
      					lresultat = lresultat / 1000
      				cas 3		
      					lresultat = lresultat / 1000000
      			FIN
      			info(lresultat * invent.iprixunite)
      		fin
      
      
      	fin
      
      FIN
      
      
      // Gaz
      
      si position(commandetrn.CDCAPGAZTUBE,"Z") alors
      
      	si hlitrecherche(invent,INUM,config.cProduitAssociegaz) alors
      
      		formule = sansespace(config.CFormulegaz)
      		res = compile("formule1","y est un reel"+rc+"y="+formule+rc+"renvoyer y") 
      		si res = "" alors
      			lresultat= ExécuteTraitement("formule1",trtProcédure)
      			selon invent.iUniteMesure 
      				cas 1
      				cas 2
      					lresultat = lresultat / 1000
      				cas 3		
      					lresultat = lresultat / 1000000
      			FIN
      
      			info(lresultat * invent.iprixunite)
      		fin
      
      
      	fin
      
      FIN
      
      
      // MDO
      
      
      formule = sansespace(config.CMDOformule)
      res = compile("formule1","y est un reel"+rc+"y="+formule+rc+"renvoyer y") 
      si res = "" alors
      	lresultat= ExécuteTraitement("formule1",trtProcédure)
      	selon config.cUniteMDO 
      		cas 1
      		cas 2
      			lresultat = lresultat / 1000
      		cas 3		
      			lresultat = lresultat / 1000000
      	FIN
      
      	info(lresultat * config.cmdo)
      fin
      
      
      // frais generaux
      
      
      formule = sansespace(config.CFraisGenerauxFormule)
      res = compile("formule1","y est un reel"+rc+"y="+formule+rc+"renvoyer y") 
      si res = "" alors
      	lresultat= ExécuteTraitement("formule1",trtProcédure)
      	selon config.cUnitefrg 
      		cas 1
      		cas 2
      			lresultat = lresultat / 1000
      		cas 3		
      			lresultat = lresultat / 1000000
      	FIN
      
      	info(lresultat * config.CFraisGeneraux)
      fin
      
      // Autres
      
      
      formule = sansespace(config.cFournitureAutreFormule)
      res = compile("formule1","y est un reel"+rc+"y="+formule+rc+"renvoyer y") 
      si res = "" alors
      	lresultat= ExécuteTraitement("formule1",trtProcédure)
      	selon config.cUniteaut
      		cas 1
      		cas 2
      			lresultat = lresultat / 1000
      		cas 3		
      			lresultat = lresultat / 1000000
      	FIN
      
      	info(lresultat * config.CFournitureAutre)
      fin
      
      si sansespace(commandetrn.CDCOMPOSANT1) <> "" alors
      	si hlitrecherche(invent,INUM,commandetrn.CDCOMPOSANT1) alors
      		info((lasurfaceanglaisreelle * invent.icoutanta)+(lasurfaceanglaisreelle * invent.icoutanta * config.cPourcPerteVerre / 100))
      	FIN
      FIN
      
      si sansespace(commandetrn.CDCOMPOSANT2) <> "" alors
      	si hlitrecherche(invent,INUM,commandetrn.CDCOMPOSANT2) alors
      		info((lasurfaceanglaisreelle * invent.icoutanta)+(lasurfaceanglaisreelle * invent.icoutanta * config.cPourcPerteVerre / 100))
      	FIN
      FIN
      si sansespace(commandetrn.CDCOMPOSANT3) <> "" alors
      	si hlitrecherche(invent,INUM,commandetrn.CDCOMPOSANT3) alors
      		info((lasurfaceanglaisreelle * invent.icoutanta)+(lasurfaceanglaisreelle * invent.icoutanta * config.cPourcPerteVerre / 100))
      	FIN
      FIN
      
      // Intercallaire
      lCoutItem = 0
      //hlitrecherche(TypeSpacDim,CleDimension,hconstruitvalcle(TypeSpacDim,CleDimension,
      si hlitrecherche(typespac,tnumero,Combo_typespac) alors
      	formule = sansespace(typespac.tcformuleSpacer)
      	si hlitrecherche(TypeSpacDim,CleDimension,HConstruitValClé(TypeSpacDim,CleDimension,typespac.TYCLEUNIK,CDESPACE)) alors
      		si hlitrecherche(invent,INUM,TypeSpacDim.TSProduit) alors
      			lCoutItem = invent.iprixunite
      		sinon
      
      		fin
      
      	fin	
      	res = compile("formule1","y est un reel"+rc+"y="+formule+rc+"renvoyer y") 
      	si res = "" alors
      		lresultat= ExécuteTraitement("formule1",trtProcédure)
      		selon invent.iUniteMesure 
      			cas 1
      			cas 2
      				lresultat = lresultat / 1000
      			cas 3		
      				lresultat = lresultat / 1000000
      		FIN
      		info(lresultat * lCoutItem)
      	fin
      
      sinon
      
      FIN
      
      
      
      
      CalculCoutantcarrelage(commandetrn.cdnumcarr)
     type : 458752
   -
     name : AssigneVariable
     procedure_id : 5859041163041359681
     type_code : 14
     code : |1+
      Procédure AssigneVariable()
      i est un entier
      selon commandetrn.facalcul
      	cas 1	
      		H1 = val(commandetrn.cDHAUTEUR) * 25.4 
      		L1 = val(commandetrn.cdlargeur) * 25.4 
      	cas 2
      		H1 = val(commandetrn.fDHAUTEURa) 
      		L1 = val(commandetrn.fdlargeura)
      FIN
      
      
      NBL = commandetrn.CDCARREAUV
      NBH = commandetrn.CDCARREAUH
      si commandetrn.CDCARRELAGE alors
      	si hlitrecherche(typecarr,tcdescription,commandetrn.typecalcul..ValeurAffichée) alors
      	
      	    info(commandetrn.Combo_typespac)
      		c = typecarr.EpaisseurCadre
      		ETL = typecarr.EpaisseurTigeLargeur
      		eth = typecarr.EpaisseurTigeHauteur
      		vx = typecarr.VariableUtil
      		vx1 = typecarr.VariableUtil1
      		pour i = 1 a 20
      
      			{"k"+i} = typecarr.TConstantes[1]
      		FIN
      	sinon
      		c = 0
      		ETL = 0
      		eth = 0
      		vx = 0
      		vx1 = 0
      fin
      DDV = commandetrn.fdDDV
      DDH = commandetrn.fdddh
      DTH = commandetrn.fddt
      sinon
      	c = 0
      	ETL = 0
      	eth = 0
      	vx = 0
      	vx1 = 0
      	DDV = 0
      	DDH = 0
          DTH=0
      fin
      si sansespace(commandetrn.CDCOMPOSANT3) <> "" alors
      	TDT = 2
      sinon
      	tdt = 1
      FIN
      
      
      
     type : 458752
   -
     name : CalculCoutantcarrelage
     procedure_id : 5859041163896735553
     type_code : 14
     code : |1+
      Procédure CalculCoutantcarrelage(lnumcarr,lcout=0)
      // fcoutant.ftype 
      //
      // 1 = verre
      // 2 = Spacer
      // 3 = cap
      // 4 = gaz
      // 5 = carrelage
      // 6 = Main d'oeuvre
      // 7 = Frais généraux
      // 8 = Autres frais
      // 9 = Main d'oeuvre Carrelage
      
      lNoRecEnCours est un entier
      lnoproduitassocie est une chaine
      lresultat est un reel
      resultatcondition est un booleen = faux
      rLtotaldimension est un reel
      lCoutantProduit est un reel
      lpourperte est un reel
      lperte est un reel
      lCoutantTotalLigne est un reel = 0
      
      SupprimeLigneCoutant(facture.fanumero,fdetail.fdligne)
      AssigneVariableCarrelage()
      
      
      // carrelage
      si position(fdetail.fCAPGAZTUBE,"C") <> 0 alors
      	H1-= 0.004
      	L1-= 0.004
      FIN
      
      // MDO
      
      
      
      formule = sansespace(config.cMDOFormuleCarrelage)
      res = compile("formule1","y est un reel"+rc+"y="+formule+rc+"renvoyer y") 
      si res = ""
      	lresultat= ExécuteTraitement("formule1",trtProcédure)
      	selon config.cUniteMDOCarrelage 
      		cas 1
      		cas 2
      			lresultat = lresultat / 1000
      		cas 3		
      			lresultat = lresultat / 1000000
      	FIN
      
      	//	info(lresultat * config.cmdo)
      	hraz(Fcoutant)
      	fcoutant.cNoCommande = facture.fanumero
      	fcoutant.cNoLigne = fdetail.fdligne
      	fcoutant.cType = 9
      	fcoutant.cSousType = 0
      	si config.cUniteMDOCarrelage = 4 alors
      		fcoutant.cqte = config.cMDOCarrelage
      		fcoutant.cCoutUnitaire = lcout
      		fcoutant.ccouttotal = arrondi(lcout * config.cMDOCarrelage/ 100,2) 
      
      	sinon
      		fcoutant.cqte = lresultat
      		fcoutant.cCoutUnitaire = config.cMDOCarrelage
      		fcoutant.ccouttotal = arrondi(lresultat * config.cMDOCarrelagem,2)* fdetail.fdqteafacturer
      
      	FIN
      
      	//	fcoutant.cqte = lresultat
      	//	fcoutant.cCoutUnitaire = config.cMDOCarrelage
      	//	fcoutant.ccouttotal = arrondi(lresultat * config.cMDOCarrelage,2)
      	fcoutant.cNoClient = facture.faclient
      	fcoutant.Cdatecommande = Facture.fadate
      	lCoutantTotalLigne+=fcoutant.ccouttotal
      	hajoute(Fcoutant)
      fin
      
      
      /// Frais generaux seulement si calcul au pourcentage 
      
      // frais generaux
      
      si config.cunitefrg = 4 alors
      	hraz(Fcoutant)
      	fcoutant.cNoCommande = facture.fanumero
      	fcoutant.cNoLigne = fdetail.fdligne
      	fcoutant.cType = 7
      	fcoutant.cSousType = 0
      	fcoutant.cqte = config.CFraisGeneraux
      	fcoutant.cCoutUnitaire = lcout
      	fcoutant.ccouttotal = arrondi(lcout * config.CFraisGeneraux / 100,2)
      
      	//	fcoutant.cqte = lresultat
      	//	fcoutant.cCoutUnitaire = config.CFraisGeneraux
      	//	fcoutant.ccouttotal = arrondi(lresultat * config.CFraisGeneraux,2)
      	lCoutantTotalLigne+=fcoutant.ccouttotal
      	fcoutant.cNoClient = facture.faclient
      	fcoutant.Cdatecommande = Facture.fadate
      	hajoute(Fcoutant)
      fin
      
      
      /// Fourniture autre seulement si calcul au pourcentage 
      
      
      
      si config.cuniteaut = 4 alors
      	hraz(Fcoutant)
      	fcoutant.cNoCommande = facture.fanumero
      	fcoutant.cNoLigne = fdetail.fdligne
      	fcoutant.cType = 8
      	fcoutant.cSousType = 0
      	fcoutant.cqte = config.CFournitureAutre
      	fcoutant.cCoutUnitaire = lcout
      	fcoutant.ccouttotal = arrondi(lcout * config.CFournitureAutre / 100,2)
      
      	//	fcoutant.cqte = lresultat
      	//	fcoutant.cCoutUnitaire = config.CFraisGeneraux
      	//	fcoutant.ccouttotal = arrondi(lresultat * config.CFraisGeneraux,2)
      	lCoutantTotalLigne+=fcoutant.ccouttotal
      	fcoutant.cNoClient = facture.faclient
      	fcoutant.Cdatecommande = Facture.fadate
      	hajoute(Fcoutant)
      fin
      
      
      /// carrelage
      
      si hlitrecherche(typecarr,tcdescription,fdetail.fdtypecalcul) alors
      	pour i = 1 a 10
      
      		formule = sansespace(typecarr.nbmorceau[i])
      		res = compile("formule1","y est un reel"+rc+"y="+formule+rc+"renvoyer y") 
      		si res = "" alors
      
      			si pas valideformule(formule) alors
      				{"NM"+i} = 0
      			sinon
      				{"NM"+i} = executetraitement("formule1",trtProcédure)
      			fin
      			si 	{"NM"+i} < 0 alors
      				{"NM"+i} = 0
      			FIN
      
      			si sansespace(typecarr.conditionsinm[i]) = "" alors
      				impvideo.vnbmorceau[i] = {"NM"+i}
      			sinon
      				formule = sansespace(typecarr.conditionsinm[i])
      				res = compile("formule2","y est un reel"+RC+"y="+formule+RC+"renvoyer y ")
      				si res = "" alors
      					resultatcondition = ExécuteTraitement("formule2",trtProcédure)
      
      					si resultatcondition  alors
      						formule = sansespace(typecarr.conditionalorsnm[i])
      						res = compile("formule2","y est un reel"+RC+"y="+formule+RC+"renvoyer y ")
      						si res = "" ALORS
      							{"NM"+i} = (ExécuteTraitement("formule2",trtProcédure))
      
      							impvideo.vnbmorceau[i] = {"NM"+i}
      						sinon
      							{"NM"+i} = 0
      
      						fin
      
      					sinon
      						impvideo.vnbmorceau[i] = {"NM"+i}
      
      					fin
      				sinon
      					{"NM"+i} = 0
      
      				fin
      
      			fin
      
      	FIN
      
      
      
      
      	formule = sansespace(typecarr.nbdimension[i])
      	res = compile("formule1","y est un reel"+rc+"y="+formule+rc+"renvoyer y") 
      	si res = "" alors
      		si pas valideformule(formule) alors
      			{"DM"+i} = 0
      		sinon
      			{"DM"+i} = executetraitement("formule1",trtProcédure)
      	fin
      	si 	{"DM"+i} < 0 alors
      		{"DM"+i} = 0
      	FIN
      
      
      
      	si sansespace(typecarr.conditionsidm[i]) = "" alors
      		impvideo.vdimensionmorceau[i] = {"DM"+i}
      	sinon
      		formule = sansespace(typecarr.conditionsidm[i])
      		res = compile("formule2","y est un reel"+RC+"y="+formule+RC+"renvoyer y ")
      		si res = "" alors
      			resultatcondition = ExécuteTraitement("formule2",trtProcédure)
      
      			si resultatcondition  alors
      				formule = sansespace(typecarr.conditionalorsdm[i])
      				res = compile("formule2","y est un reel"+RC+"y="+formule+RC+"renvoyer y ")
      				si res = "" ALORS
      					{"DM"+i} = (ExécuteTraitement("formule2",trtProcédure))
      
      					impvideo.vdimensionmorceau[i] = {"DM"+i}
      				sinon
      					{"DM"+i} = 0
      
      				fin
      
      			sinon
      				impvideo.vdimensionmorceau[i] = {"DM"+i}
      			fin
      		sinon
      			{"DM"+i} = 0
      
      	fin
      
      fin
      
      lresultat = {"DM"+i} / 1000
      lCoutantProduit = 0
      lpourperte =  config.cPourcPerteCarrelage
      
      si hlitrecherche(invent,INUM,lnumcarr) alors
      	lCoutantProduit = arrondi(invent.icoutantcarrelageM,2)
      fin
      lperte = arrondi({"NM"+i} * lresultat *  lCoutantProduit * lpourperte / 100,2)
      
      //info(lresultat * invent.iprixunite)
      hraz(Fcoutant)
      fcoutant.cNoCommande = facture.fanumero
      fcoutant.cNoLigne = fdetail.fdligne
      fcoutant.cType = 5
      fcoutant.cSousType = 0
      fcoutant.cqte = {"NM"+i}
      fcoutant.CPourPerte = lpourperte
      fcoutant.cPerte = lperte
      fcoutant.CDimension = arrondi(lresultat * 1000,2)
      fcoutant.cCoutUnitaire = lCoutantProduit
      fcoutant.ccouttotal = arrondi(({"NM"+i} * lresultat * lCoutantProduit) + lperte,2) * fdetail.fdqteafacturer
      lCoutantTotalLigne+=fcoutant.ccouttotal
      fcoutant.CFourniture = lnumcarr
      fcoutant.cNoClient = facture.faclient
      fcoutant.Cdatecommande = Facture.fadate
      hajoute(Fcoutant)
      
      
      FIN
      
      fin
      
      
      // Recherche des fournitures associées à ce carrelage
      
      
      //	si hlitrecherche(invent,INUM,lnumcarr) ALORS
      pour i = 1 a 10
      	si sansespace(typecarr.TformuleQteFourniture[i]) <> "" alors
      		lnoproduitassocie = typecarr.TProduitAssocie[i]
      
      		lNoRecEnCours = HSauvePosition(invent)
      		si hlitrecherche(invent,INUM,lnoproduitassocie) alors
      			formule = sansespace(typecarr.TformuleQteFourniture[i])
      			res = compile("formule1","y est un reel"+rc+"y="+formule+rc+"renvoyer y") 
      			si res = "" alors
      				lresultat= ExécuteTraitement("formule1",trtProcédure)
      				selon invent.iUniteMesure 
      					cas 1
      					cas 2
      						lresultat = lresultat / 1000
      					cas 3		
      						lresultat = lresultat / 1000000
      				FIN
      
      			fin
      			hraz(Fcoutant)
      			fcoutant.cNoCommande = facture.fanumero
      			fcoutant.cNoLigne = fdetail.fdligne
      			fcoutant.cType = 5
      			fcoutant.cSousType = 1
      			fcoutant.cqte = lresultat
      			fcoutant.cCoutUnitaire = invent.icoutUnitem
      			fcoutant.ccouttotal = arrondi(lresultat * invent.icoutUnitem,2)* fdetail.fdqteafacturer
      			lCoutantTotalLigne+=fcoutant.ccouttotal
      			fcoutant.CFourniture = invent.inum
      			fcoutant.cNoClient = facture.faclient
      			fcoutant.Cdatecommande = Facture.fadate
      			hajoute(Fcoutant)
      
      
      	FIN
      	HRetourPosition(lNoRecEnCours)
      FIN
      FIN
      
      //	FIN
      
      
      
      
      FIN
      
      
      FcoutantLigne.cNoCommande = facture.fanumero
      FcoutantLigne.cNoLigne = fdetail.fdligne
      fcoutantligne.cdesc = fdetail.fddesc
      fcoutantligne.ctype = fdetail.ftype
      FcoutantLigne.ccouttotal = lCoutantTotalLigne
      fcoutantligne.cNoClient = facture.faclient
      fcoutantligne.Cdatecommande = Facture.fadate
      hajoute(FcoutantLigne)
      
      
     type : 458752
   -
     name : valideformule
     procedure_id : 5859041162285401921
     type_code : 14
     code : |1+
      Procédure valideformule(Formulaverifier)
      xposition est un entier = 0  // position du caractere /
      xposition1 est un entier = 1 // position du caractere )
      souschaine est une chaine
      i est un entier = 1
      formule1 est une chaine
      res est une chaine
      boucle
      	xposition = position(Formulaverifier,"/",xposition+1)
      	si xposition = 0 alors
      		sortir
      	FIN
      	xposition1 = position(Formulaverifier,")",xposition)
          si xposition1 = 0 alors
             xposition1 = taille(Formulaverifier)
          fin
          	
      	souschaine = milieu(Formulaverifier,xposition+1,xposition1-xposition)
      	souschaine = remplace(souschaine,"(","")
      	souschaine = remplace(souschaine,")","")
      	formule1 = "y est un reel"+RC+"y="+souschaine+RC+"renvoyer y "
      	res = compile("formule2",formule1)
      	si ExécuteTraitement("formule2",trtProcédure) = 0 alors
      		renvoyer faux
      	FIN
      FIN
      
      renvoyer vrai
      
      
      
     type : 458752
   -
     name : CalculCoutantVerre
     procedure_id : 5859041162995746625
     type_code : 14
     code : |1+
      Procédure CalculCoutantVerre(lcout)
      
      
      hlit(config,1)
      lCoutantTotal est un reel  = 0
      lCoutantTotalLigne est un reel = 0
      lresultat est un reel
      lCoutItem est un reel
      lperte est un reel
      SurfaceReelle est un reel = calculsurfaceAnglaisreelle(facture.facalcul)
      i est un entier
      litem est une chaine
      lArgon est un booleen
      
      // fcoutant.ftype 
      //
      // 1 = verre
      // 2 = Spacer
      // 3 = cap
      // 4 = gaz
      // 5 = carrelage
      // 6 = Main d'oeuvre
      // 7 = Frais généraux
      // 8 = Autres frais
      // 9 = Main d'oeuvre Carrelage
      // 10 = Coin
      // 11 = Moleculaire
      
      
      
      // fcoutant.soustype
      //
      // 0 = aucun
      // 1 = fourniture relie au carrelage
      SupprimeLigneCoutant(facture.fanumero,fdetail.fdligne)
      assignevariableverre()
      
      
      // Cap
      
      si position(fdetail.fCAPGAZTUBE,"C") alors
      
      	si hlitrecherche(invent,INUM,config.cProduitAssocieCap) alors
      
      		formule = sansespace(config.CFormulecap)
      		res = compile("formule1","y est un reel"+rc+"y="+formule+rc+"renvoyer y") 
      		si res = "" alors
      			lresultat= ExécuteTraitement("formule1",trtProcédure)
      			selon invent.iUniteMesure 
      				cas 1
      				cas 2
      					lresultat = lresultat / 1000
      				cas 3		
      					lresultat = lresultat / 1000000
      			FIN
      			//info(lresultat * invent.iprixunite)
      			hraz(Fcoutant)
      			fcoutant.cNoCommande = facture.fanumero
      			fcoutant.cNoLigne = fdetail.fdligne
      			fcoutant.cType = 3
      			fcoutant.cSousType = 0
      			fcoutant.cqte = lresultat
      			fcoutant.cCoutUnitaire = invent.icoutUnitem
      			fcoutant.ccouttotal = arrondi(lresultat * invent.icoutUnitem,2) * fdetail.fdqteafacturer
      			lCoutantTotalLigne+=fcoutant.ccouttotal
      			fcoutant.CFourniture = invent.inum
      			fcoutant.cNoClient = facture.faclient
      			fcoutant.Cdatecommande = Facture.fadate
      			hajoute(Fcoutant)
      		fin
      
      
      
      	fin
      
      FIN
      
      
      // Gaz
      
      si position(fdetail.fCAPGAZTUBE,"Z") alors
      	lArgon = vrai
      	si hlitrecherche(invent,INUM,config.cProduitAssociegaz) alors
      
      		formule = sansespace(config.CFormulegaz)
      		res = compile("formule1","y est un reel"+rc+"y="+formule+rc+"renvoyer y") 
      		si res = "" alors
      			lresultat= ExécuteTraitement("formule1",trtProcédure)
      			selon invent.iUniteMesure 
      				cas 1
      				cas 2
      					lresultat = lresultat / 1000
      				cas 3		
      					lresultat = lresultat / 1000000
      			FIN
      
      			//			info(lresultat * invent.iprixunite)
      			hraz(Fcoutant)
      			fcoutant.cNoCommande = facture.fanumero
      			fcoutant.cNoLigne = fdetail.fdligne
      			fcoutant.cType = 4
      			fcoutant.cSousType = 0
      			fcoutant.cqte = lresultat
      			fcoutant.cCoutUnitaire = invent.icoutUnitem
      			fcoutant.ccouttotal = arrondi(lresultat * invent.icoutUnitem,2)* fdetail.fdqteafacturer
      			lCoutantTotalLigne+=fcoutant.ccouttotal
      			fcoutant.CFourniture = invent.inum
      			fcoutant.cNoClient = facture.faclient
      			fcoutant.Cdatecommande = Facture.fadate
      			hajoute(Fcoutant)
      		fin
      
      
      	fin
      
      sinon
      	lArgon = faux
      FIN
      
      
      
      // MDO
      
      
      formule = sansespace(config.CMDOformule)
      res = compile("formule1","y est un reel"+rc+"y="+formule+rc+"renvoyer y") 
      si res = "" alors
      	lresultat= ExécuteTraitement("formule1",trtProcédure)
      	selon config.cUniteMDO 
      		cas 1
      		cas 2
      			lresultat = lresultat / 1000
      		cas 3		
      			lresultat = lresultat / 1000000
              cas 4
              
      	FIN
      
      	//	info(lresultat * config.cmdo)
      	hraz(Fcoutant)
      	fcoutant.cNoCommande = facture.fanumero
      	fcoutant.cNoLigne = fdetail.fdligne
      	fcoutant.cType = 6
      	fcoutant.cSousType = 0
      	si config.cunitemdo = 4 alors
      		fcoutant.cqte = config.cmdo
      		fcoutant.cCoutUnitaire = lcout
      		fcoutant.ccouttotal = arrondi(lcout * config.CMDO / 100,2)
      
      	sinon
      		fcoutant.cqte = lresultat
      		fcoutant.cCoutUnitaire = config.cmdo
      		fcoutant.ccouttotal = arrondi(lresultat * config.CMDOm,2)* fdetail.fdqteafacturer
      
      	FIN
      	fcoutant.cNoClient = facture.faclient
      	fcoutant.Cdatecommande = Facture.fadate
      	lCoutantTotalLigne+=fcoutant.ccouttotal
      	hajoute(Fcoutant)
      fin
      
      
      // frais generaux
      
      
      formule = sansespace(config.CFraisGenerauxFormule)
      res = compile("formule1","y est un reel"+rc+"y="+formule+rc+"renvoyer y") 
      si res = "" alors
      	lresultat= ExécuteTraitement("formule1",trtProcédure)
      	selon config.cUnitefrg 
      		cas 1
      		cas 2
      			lresultat = lresultat / 1000
      		cas 3		
      			lresultat = lresultat / 1000000
      	FIN
      
      	//	info(lresultat * config.CFraisGeneraux)
      	hraz(Fcoutant)
      	fcoutant.cNoCommande = facture.fanumero
      	fcoutant.cNoLigne = fdetail.fdligne
      	fcoutant.cType = 7
      	fcoutant.cSousType = 0
      	si config.cunitefrg = 4 alors
      		fcoutant.cqte = config.CFraisGeneraux
      		fcoutant.cCoutUnitaire = lcout
      		fcoutant.ccouttotal = arrondi(lcout * config.CFraisGeneraux / 100,2)
      
      	sinon
      		fcoutant.cqte = lresultat
      		fcoutant.cCoutUnitaire = config.CFraisGeneraux
      		fcoutant.ccouttotal = arrondi(lresultat * config.CFraisGenerauxm,2)* fdetail.fdqteafacturer
      
      	FIN
      //	fcoutant.cqte = lresultat
      //	fcoutant.cCoutUnitaire = config.CFraisGeneraux
      //	fcoutant.ccouttotal = arrondi(lresultat * config.CFraisGeneraux,2)
      	lCoutantTotalLigne+=fcoutant.ccouttotal
      	fcoutant.cNoClient = facture.faclient
      	fcoutant.Cdatecommande = Facture.fadate
      	hajoute(Fcoutant)
      fin
      
      // Autres
      
      
      formule = sansespace(config.cFournitureAutreFormule)
      
      
      res = compile("formule1","y est un reel"+rc+"y="+formule+rc+"renvoyer y") 
      si res = "" alors
      	lresultat= ExécuteTraitement("formule1",trtProcédure)
      	selon config.cUniteaut
      		cas 1
      		cas 2
      			lresultat = lresultat / 1000
      		cas 3		
      			lresultat = lresultat / 1000000
      	FIN
      
      	//	info(lresultat * config.CFournitureAutre)
      	hraz(Fcoutant)
      	fcoutant.cNoCommande = facture.fanumero
      	fcoutant.cNoLigne = fdetail.fdligne
      	fcoutant.cType = 8
      	fcoutant.cSousType = 0
      	si config.cUniteAut = 4 alors
      		fcoutant.cqte = config.CFournitureAutre
      		fcoutant.cCoutUnitaire = lcout
      		fcoutant.ccouttotal = arrondi(lcout * config.CFournitureAutre / 100,2)
      
      	sinon
      		fcoutant.cqte = lresultat
      		fcoutant.cCoutUnitaire = config.CFournitureAutre
      		fcoutant.ccouttotal = arrondi(lresultat * config.CFournitureAutrem,2)* fdetail.fdqteafacturer
      
      	FIN
      	
      //	fcoutant.cqte = lresultat
      //	fcoutant.cCoutUnitaire = config.CFournitureAutre
      //	fcoutant.ccouttotal = arrondi(lresultat * config.CFournitureAutre,2)
      	fcoutant.cNoClient = facture.faclient
      	fcoutant.Cdatecommande = Facture.fadate
      	lCoutantTotalLigne+=fcoutant.ccouttotal
      	hajoute(Fcoutant)
      fin
      si sansespace(fdetail.fDCOMPOSANT1) <> "" alors
      	si hlitrecherche(invent,INUM,commandetrn.CDCOMPOSANT1) alors
      		//		info((surfacereelle * invent.icoutanta)+(surfacereelle * invent.icoutanta * config.cPourcPerteVerre / 100))
      		hraz(Fcoutant)
      		fcoutant.cNoCommande = facture.fanumero
      		fcoutant.cNoLigne = fdetail.fdligne
      		fcoutant.cType = 1
      		fcoutant.cSousType = 0
      		fcoutant.cqte = SurfaceReelle
      		fcoutant.cCoutUnitaire = invent.icoutantm
      		fcoutant.CPourPerte = config.cPourcPerteVerre
      		fcoutant.CPerte = SurfaceReelle * invent.icoutantm * config.cPourcPerteVerre / 100
      		fcoutant.ccouttotal = (arrondi((SurfaceReelle * invent.icoutantm)+(SurfaceReelle * invent.icoutantm * config.cPourcPerteVerre / 100),2))...
      		* fdetail.fdqteafacturer
      		fcoutant.cNoClient = facture.faclient
      		fcoutant.Cdatecommande = Facture.fadate
      		lCoutantTotalLigne+=fcoutant.ccouttotal
      		fcoutant.CFourniture = invent.inum
      
      		hajoute(Fcoutant)
      
      
      	FIN
      FIN
      
      
      si sansespace(fdetail.fDCOMPOSANT2) <> "" alors
      	si hlitrecherche(invent,INUM,commandetrn.CDCOMPOSANT2) alors
      		//		info((surfacereelle * invent.icoutanta)+(surfacereelle * invent.icoutanta * config.cPourcPerteVerre / 100))
      		hraz(Fcoutant)
      		fcoutant.cNoCommande = facture.fanumero
      		fcoutant.cNoLigne = fdetail.fdligne
      		fcoutant.cType = 1
      		fcoutant.cSousType = 0
      		fcoutant.cqte = SurfaceReelle
      		fcoutant.cCoutUnitaire = invent.icoutantm
      		fcoutant.CPourPerte = config.cPourcPerteVerre
      		fcoutant.CPerte = SurfaceReelle * invent.icoutantm * config.cPourcPerteVerre / 100
      		fcoutant.ccouttotal = (arrondi((SurfaceReelle * invent.icoutantm)+(SurfaceReelle * invent.icoutantm * config.cPourcPerteVerre / 100),2))...
      		* fdetail.fdqteafacturer
      		lCoutantTotalLigne+=fcoutant.ccouttotal
      		fcoutant.cNoClient = facture.faclient
      		fcoutant.CFourniture = invent.inum
      		fcoutant.Cdatecommande = Facture.fadate
      		hajoute(Fcoutant)
      	FIN
      FIN
      si sansespace(fdetail.fDCOMPOSANT3) <> "" alors
      	si hlitrecherche(invent,INUM,commandetrn.CDCOMPOSANT3) alors
      		//	info((surfacereelle * invent.icoutanta)+(surfacereelle * invent.icoutanta * config.cPourcPerteVerre / 100))
      		hraz(Fcoutant)
      		fcoutant.cNoCommande = facture.fanumero
      		fcoutant.cNoLigne = fdetail.fdligne
      		fcoutant.cType = 1
      		fcoutant.cSousType = 0
      		fcoutant.cqte = SurfaceReelle
      		fcoutant.cCoutUnitaire = invent.icoutantm
      		fcoutant.CPourPerte = config.cPourcPerteVerre
      		fcoutant.CPerte = SurfaceReelle * invent.icoutantm * config.cPourcPerteVerre / 100
      		fcoutant.ccouttotal = (arrondi((SurfaceReelle * invent.icoutantm)+(SurfaceReelle * invent.icoutantm * config.cPourcPerteVerre / 100),2))...
      		* fdetail.fdqteafacturer
      		lCoutantTotalLigne+=fcoutant.ccouttotal
      		fcoutant.cNoClient = facture.faclient
      		fcoutant.CFourniture = invent.inum
      		fcoutant.Cdatecommande = Facture.fadate
      		hajoute(Fcoutant)
      	FIN
      FIN
      
      
      // Intercallaire
      lCoutItem = 0
      lperte = 0
      litem = ""
      lresultat = 0
      
      //hlitrecherche(TypeSpacDim,CleDimension,hconstruitvalcle(TypeSpacDim,CleDimension,)
      
      
      si hlitrecherche(typespac,tnumero,fdetail.ftypespacer) ALORS
      	formule = sansespace(typespac.tcformuleSpacer)
      	si hlitrecherche(TypeSpacDim,CleDimension,HConstruitValClé(TypeSpacDim,CleDimension,typespac.TYCLEUNIK,sansespace(fdetail.fDESPACE))) alors
      		si hlitrecherche(invent,INUM,TypeSpacDim.TSProduit) alors
      			lCoutItem = invent.icoutunitem
      			litem = invent.inum
      	fin
      fin	
      
      
      
      res = compile("formule1","y est un reel"+rc+"y="+formule+rc+"renvoyer y") 
      si res = "" alors
      	lresultat= ExécuteTraitement("formule1",trtProcédure)
      	selon invent.iUniteMesure 
      		cas 1
      		cas 2
      			lresultat = lresultat / 1000
      		cas 3		
      			lresultat = lresultat / 1000000
      	FIN
      	//			info(lresultat * lcoutitem)
      	lperte = val(lresultat) * lCoutItem * config.cPourcPerteSpacer / 100
      	hraz(Fcoutant)
      	fcoutant.cNoCommande = facture.fanumero
      	fcoutant.cNoLigne = fdetail.fdligne
      	fcoutant.cType = 2
      	fcoutant.cSousType = 0
      	fcoutant.cqte = lresultat
      	fcoutant.cCoutUnitaire = lCoutItem
      	fcoutant.CPourPerte = config.cPourcPerteSpacer
      	fcoutant.CPerte = lperte
      	fcoutant.ccouttotal = arrondi((lresultat * lCoutItem) + lperte,2)* fdetail.fdqteafacturer
      	lCoutantTotalLigne+=fcoutant.ccouttotal
      	fcoutant.CFourniture = litem
      	fcoutant.cNoClient = facture.faclient
      	fcoutant.Cdatecommande = Facture.fadate
      	hajoute(Fcoutant)
      fin
      fin
      
      
      
      // Coin
      lCoutItem = 0
      lperte = 0
      litem = ""
      lresultat = 0
      
      //hlitrecherche(TypeSpacDim,CleDimension,hconstruitvalcle(TypeSpacDim,CleDimension,
      si hlitrecherche(typespac,tnumero,fdetail.ftypespacer) alors
      	formule = sansespace(typespac.tformulecoin)
      	si hlitrecherche(TypeSpacDim,CleDimension,HConstruitValClé(TypeSpacDim,CleDimension,typespac.TYCLEUNIK,sansespace(fdetail.fDESPACE))) alors
      
      		si hlitrecherche(invent,INUM,TypeSpacDim.Tscoin) alors
      			lCoutItem = invent.icoutunitem
      			litem = invent.inum
      	fin
      
      
      fin
      
      
      
      fin	
      res = compile("formule1","y est un reel"+rc+"y="+formule+rc+"renvoyer y") 
      si res = "" alors
      	lresultat= ExécuteTraitement("formule1",trtProcédure)
      	selon invent.iUniteMesure 
      		cas 1
      		cas 2
      			lresultat = lresultat / 1000
      		cas 3		
      			lresultat = lresultat / 1000000
      	FIN
      	//			info(lresultat * lcoutitem)
      	lperte = val(lresultat) * lCoutItem * config.cPourcPerteSpacer / 100
      	hraz(Fcoutant)
      	fcoutant.cNoCommande = facture.fanumero
      	fcoutant.cNoLigne = fdetail.fdligne
      	fcoutant.cType = 10
      	fcoutant.cSousType = 0
      	fcoutant.cqte = lresultat
      	fcoutant.cCoutUnitaire = lCoutItem
      	fcoutant.ccouttotal = arrondi((lresultat * lCoutItem),2)* fdetail.fdqteafacturer
      	lCoutantTotalLigne+=fcoutant.ccouttotal
      	fcoutant.CFourniture = litem
      	fcoutant.cNoClient = facture.faclient
      	fcoutant.Cdatecommande = Facture.fadate
      	hajoute(Fcoutant)
      fin
      
               
      // Coin Argon
      lCoutItem = 0
      lperte = 0
      litem = ""
      lresultat = 0
      
      //hlitrecherche(TypeSpacDim,CleDimension,hconstruitvalcle(TypeSpacDim,CleDimension,
      si hlitrecherche(typespac,tnumero,fdetail.ftypespacer) alors
      	formule = sansespace(typespac.Tfornulecoinargon)
      	si hlitrecherche(TypeSpacDim,CleDimension,HConstruitValClé(TypeSpacDim,CleDimension,typespac.TYCLEUNIK,sansespace(fdetail.fDESPACE))) alors
      
      		si hlitrecherche(invent,INUM,TypeSpacDim.TscoinArgon) alors
      			lCoutItem = invent.icoutunitem
      			litem = invent.inum
      	fin
      
      
      fin
      
      
      
      fin	
      res = compile("formule1","y est un reel"+rc+"y="+formule+rc+"renvoyer y") 
      si res = "" alors
      	lresultat= ExécuteTraitement("formule1",trtProcédure)
      	selon invent.iUniteMesure 
      		cas 1
      		cas 2
      			lresultat = lresultat / 1000
      		cas 3		
      			lresultat = lresultat / 1000000
      	FIN
      	//			info(lresultat * lcoutitem)
      	hraz(Fcoutant)
      	fcoutant.cNoCommande = facture.fanumero
      	fcoutant.cNoLigne = fdetail.fdligne
      	fcoutant.cType = 10
      	fcoutant.cSousType = 0
      	fcoutant.cqte = lresultat
      	fcoutant.cCoutUnitaire = lCoutItem
      	fcoutant.ccouttotal = arrondi((lresultat * lCoutItem),2)* fdetail.fdqteafacturer
      	lCoutantTotalLigne+=fcoutant.ccouttotal
      	fcoutant.CFourniture = litem
      	fcoutant.cNoClient = facture.faclient
      	fcoutant.Cdatecommande = Facture.fadate
      	hajoute(Fcoutant)
      fin
      
      // Moleculaire
      lCoutItem = 0
      lperte = 0
      litem = ""
      lresultat = 0
      
      //hlitrecherche(TypeSpacDim,CleDimension,hconstruitvalcle(TypeSpacDim,CleDimension,
      si hlitrecherche(typespac,tnumero,fdetail.ftypespacer) alors
      	formule = sansespace(typespac.tformulemoleculaire)
      	si hlitrecherche(TypeSpacDim,CleDimension,HConstruitValClé(TypeSpacDim,CleDimension,typespac.TYCLEUNIK,sansespace(fdetail.fDESPACE))) alors
      
      		si hlitrecherche(invent,INUM,TypeSpacDim.TsMoleculaire) alors
      			lCoutItem = invent.icoutunitem
      			litem = invent.inum
      	fin
      
      
      fin
      
      
      
      fin	
      res = compile("formule1","y est un reel"+rc+"y="+formule+rc+"renvoyer y") 
      si res = "" alors
      	lresultat= ExécuteTraitement("formule1",trtProcédure)
      	selon invent.iUniteMesure 
      		cas 1
      		cas 2
      			lresultat = lresultat / 1000
      		cas 3		
      			lresultat = lresultat / 1000000
      	FIN
      	//			info(lresultat * lcoutitem)
      	hraz(Fcoutant)
      	fcoutant.cNoCommande = facture.fanumero
      	fcoutant.cNoLigne = fdetail.fdligne
      	fcoutant.cType = 11
      	fcoutant.cSousType = 0
      	fcoutant.cqte = lresultat
      	fcoutant.cCoutUnitaire = lCoutItem
      	fcoutant.ccouttotal = arrondi((lresultat * lCoutItem),2)* fdetail.fdqteafacturer
      	lCoutantTotalLigne+=fcoutant.ccouttotal
      	fcoutant.CFourniture = litem
      	fcoutant.cNoClient = facture.faclient
      	fcoutant.Cdatecommande = Facture.fadate
      	hajoute(Fcoutant)
      fin
      
      
      // Colle
      lCoutItem = 0
      lperte = 0
      litem = ""
      lresultat = 0
      
      //hlitrecherche(TypeSpacDim,CleDimension,hconstruitvalcle(TypeSpacDim,CleDimension,
      si hlitrecherche(typespac,tnumero,fdetail.ftypespacer) alors
      	formule = sansespace(typespac.tformulecolle)
      	si hlitrecherche(TypeSpacDim,CleDimension,HConstruitValClé(TypeSpacDim,CleDimension,typespac.TYCLEUNIK,sansespace(fdetail.fDESPACE))) alors
      
      		si hlitrecherche(invent,INUM,TypeSpacDim.Tscolle) alors
      			lCoutItem = invent.icoutunitem
      			litem = invent.inum
      	fin
      
      
      fin
      
      
      
      fin	
      res = compile("formule1","y est un reel"+rc+"y="+formule+rc+"renvoyer y") 
      si res = "" alors
      	lresultat= ExécuteTraitement("formule1",trtProcédure)
      	selon invent.iUniteMesure 
      		cas 1
      		cas 2
      			lresultat = lresultat / 1000
      		cas 3		
      			lresultat = lresultat / 1000000
      	FIN
      	//			info(lresultat * lcoutitem)
      	hraz(Fcoutant)
      	fcoutant.cNoCommande = facture.fanumero
      	fcoutant.cNoLigne = fdetail.fdligne
      	fcoutant.cType = 11
      	fcoutant.cSousType = 0
      	fcoutant.cqte = lresultat
      	fcoutant.cCoutUnitaire = lCoutItem
      	fcoutant.ccouttotal = arrondi((lresultat * lCoutItem),2)* fdetail.fdqteafacturer
      	lCoutantTotalLigne+=fcoutant.ccouttotal
      	fcoutant.CFourniture = litem
      	fcoutant.cNoClient = facture.faclient
      	fcoutant.Cdatecommande = Facture.fadate
      	hajoute(Fcoutant)
      fin
      
      
      
      
      FcoutantLigne.cNoCommande = facture.fanumero
      FcoutantLigne.cNoLigne = fdetail.fdligne
      fcoutantligne.cdesc = fdetail.fddesc
      fcoutantligne.ctype = fdetail.ftype
      FcoutantLigne.ccouttotal = lCoutantTotalLigne
      FcoutantLigne.cNoClient = facture.faclient
      fcoutantligne.Cdatecommande = Facture.fadate
      hajoute(FcoutantLigne)
      
      
      
      
      
