          name : typecalcul
          identifier : 0x514f7ee56219c74b
          internal_properties : 
          properties :
           x : 5
           y : 38
           width : 235
           height : 24
          dropdown :
           internal_properties : 
           properties :
            width : 110
           type : 7
          type : 14
          code_elements :
           type_code : 23
           p_codes :
            -
              type : 35
              enabled : false
            -
              code : |1+
               reprisesaisie(commandetrn.cdcarreauv)
              type : 16
            -
              code : |1-
               _reponse est un entier
               
               si HLITRECHERCHE(typecarr,tcdescription,typecalcul..ValeurAffichée,hIdentique) alors
               	si pas ValideEpaisseurSpacerPourCarrelage(typecarr.TcEpaisseurMinimumSpacer) alors
               		
               		_reponse = ouvre(choixIntercalaireCarrelage)
               		selon _reponse
               			cas 1
               				reprisesaisie(cdespace)
               			cas 2
               				CDCARRELAGE = faux
               				cdnumcarr = ""
               				typecalcul = 0
               				carrelage_nom = ""
               				fddemicarrelage = 0
               				fddt = 0
               				fdvariablex = 0
               				fdvariablex1 = 0
               				fdDDH = 0
               				fdDDV = 0
               				intPrixmodifie = 0
               				CDCARREAUH = 0 
               				CDCARREAUV = 0
               				NOMBRE_DE_CARREAU = 0 
               				CDCARRPRIXUC = 0
               				CDCARRPRIXU = 0
               				CDPRIXDEBASECARRELAGE = 0
               				CDCARRPRIXTOTAL = 0
               				COMMANDE_CARRELAGE..etat = grise
               				reprisesaisie(BTN_OK_2)
               			cas 3
               				CDNUMCARR = ""
               				typecalcul = 0
               				CARRELAGE_NOM = ""
               				fddemicarrelage = 0
               				fdDt = 0
               				fdvariablex = 0
               				fdvariablex1 = 0
               				fdDDH = 0
               				fdDDV = 0
               				intPrixmodifie = 0
               				CDCARREAUH = 0 
               				CDCARREAUV = 0
               				NOMBRE_DE_CARREAU = 0 
               				CDCARRPRIXUC = 0
               				CDCARRPRIXU = 0
               				CDPRIXDEBASECARRELAGE = 0
               				CDCARRPRIXTOTAL = 0
               				reprisesaisie(cdnumcarr)	
               		fin
               	FIN
               fin
               si champencours() = "fddemicarrelage" alors Combo_Barrotin = typecarr.TBarrotin
               clederecherche est une chaine
               clederecherche = hconstruitvalcle(VariableXclient,noClientTypeCalcul,commandetrn.fclient,sansespace(typecalcul..ValeurAffichée))
               si moimeme..modifie alors //et pas modif alors
               	si hlitrecherche(VariableXclient,noClientTypeCalcul,clederecherche,hidentique) alors
               		si VariableXclient.VariableX=0 et VariableXclient.VariableX1=0 alors
               			HLITRECHERCHE(typecarr,tcdescription,sansespace(typecalcul..ValeurAffichée))
               			fdvariablex = TYPECARR.VariableUtil
               			fdvariablex1 = TYPECARR.VariableUtil1
               		sinon
               			fdvariablex = VariableXclient.VariableX
               			fdvariablex1 = VariableXclient.VariableX1
               			
               		FIN
               		
               		
               	sinon
               		HLITRECHERCHE(typecarr,tcdescription,sansespace(typecalcul..ValeurAffichée))
               		fdvariablex = TYPECARR.VariableUtil
               		fdvariablex1 = TYPECARR.VariableUtil1
               	FIN
               	Combo_Barrotin = typecarr.TBarrotin
               	
               	methodecalculcarr =typecarr.Typedessin
               	
               	DessineCarrelage()
               	typecalcul..Modifié = faux
               fin
               NOMBRE_DE_CARREAU = calcul_nb_carreau(methodecalculcarr)
              type : 33
