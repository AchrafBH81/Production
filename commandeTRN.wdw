               si commandeTRN.facalcul = 2 alors
                si contient(Milieu(MoiMême,Taille(MoiMême),1),[".","*","/","-","+"]) alors
                //si milieu(moimeme,taille(moimeme),1) = "." alors
               	moimeme = gauche(moimeme,taille(moimeme)-1)
               	moimeme..curseur = taille(moimeme)+1
                   bip()
               
                FIN
               sinon
               	SI Contient(Milieu(MoiMême,Taille(MoiMême),1),["*","-","+"]) ALORS
               		//si milieu(moimeme,taille(moimeme),1) = "." alors
               		MoiMême = Gauche(MoiMême,Taille(MoiMême)-1)
               		MoiMême..Curseur = Taille(MoiMême)+1
               		Bip()
               		
               	FIN
               	
               fin
               
               
