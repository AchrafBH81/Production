        -
          name : BTN_ANNULE_1
          identifier : 0x514f7ee53089c773
          internal_properties : 
          properties :
           x : 744
           y : 103
           width : 35
           height : 35
          type : 4
          code_elements :
           type_code : 4
           p_codes :
            -
              code : |1+
               //restaure_bouton()
               champ_reprise = champencours()
               
               selon champ_reprise
               
               cas "cdnumprod"
               
                si acso_message("Question","Terminer l'édition","OuiNon") = idyes alors
               //Code WinDev 5.5 remplacé par la migration :
               //   commande_detail..etat = grise
                  commande_detail..etat = grise; commande_detail..Visible=Vrai
                  
               //Code WinDev 5.5 remplacé par la migration :
               //   commande_carrelage..etat = grisé
                  commande_carrelage..etat = grisé; commande_carrelage..Visible=Vrai
               //Code WinDev 5.5 remplacé par la migration :
               //   fiche_det..etat = actif
                  fiche_det..etat = actif; fiche_det..Visible=Vrai
               //Code WinDev 5.5 remplacé par la migration :
               //   table_1..etat = inactif 
                  table_1..etat = AffichageSeulement; table_1..Visible=Vrai 
               //Code WinDev 5.5 remplacé par la migration :
               //   validation..etat = actif
                  validation..etat = actif; validation..Visible=Vrai
                  si table_1..vide alors
                     commandetrn.btn_ok..etat = grise	
                  FIN
               //Code WinDev 5.5 remplacé par la migration :
               //   boutoncouleur..etat = actif
                  boutoncouleur..etat = actif; boutoncouleur..Visible=Vrai
               //Code WinDev 5.5 remplacé par la migration :
               //   decko..etat = inactif
                  decko..etat = AffichageSeulement; decko..Visible=Vrai
                  //reprisesaisie("table_1")
                 commandetrn.fdhauteuru..VISIBLE = FAUX
                 commandetrn.fdlargeuru..VISIBLE = FAUX
                 cddesc..y = cdcomposant1..y+63
                 grpPeinture..etat = grise
                 grpPeinture..visible = faux
               //  TableSelectPlus(TABLE_1,1)
               //  ExécuteTraitement(table_1,trtEntréeLigne)
               TableRestaurePositionEtSélection(TABLE_1,gTablePosition)
                 si table_1..vide alors
                 	BTN_MODIFIE_DET..etat = grise
                 	BTN_DETRUIRE_DET..etat = grise
                 	
                 FIN
               
               reprisesaisie(btn_ok)
               FIN
               
               autres cas
                 si dmodif = Faux alors
                  hraz("trdetail")
                  raz_nom()
                 sinon
                 fin
               
                 fichierversecran("commandetrn","trdetail")
                 remplir_combo_type(trdetail.fdnumcarr)
                 typecalcul = trdetail.fdtypecalcul
                 gTablePosition = TableSauvePositionEtSélection(TABLE_1)
                 reprisesaisie("cdnumprod")
                 
                 
                 fin
               
              type : 18
            -
              type : 161
              enabled : false
        -
          name : BTN_OK_2
          identifier : 0x514f7ee52c43c7af
          internal_properties : 
          properties :
           x : 744
           y : 65
           width : 35
           height : 35
          type : 4
          code_elements :
           type_code : 4
           p_codes :
            -
              code : |1+
               selontypedeproduit est un entier
               //restaure_bouton()
               HDESACTIVEFILTRE(typecarr)
               AvecProduitSpeciaux=Faux
               AvecProduitSpeciauxPartiel = Faux
               nComposant = 0
               ncomposantpartiel = 0
               ValideLgneCommande(typedeproduit) 
               selon typedeproduit
               
               	cas "Verre"
               
               		
               		
               		selontypedeproduit = 1
               		si cdnumprod = "" et cdcomposant1 = "" et cdcomposant2 = "" et cdcomposant3 = "" alors
               			//Code WinDev 5.5 remplacé par la migration :
               			//		erreur(MessTraduit(2003))   //2003:Il faut au moins un numéro de prod...
               			erreur(<§$0003§>)   //2003:Il faut au moins un numéro de prod...
               			reprisesaisie("cdnumprod")
               		FIN
               		
               		si cdcomposant1 <> "" ou cdcomposant2 <> "" ou cdcomposant3 <> "" alors
               			si cdlargeur = "" alors
               				//Code WinDev 5.5 remplacé par la migration :
               				//			erreur(MessTraduit(2004))		   //2004:Veuillez indiquer la largeur
               				erreur(<§$0004§>)		   //2004:Veuillez indiquer la largeur
               				reprisesaisie("cdlargeur")
               			fin
               			si cdhauteur = "" alors
               				//Code WinDev 5.5 remplacé par la migration :
               				//			erreur(MessTraduit(2005))		   
               				erreur(<§$0005§>)		   
               				reprisesaisie("cdhauteur")
               			fin
               		FIN
               		si cdqte = 0 alors
               			//Code WinDev 5.5 remplacé par la migration :
               			//		erreur(MessTraduit(2006))   //2006:La quantité ne peut etre égale à z...
               			erreur(<§$0006§>)   //2006:La quantité ne peut etre égale à z...
               			reprisesaisie("cdqte")
               		FIN
               		
               		si cdcarrelage alors
               			si cdnumcarr = "" alors
               				//Code WinDev 5.5 remplacé par la migration :
               				//			erreur(MessTraduit(2007))   //2007:Numéro de carrelage obligatoire
               				erreur(<§$0007§>)   //2007:Numéro de carrelage obligatoire
               				reprisesaisie("cdnumcarr")
               			fin	
               			si cdcarreauv = 0 alors
               				//Code WinDev 5.5 remplacé par la migration :
               				//			erreur(MessTraduit(2008))   //2008:Veuillez inscrire le nombre de carr...
               				erreur(<§$0008§>)   //2008:Veuillez inscrire le nombre de carr...
               				reprisesaisie("cdcarreauv")
               			fin
               			si cdcarreauh = 0 alors
               				//Code WinDev 5.5 remplacé par la migration :
               				//			erreur(MessTraduit(2008))   //2008:Veuillez inscrire le nombre de carr...
               				erreur(<§$0008§>)   //2008:Veuillez inscrire le nombre de carr...
               				reprisesaisie("cdcarreauh")
               			fin
               			
               		FIN
               		
               		si fddemicarrelage alors
               			si val(fddt) = 0 alors
               				
               				Erreur("La valeur du dth ne doit pas être 0")
               				RepriseSaisie("fddt")
               				
               			FIN
               		FIN
               		
               	cas "Carrelage"
               		selontypedeproduit = 4
               		si cdqte = 0 alors
               			//Code WinDev 5.5 remplacé par la migration :
               			//		erreur(MessTraduit(2006))   //2006:La quantité ne peut etre égale à z...
               			erreur(<§$0006§>)   //2006:La quantité ne peut etre égale à z...
               			reprisesaisie("cdqte")
               		FIN
               		si invent.isaisiedimension alors
               			si cdlargeur = "" alors
               				//Code WinDev 5.5 remplacé par la migration :
               				//		erreur(MessTraduit(2004))		   //2004:Veuillez indiquer la largeur
               				erreur(<§$0004§>)		   //2004:Veuillez indiquer la largeur
               				reprisesaisie("cdlargeur")
               			fin
               			si cdhauteur = "" alors
               				//Code WinDev 5.5 remplacé par la migration :
               				//		erreur(MessTraduit(2005))		   
               				erreur(<§$0005§>)		   
               				reprisesaisie("cdhauteur")
               			fin
               		fin
               		
               		si nombre_de_carreau = 0 alors
               			si cdcarreauv = 0 alors
               				//Code WinDev 5.5 remplacé par la migration :
               				//			erreur(messtraduit(2008))   //2008:Le nombre de carreau ne peut pas être égal à z...
               				erreur(<§$0008§>)   //2008:Le nombre de carreau ne peut pas être égal à z...
               				reprisesaisie("cdcarreauv")
               			FIN
               			si cdcarreauh = 0 alors
               				//Code WinDev 5.5 remplacé par la migration :
               				//			erreur(MessTraduit(2008))   //2008:Veuillez inscrire le nombre de carr...
               				erreur(<§$0008§>)   //2008:Veuillez inscrire le nombre de carr...
               				reprisesaisie("cdcarreauh")
               			fin
               		FIN
               		
               		
               	cas "Unite"
               		selontypedeproduit = 2
               		si cdqte = 0 alors
               			//Code WinDev 5.5 remplacé par la migration :
               			//		erreur(MessTraduit(2006))   //2006:La quantité ne peut etre égale à z...
               			erreur(<§$0006§>)   //2006:La quantité ne peut etre égale à z...
               			reprisesaisie("cdqte")
               		FIN
               		
               	cas "Verreunite"
               		selontypedeproduit = 2
               		si cdqte = 0 alors
               			//Code WinDev 5.5 remplacé par la migration :
               			//		erreur(MessTraduit(2006))   //2006:La quantité ne peut etre égale à z...
               			erreur(<§$0006§>)   //2006:La quantité ne peut etre égale à z...
               			reprisesaisie("cdqte")
               		FIN
               	cas "Spacer"
               		selontypedeproduit = 3
               		si cdqte = 0 alors
               			erreur(<§$0006§>)   //2006:La quantité ne peut etre égale à z...
               			reprisesaisie("cdqte")
               		FIN
               	cas "Peinture","PeintureUnite"
               		selontypedeproduit = 5
               		si cdqte = 0 alors
               			erreur(<§$0006§>)   //2006:La quantité ne peut etre égale à z...
               			reprisesaisie("cdqte")
               		FIN
               fin	
               
               CalculSurchargeTaux()
               
               ecranversfichier(commandetrn,trdetail)
               
               POUR i = 1 À 3
               	SI SansEspace({"commandetrn.cdcomposant"+i,indChamp}) <> "" ALORS 
               		ncomposant++
               	FIN
               	SI HLitRecherche(invent,INUM,{"commandetrn.cdcomposant"+i,indchamp}) ALORS
               		SI invent.IproduitSpecial ALORS
               			nComposantpartiel++
               			AvecProduitSpeciauxPartiel = Vrai
               		FIN
               
               	FIN
               FIN
               SI ncomposant <> 0 _ET_ nComposantpartiel = ncomposant ALORS AvecProduitSpeciaux = Vrai
               
               si trdetail.fdcarrelage alors  trdetail.FDdesccarr = CARRELAGE_NOM sinon trdetail.FDdesccarr = ""
               
               
               messagelignedejaaffiche = ValideAlerte(1,messagelignedejaaffiche)
               
               
               trdetail.FDmessageAffiche = messagelignedejaaffiche
               trdetail.fdbase = commandetrn.pdebase
               miseajour_fdetail(selontypedeproduit)
               
               
               
               
               
               
               
              type : 18
            -
              type : 161
              enabled : false
        -
