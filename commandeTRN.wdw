          name : fddemicarrelage
          identifier : 0x514f7ee545e9c755
          internal_properties : 
          properties :
           x : 6
           y : 65
           width : 61
           height : 23
          options :
           -
             internal_properties : CQAAAAkAAABT571lBLRagFTPuPKcrfkAKdVAnPu4lHNLAg8OSI2SfTArs1Pjwi23XuBPooLlAt+NAUtF61dkvEkHtBeX810g4gm9TxyLKGgLS9B7kxyCL4LeQBZYu2hmQZJmQ0AjchapiIyjcyewf5Y9/mLBLGO+0/YD3Gx3
          type : 5
          controls : []
          code_elements :
           type_code : 5
           p_codes :
            -
              code : |1-
               
              type : 15
            -
              code : |1-
               
              type : 16
            -
              code : |1+
               si fddemicarrelage ALORS 
               	
               	commandeTRN.Combo_Barrotin..Visible = Vrai 
               	//	commandeTRN.Combo_Barrotin..etat = actif 
               	//	FichierVersEcran("commandetrn","trdetail")
               	
               	si champencours() = "fddemicarrelage" alors 
               		commandetrn.cDextraCarrelagedemi..etat = actif
               		remplir_combo_type(CDNUMCARR,fddemicarrelage)
               	fin
               	
               	
               	
               	//	si commandetrn.cDextraCarrelagedemi= 0 ALORS
               	si pas intPrixExtraDemiModifie alors commandeTRN.cDextraCarrelagedemi=TrouveExtraDemi(sansespace(client.numero))
               	//		commandeTRN.cDextraCarrelagedemi=Client.Cextracarrelagedemi
               	ExécuteTraitement(cDextraCarrelagedemi,trtSortie)
               	ExécuteTraitement(cdnumcarr,trtSortie)
               	
               	calcul_prix_carr()
               	DessineCarrelage()
               	//		REPRISESAISIE(COMMANDETRN.FDDT)
               	//	sinon
               	//		ValeurExtraDemi = 0
               	//		ExécuteTraitement(cDextraCarrelagedemi,trtSortie)
               	//		ExécuteTraitement(CDNUMCARR,trtSortie)   
               	//		commandeTRN.cDextraCarrelagedemi = 0
               	//
               	//		calcul_prix_carr()
               	//		DessineCarrelage()
               	////		RepriseSaisie(commandeTRN.fdDt)
               	//		
               	//	FIN
               sinon
               	commandeTRN.Combo_Barrotin..Visible = faux
               	//	commandeTRN.Combo_Barrotin..Etat = Inactif 
               	commandeTRN.Combo_Barrotin = 0 
               	
               	
               	ValeurExtraDemi = 0
               	SI ChampEnCours() = "fddemicarrelage" ALORS 
               		commandeTRN.cDextraCarrelagedemi=0
               		commandeTRN.cDextraCarrelagedemi..Etat = Grisé
               		commandeTRN.cDextraBarrotin=0
               		commandeTRN.cDextraBarrotin..Etat = Grisé
               		remplir_combo_type(CDNUMCARR,fddemicarrelage)
               	FIN
               	ExécuteTraitement(cDextraCarrelagedemi,trtSortie)
               	ExécuteTraitement(CDNUMCARR,trtSortie)
               	calcul_prix_carr()
               	DessineCarrelage()
               	intPrixExtraDemiModifie = Faux
               FIN
               
               
              type : 17
        -
          name : cDextraCarrelagedemi
          identifier : 0x514f7ee56274c755
          internal_properties : 
          properties :
           x : 484
           y : 48
           width : 134
           height : 24
          type : 2
          code_elements :
           type_code : 3
           p_codes :
            -
              code : |1-
               
               ValeurExtraDemi = MoiMême
              type : 15
            -
              code : |1+
               
               SI PAS MoiMême = ValeurExtraDemi _ou_ moimeme = 0 ALORS
               	si pas client.CalculCarrPied alors
               		cdcarrprixu = (moimeme+commandetrn.CDCARRPRIXUC) * nombre_de_carreau 
               		cdcarrprixtotal = (cdcarrprixu * cdqte) + (cdprixdebasecarrelage * commandetrn.cdqte)
               		si pas commandetrn.cdcarrelage alors
               			cdprixu = (moimeme+commandetrn.CDCARRPRIXUC) * nombre_de_carreau
               			cdprixtot = (cdcarrprixu * cdqte) + (cdprixdebasecarrelage * commandetrn.cdqte)	  
               		FIN
               		si moimeme..Modifié alors
               			intPrixExtraDemiModifie = vrai
               			ExécuteTraitement(intPrixExtraDemiModifie,trtModification)
               		FIN
               	sinon
               		cdcarrprixu =(moimeme+commandetrn.CDCARRPRIXUC) * trdetail.fdpiedcarrefacture 
               		cdcarrprixtotal = (cdcarrprixu * cdqte)
               		si moimeme..Modifié alors
               			intPrixExtraDemiModifie = vrai
               			ExécuteTraitement(intPrixExtraDemiModifie,trtModification)
               		FIN
               		reprisesaisie(fdextraforme)
               	
               	fin
               FIN
              type : 16
