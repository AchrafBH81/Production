               //SI PAS moimeme = ValeurLargeur ALORS
               	commandetrn.fdlargeura = moimeme
               	
               	selon commandetrn.facalcul
               		cas 1
               			SI PAS CONVERTiraNGLAIS(MOIMEME) ALORS
               				REPRISESAISIE
               			FIN
               			commandetrn.fdlargeuranglais = commandetrn.fdlargeura
               
               			verifieMaximum(Val(commandeTRN.CDLARGEUR),Val(commandeTRN.CDHAUTEUR))
               		cas 2
               //		commandeTRN.fdlargeuranglais = calcul_anglais(MoiMême)
               		commandeTRN.fdlargeuranglais = MillimiterToInchFraction(moimeme)
               		
               			SI PAS CONVERT_metrique() ALORS
               				REPRISESAISIE
               			FIN
               			verifieMaximum(Val(commandeTRN.fdlargeura)/25.4,Val(commandeTRN.fdhauteura)/25.4)
               	fin	
               	
               	calcul_prixu(commandetrn.facalcul,escompteqte,pourcescompteqte)
               	calculenergieligneencours()
               //fin
               
               RepriseSaisie(CDHAUTEUR)
