     name : AffichageInfo
     procedure_id : 5859041163738728257
     type_code : 14
     code : |1+
      Procédure AffichageInfo(lNumLigne=0,Libcolonne="",ltoucheenfoncee=0)
      
      
      selon ltoucheenfoncee
      	// aucune touche 
      	cas 0
      		RemplirTableContact(lNumLigne,Libcolonne,ltoucheenfoncee)
      		// Touche Shift
      	cas 1
      		selon Onglet1
      			cas 1
      				Remplirtableinfo(lNumLigne,Libcolonne,ltoucheenfoncee,table.FACLIENTTable[lNumLigne])
      			cas 2
      				Remplirtableinfo(lNumLigne,Libcolonne,ltoucheenfoncee,table1.FACLIENT1[lNumLigne])
      		fin
      
      
      FIN
      
      
      
      
      
     type : 458752
   -
     name : verifieMaximum1
     procedure_id : 5859041162427090753
     type_code : 14
     code : |1+
      Procédure verifieMaximum1(ldimension,ltype="Largeur")
      DimensionSuivante est un booleen = faux
      decision est un entier
      produitremplacement est une chaine
      composantrempl1 est une chaine = commandetrn.cdcomposant1
      composantrempl2 est une chaine = commandetrn.cdcomposant2
      composantrempl3 est une chaine = commandetrn.cdcomposant3
      saveccap est un booleen = faux
      savecgaz est un booleen = faux
      cleaveccap est une chaine
      cleavecgaz est une chaine
      
      si produitfixe alors
      	renvoyer vrai
      FIN
      pour i = 1 a 3
      	si pas sansespace({"commandetrn.CDCOMPOSANT"+i}) = "" alors
      		si hlitrecherche(invent,inum,{"commandetrn.CDCOMPOSANT"+i}) alors
      			{"composantrempl"+i} = invent.ipsuivant
      			selon ltype
      				cas "Largeur"
      					si invent.ilargeurmax < ldimension alors
                             DimensionSuivante = vrai
      					FIN
      				cas "Hauteur"
      					si invent.ihauteurmax < ldimension alors
      
                            DimensionSuivante = vrai
      					FIN
      			FIN
      		FIN
      	fin
      FIN
      hlitrecherche("persoens","ennumero",commandetrn.cdnumprod)
      si pas HEnDehors() et HTrouve() alors
      	saveccap = persoens.encap
      	savecgaz = persoens.engaz
      FIN
      hconvertc(cleaveccap,saveccap)
      hconvertc(cleavecgaz,savecgaz)
      
      
      HLITRECHERCHE("persoens","clecomposantcapgaz",COMPLETE(composantrempl1,10)+COMPLETE(composantrempl2,10)+COMPLETE(composantrempl3,10)+cleaveccap+cleavecgaz)
      //Code WinDev 5.5 remplacé par la migration :
      //SI PAS H.ENDEHORS ET H.TROUVE ALORS
      SI PAS HEnDehors() ET HTrouve() ALORS
      	produitremplacement = SANSESPACE(persoens.ennumero)
      
      FIN
      
      
      si DimensionSuivante alors
      	decision = ouvre("Choixproduit",commandetrn.cdnumprod,commandetrn.cdcomposant1,commandetrn.cdcomposant2,...
      	commandetrn.cdcomposant3,produitremplacement,composantrempl1,composantrempl2,...
      	composantrempl3,"commandetrn")
      	selon decision
      
      		cas 1
      			commandetrn.composant1_nom  = ""
      			commandetrn.composant2_nom  = ""
      			commandetrn.composant3_nom  = ""
      			clicbouton = vrai
      			premierefois = vrai
      			produitfixe = faux
      			reprisesaisie("commandetrn.cdnumprod")
      		cas 2
      			produitfixe = vrai
      		cas 3
      			commandetrn.cdnumprod = ""
      			commandetrn.cdcomposant1 = ""
      			commandetrn.cdcomposant2 = ""
      			commandetrn.cdcomposant3 = ""
      			commandetrn.composant1_nom  = ""
      			commandetrn.composant2_nom  = ""
      			commandetrn.composant3_nom  = ""
      			produitfixe = faux
      			reprisesaisie("commandetrn.cdnumprod")
      	fin
      
      FIN
      
      
     type : 458752
   -
     name : CalculPrixUintercalaire
     procedure_id : 5859041163765860161
     type_code : 14
     code : |1+
      Procédure CalculPrixUintercalaire(ladimension)
      resultat est un reel = 0
      
      si pas dmodif alors
      	si sansespace(commandetrn.cdespace) <> "" alors
      		si hlitrecherche(spacer,stypeSnumero,HConstruitValClé(spacer,stypeSnumero,type_intercallaire[[1 a ]],sansespace(commandetrn.cdespace))) alors
      			selon commandetrn.facalcul
      				cas 1
      					resultat += spacer.sprixa
      				cas 2
      					resultat += spacer.sprixm
      			fin
      		fin
      	fin	
      
      
      	si sansespace(commandetrn.cdespace2) <> "" alors
      		si hlitrecherche(spacer,stypeSnumero,HConstruitValClé(spacer,stypeSnumero,type_intercallaire[[1 a ]],sansespace(commandetrn.cdespace2))) alors
      			selon commandetrn.facalcul
      				cas 1
      					resultat += spacer.sprixa
      				cas 2
      					resultat += spacer.sprixm
      			fin
      		fin
      	fin	
      	commandetrn.CDPRIXUPIED = resultat
      sinon
      	resultat = commandetrn.CDPRIXUPIED
      fin
      
      commandetrn.cdprixu = arrondi(resultat,2) * arrondi(ladimension,2) 
      commandetrn.cdprixtot = arrondi(commandetrn.cdprixu,2)  * commandetrn.cdqte
      trdetail.fdpiedcarrefacture = ladimension
      
      
      renvoyer 0
     type : 458752
   -
     name : calculenergieligneencours
     procedure_id : 5859041164080498497
     type_code : 14
     code : |1+
      Procédure calculenergieligneencours()
      commandetrn.surchargeenergie=0
      
      si commandetrn.casesurchargeenergie alors
      	si commandetrn.typedeproduit = "Verre"	alors
      
      		si pas trdetail.fdintercalaire alors
      			commandetrn.surchargeenergie += arrondi((commandeTRN.cdprixu+commandetrn.FDextra10X+commandetrn.FDextra5x) * commandetrn.cdqte,2) * commandetrn.surchargebase / 100 //+ ...
      			commandetrn.surchargeenergie += arrondi(commandetrn.cdcarrprixtotal,2)  * commandetrn.surchargecarrelage / 100
      			commandetrn.surchargeenergie += arrondi(commandetrn.fdextraforme * commandetrn.cdqte,2)  * commandetrn.surchargeforme / 100
      		sinon
      			trdetail.surchargeenergie = 0
      		fin
      
      	sinon
      		si commandetrn.typedeproduit = "Verreunite" alors
      			commandetrn.surchargeenergie += commandeTRN.cdprixu * commandetrn.cdqte * commandetrn.surchargebase / 100
      		fin
      	fin
      
      sinon
      
      	commandetrn.surchargeenergie = 0
      FIN
      
      
      
      
      
      
      
     type : 458752
   -
     name : TrouvePourcSurcharge
     procedure_id : 5859041163736434497
     type_code : 14
     code : |1+
      Procédure TrouvePourcSurcharge()
      
      
      si client.surcharge alors
      	si client.csurchargebase <> 0 alors
      		surchargebase = client.csurchargebase
      	sinon
      //		surchargebase = config.surchargebase
      		surchargebase = gclconfig.m_rsurchargebase
      	FIN
      sinon
      	surchargebase=0
      fin
      
      
      si client.surchargeverreunite alors
      	si client.csurchargeverreunite <>0 alors
      		surchargeverreunite = client.csurchargeverreunite
      	sinon
      //		surchargeverreunite = config.surchargeverreunite
      		surchargeverreunite = gclconfig.m_rsurchargeverreunite
      	FIN
      sinon
      	surchargeverreunite = 0
      fin
      
      
      si client.SUrchargeforme alors
      	si client.Csurchargeforme <>0 alors
      		surchargeforme = client.csurchargeforme
      	sinon
      //		surchargeforme = config.SUrchargeforme
      		surchargeforme = gclconfig.m_nSUrchargeforme
      	FIN
      sinon
      	surchargeforme = 0
      fin
      
      si client.SUrchargecarrelage alors
      	si client.csurchargecarrelage <>0 alors
      		surchargecarrelage = client.Csurchargecarrelage
      	sinon
      		surchargecarrelage= gclconfig.m_rSUrchargecarrelage
      //		surchargecarrelage= config.SUrchargecarrelage
      	FIN
      sinon
      	surchargecarrelage = 0
      fin
      
      
      //SI config.SUrchargeTauxActive _ET_ Client.SUrchargeTaux ALORS
      	SI gclconfig.m_bSUrchargeTauxActive _ET_ Client.SUrchargeTaux ALORS
      		si client.CSurchargeTauxBase <> 0 alors
      		SurchargeTauxClient = client.CSurchargeTauxBase
      	sinon
      //		SurchargeTauxClient = config.SurChargeTauxBase
      		SurchargeTauxClient = gclconfig.m_rSurChargeTauxBase
      	fin	
      sinon
      	surchargetauxclient = 0
      FIN
     type : 458752
   -
     name : ValideEpaisseurSpacerPourCarrelage
     procedure_id : 5859041162961012545
     type_code : 14
     code : |1+
      Procédure ValideEpaisseurSpacerPourCarrelage(lepaisseur =0)
      
      si lepaisseur = 0 alors renvoyer vrai
      si commandetrn.COMMANDECREDIT = 3 _ET_ Combo_typespac = 0 alors renvoyer vrai
      si lepaisseur < EpaisseurIntercalaire1 ou EpaisseurIntercalaire1 = 0 alors renvoyer vrai
      si lepaisseur < EpaisseurIntercalaire2 ou EpaisseurIntercalaire2 = 0 alors renvoyer vrai
      
      renvoyer faux
     type : 458752
   -
     name : getTauxTaxes
     procedure_id : 5859041163617748801
     type_code : 14
     code : |1+
      Procédure getTauxTaxes()
      reqsql est une source de données
      reqtxt est une chaine = "select * from taxegroupedatetaux where idtaxegroupedate = '%1' order by ordre"
      cpt est un entier = 0
      TaxeTaux1 = 0
      TaxeTaux2 = 0
      TaxeDesc1 = ""
      TaxeDesc2 = ""
      TaxeCalcul2sur1 = faux
      
      
      si client.IDTaxeGroupe <> 0 alors
      	si hlitrecherche(TaxeGroupe,IDTaxeGroupe,client.IDTaxeGroupe) ALORS
      		hlitrecherche(TaxeGroupeDate,IDTaxeGroupe,TaxeGroupe.IDTaxeGroupe)
      		tantque pas hendehors(TaxeGroupeDate) et TaxeGroupeDate.IDTaxeGroupe = TaxeGroupe.IDTaxeGroupe
      			si commandetrn.fadate >= taxegroupedate.DateDebut et commandetrn.fadate <= taxegroupedate.DateFin alors
      			
      				HExécuteRequêteSQL(reqsql,hRequêteDéfaut,chaineconstruit(reqtxt,taxegroupedate.IDTaxeGroupeDate))
      				pour tout reqsql
      					cpt++
      					{"taxetaux"+cpt} = reqsql.Taux
      					{"TaxeDesc"+cpt} = reqsql.Description
      					si cpt=2 alors  TaxeCalcul2sur1 = reqsql.Combine
      				FIN
      				
      			FIN
      		    hlitsuivant(TaxeGroupeDate,IDTaxeGroupe)
      		
      		FIN
      		
      	FIN
      FIN
      
      
      
     type : 458752
   -
     name : remplirTableauIntercalaireOld
     procedure_id : 1460765329994588027
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] remplirTableauIntercalaireOld (<Combo_typespac>, <lespacetotale>)
      //
      // Paramètres :
      //	Combo_typespac : <indiquez ici le rôle de Combo_typespac>
      //	lespacetotale : <indiquez ici le rôle de lespacetotale>
      // Valeur de retour :
      // 	chaîne : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE remplirTableauIntercalaireOld(Combo_typespac,lespacetotale)
      
      
      reqsql est un source de donnees
      txtsql est une chaine = "select * from IntercalaireCouleurDimensions where IDIntercalaireCouleurs = %1 order by dimensioni"
      txtsql = ChaîneConstruit(txtsql,Combo_typespac)
      tabDimensioncroise est un tableau de 0 par 2 chaines
      tabdimension est un tableau de 0 par 2 chaine
      tabdimensionChoix est un tableau de 0 par 2 chaine
      Dimensionatrairer est une chaine = ""
      lchaine est une chaine 
      difference est un entier
      
      
      cpt est un entier = 1
      cpt1 est un entier = 1
      si HExécuteRequêteSQL(reqsql,hRequêteDéfaut,txtsql) alors
      	pour TOUT reqsql 
      		dimension(tabdimension,cpt,2)
      		tabdimension[cpt,1] = reqsql.numero
      		tabdimension[cpt,2] = numeriqueverschaine(arrondi(reqsql.dimensioni,3))
      		cpt++
      	FIN
      sinon
      	info(herreurinfo(hErrComplet))
      FIN
      
      pour cpt = 1 _a_ dimension(tabdimension)/2
      	pour cpt1 = cpt _a_ Dimension(tabdimension)/2
      		tableauajouteligne(tabDimensioncroise,tabdimension[cpt,1]+","+tabdimension[cpt1,1] , numeriqueverschaine(val(tabdimension[cpt,2]) +   Val(tabdimension[cpt1,2])))
      		
      	FIN
      FIN
      tableautrie(tabDimensioncroise,ttCroissant,2)
      pour cpt = 1 _a_ dimension(tabDimensioncroise)
      	
      	si tabDimensioncroise[cpt,2] > lespacetotale ALORS
      		si cpt = 1 alors renvoyer lchaine
      		TableauAjouteLigne(tabdimensionChoix,tabDimensioncroise[cpt-1,1],tabDimensioncroise[cpt-1,2])
      		Dimensionatrairer = tabDimensioncroise[cpt-1,2]
      		cpt1 = cpt-2
      		si cpt1 > 0 alors
      			BOUCLE
      				si tabDimensioncroise[cpt1,2] = Dimensionatrairer alors
      					TableauAjouteLigne(tabdimensionChoix,tabDimensioncroise[cpt1,1],tabDimensioncroise[cpt1,2])
      					cpt1-=1
      					si cpt1 = 0 alors sortir
      				sinon
      					sortir
      				FIN
      			FIN
      		fin
      		sortir
      	FIN
      	
      FIN
      
      si dimension(tabdimensionChoix)/2 > 1 alors
      	lchaine = ouvre(ChoixDimensionIntercalaire,tabdimensionChoix,0)
      sinon si dimension(tabdimensionChoix) /2 = 1
          lchaine = sansespace(tabdimensionChoix[1,1])
      FIN
      
      renvoyer lchaine
      
      
      
      
      
      
      
      
      
      
      
     type : 458752
   -
     name : TrouveExtraDemi
     procedure_id : 1461861654735456404
     type_code : 14
     code : |1-
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //[ <Résultat> = ] TrouveExtraDemi (<noclient>)
      //
      // Paramètres :
      //	noclient : <indiquez ici le rôle de noclient>
      // Valeur de retour :
      // 	réel : // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE TrouveExtraDemi(noclient)
      valeuraretourner est un reel = 0
      si hlitrecherche(ProduitClient,IdClientIdproruit,HConstruitValClé(ProduitClient,IdClientIdproruit,noclient,gNoExtraDemi)) _et_ PRODUITCLIENT.IPprixSpecial alors
      	valeuraretourner =  produitclient.IPrixa
      sinon si hlitrecherche(invent,inum,gNoExtraDemi) alors
      	si hlitrecherche(invent,INUM,gNoExtraDemi) alors
      		valeuraretourner = invent.iprixcarreau
      	fin
      	
      FIN
      
      renvoyer valeuraretourner
     type : 458752
   -
     name : ValideLgneCommande
     procedure_id : 1480679976655468143
     type_code : 14
     code : |1+
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      //ValideLgneCommande ( [<_type>])
      //
      // Paramètres :
      //	_type (valeur par défaut="") : <indiquez ici le rôle de Param1>
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE ValideLgneCommande(_type = "")
      DefenirTypeVerre()
      
      
      
      selon _type
      	cas "Verre"
      		si commandetrn.CDCARRELAGE alors
      			si sansespace(commandetrn.typecalcul) =  "" alors
      				ACSO_message("Erreur","Vous devez entrer un type de calcul","Erreur")
      				RepriseSaisie(commandeTRN.CDNUMCARR)
      				
      			FIN
      		FIN
      		
      		
      		selon commandeTRN.nbverre 
      			cas "double"
      				SI Combo_typespac  < 1 _et_ commandetrn.COMMANDECREDIT <> 3 ALORS
      					ACSO_message("Erreur","Vous devez entrer un type d'intercalaire","Erreur")
      					RepriseSaisie(Combo_typespac)
      					
      				FIN
      				SI DFINI = "" _et_ pas commandetrn.commandecredit = 3 ALORS 
      					ACSO_message("Erreur","Vous devez entrer une dimension pour le fini","Erreur")
      					RepriseSaisie(DFINI)
      				FIN
      				si (commandetrn.cdespace = "" ET PAS commandeTRN.COMMANDECREDIT = 3) _ou_ (sansespace(commandeTRN.CDESPACE) = "" _et_ commandeTRN.COMMANDECREDIT = 3 _et_ commandetrn.dfini <> "") alors
      					ACSO_message("Erreur","Vous devez entrer un intercalaire","Erreur")
      					RepriseSaisie(commandetrn.CDESPACE)
      				FIN
      				
      			cas "triple"
      				SI Combo_typespac  < 1 _ET_ commandeTRN.COMMANDECREDIT <> 3 ALORS
      					ACSO_message("Erreur","Vous devez entrer un type d'intercalaire","Erreur")
      					RepriseSaisie(Combo_typespac)
      					
      				FIN
      				SI DFINI = "" _ET_ PAS commandeTRN.COMMANDECREDIT = 3 ALORS 
      					ACSO_message("Erreur","Vous devez entrer une dimension pour le fini","Erreur")
      					RepriseSaisie(DFINI)
      				FIN
      				SI (commandeTRN.CDESPACE = "" ET PAS commandeTRN.COMMANDECREDIT = 3) _OU_ (SansEspace(commandeTRN.CDESPACE) = "" _ET_ commandeTRN.COMMANDECREDIT = 3 _ET_ commandeTRN.DFINI <> "") ALORS
      //					SI commandeTRN.CDESPACE = "" ALORS
      					ACSO_message("Erreur","Vous devez entrer un intercalaire","Erreur")
      					RepriseSaisie(commandeTRN.CDESPACE)
      				FIN
      				SI (commandeTRN.CDESPACE2 = "" ET PAS commandeTRN.COMMANDECREDIT = 3) _OU_ (SansEspace(commandeTRN.CDESPACE2) = "" _ET_ commandeTRN.COMMANDECREDIT = 3 _ET_ commandeTRN.DFINI <> "") ALORS
      	//				SI commandeTRN.CDESPACE2 = "" ALORS
      					ACSO_message("Erreur","Vous devez entrer un 2ième intercalaire","Erreur")
      					RepriseSaisie(commandeTRN.CDESPACE2)
      				FIN
      				
      			AUTRE CAS
      				SI cdnumprod = "" ALORS 
      					ACSO_message("Erreur","Vous devez entrer un numéro de produit","Erreur")
      					RepriseSaisie(cdnumprod)
      				FIN
      		FIN
      	cas "Peinture"
      		
      	autres cas
      		SI cdnumprod = "" ALORS 
      			ACSO_message("Erreur","Vous devez entrer un numéro de produit","Erreur")
      			RepriseSaisie(cdnumprod)
      		FIN
      		
      FIN
      
      
      
      
     type : 458752
   -
     name : SauveDocumentArchive
     procedure_id : 1481566135928830719
     type_code : 14
     code : |1+
      Procédure SauveDocumentArchive(ltexte,lsujet,ltypedocument,lfichierattache,ldestinataire)
      
      ArchiveEmail.dateEmail = DateHeureSys()
      ArchiveEmail.noClient = complete(client.numero,10)
      ArchiveEmail.ltexte = SansEspace(ltexte)
      ArchiveEmail.lSujet = SansEspace(lsujet)
      ArchiveEmail.lTypeDocument = ltypedocument
      ArchiveEmail.lFichierAttaché = lfichierattache
      ArchiveEmail.lDestinataire = ldestinataire
      hajoute(ArchiveEmail)		
      
      
      
     type : 458752
   -
     name : DefenirTypeVerre
     procedure_id : 1636540392740980663
     type_code : 14
     code : |1-
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      // DefenirTypeVerre ()
      //
      // Paramètres :
      //	Aucun
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // Indiquez ici un exemple d'utilisation.
      //
      PROCEDURE DefenirTypeVerre()
      
      IndiceNbVerre = 0
      SI commandeTRN.CDCOMPOSANT1 <> "" ALORS
      	IndiceNbVerre = IndiceNbVerre + 1
      	
      FIN
      SI commandeTRN.CDCOMPOSANT2 <> "" ALORS
      	IndiceNbVerre = IndiceNbVerre + 1
      	
      FIN
      SI commandeTRN.CDCOMPOSANT3 <> "" ALORS
      	IndiceNbVerre = IndiceNbVerre + 1
      	
      FIN
      
      SELON IndiceNbVerre
      	CAS 1 
      		commandeTRN.nbverre = "simple"
      		CDVERREUNITE  = Vrai
      	CAS 2 
      		commandeTRN.nbverre = "double"
      	CAS 3 
      		commandeTRN.nbverre = "triple"
      		
      	AUTRE CAS
      		commandeTRN.nbverre = ""
      		
      FIN
     type : 458752
