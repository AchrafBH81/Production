         		// Métrique
         		CAS 2
         			commandeTRN.facalcul = 1
         			BtnTypeSaisie..Libellé = "A"
         	FIN
         sinon
         	erreur("Impossible de basculer de mode , Des lignes de commandes existent ")
         fin
        type : 18
      -
        type : 161
        enabled : false
