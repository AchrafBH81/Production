  p_codes :
   -
     code : |1+
      procedure fcommentaire(lCommentaire = "",lOuverture = "M",nEtat est un entier sur 2 octets = 0)
      si lCommentaire = "" alors
      	lcommentaire =  client.clangue = 1 ?  "SOUMISSION VALIDE 30 JOURS" sinon "QUOTE VALID FOR 30 DAYS"
      FIN
      
      
      
   -
     code : |1-
      	fcommentaire.csCommentaire = lCommentaire
      
      si louverture <> "M" alors
      	fcommentaire.csCommentaire..etat = inactif
      	
      FIN
     type : 34
