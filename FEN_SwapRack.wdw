 code_elements :
  type_code : 1
  p_codes :
   -
     code : |1-
      PROCEDURE MaFenêtre(gnNoCamion est un entier,gnNoRack est un entier,gtaAllTruck est un tableau associatif de STAllTruck,gbIsSameCustomer est un booleen)
      
      gbTruckNumberChange est un booleen = Faux
      
      gstCamion est un STAllTruck
      gbChangeTruck est un booleen   //  pour savoir si le numéro de camion à été modifié
      
      pour chaque stCamion,sKeyTruck de gtaAllTruck
      	si stcamion.taAllTruckRack..occurrence <> 0 alors
      		
      		COMBO_camion.ajoute("Camion"+sKeyTruck+gValeurMémorisée(sansespace(skeytruck)))
      	
      	FIN
      	
      FIN
      SI gnNoRack =  99  _ou_ pas gbIsSameCustomer ALORS
      	COMBO_camion..etat = AffichageSeulement
      FIN
      
      COMBO_camion	= gnNoCamion
      
      SAI_TruckFrom	= "Camion"+gnnoCamion
      SAI_rackFrom	= "Rack"+gnnorack
      gbCancel est un booleen = vrai
      gtabIntRackContent est un tableau d'EntierS
      
      mafenetre..ValeurRenvoyée = 0
   -
     code : |1+
      si COMBO_camion <> -1 alors ExécuteTraitement(COMBO_camion,trtSélection)
     type : 34
   -
     type : 180
     enabled : false
   -
     type : 230
     enabled : false
   -
     code : |1-
      MaFenêtre..hauteur = MaFenêtre..HauteurInitiale
      renvoyer (COMBO_camion,SEL_RackTo,gbcancel,gbTruckNumberChange,SAI_Sequence)
     type : 2
  procedures :
   -
     name : SetAvailableRacks
     procedure_id : 1663258486678318811
     type_code : 14
     code : |1-
      // Résumé : <indiquez ici ce que fait la procédure>
      // Syntaxe :
      // SetAvailableRacks ()
      //
      // Paramètres :
      //	Aucun
      // Valeur de retour :
      // 	Aucune
      //
      // Exemple :
      // <Indiquez ici un exemple d'utilisation>
      //
      procédure SetAvailableRacks()
      gtabIntRackContent.SupprimeTout()
      nCpt	est un entier 
      nRes	est un entier
      nNbrack est un entier  
      nSelectorHeight est un entier = MaFenêtre..HauteurInitiale
      POUR i = SEL_RackTo..occurrence _a_ 2 pas -1 
      	SEL_RackTo.Supprime(i)
      FIN
      POUR i = INT_rackTo..occurrence _a_ 2 pas -1 
      	INT_rackto.Supprime(i)
      FIN
      
      
      fenetat
      POUR TOUT stRack,sCle de gstCamion.taAllTruckRack
      	SI Val(sCle) <> gnNoRack ALORS
      		nCpt++
      		
      		SI nCpt = 1 ALORS 
      			INT_rackTo[1].Libellé			= "Rack"+sCle
      			gtabIntRackContent.ajoute(sCle)
      			
      			SEL_RackTo[1].Libellé			= "Rack"+sCle
      			SEL_RackTo[1].ValeurRenvoyée	= sCle
      		SINON
      			nRes							= SEL_RackTo.Ajoute("Rack"+sCle)
      			SEL_RackTo[nRes].ValeurRenvoyée	= sCle
      			nRes								= Int_RackTo.Ajoute("Rack"+sCle)
      			INT_rackTo[nres].Libellé			= "Rack"+sCle
      			gtabIntRackContent.Ajoute(sCle)
      		FIN
      	FIN
      FIN
      
      INT_rackTo..Hauteur = INT_rackTo..Occurrence * 20
      si INT_rackTo..Hauteur > 90 ALORS
      	FEN_SwapRack..hauteur = FEN_SwapRack..HauteurInitiale + (INT_rackTo..hauteur-90)
      FIN
      
      SI nCpt = 0 ALORS sel_RackTo..Etat = Grisé sinon sel_RackTo..etat = actif
     type : 458752
  procedure_templates : []
  property_templates : []
