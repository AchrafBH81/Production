      -
        code : |1+
         hpos est un entier = hsauveposition("invent")
         RESTAURE_BOUTON()
         hlitrecherche("invent","INUM",produitdebase)
         
         //Code WinDev 5.5 remplacé par la migration :
         //si pas h.endehors et h.trouve alors
         si pas HEnDehors() et HTrouve() alors
             commandeTRN.cdcodegl = invent.ICODEGL
         	hretourposition(hpos)
         	ferme
         sinon
         	produitdebase = ""
         	reprisesaisie(produitdebase)
         FIN
         
         
