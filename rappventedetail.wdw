  -
    name : BOUTON4
    identifier : 0x3f87178547402839
    internal_properties : 
    properties :
     x : 499
     y : 81
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         //conditiondeselection est une chaine
         memcree("zonefacture")
         //clederecherche EST UNE CHAINE 
         //Code WinDev 5.5 remplacé par la migration :
         //numerovue est un entier long
         numerovue est un entier  
         choixrapport est une chaine
         choixsommaire est un booleen  
         tableaudate est un tableau de 8 chaines
         datedebutannee est une chaine= config.canneeencoursdebut
         datefinannee est une chaine= ventefin
         datedebutanneeprecedent est une chaine
         datefinanneeprecedent est une chaine
         datedebutperiodeprecedent est une chaine
         datefinperiodeprecedent est une chaine
         Rang est un entier
         Indice est un entier
         ligne est une chaine
         Rang = 1
         datedebutperiodeprecedent = numeriqueverschaine(val(dateverschaine(ventedebut,"AAAA"))-1,"4d")
         //datedebutanneeprecedent =dateverschaine(datedebutanneeprecedent+droite(datedebutannee,4))
         datedebutperiodeprecedent =datedebutperiodeprecedent+droite(ventedebut,4)
         
         datefinperiodeprecedent = numeriqueverschaine(val(dateverschaine(ventefin,"AAAA"))-1,"4d")
         //datedebutanneeprecedent =dateverschaine(datedebutanneeprecedent+droite(datedebutannee,4))
         datefinperiodeprecedent =datefinperiodeprecedent+droite(ventefin,4)
         
         datedebutanneeprecedent = numeriqueverschaine(val(dateverschaine(datedebutannee,"AAAA"))-1,"4d")
         //datedebutanneeprecedent =dateverschaine(datedebutanneeprecedent+droite(datedebutannee,4))
         datedebutanneeprecedent =datedebutanneeprecedent+droite(datedebutannee,4)
         datefinanneeprecedent = datefinperiodeprecedent
         tableaudate[1] =  ventedebut
         tableaudate[2] =  ventefin
         tableaudate[3] =  datedebutannee
         tableaudate[4] =  datefinannee
         tableaudate[5] =  datedebutanneeprecedent
         tableaudate[6] =  datefinanneeprecedent
         tableaudate[7] =  datedebutperiodeprecedent
         tableaudate[8] =  datefinperiodeprecedent
         
         
         selon rappventedetail.selectclient
         cas 3
         Boucle
          	Indice = ListeSelect("CHOIXCLIENT", Rang)
         	Si Indice<>-1 alors
         		// Ajoute l'élément sélectionné dans ListeSel
                 hlitrecherche("hfacture","faclient",choixclient[Indice])
         //Code WinDev 5.5 remplacé par la migration :
         //		tantque pas h.endehors et hfacture.faclient = choixclient[Indice]
         		tantque pas HEnDehors() et hfacture.faclient = choixclient[Indice]
             	   
                    si hfacture.fadate >=  datedebutanneeprecedent et hfacture.fadate <=  datefinanneeprecedent alors
         			ajoutedetail(hfacture.fanofacture)
         		   fin
                    si hfacture.fadate >=  datedebutannee et hfacture.fadate <=  datefinannee alors
         			ajoutedetail(hfacture.fanofacture)
         		   fin
         //			info(hfacture.fanofacture)
         //			memajoute("zonefacture",h.numenr,h.numenr)
         			hlitsuivant("hfacture","faclient")
         		FIN
         		//ligne+=choixclient[Indice] //+ "_"
         	Sinon 
         		Sortir     // Sort de la boucle
         	Fin
         	Rang++
         Fin 
         cas 1
                 hlitpremier("hfacture","faclient")
         //Code WinDev 5.5 remplacé par la migration :
         //		tantque pas h.endehors 
         		tantque pas HEnDehors() 
             	   
         //           si hfacture.fadate >=  ventedebut et hfacture.fadate <=  ventefin alors
                    si hfacture.fadate >=  datedebutanneeprecedent et hfacture.fadate <=  ventefin alors
         			ajoutedetail(hfacture.fanofacture)
         			fin
         //			info(hfacture.fanofacture)
         //			memajoute("zonefacture",h.numenr,h.numenr)
         			hlitsuivant("hfacture","faclient")
         		FIN
         cas 2
                 hlitrecherche("hfacture","faclient",rappventedetail.saisienumero)
         //Code WinDev 5.5 remplacé par la migration :
         //		tantque pas h.endehors et hfacture.faclient = rappventedetail.saisienumero    	   
         		tantque pas HEnDehors() et hfacture.faclient = rappventedetail.saisienumero    	   
         //           si hfacture.fadate >=  ventedebut et hfacture.fadate <=  ventefin alors
                    si hfacture.fadate >=  datedebutanneeprecedent et hfacture.fadate <=  ventefin alors
         			ajoutedetail(hfacture.fanofacture)
         			fin
         //			info(hfacture.fanofacture)
         //			memajoute("zonefacture",h.numenr,h.numenr)
         			hlitsuivant("hfacture","faclient")
         		FIN
         	
         fin	
         iconfigure(imprimanterapport,vrai)
         iParamètre("DEFAUT=NON")
         iParamètre("FORMATPAPIER=LEGAL")
         
         si rappventedetail.destination = 2 alors
          iapercu(1,"Rapport de vente")
         fin
         iimprimeetat("RAPPORTVENTEDETAIL","zonefacture",tableaudate)
         
        type : 18
      -
        type : 161
        enabled : false
