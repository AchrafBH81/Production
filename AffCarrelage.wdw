      -
        code : |1+
         hexecuterequete(RequetedetailCommande,hRequêteDéfaut,Table_Facture.fanumero)
         tablesupprimetout(TableDétail)
         hlitpremier(RequeteDetailcommande)
         tantque pas hendehors(Requetedetailcommande)
         si RequetedetailCommande.ftype = 4 alors
         	tableajouteligne(TableDétail,RequeteDetailcommande.fdligne,RequeteDetailcommande.fdnumcarr,trouve_produit(requeteDétailCommande.fdnumcarr,vrai),...
         	requeteDétailCommande.fdqte,RequeteDetailcommande.fdlargeura,RequeteDetailcommande.fdhauteura,...
         	requetedetailcommande.fdlien)
         sinon
         	tableajouteligne(TableDétail,RequeteDetailcommande.fdligne,RequeteDetailcommande.fdnumprod,trouve_produit(requeteDétailCommande.fdnumprod),...
         	RequeteDetailcommande.fdqte,RequeteDetailcommande.fdlargeura,RequeteDetailcommande.fdhauteura,...
         	requetedetailcommande.fdlien)
         	
         
         FIN
         hlitsuivant(RequetedetailCommande)
         FIN
