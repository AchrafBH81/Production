     x : 701
     y : 182
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         si pas tabledetail..vide alors
         	lignedebut est un entier = Tabledetail.lien[1]
         	lignefin est un entier = tabledetail.lien[tableoccurrence(tabledetail)]
         	hexecuteRequete(requetecarrelageetiquette,hRequêteDéfaut,Table_Facture.fanumero,lignedebut,lignefin)
         	iconfigure(sansespace(imprimantefacture),vrai)
         	iAperçu(i100, "Aperçu écran", Vrai)
         	iParamètre("QUALITE=HAUTE")
         
         //	iimprimeetat(EtatCarrelage)
         	iimprimeetat(CarrelageEtiquette1)
         fin
         
        type : 18
      -
