   -
     name : trouve_produit
     procedure_id : 4592111221623578509
     type_code : 14
     code : |1+
      Procédure trouve_produit(numproduit,carr = faux)
      
      si carr alors
      	si hlitrecherche(invent,INUM,numproduit) ALORS
      		renvoyer invent.idesc
      	sinon
      		renvoyer ""	
      	FIN
      
      sinon
      si hlitrecherche(persoens,ennumero,numproduit) ALORS
      	renvoyer persoens.endescription
      sinon
      	renvoyer ""	
      FIN
      fin
     type : 458752
