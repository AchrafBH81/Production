        enabled : false
  -
    name : BtnOk
    identifier : 0x462f80d76612ffa3
    internal_properties : 
    properties :
     x : 360
     y : 98
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1-
         ldateDebut est une chaine
         ldatefin est une chaine
         lNoClient est une chaine
         iconfigure(imprimanterapport,vrai)
         iParamètre("DEFAUT=NON")
         iParamètre("FORMATPAPIER=LETTRE")
         iParamètre("QUALITE=HAUTE")
         si DESTINATION = 2 alors
         	iapercu()
         FIN
         selon SELECTCLIENT
         
         	// Tous les clients
         
         	cas 1 
         		// 1 = toutes les dates
         		// sinon intervalle
         		si SELECTDate = 1 alors
         			RequeteCoutantCommandeArchivev1.pDateDebut = null
         			RequeteCoutantCommandeArchivev1.pDatefin = null
         
         		sinon
         			RequeteCoutantCommandeArchivev1.pDateDebut = csddatedebut
         			RequeteCoutantCommandeArchivev1.pDatefin = csddatefin
         			ldateDebut = csddatedebut
         			ldatefin = csddatefin
         		FIN
         		RequeteCoutantCommandeArchivev1.pNoClient = null
         		HExécuteRequête(RequeteCoutantCommandeArchivev1) 
         		si selectdate = 1 alors
         			hlitpremier(RequeteCoutantCommandeArchiveV1,bdate)
         			ldateDebut = RequeteCoutantCommandeArchiveV1.Bdate
         			hlitdernier(RequeteCoutantCommandeArchiveV1,bdate)
         			ldatefin = RequeteCoutantCommandeArchiveV1.Bdate
         
         		fin	
         		selon SELECTType
         			cas 1
         				iapercu()
         				iImprimeEtat(ECoutantCommandeSommaireArchive,ldateDebut,ldatefin,lNoClient)
         			cas 2
         				iapercu()
         				iImprimeEtat(ECoutantCommandedetailleeArchive,ldateDebut,ldatefin,lNoClient)
         
         		fin	
         	cas 2
         	    lNoClient = fChoixCoutant.cstNoClient
         		si SELECTDate = 1 alors
         			RequeteCoutantCommandeArchivev1.pDateDebut = null
         			RequeteCoutantCommandeArchivev1.pDatefin = null
         			ldateDebut = "Début"
         			ldatefin = "Fin"
         
         		sinon
         			RequeteCoutantCommandeArchivev1.pDateDebut = csddatedebut
         			RequeteCoutantCommandeArchivev1.pDatefin = csddatefin
         			ldateDebut = csddatedebut
         			ldatefin = csddatefin
         		FIN
         		RequeteCoutantCommandeArchivev1.pNoClient = complete(cstNoClient,10)
         		HExécuteRequête(RequeteCoutantCommandeArchivev1) 
         
         		si selectdate = 1 alors
         			hlitpremier(RequeteCoutantCommandeArchiveV1,bdate)
         			ldateDebut = RequeteCoutantCommandeArchiveV1.Bdate
         			hlitdernier(RequeteCoutantCommandeArchiveV1,bdate)
         			ldatefin = RequeteCoutantCommandeArchiveV1.Bdate
         
         		fin	
         		selon SELECTType
         			cas 1
         				iImprimeEtat(ECoutantCommandeSommaireunClient,ldateDebut,ldatefin,lNoClient)
         			cas 2
         				iImprimeEtat(ECoutantCommandeDetailleeUnClient,ldateDebut,ldatefin,lNoClient)
         
         		fin	
         
         FIN
        type : 18
      -
        type : 161
        enabled : false
  -
