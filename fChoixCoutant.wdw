  -
    name : cstNoClient
    identifier : 0x462f757b15199e20
    internal_properties : 
    properties :
     x : 190
     y : 261
     width : 124
     height : 24
    type : 2
    code_elements :
     type_code : 3
     p_codes :
      -
        code : |1-
         si pas moimeme = "" alors
         	si hlitrecherche(client,numero,moimeme) alors
         		cstNomClient = client.nom
         	sinon
         		acso_message("Erreur","client inexistant dans le fichier","Erreur"	)
         		moimeme = ""
         		reprisesaisie()
         	FIN
         fin
        type : 16
