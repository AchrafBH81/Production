  -
    name : BTN_OK
    identifier : 0x4625082965b23336
    internal_properties : 
    properties :
     x : 642
     y : 89
     width : 35
     height : 35
    type : 4
    code_elements :
     type_code : 4
     p_codes :
      -
        code : |1+
         si sansespace(TSdimension) = "" alors
         	si acso_message("Question","La dimension est vide","Sortir sans sauvegarder ?","OuiNon") = idyes alors
         		ferme()
         	sinon
         		reprisesaisie(TSdimension)	 
         	FIN
         FIN
         
         si sansespace(TSProduit) = "" alors
         	si acso_message("Question","Le numéro de produit est vide","Sortir sans sauvegarder ?","OuiNon") = idyes alors
         		ferme()
         	sinon
         		reprisesaisie(TSProduit)	 
         	FIN
         FIN
         
         
         EcranVersFichier(wAjoutModifDimension,TypeSpacDim)
         TypeSpacDim.TYCLEUNIK = typespac.TYCLEUNIK
         i est un entier
         si lTYPE = "A" alors
         	hajoute(TypeSpacDim)
         sinon
         	hmodifie(TypeSpacDim,hNumEnrEnCours)	
         FIN
         ferme()
         
        type : 18
      -
        type : 161
        enabled : false
